<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.AttachmentPages.AttachmentPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <StackLayout
                Grid.Row="0"
                Margin="0,0,0,0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
                <ScrollView
                    x:Name="ScrollViewContainer"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Fill">
                    <Grid
                        ColumnSpacing="0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40*" />
                            <RowDefinition Height="50*" />
                            <RowDefinition Height="10" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            ColumnSpacing="0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="CenterAndExpand"
                                Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAttachments}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Padding="0"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAttachmentSizeNotfication}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Padding="0"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAttachmentTypeNotfication}"
                                VerticalOptions="EndAndExpand" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Padding="0"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAttachmentMaxSizeNotfication}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="10,0,10,0"
                                Padding="0"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                IsVisible="{Binding AttachmentSizeVisibility}"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                VerticalOptions="CenterAndExpand">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Text="{Binding TotalAttachmentSize}" />
                                        <Span Text="     " />
                                        <Span Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Text="{x:Static ResourceManager:AppResources.OfText}" />
                                        <Span Text="     " />
                                        <Span Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Text="300 MB" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAttachments}" />

                            <custom:CustomSfTextInputView
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HasError="False">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        Margin="20,0,20,0"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                        Text="{Binding AttachmentName}" />
                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>

                            <Image
                                Grid.Row="6"
                                Grid.Column="1"
                                Margin="20,0,20,0"
                                HorizontalOptions="CenterAndExpand"
                                IsVisible="{Binding IsShowAttachmentButton}"
                                Source="ic_attachment.png"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                </Image.GestureRecognizers>
                            </Image>

                        </Grid>

                        <StackLayout
                            x:Name="AttachmentList"
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Start">
                            <ListView
                                x:Name="list"
                                BackgroundColor="White"
                                HasUnevenRows="True"
                                HorizontalOptions="FillAndExpand"
                                ItemTapped="Attachmentlist_ItemTapped"
                                ItemsSource="{Binding AttachmentList}"
                                SeparatorVisibility="None"
                                VerticalOptions="FillAndExpand">
                                <x:Arguments>
                                    <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                </x:Arguments>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ContentView>
                                                <cards:SfCardView
                                                    Margin="10"
                                                    BackgroundColor="White"
                                                    BorderColor="{StaticResource EntryTextColor}"
                                                    BorderWidth=".05"
                                                    CornerRadius="8"
                                                    IndicatorColor="{StaticResource Primary}"
                                                    IndicatorPosition="Left"
                                                    IndicatorThickness="5"
                                                    Opacity=".9">
                                                    <StackLayout
                                                        Padding="10"
                                                        HorizontalOptions="FillAndExpand"
                                                        Orientation="Horizontal"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Grid
                                                            BackgroundColor="White"
                                                            ColumnSpacing="0"
                                                            HorizontalOptions="FillAndExpand"
                                                            RowSpacing="2"
                                                            Style="{DynamicResource GridStyle}"
                                                            VerticalOptions="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70*" />
                                                                <ColumnDefinition Width="15*" />
                                                                <ColumnDefinition Width="15*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="30" />
                                                                <RowDefinition Height="30" />
                                                            </Grid.RowDefinitions>
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource SomarBold}"
                                                                HorizontalOptions="StartAndExpand"
                                                                LineBreakMode="TailTruncation"
                                                                Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="CenterAndExpand" />
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.RowSpan="2"
                                                                Grid.Column="1"
                                                                HorizontalOptions="CenterAndExpand"
                                                                Source="ic_file_download.png"
                                                                VerticalOptions="CenterAndExpand">
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.RowSpan="2"
                                                                Grid.Column="2"
                                                                HorizontalOptions="CenterAndExpand"
                                                                Source="{Binding DeleteImageSource}"
                                                                VerticalOptions="CenterAndExpand">
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="3,0,3,-5"
                                                                FlowDirection="LeftToRight"
                                                                FontFamily="{StaticResource SomarBold}"
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource MiniGrayLabelStyle}"
                                                                Text="{Binding Erfdt}"
                                                                VerticalOptions="CenterAndExpand" />
                                                        </Grid>
                                                    </StackLayout>
                                                </cards:SfCardView>
                                            </ContentView>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackLayout>

                    </Grid>
                </ScrollView>
            </StackLayout>
            <!--  Acticity indicator layout start  -->
            <custom:Loader IsVisible="{Binding IsLoading}" />

            <!--  Acticity indicator layout end  -->
        </Grid>
    </ContentPage.Content>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView
                    Title=""
                    BackgroundColor="{DynamicResource Gray-White}"
                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    FontSize="13">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="{StaticResource Primary}" />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
</ContentPage>