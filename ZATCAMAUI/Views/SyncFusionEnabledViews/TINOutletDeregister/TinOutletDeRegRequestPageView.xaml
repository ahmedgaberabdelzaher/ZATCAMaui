<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.TINOutletDeregister.TinOutletDeRegRequestPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:sfconverter="clr-namespace:ZATCAMAUI.ViewModel.SyncFusionEnabledViewModel.TINOutletDeregister"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:view="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    x:Name="page"
    Title="TinOutletDeRegRequestPageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <sfconverter:RotationConverter x:Key="rotationConverter" />
            <converter:InverseBoolConverter x:Key="BoolConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.DeregistrationServiceTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid Margin="10,0,10,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <IndicatorView 
                            IndicatorColor="LightGray"
                            IndicatorSize="16"
                            SelectedIndicatorColor="{StaticResource PrimaryColor}"
                            HorizontalOptions="End"
                            MaximumVisible="{Binding MaxIndex}"
                            Count="{Binding MaxIndex}"
                            VerticalOptions="CenterAndExpand"
                            Position="{Binding CurrentIndex}"
                            />
                    </Grid>

                    <Grid Grid.Row="1" VerticalOptions="FillAndExpand">



                        <!--  DrpDowns and List  -->
                        <StackLayout IsVisible="{Binding ShouldShowList}">
                            <listView:SfListView
                                x:Name="outerListView"
                                AutoFitMode="DynamicHeight"
                                BackgroundColor="White"
                                ItemsSource="{Binding OutlettUiList}">
                                <listView:SfListView.HeaderTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ViewCell.View>
                                                <StackLayout x:Name="rootArea">
                                                    <StackLayout>
                                                        <Label
                                                            FontFamily="{StaticResource SomarLight}"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MicroGrayLabelStyle}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.DeregistrationType}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Label
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource BodyLabelBlack}"
                                                                    Text="{Binding SelectedDeRegType}" />

                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    HorizontalOptions="Center"
                                                                    IsEnabled="{Binding EnableDeregType}">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                                            Size="28"
                                                                            Color="{StaticResource Secondary}" />
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding ShowDeregTypePicker}" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>


                                                            </Grid>
                                                        </Border>

                                                    </StackLayout>
                                                    <StackLayout IsVisible="{Binding ShouldShowDeregReason}">
                                                        <Label
                                                            FontFamily="{StaticResource SomarLight}"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MicroGrayLabelStyle}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.TinDeregistrationSelectReason}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Label
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource BodyLabelBlack}"
                                                                    Text="{Binding SelectedDeRegReason}" />

                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    HorizontalOptions="Center"
                                                                    IsEnabled="{Binding EnableDeregReason}">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                                            Size="28"
                                                                            Color="{StaticResource Secondary}" />
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding ShowDeregReasonPicker}" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>


                                                            </Grid>
                                                        </Border>

                                                    </StackLayout>
                                                </StackLayout>
                                            </ViewCell.View>
                                        </ViewCell>
                                    </DataTemplate>
                                </listView:SfListView.HeaderTemplate>
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />

                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Margin="0,10"
                                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                                <StackLayout Padding="0,10">
                                                    <Grid
                                                        x:Name="grid"
                                                        Padding="10"
                                                        ColumnSpacing="15"
                                                        RowSpacing="15">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedCommand, Source={x:Reference outerListView}}" CommandParameter="{Binding .}" />
                                                        </Grid.GestureRecognizers>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackLayout
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Spacing="-5">
                                                            <Button
                                                                Padding="10,0,0,0"
                                                                BackgroundColor="Transparent"
                                                                Command="{Binding Path=BindingContext.OuterListTapCommand, Source={x:Reference outerListView}}"
                                                                CommandParameter="{Binding .}"
                                                                FontAttributes="Bold"
                                                                FontSize="24"
                                                                HorizontalOptions="Start"
                                                                Rotation="{Binding IsInnerListVisible, Converter={StaticResource rotationConverter}}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="^"
                                                                VerticalOptions="CenterAndExpand" />
                                                        </StackLayout>
                                                        <StackLayout
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Spacing="-5">
                                                            <custom:CheckboxCustom
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                CheckChanged="Outlet_CheckChanged"
                                                                HorizontalOptions="End"
                                                                IsChecked="{Binding IsOutletChecked}"
                                                                IsEnabled="{Binding IsOutletCheckEnable}"
                                                                Style="{StaticResource CheckboxHeightWidth32}"
                                                                VerticalOptions="CenterAndExpand" />
                                                        </StackLayout>
                                                        <StackLayout
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Spacing="-5">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletOutletNumber}" />

                                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding AOutletNoTb}"
                                                                    VerticalTextAlignment="Center" />

                                                            </StackLayout>

                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="-5">
                                                            <StackLayout>
                                                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletType}" />
                                                                <StackLayout HorizontalOptions="StartAndExpand">
                                                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding AOutletTypeTb}" />
                                                                </StackLayout>


                                                            </StackLayout>


                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Spacing="-5">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletCommarcialName}" />
                                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding AOutletNameTb}" />
                                                            </StackLayout>

                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            Spacing="-5">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletCommarcialNo}" />
                                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding AOutletIdentificationNoTb}" />
                                                            </StackLayout>



                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="3"
                                                            Grid.Column="0"
                                                            Spacing="-5">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletIssueDate}" />
                                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding AOutletIssueDtTb}" />
                                                            </StackLayout>

                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            Spacing="-5">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletCRStatus}" />
                                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding AOutletStatusTb}" />
                                                            </StackLayout>

                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="4"
                                                            Grid.Column="0"
                                                            Spacing="-5">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletValidto}" />
                                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding AOutletValidToTb}" />
                                                            </StackLayout>

                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="4"
                                                            Grid.Column="1"
                                                            Spacing="-5">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletCRCloseTrnsfrDt}" />
                                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                                <Label
                                                                    IsVisible="{Binding IsDateEnable, Converter={StaticResource BoolConverter}}"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding AOutletCloseTransferDtTb}" />
                                                                <Border
                                                                    Margin="0,8,0,0"
                                                                    Padding="5,8,5,8"
                                                                    IsVisible="{Binding IsDateEnable}"
                                                                    Stroke="#B1B1B1"
                                                                    StrokeThickness="1"
                                                                    Style="{StaticResource GreyBorderFrame}">
                                                                    <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">


                                                                        <custom:GAZTBorderlessEntry
                                                                            HorizontalOptions="FillAndExpand"
                                                                            IsEnabled="False"
                                                                            MaxLength="10"
                                                                            Placeholder="{x:Static ResourceManager:AppResources.ddmmyyyyformat}"
                                                                            Style="{StaticResource BodyLabelBlack}"
                                                                            Text="{Binding AOutletCloseTransferDtTb}" />


                                                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                                                            <Image Margin="5,0">
                                                                                <Image.Source>
                                                                                    <FontImageSource
                                                                                        FontFamily="UserIconFont"
                                                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                                        Size="24"
                                                                                        Color="{StaticResource SecondaryNew}" />
                                                                                </Image.Source>
                                                                            </Image>

                                                                        </StackLayout>
                                                                        <StackLayout.GestureRecognizers>
                                                                            <TapGestureRecognizer
                                                                                Command="{Binding BindingContext.OutletClosetransferDatePickerClicker, Source={x:Reference outerListView}}"
                                                                                CommandParameter="{Binding .}"
                                                                                NumberOfTapsRequired="1" />
                                                                        </StackLayout.GestureRecognizers>


                                                                    </StackLayout>
                                                                </Border>

                                                            </StackLayout>


                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="5"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Spacing="-5">
                                                            <Label
                                                                Margin="0,0,0,10"
                                                                Style="{StaticResource CaptionLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.CRDeregReqAction}" />

                                                            <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Label
                                                                        Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        Style="{StaticResource BodyLabelBlack}"
                                                                        Text="{Binding AoutletReason}" />

                                                                    <Image
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        HorizontalOptions="Center"
                                                                        IsEnabled="{Binding IsActionTypeEnabled}">
                                                                        <Image.Source>
                                                                            <FontImageSource
                                                                                FontFamily="UserIconFont"
                                                                                Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                                                Size="28"
                                                                                Color="{StaticResource Secondary}" />
                                                                        </Image.Source>
                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.ShowOutletReasonPicker, Source={x:Reference outerListView}}" CommandParameter="{Binding .}" />
                                                                        </Image.GestureRecognizers>
                                                                    </Image>


                                                                </Grid>
                                                            </Border>
                                                        </StackLayout>

                                                    </Grid>
                                                </StackLayout>
                                            </Border>
                                            <listView:SfListView
                                                x:Name="innerListView"
                                                Grid.Row="1"
                                                Margin="5"
                                                AutoFitMode="DynamicHeight"
                                                IsScrollingEnabled="False"
                                                IsVisible="{Binding IsInnerListVisible}"
                                                ItemsSource="{Binding ContactDetails}">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            x:Name="grid"
                                                            Margin="0,5,0,0"
                                                            Padding="10"
                                                            BackgroundColor="#bbbfca"
                                                            ColumnSpacing="15"
                                                            RowSpacing="15">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>


                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Spacing="-5">

                                                                <custom:CheckboxCustom
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    CheckChanged="Permit_CheckChanged"
                                                                    IsChecked="{Binding IsPermitChecked}"
                                                                    IsEnabled="{Binding IsPermitCheckEnable}"
                                                                    Style="{StaticResource CheckboxHeightWidth32}"
                                                                    VerticalOptions="CenterAndExpand" />



                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Spacing="-5">
                                                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletPermitNumber}" />
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    HorizontalTextAlignment="Start"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding APermitNoTb}"
                                                                    VerticalTextAlignment="Center" />

                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="-5">
                                                                <StackLayout>
                                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletValidFrom}" />
                                                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding APermitValfrDtTb}" />
                                                                </StackLayout>
                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Spacing="-5">
                                                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletName}" />
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding APermitIssueName}" />
                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Spacing="-5">
                                                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletLcnseCloseTrnsfrDt}" />

                                                                <StackLayout HorizontalOptions="StartAndExpand">
                                                                    <Label
                                                                        IsVisible="{Binding IsPermitDateEnable, Converter={StaticResource BoolConverter}}"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        Text="{Binding ALicenceCloseTransfer}" />

                                                                    <Border
                                                                        Margin="0,5,0,0"
                                                                        Padding="5,8,5,8"
                                                                        IsVisible="{Binding IsPermitDateEnable}"
                                                                        Stroke="#B1B1B1"
                                                                        StrokeThickness="1"
                                                                        Style="{StaticResource GreyBorderFrame}">
                                                                        <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">


                                                                            <custom:GAZTBorderlessEntry
                                                                                HorizontalOptions="FillAndExpand"
                                                                                IsEnabled="False"
                                                                                Placeholder="{x:Static ResourceManager:AppResources.ddmmyyyyformat}"
                                                                                Style="{StaticResource BodyLabelBlack}"
                                                                                Text="{Binding ALicenceCloseTransfer}" />


                                                                            <StackLayout
                                                                                HorizontalOptions="End"
                                                                                IsEnabled="{Binding IsPermitDateEnable}"
                                                                                Orientation="Horizontal">
                                                                                <Image Margin="5,0">
                                                                                    <Image.Source>
                                                                                        <FontImageSource
                                                                                            FontFamily="UserIconFont"
                                                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                                            Size="24"
                                                                                            Color="{StaticResource SecondaryNew}" />
                                                                                    </Image.Source>
                                                                                </Image>

                                                                            </StackLayout>
                                                                            <StackLayout.GestureRecognizers>
                                                                                <TapGestureRecognizer
                                                                                    Command="{Binding BindingContext.LicenceCloseTransferDatePickerClicked, Source={x:Reference innerListItem}}"
                                                                                    CommandParameter="{Binding .}"
                                                                                    NumberOfTapsRequired="1" />
                                                                            </StackLayout.GestureRecognizers>


                                                                        </StackLayout>
                                                                    </Border>

                                                                </StackLayout>
                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="2"
                                                                Grid.Column="1"
                                                                Spacing="-5">
                                                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinOutletDeregReason}" />
                                                                <Border
                                                                    Margin="0,8,0,0"
                                                                    Padding="10"
                                                                    Style="{StaticResource GreyBorderFrame}">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Label
                                                                            Grid.Row="0"
                                                                            Grid.Column="0"
                                                                            HorizontalOptions="FillAndExpand"
                                                                            Style="{StaticResource BodyLabelBlack}"
                                                                            Text="{Binding APermitReason}" />

                                                                        <Image
                                                                            Grid.Row="0"
                                                                            Grid.Column="1"
                                                                            HorizontalOptions="Center"
                                                                            IsEnabled="{Binding IsPermitActionTypeEnable}">
                                                                            <Image.Source>
                                                                                <FontImageSource
                                                                                    FontFamily="UserIconFont"
                                                                                    Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                                                    Size="28"
                                                                                    Color="{StaticResource Secondary}" />
                                                                            </Image.Source>
                                                                            <Image.GestureRecognizers>
                                                                                <TapGestureRecognizer
                                                                                    Command="{Binding BindingContext.ShowPermitReasonPicker, Source={x:Reference innerListItem}}"
                                                                                    CommandParameter="{Binding .}"
                                                                                    NumberOfTapsRequired="1" />
                                                                            </Image.GestureRecognizers>
                                                                        </Image>


                                                                    </Grid>
                                                                </Border>
                                                            </StackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>
                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                            <StackLayout
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsVisible="{Binding ShowMainOutletDropDown}">
                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.MainOutletChangeTitle}" />
                                <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding NewMainOutlet}" />

                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                    Size="28"
                                                    Color="{StaticResource Secondary}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding MainOutletPicker}" NumberOfTapsRequired="1" />
                                            </Image.GestureRecognizers>
                                        </Image>


                                    </Grid>
                                </Border>
                            </StackLayout>
                            <buttons:SfButton
                                Grid.Row="6"
                                Margin="0,16,0,16"
                                BackgroundColor="{Binding ContinueBtnBackgroundColor}"
                                Command="{Binding ContinueBtnTapped}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.VRContinue}" />

                        </StackLayout>



                        <!--  Attachment Part  -->
                        <StackLayout IsVisible="{Binding ShouldShowAttachments}">

                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">



                                <listView:SfListView
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="True"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding DeregisterAttachmentsListViewData}"
                                    ScrollBarVisibility="Never"
                                    SelectionBackground="Transparent"
                                    SelectionMode="SingleDeselect"
                                    TapCommand="{Binding DeregisterAttachmentTapped}"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Border
                                                    Grid.Row="0"
                                                    Margin="0,0,0,10"
                                                    Padding="12"
                                                    Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="5,0"
                                                            HeightRequest="25"
                                                            HorizontalOptions="Start"
                                                            Source="newui_ic_pdf"
                                                            VerticalOptions="Center"
                                                            WidthRequest="25" />

                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="Center" />

                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="2"
                                                            HorizontalOptions="Center"
                                                            Rotation="90"
                                                            VerticalOptions="Center">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                    Size="24"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </Border>


                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />

                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelBlackMedium}"
                                        Text="{x:Static ResourceManager:AppResources.CRContractprofitEstimatedRate}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.SupportingDocuments}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="StartAndExpand">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                Size="24"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>

                                        <Image.GestureRecognizers>

                                            <TapGestureRecognizer Command="{Binding AttachmentInfoCommand}" />
                                        </Image.GestureRecognizers>

                                    </Image>
                                </Grid>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />

                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        FontFamily="{StaticResource SomarRegular}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource MicroGrayLabelStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmentPleaseProvideWithSupportingDocuments}" />

                                    <Border
                                        Grid.Row="1"
                                        Margin="0,0,0,10"
                                        Padding="10"
                                        Style="{StaticResource SfStyleGreyBorderFrame}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                TextColor="{StaticResource PrimaryColor}" />
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="Center"
                                                Rotation="90"
                                                VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DeregisterAttachmentTapped}" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="-5">
                                    <CheckBox
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        IsChecked="True"
                                        IsEnabled="False"
                                        VerticalOptions="CenterAndExpand"
                                        Color="{StaticResource NewDarkGreenColor}">
                                        <CheckBox.Triggers>
                                            <DataTrigger TargetType="CheckBox" Value="true">
                                                <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                            </DataTrigger>
                                        </CheckBox.Triggers>
                                    </CheckBox>
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource GAZTMicroMediumGrayLabel}"
                                        Text="{x:Static ResourceManager:AppResources.TinOutletDeclaration}"
                                        VerticalTextAlignment="Center" />



                                </StackLayout>

                            </StackLayout>
                            <StackLayout
                                HorizontalOptions="Center"
                                IsVisible="{Binding ShowSaveSubmit}"
                                Orientation="Horizontal">
                                <buttons:SfButton
                                    Margin="0,5,0,5"
                                    Command="{Binding OnVoidOrSaveDraftClick}"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.VATRMPSaveasDraft}"
                                    VerticalOptions="Fill"
                                    WidthRequest="150" />

                                <buttons:SfButton
                                    Margin="0,5,0,5"
                                    Command="{Binding SubmitBtnTapped}"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Submit}"
                                    VerticalOptions="Fill"
                                    WidthRequest="150" />


                            </StackLayout>


                        </StackLayout>

