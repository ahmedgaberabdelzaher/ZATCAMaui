<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.TINOutletDeregister.TINOutletDeregistrationPageView"
             Title="TINOutletDeregistrationPageView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
            xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
            xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Name="page"
            xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
            ios:Page.UseSafeArea="true"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">
     <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                     Text="{x:Static ResourceManager:AppResources.DeregistrationServiceTitle}"
                    VerticalOptions="Center" />


                <StackLayout Spacing="15" Orientation="Horizontal" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="2">
                        <Image Source="search" IsVisible="{Binding IsSearchButtonVisible}" HeightRequest="20" WidthRequest="20">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="searchButtonTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                </StackLayout>
                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                Grid.Row="1" Grid.ColumnSpan="3">

                    <Grid HorizontalOptions="FillAndExpand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <SearchBar x:Name="searchBar" Placeholder="Enter Request No." Grid.Column="0" Keyboard="Numeric" BackgroundColor="White" custom:RoundCornersEffect.CornerRadius="12" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0" TextChanged="SearchBar_TextChanged" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                        </SearchBar>

                        <Image Grid.Column="1" WidthRequest="24" HeightRequest="24" Source="close" IsVisible="{Binding IsCloseButtonVisible}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CloseSearchButton_Tapped">
                                </TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                <Grid>
                <listView:SfListView   x:Name="ListView_Dereg" Padding="10,0,10,0" Grid.Row="0"
                      ItemsSource="{Binding CopiedPreviousRequestList,Mode=TwoWay}"
                      HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand"
                      BackgroundColor="White"
                      ScrollBarVisibility="Never"
                      SelectionBackground="Transparent"
                      AutoFitMode="Height">
                    <listView:SfListView.HeaderTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ViewCell.View>
                                    <Border StrokeShape="RoundRectangle 15" HorizontalOptions="FillAndExpand" Padding="12" 
                                     Style="{StaticResource GreyBorderFrameWithShadow}" VerticalOptions="FillAndExpand">
                                        <Grid  x:Name="grid">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Row="0" Grid.Column="0" Source="add" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" VerticalOptions="CenterAndExpand"></Image>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentCreateNewRequest}" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" FontSize="16" VerticalOptions="CenterAndExpand"/>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding CreateNewRequestTapped}"></TapGestureRecognizer>
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Border>
                                </ViewCell.View>
                            </ViewCell>
                        </DataTemplate>
                    </listView:SfListView.HeaderTemplate>

                    <listView:SfListView.ItemTemplate IsVisible="{Binding IsListVisible}" >
                        <DataTemplate>
                            <ViewCell>
                                <Border Margin="0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0,10">
                                        <Grid Padding="10" RowSpacing="15" ColumnSpacing="15" x:Name="grid">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedCommand, Source={x:Reference ListView_Dereg}}" CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>

                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.RequestNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <StackLayout HorizontalOptions="StartAndExpand">
                                                    <custom:CustomLabel Text="{Binding Fbnum}"  Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>

                                            </StackLayout>


                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.RequestStatus}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <custom:CustomLabel Text="{Binding Status}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>

                                           

                                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.DeregistrationType}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <custom:CustomLabel Text="{Binding Dtype}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                                <custom:CustomLabel HorizontalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.RequestDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <StackLayout HorizontalOptions="StartAndExpand">
                                                    <custom:CustomLabel HorizontalTextAlignment="Start"   Text="{Binding Date}" Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5" Orientation="Horizontal">
                                                <buttons:SfButton
                                                    Command="{Binding Path=BindingContext.DeleteRequestTapped, Source={x:Reference ListView_Dereg}}" 
                                                    CommandParameter="{Binding .}"
                                                    HeightRequest="40"
                                                    WidthRequest="200"
                                                    Margin="10, 0, 10, 0"
                                                    IsVisible="{Binding IsDeleteVisible}"
                                                    Text="{x:Static ResourceManager:AppResources.DeleteRequest}"
                                                    Style="{StaticResource PrimaryButtonStyle}"/>
                                                <buttons:SfButton
                                                    Command="{Binding Path=BindingContext.CancelRequestTapped, Source={x:Reference ListView_Dereg}}" 
                                                    CommandParameter="{Binding .}"
                                                    HeightRequest="40"
                                                    WidthRequest="100"
                                                    Margin="10, 0, 10, 0"
                                                    IsVisible="{Binding IsCancelVisible}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZCancelText}"
                                                    Style="{StaticResource PrimaryButtonStyle}"/>

                                            </StackLayout>
                                        </Grid>

                                    </StackLayout>
                                </Border >
                            </ViewCell>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                </listView:SfListView>

            </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />


        </Grid>
    </ContentPage.Content>
</ContentPage>
