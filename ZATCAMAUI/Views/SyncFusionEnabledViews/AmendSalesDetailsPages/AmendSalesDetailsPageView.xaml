<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.AmendSalesDetailsPages.AmendSalesDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sfcustom="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    Title="{x:Static ResourceManager:AppResources.ZAmendSalesDetails}"
    ios:Page.UseSafeArea="true"
    BackgroundColor="White"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <sfcustom:TitleView
                    Title="{x:Static ResourceManager:AppResources.ZAmendSalesDetails}"
                    BackgroundColor="{DynamicResource Gray-White}"
                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    FontSize="13">
                    <sfcustom:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="{StaticResource Primary}" />
                    </sfcustom:TitleView.LeadingView>
                </sfcustom:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            BackgroundColor="White"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88*" />
                    <RowDefinition Height="12*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <ScrollView
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid BackgroundColor="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86*" />
                            <ColumnDefinition Width="14*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="30"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Label
                                x:Name="SalesType"
                                Grid.Row="0"
                                Grid.Column="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                IsEnabled="False"
                                Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"
                                Text="{Binding SalesType}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center" />
                        </StackLayout>

                        <custom:CustomSfTextInputView
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HasError="False">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                    Text="{Binding OldValue}"
                                    TextColor="{StaticResource ForgotPasswordGrayTextColor}">
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behaviors:AlphaNumericValidatorBehaviour />
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <custom:CustomSfTextInputView
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HasError="False">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    x:Name="NewValue"
                                    Focused="OnEntryFocussed"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    Keyboard="{OnPlatform Android=Numeric,
                                                          iOS=Default}"
                                    Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                    Text="{Binding NewValue}"
                                    TextChanged="OnNewValueTextChanged"
                                    Unfocused="OnEntryUnFocussed">
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behaviors:OnlyNumericValuesBehaviour />
                                    </custom:GAZTBorderlessEntry.Behaviors>

                                </custom:GAZTBorderlessEntry>
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <custom:CustomSfTextInputView
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HasError="False">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                    Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                    Text="{Binding ChangeReason}">
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behaviors:AlphabetandArabicCharacters />
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Grid.Row="7"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                            Style="{StaticResource GAZTSmallGreenLabelStyle}"
                            Text="{x:Static ResourceManager:AppResources.Attachments}" />

                        <custom:CustomSfTextInputView
                            Grid.Row="12"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HasError="False">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                    Text="{Binding AttachmentName}"
                                    TextColor="{StaticResource PrimaryColor}" />
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <Image
                            Grid.Row="12"
                            Grid.Column="1"
                            Margin="13,2,13,1"
                            HorizontalOptions="CenterAndExpand"
                            Source="ic_attachment.png"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label
                            Grid.Row="8"
                            Grid.Column="0"
                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"
                            Text="{x:Static ResourceManager:AppResources.ZNote}"
                            VerticalOptions="CenterAndExpand" />
                        <Label
                            Grid.Row="9"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                            HorizontalOptions="StartAndExpand"
                            HorizontalTextAlignment="Start"
                            Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                            Text="{x:Static ResourceManager:AppResources.ZFilesizeshouldnotbemorethan5MB}"
                            VerticalOptions="CenterAndExpand" />
                        <StackLayout
                            Grid.Row="10"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalOptions="FillAndExpand">
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZZChooseonlyfilewithextensionForZAKAT}"
                                VerticalOptions="EndAndExpand" />
                        </StackLayout>
                        <Label
                            Grid.Row="11"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                            Text="{x:Static ResourceManager:AppResources.ZMaximumnoof5attachmentscanbeuploaded}"
                            VerticalOptions="Start" />
                        <StackLayout
                            Grid.Row="13"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Fill">
                            <ListView
                                x:Name="Attachmentlist"
                                BackgroundColor="White"
                                HasUnevenRows="True"
                                HorizontalOptions="FillAndExpand"
                                ItemTapped="Attachmentlist_ItemTapped"
                                ItemsSource="{Binding ZakatReturnAttachmentsList}"
                                SeparatorVisibility="None"
                                VerticalOptions="FillAndExpand">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ContentView>
                                                <cards:SfCardView
                                                    Margin="10,10,10,0"
                                                    BackgroundColor="White"
                                                    BorderColor="{StaticResource EntryTextColor}"
                                                    BorderWidth=".05"
                                                    CornerRadius="8"
                                                    IndicatorColor="{StaticResource Primary}"
                                                    IndicatorPosition="Left"
                                                    IndicatorThickness="5"
                                                    Opacity=".9">
                                                    <StackLayout
                                                        Padding="10"
                                                        HorizontalOptions="FillAndExpand"
                                                        Orientation="Horizontal"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Grid
                                                            Margin="0"
                                                            BackgroundColor="White"
                                                            ColumnSpacing="0"
                                                            HorizontalOptions="FillAndExpand"
                                                            RowSpacing="2"
                                                            Style="{DynamicResource GridStyle}"
                                                            VerticalOptions="CenterAndExpand">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="52*" />
                                                                <ColumnDefinition Width="10*" />
                                                                <ColumnDefinition Width="15*" />
                                                                <ColumnDefinition Width="15*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="30" />
                                                                <RowDefinition Height="30" />
                                                            </Grid.RowDefinitions>
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                HorizontalOptions="StartAndExpand"
                                                                LineBreakMode="WordWrap"
                                                                Style="{StaticResource MiniGrayLabelStyle}"
                                                                Text="{Binding Filename}"
                                                                TextColor="{StaticResource PrimaryColor}"
                                                                VerticalOptions="CenterAndExpand" />
                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,0,0,0"
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                HorizontalOptions="StartAndExpand"
                                                                LineBreakMode="CharacterWrap"
                                                                Style="{StaticResource MiniGrayLabelStyle}"
                                                                Text="{Binding UploadededDateToShow}"
                                                                TextColor="{StaticResource PrimaryColor}"
                                                                VerticalOptions="CenterAndExpand" />
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.RowSpan="2"
                                                                Grid.Column="2"
                                                                HorizontalOptions="Center"
                                                                Source="ic_file_download.png"
                                                                VerticalOptions="CenterAndExpand">
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.RowSpan="2"
                                                                Grid.Column="3"
                                                                Aspect="AspectFit"
                                                                HorizontalOptions="Center"
                                                                Source="ic_delete.png"
                                                                VerticalOptions="Center">
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnDeleteAttachmentClickedTapped" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                                        </Grid>
                                                    </StackLayout>
                                                </cards:SfCardView>
                                            </ContentView>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackLayout>
                    </Grid>
                </ScrollView>
                <!--</Grid>-->
                <buttons:SfButton
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0"
                    Padding="0"
                    BackgroundColor="{Binding ButtonBackgroundColor}"
                    Command="{Binding OnZakatReturnDataUpdateClicked}"
                    CornerRadius="0"
                    FontFamily="{StaticResource SomarBold}"
                    HeightRequest="56"
                    IsEnabled="{Binding IsSaveButtonEnable}"
                    Text="{x:Static ResourceManager:AppResources.Save}"
                    TextColor="White"
                    VerticalOptions="EndAndExpand">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="gray" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="White" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </buttons:SfButton>
            </Grid>
            <!--  Acticity indicator layout start  -->

            <custom:Loader IsVisible="{Binding IsLoading}" />

            <!--  Acticity indicator layout end  -->
        </Grid>
    </ContentPage.Content>
</ContentPage>