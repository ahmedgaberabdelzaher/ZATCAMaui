<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.InternationalCodeSearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    FlowDirection="{Binding AppDirection}"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    NavigationPage.HasNavigationBar="False">

    <Border Padding="20" Style="{StaticResource CommonTopCurves}">

         <Grid RowDefinitions="auto,*"
                    Padding="10">

            <StackLayout>

                <StackLayout
                Margin="0,10"
                Orientation="Horizontal"
                VerticalOptions="Start">

                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Medium"
                        Text="{x:Static ResourceManager:AppResources.CountryText}"
                        TextColor="{StaticResource PrimaryColor}"
                        VerticalOptions="Start" />

                    <Image
                        HeightRequest="25"
                        HorizontalOptions="EndAndExpand"
                        Source="close"
                        VerticalOptions="Start"
                        WidthRequest="25">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Close_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>

                </StackLayout>

                <!--  Horizontal Line  -->
                <BoxView
                    Margin="0,10,0,0"
                    BackgroundColor="{StaticResource NeutralLightGrey}"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    WidthRequest="350" />

                 <inputLayout:SfTextInputLayout
                    ContainerBackground="White"
                    ContainerType="Outlined"
                    InputViewPadding="0"
                    LeadingViewPosition="Inside"
                    Hint="{x:Static ResourceManager:AppResources.SearchText}"
                    OutlineCornerRadius="10"
                    Stroke="{StaticResource NeutralGreay}"
                    VerticalOptions="Start">
                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <inputLayout:LabelStyle TextColor="#B00020" />
                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <custom:GAZTBorderlessEntry
                        x:Name="searchEntry"
                        Keyboard="Text"
                        Placeholder="{x:Static ResourceManager:AppResources.ZSearch}"
                        Style="{StaticResource DefaultEntry}"
                        Text="{Binding SearchText}"
                        TextChanged="searchEntry_TextChanged"
                        TextColor="#002447">

                    </custom:GAZTBorderlessEntry>

                    <inputLayout:SfTextInputLayout.LeadingView>
                        <Image Aspect="AspectFit" Source="reportSearchBar.png" />
                    </inputLayout:SfTextInputLayout.LeadingView>

                </inputLayout:SfTextInputLayout>

                <!--  Horizontal Line  -->
                <BoxView
                    Margin="0,0,0,0"
                    BackgroundColor="{StaticResource NeutralLightGrey}"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    WidthRequest="350" />

            </StackLayout>

             <Grid RowDefinitions="*"
                      Grid.Row="1"
                      ColumnDefinitions="*">

                <CollectionView
                    x:Name="itemList"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Never"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding MobileCodes}"
                    VerticalOptions="CenterAndExpand">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <StackLayout x:Name="selectedItem">

                                <StackLayout Orientation="Horizontal"
                                             Spacing="10">

                                     <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="18"
                                        Text="{Binding Telefto}"
                                        TextColor="#002447"/>


                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="18"
                                        Text="{Binding Landx}"
                                        TextColor="#002447"/>

                                </StackLayout>
                               

                                <!--  Horizontal Line  -->
                                <BoxView
                                    Margin="0,10,0,0"
                                    BackgroundColor="{StaticResource NeutralLightGrey}"
                                    HeightRequest="1"
                                    VerticalOptions="Center"
                                    WidthRequest="350" />

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            BindingContext="{Binding Source={x:Reference itemList}, Path=BindingContext}"
                                            Tapped="TapGestureRecognizer_Tapped"
                                            CommandParameter="{Binding Source={x:Reference selectedItem}, Path=BindingContext}" />
                                    </StackLayout.GestureRecognizers>

                            </StackLayout>
                      
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Grid>

    </Border>
</pages:PopupPage>
