<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.FinancialDetailAttachmentPopupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Grid>
        <Border
            BackgroundColor="White"
            StrokeShape="RoundRectangle 22,22,0,0"
            VerticalOptions="End">
            <Grid>


                <StackLayout Margin="10,0,10,0" Padding="0,0,0,0">

                    <StackLayout>

                        <StackLayout Padding="22,22,22,0">
                            <!--  VATRMPAttachments  -->
                            <!--  Divya created a new label and setting visibility when vat amend/reactivation selected  -->
                            <Label
                                HorizontalOptions="Center"
                                IsVisible="{Binding TitleIsVisible}"
                                Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                Text="{Binding AttachmentHeaderTitle}"
                                VerticalOptions="Center" />

                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="Large"
                                HorizontalOptions="Center"
                                IsVisible="{Binding RegAttachmentTitle}"
                                Text="{x:Static ResourceManager:AppResources.VATRMPAttachments}"
                                TextColor="{StaticResource PrimaryColor}"
                                VerticalOptions="Center" />
                            <StackLayout Grid.Row="2" />
                        </StackLayout>
                        <StackLayout Padding="15,0,15,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Padding="0,0,0,0"
                                    FontFamily="{StaticResource SomarBold}"
                                    Text="{x:Static ResourceManager:AppResources.VATRAttachmentCategory}" />
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmIDType"
                                    Grid.Row="1"
                                    Margin="0,-6,0,-6"
                                    ContainerType="Outlined"
                                    HasError="False"
                                    IsHintAlwaysFloated="True"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:GAZTBorderlessEntry
                                            FontSize="Small"
                                            HorizontalOptions="FillAndExpand"
                                            IsSpellCheckEnabled="False"
                                            Text="{Binding AttachmentTypeTxt}"
                                            TextColor="{StaticResource PrimaryColor}" />

                                        <Image Source="arrowDropdown.png" />

                                    </StackLayout>
                                </inputLayout:SfTextInputLayout>
                                <buttons:SfButton
                                    x:Name="btn1"
                                    Grid.Row="1"
                                    Margin="0,0,0,0"
                                    Background="Transparent"
                                    Clicked="btn1_Clicked"
                                    FontSize="Small" />

                                <syncfusion:SfPicker
                                    x:Name="AttachmentTypePicker"
                                    Grid.Row="1"
                                    Margin="0,0,0,0"
                                    Background="White"
                                    FlowDirection="RightToLeft"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectionChanged="DDlIDTypee_OkButtonClicked">

                                    <syncfusion:SfPicker.TextStyle>
                                        <syncfusion:PickerTextStyle FontSize="13" />
                                    </syncfusion:SfPicker.TextStyle>

                                    <syncfusion:SfPicker.Columns>
                                        <syncfusion:PickerColumn
                                            Width="270"
                                            DisplayMemberPath="Txt50"
                                            ItemsSource="{Binding ResultsItemForDOCSet}"
                                            SelectedIndex="{Binding SelectedAttachmentType}" />
                                    </syncfusion:SfPicker.Columns>


                                    <syncfusion:SfPicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                    </syncfusion:SfPicker.SelectedTextStyle>


                                    <syncfusion:SfPicker.SelectionView>
                                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                    </syncfusion:SfPicker.SelectionView>

                                    <syncfusion:SfPicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="40"
                                            Background="{StaticResource Primary}"
                                            Text="{x:Static ResourceManager:AppResources.VATRAttachmentCategory}">
                                            <syncfusion:PickerHeaderView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="White" />
                                            </syncfusion:PickerHeaderView.TextStyle>
                                        </syncfusion:PickerHeaderView>

                                    </syncfusion:SfPicker.HeaderView>

                                    <syncfusion:SfPicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </syncfusion:SfPicker.FooterView>


                                </syncfusion:SfPicker>
                                <!--  OkButtonClicked="DDlIDType_OkButtonClicked"  CancelButtonClicked="DDlIDType_CancelButtonClicked"  -->
                                <StackLayout Grid.Row="2" IsVisible="{Binding IsAttachmentVisibile}">
                                    <Label
                                        Grid.Row="2"
                                        FontFamily="{StaticResource SomarBold}"
                                        Text="{x:Static ResourceManager:AppResources.Attachment}" />
                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmAttachmentOptional"
                                        Grid.Row="3"
                                        Margin="0,-6,0,-6"
                                        ContainerType="Outlined"
                                        HasError="False"
                                        IsHintAlwaysFloated="True"
                                        OutlineCornerRadius="8"
                                        Stroke="#bbbbbb">
                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <StackLayout x:Name="ExploreAttachmentLayout" Orientation="Horizontal">
                                            <custom:GAZTBorderlessEntry
                                                x:Name="EntryExploreAttachment"
                                                FontFamily="{StaticResource SomarBold}"
                                                FontSize="Small"
                                                IsEnabled="False"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZZExplore}" />
                                            <Image HorizontalOptions="EndAndExpand" Rotation="270">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                        Size="25"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>

                            </Grid>
                        </StackLayout>
                        <ListView
                            x:Name="List"
                            HasUnevenRows="True"
                            HeightRequest="300"
                            HorizontalOptions="FillAndExpand"
                            ItemTapped="List_ItemTapped"
                            ItemsSource="{Binding AttachmentList}"
                            SeparatorVisibility="None"
                            VerticalOptions="FillAndExpand">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ContentView>
                                            <cards:SfCardView
                                                Margin="10"
                                                BackgroundColor="White"
                                                BorderColor="{StaticResource EntryTextColor}"
                                                BorderWidth=".05"
                                                CornerRadius="8"
                                                IndicatorColor="{StaticResource Primary}"
                                                IndicatorPosition="Left"
                                                IndicatorThickness="5"
                                                Opacity=".9">
                                                <StackLayout
                                                    Padding="10"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Grid
                                                        BackgroundColor="White"
                                                        ColumnSpacing="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        RowSpacing="2"
                                                        Style="{DynamicResource GridStyle}"
                                                        VerticalOptions="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70*" />
                                                            <ColumnDefinition Width="15*" />
                                                            <ColumnDefinition Width="15*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="30" />
                                                            <RowDefinition Height="30" />
                                                        </Grid.RowDefinitions>
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            HorizontalOptions="StartAndExpand"
                                                            LineBreakMode="TailTruncation"
                                                            Style="{StaticResource MicroGrayLabelStyleNew}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="CenterAndExpand" />

                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.RowSpan="2"
                                                            Grid.Column="2"
                                                            HorizontalOptions="CenterAndExpand"
                                                            Source="ic_delete.png"
                                                            VerticalOptions="CenterAndExpand">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                        <Label
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="3,0,3,-5"
                                                            FlowDirection="LeftToRight"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniGrayLabelStyle}"
                                                            Text="{Binding Erfdt}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </Grid>
                                                </StackLayout>
                                            </cards:SfCardView>
                                        </ContentView>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <buttons:SfButton
                            x:Name="btnDone"
                            Margin="10,0,10,20"
                            Background="{StaticResource Secondary}"
                            Clicked="Close_Tapped"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="15"
                            HeightRequest="48"
                            StrokeThickness="0"
                            Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                            TextColor="{DynamicResource Gray-White}"
                            VerticalOptions="End" />


                    </StackLayout>


                </StackLayout>
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    IsVisible="{Binding IsLoading}">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForLanding"
                                AnimationType="Cupertino"
                                HeightRequest="70"
                                HorizontalOptions="CenterAndExpand"
                                IndicatorColor="{StaticResource Secondary}"
                                IsRunning="{Binding IsLoading}"
                                SizeFactor="0.6"
                                TitlePlacement="Bottom"
                                VerticalOptions="Center"
                                WidthRequest="70" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
        </Border>

    </Grid>

</pages:PopupPage>
