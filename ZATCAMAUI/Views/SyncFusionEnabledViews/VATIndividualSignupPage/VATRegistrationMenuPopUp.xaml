<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATRegistrationMenuPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        BackgroundColor="White"
        StrokeShape="RoundRectangle 22,22,22,22"
        VerticalOptions="CenterAndExpand">
        <StackLayout>
            <Label
                Grid.Row="0"
                Grid.Column="2"
                Margin="10,0,10,0"
                HorizontalOptions="End"
                IsVisible="{Binding BackArrowVisible}"
                Style="{StaticResource IconLabelStyle}"
                Text="{StaticResource Close}"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="CloseTapped" />
                </Label.GestureRecognizers>
            </Label>
            <StackLayout Margin="10,22,10,22">
                <StackLayout
                    x:Name="attach"
                    HorizontalOptions="CenterAndExpand"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image Rotation="-45">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                Size="35"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <Label
                        FontSize="Large"
                        Text="{x:Static ResourceManager:AppResources.VATRMPAttachments}"
                        TextColor="{StaticResource PrimaryColor}" />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnAttachmentTapped" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <StackLayout
                    HorizontalOptions="CenterAndExpand"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image>
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.ContentSaveEdit}"
                                Size="35"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <Label
                        FontSize="Large"
                        Text="{x:Static ResourceManager:AppResources.VATRMPSaveasDraft}"
                        TextColor="{StaticResource PrimaryColor}" />
                </StackLayout>
            </StackLayout>
        </StackLayout>
    </Border>
</Mopups:PopupPage>