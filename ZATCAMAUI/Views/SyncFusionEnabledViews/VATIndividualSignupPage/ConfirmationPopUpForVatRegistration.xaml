<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.ConfirmationPopUpForVatRegistration"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        BackgroundColor="White"
        Stroke="{StaticResource NeutralLightGrey}"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0" Spacing="0">


                <Label
                    x:Name="confirmationText"
                    Margin="10"
                    Style="{StaticResource BodyLabelBlack}" />

            </StackLayout>

            <HorizontalStackLayout
                Grid.Row="1"
                Spacing="10"
                HorizontalOptions="CenterAndExpand">
              
                <buttons:SfButton
                    Clicked="OnOkayButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZYes}"
                    WidthRequest="150"/>
                <buttons:SfButton
                    Clicked="OnCancelClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZNo}"
                    VerticalOptions="FillAndExpand"
                    WidthRequest="150"/>
            </HorizontalStackLayout>

            <!--  Footer Section Ends  -->

            <!--  End of Attachment Visible  -->





        </Grid>
    </Border>
</Mopups:PopupPage>
