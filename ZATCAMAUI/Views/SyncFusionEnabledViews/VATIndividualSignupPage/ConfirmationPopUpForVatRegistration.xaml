<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.ConfirmationPopUpForVatRegistration"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0" Spacing="0">


                <Label
                    x:Name="confirmationText"
                    Margin="10"
                    Style="{StaticResource BodyLabelBlack}" />

            </StackLayout>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="50*" />

                </Grid.ColumnDefinitions>
                <buttons:SfButton
                    Grid.Row="0"
                    Grid.Column="0"
                    Clicked="OnOkayButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZYes}" />
                <buttons:SfButton
                    Grid.Row="0"
                    Grid.Column="1"
                    Clicked="OnCancelClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZNo}"
                    VerticalOptions="FillAndExpand" />
            </Grid>

            <!--  Footer Section Ends  -->

            <!--  End of Attachment Visible  -->





        </Grid>
    </Border>
</Mopups:PopupPage>
