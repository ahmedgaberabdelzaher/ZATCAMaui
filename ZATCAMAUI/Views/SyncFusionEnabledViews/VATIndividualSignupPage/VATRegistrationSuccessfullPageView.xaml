<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATRegistrationSuccessfullPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">

                <Image Aspect="AspectFit" Source="Forget_ic_success" />
                <Label
                    FontSize="Large"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static ResourceManager:AppResources.VATRSRegistrationSuccessful}"
                    TextColor="White" />
                <Label
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static ResourceManager:AppResources.VATRSRegisteredToVATService}"
                    TextColor="White" />
            </StackLayout>
            <ScrollView>
                <Border
                    Padding="20"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 20,20,0,0"
                    VerticalOptions="EndAndExpand">
                    <StackLayout>
                        <Border
                            Margin="0,20,0,0"
                            Padding="0"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 8,8,8,8">
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    FontSize="11"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.VATRSName}"
                                    TextColor="{StaticResource DarkGrayTextColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="Label_Name"
                                    Grid.Column="1"
                                    FontSize="15"
                                    HorizontalOptions="EndAndExpand"
                                    Style="{StaticResource ValueLabelBlack}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,20,0,0"
                            Padding="0"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 8,8,8,8">
                            <StackLayout Padding="10" Orientation="Horizontal">
                                <Label
                                    FontSize="11"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.VATRSAppNumber}"
                                    TextColor="{StaticResource DarkGrayTextColor}"
                                    VerticalOptions="Center" />
                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                    <Label
                                        x:Name="Label_ApplicationNumber"
                                        FontSize="15"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text=""
                                        VerticalOptions="Center" />
                                    <Image>
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>
                                </StackLayout>
                            </StackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Image_Copy_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Margin="0,20,0,10"
                            Padding="0"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 8,8,8,8">
                            <StackLayout Padding="10" Orientation="Horizontal">
                                <Label
                                    FontSize="11"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Date}"
                                    TextColor="{StaticResource DarkGrayTextColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="Label_Date"
                                    FontSize="15"
                                    HorizontalOptions="EndAndExpand"
                                    Style="{StaticResource ValueLabelBlack}"
                                    VerticalOptions="Center" />
                            </StackLayout>
                        </Border>
                        <!--  VATRgotologinpage  -->
                        <buttons:SfButton
                            x:Name="btnDashboard"
                            Grid.ColumnSpan="2"
                            Margin="10,0,10,0"
                            BackgroundColor="{StaticResource Secondary}"
                            Clicked="btnDashboard_Clicked"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="46"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}"
                            TextColor="White"
                            VerticalOptions="End" />
                    </StackLayout>
                </Border>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>