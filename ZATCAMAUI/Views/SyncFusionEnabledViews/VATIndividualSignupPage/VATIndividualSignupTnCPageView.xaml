<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATIndividualSignupTnCPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    Title="{x:Static ResourceManager:AppResources.ZVatTermsAndConditions}"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>

            <StackLayout Spacing="0">
                <controls:SignUpTitle
                    Title="{x:Static ResourceManager:AppResources.ZZTermsAndConditions}"
                    BackgroundColor="Transparent"
                    FontFamily="{x:StaticResource GAZT_FONT_BOLD}"
                    FontSize="13">

                    <controls:SignUpTitle.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.BackButtonClicked}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="White" />
                    </controls:SignUpTitle.LeadingView>

                </controls:SignUpTitle>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid Margin="0,-6,0,0" BackgroundColor="{StaticResource Primary}">
            <Border
                Margin="0,0,0,0"
                Padding="0"
                BackgroundColor="Transparent"
                StrokeShape="RoundRectangle 32,32,0,0">
                <Grid
                    Margin="0"
                    Padding="0,15,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="80*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0"
                        Padding="15,15,15,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <WebView
                            x:Name="TCWebView"
                            HeightRequest="880"
                            HorizontalOptions="FillAndExpand"
                            WidthRequest="1000" />
                    </Grid>

                    <StackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,0,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="End">
                        <StackLayout
                            Margin="0,0,0,0"
                            BackgroundColor="White"
                            HeightRequest="70"
                            Orientation="Horizontal"
                            VerticalOptions="Center"
                            WidthRequest="1000">
                            <custom:CheckboxCustom
                                x:Name="chkTAndC"
                                IsChecked="{Binding IschkTAndC}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Margin="0,0,10,0"
                                FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZZIagreeontermsAndconditions}"
                                VerticalOptions="Center" />
                        </StackLayout>
                        <buttons:SfButton
                            x:Name="MainButtonName"
                            Grid.ColumnSpan="2"
                            Margin="0"
                            Background="{StaticResource Secondary}"
                            Command="{Binding OnSubmitClicked}"
                            CornerRadius="0"
                            FontAttributes="Bold"
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="15"
                            HeightRequest="56"
                            HorizontalOptions="FillAndExpand"
                            IsEnabled="{Binding IsButtonEnabled}"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZProceedtoindividualSignup}"
                            VerticalOptions="End" />
                        <!--  Clicked="btnContinue_Clicked"  -->
                    </StackLayout>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15,-15,15,0"
                        Padding="0"
                        BackgroundColor="White">
                        <Grid Margin="0,7,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="60*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />
                        </Grid>
                    </StackLayout>

                </Grid>
            </Border>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="{Binding IsLoading}"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
