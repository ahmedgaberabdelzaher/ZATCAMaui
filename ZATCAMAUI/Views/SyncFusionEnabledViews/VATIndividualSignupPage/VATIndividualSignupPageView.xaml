<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATIndividualSignupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingVATIndividualSignupCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid>
            <Border
                Grid.Row="0"
                Padding="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 32,32,0,0">
                <StackLayout Padding="20">
                    <Grid HorizontalOptions="FillAndExpand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            x:Name="Image_backArrow"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="Start"
                            IsVisible="{Binding BackArrowVisible}"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{StaticResource Back}"
                            VerticalOptions="Start">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Image
                            Grid.Row="0"
                            Grid.Column="1"
                            HeightRequest="50"
                            HorizontalOptions="CenterAndExpand"
                            Source="ic_logo_gazt.png"
                            VerticalOptions="Start"
                            WidthRequest="50" />
                    </Grid>
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="22"
                        Text="{x:Static ResourceManager:AppResources.ZTERNewAccount}"
                        TextColor="{StaticResource PrimaryColor}" />
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="15"
                        Text="{x:Static ResourceManager:AppResources.ZZZZSelectthetypeofEntity}" />
                    <BoxView Margin="0,0,0,25" Style="{StaticResource lineSeperator}" />
                    <Grid Padding="0">
                        <!--  BackgroundColor="DarkGreen"  -->
                        <Image
                            x:Name="image_individual_tile"
                            Grid.Row="0"
                            Grid.Column="0"
                            Aspect="AspectFill"
                            Source="{Binding ImageIndividualTile}" />
                        <Border
                            Margin="5"
                            BackgroundColor="Transparent"
                            HeightRequest="100"
                            StrokeShape="RoundRectangle 5,5,5,5">
                            <!--  Text="Individual Registration"  -->

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70*" />
                                    <RowDefinition Height="30*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30*" />
                                    <ColumnDefinition Width="70*" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    x:Name="image_individual_icon"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HorizontalOptions="FillAndExpand"
                                    Source="{Binding ImageIndividualIcon}"
                                    VerticalOptions="FillAndExpand" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="13"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZIndividualSignupinVAT}"
                                    TextColor="{Binding IndividualTileColor}"
                                    VerticalOptions="End" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IndividualRegistrationCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>


                    <!--  Establishment signup block  -->
                    <Grid Padding="0">

                        <Image
                            x:Name="image_estimated_tile"
                            Grid.Row="0"
                            Grid.Column="0"
                            Aspect="AspectFill"
                            Source="{Binding ImageEstimatedTile}" />
                        <Border
                            Margin="5"
                            BackgroundColor="Transparent"
                            HeightRequest="100"
                            StrokeShape="RoundRectangle 5,5,5,5">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70*" />
                                    <RowDefinition Height="30*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30*" />
                                    <ColumnDefinition Width="70*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HorizontalOptions="FillAndExpand"
                                    Source="{Binding ImageEstimatedIcon}"
                                    VerticalOptions="FillAndExpand" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="13"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZestablishmentsignup}"
                                    TextColor="{Binding EstimatedTileColor}"
                                    VerticalOptions="End" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EstablishmentSignupCommand}" />
                            </Border.GestureRecognizers>

                        </Border>

                    </Grid>
                    <!--  Establishment signup block  -->
                </StackLayout>
            </Border>

            <custom:Loader IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>