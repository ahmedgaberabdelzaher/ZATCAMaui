<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATRegistrationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    x:Name="page"
    Title="{x:Static ResourceManager:AppResources.ZZZZVatRegistrationTile}"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <!--  ZZZZVatRegistrationTile  -->
    <ContentPage.Resources>
        <ResourceDictionary>


            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />


            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *" RowSpacing="0">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZVatRegistrationTile}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="0"
                StrokeShape="RoundRectangle 15,15,0,0">
                <Grid
                    x:Name="VATRMainGrid"
                    Margin="0"
                    Padding="0,15,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    RowDefinitions="auto,*"
                    VerticalOptions="FillAndExpand">

                    <!--#region Inner Header-->
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15,15,15,0"
                        Padding="0"
                        BackgroundColor="White">
                        <Grid
                            Margin="0,7,0,0"
                            ColumnDefinitions="20*,60*,20*"
                            RowDefinitions="auto,auto">

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsBackStepButtonVisible}"
                                Source="arrowRight.png"
                                VerticalOptions="CenterAndExpand">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding AppDirection}"
                                        TargetType="Image"
                                        Value="LeftToRight">
                                        <Setter Property="Rotation" Value="180" />
                                    </DataTrigger>
                                </Image.Triggers>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TappedOnBackButton" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />

                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <StackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Orientation="Horizontal"
                                    Rotation="90"
                                    Spacing="3"
                                    VerticalOptions="CenterAndExpand">
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                </StackLayout>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="onMoreOptionClicked" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>

                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Padding="10,0,0,10"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand">
                                <commonView:PageIndicatorView
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}" />


                            </StackLayout>

                        </Grid>
                    </StackLayout>
                    <!--#endregion-->

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0"
                        Padding="15,5,15,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">

                        <ScrollView
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">

                            <StackLayout BackgroundColor="White">

                                <Grid
                                    Margin="0"
                                    BackgroundColor="White"
                                    ColumnDefinitions="100*"
                                    HorizontalOptions="FillAndExpand"
                                    RowDefinitions="100*"
                                    RowSpacing="0"
                                    VerticalOptions="FillAndExpand">

                                    <!--#region Terms and Conditions-->
                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0"
                                        BackgroundColor="White"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding IsInstrunctionVisible}"
                                        RowSpacing="0"
                                        VerticalOptions="FillAndExpand">

                                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">

                                            <StackLayout BackgroundColor="White">

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMediumBlackLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" />

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTSmallGoldLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsFirst}"
                                                    TextColor="{StaticResource Primary}" />


                                                <Label
                                                    Margin="0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                Style="{StaticResource GAZTTermsConditions}"
                                                                Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ1}"
                                                                TextColor="{StaticResource Secondary}" />
                                                            <Span Text="&#160;" />
                                                            <Span
                                                                Style="{StaticResource GAZTTermsConditions}"
                                                                Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ2}"
                                                                TextColor="#003672">
                                                                <Span.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="VATFaqTapped" />
                                                                </Span.GestureRecognizers>
                                                            </Span>
                                                            <Span Text="&#160;" />
                                                            <Span
                                                                Style="{StaticResource GAZTTermsConditions}"
                                                                Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ3}"
                                                                TextColor="{StaticResource NeutralGreay}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="1." />
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions1}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontSize="11"
                                                                Style="{StaticResource GAZTTermsConditions}"
                                                                Text="2." />
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions2}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="3." />
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions3}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label LineHeight="1" Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="4." />
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions4}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="5." />
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions5}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label LineHeight="1" Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="6." />
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions6}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label LineHeight="1" Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="7." />
                                                            <Span Style="{StaticResource GAZTTermsConditions}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions7}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <custom:CheckboxCustom
                                                        x:Name="chkDeclaration"
                                                        IsChecked="{Binding IsInstrunctionChecked}"
                                                        Style="{StaticResource CheckboxHeightWidth32}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label Style="{StaticResource CheckboxSelectedFontStyle}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}" />
                                                </StackLayout>

                                            </StackLayout>

                                        </ScrollView>

                                    </Grid>
                                    <!--#endregion-->

                                    <!--#region TaxPayers Details-->
                                    <Grid
                                        x:Name="TaxPayersDetailsView"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="0,0,0,0"
                                        IsVisible="{Binding IsTaxPayersVisible}"
                                        RowDefinitions="auto,auto">

                                        <StackLayout Grid.Row="0">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="28"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                                                VerticalOptions="Center" />

                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />

                                            <BoxView Margin="0,0,0,15" Style="{StaticResource lineSeperator}" />

                                        </StackLayout>

                                        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">

                                            <Grid
                                                Padding="0"
                                                BackgroundColor="White"
                                                BindingContext="{Binding VATRegistrationDetailsData.d}"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,20*"
                                                VerticalOptions="FillAndExpand">

                                                <!--  Start Of Read Only or pre-populated  -->

                                                <StackLayout Grid.Row="0">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.TIN}" />

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.TINS}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Gpartz}">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="1">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZName}" />

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZZName}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding TinNm}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="2">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRMainOutlet}" />

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZZZVATRMainOutlet}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding CrNo}">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                FontSize="Small"
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZZZVATRMainOutlet}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding CrNm}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="3">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRStartDate}" />

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="Entry_CrStdt"
                                                                Margin="0"
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZZZZVATRStartDate}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.StartdateToshow}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="4">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatAddress}" />

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZVatAddress}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>
                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZVatAddress}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="5">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRSource}" />

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZZZVATRSource}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="6" Margin="0,0,0,15">

                                                    <Label
                                                        FontSize="28"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRAdditionalInformation}" />

                                                    <Border
                                                        Padding="15,20,15,20"
                                                        BackgroundColor="White"
                                                        Stroke="#bbbbbb"
                                                        StrokeShape="RoundRectangle 10,10,10,10">
                                                        <StackLayout>

                                                            <Grid
                                                                ColumnDefinitions="20,*"
                                                                ColumnSpacing="10"
                                                                RowDefinitions="auto">

                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Information}"
                                                                            Size="30"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                </Image>

                                                                <StackLayout
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    Spacing="0"
                                                                    VerticalOptions="Start">

                                                                    <Label
                                                                        FontFamily="{StaticResource SomarRegular}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                    <Label
                                                                        FontFamily="{StaticResource SomarRegular}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                    <Label
                                                                        FontFamily="{StaticResource SomarRegular}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                    <Label
                                                                        FontFamily="{StaticResource SomarRegular}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                    <Label
                                                                        FontFamily="{StaticResource SomarRegular}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFifthLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                </StackLayout>
                                                            </Grid>
                                                        </StackLayout>

                                                    </Border>

                                                </StackLayout>

                                                <StackLayout Grid.Row="7">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource CaptionLabelGrey}">

                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATREligibleStartDate}" />
                                                                <Span Text="*" TextColor="#e84941" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>

                                                    <custom:CustomSfTextInputView x:Name="FrmEStartDate">
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="DateEntry"
                                                                IsReadOnly="True"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ddmmyyyyformat}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.VatEligibleStartDate}"
                                                                TextChanged="DateEntry_TextChanged_1">
                                                                <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="btn1_Clicked" />
                                                                </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                            </custom:GAZTBorderlessEntry>
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                        <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="btn1_Clicked" />
                                                        </inputLayout:SfTextInputLayout.GestureRecognizers>
                                                        <inputLayout:SfTextInputLayout.TrailingView>
                                                            <Image
                                                                HorizontalOptions="EndAndExpand"
                                                                Source="calendar.png"
                                                                Style="{StaticResource SmallIcon}" />
                                                        </inputLayout:SfTextInputLayout.TrailingView>

                                                    </custom:CustomSfTextInputView>

                                                    <custom:CustomDatePicker
                                                        x:Name="DpEStartDate"
                                                        Background="White"
                                                        Closed="DpEStartDate_Closed"
                                                        HorizontalOptions="FillAndExpand"
                                                        ItemHeight="45"
                                                        Mode="Dialog"
