<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.VATRegistrationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    
    Title="{x:Static ResourceManager:AppResources.ZZZZVatRegistrationTile}"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.BackButtonTitle=""
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <!--  ZZZZVatRegistrationTile  -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\CommonStyle\StylesNewUI.xaml" />

            </ResourceDictionary.MergedDictionaries>-->

            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="1"
                Padding="0"
                StrokeShape="RoundRectangle 15,15,0,0">
                <Grid
                    x:Name="VATRMainGrid"
                    Margin="0"
                    Padding="0,15,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="90*" />
                        <!--<RowDefinition Height="10*" />-->
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0"
                        Padding="15,5,15,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="98*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollView
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <StackLayout BackgroundColor="White">

                                <Grid
                                    Margin="0"
                                    Padding="0,0,0,10"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="0"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0"
                                        Padding="15"
                                        BackgroundColor="White"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding IsInstrunctionVisible}"
                                        RowSpacing="0"
                                        VerticalOptions="FillAndExpand">
                                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                                            <StackLayout BackgroundColor="White">

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMediumBlackLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" />

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTSmallGoldLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsFirst}"
                                                    TextColor="{StaticResource Primary}" />


                                                <Label
                                                    Margin="0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ1}" TextColor="{StaticResource Secondary}" />
                                                            <Span Text="&#160;" />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ2}" TextColor="#003672">
                                                                <Span.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="VATFaqTapped" />
                                                                </Span.GestureRecognizers>
                                                            </Span>
                                                            <Span Text="&#160;" />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ3}" TextColor="{StaticResource NeutralGreay}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="1." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions1}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span FontSize="11" Text="2." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions2}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="3." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions3}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label LineHeight="1" Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="4." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions4}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    LineHeight="1"
                                                    Style="{StaticResource GAZTTermsConditions}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="5." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions5}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label LineHeight="1" Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="6." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions6}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label LineHeight="1" Style="{StaticResource GAZTTermsConditions}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="7." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions7}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <StackLayout Orientation="Horizontal">
                                                    <custom:CheckboxCustom
                                                        x:Name="chkDeclaration"
                                                        IsChecked="{Binding IsInstrunctionChecked}"
                                                        Style="{StaticResource CheckboxHeightWidth32}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label Style="{StaticResource CheckboxSelectedFontStyle}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                            </StackLayout>
                                        </ScrollView>
                                    </Grid>


                                    <!--  TaxPayers Details  -->
                                    <Grid
                                        x:Name="TaxPayersDetailsView"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="0,0,0,0"
                                        IsVisible="{Binding IsTaxPayersVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="28"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                                                VerticalOptions="Center" />
                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                                            <BoxView Margin="0,0,0,15" Style="{StaticResource lineSeperator}" />
                                        </StackLayout>
                                        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">

                                            <Grid
                                                Padding="0"
                                                BackgroundColor="White"
                                                BindingContext="{Binding VATRegistrationDetailsData.d}"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="15"
                                                VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="20*" />
                                                </Grid.RowDefinitions>
                                                <!--  Start Of Read Only or pre-populated  -->

                                                <StackLayout Grid.Row="0">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.TIN}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                         IsHintAlwaysFloated="True"
                                                        OutlineCornerRadius="8"
                                                        Stroke="#003672"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Placeholder="{x:Static ResourceManager:AppResources.TINS}"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Gpartz}"
                                                            TextColor="#bbbbbb">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:OnlyNumericValuesBehaviour />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                         IsHintAlwaysFloated="True"
                                                        OutlineCornerRadius="8"
                                                        Stroke="#003672"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding TinNm}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="2">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRMainOutlet}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                         IsHintAlwaysFloated="True"
                                                        OutlineCornerRadius="8"
                                                        Stroke="#003672"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding CrNo}">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:OnlyNumericValuesBehaviour />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>

                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                        OutlineCornerRadius="8"
                                                        Stroke="#003672"
                                                         IsHintAlwaysFloated="True"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            FontSize="Small"
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding CrNm}"
                                                            TextColor="#bbbbbb" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="3">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRStartDate}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                        OutlineCornerRadius="8"
                                                         IsHintAlwaysFloated="True"
                                                        Stroke="#003672"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <StackLayout Orientation="Horizontal">
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="Entry_CrStdt"
                                                                Margin="0"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.StartdateToshow}" />
                                                        </StackLayout>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="4">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatAddress}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                         IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        OutlineCornerRadius="8"
                                                        Stroke="#003672"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}" />
                                                    </inputLayout:SfTextInputLayout>
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                         IsHintAlwaysFloated="True"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                        OutlineCornerRadius="8"
                                                        Stroke="#003672"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="5">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRSource}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                         IsHintAlwaysFloated="True"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                        OutlineCornerRadius="8"
                                                        Stroke="#003672"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source}" />

                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="6" Margin="0,0,0,15">

                                                    <Label
                                                        FontSize="28"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRAdditionalInformation}" />

                                                    <Frame
                                                        Padding="15,20,15,20"
                                                        BackgroundColor="White"
                                                        BorderColor="#bbbbbb"
                                                        CornerRadius="10"
                                                        HasShadow="False">
                                                        <StackLayout>

                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Information}"
                                                                            Size="30"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                </Image>
                                                                <StackLayout
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    Spacing="0"
                                                                    VerticalOptions="Start">
                                                                    <Label
                                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />
                                                                    <Label
                                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                    <Label
                                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                    <Label
                                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                    <Label
                                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                                        FontSize="11"
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFifthLine}"
                                                                        TextColor="{StaticResource PrimaryColor}" />

                                                                </StackLayout>
                                                            </Grid>
                                                        </StackLayout>

                                                    </Frame>

                                                </StackLayout>

                                                <StackLayout Grid.Row="7">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <!--<Label Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VATREligibleStartDate}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}" Style="{StaticResource GAZTSmallGrayLabelStyle}" Padding="0,0,0,0"/>-->
                                                        <Label
                                                            Grid.Row="0"
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource CaptionLabelGrey}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.VATREligibleStartDate}" />
                                                                    <Span Text="*" TextColor="#e84941" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <inputLayout:SfTextInputLayout
                                                            x:Name="FrmEStartDate"
                                                            Grid.Row="1"
                                                            Margin="0,-6,0,-6"
                                                             IsHintAlwaysFloated="True"
                                                            ContainerType="Outlined"
                                                            HorizontalOptions="FillAndExpand"
                                                            InputViewPadding="16,0,16,0"
                                                            LeadingViewPosition="Inside"
                                                            OutlineCornerRadius="8"
                                                            Stroke="#003672"
                                                            Style="{StaticResource TextInputLayout}">
