                                                        <Label Style="{StaticResource GAZTSmallBlackLblMediumFont}" Text="{x:Static ResourceManager:AppResources.VATRSummeryOfSalesDetailsComming12months}" />
                                                        <Label Style="{StaticResource GAZTSmallBlackLblMediumFont}" Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.SliderLable1}" />
                                                        <Label
                                                            Margin="0,20,0,0"
                                                            Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                            Text="{x:Static ResourceManager:AppResources.VATRSummeryOfSalesDetailsLast12months}" />
                                                        <Label Style="{StaticResource GAZTSmallBlackLblMediumFont}" Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.SliderLable2}" />
                                                    </StackLayout>
                                                </StackLayout>
                                            </Border>
                                            <!--  Expenses Details Summery  -->
                                            <Border
                                                Margin="0,10,0,0"
                                                Padding="0"
                                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                                <StackLayout>
                                                    <StackLayout Padding="10,5,10,5" Orientation="Horizontal">


                                                        <Image
                                                            Aspect="AspectFit"
                                                            HorizontalOptions="Start"
                                                            Source="ChartBar.png"
                                                            Style="{StaticResource ComponentIconSummaryPage}"
                                                            VerticalOptions="CenterAndExpand" />


                                                        <Label
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text="{x:Static ResourceManager:AppResources.VATRExpensesDetails}" />
                                                    </StackLayout>
                                                    <BoxView
                                                        BackgroundColor="LightGray"
                                                        HeightRequest="1"
                                                        HorizontalOptions="FillAndExpand" />
                                                    <StackLayout Padding="10,5,10,20">
                                                        <!--  SliderLable1  -->
                                                        <Label Style="{StaticResource GAZTSmallBlackLblMediumFont}" Text="{x:Static ResourceManager:AppResources.VATRSummeryofExpenseDetailsComming12Months}" />
                                                        <Label Style="{StaticResource GAZTSmallBlackLblMediumFont}" Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.quesTion3answerSelected}" />
                                                        <Label
                                                            Margin="0,0,0,0"
                                                            Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                            Text="{x:Static ResourceManager:AppResources.VATRSummeryOfExpenseDetailsLast12Months}" />
                                                        <Label Style="{StaticResource GAZTSmallBlackLblMediumFont}" Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.quesTion4answerSelected}" />
                                                    </StackLayout>
                                                </StackLayout>
                                            </Border>
                                            <!--  Financial representative Details Summery  -->
                                            <Border
                                                Margin="0,10,0,0"
                                                Padding="0"
                                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                                <StackLayout>
                                                    <StackLayout Padding="10,5,10,5" Orientation="Horizontal">

                                                        <Image
                                                            Aspect="AspectFit"
                                                            HorizontalOptions="Start"
                                                            Source="ChartBar.png"
                                                            Style="{StaticResource ComponentIconSummaryPage}"
                                                            VerticalOptions="CenterAndExpand" />

                                                        <Label
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZZVATRFinancialRepresentative}" />
                                                    </StackLayout>
                                                    <BoxView
                                                        BackgroundColor="LightGray"
                                                        HeightRequest="1"
                                                        HorizontalOptions="FillAndExpand" />
                                                    <Grid Padding="10,5,10,10" RowSpacing="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40*" />
                                                            <ColumnDefinition Width="50*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.TIN}" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.GpartFR}" />

                                                        <Label
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                        <Label
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.TxtIDTypeFR}" />

                                                        <Label
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                        <Label
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.IdnumberFR}" />

                                                        <Label
                                                            Grid.Row="3"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZVATRFirstName}" />
                                                        <Label
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.FirstnmFR}" />

                                                        <Label
                                                            Grid.Row="4"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZVATRSurName}" />
                                                        <Label
                                                            Grid.Row="4"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.LastnmFR}" />

                                                        <Label
                                                            Grid.Row="5"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                                        <Label
                                                            Grid.Row="5"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource BodyLabelBlackMedium}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource BodyLabelBlackMedium}" TextColor="{StaticResource PrimaryColor}" />
                                                                    <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.MobNumberFR}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <Label
                                                            Grid.Row="6"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.Email}" />
                                                        <Label
                                                            Grid.Row="6"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.SmtpAddrFR}" />
                                                    </Grid>
                                                </StackLayout>
                                            </Border>
                                            <StackLayout>
                                                <Grid
                                                    Padding="0"
                                                    BackgroundColor="White"
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsDeclarationViewEnabled}"
                                                    VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackLayout Grid.Row="0">

                                                        <Label Grid.Row="0" Style="{StaticResource CaptionLabelGrey}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATRIDType}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <custom:CustomSfTextInputView Grid.Row="1">
                                                            <custom:CustomSfTextInputView.TextInputView>
                                                                <custom:GAZTBorderlessEntry
                                                                    HorizontalOptions="FillAndExpand"
                                                                    IsEnabled="False"
                                                                    IsReadOnly="True"
                                                                    IsSpellCheckEnabled="False"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.VATRIDType}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding TxtIDTypeSR}">
                                                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="btnContactID_Clicked" />
                                                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                </custom:GAZTBorderlessEntry>

                                                            </custom:CustomSfTextInputView.TextInputView>
                                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="btnContactID_Clicked" />
                                                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                                                            <inputLayout:SfTextInputLayout.TrailingView>

                                                                <Image
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Source="arrowDropdown.png"
                                                                    Style="{StaticResource SmallIcon}" />
                                                            </inputLayout:SfTextInputLayout.TrailingView>
                                                        </custom:CustomSfTextInputView>

                                                        <custom:CustomSfPicker
                                                            x:Name="DDlContactIDType"
                                                            Margin="0,0,0,0"
                                                            Background="White"
                                                            ItemHeight="40"
                                                            Mode="Dialog"
                                                            OkButtonClicked="DDlIDTypeSR_OkayButtonClicked">

                                                            <syncfusion:SfPicker.TextStyle>
                                                                <syncfusion:PickerTextStyle FontSize="13" TextColor="{StaticResource NeutralGreay}" />
                                                            </syncfusion:SfPicker.TextStyle>

                                                            <syncfusion:SfPicker.Columns>
                                                                <syncfusion:PickerColumn
                                                                    Width="270"
                                                                    DisplayMemberPath="Name"
                                                                    ItemsSource="{Binding IdTypeListSR}"
                                                                    SelectedIndex="{Binding IDTypeIndexSR}" />
                                                            </syncfusion:SfPicker.Columns>


                                                            <syncfusion:SfPicker.SelectedTextStyle>
                                                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                            </syncfusion:SfPicker.SelectedTextStyle>

                                                            <syncfusion:SfPicker.SelectionView>
                                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                            </syncfusion:SfPicker.SelectionView>

                                                            <syncfusion:SfPicker.HeaderView>

                                                                <syncfusion:PickerHeaderView
                                                                    Height="40"
                                                                    Background="{StaticResource Primary}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZIDType}">
                                                                    <syncfusion:PickerHeaderView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                                    </syncfusion:PickerHeaderView.TextStyle>
                                                                </syncfusion:PickerHeaderView>

                                                            </syncfusion:SfPicker.HeaderView>

                                                            <syncfusion:SfPicker.FooterView>

                                                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                                    <syncfusion:PickerFooterView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                    </syncfusion:PickerFooterView.TextStyle>

                                                                </syncfusion:PickerFooterView>

                                                            </syncfusion:SfPicker.FooterView>

                                                        </custom:CustomSfPicker>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="1">
                                                        <Label Grid.Row="0" Style="{StaticResource CaptionLabelGrey}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <custom:CustomSfTextInputView x:Name="FrmContactIDNumber" HasError="{Binding FrameContactIDError}">
                                                            <custom:CustomSfTextInputView.TextInputView>
                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="EntryContactIDNumber"
                                                                    IsSpellCheckEnabled="False"
                                                                    Keyboard="Numeric"
                                                                    MaxLength="{Binding MaxLengthIDSR}"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding IdNumberSR}"
                                                                    TextChanged="EntryContactIDNumber_TextChanged"
                                                                    Unfocused="EntryContactIDNumber_Unfocused">
                                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                                </custom:GAZTBorderlessEntry>
                                                            </custom:CustomSfTextInputView.TextInputView>
                                                        </custom:CustomSfTextInputView>
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        IsVisible="{Binding DOBMandatoryVisibilitySM}">

                                                        <Label Grid.Row="0" Style="{StaticResource CaptionLabelGrey}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>


                                                        <custom:CustomSfTextInputView
                                                            x:Name="FrmContactDBO"
                                                            Grid.Row="1"
                                                            HasError="{Binding FrameContactDOBError}"
                                                            IsVisible="{Binding DOBMandatoryVisibilitySM}">
                                                            <custom:CustomSfTextInputView.TextInputView>
                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="ContactDateEntry"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    IsEnabled="False"
                                                                    IsReadOnly="True"
                                                                    Placeholder="YYYY/MM/DD"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding ContactDOB}"
                                                                    TextChanged="ContactDateEntry_TextChanged">
                                                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="btn4_Clicked" />
                                                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                </custom:GAZTBorderlessEntry>
                                                            </custom:CustomSfTextInputView.TextInputView>
                                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="btn4_Clicked" />
                                                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                                                            <inputLayout:SfTextInputLayout.TrailingView>

                                                                <Image
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Source="calendar.png"
                                                                    Style="{StaticResource SmallIcon}" />
                                                            </inputLayout:SfTextInputLayout.TrailingView>

                                                        </custom:CustomSfTextInputView>


                                                        <custom:CustomDatePicker
                                                            x:Name="ContactDOBPicker"
                                                            Margin="2"
                                                            Background="White"
                                                            Closed="ContactDOBPicker_Closed"
                                                            FlowDirection="RightToLeft"
                                                            HorizontalOptions="FillAndExpand"
                                                            ItemHeight="45"
                                                            Mode="Dialog"
                                                            OkButtonClicked="ContactDOBPicker_OkButtonClicked"
                                                            SelectedItem="{Binding TodayDate}">

                                                            <custom:CustomDatePicker.ColumnHeaderView>
                                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                                            </custom:CustomDatePicker.ColumnHeaderView>


                                                            <custom:CustomDatePicker.SelectionView>
                                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                            </custom:CustomDatePicker.SelectionView>

                                                            <custom:CustomDatePicker.SelectedTextStyle>
                                                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                            </custom:CustomDatePicker.SelectedTextStyle>

                                                            <custom:CustomDatePicker.HeaderView>

                                                                <syncfusion:PickerHeaderView
                                                                    Height="46"
                                                                    Background="{StaticResource Primary}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">

                                                                    <syncfusion:PickerHeaderView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                                    </syncfusion:PickerHeaderView.TextStyle>

                                                                </syncfusion:PickerHeaderView>

                                                            </custom:CustomDatePicker.HeaderView>

                                                            <custom:CustomDatePicker.FooterView>

                                                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                                                    <syncfusion:PickerFooterView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                                    </syncfusion:PickerFooterView.TextStyle>

                                                                </syncfusion:PickerFooterView>

                                                            </custom:CustomDatePicker.FooterView>

                                                        </custom:CustomDatePicker>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="3">
                                                        <Label Grid.Row="0" Style="{StaticResource CaptionLabelGrey}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATRContactPersonName}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <custom:CustomSfTextInputView x:Name="FrmContactName">
                                                            <custom:CustomSfTextInputView.TextInputView>
                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="EntryContactName"
                                                                    IsSpellCheckEnabled="False"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.VATRContactPersonName}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding FirstNameSR}"
                                                                    TextChanged="EntryContactName_TextChanged">
                                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                                        <behaviors:AlphabetandArabicCharacters />
                                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                                </custom:GAZTBorderlessEntry>
                                                            </custom:CustomSfTextInputView.TextInputView>
                                                        </custom:CustomSfTextInputView>
                                                    </StackLayout>
                                                </Grid>
                                                <Grid
                                                    Padding="0"
                                                    BackgroundColor="White"
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsDeclarationViewEnabledNew}"
                                                    RowSpacing="15"
                                                    VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*" />
                                                        <ColumnDefinition Width="50*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="1" />
                                                        </Grid.RowDefinitions>
                                                        <StackLayout>

                                                            <StackLayout Orientation="Horizontal"
                                                                         Spacing="10">
                                                                <custom:CheckboxCustom
                                                                    IsChecked="{Binding IsDeclarationChecked}"
                                                                    MinimumHeightRequest="32"
                                                                    MinimumWidthRequest="32"
                                                                    VerticalOptions="Start" />
                                                                <Label
                                                                    HeightRequest="350"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    HorizontalTextAlignment="{Binding TermsAlignment}"
                                                                    Style="{StaticResource CheckboxUnselectedFontStyle}"
                                                                    Text="{Binding Zterms}"
                                                                    TextType="Html"
                                                                    VerticalOptions="FillAndExpand" />

                                                            </StackLayout>
                                                        </StackLayout>
                                                    </Grid>

                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>
                                    </Grid>
                                    <!--#endregion-->

                                </Grid>

                                <!--#region Next Button-->
                                <buttons:SfButton
                                    x:Name="MainButtonName"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,10"
                                    Background="{Binding ContinueButtonnBackroundColor}"
                                    Clicked="btnContinue_Clicked"
                                    CornerRadius="14"
                                    IsEnabled="{Binding IsContinueButtonEnable}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding CurrentStep}" />
                                <!--#endregion-->

                            </StackLayout>
                        </ScrollView>

                    </Grid>

                </Grid>
            </Border>
            <!--#endregion-->

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>


    </ContentPage.Content>
</ContentPage>