                                                                        </syncfusion:PickerFooterView.TextStyle>

                                                                    </syncfusion:PickerFooterView>

                                                                 </custom:CustomDatePicker.FooterView>

                                                            </custom:CustomDatePicker>
                                                        </Grid>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="3">
                                                        <Label Grid.Row="0" Style="{StaticResource CaptionLabelGrey}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATRContactPersonName}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <inputLayout:SfTextInputLayout
                                                            x:Name="FrmContactName"
                                                            Margin="0,-6,0,-6"
                                                            ContainerType="Outlined"
                                                            HorizontalOptions="FillAndExpand"
                                                            InputViewPadding="16,0,16,0"
                                                            LeadingViewPosition="Inside"
                                                            OutlineCornerRadius="8"
                                                             IsHintAlwaysFloated="True"
                                                            Stroke="#003672"
                                                            Style="{StaticResource TextInputLayout}">
                                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="EntryContactName"
                                                                IsSpellCheckEnabled="False"
                                                                Placeholder="{x:Static ResourceManager:AppResources.VATRContactPersonName}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding FirstNameSR}"
                                                                TextChanged="EntryContactName_TextChanged">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:AlphabetandArabicCharacters />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>
                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>
                                    </Grid>

                                </Grid>

                                <StackLayout
                                    Padding="0,0,0,10"
                                    BackgroundColor="white"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="End">
                                    <buttons:SfButton
                                        x:Name="MainButtonName"
                                        Grid.ColumnSpan="2"
                                        Background="{Binding ContinueButtonnBackroundColor}"
                                        Clicked="btnContinue_Clicked"
                                        CornerRadius="14"
                                        IsEnabled="{Binding IsContinueButtonEnable}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{Binding CurrentStep}">
                                        <buttons:SfButton.Margin>
                                            <OnPlatform x:TypeArguments="Thickness">
                                                <On Platform="iOS" Value="0,-10,0,50" />
                                                <On Platform="Android" Value="0" />
                                            </OnPlatform>
                                        </buttons:SfButton.Margin>
                                    </buttons:SfButton>
                                </StackLayout>
                            </StackLayout>
                        </ScrollView>

                    </Grid>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15,-15,15,0"
                        Padding="0"
                        BackgroundColor="White">
                        <Grid Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="60*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsBackStepButtonVisible}"
                                Source="arrowLeft.png"
                                Style="{DynamicResource BackButtonArrow}"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TappedOnBackButton" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />

                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <StackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Orientation="Horizontal"
                                    Rotation="90"
                                    Spacing="3"
                                    VerticalOptions="CenterAndExpand">
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                </StackLayout>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="onMoreOptionClicked" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Padding="10,0,0,10"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand">
                                <commonView:PageIndicatorView
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}" />

                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZVatRegistrationTile}"
                    VerticalOptions="Center" />

                <Image
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    Source="arrowLeftwhite.png"
                    Style="{DynamicResource BackButtonArrow}"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="{Binding IsLoading}"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>


    </ContentPage.Content>
</ContentPage>