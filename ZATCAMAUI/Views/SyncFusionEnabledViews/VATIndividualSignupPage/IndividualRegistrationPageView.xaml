                                    FontSize="22"
                                    Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZSummery}"
                                    TextColor="{StaticResource PrimaryColor}"
                                    VerticalOptions="Center" />

                                <Label
                                    Margin="10,0,10,0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="15"
                                    Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZReviewinformation}" />

                                <BoxView
                                    Margin="10,10,10,15"
                                    Style="{StaticResource lineSeperator}"
                                    WidthRequest="350" />

                            </StackLayout>

                            <StackLayout Grid.Row="1" Margin="10,0,10,0">
                                <!--  Personal Information  -->
                                <Border
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0,5">
                                        <Grid
                                            Padding="10,0,10,0"
                                            ColumnDefinitions="auto,*,auto"
                                            ColumnSpacing="5"
                                            RowDefinitions="auto">

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="30"
                                                Source="vat_ic_taxpayerDetail.png" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,5,0,5"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                FontSize="Medium"
                                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZPersonalInformation}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                            <buttons:SfButton
                                                x:Name="Btn_Edit_PersonalInformation"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Clicked="Btn_Edit_PersonalInformation_Clicked"
                                                HorizontalOptions="End"
                                                Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                        </Grid>
                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand"
                                            WidthRequest="380" />
                                        <Grid
                                            Padding="10,5,10,10"
                                            ColumnDefinitions="40*,60*"
                                            RowDefinitions="auto,auto,auto,auto">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding TxtIDType}"
                                                TextColor="{StaticResource PrimaryColor}" />


                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding IdNumber}"
                                                TextColor="{StaticResource PrimaryColor}" />


                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource PrimaryColor}" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding DOBddyymm}"
                                                TextColor="{StaticResource PrimaryColor}" />

                                        </Grid>
                                    </StackLayout>
                                </Border>
                                <!--  National Address  -->
                                <Border
                                    Margin="0,20,0,0"
                                    Padding="0"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>
                                        <Grid
                                            Margin="10,0,10,0"
                                            ColumnDefinitions="auto,*,auto"
                                            ColumnSpacing="5"
                                            RowDefinitions="auto">

                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="30"
                                                Source="vat_new_Iconmetrolocation.png" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,5,0,5"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                FontSize="Medium"
                                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZNationalAddress}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                            <buttons:SfButton
                                                x:Name="Btn_Edit_NationalAddress"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Clicked="Btn_Edit_NationalAddress_Clicked"
                                                HorizontalOptions="End"
                                                Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                        </Grid>
                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand"
                                            WidthRequest="380" />
                                        <Grid Padding="10,5,10,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*" />
                                                <ColumnDefinition Width="60*" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZCountry}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding CountryName}"
                                                TextColor="{StaticResource PrimaryColor}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZCity}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding CityName}"
                                                TextColor="{StaticResource PrimaryColor}" />


                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZNeighborhood}" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding Neighborhood}"
                                                TextColor="{StaticResource PrimaryColor}" />


                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZPostalCode}" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding PostalCode}"
                                                TextColor="{StaticResource PrimaryColor}" />


                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}" />
                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding BuildingNumber}"
                                                TextColor="{StaticResource PrimaryColor}" />


                                            <Label
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZUnitNumber}" />
                                            <Label
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding UnitNumber}"
                                                TextColor="{StaticResource PrimaryColor}" />

                                        </Grid>
                                    </StackLayout>
                                </Border>

                                <!--  Contact Information  -->
                                <Border
                                    Margin="0,20,0,0"
                                    Padding="0,0,0,15"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">

                                    <StackLayout Margin="0,5,0,5">

                                        <Grid
                                            Padding="10,0,10,0"
                                            ColumnDefinitions="auto,*,auto"
                                            RowDefinitions="auto">

                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="30"
                                                Source="vat_new_Iconawesomephonealt.png" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,5"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                FontSize="Medium"
                                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZContactInformation}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                            <buttons:SfButton
                                                x:Name="Btn_Edit_ContactInformation"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Clicked="Btn_Edit_ContactInformation_Clicked"
                                                HorizontalOptions="End"
                                                Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                        </Grid>

                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand"
                                            WidthRequest="380" />

                                        <Grid Padding="10,5,10,10" VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*" />
                                                <ColumnDefinition Width="60*" />
                                            </Grid.ColumnDefinitions>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZMobileNumber}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FlowDirection="LeftToRight"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding MobileNumber}"
                                                TextColor="{StaticResource PrimaryColor}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource GAZTSmallBlackLabel}" Text="{Binding TxtCountryCode}" />
                                                        <Span Style="{StaticResource GAZTSmallBlackLabel}" Text="{Binding MobileNumber}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>


                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.Email}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                FontSize="13"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding Email}"
                                                TextColor="{StaticResource PrimaryColor}" />


                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource PrimaryColor}" />

                                        </Grid>

                                    </StackLayout>
                                </Border>

                            </StackLayout>
                        </Grid>

                        <!--  Password  -->
                        <StackLayout x:Name="PasswordView" IsVisible="{Binding PasswordView}">


                            <StackLayout IsVisible="{Binding passwordMainView}">
                                <Label
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="22"
                                    Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Password}"
                                    TextColor="{StaticResource PrimaryColor}"
                                    VerticalOptions="Center" />
                                <Label
                                    Margin="10,0,10,0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="15"
                                    Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZCreateasecurePassword}" />
                                <BoxView
                                    Margin="10,10,10,15"
                                    Style="{StaticResource lineSeperator}"
                                    WidthRequest="350" />
                            </StackLayout>

                            <StackLayout>

                                <StackLayout IsVisible="{Binding passwordMainView}">

                                    <StackLayout IsVisible="{Binding IsGulfER}">
                                        <Label HorizontalOptions="Start" Style="{StaticResource GAZTSmallGrayLabelStyle}">

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.NewPassword}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <inputLayout:SfTextInputLayout
                                            ContainerBackground="White"
                                            ContainerType="Outlined"
                                            HasError="{Binding FramePasswordError}"
                                            Hint="{x:Static ResourceManager:AppResources.NewPassword}"
                                            HorizontalOptions="FillAndExpand"
                                            InputViewPadding="16,0,16,0"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="10"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                x:Name="EntryPassword"
                                                IsPassword="{Binding IsPasswordEncripted}"
                                                MaxLength="16"
                                                Placeholder="{x:Static ResourceManager:AppResources.NewPassword}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding Password}"
                                                TextChanged="EntryPassword_TextChanged"
                                                WidthRequest="128">

                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:PasswordTextBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image
                                                    x:Name="ImageSeePassword"
                                                    Source="hidePassword.png"
                                                    Style="{StaticResource SmallIcon}">

                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="ImageSeePassword_Tapped" />
                                                    </Image.GestureRecognizers>

                                                </Image>
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>

                                    <StackLayout IsVisible="{Binding IsGulfER}">

                                        <Label HorizontalOptions="Start" Style="{StaticResource GAZTSmallGrayLabelStyle}">

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <inputLayout:SfTextInputLayout
                                            ContainerBackground="White"
                                            ContainerType="Outlined"
                                            HasError="{Binding FrameConfirmPasswordError}"
                                            Hint="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}"
                                            HorizontalOptions="FillAndExpand"
                                            InputViewPadding="16,0,16,0"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="10"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                x:Name="EntryConfirmPassword"
                                                FontSize="Small"
                                                IsPassword="{Binding IsConfirmPasswordEncripted}"
                                                MaxLength="16"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding ConfirmPassword}"
                                                TextChanged="EntryConfirmPassword_TextChanged"
                                                WidthRequest="128">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:PasswordTextBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image
                                                    x:Name="ImageSeeConfirmPassword"
                                                    Source="hidePassword.png"
                                                    Style="{StaticResource SmallIcon}">

                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="ImageSeeConfirmPassword_Tapped" />
                                                    </Image.GestureRecognizers>

                                                </Image>
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>

                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image
                                            HorizontalOptions="Start"
                                            Source="{Binding MinEight}"
                                            Style="{StaticResource SmallIcon}" />
                                        <Label
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZAtleast8characterslong}"
                                            TextColor="#010101" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image
                                            HorizontalOptions="Start"
                                            Source="{Binding CapsSmall}"
                                            Style="{StaticResource SmallIcon}" />
                                        <Label
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZEnglishcapitalandsmallletters}"
                                            TextColor="#010101" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image
                                            HorizontalOptions="Start"
                                            Source="{Binding MaxSixteen}"
                                            Style="{StaticResource SmallIcon}" />
                                        <Label
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}"
                                            TextColor="#010101" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal">
                                        <Image
                                            HorizontalOptions="Start"
                                            Source="{Binding NumSymbol}"
                                            Style="{StaticResource SmallIcon}" />
                                        <Label
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZNumbersandsymbols}"
                                            TextColor="#010101" />
                                    </StackLayout>

                                </StackLayout>

                                <!--  Verification Code  -->
                                <StackLayout>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="10,0,10,0"
                                        FontFamily="{StaticResource SomarBold}"
                                        FontSize="22"
                                        Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VerificationCode}"
                                        TextColor="{StaticResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="15"
                                        Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                        Text="{x:Static ResourceManager:AppResources.EnterVerificationCode}" />
                                    <BoxView
                                        Margin="0,10,0,15"
                                        Style="{StaticResource lineSeperator}"
                                        WidthRequest="380" />
                                </StackLayout>

                                <StackLayout Spacing="10">
                                    <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding EncriptedMobileNumber}" />

                                    <StackLayout Orientation="Horizontal">
                                        <Image Source="clock.png" Style="{StaticResource SmallIcon}" />
                                        <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding OTPValidDuration}" />
                                    </StackLayout>
                                </StackLayout>

                                <StackLayout Margin="0,10">
                                    <Label
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                        Text="{x:Static ResourceManager:AppResources.EnterOTP}" />

                                    <inputLayout:SfTextInputLayout
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        HasError="{Binding FrameOTPError}"
                                        HorizontalOptions="FillAndExpand"
                                        InputViewPadding="16,0,16,0"
                                        IsHintAlwaysFloated="True"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10"
                                        Stroke="{StaticResource Primary}">
                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarLight}"
                                            FontSize="Small"
                                            HorizontalOptions="StartAndExpand"
                                            IsPassword="{Binding IsOTPEncripted}"
                                            Keyboard="{OnPlatform Android=Numeric,
                                                                  iOS=Default}"
                                            MaxLength="4"
                                            Placeholder="{x:Static ResourceManager:AppResources.EnterOTP}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding OTP}"
                                            WidthRequest="128">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>

                                        </custom:GAZTBorderlessEntry>
                                    </inputLayout:SfTextInputLayout>

                                    <!--  ResendOTP  -->
                                    <buttons:SfButton
                                        x:Name="btnResendOtp"
                                        Background="{Binding ButtonDisableColor}"
                                        Command="{Binding OnResendButtonClick}"
                                        CornerRadius="0"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="56"
                                        Style="{StaticResource SfButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ResendOTP}"
                                        VerticalOptions="End" />
                                </StackLayout>

                            </StackLayout>

                        </StackLayout>

                        <buttons:SfButton
                            x:Name="btnContinue"
                            Margin="0,10"
                            Command="{Binding OnContinueButtonClick}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ContinueButtonText}"
                            VerticalOptions="EndAndExpand" />

                    </StackLayout>

                </ScrollView>
                <!--#endregion Body-->

            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>