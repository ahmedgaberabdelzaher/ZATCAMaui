<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.IndividualRegistrationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\CommonStyle\StylesNewUI.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>


        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView
                Grid.Row="0"
                Grid.Column="0"
                Padding="0,20,0,0"
                BackgroundColor="White"
                CornerRadius="14,14,0,0">

                <Grid
                    Margin="0"
                    BackgroundColor="White"
                    ColumnSpacing="0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="1"
                        Margin="0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="88*" />
                            <RowDefinition Height="12*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>
                        <ScrollView
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="10,0,10,10"
                            HorizontalOptions="FillAndExpand">
                            <StackLayout
                                Margin="0"
                                Padding="0"
                                BackgroundColor="White"
                                Spacing="0">

                                <Grid
                                    Margin="0"
                                    Padding="0,15,0,10"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="0"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>


                                    <!--  Individual Registration  -->
                                    <Grid
                                        x:Name="IndividualRegistrationView"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0"
                                        Padding="0,10,0,0"
                                        IsVisible="{Binding IndividualRegistrationView}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100*" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label
                                                Margin="10,0,10,0"
                                                FontFamily="{StaticResource SomarBold}"
                                                FontSize="22"
                                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZIndividualRegistration}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Margin="10,0,10,0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                FontSize="15"
                                                Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                                            <BoxView Margin="10,0,10,15" Style="{StaticResource lineSeperator}" />
                                        </StackLayout>

                                        <Grid Grid.Row="1" IsVisible="{Binding IsCitizen}">
                                            <ScrollView Padding="10,0,10,0" Background="white">
                                                <Grid
                                                    Padding="0"
                                                    BackgroundColor="White"
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowSpacing="15"
                                                    VerticalOptions="FillAndExpand">

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout x:Name="IDtYpe" Grid.Row="0">
                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource CardLabelBlack}">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Border Stroke="{StaticResource Secondary}" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                            <Label
                                                                x:Name="idType"
                                                                Padding="10"
                                                                HeightRequest="40"
                                                                Style="{StaticResource CardLabelBlack}"
                                                                Text="{Binding IdType}" />
                                                        </Border>
                                                    </StackLayout>
                                                    <StackLayout x:Name="IDNumber" Grid.Row="1">
                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource CardLabelBlack}">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Border Stroke="{StaticResource Secondary}" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                            <Label
                                                                x:Name="Number"
                                                                Padding="10"
                                                                HeightRequest="40"
                                                                Style="{StaticResource CardLabelBlack}"
                                                                Text="{Binding Idnumber}" />
                                                        </Border>
                                                    </StackLayout>
                                                    <StackLayout x:Name="DateOfBirth" Grid.Row="2">
                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource CardLabelBlack}">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Border Stroke="{StaticResource Secondary}" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                            <Label
                                                                x:Name="Birthdt"
                                                                Padding="10"
                                                                HeightRequest="40"
                                                                Style="{StaticResource CardLabelBlack}"
                                                                Text="{Binding Birthdt}" />
                                                        </Border>
                                                    </StackLayout>
                                                    <StackLayout x:Name="NameofTp" Grid.Row="3">
                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource CardLabelBlack}">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Border Stroke="{StaticResource Secondary}" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                            <custom:CustomLabel
                                                                x:Name="Firstname"
                                                                Padding="10"
                                                                HeightRequest="40"
                                                                Style="{StaticResource CardLabelBlack}"
                                                                Text="{Binding Firstname}" />
                                                        </Border>
                                                    </StackLayout>
                                                </Grid>
                                            </ScrollView>
                                        </Grid>


                                        <Grid Grid.Row="1" IsVisible="{Binding IsGulfER}">
                                            <ScrollView Padding="10,0,10,0">
                                                <Grid
                                                    Padding="0"
                                                    BackgroundColor="White"
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowSpacing="15"
                                                    VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        IsEnabled="False">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <custom:CustomLabel
                                                                Grid.Row="0"
                                                                Padding="0,0,0,0"
                                                                HorizontalOptions="Start"
                                                                Style="{StaticResource CardLabelBlack}">

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <inputLayout:SfTextInputLayout
                                                                x:Name="FrmIDType"
                                                                Grid.Row="1"
                                                                Margin="0,-6,0,-6"
                                                                ContainerType="Outlined"
                                                                HasError="False"
                                                                HorizontalOptions="FillAndExpand"
                                                                InputViewPadding="16,0,16,0"
                                                                LeadingViewPosition="Inside"
                                                                OutlineCornerRadius="8"
                                                                Stroke="{StaticResource Primary}"
                                                                Style="{StaticResource TextInputLayout}"
                                                                TrailingViewPosition="Inside">
                                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <custom:GAZTBorderlessEntry
                                                                    FontFamily="{StaticResource SomarLight}"
                                                                    FontSize="Small"
                                                                    IsSpellCheckEnabled="False"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding TxtIDType}" />
                                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                                    <Image Source="arrowDropdown.png" />

                                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                            </inputLayout:SfTextInputLayout>
                                                            <custom:CustomButton
                                                                x:Name="btn1"
                                                                Grid.Row="1"
                                                                Margin="0,0,0,0"
                                                                BackgroundColor="Transparent"
                                                                Clicked="btn1_Clicked"
                                                                FontSize="Small" />

                                                            <syncfusion:SfPicker
                                                                x:Name="DDlIDType"
                                                                Grid.Row="1"
                                                                Margin="0,0,0,0"
                                                                Background="White"
                                                                CancelButtonClicked="IDType_CancelButtonClicked"
                                                                FlowDirection="RightToLeft"
                                                                ItemHeight="40"
                                                                Mode="Dialog"
                                                                OkButtonClicked="DDlIDType_OkayButtonClicked"
                                                                SelectionChanged="IDType_SelectedIndexChanged">

                                                                <syncfusion:SfPicker.TextStyle>
                                                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="{StaticResource NeutralGreay}" />
                                                                </syncfusion:SfPicker.TextStyle>

                                                                <syncfusion:SfPicker.Columns>
                                                                    <syncfusion:PickerColumn
                                                                        Width="270"
                                                                        DisplayMemberPath="Name"
                                                                        ItemsSource="{Binding IdTypeList}"
                                                                        SelectedIndex="{Binding IDTypeIndex}" />
                                                                </syncfusion:SfPicker.Columns>


                                                                <syncfusion:SfPicker.SelectedTextStyle>
                                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                                </syncfusion:SfPicker.SelectedTextStyle>

                                                                <syncfusion:SfPicker.ColumnHeaderView>
                                                                    <syncfusion:PickerColumnHeaderView Height="46" />
                                                                </syncfusion:SfPicker.ColumnHeaderView>

                                                                <syncfusion:SfPicker.HeaderView>

                                                                    <syncfusion:PickerHeaderView
                                                                        Height="40"
                                                                        Background="{StaticResource Primary}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZIDType}">
                                                                        <syncfusion:PickerHeaderView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="White" />
                                                                        </syncfusion:PickerHeaderView.TextStyle>
                                                                    </syncfusion:PickerHeaderView>

                                                                </syncfusion:SfPicker.HeaderView>

                                                                <syncfusion:SfPicker.FooterView>

                                                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                                        <syncfusion:PickerFooterView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                        </syncfusion:PickerFooterView.TextStyle>

                                                                    </syncfusion:PickerFooterView>

                                                                </syncfusion:SfPicker.FooterView>

                                                                <syncfusion:SfPicker.Behaviors>
                                                                    <behaviors:SfPickerBehavior />
                                                                </syncfusion:SfPicker.Behaviors>

                                                            </syncfusion:SfPicker>
                                                        </Grid>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="1" Grid.Column="0">

                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource CaptionLabelBlack}">

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <inputLayout:SfTextInputLayout
                                                            x:Name="FrmIDNumber"
                                                            Margin="0,-6,0,-6"
                                                            ContainerType="Outlined"
                                                            HasError="{Binding FrameIDError}"
                                                            HorizontalOptions="FillAndExpand"
                                                            InputViewPadding="16,0,16,0"
                                                            LeadingViewPosition="Inside"
                                                            OutlineCornerRadius="8"
                                                            Stroke="{StaticResource Primary}"
                                                            Style="{StaticResource TextInputLayout}">

                                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="EntryIDNumber"
                                                                FontFamily="{StaticResource SomarLight}"
                                                                FontSize="Small"
                                                                IsSpellCheckEnabled="False"
                                                                Keyboard="Numeric"
                                                                MaxLength="{Binding MaxLengthID}"
                                                                Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding IdNumber}"
                                                                TextChanged="GAZTBorderlessEntry_TextChanged"
                                                                Unfocused="EntryIDNumber_Unfocused">
                                                                <Entry.Behaviors>
                                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                                </Entry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="2" Grid.Column="0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <StackLayout Grid.Row="0">
                                                                <custom:CustomLabel
                                                                    Padding="0,0,0,0"
                                                                    HorizontalOptions="Start"
                                                                    Style="{StaticResource CaptionLabelBlack}">

                                                                    <custom:CustomLabel.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                        </FormattedString>
                                                                    </custom:CustomLabel.FormattedText>
                                                                </custom:CustomLabel>

                                                                <busyindicator:SfChipGroup
                                                                    x:Name="ChipGroup_statusFilter"
                                                                    Margin="0,10,0,0"
                                                                    ChipBackground="Transparent"
                                                                    ChipStroke="{StaticResource NeutralLightGrey}"
                                                                    ChipStrokeThickness="1"
                                                                    ChipType="Choice"
                                                                    HorizontalOptions="Start"
                                                                    ItemsSource="{Binding ChipDataFilterlist}"
                                                                    SelectedChipBackground="{StaticResource PartialBg}"
                                                                    SelectionChanged="ChipGroup_statusFilter_SelectionChanged"
                                                                    VerticalOptions="Center">
                                                                    <busyindicator:SfChipGroup.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackLayout WidthRequest="80">
                                                                                <custom:CustomLabel
                                                                                    HorizontalOptions="FillAndExpand"
                                                                                    HorizontalTextAlignment="Center"
                                                                                    Style="{StaticResource CaptionLabelBlack}"
                                                                                    StyleId="OnBoardText"
                                                                                    Text="{Binding Text}" />
                                                                            </StackLayout>
                                                                        </DataTemplate>
                                                                    </busyindicator:SfChipGroup.ItemTemplate>
                                                                </busyindicator:SfChipGroup>

                                                            </StackLayout>

                                                            <inputLayout:SfTextInputLayout
                                                                x:Name="FrmDBO"
                                                                Grid.Row="1"
                                                                Margin="0,-6,0,-6"
                                                                ContainerType="Outlined"
                                                                HasError="{Binding FrameDOBError}"
                                                                HorizontalOptions="FillAndExpand"
                                                                InputViewPadding="16,0,16,0"
                                                                LeadingViewPosition="Inside"
                                                                OutlineCornerRadius="8"
                                                                Stroke="{StaticResource Primary}"
                                                                Style="{StaticResource TextInputLayout}">
                                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="DateEntry"
                                                                    Focused="OnDateEntryFocussed"
                                                                    FontFamily="{StaticResource SomarLight}"
                                                                    FontSize="Small"
                                                                    Placeholder="dd/MM/yyyy"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding DOBddyymm}"
                                                                    TextChanged="DateEntry_TextChanged"
                                                                    TextColor="{StaticResource Primary}"
                                                                    Unfocused="DatePicker_Unfocused" />
                                                                <!--  Placeholder="yyyy/MM/dd"  -->
                                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                                    <Image Source="calendar.png" />
                                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                            </inputLayout:SfTextInputLayout>

                                                            <Button
                                                                x:Name="btn4"
                                                                Grid.Row="1"
                                                                Margin="0,0,0,0"
                                                                BackgroundColor="Transparent"
                                                                Clicked="btnDate_Clicked" />

                                                            <custom:CustomDatePicker
                                                                x:Name="SignUpDOB"
                                                                Grid.Row="1"
                                                                Margin="2"
                                                                Background="White"
                                                                CancelButtonClicked="DOB_CancelButtonClicked"
                                                                Closed="SignUpDOB_Closed"
                                                                FlowDirection="RightToLeft"
                                                                HorizontalOptions="FillAndExpand"
                                                                ItemHeight="45"
                                                                Mode="Dialog"
                                                                OkButtonClicked="DOB_OkButtonClicked"
                                                                SelectedItem="{Binding TodayDate}">

                                                                <custom:CustomDatePicker.SelectedTextStyle>
                                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                                </custom:CustomDatePicker.SelectedTextStyle>

                                                                <custom:CustomDatePicker.HeaderView>

                                                                    <syncfusion:PickerHeaderView
                                                                        Height="46"
                                                                        Background="White"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">
                                                                        <syncfusion:PickerHeaderView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                                        </syncfusion:PickerHeaderView.TextStyle>
                                                                    </syncfusion:PickerHeaderView>

                                                                </custom:CustomDatePicker.HeaderView>

                                                                <custom:CustomDatePicker.ColumnHeaderView>
                                                                    <syncfusion:PickerColumnHeaderView Height="50" Background="White" />
                                                                </custom:CustomDatePicker.ColumnHeaderView>

                                                                <custom:CustomDatePicker.FooterView>

                                                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                                        <syncfusion:PickerFooterView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource PrimaryColor}" />
                                                                        </syncfusion:PickerFooterView.TextStyle>

                                                                    </syncfusion:PickerFooterView>

                                                                </custom:CustomDatePicker.FooterView>

                                                                <custom:CustomDatePicker.Behaviors>
                                                                    <behaviors:SfPickerBehavior />
                                                                </custom:CustomDatePicker.Behaviors>

                                                            </custom:CustomDatePicker>

                                                            <custom:CustomHijriDatePicker
                                                                x:Name="SignUpDOBHijri"
                                                                Grid.Row="1"
                                                                Margin="2"
                                                                Background="White"
                                                                CancelButtonClicked="DOB_CancelButtonClicked"
                                                                Closed="SignUpDOB_Closed"
                                                                FlowDirection="RightToLeft"
                                                                HorizontalOptions="FillAndExpand"
                                                                ItemHeight="45"
                                                                Mode="Dialog"
                                                                OkButtonClicked="DOB_OkButtonClicked"
                                                                SelectedItem="{Binding TodayDateinHijri}">

                                                                <custom:CustomHijriDatePicker.ColumnHeaderView>
                                                                    <syncfusion:PickerColumnHeaderView Height="50" Background="White" />
                                                                </custom:CustomHijriDatePicker.ColumnHeaderView>

                                                                <custom:CustomHijriDatePicker.HeaderView>

                                                                    <syncfusion:PickerHeaderView
                                                                        Height="46"
                                                                        Background="White"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />

                                                                </custom:CustomHijriDatePicker.HeaderView>

                                                                <custom:CustomHijriDatePicker.SelectedTextStyle>
                                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                                </custom:CustomHijriDatePicker.SelectedTextStyle>


                                                                <custom:CustomHijriDatePicker.FooterView>

                                                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                                        <syncfusion:PickerFooterView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                        </syncfusion:PickerFooterView.TextStyle>

                                                                    </syncfusion:PickerFooterView>

                                                                </custom:CustomHijriDatePicker.FooterView>

                                                            </custom:CustomHijriDatePicker>



                                                        </Grid>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="3" Grid.Column="0">

                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource CaptionLabelBlack}">

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>

                                                        <inputLayout:SfTextInputLayout
                                                            x:Name="FrmName"
                                                            Margin="0,-6,0,-6"
                                                            ContainerType="Outlined"
                                                            HasError="{Binding FrameNameError}"
                                                            HorizontalOptions="FillAndExpand"
                                                            InputViewPadding="16,0,16,0"
                                                            LeadingViewPosition="Inside"
                                                            OutlineCornerRadius="8"
                                                            Stroke="{StaticResource Primary}"
                                                            Style="{StaticResource TextInputLayout}">
                                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="EntryName"
                                                                FontFamily="{StaticResource SomarLight}"
                                                                FontSize="Small"
                                                                IsSpellCheckEnabled="False"
                                                                Placeholder="{x:Static ResourceManager:AppResources.ZZName}"
