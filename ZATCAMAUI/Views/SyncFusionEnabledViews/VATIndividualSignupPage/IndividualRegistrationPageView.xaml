                                                FontFamily="{StaticResource SomarBold}"
                                                FontSize="22"
                                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.Password}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Margin="10,0,10,0"
                                                FontFamily="{StaticResource SomarSemiBold}"
                                                FontSize="15"
                                                Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZCreateasecurePassword}" />
                                            <BoxView Margin="10,0,10,15" Style="{StaticResource lineSeperator}" />
                                        </StackLayout>

                                        <StackLayout Grid.Row="1">
                                            <ScrollView Padding="10,0,10,0">
                                                <StackLayout>
                                                    <Grid
                                                        Padding="0"
                                                        BackgroundColor="White"
                                                        ColumnSpacing="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsVisible="{Binding passwordMainView}"
                                                        RowSpacing="15"
                                                        VerticalOptions="FillAndExpand">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackLayout
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            IsVisible="{Binding IsGulfER}">
                                                            <custom:CustomLabel
                                                                Padding="0,0,0,0"
                                                                HorizontalOptions="Start"
                                                                Style="{StaticResource GAZTSmallGrayLabelStyle}">

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static ResourceManager:AppResources.NewPassword}" />
                                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <inputLayout:SfTextInputLayout
                                                                Margin="0,-6,0,-6"
                                                                ContainerType="Outlined"
                                                                HasError="{Binding FramePasswordError}"
                                                                HorizontalOptions="FillAndExpand"
                                                                InputViewPadding="16,0,16,0"
                                                                LeadingViewPosition="Inside"
                                                                OutlineCornerRadius="8"
                                                                Stroke="{StaticResource Primary}"
                                                                Style="{StaticResource TextInputLayout}">
                                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="EntryPassword"
                                                                    IsPassword="{Binding IsPasswordEncripted}"
                                                                    MaxLength="16"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.NewPassword}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding Password}"
                                                                    TextChanged="EntryPassword_TextChanged"
                                                                    WidthRequest="128">

                                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                                        <behaviors:PasswordTextBehaviour />
                                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                                </custom:GAZTBorderlessEntry>
                                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                                    <Image x:Name="ImageSeePassword" Source="hidePassword.png">

                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeePassword_Tapped" />
                                                                        </Image.GestureRecognizers>

                                                                    </Image>
                                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                            </inputLayout:SfTextInputLayout>
                                                        </StackLayout>
                                                        <StackLayout
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            IsVisible="{Binding IsGulfER}">
                                                            <custom:CustomLabel
                                                                Padding="0,0,0,0"
                                                                HorizontalOptions="Start"
                                                                Style="{StaticResource GAZTSmallGrayLabelStyle}">

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}" />
                                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <inputLayout:SfTextInputLayout
                                                                Margin="0,-6,0,-6"
                                                                ContainerType="Outlined"
                                                                HasError="{Binding FrameConfirmPasswordError}"
                                                                HorizontalOptions="FillAndExpand"
                                                                InputViewPadding="16,0,16,0"
                                                                LeadingViewPosition="Inside"
                                                                OutlineCornerRadius="8"
                                                                Stroke="{StaticResource Primary}"
                                                                Style="{StaticResource TextInputLayout}">
                                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="EntryConfirmPassword"
                                                                    FontSize="Small"
                                                                    IsPassword="{Binding IsConfirmPasswordEncripted}"
                                                                    MaxLength="16"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding ConfirmPassword}"
                                                                    TextChanged="EntryConfirmPassword_TextChanged"
                                                                    WidthRequest="128">
                                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                                        <behaviors:PasswordTextBehaviour />
                                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                                </custom:GAZTBorderlessEntry>
                                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                                    <Image x:Name="ImageSeeConfirmPassword" Source="hidePassword.png">

                                                                        <Image.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="ImageSeeConfirmPassword_Tapped" />
                                                                        </Image.GestureRecognizers>

                                                                    </Image>
                                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                            </inputLayout:SfTextInputLayout>
                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="3"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2">
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start" Source="{Binding MinEight}" />
                                                                <Label
                                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZZZAtleast8characterslong}"
                                                                    TextColor="#010101" />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start" Source="{Binding CapsSmall}" />
                                                                <Label
                                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZZZEnglishcapitalandsmallletters}"
                                                                    TextColor="#010101" />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start" Source="{Binding MaxSixteen}" />
                                                                <Label
                                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}"
                                                                    TextColor="#010101" />
                                                            </StackLayout>

                                                            <StackLayout Orientation="Horizontal">
                                                                <Image HorizontalOptions="Start" Source="{Binding NumSymbol}" />
                                                                <Label
                                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZZZNumbersandsymbols}"
                                                                    TextColor="#010101" />
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </Grid>
                                                    <!--  Verification Code  -->
                                                    <Grid x:Name="VerificationCodeView" Padding="0,10,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackLayout Grid.Row="0">
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="10,0,10,0"
                                                                FontFamily="{StaticResource SomarBold}"
                                                                FontSize="22"
                                                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                                                Text="{x:Static ResourceManager:AppResources.VerificationCode}"
                                                                TextColor="{StaticResource PrimaryColor}"
                                                                VerticalOptions="Center" />
                                                            <Label
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                FontSize="15"
                                                                Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                                                Text="{x:Static ResourceManager:AppResources.EnterVerificationCode}" />
                                                            <BoxView Margin="0,0,0,15" Style="{StaticResource lineSeperator}" />
                                                        </StackLayout>
                                                        <StackLayout Grid.Row="1">
                                                            <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding EncriptedMobileNumber}" />

                                                            <StackLayout Orientation="Horizontal">
                                                                <Image Source="clock.png" />
                                                                <Label Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{Binding OTPValidDuration}" />
                                                            </StackLayout>
                                                        </StackLayout>

                                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                                            <Label
                                                                Padding="0,0,0,0"
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                Style="{StaticResource GAZTSmallGrayLabelStyle}"
                                                                Text="{x:Static ResourceManager:AppResources.EnterOTP}" />

                                                            <inputLayout:SfTextInputLayout
                                                                Margin="0,-6,0,-6"
                                                                ContainerType="Outlined"
                                                                HasError="{Binding FrameOTPError}"
                                                                HorizontalOptions="FillAndExpand"
                                                                InputViewPadding="16,0,16,0"
                                                                LeadingViewPosition="Inside"
                                                                OutlineCornerRadius="8"
                                                                Stroke="{StaticResource Primary}"
                                                                Style="{StaticResource TextInputLayout}">
                                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <custom:GAZTBorderlessEntry
                                                                    FontFamily="{StaticResource SomarLight}"
                                                                    FontSize="Small"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    IsPassword="{Binding IsOTPEncripted}"
                                                                    Keyboard="Numeric"
                                                                    MaxLength="4"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.EnterOTP}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding OTP}"
                                                                    WidthRequest="128" />
                                                            </inputLayout:SfTextInputLayout>
                                                            <!--  ResendOTP  -->
                                                            <buttons:SfButton
                                                                x:Name="btnResendOtp"
                                                                Background="{Binding ButtonDisableColor}"
                                                                Command="{Binding OnResendButtonClick}"
                                                                CornerRadius="0"
                                                                FontFamily="{StaticResource SomarRegular}"
                                                                FontSize="15"
                                                                HeightRequest="56"
                                                                Style="{StaticResource SfButtonStyle}"
                                                                Text="{x:Static ResourceManager:AppResources.ResendOTP}"
                                                                VerticalOptions="End" />
                                                        </StackLayout>

                                                    </Grid>
                                                </StackLayout>
                                            </ScrollView>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </ScrollView>
                        <StackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="20,8,20,10"
                            BackgroundColor="White">
                            <buttons:SfButton
                                x:Name="btnContinue"
                                Command="{Binding OnContinueButtonClick}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{Binding ContinueButtonText}" />
                        </StackLayout>
                    </Grid>

                    <StackLayout Grid.Row="0" BackgroundColor="White">

                        <Grid Padding="15,0,15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="60*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout Grid.Column="0" Padding="0,8,0,0">
                                <Image
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding BackArrowVisible}"
                                    Source="arrowLeft.png"
                                    Style="{DynamicResource BackButtonArrow}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnBackButtonClick}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <StackLayout Grid.Column="1">
                                <Image
                                    HeightRequest="40"
                                    Source="ic_logo_gazt.png"
                                    WidthRequest="34" />
                            </StackLayout>
                            <StackLayout Grid.Column="2" Padding="0,8,0,0">
                                <Image
                                    HorizontalOptions="End"
                                    IsVisible="{Binding BackArrowVisible}"
                                    Source="close.png">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoButtonClick}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                        </Grid>


                        <commonView:PageIndicatorView
                            Margin="10,0,10,0"
                            Padding="10,0,0,0"
                            DotSize="12"
                            HorizontalOptions="End"
                            MaxNum="{Binding MaxIndex}"
                            MinNum="{Binding CurrentIndex}" />
                    </StackLayout>

                </Grid>
                <!--</StackLayout>-->
            </yummy:PancakeView>


            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="{Binding IsLoading}"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>