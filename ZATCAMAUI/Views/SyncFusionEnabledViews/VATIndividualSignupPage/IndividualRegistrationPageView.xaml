<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATIndividualSignupPage.IndividualRegistrationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:SfChipGroup="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>


        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingIndividualRegistrationCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <Image
                    HorizontalOptions="Start"
                    IsVisible="{Binding BackArrowVisible}"
                    Source="arrowRight.png">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding AppDirection}"
                            TargetType="Image"
                            Value="LeftToRight">
                            <Setter Property="Rotation" Value="180" />
                        </DataTrigger>
                    </Image.Triggers>

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClick}" />
                    </Image.GestureRecognizers>
                </Image>

                <Image
                    Grid.Column="1"
                    HeightRequest="40"
                    Source="ic_logo_gazt.png"
                    WidthRequest="34" />

                <Image
                    Grid.Column="2"
                    Aspect="AspectFit"
                    HeightRequest="25"
                    HorizontalOptions="End"
                    IsVisible="{Binding BackArrowVisible}"
                    Source="close.png"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
            <!--#endregion Header-->

            <Border
                Grid.Row="1"
                Padding="20"
                Style="{StaticResource CommonTopCurves}">

                <!--#region Body-->
                <ScrollView
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">

                    <StackLayout Margin="10,0" VerticalOptions="FillAndExpand">
                        <commonView:PageIndicatorView
                            Completed="{Binding MarkComplete}"
                            DotSize="16"
                            HorizontalOptions="EndAndExpand"
                            MaxNum="{Binding MaxIndex}"
                            MinNum="{Binding CurrentIndex}"
                            VerticalOptions="Start" />

                        <!--#region Individual Registration-->
                        <StackLayout x:Name="IndividualRegistrationView" IsVisible="{Binding IndividualRegistrationView}">


                            <!--  Titles  -->
                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="22"
                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZIndividualRegistration}"
                                TextColor="{StaticResource PrimaryColor}"
                                VerticalOptions="Center" />

                            <Label
                                FontFamily="{StaticResource SomarSemiBold}"
                                FontSize="15"
                                Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />

                            <BoxView
                                Margin="10,0,10,15"
                                Style="{StaticResource lineSeperator}"
                                WidthRequest="500" />

                            <StackLayout
                                Padding="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsCitizen}"
                                Spacing="15"
                                VerticalOptions="FillAndExpand">

                                <StackLayout x:Name="IDtYpe">
                                    <Label HorizontalOptions="Start" Style="{StaticResource CardLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Border
                                        Stroke="{StaticResource Gray}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <Label
                                            x:Name="idType"
                                            Padding="10"
                                            HeightRequest="40"
                                            Style="{StaticResource CardLabelBlack}"
                                            Text="{Binding IdType}" />
                                    </Border>

                                </StackLayout>

                                <StackLayout x:Name="IDNumber" Grid.Row="1">
                                    <Label HorizontalOptions="Start" Style="{StaticResource CardLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Border
                                        Stroke="{StaticResource Gray}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <Label
                                            x:Name="Number"
                                            Padding="10"
                                            HeightRequest="40"
                                            Style="{StaticResource CardLabelBlack}"
                                            Text="{Binding Idnumber}" />
                                    </Border>
                                </StackLayout>

                                <StackLayout Grid.Row="2" IsVisible="{Binding ShowIqamaTypeDesc}">

                                    <Label HorizontalOptions="Start" Style="{StaticResource CardLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.IqamaType}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Border
                                        Padding="8,4,0,0"
                                        Stroke="{StaticResource Secondary}"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">

                                        <Label
                                            Padding="10"
                                            HeightRequest="40"
                                            Style="{StaticResource CardLabelBlack}"
                                            Text="{Binding IqamaTypeDesc}"
                                            VerticalOptions="Center" />

                                    </Border>


                                </StackLayout>

                                <StackLayout x:Name="DateOfBirth" Grid.Row="2">
                                    <Label
                                        Grid.Row="0"
                                        Padding="0,0,0,0"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CardLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Border
                                        Stroke="{StaticResource Gray}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <Label
                                            x:Name="Birthdt"
                                            Padding="10"
                                            HeightRequest="40"
                                            Style="{StaticResource CardLabelBlack}"
                                            Text="{Binding Birthdt}" />
                                    </Border>
                                </StackLayout>

                                <StackLayout x:Name="NameofTp" Grid.Row="3">
                                    <Label
                                        Grid.Row="0"
                                        Padding="0,0,0,0"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CardLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Border
                                        Stroke="{StaticResource Gray}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <Label
                                            x:Name="Firstname"
                                            Padding="10"
                                            HeightRequest="40"
                                            Style="{StaticResource CardLabelBlack}"
                                            Text="{Binding Firstname}" />
                                    </Border>
                                </StackLayout>

                            </StackLayout>

                            <!--  GulfER  -->
                            <StackLayout
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsGulfER}"
                                VerticalOptions="FillAndExpand">

                                <!--  Id Type  -->
                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>


                                    <custom:CustomSfTextInputView x:Name="FrmIDType">

                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarLight}"
                                                FontSize="Small"
                                                InputTransparent="True"
                                                IsReadOnly="True"
                                                IsSpellCheckEnabled="False"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding TxtIDType}" />
                                        </custom:CustomSfTextInputView.TextInputView>

                                        <custom:CustomSfTextInputView.TrailingView>
                                            <Image Source="arrowDropdown.png" Style="{StaticResource SmallIcon}" />
                                        </custom:CustomSfTextInputView.TrailingView>

                                    </custom:CustomSfTextInputView>

                                    <custom:CustomSfPicker
                                        x:Name="DDlIDType"
                                        AcceptCommand="{Binding DDlIDTypeOkayButtonCommand}"
                                        Background="White"
                                        ItemHeight="46"
                                        Mode="Dialog"
                                        SelectionChangedCommand="{Binding IDTypeSelectedIndexCommand}">

                                        <syncfusion:SfPicker.TextStyle>
                                            <syncfusion:PickerTextStyle FontSize="13" TextColor="{StaticResource NeutralGreay}" />
                                        </syncfusion:SfPicker.TextStyle>

                                        <syncfusion:SfPicker.SelectionView>
                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                        </syncfusion:SfPicker.SelectionView>

                                        <syncfusion:SfPicker.Columns>
                                            <syncfusion:PickerColumn
                                                Width="270"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding IdTypeList}"
                                                SelectedIndex="{Binding IDTypeIndex}" />
                                        </syncfusion:SfPicker.Columns>


                                        <syncfusion:SfPicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.SelectedTextStyle>

                                        <syncfusion:SfPicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="46"
                                                Background="{StaticResource Primary}"
                                                Text="{x:Static ResourceManager:AppResources.ZZIDType}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </syncfusion:SfPicker.HeaderView>

                                        <syncfusion:SfPicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </syncfusion:SfPicker.FooterView>


                                    </custom:CustomSfPicker>

                                </StackLayout>

                                <!--  Id Number  -->
                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <custom:CustomSfTextInputView x:Name="FrmIDNumber" HasError="{Binding FrameIDError}">
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                x:Name="EntryIDNumber"
                                                FontFamily="{StaticResource SomarLight}"
                                                FontSize="Small"
                                                IsSpellCheckEnabled="False"
                                                Keyboard="Numeric"
                                                MaxLength="{Binding MaxLengthID}"
                                                Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding IdNumber}">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <xct:EventToCommandBehavior Command="{Binding EntryIDNumberTextCommand}" EventName="TextChanged" />
                                                    <xct:EventToCommandBehavior Command="{Binding EntryIDNumberUnfocusedCommand}" EventName="Unfocused" />
                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>

                                        </custom:CustomSfTextInputView.TextInputView>
                                    </custom:CustomSfTextInputView>

                                </StackLayout>

                                <!--  DateofBirth  -->
                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <SfChipGroup:SfChipGroup
                                        x:Name="ChipGroup_statusFilter"
                                        Margin="0,10"
                                        ChipBackground="Transparent"
                                        ChipStroke="{StaticResource NeutralLightGrey}"
                                        ChipStrokeThickness="1"
                                        ChipType="Choice"
                                        HorizontalOptions="Start"
                                        ItemsSource="{Binding ChipDataFilterlist}"
                                        SelectedChipBackground="{StaticResource PartialBg}"
                                        SelectedItem="{Binding ChipGroupStatusFilterSelectedItem}"
                                        VerticalOptions="Center">
                                        <SfChipGroup:SfChipGroup.Behaviors>
                                            <xct:EventToCommandBehavior Command="{Binding ChipGroupSelectedCommand}" EventName="SelectionChanged" />
                                        </SfChipGroup:SfChipGroup.Behaviors>
                                        <SfChipGroup:SfChipGroup.ItemTemplate>
                                            <DataTemplate>
                                                <StackLayout WidthRequest="80">
                                                    <Label
                                                        HorizontalOptions="FillAndExpand"
                                                        HorizontalTextAlignment="Center"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        StyleId="OnBoardText"
                                                        Text="{Binding Text}" />
                                                </StackLayout>
                                            </DataTemplate>
                                        </SfChipGroup:SfChipGroup.ItemTemplate>
                                    </SfChipGroup:SfChipGroup>


                                    <custom:CustomSfTextInputView x:Name="FrmDBO" HasError="{Binding FrameDOBError}">

                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                x:Name="DateEntry"
                                                FontFamily="{StaticResource SomarLight}"
                                                FontSize="Small"
                                                InputTransparent="True"
                                                IsReadOnly="True"
                                                Keyboard="Text"
                                                Placeholder="dd/MM/yyyy"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding DOBddyymm}"
                                                TextColor="{StaticResource Primary}">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <xct:EventToCommandBehavior Command="{Binding DateEntryTextChangedCommand}" EventName="TextChanged" />
                                                    <xct:EventToCommandBehavior Command="{Binding DatePickerUnfocusedCommand}" EventName="Unfocused" />
                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>
                                        </custom:CustomSfTextInputView.TextInputView>

                                        <custom:CustomSfTextInputView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="btnDate_Clicked" />
                                        </custom:CustomSfTextInputView.GestureRecognizers>

                                        <custom:CustomSfTextInputView.TrailingView>
                                            <Image
                                                Aspect="AspectFit"
                                                Source="greyCalender"
                                                Style="{StaticResource SmallIcon}" />
                                        </custom:CustomSfTextInputView.TrailingView>
                                    </custom:CustomSfTextInputView>

                                    <custom:CustomDatePicker
                                        x:Name="SignUpDOB"
                                        AcceptCommand="{Binding DOBOkButtonCommand}"
                                        Background="White"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="45"
                                        Mode="Dialog"
                                        SelectedItem="{Binding TodayDate}">

                                        <custom:CustomDatePicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                                        </custom:CustomDatePicker.ColumnHeaderView>

                                        <custom:CustomDatePicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </custom:CustomDatePicker.SelectedTextStyle>

                                        <custom:CustomDatePicker.SelectionView>
                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                        </custom:CustomDatePicker.SelectionView>


                                        <custom:CustomDatePicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="46"
                                                Background="White"
                                                Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </custom:CustomDatePicker.HeaderView>

                                        <custom:CustomDatePicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </custom:CustomDatePicker.FooterView>


                                    </custom:CustomDatePicker>

                                    <custom:CustomHijriDatePicker
                                        x:Name="SignUpDOBHijri"
                                        AcceptCommand="{Binding DOBOkButtonCommand}"
                                        Background="White"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="45"
                                        Mode="Dialog"
                                        SelectedItem="{Binding TodayDateinHijri}">

                                        <custom:CustomHijriDatePicker.SelectionView>
                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                        </custom:CustomHijriDatePicker.SelectionView>

                                        <custom:CustomHijriDatePicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                                        </custom:CustomHijriDatePicker.ColumnHeaderView>

                                        <custom:CustomHijriDatePicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="46"
                                                Background="White"
                                                Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />

                                        </custom:CustomHijriDatePicker.HeaderView>

                                        <custom:CustomHijriDatePicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </custom:CustomHijriDatePicker.SelectedTextStyle>

                                        <custom:CustomHijriDatePicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </custom:CustomHijriDatePicker.FooterView>

                                    </custom:CustomHijriDatePicker>
                                </StackLayout>

                                <!--  Name  -->
                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <custom:CustomSfTextInputView x:Name="FrmName">
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                x:Name="EntryName"
                                                FontFamily="{StaticResource SomarLight}"
                                                FontSize="Small"
                                                IsEnabled="{Binding IsEntryNameEnabled}"
                                                IsSpellCheckEnabled="False"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZZName}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding Name}">

                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:AlphabetandArabicCharacters />
                                                    <xct:EventToCommandBehavior Command="{Binding EntryNameTextChangedCommand}" EventName="TextChanged" />
                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>
                                        </custom:CustomSfTextInputView.TextInputView>
                                    </custom:CustomSfTextInputView>
                                </StackLayout>

                            </StackLayout>

                        </StackLayout>
                        <!--#endregion-->

                        <!--#region National Address-->
                        <StackLayout x:Name="NationalAddressView" IsVisible="{Binding NationalAddressView}">

                            <Label
                                Margin="10,0"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="22"
                                Style="{StaticResource GAZTMediumBoldBlackLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZNationalAddress}"
                                TextColor="{StaticResource PrimaryColor}"
                                VerticalOptions="Center" />

                            <Label
                                Margin="10,0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                FontSize="15"
                                Style="{StaticResource GAZTMediumGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />

                            <BoxView
                                Margin="10,10,10,15"
                                Style="{StaticResource lineSeperator}"
                                WidthRequest="380" />

                            <ScrollView VerticalScrollBarVisibility="Never">

                                <StackLayout>

                                    <!--  Country  -->
                                    <StackLayout IsVisible="{Binding SetCountryVisibility}">

                                        <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}">

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZZZCountry}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <custom:CustomSfTextInputView x:Name="Frame_Country">

                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="{Binding SetEnabilityToCountryList}"
                                                    IsReadOnly="{Binding SetEnabilityToCountryList}"
                                                    IsSpellCheckEnabled="False"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ZZZZCountry}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding CountryName}" />
                                            </custom:CustomSfTextInputView.TextInputView>


                                            <custom:CustomSfTextInputView.TrailingView>
                                                <Image Source="arrowDropdown.png" Style="{StaticResource SmallIcon}" />
                                            </custom:CustomSfTextInputView.TrailingView>

                                        </custom:CustomSfTextInputView>

                                    </StackLayout>

                                    <StackLayout IsVisible="{Binding SetGCCCountryVisibility}">

                                        <Label HorizontalOptions="Start" Style="{StaticResource GAZTSmallGrayLabelStyle}">

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource GAZTSmallGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZZZZCountry}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <custom:CustomSfTextInputView x:Name="GCCFrame_Country">

                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="GccCountryName"
                                                    FontSize="Small"
                                                    InputTransparent="{Binding SetEnabilityToCountryList}"
                                                    IsReadOnly="{Binding SetEnabilityToCountryList}"
                                                    IsSpellCheckEnabled="False"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ZZZZCountry}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding CountryName}">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <xct:EventToCommandBehavior Command="{Binding GccCountryNameTextChangedCommand}" EventName="TextChanged" />

                                                    </custom:GAZTBorderlessEntry.Behaviors>

                                                </custom:GAZTBorderlessEntry>
                                            </custom:CustomSfTextInputView.TextInputView>

                                            <custom:CustomSfTextInputView.TrailingView>
                                                <Image Source="arrowDropdown.png" Style="{StaticResource SmallIcon}" />
                                            </custom:CustomSfTextInputView.TrailingView>

                                            <custom:CustomSfTextInputView.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="GCCPickerBtn_Country_Clicked" />
                                            </custom:CustomSfTextInputView.GestureRecognizers>

                                        </custom:CustomSfTextInputView>

                                        <custom:CustomSfPicker
                                            x:Name="GCCPicker_Country"
                                            AcceptCommand="{Binding GCCCountryOkayButtonCommand}"
                                            Background="White"
                                            IsEnabled="{Binding SetEnabilityToCountryList}"
                                            IsVisible="{Binding SetGCCCountryVisibility}"
                                            ItemHeight="40"
                                            Mode="Dialog"
                                            SelectionChangedCommand="{Binding GCCPickerCountrySelectionChanged}">


                                            <syncfusion:SfPicker.TextStyle>
