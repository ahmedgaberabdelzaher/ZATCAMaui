<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.StylesTestUi.StyleTestUIPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    FlowDirection="LeftToRight"
    mc:Ignorable="d">
    <ContentPage.Content>
        <ScrollView Padding="0,15,0,15">
            <StackLayout Margin="10">
                <buttons:SfButton
                    x:Name="btnprimary"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="Primary" />
                <buttons:SfButton
                    x:Name="btnSecondary"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="Secondary" />
                <Label Style="{StaticResource PageTitleBlack}" Text="Page Title" />
                <Label Style="{StaticResource PageTitleGrey}" Text="Page Title" />

                <Label Style="{StaticResource SectionTitleBlack}" Text="Section Title" />
                <Label Style="{StaticResource SectionTitleGrey}" Text="Section Title" />

                <Label Style="{StaticResource ValueLabelBlack}" Text="Value Title" />
                <Label Style="{StaticResource ValueLabelGrey}" Text="Value Title" />

                <Label Style="{StaticResource BodyLabelBlack}" Text="Body Title" />
                <Label Style="{StaticResource BodyLabelGrey}" Text="Body Title" />

                <Label Style="{StaticResource CaptionLabelBlack}" Text="Caption Title" />
                <Label Style="{StaticResource CaptionLabelGrey}" Text="Caption Title" />
                <!--  Income card  -->
                <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                    <Grid Padding="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="-3">
                            <Label Style="{StaticResource ValueLabelBlack}" Text="Individual Zakat" />
                            <Label Style="{StaticResource CaptionLabelGrey}" Text=" Zakat" />
                        </StackLayout>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Border
                                Padding="10,10,10,10"
                                BackgroundColor="AliceBlue"
                                HorizontalOptions="End"
                                StrokeShape="RoundRectangle 20,20,20,20"
                                StrokeThickness="1"
                                VerticalOptions="CenterAndExpand">
                                <Label
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="Submitted"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="CenterAndExpand" />
                            </Border>
                        </StackLayout>
                    </Grid>
                </Border>
                <!--  Income card  -->


                <!--  ListIconLeftCard  -->

                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                        <Image>
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                    Size="25"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource ValueLabelGrey}"
                            Text="TIN Number" />
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="3101503102" />

                        </StackLayout>
                    </StackLayout>
                </Border>
                <!--  ListIconLeftCard  -->
                <!--  ListIconRightCard  -->
                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">

                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource ValueLabelGrey}"
                            Text="TIN Number" />
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="3101503102" />
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="UserIconFont"
                                        Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                        Size="25"
                                        Color="{StaticResource SecondaryNew}" />
                                </Image.Source>
                            </Image>

                        </StackLayout>
                    </StackLayout>
                </Border>
                <!--  ListIconRightCard  -->
                <!--  Distributive  -->
                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                        <Image>
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                    Size="25"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource ValueLabelBlack}"
                            Text="TIN Number" />
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="UserIconFont"
                                        Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                        Size="25"
                                        Color="{StaticResource SecondaryNew}" />
                                </Image.Source>
                            </Image>

                        </StackLayout>
                    </StackLayout>
                </Border>
                <!--  Distributive  -->
                <!--  Summery  -->
                <Frame
                    Margin="0,10,0,10"
                    Padding="0"
                    BackgroundColor="AliceBlue"
                    BorderColor="AliceBlue"
                    CornerRadius="8"
                    HasShadow="False">
                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                        <Image>
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                    Size="25"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource ValueLabelBlack}"
                            Text="TIN Number" />
                    </StackLayout>
                </Frame>
                <!--  Summery  -->
                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                        <Image>
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.PlusCircleOutline}"
                                    Size="25"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource ValueLabelPrimary}"
                            Text="TIN Number" />
                    </StackLayout>
                </Border>
                <!--  Total Small  -->
                <Frame
                    Margin="0,10,0,10"
                    Padding="0"
                    BackgroundColor="AliceBlue"
                    BorderColor="AliceBlue"
                    CornerRadius="8"
                    HasShadow="False">
                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource ValueLabelBlack}"
                            Text="Total"
                            VerticalTextAlignment="Center" />
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="Amount" />
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="UserIconFont"
                                        Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                        Size="25"
                                        Color="{StaticResource SecondaryNew}" />
                                </Image.Source>
                            </Image>
                        </StackLayout>
                    </StackLayout>
                </Frame>
                <!--  Total Small  -->

                <!--  Inbox Unread  -->
                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <Grid Padding="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="-3">
                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="Message Title" />
                            <Label Style="{StaticResource CaptionLabelGrey}" Text=" Date" />
                        </StackLayout>

                        <Label
                            x:Name="Image_backArrow"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10,0,10,0"
                            HorizontalOptions="End"
                            Rotation="180"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{StaticResource Back}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnBackButtonClick}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </Grid>
                </Border>
                <!--  Inbox Unread  -->
                <!--  inbod read  -->
                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <Grid Padding="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="-3">
                            <Label Style="{StaticResource BodyLabelBlack}" Text="Message Title" />
                            <Label Style="{StaticResource CaptionLabelGrey}" Text=" Date" />
                        </StackLayout>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10,0,10,0"
                            HorizontalOptions="End"
                            Rotation="180"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{StaticResource Back}"
                            VerticalOptions="Center" />

                    </Grid>
                </Border>
                <!--  inbod read  -->





                <!--  My Bills template UI Starts  -->
                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout Padding="0">
                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="-10">
                                <Label
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="ZAKAT"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontSize="Small"
                                    Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                    Text="Amendment by Gazt"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">
                                <Border
                                    Padding="10,10,10,10"
                                    BackgroundColor="AliceBlue"
                                    HorizontalOptions="End"
                                    StrokeShape="RoundRectangle 20,20,20,20"
                                    StrokeThickness="1"
                                    VerticalOptions="CenterAndExpand">
                                    <Label
                                        HorizontalOptions="CenterAndExpand"
                                        Text="Submitted"
                                        VerticalOptions="CenterAndExpand" />
                                </Border>
                            </StackLayout>
                        </Grid>
                        <BoxView
                            BackgroundColor="LightGray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand" />
                        <Grid Padding="10,10,10,10" RowSpacing="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="Medium"
                                Text="1200.00 SAR"
                                TextColor="{StaticResource PrimaryColor}"
                                VerticalOptions="CenterAndExpand" />
                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Spacing="-5">
                                <Label Style="{StaticResource CaptionLabelGrey}" Text="SADAD Number" />
                                <Label Style="{StaticResource ValueLabelBlack}" Text="SADAD Number" />
                            </StackLayout>
                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="1"
                                Spacing="-5">
                                <Label Style="{StaticResource CaptionLabelGrey}" Text="SADAD Number" />
                                <Label Style="{StaticResource ValueLabelBlack}" Text="SADAD Number" />
                            </StackLayout>
                        </Grid>

                    </StackLayout>
                </Border>
                <!--  My Bills template UI Ends  -->
                <cards:SfCardView
                    Margin="0,10,0,10"
                    Padding="10"
                    BackgroundColor="White"
                    CornerRadius="10">
                    <StackLayout>
                        <StackLayout Orientation="Horizontal">
                            <Label
                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                Text="VAT"
                                VerticalOptions="Center" />
                            <Label
                                Style="{StaticResource GAZTMicroGrayLabel}"
                                Text="4793187498192"
                                TextColor="{StaticResource NewWarmGreyColor}"
                                VerticalOptions="Center" />
                            <Label
                                Padding="80,0,0,0"
                                HorizontalOptions="EndAndExpand"
                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                Text="200.000,00 SAR" />
                        </StackLayout>

                        <!--  Progress Bar SF  -->

                        <progressBar:SfLinearProgressBar
                            HeightRequest="5"
                            Progress="100"
                            ProgressCornerRadius="5">

                            <progressBar:SfLinearProgressBar.GradientStops>

                                <progressBar:ProgressGradientStop Color="{StaticResource NewDarkBlueGreenColor}" Value="0" />
                                <progressBar:ProgressGradientStop Color="{StaticResource NewProgressLightGreenColor}" Value="65" />
                                <progressBar:ProgressGradientStop Color="LightGray" Value="100" />


                            </progressBar:SfLinearProgressBar.GradientStops>

                        </progressBar:SfLinearProgressBar>

                        <!--  Progress Bar SF  -->
                        <Label
                            Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                            Text="Next Payment"
                            VerticalOptions="Center" />

                        <StackLayout Orientation="Horizontal">
                            <Label
                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                Text="24 January"
                                VerticalOptions="Center" />

                            <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="Center">
                                <BoxView
                                    BackgroundColor="{StaticResource NewProgressLightGreenColor}"
                                    CornerRadius="5"
                                    HeightRequest="10"
                                    WidthRequest="10" />
                            </StackLayout>

                            <Label
                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                Text="10.000,00 SAR"
                                VerticalOptions="Center" />
                        </StackLayout>
                    </StackLayout>
                </cards:SfCardView>
                <!--  slider  -->
                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout Padding="15">
                        <Label
                            Style="{StaticResource ValueLabelBlack}"
                            Text="What will be your total VAT taxable sales value in upcoming 12 months?"
                            VerticalOptions="Center" />
                        <Label
                            HorizontalTextAlignment="Start"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="10,000 SAR" />
                        <Border
                            Margin="0,10,0,0"
                            BackgroundColor="#eaeaea"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Slider
                                x:Name="Slider_Answer1"
                                Margin="0,10,0,10"
                                HorizontalOptions="FillAndExpand"
                                Maximum="{Binding MaximumValueOfSlider1}"
                                MaximumTrackColor="{StaticResource Primary}"
                                Minimum="0"
                                MinimumTrackColor="{StaticResource Primary}" />
                        </Border>
                        <StackLayout
                            Margin="0,5,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                HorizontalTextAlignment="Start"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="Less Than" />
                            <Label
                                HorizontalOptions="EndAndExpand"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="Greater Than" />
                        </StackLayout>
                    </StackLayout>
                </Border>
                <!--  slider  -->
                <cards:SfCardView
                    Margin="0,10,0,0"
                    BackgroundColor="White"
                    CornerRadius="10"
                    HorizontalOptions="Start">
                    <StackLayout Orientation="Horizontal">
                        <cards:SfCardView
                            BackgroundColor="{StaticResource Secondary}"
                            CornerRadius="10"
                            HeightRequest="60"
                            WidthRequest="60">
                            <StackLayout
                                HorizontalOptions="Center"
                                Spacing="0"
                                VerticalOptions="Center">
                                <Label Text="03" TextColor="White" />
                                <Label Text="Jul" TextColor="White" />
                            </StackLayout>
                        </cards:SfCardView>
                        <StackLayout Padding="10,5,10,5" Spacing="-5">
                            <Label Style="{StaticResource ValueLabelBlackBold}" Text="Paid Bill" />
                            <Label Style="{StaticResource BodyLabelBlack}" Text="200,000,00 SAR" />
                        </StackLayout>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10,0,10,0"
                            HorizontalOptions="End"
                            Rotation="180"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{StaticResource Back}"
                            VerticalOptions="Center" />
                    </StackLayout>
                </cards:SfCardView>
                <cards:SfCardView
                    Margin="0,10,0,0"
                    BackgroundColor="White"
                    CornerRadius="10"
                    HorizontalOptions="Start">
                    <StackLayout Orientation="Horizontal">
                        <cards:SfCardView
                            BackgroundColor="{StaticResource Primary}"
                            CornerRadius="10"
                            HeightRequest="60"
                            WidthRequest="60" />

                        <StackLayout Padding="10,5,10,5" Spacing="-5">
                            <Label Style="{StaticResource ValueLabelBlackBold}" Text="Gazt" />
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="Twitter" />
                        </StackLayout>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10,0,10,0"
                            HorizontalOptions="End"
                            Rotation="180"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{StaticResource Back}"
                            VerticalOptions="Center" />
                    </StackLayout>
                </cards:SfCardView>

                <inputLayout:SfTextInputLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,10,0,-6"
                    ContainerType="Outlined"
                    HorizontalOptions="FillAndExpand"
                    IsHintAlwaysFloated="True"
                    OutlineCornerRadius="8"
                    Stroke="{StaticResource Primary}"
                    TrailingViewPosition="Inside">
                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <inputLayout:LabelStyle TextColor="#B00020" />
                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <custom:GAZTBorderlessEntry
                        HeightRequest="51"
                        Keyboard="Numeric"
                        MaxLength="4"
                        Placeholder="Enter OTP"
                        Style="{StaticResource DefaultEntry}"
                        VerticalTextAlignment="End" />


                    <inputLayout:SfTextInputLayout.TrailingView>
                        <Image HorizontalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.Eye}"
                                    Size="25"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                    </inputLayout:SfTextInputLayout.TrailingView>

                </inputLayout:SfTextInputLayout>


                <inputLayout:SfTextInputLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0"
                    ContainerType="Outlined"
                    HorizontalOptions="FillAndExpand"
                    IsHintAlwaysFloated="True"
                    LeadingViewPosition="Inside"
                    OutlineCornerRadius="8"
                    Stroke="{StaticResource Primary}"
                    TrailingViewPosition="Inside">
                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <inputLayout:LabelStyle TextColor="#B00020" />
                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <inputLayout:SfTextInputLayout.LeadingView>
                        <Image HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                    Size="20"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                    </inputLayout:SfTextInputLayout.LeadingView>
                    <custom:GAZTBorderlessEntry
                        HeightRequest="51"
                        Placeholder="Text here"
                        Style="{StaticResource DefaultEntry}" />
                    <inputLayout:SfTextInputLayout.TrailingView>
                        <Image HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                    Size="16"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>

                        </Image>
                    </inputLayout:SfTextInputLayout.TrailingView>


                </inputLayout:SfTextInputLayout>

                <Frame
                    Margin="0,10,0,0"
                    Padding="0"
                    BorderColor="#B1B1B1"
                    CornerRadius="8"
                    HasShadow="False"
                    HeightRequest="50">
                    <Grid Padding="5" ColumnSpacing="2">
                        <Grid.RowDefinitions>

                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="14*" />
                            <ColumnDefinition Width="17*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="17*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="17*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="17*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            Source="icon.png" />
                        <custom:GAZTBorderlessEntry
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalTextAlignment="Center"
                            Keyboard="Telephone"
                            MaxLength="4"
                            Placeholder="0000"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding MobileNumber}" />
                        <BoxView
                            Grid.Row="0"
                            Grid.Column="3"
                            BackgroundColor="LightGray"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            WidthRequest="0.1" />

                        <custom:GAZTBorderlessEntry
                            Grid.Row="0"
                            Grid.Column="4"
                            HorizontalTextAlignment="Center"
                            Keyboard="Telephone"
                            MaxLength="4"
                            Placeholder="0000"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding MobileNumber}" />
                        <BoxView
                            Grid.Row="0"
                            Grid.Column="5"
                            BackgroundColor="LightGray"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            WidthRequest="0.1" />


                        <custom:GAZTBorderlessEntry
                            Grid.Row="0"
                            Grid.Column="6"
                            HorizontalTextAlignment="Center"
                            Keyboard="Telephone"
                            MaxLength="4"
                            Placeholder="0000"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding MobileNumber}" />
                        <BoxView
                            Grid.Row="0"
                            Grid.Column="7"
                            BackgroundColor="LightGray"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            WidthRequest="0.1" />

                        <custom:GAZTBorderlessEntry
                            Grid.Row="0"
                            Grid.Column="8"
                            BackgroundColor="White"
                            HorizontalTextAlignment="Center"
                            Keyboard="Telephone"
                            MaxLength="4"
                            Placeholder="0000"
                            PlaceholderColor="Gray"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding MobileNumber}" />

                    </Grid>
                </Frame>

                <!--  Range Input Box  -->
                <!--<Label Text="Label" Style="{StaticResource GAZTMicroGrayLabel}" Margin="10"/>-->
                <Frame
                    Margin="0,10,0,0"
                    Padding="0"
                    BorderColor="#B1B1B1"
                    CornerRadius="8"
                    HasShadow="False"
                    HeightRequest="50">
                    <Grid Padding="5" ColumnSpacing="2">
                        <Grid.RowDefinitions>

                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40*" />
                            <ColumnDefinition Width="10*" />
                            <ColumnDefinition Width="40*" />
                            <ColumnDefinition Width="10*" />
                        </Grid.ColumnDefinitions>

                        <custom:GAZTBorderlessEntry
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="White"
                            Keyboard="Telephone"
                            MaxLength="4"
                            Placeholder="From"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding MobileNumber}" />
                        <Image
                            Grid.Row="0"
