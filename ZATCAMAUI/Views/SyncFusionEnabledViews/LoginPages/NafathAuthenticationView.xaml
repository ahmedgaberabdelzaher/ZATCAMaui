<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.NafathAuthenticationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:buttons="http://schemas.syncfusion.com/maui"
    x:Name="page"
    Title="NafathAuthenticationView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

     <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingNafathAuthenticationViewCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

              <!--#region Header-->
            <Grid Padding="15,10" ColumnDefinitions="*,4*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NafathLoginHeader}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,35,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="20" VerticalOptions="FillAndExpand">

                        <!--  OpenNafath/Confirm Openning Nafath Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            LineBreakMode="WordWrap"
                            LineHeight="1"
                            Text="{x:Static ResourceManager:AppResources.ApproveInNafathApp}"
                            TextColor="#002447"/>



                        <!--  Horizontal Line  -->
                        <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="2" />

                        <!--  ConfirmOpenningNafath Label  -->
                        <Border
                            Margin="0,30,0,0"
                            Padding="10"
                            HeightRequest="50"
                            HorizontalOptions="CenterAndExpand"
                            Stroke="Black"
                            StrokeShape="RoundRectangle 20,20,20,20"
                            VerticalOptions="Start"
                            WidthRequest="50">

                            <!--  ConfirmOpenningNafath Label  -->
                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="20"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                Text="{Binding AuthenticationNumber}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="CenterAndExpand"
                                VerticalTextAlignment="Center" />

                        </Border>

                         <Label
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ApproveInNafathApp}"
                            VerticalOptions="CenterAndExpand" />

                        <!--  Cancel Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            Background="Transparent"
                            Command="{Binding CancelCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Stroke="Transparent"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.CancelText}"
                            TextColor="{StaticResource Secondary}" />

                    </StackLayout>

                </ScrollView>

            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />


        </Grid>
    </ContentPage.Content>
</ContentPage>