<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.NafathAuthenticationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:buttons="http://schemas.syncfusion.com/maui"
    x:Name="page"
    Title="NafathAuthenticationView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NafathAuthentication}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <StackLayout
                    Padding="24"
                    Spacing="24"
                    VerticalOptions="CenterAndExpand">
                    <Border
                        BackgroundColor="{StaticResource TiffanyBG}"
                        HorizontalOptions="Center"
                        Stroke="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 30">
                        <Label
                            FontSize="Large"
                            Padding="20"
                            Text="{Binding AuthenticationNumber}"
                            TextColor="{StaticResource Primary}" />
                    </Border>
                    <Label
                        HorizontalOptions="CenterAndExpand"
                        Text="{x:Static ResourceManager:AppResources.ApproveInNafathApp}"
                        VerticalOptions="CenterAndExpand" />
                    
                    <buttons:SfButton
                        StrokeThickness="1.5"
                        Command="{Binding CancelCommand}"
                        CornerRadius="15"
                        Text="{x:Static ResourceManager:AppResources.CancelText}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                </StackLayout>

            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />


        </Grid>
    </ContentPage.Content>
</ContentPage>