<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.OTPPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    x:Name="page"
    Title="OTPPageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding StartTimerCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid
            HorizontalOptions="FillAndExpand"
            RowDefinitions="Auto,*"
            VerticalOptions="FillAndExpand">

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="FillAndExpand">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="30">

                        <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                            <!--  Logo Image  -->
                            <Image
                                Grid.Column="1"
                                HeightRequest="45"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="40" />


                            <StackLayout Grid.Column="2">

                                <!--  Close Image  -->
                                <Image
                                    HorizontalOptions="EndAndExpand"
                                    Rotation="0"
                                    Source="darkClose.png"
                                    
                                    VerticalOptions="CenterAndExpand" />

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                                </StackLayout.GestureRecognizers>

                            </StackLayout>

                        </Grid>

                        <!--  Header Label  -->
                        <Label
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="28"
                            Text="{x:Static ResourceManager:AppResources.VerificationCodeTitle}"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            TextColor="#002447"
                            VerticalOptions="Start" />

                        <!--  OTP msg Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="{x:Static ResourceManager:AppResources.OTPPageDescription}"
                            TextColor="#999999"
                            VerticalOptions="Start" />


                        <!--  Horizontal Line  -->
                        <BoxView
                            BackgroundColor="#EBEBEB"
                            HeightRequest="1"
                            VerticalOptions="Start" />


                        <!--  OTP msg Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="{Binding OTPSentOnThisMobileNumber}"
                            TextColor="#999999"
                            VerticalOptions="Start" />


                        <Grid
                            Padding="0"
                            ColumnDefinitions="55,55,55,55"
                            ColumnSpacing="20"
                            FlowDirection="LeftToRight"
                            HorizontalOptions="CenterAndExpand"
                            RowDefinitions="65"
                            VerticalOptions="Start">

                            <!--  First OTP  -->
                            <Border
                                HeightRequest="50"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Start"
                                WidthRequest="50">

                                <custom:GAZTBorderlessEntry
                                    x:Name="firstEntry"
                                    ClassId="1"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Next"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPFirstDigit}"
                                    TextColor="#0996D4"
                                    WidthRequest="100">

                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behavior:OnlyNumericValuesBehaviour />
                                        <xct:EventToCommandBehavior
                                            Command="{Binding GoToNextEntryCommand}"
                                            CommandParameter="{Binding Source={x:Reference secondEntry}}"
                                            EventName="TextChanged" />
                                    </custom:GAZTBorderlessEntry.Behaviors>

                                </custom:GAZTBorderlessEntry>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference firstEntry}}" />
                                </Border.GestureRecognizers>

                            </Border>

                            <!--  Second OTP  -->
                            <Border
                                Grid.Column="1"
                                HeightRequest="50"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Start"
                                WidthRequest="50">

                                <custom:GAZTBorderlessEntry
                                    x:Name="secondEntry"
                                    ClassId="2"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Next"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPSecondDigit}"
                                    TextColor="#0996D4"
                                    WidthRequest="100">

                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behavior:OnlyNumericValuesBehaviour />
                                        <xct:EventToCommandBehavior
                                            Command="{Binding GoToNextEntryCommand}"
                                            CommandParameter="{Binding Source={x:Reference thirdEntry}}"
                                            EventName="TextChanged" />
                                    </custom:GAZTBorderlessEntry.Behaviors>

                                </custom:GAZTBorderlessEntry>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference secondEntry}}" />
                                </Border.GestureRecognizers>

                            </Border>

                            <!--  Third OTP  -->
                            <Border
                                Grid.Column="2"
                                HeightRequest="50"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Start"
                                WidthRequest="50">

                                <custom:GAZTBorderlessEntry
                                    x:Name="thirdEntry"
                                    ClassId="3"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Next"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPThirdDigit}"
                                    TextColor="#0996D4"
                                    WidthRequest="100">

                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behavior:OnlyNumericValuesBehaviour />
                                        <xct:EventToCommandBehavior
                                            Command="{Binding GoToNextEntryCommand}"
                                            CommandParameter="{Binding Source={x:Reference fourthEntry}}"
                                            EventName="TextChanged" />
                                    </custom:GAZTBorderlessEntry.Behaviors>

                                </custom:GAZTBorderlessEntry>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference thirdEntry}}" />
                                </Border.GestureRecognizers>

                            </Border>

                            <!--  Fourth OTP  -->
                            <Border
                                Grid.Column="3"
                                HeightRequest="50"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Start"
                                WidthRequest="50">

                                <custom:GAZTBorderlessEntry
                                    x:Name="fourthEntry"
                                    ClassId="4"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Go"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPFourthDigit}"
                                    TextColor="#0996D4"
                                    WidthRequest="100">

                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behavior:OnlyNumericValuesBehaviour />
                                        <xct:EventToCommandBehavior Command="{Binding VerifyOTPCommand}" EventName="Completed" />
                                    </custom:GAZTBorderlessEntry.Behaviors>

                                </custom:GAZTBorderlessEntry>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference fourthEntry}}" />
                                </Border.GestureRecognizers>

                            </Border>

                        </Grid>

                        <StackLayout
                            HorizontalOptions="Center"
                            Orientation="Horizontal"
                            Spacing="20">

                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                Text="{Binding LblCountDownTimer}"
                                TextColor="#999999" />

                            <Image
                                HeightRequest="25"
                                Source="clock"
                                WidthRequest="25" />

                        </StackLayout>

                         <Label
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="20"
                            Text="{x:Static ResourceManager:AppResources.AccountLockedMsg}"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            TextColor="#002447"
                            VerticalOptions="Start" />

                        <!--  Resend msg Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            IsEnabled="{Binding IsResendCodeEnabled}"
                            TextColor="{Binding ResendCodeTextColor}"
                            Opacity="{Binding ResendCodeOpacity}"
                            Text="{x:Static ResourceManager:AppResources.ResendVerificationCodeMsg}"
                            TextDecorations="Underline"
                            VerticalOptions="Start">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ResendOtpCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </StackLayout>

                </ScrollView>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>