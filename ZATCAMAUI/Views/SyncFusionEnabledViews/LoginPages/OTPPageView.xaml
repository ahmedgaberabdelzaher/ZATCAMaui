<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.OTPPageView"
             Title="OTPPageView"
            xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Name="page"
            ios:Page.UseSafeArea="true"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">
     <ContentPage.Content>
        <Grid>
            <Grid x:Name="otpGrid" Margin="{OnPlatform  Android='0,-40,0,0', iOS='0,-50,0,-35'}">
                <!--/* please dont remove UWP it gives error on run time */-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackLayout Orientation="Vertical">
                    <Image Source="Burger" x:Name="HamburgerMenu" Style="{StaticResource SmallIcon}" 
                       VerticalOptions="Start"
                HorizontalOptions="EndAndExpand"
                        Margin="10,55,10,0">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding HamburgerMenuClickedCommand}" NumberOfTapsRequired="1"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Grid VerticalOptions="Start">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Image Grid.Row="0" BackgroundColor="Transparent" Source="zatcaLogo.png" HorizontalOptions="Center" HeightRequest="100" WidthRequest="100" />
                        <StackLayout Grid.Row="1" BackgroundColor="Transparent" Margin="25,0,0,0" Orientation="Vertical">
                            <Label x:Name="VerificationCodeTitle" Margin="0,0,25,0" FontSize="Large" TextColor="LightSeaGreen" Opacity="1.3" Grid.Row="0" />
                            <Label x:Name="OTPPageDescription" Margin="0,3,25,0"  FontSize="12" TextColor="white"  Opacity="0.8"/>
                            <BoxView  HeightRequest="1" Margin="0,3,35,0" BackgroundColor="Gray" Opacity="0.3"  VerticalOptions="Center" HorizontalOptions="StartAndExpand" WidthRequest="500" Grid.RowSpan="3"/>
                            <Label x:Name="OTPErrorMsg"  Margin="0,10,35,0" HeightRequest="20"  FontSize="12" BackgroundColor="LightPink" TextColor="Red" Opacity="1.3" VerticalOptions="Center" IsVisible="{Binding LoginError}"/>
                            <Label Margin="0,3,25,0" FontSize="12" Style="{StaticResource CaptionLabelWhite}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span x:Name="MobileNumber"  TextColor="{StaticResource SuccessColor}"/>
                                        <Span Text=" "/>
                                        <Span x:Name="MobileNumberTxt" Text="xxxxxx2226"></Span>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0" HorizontalOptions="CenterAndExpand" VerticalOptions="Start">
                            <Border HorizontalOptions="FillAndExpand" HeightRequest="40" WidthRequest="40"  Padding="0" StrokeShape="RoundRectangle 5" Margin="5"  >
                                <custom:GAZTBorderlessEntry BackgroundColor="White" HeightRequest="35" WidthRequest="35"  x:Name="Step1" HorizontalTextAlignment="Center" IsPassword="true" TextChanged="Step1_TextChanged" MaxLength="1" TextColor="black" HorizontalOptions="CenterAndExpand" PlaceholderColor="Black" Margin="1,1,1,1"  Opacity="1"/>
                            </Border>
                            <Border HorizontalOptions="FillAndExpand" HeightRequest="40" WidthRequest="40"  Padding="0" StrokeShape="RoundRectangle 5" Margin="5" >
                                <custom:GAZTBorderlessEntry BackgroundColor="White"  HeightRequest="35" WidthRequest="35"  x:Name="Step2" HorizontalTextAlignment="Center" IsPassword="true" TextChanged="Step2_TextChanged" MaxLength="1" TextColor="black" HorizontalOptions="CenterAndExpand" PlaceholderColor="Black" Margin="1,1,1,1"  Opacity="1"/>
                            </Border>
                            <Border HorizontalOptions="FillAndExpand" HeightRequest="40" WidthRequest="40"  Padding="0" StrokeShape="RoundRectangle 5" Margin="5" >
                                <custom:GAZTBorderlessEntry BackgroundColor="White" HeightRequest="35" WidthRequest="35"  x:Name="Step3" HorizontalTextAlignment="Center" IsPassword="true" TextChanged="Step3_TextChanged"  MaxLength="1" TextColor="black" HorizontalOptions="Center" PlaceholderColor="Black" Margin="1,1,1,1"  Opacity="1"/>
                            </Border>
                            <Border HorizontalOptions="FillAndExpand" HeightRequest="40" WidthRequest="40"  Padding="0" StrokeShape="RoundRectangle 5" Margin="5" >
                                <custom:GAZTBorderlessEntry BackgroundColor="White" HeightRequest="35" WidthRequest="35"  x:Name="Step4" HorizontalTextAlignment="Center" IsPassword="true" TextChanged="Step4_TextChanged" MaxLength="1" TextColor="black" HorizontalOptions="Center" PlaceholderColor="Black" Margin="1,1,1,1"  Opacity="1"/>
                            </Border>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Grid.Row="3" HorizontalOptions="CenterAndExpand" Margin="0,20,0,0" VerticalOptions="Start">
                            <Image Source="partially_clock" Style="{StaticResource SmallIcon}" Margin="5" HeightRequest="20" WidthRequest="20"/>
                            <Label x:Name="ResendTimer" TextColor="White" Opacity="1.3" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="12" />
                        </StackLayout>
                        <Label x:Name="AccountLockedText"  Margin="25,20,25,0" Grid.Row="4" TextColor="LightSeaGreen" Opacity="1.3" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="14" />
                        <Label x:Name="ResendCodeText"   Margin="25,40,25,0" Grid.Row="5" Opacity="1.0" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" TextColor="Gray" FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Resent_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>