<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.SFLoginPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls"
    Title="Login"
    FlowDirection="{Binding AppDirection}"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <Grid>

            <Grid x:Name="loginGrid"
                  RowDefinitions="100*"
                  ColumnDefinitions="100*">

                <controls:Loader IsVisible="{Binding IsLoading}"/>

            </Grid>

            <StackLayout
                x:Name="sessionExpiredView"
                Margin="0"
                BackgroundColor="Transparent"
                IsVisible="false">
                <StackLayout
                    Padding="40"
                    BackgroundColor="Transparent"
                    VerticalOptions="CenterAndExpand">
                    <Image Aspect="AspectFit" Source="errorNew.png" />
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.Information}"
                        TextColor="White" />
                    <Label
                        FontFamily="{StaticResource SomarSemiBold}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.ZYourSessionhasexpiredPleaseLoginagain}"
                        TextColor="White" />
                </StackLayout>

                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="30,60,30,80"
                    HorizontalOptions="Center"
                    VerticalOptions="End">
                    <buttons:SfButton
                        x:Name="btnLogin"
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,16"
                        Clicked="btnLoginClicked"
                        HeightRequest="46"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.LoginTitle}" />
                </StackLayout>
            </StackLayout>

           <controls:BottomMenu VerticalOptions="EndAndExpand"
                                HorizontalOptions="Fill"/>

        </Grid>
    </ContentPage.Content>
</ContentPage>