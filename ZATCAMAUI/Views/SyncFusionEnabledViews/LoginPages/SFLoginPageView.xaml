<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.SFLoginPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Name="page"
    Title="Login"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <Grid RowDefinitions="*">

            <StackLayout
                Padding="10,0"
                Spacing="20">

                <!--  Back Button  -->
                <Image
                    Margin="40,10"
                    HeightRequest="75"
                    HorizontalOptions="Center"
                    Source="zatcaLogo.png"
                    VerticalOptions="Start"
                    WidthRequest="75" />

                <Label
                    x:Name="loginLabel"
                    FontSize="Large"
                    HorizontalOptions="Start"
                    Opacity="1.3"
                    TextColor="LightSeaGreen" />

                <Label
                    x:Name="WelcomeLabel"
                    FontSize="Small"
                    Opacity="0.8"
                    TextColor="white" />

                <BoxView
                    BackgroundColor="Gray"
                    HeightRequest="1"
                    HorizontalOptions="StartAndExpand"
                    Opacity="0.3"
                    VerticalOptions="Center"
                    WidthRequest="500" />

                <Label
                    x:Name="LoginErrorLabel"
                    BackgroundColor="LightPink"
                    FontSize="12"
                    HeightRequest="20"
                    IsVisible="{Binding LoginError}"
                    Opacity="1.3"
                    Text="{Binding LoginErrorMsg}"
                    TextColor="Red"
                    VerticalOptions="Center" />

                <!--  Tin/Email Entry  -->
                <custom:CustomSfTextInputView>
                    <custom:CustomSfTextInputView.TextInputView>

                        <custom:GAZTBorderlessEntry
                            x:Name="LoginTin"
                            Focused="LoginTin_Focused"
                            Placeholder="{x:Static ResourceManager:AppResources.TINPlaceholder}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding TIN}"
                            TextColor="#58595B"
                            Unfocused="LoginTin_Unfocused" />



                    </custom:CustomSfTextInputView.TextInputView>
                    <custom:CustomSfTextInputView.LeadingView>
                        <Image Aspect="AspectFit" Source="user_profile.png" />

                    </custom:CustomSfTextInputView.LeadingView>
                </custom:CustomSfTextInputView>


                <!--  PleaseSelectTIN Drop-Down  -->
                <custom:CustomSfTextInputView IsVisible="{Binding IsTinDropdownVisible}">
                    <custom:CustomSfTextInputView.TextInputView>
                        <custom:GAZTBorderlessEntry
                            InputTransparent="True"
                            IsReadOnly="True"
                            Keyboard="Text"
                            Placeholder="{x:Static ResourceManager:AppResources.PleaseSelectTIN}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding SelectedTin}"
                            TextColor="#58595B">
                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowTinsPickerCommand}" />
                            </custom:GAZTBorderlessEntry.GestureRecognizers>
                        </custom:GAZTBorderlessEntry>

                    </custom:CustomSfTextInputView.TextInputView>
                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowTinsPickerCommand}" />
                    </inputLayout:SfTextInputLayout.GestureRecognizers>

                    <inputLayout:SfTextInputLayout.TrailingView>

                        <Image Aspect="AspectFit" Source="greyDropDown" />
                    </inputLayout:SfTextInputLayout.TrailingView>

                    <inputLayout:SfTextInputLayout.LeadingView>

                        <Image Aspect="AspectFit" Source="user_profile.png" />
                    </inputLayout:SfTextInputLayout.LeadingView>
                </custom:CustomSfTextInputView>


                <!--  Password Entry  -->
                <custom:CustomSfTextInputView>
                    <custom:CustomSfTextInputView.TextInputView>

                        <custom:GAZTBorderlessEntry
                            x:Name="LoginPassword"
                            IsPassword="true"
                            Placeholder="{x:Static ResourceManager:AppResources.PasswordPlaceholder}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding Password}"
                            TextColor="#58595B" />



                    </custom:CustomSfTextInputView.TextInputView>
                    <custom:CustomSfTextInputView.LeadingView>
                        <Image Aspect="AspectFit" Source="password_key.png" />

                    </custom:CustomSfTextInputView.LeadingView>
                </custom:CustomSfTextInputView>

                <Label
                    x:Name="forgotPasswordLabel"
                    FontSize="Small"
                    TextColor="white">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label
                    x:Name="changeMobileNumberLabel"
                    FontSize="Small"
                    TextColor="white">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangeMCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label
                    x:Name="loginLineLabel"
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="Small"
                    TextColor="white">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding WebLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <buttons:SfButton
                    x:Name="loginBtn"
                    Command="{Binding LoginClickedCommand}"
                    CornerRadius="15"
                    FontSize="Medium"
                    StrokeThickness="1.5"
                    Style="{StaticResource PrimaryButtonStyle}"
                    TextColor="White"
                    VerticalOptions="Center" />

                <Label
                    x:Name="registerLabel"
                    FontSize="Small"
                    HorizontalOptions="CenterAndExpand"
                    Opacity="0.8"
                    Margin="0"
                    TextColor="LightGreen">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SignUpCommand}" />
                    </Label.GestureRecognizers>

                </Label>

            </StackLayout>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <custom:BottomMenu Grid.Row="2" VerticalOptions="EndAndExpand" />

        </Grid>
    </ContentPage.Content>
</ContentPage>