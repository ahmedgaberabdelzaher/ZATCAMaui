<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.SFLoginPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    Title="Login"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
     xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls" xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    FlowDirection="{Binding AppDirection}"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <!--  Back Button  -->
            <Image
                HorizontalOptions="Center"
                Source="zatcaLogo.png"
                Margin="40,10"
                WidthRequest="75"
                HeightRequest="75"
                VerticalOptions="Start"/>
            <!--#endregion Header-->

            <StackLayout Grid.Row="1"
                         Padding="10,0" Spacing="20">

                     <Label x:Name="loginLabel"  FontSize="Large" TextColor="LightSeaGreen" Opacity="1.3" HorizontalOptions="Start" />

                    <Label x:Name="WelcomeLabel" FontSize="Small" TextColor="white"
                            Opacity="0.8"/>

                    <BoxView  HeightRequest="1" BackgroundColor="Gray" Opacity="0.3" VerticalOptions="Center" HorizontalOptions="StartAndExpand" WidthRequest="500"
                                />

                    <Label x:Name="LoginErrorLabel" Text="{Binding LoginErrorMsg}"
                            HeightRequest="20"  FontSize="12" BackgroundColor="LightPink" TextColor="Red" Opacity="1.3" VerticalOptions="Center" IsVisible="{Binding LoginError}"/>

                    <!--  Tin/Email Entry  -->
                    <custom:CustomSfTextInputView>
                        <custom:CustomSfTextInputView.TextInputView>

                                <custom:GAZTBorderlessEntry
                                    x:Name="LoginTin"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding TIN}"
                                    Unfocused="LoginTin_Unfocused"
                                    Focused="LoginTin_Focused"
                                    TextColor="#58595B"/>



                    </custom:CustomSfTextInputView.TextInputView>
                        <custom:CustomSfTextInputView.LeadingView>
                            <Image  Source="user_profile.png"
                                    Aspect="AspectFit"/>

                        </custom:CustomSfTextInputView.LeadingView>
                    </custom:CustomSfTextInputView>

                    
                    <!--  PleaseSelectTIN Drop-Down  -->
                    <custom:CustomSfTextInputView  IsVisible="{Binding IsTinDropdownVisible}">
                        <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.PleaseSelectTIN}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedTin}"
                                    TextColor="#58595B">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowTinsPickerCommand}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowTinsPickerCommand}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                        <inputLayout:SfTextInputLayout.TrailingView>

                            <Image Aspect="AspectFit" Source="greyDropDown" />
                        </inputLayout:SfTextInputLayout.TrailingView>

                    <inputLayout:SfTextInputLayout.LeadingView>

                           <Image  Source="user_profile.png"
                                    Aspect="AspectFit"/>
                        </inputLayout:SfTextInputLayout.LeadingView>
                    </custom:CustomSfTextInputView>

                    
                    <!--  Password Entry  -->
                    <custom:CustomSfTextInputView>
                        <custom:CustomSfTextInputView.TextInputView>

                                <custom:GAZTBorderlessEntry
                                x:Name="LoginPassword"
                                IsPassword="true"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding Password}"
                                TextColor="#58595B"/>



                    </custom:CustomSfTextInputView.TextInputView>
                        <custom:CustomSfTextInputView.LeadingView>
                            <Image  Source="password_key.png"
                                    Aspect="AspectFit"/>

                        </custom:CustomSfTextInputView.LeadingView>
                    </custom:CustomSfTextInputView>

                    <Label x:Name="forgotPasswordLabel" FontSize="Small" TextColor="white" >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Command="{Binding ForgotPasswordCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>

                    <Label x:Name="changeMobileNumberLabel"   FontSize="Small" TextColor="white">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Command="{Binding ChangeMCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>

                    <Label x:Name="loginLineLabel"  FontFamily="{StaticResource SomarRegular}" FontSize="Small" TextColor="white" >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Command="{Binding WebLoginCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>

                     <buttons:SfButton x:Name="loginBtn"
                                              VerticalOptions="Center"
                                              TextColor="White"
                                              StrokeThickness="1.5"
                                              CornerRadius="15"
                                              Margin="35,5,0,5"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              FontSize="Medium"
                                              Command="{Binding LoginClickedCommand}"/>

                    <Label x:Name="registerLabel"
                           HorizontalOptions="CenterAndExpand"
                           FontSize="Small"
                           TextColor="LightGreen"
                           Opacity="0.8">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer  Command="{Binding SignUpCommand}"/>
                        </Label.GestureRecognizers>

                    </Label>

            </StackLayout>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <custom:BottomMenu Grid.Row="2" VerticalOptions="EndAndExpand" />

        </Grid>
    </ContentPage.Content>
</ContentPage>