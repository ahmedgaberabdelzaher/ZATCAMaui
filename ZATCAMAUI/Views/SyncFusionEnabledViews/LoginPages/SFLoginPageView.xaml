<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.SFLoginPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters.SyncFusionEnabledConverters"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    Title="Login"
    BackgroundColor="White"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BooleanToColorConverter x:Key="ColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid x:Name="loginGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <StackLayout IsVisible="false" Orientation="Horizontal">

                    <!--  Left/Right icon  -->
                    <Image
                        x:Name="backbutton"
                        Margin="20,60,20,0"
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="StartAndExpand">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

                    <Image
                        x:Name="HamburgerMenu"
                        Margin="10,55,10,0"
                        HorizontalOptions="EndAndExpand"
                        Source="Burger"
                        Style="{StaticResource SmallIcon}"
                        VerticalOptions="Start">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding HamburgerMenuClickedCommand}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    IsVisible="false">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center" />
                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,-20,0,-20"
                    IsVisible="{Binding IsLoading}">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForLanding"
                                AnimationType="SingleCircle"
                                EnableAnimation="True"
                                HorizontalOptions="CenterAndExpand"
                                IsBusy="True"
                                TextColor="{StaticResource Secondary}"
                                TitlePlacement="Bottom"
                                VerticalOptions="CenterAndExpand"
                                ViewBoxHeight="70"
                                ViewBoxWidth="70" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
            <StackLayout
                x:Name="sessionExpiredView"
                Margin="0"
                BackgroundColor="Transparent"
                IsVisible="false">
                <StackLayout
                    Padding="40"
                    BackgroundColor="Transparent"
                    VerticalOptions="CenterAndExpand">
                    <Image Aspect="AspectFit" Source="errorNew.png" />
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.Information}"
                        TextColor="White" />
                    <Label
                        FontFamily="{StaticResource SomarSemiBold}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.ZYourSessionhasexpiredPleaseLoginagain}"
                        TextColor="White" />
                </StackLayout>

                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="30,60,30,80"
                    HorizontalOptions="Center"
                    VerticalOptions="End">
                    <buttons:SfButton
                        x:Name="btnLogin"
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,16"
                        Clicked="btnLoginClicked"
                        HeightRequest="46"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.LoginTitle}" />
                </StackLayout>
            </StackLayout>
            <yummy:PancakeView
                Grid.Row="0"
                Margin="0"
                Padding="0"
                BackgroundColor="#002447"
                CornerRadius="15,15,0,0"
                VerticalOptions="EndAndExpand">
                <controls:BottomMenu>
                    <controls:BottomMenu.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="iOS" Value="10,0,10,15" />
                            <On Platform="Android" Value="10,0,10,0" />
                        </OnPlatform>
                    </controls:BottomMenu.Margin>
                </controls:BottomMenu>
            </yummy:PancakeView>
        </Grid>
    </ContentPage.Content>
</ContentPage>