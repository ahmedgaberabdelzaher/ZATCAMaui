<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.NafathLoginView"
             Title="NafathLoginView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
            xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
            xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Name="page"
            ios:Page.UseSafeArea="true"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">
 <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                     Text="{x:Static ResourceManager:AppResources.NafathAuthentication}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

              <Grid>
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="32" Spacing="16">
                        <Label Text="{x:Static ResourceManager:AppResources.ZIBANNationalID}"
                        HorizontalOptions="StartAndExpand" Style="{StaticResource SectionTitleBlack}"/>
                        
                        <Border Style="{StaticResource GreyBorderFrame}" Stroke="#B1B1B1" Padding="5" StrokeThickness="1">
                            <custom:GAZTBorderlessEntry HorizontalOptions="FillAndExpand" Text="{Binding NafathId}" Placeholder="{x:Static ResourceManager:AppResources.EnterYourNationalIdHere}" Margin="8,0" HeightRequest="40"/>
                        </Border>
                        <Label Text="{Binding Error}" TextColor="Red" Padding="8,0,0,8"/>
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.LogIn}" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackLayout>
                    
                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>
