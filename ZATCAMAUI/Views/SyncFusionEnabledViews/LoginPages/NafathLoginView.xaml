<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.LoginPages.NafathLoginView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls" xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    x:Name="page"
    Title="NafathLoginView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NafathAuthentication}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid>
                    <StackLayout
                        Padding="32"
                        HorizontalOptions="FillAndExpand"
                        Spacing="16"
                        VerticalOptions="FillAndExpand">
                        <Label
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.ZIBANNationalID}" />

                        <custom:CustomSfTextInputView
                            ContainerBackground="White"
                            ContainerType="Outlined"
                            Hint="{x:Static ResourceManager:AppResources.EnterYourNationalIdHere}"
                            InputViewPadding="16,0,16,0"
                            OutlineCornerRadius="10"
                            Stroke="{StaticResource Primary}">
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding NafathId}">
                            </custom:GAZTBorderlessEntry>
                            </custom:CustomSfTextInputView.TextInputView>
                            
                        </custom:CustomSfTextInputView>

                        <Label
                            Padding="8,0,0,8"
                            Text="{Binding Error}"
                            TextColor="Red" />
                        <buttons:SfButton
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.LogIn}" />
                    </StackLayout>

                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>
