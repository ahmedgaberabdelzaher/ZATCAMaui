<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.ICRListPages.ICRListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    Title="{x:Static ResourceManager:AppResources.VATDeclaration}"
    ios:Page.UseSafeArea="true"
    BackgroundColor="{StaticResource Primary}"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.ControlTemplate>
        <ControlTemplate>

            <Grid>
                <StackLayout>
                    <Grid Padding="0,5,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="Large"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.VatReturns}"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.BackCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Border
                        Padding="0"
                        BackgroundColor="Black"
                        StrokeShape="RoundRectangle 32,32,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,15,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="90*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="1"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            BackgroundColor="White"
            HeightRequest="1000"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
            <Grid
                x:Name="ParentGrid"
                Margin="0"
                ColumnSpacing="10"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="12*" />
                    <RowDefinition Height="88*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <custom:CustomSfTextInputView
                    x:Name="FrmLicenseIssuedBy"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="7">
                    <custom:CustomSfTextInputView.TextInputView>
                        <custom:GAZTBorderlessEntry
                        FontSize="Small"
                        IsSpellCheckEnabled="False"
                        Text="{Binding TxtSelectedStatus}" />
                    </custom:CustomSfTextInputView.TextInputView>
                   
                </custom:CustomSfTextInputView>

                <buttons:SfButton
                    x:Name="BPickerButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="7"
                    Margin="10,0,10,0"
                    Background="Transparent"
                    Clicked="BPickerButton_Clicked" />
                <syncfusion:SfPicker
                    x:Name="BPicker"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="7"
                    Background="#EAF7CC"
                    CancelButtonClicked="BPicker_CancelButtonClicked"
                    FlowDirection="RightToLeft"
                    ItemHeight="40"
                    Mode="Dialog"
                    OkButtonClicked="BPicker_OkButtonClicked"
                    SelectionChanged="SelectedICR">

                    <syncfusion:SfPicker.TextStyle>
                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                    </syncfusion:SfPicker.TextStyle>


                    <syncfusion:SfPicker.Columns>
                        <syncfusion:PickerColumn
                            Width="270"
                            DisplayMemberPath="Txt30"
                            ItemsSource="{Binding ICRStatusList}"
                            SelectedIndex="{Binding ICRSelectedIndex}" />
                    </syncfusion:SfPicker.Columns>

                    <syncfusion:SfPicker.SelectedTextStyle>
                        <syncfusion:PickerTextStyle FontSize="13" TextColor="{StaticResource Primary}" />
                    </syncfusion:SfPicker.SelectedTextStyle>

                    <syncfusion:SfPicker.SelectionView>
                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                    </syncfusion:SfPicker.SelectionView>

                    <syncfusion:SfPicker.HeaderView>

                        <syncfusion:PickerHeaderView
                            Height="40"
                            Background="{StaticResource Primary}"
                            Text="{x:Static ResourceManager:AppResources.ZZReturnStatus}">
                            <syncfusion:PickerHeaderView.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="White" />
                            </syncfusion:PickerHeaderView.TextStyle>
                        </syncfusion:PickerHeaderView>

                    </syncfusion:SfPicker.HeaderView>

                    <syncfusion:SfPicker.FooterView>

                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                            <syncfusion:PickerFooterView.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                            </syncfusion:PickerFooterView.TextStyle>

                        </syncfusion:PickerFooterView>

                    </syncfusion:SfPicker.FooterView>

                </syncfusion:SfPicker>
                <StackLayout
                    x:Name="ListLayout"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="7"
                    Margin="10,0,10,0"
                    BackgroundColor="White"
                    HeightRequest="1000"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsICRListVisible}"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ListView
                        x:Name="ICRList"
                        BackgroundColor="White"
                        HasUnevenRows="True"
                        HorizontalOptions="FillAndExpand"
                        ItemsSource="{Binding ICRList}"
                        SelectedItem="{Binding SelectedICR}"
                        SeparatorVisibility="None"
                        VerticalOptions="FillAndExpand">
                        <x:Arguments>
                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                        </x:Arguments>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <!--  Margin="10"  -->
                                    <cards:SfCardView
                                        Margin="0,10,0,10"
                                        BackgroundColor="White"
                                        BorderColor="{StaticResource EntryTextColor}"
                                        BorderWidth=".05"
                                        CornerRadius="3"
                                        IndicatorColor="{Binding BorderColour}"
                                        IndicatorPosition="Left"
                                        IndicatorThickness="5"
                                        Opacity=".9">
                                        <StackLayout
                                            Margin="10,10,0,10"
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Grid
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="2"
                                                VerticalOptions="FillAndExpand">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90*" />
                                                    <ColumnDefinition Width="10*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                    Text="{x:Static ResourceManager:AppResources.ZVATReturnForm}"
                                                    VerticalOptions="StartAndExpand" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                    Text="{Binding Incotext}"
                                                    VerticalOptions="StartAndExpand" />
                                                <Label
                                                    x:Name="Fbnumber"
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                    Text="{Binding FormBundleNumber}"
                                                    VerticalOptions="StartAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding FormBundleNumber}"
                                                            TargetType="Label"
                                                            Value="">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                Text="{x:Static ResourceManager:AppResources.ZTaxPeriod}" />
                                                            <Span
                                                                FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                Text=" : " />
                                                            <Span
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                                Text="{Binding FormatTaxPeriod}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label
                                                    Grid.Row="4"
                                                    Grid.Column="0"
                                                    Margin="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                Text="{x:Static ResourceManager:AppResources.ZStatus}" />
                                                            <Span
                                                                FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                Text=" : " />
                                                            <Span
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                                Text="{Binding StatusTxt}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <StackLayout
                                                    Grid.Row="5"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0"
                                                    Orientation="Horizontal">

                                                    <Label
                                                        Margin="0,0,0,0"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        LineBreakMode="CharacterWrap"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span
                                                                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZReturnPeriod}" />
                                                                <Span
                                                                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                    Text=" : " />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label
                                                        Margin="-5,0,-5,0"
                                                        FlowDirection="LeftToRight"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        HorizontalOptions="StartAndExpand"
                                                        LineBreakMode="CharacterWrap"
                                                        Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                        Text="{Binding FormatedDate}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="6"
                                                    Grid.Column="0"
                                                    Margin="0"
                                                    Orientation="Horizontal">
                                                    <Label Margin="0,0,0,0" VerticalOptions="CenterAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span
                                                                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                    Text="{x:Static ResourceManager:AppResources.DueDate}" />
                                                                <Span
                                                                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                                    Text=" : " />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Label
                                                        Margin="-5,0,-5,0"
                                                        FlowDirection="LeftToRight"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                                        Text="{Binding FormatedSingleDueDate}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Source="{Binding StatusImage}"
                                                    VerticalOptions="StartAndExpand" />
                                            </Grid>
                                        </StackLayout>
                                    </cards:SfCardView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="7"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsNoDataLabelVisible}"
                    Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"
                    Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}"
                    VerticalOptions="Center" />
            </Grid>
            <!--  Acticity indicator layout start  -->
            <custom:Loader IsVisible="{Binding IsLoading}" />

            <!--  Acticity indicator layout end  -->
        </Grid>
    </ContentPage.Content>
</ContentPage>