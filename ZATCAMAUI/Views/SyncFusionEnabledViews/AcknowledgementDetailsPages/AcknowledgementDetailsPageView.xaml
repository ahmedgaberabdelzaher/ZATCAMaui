<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.AcknowledgementDetailsPages.AcknowledgementDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundColor="White"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,auto">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.Acknowlwdgement}"
                    VerticalOptions="Center" />

                <buttons:SfButton
                    x:Name="HomeButton"
                    Grid.Column="2"
                    Command="{Binding GoHomeClick}"
                    CornerRadius="4"
                    Style="{StaticResource IconButtonStyle}"
                    TextColor="{StaticResource Primary}" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid
                    x:Name="ParentContainerForChangeMobileNumber"
                    BackgroundColor="White"
                    ColumnDefinitions="100*"
                    HorizontalOptions="FillAndExpand"
                    RowDefinitions="100*"
                    VerticalOptions="FillAndExpand">

                    <ScrollView BackgroundColor="White">
                        <StackLayout BackgroundColor="White" VerticalOptions="FillAndExpand">
                            <StackLayout BackgroundColor="White" VerticalOptions="FillAndExpand">
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgmentReceiptText}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZZName}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{Binding TPName}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatReturnReferenceNumber}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{Binding ReturnReferenceNumber}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZZPleaseretainthisnumberforfuturereferenceandcommunucation}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{Binding TaxablePeriod}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatReceiptDate}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Padding="0"
                                    FlowDirection="LeftToRight"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{Binding ReceiptDate}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="{Binding IsSadadNumberVisible}"
                                    Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZSadadNumber}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="{Binding IsSadadNumberVisible}"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{Binding SadadNumber}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="{Binding IsSadadNumberVisible}"
                                    Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZAmountPayable}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Grid.Row="14"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="{Binding IsSadadNumberVisible}"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    VerticalOptions="CenterAndExpand">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontFamily="{StaticResource SomarBold}"
                                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                                Text="{Binding AmountPayable}" />
                                            <Span Text="&#160;&#160;" />
                                            <Span
                                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                                Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="{Binding IsSadadNoteVisible}"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgmentWaitingText}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="{Binding BreakdownAmountVisibility}"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.BreakDownLabel}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Padding="0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgmentHelpText}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                            <StackLayout VerticalOptions="EndAndExpand">
                                <buttons:SfButton
                                    Margin="0"
                                    Padding="0"
                                    Background="{StaticResource Primary}"
                                    Clicked="OnVATRefreshButtonClicked"
                                    CornerRadius="0"
                                    HeightRequest="56"
                                    IsVisible="{Binding IsRefreshButtonVisible}"
                                    Style="{StaticResource SfButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatRefresh}"
                                    VerticalOptions="EndAndExpand" />
                                <buttons:SfButton
                                    Margin="0"
                                    Padding="0"
                                    Background="{StaticResource Primary}"
                                    Command="{Binding OnAcknowlwdgementClicked}"
                                    CornerRadius="0"
                                    HeightRequest="56"
                                    IsVisible="{Binding IsAcknowledgementButtonVisible}"
                                    Style="{StaticResource SfButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.DownloadAcknowlwdgement}"
                                    VerticalOptions="EndAndExpand" />
                                <buttons:SfButton
                                    Margin="0"
                                    Padding="0"
                                    Background="{StaticResource Primary}"
                                    Command="{Binding OnDownloadFormClicked}"
                                    CornerRadius="0"
                                    HeightRequest="56"
                                    IsVisible="{Binding IsButtonVisible}"
                                    Style="{StaticResource SfButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                                    VerticalOptions="EndAndExpand" />
                            </StackLayout>
                        </StackLayout>
                    </ScrollView>

                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>