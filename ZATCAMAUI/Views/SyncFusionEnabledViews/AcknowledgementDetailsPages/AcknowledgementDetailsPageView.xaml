<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.AcknowledgementDetailsPages.AcknowledgementDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sfcustom="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    BackgroundColor="White"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <sfcustom:TitleView
                    Title="{x:Static ResourceManager:AppResources.Acknowlwdgement}"
                    BackgroundColor="{DynamicResource Gray-White}"
                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    FontSize="13">
                    <sfcustom:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="{StaticResource Primary}" />
                    </sfcustom:TitleView.LeadingView>
                    <sfcustom:TitleView.TrailingView>
                        <buttons:SfButton
                            x:Name="HomeButton"
                            Command="{TemplateBinding BindingContext.GoHomeClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource Home}"
                            TextColor="{StaticResource Primary}" />
                    </sfcustom:TitleView.TrailingView>
                </sfcustom:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            x:Name="ParentContainerForChangeMobileNumber"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                BackgroundColor="White">
                <ScrollView BackgroundColor="White">
                    <StackLayout BackgroundColor="White" VerticalOptions="FillAndExpand">
                        <StackLayout BackgroundColor="White" VerticalOptions="FillAndExpand">
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgmentReceiptText}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZZName}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{Binding TPName}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatReturnReferenceNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{Binding ReturnReferenceNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZZPleaseretainthisnumberforfuturereferenceandcommunucation}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{Binding TaxablePeriod}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatReceiptDate}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Padding="0"
                                FlowDirection="LeftToRight"
                                FontFamily="{StaticResource SomarSemiBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{Binding ReceiptDate}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsSadadNumberVisible}"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZSadadNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsSadadNumberVisible}"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{Binding SadadNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsSadadNumberVisible}"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZAmountPayable}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Grid.Row="14"
                                Padding="0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsSadadNumberVisible}"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                VerticalOptions="CenterAndExpand">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontFamily="{StaticResource SomarBold}" Text="{Binding AmountPayable}" />
                                        <Span Text="&#160;&#160;" />
                                        <Span FontFamily="{StaticResource GAZT_FONT_BOLD}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsSadadNoteVisible}"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgmentWaitingText}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding BreakdownAmountVisibility}"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.BreakDownLabel}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Padding="0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgmentHelpText}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                        <StackLayout VerticalOptions="EndAndExpand">
                            <buttons:SfButton
                                Margin="0"
                                Padding="0"
                                Background="{StaticResource Primary}"
                                Clicked="OnVATRefreshButtonClicked"
                                CornerRadius="0"
                                HeightRequest="56"
                                IsVisible="{Binding IsRefreshButtonVisible}"
                                Style="{StaticResource SfButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZVatRefresh}"
                                VerticalOptions="EndAndExpand" />
                            <buttons:SfButton
                                Margin="0"
                                Padding="0"
                                Background="{StaticResource Primary}"
                                Command="{Binding OnAcknowlwdgementClicked}"
                                CornerRadius="0"
                                HeightRequest="56"
                                IsVisible="{Binding IsAcknowledgementButtonVisible}"
                                Style="{StaticResource SfButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.DownloadAcknowlwdgement}"
                                VerticalOptions="EndAndExpand" />
                            <buttons:SfButton
                                Margin="0"
                                Padding="0"
                                Background="{StaticResource Primary}"
                                Command="{Binding OnDownloadFormClicked}"
                                CornerRadius="0"
                                HeightRequest="56"
                                IsVisible="{Binding IsButtonVisible}"
                                Style="{StaticResource SfButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                                VerticalOptions="EndAndExpand" />
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </StackLayout>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>