<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.ZakatDeregistration.TINDeRegistrationPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat">
    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>-->
    <yummy:PancakeView
        BackgroundColor="White"
        CornerRadius="15,15,0,0"
        VerticalOptions="EndAndExpand">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>

            <StackLayout
                Grid.Row="0"
                HorizontalOptions="FillAndExpand"
                Spacing="0"
                VerticalOptions="FillAndExpand">
                <buttons:SfButton
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    Clicked="OnSaveAsDraftClicked"
                    FontFamily="{StaticResource SomarSemiBold}"
                    FontSize="18"
                    HeightRequest="50"
                    HorizontalOptions="FillAndExpand"
                    Text="{x:Static ResourceManager:AppResources.ZZSaveAsDraft}"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
            </StackLayout>

        </Grid>
    </yummy:PancakeView>

</pages:PopupPage>
