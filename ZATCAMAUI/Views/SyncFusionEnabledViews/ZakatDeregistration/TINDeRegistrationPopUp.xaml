<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.ZakatDeregistration.TINDeRegistrationPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}">
    <Border
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>

            <StackLayout
                Grid.Row="0"
                HorizontalOptions="FillAndExpand"
                Spacing="0"
                VerticalOptions="FillAndExpand">
                <buttons:SfButton
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Transparent"
                    Clicked="OnSaveAsDraftClicked"
                    FontFamily="{StaticResource SomarSemiBold}"
                    FontSize="18"
                    HeightRequest="50"
                    HorizontalOptions="FillAndExpand"
                    Text="{x:Static ResourceManager:AppResources.ZZSaveAsDraft}"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
            </StackLayout>

        </Grid>
    </Border>

</Mopups:PopupPage>
