<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.AddNotePages.AddNotePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundColor="White"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Content>
        <ScrollView
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="8"
            Margin="0,0,0,0"
            BackgroundColor="White"
            HorizontalOptions="FillAndExpand"
            IsVisible="{Binding IsVisibleNotes}"
            VerticalOptions="FillAndExpand"
            VerticalScrollBarVisibility="Always">
            <Grid
                BackgroundColor="White"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                Style="{DynamicResource GridStyle}"
                VerticalOptions="FillAndExpand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="50*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" />
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource GAZTSmallGreenLabelStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZVatNotes}"
                    VerticalOptions="Center" />
                <Frame
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource GAZTFrameStyleForEntry}" />
                <custom:GAZTBorderlessEditor
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="12"
                    BackgroundColor="White"
                    FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                    Style="{StaticResource GAZTTextBoxStyleForEntry}"
                    Text="{Binding NoteText}" />
                <buttons:SfButton
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0"
                    Padding="0"
                    Background="{StaticResource Primary}"
                    Command="{Binding OnAddButtonClicked}"
                    CornerRadius="0"
                    HeightRequest="56"
                    Style="{StaticResource SfButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZVatNotesSaveandClose}" />
                <buttons:SfButton
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0"
                    Padding="0"
                    Background="{StaticResource Primary}"
                    Command="{Binding OnClearButtonClicked}"
                    CornerRadius="0"
                    HeightRequest="56"
                    Style="{StaticResource SfButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZVatNotesClearandClose}" />
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>