<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.ActivityIndicator.ActivityIndicatorPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls">
    <Grid IsVisible="true">

        <StackLayout
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            BackgroundColor="Black"
            Opacity="0.2"
            VerticalOptions="FillAndExpand" />

        <custom:Loader Grid.RowSpan="2" />

    </Grid>
</Mopups:PopupPage>
