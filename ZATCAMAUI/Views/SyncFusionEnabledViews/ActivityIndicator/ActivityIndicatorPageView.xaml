<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.ActivityIndicator.ActivityIndicatorPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui">
    <Grid IsVisible="true">
        <StackLayout
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            BackgroundColor="Black"
            Opacity="0.2"
            Orientation="Vertical"
            VerticalOptions="FillAndExpand" />
        <StackLayout
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Padding="15,15"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            Opacity="0.8"
            Orientation="Vertical"
            VerticalOptions="Center">
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <busyindicator:SfBusyIndicator
                    x:Name="busyindicatorForLanding"
                    AnimationType="SingleCircle"
                    HeightRequest="70"
                    HorizontalOptions="CenterAndExpand"
                    IsRunning="True"
                    TextColor="{StaticResource Secondary}"
                    TitlePlacement="Bottom"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="70" />
                <!--  Title="{x:Static local:AppResources.ActivityIndicatorTitle}"  -->
            </StackLayout>
        </StackLayout>
    </Grid>
</pages:PopupPage>
