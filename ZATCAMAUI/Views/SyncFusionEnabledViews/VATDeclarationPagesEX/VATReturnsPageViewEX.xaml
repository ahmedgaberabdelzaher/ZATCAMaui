                                                <TapGestureRecognizer Command="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.OnGetAcknowledgementLinkClicked}" />
                                            </Label.GestureRecognizers>
                                        </custom:CustomLabel>
                                    </Grid>
                                </ScrollView>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                    </tabView:SfTabView>

                    <Frame
                        Grid.Row="0"
                        Grid.Column="0"
                        IsVisible="{Binding IsVisibleCreditCarriedLabel}"
                        Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="CenterAndExpand"
                        IsVisible="{Binding IsVisibleCreditCarriedLabel}"
                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZVatcreditcarriedforward}"
                        VerticalOptions="Center" />
                    <CollectionView
                        x:Name="VATTabbedPageReturnCollectionView"
                        Margin="0"
                        BackgroundColor="{StaticResource Primary}"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="False"
                        ItemsLayout="HorizontalList"
                        ItemsSource="{Binding VatTabbledPageList}"
                        SelectedItem="{Binding PageSelectedItem, Mode=TwoWay}"
                        SelectionChanged="OnPageSelected"
                        SelectionMode="Single"
                        VerticalOptions="FillAndExpand">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="5,0,5,0"
                                    BackgroundColor="{StaticResource Primary}"
                                    HorizontalOptions="Center"
                                    Orientation="Horizontal"
                                    VerticalOptions="CenterAndExpand">
                                    <custom:CustomLabel
                                        x:Name="lblName"
                                        Margin="5,0,5,0"
                                        BackgroundColor="{StaticResource Primary}"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Style="{StaticResource forLightLabel}"
                                        Text="{Binding pageName}"
                                        TextColor="{Binding TextColor}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,-10"
                        Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding OnStepButtonClicked}"
                        CornerRadius="0"
                        FontAttributes="Bold"
                        FontFamily="{StaticResource SomarSemiBold}"
                        HeightRequest="56"
                        IsEnabled="{Binding IsMainButtonEnabled}"
                        IsVisible="{Binding IsMainButtonVisible}"
                        Text="{Binding ButtonName}"
                        TextColor="White"
                        VerticalOptions="EndAndExpand" />
                </Grid>
                <!--  Acticity indicator layout start  -->
                <!--  Acticity indicator layout End  -->
            </StackLayout>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <sfcustom:TitleView
                    Title="{x:Static ResourceManager:AppResources.VATDeclaration}"
                    BackgroundColor="{DynamicResource Gray-White}"
                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    FontSize="13">
                    <sfcustom:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="{StaticResource Primary}" />
                    </sfcustom:TitleView.LeadingView>
                    <sfcustom:TitleView.TrailingView>
                        <buttons:SfButton
                            x:Name="MenuButton"
                            Clicked="onMoreOptionClicked"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            IsEnabled="{TemplateBinding BindingContext.IsMoreButtonEnabled}"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource More}"
                            TextColor="{StaticResource Primary}" />
                    </sfcustom:TitleView.TrailingView>
                </sfcustom:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
</ContentPage>

