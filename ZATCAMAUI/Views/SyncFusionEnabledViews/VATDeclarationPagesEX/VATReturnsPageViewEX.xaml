<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.VATDeclarationPagesEX.VATReturnsPageViewEX"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sfcustom="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    Title="{x:Static ResourceManager:AppResources.VATDeclaration}"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->
    <ContentPage.Content>
        <Grid
            x:Name="ParentContainerForVAT"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>
            <StackLayout Grid.Row="0" Grid.Column="0">
                <Grid
                    x:Name="MainGrid"
                    Margin="0"
                    Padding="0,0,0,10"
                    ColumnSpacing="0"
                    HorizontalOptions="FillAndExpand"
                    RowSpacing="0"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <tabView:SfTabView
                        x:Name="SfTabView"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BackgroundColor="White"
                        IndicatorBackground="{StaticResource Primary}"
                        IndicatorPlacement="Bottom"
                        SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                        SelectionChanged="SfTabView_SelectionChanged"
                        TabItemTapped="SfTabView_TabItemTapped"
                        VerticalOptions="FillAndExpand">
                        <tabView:SfTabItem
                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                            FontSize="10"
                            Header="{x:Static ResourceManager:AppResources.ZZInstruction}"
                            TextColor="Gray">
                            <tabView:SfTabItem.Content>
                                <ScrollView
                                    x:Name="TabInstruction"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsVisibleInstrunction}"
                                    VerticalOptions="FillAndExpand">
                                    <Grid
                                        ColumnSpacing="0"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15*" />
                                            <ColumnDefinition Width="85*" />
                                        </Grid.ColumnDefinitions>
                                        <Frame
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                            HorizontalOptions="CenterAndExpand"
                                            Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZInstructions}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatReadInstructions}"
                                            VerticalOptions="EndAndExpand" />
                                        <custom:CustomLabel
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,10,2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                            VerticalOptions="EndAndExpand">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarLight}"
                                                        FontSize="11"
                                                        Text="1." />
                                                    <Span
                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                        FontSize="11"
                                                        Text="{x:Static ResourceManager:AppResources.ZZPleasefilltherequestedinformationforeachstep}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                        <custom:CustomLabel
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,10,2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                            VerticalOptions="EndAndExpand">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarLight}"
                                                        FontSize="11"
                                                        Text="2." />
                                                    <Span
                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                        FontSize="11"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatSubmittedInstructions}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                        <custom:CustomLabel
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,10,2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                            VerticalOptions="EndAndExpand">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarLight}"
                                                        FontSize="11"
                                                        Text="3." />
                                                    <Span
                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                        FontSize="11"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatDateInstructions}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                        <custom:CustomLabel
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,10,2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                            VerticalOptions="EndAndExpand">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarLight}"
                                                        FontSize="11"
                                                        Text="4." />
                                                    <Span
                                                        FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                                        FontSize="11"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatFaqSectionInstructions}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                        <Label
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,10,2"
                                            FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatClickFaqInstructions}"
                                            VerticalOptions="EndAndExpand">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.onFaqSectionClicked}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <CheckBox
                                            x:Name="chkDeclaration"
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Margin="10,0,10,0"
                                            IsChecked="{Binding IsDeclarationCheckedForInstruction}"
                                            IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsDeclarationCheckEnabled}"
                                            VerticalOptions="CenterAndExpand">
                                            <CheckBox.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Source={x:Reference chkDeclaration}, Path=IsChecked}"
                                                    TargetType="CheckBox"
                                                    Value="false">
                                                    <Setter Property="Color" Value="#e84941" />
                                                </DataTrigger>
                                            </CheckBox.Triggers>
                                        </CheckBox>
                                        <custom:CustomLabel
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            Margin="0,0,0,5"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                            VerticalOptions="CenterAndExpand">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                                        FontSize="11"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatDeclarationInstructions}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                    </Grid>
                                </ScrollView>
                            </tabView:SfTabItem.Content>
                        </tabView:SfTabItem>
                        <tabView:SfTabItem
                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                            FontSize="10"
                            Header="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                            TextColor="Gray">
                            <tabView:SfTabItem.Content>
                                <ScrollView
                                    x:Name="TabTaxPayerDetails"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsVisibleTaxPayerDetails}"
                                    Orientation="Vertical"
                                    VerticalOptions="FillAndExpand">
                                    <Grid BindingContext="{Binding ResponseVATDeclarationD}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15*" />
                                            <ColumnDefinition Width="90*" />
                                        </Grid.ColumnDefinitions>
                                        <Frame
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                            HorizontalOptions="CenterAndExpand"
                                            Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatTaxReturnDetails}"
                                            VerticalOptions="Center" />

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVatReturnType}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                IsSpellCheckEnabled="False"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Incotext}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVatReturn}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                IsSpellCheckEnabled="False"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Vrtaxret}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVatReturnReferenceNo}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Fbnum}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZTaxPeriod}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Perslt}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVatPeriodFrom}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FlowDirection="LeftToRight"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.TaxpayerPeriodFromDate}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVatPeriodTo}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="7"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FlowDirection="LeftToRight"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.TaxpayerPeriodToDate}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>
                                        <Frame
                                            Grid.Row="8"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" />
                                        <Label
                                            Grid.Row="8"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                            HorizontalOptions="CenterAndExpand"
                                            Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZTaxpayerInformation}"
                                            VerticalOptions="Center" />

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="9"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.TIN}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="9"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Gpart}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="10"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVATAccountNumber}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="10"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Fin}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="11"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVatIdentificationNumber}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">

                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="11"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Idnumber}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>

                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="12"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,-6,10,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            Hint="{x:Static ResourceManager:AppResources.ZVatTaxpayersName}"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                Grid.Row="12"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsReadOnly="True"
                                                Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                                Text="{Binding Tpnm}"
                                                TextColor="{StaticResource ForgotPasswordGrayTextColor}" />
                                        </inputLayout:SfTextInputLayout>
                                        <Label
                                            Grid.Row="13"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                            Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatAddress}" />
                                        <Frame
                                            Grid.Row="14"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            HeightRequest="100"
                                            Style="{StaticResource GAZTFrameStyleForEntry}" />
                                        <custom:GAZTBorderlessEditor
                                            Grid.Row="14"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="12,3,12,3"
                                            BackgroundColor="White"
                                            FontFamily="{StaticResource GAZT_FONT_REGULAR}"
                                            HeightRequest="100"
                                            IsEnabled="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource GAZTTextBoxStyleForEntry}"
                                            Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.FullAddress}"
                                            TextColor="{StaticResource ForgotPasswordGrayTextColor}"
                                            VerticalOptions="FillAndExpand" />
                                        <CheckBox
                                            x:Name="chkClearification"
                                            Grid.Row="15"
                                            Grid.Column="0"
                                            Margin="10,0,10,0"
                                            CheckedChanged="chkClearification_CheckedChanged"
                                            HorizontalOptions="FillAndExpand"
                                            IsChecked="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsCheckedTaxPayerDetailsInfo}"
                                            IsEnabled="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsTaxPayerCheckEnabled}"
                                            VerticalOptions="Center">
                                            <CheckBox.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Source={x:Reference chkClearification}, Path=IsChecked}"
                                                    TargetType="CheckBox"
                                                    Value="false">
                                                    <Setter Property="Color" Value="#e84941" />
                                                </DataTrigger>
                                            </CheckBox.Triggers>
                                        </CheckBox>
                                        <custom:CustomLabel
                                            Grid.Row="15"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                            FontSize="11"
                                            HorizontalTextAlignment="Start"
                                            Style="{DynamicResource searchBarStyleForClearificationChb}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatConfirmMessage}"
                                            TextColor="{StaticResource PrimaryColor}"
                                            VerticalOptions="FillAndExpand"
                                            VerticalTextAlignment="Center" />
                                        <custom:CustomLabel
                                            Grid.Row="16"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,10,0"
                                            HorizontalOptions="StartAndExpand"
                                            IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsChangeRegistrationlinkVisible}"
                                            Style="{StaticResource GAZTGreenLabelStyleForDashboardIcon}"
                                            VerticalOptions="EndAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatNote}" />
                                                    <Span
