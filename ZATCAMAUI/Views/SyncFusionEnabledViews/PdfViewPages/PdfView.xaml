<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.PdfViewPages.PdfView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:sfcustom="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
    BackgroundColor="White"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="ic_share.png" x:Name="ICvalidation1"
                Priority="1" Order="Primary" Clicked="Share_Clicked"  />
    </ContentPage.ToolbarItems>-->
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <syncfusion:SfPdfViewer
                    x:Name="PdfViewForCertificate"
                    Grid.Row="0"
                    Grid.Column="0"
                    DocumentSource="{Binding StreamForDownloadURL}"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="True"
                    VerticalOptions="FillAndExpand" />
                <ActivityIndicator
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    VerticalOptions="Center" />
            </Grid>
            <!--  Acticity indicator layout start  -->
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding Loading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
            <!--  Acticity indicator layout end  -->
        </Grid>
    </ContentPage.Content>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <sfcustom:TitleView
                    BackgroundColor="{DynamicResource Gray-White}"
                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    FontSize="13">
                    <sfcustom:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="{StaticResource Primary}" />
                    </sfcustom:TitleView.LeadingView>
                    <sfcustom:TitleView.TrailingView>
                        <buttons:SfButton
                            x:Name="ShareButton"
                            Clicked="Share_Clicked"
                            CornerRadius="4"
                            IsEnabled="{TemplateBinding BindingContext.IsShareButtonEnable}"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource Share}"
                            TextColor="{StaticResource Primary}" />
                    </sfcustom:TitleView.TrailingView>
                </sfcustom:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
</ContentPage>