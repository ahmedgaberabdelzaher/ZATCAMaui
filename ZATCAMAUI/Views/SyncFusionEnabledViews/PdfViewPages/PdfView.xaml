<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.PdfViewPages.PdfView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="true"
    BackgroundColor="White"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingPdfViewCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid
            HorizontalOptions="FillAndExpand"
            RowDefinitions="Auto, *"
            VerticalOptions="FillAndExpand">

            <!--#region Header-->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,*"
                HorizontalOptions="FillAndExpand">
                <StackLayout>
                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="arrowRight.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <buttons:SfButton
                    x:Name="ShareButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Command="{Binding ShareCommand}"
                    CornerRadius="4"
                    HorizontalOptions="EndAndExpand"
                    IsEnabled="{TemplateBinding BindingContext.IsShareButtonEnable}"
                    Style="{StaticResource IconButtonStyle}"
                    Text="{DynamicResource Share}"
                    TextColor="{StaticResource Primary}" />
            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <syncfusion:SfPdfViewer
                x:Name="PdfViewForCertificate"
                Grid.Row="1"
                DocumentSource="{Binding StreamForDownloadURL}"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand" />

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>