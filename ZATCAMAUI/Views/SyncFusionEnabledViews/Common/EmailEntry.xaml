<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.Common.EmailEntry"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters.SyncFusionEnabledConverters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    FlowDirection="{Binding AppDirection}">
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <StackLayout>
            <Grid Margin="0,11,0,0"
                  ColumnDefinitions="*,Auto">

                <custom:CustomSfTextInputView
                    Grid.Column="0"
                    x:Name="EmailInputLayout"
                    Grid.ColumnSpan="2">

                     <custom:GAZTBorderlessEntry
                        x:Name="email"
                        FontSize="Small"
                        PlaceholderColor="Gray"
                        Text="{Binding Email}"
                        TextColor="White"
                        Unfocused="Email_UnFocused" />

                </custom:CustomSfTextInputView>
            </Grid>
            <Label
                x:Name="ValidationLabel"
                Margin="15,-5,0,0"
                FontSize="11"
                IsVisible="{Binding Path=IsFocused, Source={x:Reference email}, Converter={StaticResource StringToBooleanConverter}, ConverterParameter={x:Reference email}}"
                Text="{x:Static ResourceManager:AppResources.ZZPleaseenteravalidEmailAddress}"
                TextColor="{DynamicResource Red}"
                VerticalOptions="FillAndExpand" />
            <Grid
                Margin="0,11,0,0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="20*" />
                </Grid.ColumnDefinitions>
                 <custom:CustomSfTextInputView
                     x:Name="TINSLayout"
                    Grid.Row="0"
                    Grid.Column="0"
                     IsVisible="{Binding IsVisibleTinIds}"
                    Grid.ColumnSpan="2">

                     <custom:GAZTBorderlessEntry
                        x:Name="TinDropdown"
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Small"
                        Text="{Binding TINID}"
                        TextColor="White" />

                </custom:CustomSfTextInputView>

                <buttons:SfButton
                    x:Name="TinsButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="10,0,10,0"
                    Background="Transparent"
                    Clicked="TINs_Clicked"
                    FontSize="Small"
                    IsVisible="{Binding IsVisibleTinIds}"
                    TextColor="White" />

                <custom:CustomSfPicker
                    x:Name="TinsPicker"
                    Margin="10,0,10,0"
                    Background="#EAF7CC"
                    CancelButtonClicked="TinsPicker_CancelButtonClicked"
                    FlowDirection="RightToLeft"
                    ItemHeight="40"
                    Mode="Dialog"
                    OkButtonClicked="TinsPicker_OkButtonClicked">


                    <syncfusion:SfPicker.Columns>
                        <syncfusion:PickerColumn
                            Width="270"
                            DisplayMemberPath="Tin"
                            ItemsSource="{Binding TINs}"
                            SelectedIndex="{Binding TINIndex}" />
                    </syncfusion:SfPicker.Columns>

                    <syncfusion:SfPicker.SelectedTextStyle>
                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                    </syncfusion:SfPicker.SelectedTextStyle>


                    <syncfusion:SfPicker.SelectionView>
                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                    </syncfusion:SfPicker.SelectionView>

                    <syncfusion:SfPicker.HeaderView>

                        <syncfusion:PickerHeaderView
                            Height="40"
                            Background="{StaticResource Primary}"
                            Text="{x:Static ResourceManager:AppResources.TINS}">
                            <syncfusion:PickerHeaderView.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="White" />
                            </syncfusion:PickerHeaderView.TextStyle>
                        </syncfusion:PickerHeaderView>

                    </syncfusion:SfPicker.HeaderView>

                    <syncfusion:SfPicker.FooterView>

                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                            <syncfusion:PickerFooterView.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                            </syncfusion:PickerFooterView.TextStyle>

                        </syncfusion:PickerFooterView>

                    </syncfusion:SfPicker.FooterView>


                </custom:CustomSfPicker>
            </Grid>
        </StackLayout>
    </ContentView.Content>
</ContentView>