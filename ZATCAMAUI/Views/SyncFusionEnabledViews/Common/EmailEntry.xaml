<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.Common.EmailEntry"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters.SyncFusionEnabledConverters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    FlowDirection="RightToLeft">
    <ContentView.Resources>
        <ResourceDictionary>
            <converter:StringToBooleanConverter x:Key="StringToBooleanConverter" />
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <StackLayout>
            <Grid Margin="0,11,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <inputLayout:SfTextInputLayout
                    x:Name="EmailInputLayout"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="10,-6,10,-6"
                    ContainerType="Outlined"
                    HasError="False"
                    Hint="{x:Static ResourceManager:AppResources.TinEmail}"
                    OutlineCornerRadius="8"
                    Stroke="{StaticResource Primary}">
                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <inputLayout:LabelStyle TextColor="#B00020" />
                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <custom:GAZTBorderlessEntry
                        x:Name="email"
                        FontSize="Small"
                        PlaceholderColor="Gray"
                        Text="{Binding Email}"
                        TextColor="White"
                        Unfocused="Email_UnFocused" />
                </inputLayout:SfTextInputLayout>
            </Grid>
            <Label
                x:Name="ValidationLabel"
                Margin="15,-5,0,0"
                FontSize="11"
                IsVisible="{Binding Path=IsFocused, Source={x:Reference email}, Converter={StaticResource StringToBooleanConverter}, ConverterParameter={x:Reference email}}"
                Text="{x:Static ResourceManager:AppResources.ZZPleaseenteravalidEmailAddress}"
                TextColor="{DynamicResource Red}"
                VerticalOptions="FillAndExpand" />
            <Grid
                Margin="0,11,0,0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="20*" />
                </Grid.ColumnDefinitions>
                <inputLayout:SfTextInputLayout
                    x:Name="TINSLayout"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="10,-6,10,-6"
                    ContainerType="Outlined"
                    HasError="False"
                    Hint="{x:Static ResourceManager:AppResources.TINS}"
                    IsVisible="{Binding IsVisibleTinIds}"
                    OutlineCornerRadius="8"
                    Stroke="{StaticResource Primary}">
                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <inputLayout:LabelStyle TextColor="#B00020" />
                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <custom:GAZTBorderlessEntry
                        x:Name="TinDropdown"
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Small"
                        Text="{Binding TINID}"
                        TextColor="White" />
                </inputLayout:SfTextInputLayout>
                <custom:CustomButton
                    x:Name="TinsButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="10,0,10,0"
                    BackgroundColor="Transparent"
                    Clicked="TINs_Clicked"
                    FontSize="Small"
                    IsVisible="{Binding IsVisibleTinIds}"
                    TextColor="White" />

                <syncfusion:SfPicker
                    x:Name="TinsPicker"
                    Margin="10,0,10,0"
                    Background="#EAF7CC"
                    CancelButtonClicked="TinsPicker_CancelButtonClicked"
                    FlowDirection="RightToLeft"
                    ItemHeight="40"
                    Mode="Dialog"
                    OkButtonClicked="TinsPicker_OkButtonClicked">


                    <syncfusion:SfPicker.Columns>
                        <syncfusion:PickerColumn
                            Width="270"
                            DisplayMemberPath="Tin"
                            ItemsSource="{Binding TINs}"
                            SelectedIndex="{Binding TINIndex}" />
                    </syncfusion:SfPicker.Columns>

                    <syncfusion:SfPicker.SelectedTextStyle>
                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                    </syncfusion:SfPicker.SelectedTextStyle>

                    <syncfusion:SfPicker.ColumnHeaderView>
                        <syncfusion:PickerColumnHeaderView Height="46" />
                    </syncfusion:SfPicker.ColumnHeaderView>

                    <syncfusion:SfPicker.HeaderView>

                        <syncfusion:PickerHeaderView
                            Height="40"
                            Background="{StaticResource Primary}"
                            Text="{x:Static ResourceManager:AppResources.TINS}">
                            <syncfusion:PickerHeaderView.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="White" />
                            </syncfusion:PickerHeaderView.TextStyle>
                        </syncfusion:PickerHeaderView>

                    </syncfusion:SfPicker.HeaderView>

                    <syncfusion:SfPicker.FooterView>

                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                            <syncfusion:PickerFooterView.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                            </syncfusion:PickerFooterView.TextStyle>

                        </syncfusion:PickerFooterView>

                    </syncfusion:SfPicker.FooterView>

                    <syncfusion:SfPicker.Behaviors>
                        <behaviors:SfPickerBehavior />
                    </syncfusion:SfPicker.Behaviors>

                </syncfusion:SfPicker>
            </Grid>
        </StackLayout>
    </ContentView.Content>
</ContentView>