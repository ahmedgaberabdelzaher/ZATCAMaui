<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.ZakatReturnDetailsPages.ZakatReturnDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static ResourceManager:AppResources.ZZakatReturnDetails}"
    BackgroundColor="White"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Common\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView
                    Title="{x:Static ResourceManager:AppResources.ZZakatReturnDetails}"
                    BackgroundColor="{DynamicResource Gray-White}"
                    FontFamily="{StaticResource GAZT_FONT_BOLD}"
                    FontSize="13">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="{StaticResource Primary}" />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <ScrollView>
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70*" />
                        <RowDefinition Height="30*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" />
                    </Grid.ColumnDefinitions>
                    <ScrollView
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            BindingContext="{Binding ZakatReturnDetail}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40*" />
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="10*" />
                            </Grid.ColumnDefinitions>
                            <Frame
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource GAZTFrameStyleEntryForLableBackground}" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                HorizontalOptions="CenterAndExpand"
                                Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZSummaryofZakatcalculation}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.FiscalYear}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{Binding Persl}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.FinancialPeriodFrom}"
                                VerticalOptions="CenterAndExpand" />


                            <StackLayout
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal"
                                VerticalOptions="FillAndExpand">


                                <custom:CustomLabel
                                    x:Name="date"
                                    Margin="10,0,10,0"
                                    FlowDirection="LeftToRight"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    HorizontalOptions="StartAndExpand"
                                    LineBreakMode="CharacterWrap"
                                    Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>






                            <Label
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZReturnReferenceNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{Binding Fbnum}"
                                VerticalOptions="CenterAndExpand" />
                            <BoxView
                                Grid.Row="7"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource GAZTBoxViewStyle}" />
                            <custom:CustomLabel
                                Grid.Row="8"
                                Grid.Column="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"
                                Text="{x:Static ResourceManager:AppResources.ZZEstimatedSalesForFiscalYear}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Row="8"
                                Grid.Column="1"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Estsl}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Grid.Row="8"
                                Grid.Column="2"
                                Margin="0,0,0,2"
                                Style="{StaticResource IconLabelStyleVAT}"
                                Text="{StaticResource Help}"
                                TextColor="{StaticResource Primary}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnInformationMessageClickedOne" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label
                                Grid.Row="9"
                                Grid.Column="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"
                                Text="{x:Static ResourceManager:AppResources.Capital}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Row="9"
                                Grid.Column="1"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"
                                Text="{Binding Cpamt}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Cpamt}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Grid.Row="9"
                                Grid.Column="2"
                                Margin="0,0,0,2"
                                Style="{StaticResource IconLabelStyleVAT}"
                                Text="{StaticResource Help}"
                                TextColor="{StaticResource Primary}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnInformationMessageClickedTwo" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label
                                Grid.Row="10"
                                Grid.Column="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"
                                Text="{x:Static ResourceManager:AppResources.ZakatBase}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Row="10"
                                Grid.Column="1"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"
                                Text="{Binding Zbamt}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Zbamt}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Grid.Row="10"
                                Grid.Column="2"
                                Margin="0,0,0,2"
                                Style="{StaticResource IconLabelStyleVAT}"
                                Text="{StaticResource Help}"
                                TextColor="{StaticResource Primary}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnInformationMessageClickedThree" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label
                                Grid.Row="11"
                                Grid.Column="0"
                                FontFamily="{StaticResource GAZT_FONT_BOLD}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGoldLabelStyleForSmallFont}"
                                Text="{x:Static ResourceManager:AppResources.ZakatAmount}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center" />
                            <Label
                                Grid.Row="11"
                                Grid.Column="1"
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"
                                Text="{Binding Zkamt}"
                                VerticalOptions="FillAndExpand"
                                VerticalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Zkamt}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Grid.Row="11"
                                Grid.Column="2"
                                Margin="0,0,0,2"
                                Style="{StaticResource IconLabelStyleVAT}"
                                Text="{StaticResource Help}"
                                TextColor="{StaticResource Primary}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnInformationMessageClickedFour" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </ScrollView>
                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="1"
                        VerticalOptions="EndAndExpand">
                        <buttons:SfButton
                            Margin="0"
                            Padding="0"
                            BackgroundColor="{StaticResource Primary}"
                            Command="{Binding OnSalesDetailsClicked}"
                            CornerRadius="0"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="13"
                            HeightRequest="56"
                            IsVisible="{Binding SalesDetailsAndReleaseButtonVisibility}"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.SalesDetails}" />

                        <buttons:SfButton
                            Margin="0"
                            Padding="0"
                            BackgroundColor="{StaticResource Primary}"
                            Command="{Binding OnChangeFromEstimateToAccountingBasisButtonClicked}"
                            CornerRadius="0"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="13"
                            HeightRequest="56"
                            IsVisible="{Binding ChangeFromEstimateTAccountringBasisButtonVisibility}"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ChangeFromEstimateToAccountingBasis}" />




                        <!--  Command="{Binding OnSalesDetailsClicked}"  -->
                        <buttons:SfButton
                            Margin="0"
                            Padding="0"
                            BackgroundColor="{StaticResource Primary}"
                            Clicked="OnBillsButtonClicked"
                            CornerRadius="0"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="13"
                            HeightRequest="56"
                            IsVisible="{Binding SalesDetailsAndReleaseButtonVisibility}"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{Binding ReleaseOrBillDetailsButtonText}" />
                        <!--  Command="{Binding OnBillsButtonClicked}"  -->
                        <buttons:SfButton
                            Margin="0"
                            Padding="0"
                            BackgroundColor="{StaticResource Primary}"
                            Command="{Binding OnAmendReturnButtonClicked}"
                            CornerRadius="0"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="13"
                            HeightRequest="56"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding AmedmentButtonVisibility}"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.AmendReturn}"
                            VerticalOptions="Center" />
                    </StackLayout>
                </Grid>
                <!--  Acticity indicator layout start  -->
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    IsVisible="{Binding IsLoading}"
                    VerticalOptions="FillAndExpand">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForLanding"
                                AnimationType="Cupertino"
                                HeightRequest="70"
                                HorizontalOptions="CenterAndExpand"
                                IndicatorColor="{StaticResource Secondary}"
                                IsRunning="True"
                                SizeFactor="0.6"
                                TitlePlacement="Bottom"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="70" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
                <!--  Acticity indicator layout End  -->
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>