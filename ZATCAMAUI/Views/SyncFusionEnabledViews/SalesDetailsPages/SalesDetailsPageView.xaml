<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.SyncFusionEnabledViews.SalesDetailsPages.SalesDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls.SyncFusionEnabledControls"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static ResourceManager:AppResources.ZSalesDetails}"
    BackgroundColor="White"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <StackLayout Spacing="0">
                <controls:TitleView
                    Title="{x:Static ResourceManager:AppResources.ZSalesDetails}"
                    BackgroundColor="{DynamicResource Gray-White}"
                    FontFamily="{StaticResource custom_FONT_BOLD}"
                    FontSize="13">
                    <controls:TitleView.LeadingView>
                        <buttons:SfButton
                            x:Name="backButton"
                            Command="{TemplateBinding BindingContext.GoBackClick}"
                            CommandParameter="{x:Reference backButton}"
                            CornerRadius="4"
                            Style="{StaticResource IconButtonStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="{StaticResource Primary}" />
                    </controls:TitleView.LeadingView>
                </controls:TitleView>
                <ContentPresenter VerticalOptions="FillAndExpand" />
            </StackLayout>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            Margin="0"
            Padding="0"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="78*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="50*" />
                </Grid.ColumnDefinitions>
                <StackLayout
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0"
                    Padding="0"
                    Orientation="Vertical"
                    VerticalOptions="End">
                    <BoxView
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,5"
                        Style="{StaticResource customBoxViewStyle}" />
                    <Grid
                        Grid.Row="11"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0"
                        Padding="0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <ScrollView VerticalOptions="End">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="90*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    x:Name="checkBox"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    CheckedChanged="OnCheckBoxCheckedChanged"
                                    IsChecked="{Binding CheckBoxStatus}"
                                    IsVisible="{Binding DesClaimerVisibility}"
                                    VerticalOptions="Start" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontFamily="{StaticResource custom_FONT_MEDIUM}"
                                    IsVisible="{Binding DesClaimerVisibility}"
                                    Style="{StaticResource customGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZZDeclarationText}"
                                    VerticalOptions="Start" />
                                <buttons:SfButton
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0"
                                    Padding="0"
                                    Background="{StaticResource Primary}"
                                    Command="{Binding OnAcceptReturnButtonClicked}"
                                    CornerRadius="0"
                                    FontFamily="{StaticResource custom_FONT_BOLD}"
                                    HeightRequest="56"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding AmedmentButtonVisibility}"
                                    Style="{StaticResource SfButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.BillDetails}"
                                    VerticalOptions="End" />
                                <buttons:SfButton
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0"
                                    Padding="0"
                                    Background="{StaticResource Primary}"
                                    Command="{Binding OnAmendReturnButtonClicked}"
                                    CornerRadius="0"
                                    FontFamily="{StaticResource custom_FONT_BOLD}"
                                    HeightRequest="56"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding AmedmentButtonVisibility}"
                                    Style="{StaticResource SfButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.AmendReturn}"
                                    VerticalOptions="End" />
                                <buttons:SfButton
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0"
                                    Padding="0"
                                    Background="{StaticResource Primary}"
                                    Command="{Binding OnSubmitButtonClicked}"
                                    CornerRadius="0"
                                    FontFamily="{StaticResource custom_FONT_BOLD}"
                                    HeightRequest="56"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding SubmitButtonVisibility}"
                                    Style="{StaticResource SfButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Submit}"
                                    VerticalOptions="End" />
                                <buttons:SfButton
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0"
                                    Padding="0"
                                    Background="{StaticResource Primary}"
                                    Clicked="OnConfirmButtonClicked"
                                    CornerRadius="0"
                                    FontFamily="{StaticResource custom_FONT_BOLD}"
                                    HeightRequest="56"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding ConfirmButtonVisibility}"
                                    Style="{StaticResource SfButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Confirm}"
                                    VerticalOptions="End" />
                            </Grid>
                        </ScrollView>
                    </Grid>
                </StackLayout>
                <StackLayout
                    Margin="0,5,0,5"
                    HorizontalOptions="FillAndExpand"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0">
                    <Label
                        Margin="10,5,10,0"
                        FontSize="11"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="CenterAndExpand"
                        VerticalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    FontFamily="{StaticResource custom_FONT_MEDIUM}"
                                    Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                    Text="{x:Static ResourceManager:AppResources.FiscalYear}"
                                    TextColor="{StaticResource GoldLabelTextColor}" />
                                <Span Text=" " />
                                <Span
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                    Text="{Binding Persl}"
                                    TextColor="{StaticResource DashboardGrayTextColor}" />

                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <StackLayout
                        Grid.Column="0"
                        Margin="0"
                        Orientation="Horizontal"
                        VerticalOptions="CenterAndExpand">

                        <Label
                            Margin="10,0,10,0"
                            FontFamily="{StaticResource SomarSemiBold}"
                            LineBreakMode="CharacterWrap"
                            VerticalOptions="CenterAndExpand">
                            <Label.FormattedText>
                                <FormattedString>

                                    <Span
                                        FontFamily="{StaticResource custom_FONT_MEDIUM}"
                                        Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                        Text="{x:Static ResourceManager:AppResources.ZFinancialPeriodFrom}"
                                        TextColor="{StaticResource GoldLabelTextColor}" />
                                    <Span
                                        FontFamily="{StaticResource custom_FONT_MEDIUM}"
                                        Style="{StaticResource MicroGrayLabelStyleNew}"
                                        Text=" " />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label
                            Margin="-5,0,-5,0"
                            FlowDirection="LeftToRight"
                            FontFamily="{StaticResource SomarSemiBold}"
                            HorizontalOptions="StartAndExpand"
                            LineBreakMode="CharacterWrap"
                            Style="{StaticResource MicroGrayLabelStyleNewEn}"
                            Text="{Binding Abrzu}"
                            TextColor="{StaticResource DashboardGrayTextColor}"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                    <Label
                        Margin="10,0,10,5"
                        FontSize="11"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="CenterAndExpand"
                        VerticalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>

                                <Span
                                    FontFamily="{StaticResource custom_FONT_MEDIUM}"
                                    Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                    Text="{x:Static ResourceManager:AppResources.ZReturnReferenceNumber}"
                                    TextColor="{StaticResource GoldLabelTextColor}" />
                                <Span Text=" " />
                                <Span
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    Style="{StaticResource MicroGrayLabelStyleNewEn}"
                                    Text="{Binding Fbnum}"
                                    TextColor="{StaticResource DashboardGrayTextColor}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </StackLayout>
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48*" />
                        <ColumnDefinition Width="40*" />
                        <ColumnDefinition Width="12*" />
                    </Grid.ColumnDefinitions>
                    <BoxView
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,2"
                        Style="{StaticResource customBoxViewStyle}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        FontFamily="{StaticResource custom_FONT_MEDIUM}"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource customGreenLabelStyleForDashboardIcon}"
                        Text="{x:Static ResourceManager:AppResources.ZEstimatedSales}"
                        VerticalOptions="CenterAndExpand"
                        VerticalTextAlignment="Center" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        FontFamily="{StaticResource SomarSemiBold}"
                        HorizontalOptions="CenterAndExpand"
                        Style="{StaticResource customGrayLabelStyleForSmallFont}"
                        VerticalOptions="CenterAndExpand"
                        VerticalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Estsl}" />
                                <Span Text=" " />
                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="5,0,5,0"
                        HorizontalOptions="Center"
                        Style="{StaticResource IconLabelStyleVAT}"
                        Text="{StaticResource Help}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEstmatedSalesInfoMessageClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,2,0,2"
                        Style="{StaticResource customBoxViewStyle}" />
                    <ListView
                        x:Name="salesDetails"
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        BackgroundColor="White"
                        HasUnevenRows="True"
                        HorizontalOptions="FillAndExpand"
                        ItemsSource="{Binding SalesDetailsList}"
                        SelectedItem="{Binding SelectedSalesDetails}"
                        SeparatorVisibility="None"
                        VerticalOptions="FillAndExpand">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Grid
                                        BackgroundColor="{Binding DisableItemBackgroundColor}"
                                        ColumnSpacing="5"
                                        RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48*" />
                                            <ColumnDefinition Width="40*" />
                                            <ColumnDefinition Width="12*" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,10,0"
                                            FontFamily="{StaticResource custom_FONT_BOLD}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource customGoldLabelStyleForCaptionFont}"
                                            Text="{Binding SalesType}"
                                            VerticalOptions="CenterAndExpand" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="10,0,10,0"
                                            FontFamily="{StaticResource custom_FONT_MEDIUM}"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource customGreenLabelStyleForMicro}"
                                            Text="{x:Static ResourceManager:AppResources.ZInformationfromrelatedparties}"
                                            VerticalOptions="Start" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="10,0,10,0"
                                            FontFamily="{StaticResource custom_FONT_MEDIUM}"
                                            HorizontalOptions="StartAndExpand"
                                            IsVisible="{Binding InformationIconVisibility}"
                                            Style="{StaticResource customGreenLabelStyleForMicro}"
                                            Text="{x:Static ResourceManager:AppResources.ZEstimatedSales}"
                                            VerticalOptions="Start" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="5,10,5,10"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding HelpIconVisibility}"
                                            Style="{StaticResource IconLabelStyleVAT}"
                                            Text="{StaticResource Help}"
                                            TextColor="{StaticResource Primary}"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnInformationMessageClicked" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="10,0,10,10"
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource customGrayLabelStyleForCaptionFont}"
                                            Text="{Binding InformationFromPartieToCompare}"
                                            VerticalOptions="FillAndExpand"
                                            VerticalTextAlignment="Center" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="10,0,10,10"
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            HorizontalOptions="StartAndExpand"
                                            IsVisible="{Binding InformationIconVisibility}"
                                            Style="{StaticResource customGrayLabelStyleForCaptionFont}"
                                            VerticalOptions="FillAndExpand"
                                            VerticalTextAlignment="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding EstimateSales}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Image
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="5,0,5,5"
                                            HorizontalOptions="Center"
                                            Source="{Binding EditImageSource}"
                                            VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnEditImageClicked" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <BoxView
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            BackgroundColor="Black"
                                            HeightRequest="0.5"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding SeparatorVisibility}"
                                            VerticalOptions="Fill" />
                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            <!--  Acticity indicator layout start  -->
            <custom:Loader IsVisible="{Binding IsLoading}"/>
        
            <!--  Acticity indicator layout end  -->
        </Grid>
    </ContentPage.Content>
</ContentPage>