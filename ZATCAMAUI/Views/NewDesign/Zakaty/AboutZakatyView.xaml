<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.Zakaty.AboutZakatyView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    TitleText="{x:Static ResourceManager:AppResources.Zakaty}">
    <newdesign:BaseContentPage.PancakeView>
        <ScrollView VerticalScrollBarVisibility="Never">
            <!--  Body  -->
            <StackLayout Margin="24">
                <!--#region ZAKAty Logo-->
                <Image
                    Margin="10,41,10,16"
                    HeightRequest="50"
                    HorizontalOptions="CenterAndExpand"
                    Source="ZAKATyLogo"
                    WidthRequest="96" />
                <!--#endregion-->
                <!--#region About ZAKAty Title Label-->
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="18"
                    Text="{x:Static ResourceManager:AppResources.About_Zakaty}"
                    TextColor="#002447" />
                <!--#endregion-->
                <!--#region About ZAKAty Description Label-->
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="16"
                    Text="{x:Static ResourceManager:AppResources.ZAKATYDesc}"
                    TextColor="#002447" />
                <!--#endregion-->
                <!--#region Move To Zakaty Portal View-->
                <Frame
                    Margin="0,34,0,24"
                    Padding="12"
                    BackgroundColor="#0996D4"
                    CornerRadius="14">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToZakatyPortalCommand}" />
                    </Frame.GestureRecognizers>
                    <Label
                        FontSize="16"
                        HorizontalOptions="CenterAndExpand"
                        Text="{x:Static ResourceManager:AppResources.GoToZakatyPortal}"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />
                </Frame>
                <!--#endregion-->
                <!--#region Store Links View-->
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="16"
                    Text="{x:Static ResourceManager:AppResources.DownloadApp}"
                    TextColor="#002447" />
                <!--  <StackLayout Orientation="Horizontal">-->
                <OnPlatform x:TypeArguments="View">
                    <On Platform="iOS">
                        <Image
                            Margin="0,30,10,10"
                            Aspect="AspectFit"
                            HeightRequest="36"
                            HorizontalOptions="CenterAndExpand"
                            Source="AppleStore">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToZakatyAppstoreCommand}" />

                            </Image.GestureRecognizers>

                        </Image>
                    </On>
                    <On Platform="Android">
                        <Image
                            HeightRequest="36"
                            HorizontalOptions="Start"
                            Source="GooglePlay">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToZakatyPlayStoreCommand}" />

                            </Image.GestureRecognizers>

                        </Image>
                    </On>
                </OnPlatform>
                <!-- </StackLayout>-->
                <!--#endregion-->
            </StackLayout>

        </ScrollView>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

