<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ReportOTP.InquiryAboutMyReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />
            <xct:IsListNotNullOrEmptyConverter x:Key="ListIsNotNullOrEmptyConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  My Pervious Reports Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.PerviousReports}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="30">

                        <!--  Choose the way to see your reports Label  -->
                        <Label
                            Margin="0,20,0,0"
                            FontSize="16"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="False"
                            Text="{x:Static ResourceManager:AppResources.InquriyMyReports}"
                            TextColor="#868894" />

                        <StackLayout
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalOptions="Start">

                            <!--  Phone Card  -->

                            <Grid
                                Padding="0"
                                HeightRequest="136"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="False"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background image selected  -->
                                <Image Aspect="AspectFill" Source="Unselected.png">

                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsPhoneSelected}"
                                            TargetType="Image"
                                            Value="True">
                                            <Setter Property="Source" Value="Unselected.png" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsPhoneSelected}"
                                            TargetType="Image"
                                            Value="False">
                                            <Setter Property="Source" Value="UnselectedCard.png" />
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>

                                <StackLayout
                                    Margin="20,0"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="20"
                                    VerticalOptions="CenterAndExpand">

                                    <!--  Phone icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="45"
                                        HorizontalOptions="StartAndExpand"
                                        Source="selectedPhone.png"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="45">

                                        <Image.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Image"
                                                Value="True">
                                                <Setter Property="Source" Value="selectedPhone.png" />
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Image"
                                                Value="False">
                                                <Setter Property="Source" Value="unSelectedPhone.png" />
                                            </DataTrigger>

                                        </Image.Triggers>

                                    </Image>

                                    <!--  Phone number Label  -->
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.MobileNumber}"
                                        TextColor="White">

                                        <Label.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Label"
                                                Value="False">
                                                <Setter Property="TextColor" Value="#232323" />
                                            </DataTrigger>


                                        </Label.Triggers>

                                    </Label>

                                </StackLayout>

                                <!--<Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CardSelectionCommand}"/>
                                </Grid.GestureRecognizers>-->

                            </Grid>


                            <!--  Report number card  -->

                            <Grid
                                Padding="0"
                                HeightRequest="136"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="False"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background image selected  -->
                                <Image Aspect="AspectFill" Source="UnselectedCard.png">

                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsPhoneSelected}"
                                            TargetType="Image"
                                            Value="False">
                                            <Setter Property="Source" Value="Unselected.png" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsPhoneSelected}"
                                            TargetType="Image"
                                            Value="True">
                                            <Setter Property="Source" Value="UnselectedCard.png" />
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>

                                <StackLayout
                                    Margin="20,0"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="20"
                                    VerticalOptions="CenterAndExpand">

                                    <!--  keyPad image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="45"
                                        HorizontalOptions="StartAndExpand"
                                        Source="unReportNumber.png"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="45">

                                        <Image.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Image"
                                                Value="False">
                                                <Setter Property="Source" Value="SelectedReport.png" />
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Image"
                                                Value="True">
                                                <Setter Property="Source" Value="unReportNumber.png" />
                                            </DataTrigger>

                                        </Image.Triggers>

                                    </Image>

                                    <!--  Report number label  -->
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.ZTEReportReportNumber}"
                                        TextColor="#232323">

                                        <Label.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Label"
                                                Value="False">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsPhoneSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="#232323" />
                                            </DataTrigger>


                                        </Label.Triggers>
                                    </Label>

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}" />
                                </Grid.GestureRecognizers>

                            </Grid>

                        </StackLayout>

                        <!--  Phone & Report no. Field  -->
                        <StackLayout Spacing="0">

                            <!--  Phone & Report no. Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.MobileNumber}">

                                <Label.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsPhoneSelected}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZTEReportReportNumber}" />
                                    </DataTrigger>

                                    <DataTrigger
                                        Binding="{Binding IsPhoneSelected}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                    </DataTrigger>


                                </Label.Triggers>

                            </Label>


                            <!--  Phone & Report no. Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                HasError="{Binding IsNeedRewardError}"
                                Hint="{x:Static ResourceManager:AppResources.MobileNumber}"
                                InputViewPadding="15,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">

                                <inputLayout:SfTextInputLayout.Triggers>

                                    <DataTrigger
                                        Binding="{Binding IsPhoneSelected}"
                                        TargetType="inputLayout:SfTextInputLayout"
                                        Value="True">
                                        <Setter Property="Hint" Value="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                    </DataTrigger>

                                    <DataTrigger
                                        Binding="{Binding IsPhoneSelected}"
                                        TargetType="inputLayout:SfTextInputLayout"
                                        Value="False">
                                        <Setter Property="Hint" Value="{x:Static ResourceManager:AppResources.ZTEReportReportNumber}" />
                                    </DataTrigger>

                                </inputLayout:SfTextInputLayout.Triggers>

                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <custom:GAZTBorderlessEntry
                                    x:Name="phoneEntry"
                                    Placeholder="{x:Static ResourceManager:AppResources.MobileNumber}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding PhoneORRportNumber}"
                                    TextColor="#58595B">

                                    <custom:GAZTBorderlessEntry.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsPhoneSelected}"
                                            TargetType="custom:GAZTBorderlessEntry"
                                            Value="True">
                                            <Setter Property="Placeholder" Value="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsPhoneSelected}"
                                            TargetType="custom:GAZTBorderlessEntry"
                                            Value="False">
                                            <Setter Property="Placeholder" Value="{x:Static ResourceManager:AppResources.ZTEReportReportNumber}" />
                                        </DataTrigger>

                                    </custom:GAZTBorderlessEntry.Triggers>

                                </custom:GAZTBorderlessEntry>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image
                                        Aspect="AspectFit"
                                        IsVisible="{Binding IsPhoneSelected}"
                                        Source="phoneIcon" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                            </inputLayout:SfTextInputLayout>

                        </StackLayout>


                        <!--  Inquire Report Button  -->
                        <buttons:SfButton
                            Margin="0,40"
                            Background="#0996D4"
                            Command="{Binding InquireReportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.Inquire}" />

                    </StackLayout>

                </ScrollView>

            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>
