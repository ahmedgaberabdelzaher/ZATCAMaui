<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatExemptionRequest.ZakatExemptionRequestListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="page"
    Title="ZakatExemptionRequestListPageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,2*,*"
                RowDefinitions="auto,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatExemptionRequest}"
                    VerticalOptions="Center" />

                <StackLayout
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalOptions="EndAndExpand"
                    Orientation="Horizontal"
                    Spacing="15"
                    VerticalOptions="CenterAndExpand">
                    <Image
                        HeightRequest="20"
                        IsVisible="{Binding IsSearchButtonVisible}"
                        Source="search"
                        WidthRequest="20">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="searchButtonTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        HeightRequest="20"
                        Source="filter"
                        WidthRequest="20">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="filterButtonTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

                <StackLayout
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    HorizontalOptions="FillAndExpand"
                    Orientation="Horizontal"
                    VerticalOptions="FillAndExpand">

                    <Grid HorizontalOptions="FillAndExpand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SearchBar
                            x:Name="searchBar"
                            Grid.Column="0"
                            Margin="0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsCloseButtonVisible}"
                            Keyboard="{OnPlatform Android=Numeric,
                                                  iOS=Default}"
                            TextChanged="SearchBar_TextChanged"
                            VerticalOptions="FillAndExpand" />

                        <Image
                            Grid.Column="1"
                            HeightRequest="24"
                            IsVisible="{Binding IsCloseButtonVisible}"
                            Source="close"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <listView:SfListView
                        x:Name="ListView_Returns"
                        Grid.Row="0"
                        AutoFitMode="Height"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        ItemsSource="{Binding CopiedZakatExemptionListViewData, Mode=TwoWay}"
                        ScrollBarVisibility="Never"
                        SelectionBackground="Transparent"
                        VerticalOptions="FillAndExpand">
                        <listView:SfListView.HeaderTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <ViewCell.View>
                                        <Border
                                            Margin="8"
                                            Padding="12"
                                            HorizontalOptions="FillAndExpand"
                                            StrokeShape="RoundRectangle 15"
                                            Style="{StaticResource GreyBorderFrameWithShadow}"
                                            VerticalOptions="FillAndExpand">
                                            <Grid x:Name="grid">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="add"
                                                    VerticalOptions="CenterAndExpand"
                                                    WidthRequest="24" />
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    FontSize="16"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentCreateNewRequest}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding CreateNewRequestTapped}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </Border>
                                    </ViewCell.View>
                                </ViewCell>
                            </DataTemplate>
                        </listView:SfListView.HeaderTemplate>

                        <listView:SfListView.ItemTemplate IsVisible="{Binding IsListVisible}">
                            <DataTemplate>
                                <ViewCell>
                                    <Border Margin="0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0,10">
                                            <Grid
                                                x:Name="grid"
                                                Padding="10"
                                                ColumnSpacing="15"
                                                RowSpacing="15">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedCommand, Source={x:Reference ListView_Returns}}" CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.RequestNumber}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding Fbnum}" />
                                                </StackLayout>

                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <buttons:SfButton
                                                        Background="{StaticResource Secondary}"
                                                        Command="{Binding Path=BindingContext.DownloadCertCommand, Source={x:Reference ListView_Returns}}"
                                                        CommandParameter="{Binding .}"
                                                        HeightRequest="40"
                                                        IsVisible="{Binding IsDownloadCert}"
                                                        Text="{x:Static ResourceManager:AppResources.DownloadCert}" />
                                                </StackLayout>

                                                <StackLayout Grid.Row="1" Grid.Column="0">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSubmissionDate}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding SubDate}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="1" Grid.Column="1">
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.NDPeriod}" />
                                                    <StackLayout HorizontalOptions="StartAndExpand">
                                                        <custom:CustomLabel
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding Persl}" />
                                                    </StackLayout>
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZStatus}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding StatusDesc}" />
                                                </StackLayout>
                                            </Grid>

                                        </StackLayout>
                                    </Border>
                                </ViewCell>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                    </listView:SfListView>

                    <custom:CustomLabel
                        Grid.Row="0"
                        Margin="0,40,0,0"
                        HorizontalOptions="Center"
                        IsVisible="{Binding NoDataAvailable}"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}"
                        VerticalOptions="Center" />



                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>