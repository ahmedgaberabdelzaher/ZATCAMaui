<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.NewDesign.ZakatExemptionRequest.ZakatExemptionRequestListPageView"
             Title="ZakatExemptionRequestListPageView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
            xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
            xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
            xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Name="page"
            ios:Page.UseSafeArea="true"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*"
            RowDefinitions="auto,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatExemptionRequest}"
                    VerticalOptions="Center" />

                <StackLayout Spacing="15" Orientation="Horizontal" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="2">
                        <Image Source="search" IsVisible="{TemplateBinding BindingContext.IsSearchButtonVisible}" HeightRequest="20" WidthRequest="20">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="searchButtonTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Source="filter" HeightRequest="20" WidthRequest="20">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="filterButtonTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                </StackLayout>

                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                    Grid.Row="1" Grid.ColumnSpan="3">

                        <Grid HorizontalOptions="FillAndExpand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <SearchBar x:Name="searchBar" Grid.Column="0" Keyboard="Numeric" BackgroundColor="White" custom:RoundCornersEffect.CornerRadius="12" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0" TextChanged="SearchBar_TextChanged" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                            </SearchBar>

                            <Image Grid.Column="1" WidthRequest="24" HeightRequest="24" Source="close" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="CloseSearchButton_Tapped">
                                    </TapGestureRecognizer>
                                </Image.GestureRecognizers>
                            </Image>

                        </Grid>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                     <listView:SfListView   x:Name="ListView_Returns" Grid.Row="0"
                      ItemsSource="{Binding CopiedZakatExemptionListViewData,Mode=TwoWay}"
                      HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand"
                      BackgroundColor="White"
                      ScrollBarVisibility="Never"
                      SelectionBackground="Transparent"
                      AutoFitMode="Height">
                <listView:SfListView.HeaderTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ViewCell.View>
                                <Border StrokeShape="RoundRectangle 15" HorizontalOptions="FillAndExpand" Padding="12" Style="{StaticResource GreyBorderFrameWithShadow}" VerticalOptions="FillAndExpand">
                                    <Grid  x:Name="grid">
                                       
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Row="0" Grid.Column="0" Source="add" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" VerticalOptions="CenterAndExpand"></Image>
                                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentCreateNewRequest}" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" FontSize="16" VerticalOptions="CenterAndExpand"/>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CreateNewRequestTapped}"></TapGestureRecognizer>
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Border>
                            </ViewCell.View>
                            </ViewCell>
                    </DataTemplate>
                </listView:SfListView.HeaderTemplate>

                <listView:SfListView.ItemTemplate IsVisible="{Binding IsListVisible}">
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0,10">
                                    <Grid Padding="10" RowSpacing="15" ColumnSpacing="15" x:Name="grid">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.ItemTappedCommand, Source={x:Reference ListView_Returns}}" CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>

                                        <Grid.RowDefinitions >
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.RequestNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding Fbnum}"  Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>

                                        <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                             <buttons:SfButton
                                                    Command="{Binding Path=BindingContext.DownloadCertCommand, Source={x:Reference ListView_Returns}}" 
                                                    CommandParameter="{Binding .}"
                                                    HeightRequest="40"
                                                    IsVisible="{Binding IsDownloadCert}"
                                                    Text="{x:Static ResourceManager:AppResources.DownloadCert}"
                                                    Style="{StaticResource PrimaryButtonStyle}"/> 
                                        </StackLayout>
                                                   
                                        <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSubmissionDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding SubDate}" Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>
                                        <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                            <custom:CustomLabel HorizontalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.NDPeriod}" Style="{StaticResource CaptionLabelGrey}"/>
                                            <StackLayout HorizontalOptions="StartAndExpand">
                                                <custom:CustomLabel HorizontalTextAlignment="Start"   Text="{Binding Persl}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                        </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZStatus}" Style="{StaticResource CaptionLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding StatusDesc}"  Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>
                                    </Grid>

                                </StackLayout>
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </listView:SfListView.ItemTemplate>

            </listView:SfListView>

            <custom:CustomLabel Grid.Row="0" Margin="0,40,0,0"  Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding NoDataAvailable}"/>

           

            </Grid>               

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>