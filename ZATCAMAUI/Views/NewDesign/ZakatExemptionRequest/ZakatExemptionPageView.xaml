<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.NewDesign.ZakatExemptionRequest.ZakatExemptionPageView"
             Title="ZakatExemptionPageView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
            xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
            xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
            xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
            x:Name="page"
            ios:Page.UseSafeArea="true"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

<ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                     Text="{x:Static ResourceManager:AppResources.ZakatExemptionRequest}" 
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">
                
                <Grid RowDefinitions="*">
                                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,25,20,0" MaxNum="{Binding MaxIndex}"
                                                  MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}"
                                                  VerticalOptions="CenterAndExpand" DotSize="12" HorizontalOptions="End"/>
                </Grid>




                <Grid Grid.Row="1" VerticalOptions="FillAndExpand">

                    <StackLayout IsVisible="{Binding ZakatExcemptionTPDetailsVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                          HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                          <Label Padding="0,10,0,0"
                                            LineHeight="0.7"
                                            Text="{x:Static ResourceManager:AppResources.CRTPDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                        <BoxView HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <Border StrokeShape="RoundRectangle 15"
                                Margin="0,10,0,20"
                                HorizontalOptions="FillAndExpand"
                                Padding="12"
                                Style="{StaticResource GreyBorderFrameWithShadow}"
                                VerticalOptions="Fill">
                            <Grid>
                                 <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />

                                  </Grid.RowDefinitions>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>

                                  <Label Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTPZENAME}" Style="{StaticResource GAZTSmallBlackLblMediumFont}"/>
                                  <Label Grid.Row="0" Grid.Column="1" Text="" x:Name="TPNAME" Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>

                                  <Label Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTPZECN}" Style="{StaticResource GAZTSmallBlackLblMediumFont}"/>
                                  <Label Grid.Row="1" Grid.Column="1" Text=""  x:Name="TPCN" Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>

                                  <Label Grid.Row="2" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTPZEACTY}" Style="{StaticResource GAZTSmallBlackLblMediumFont}"/>
                                  <Label Grid.Row="2" Grid.Column="1" Text=""  x:Name="TPACTY" Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>

                                  <Label Grid.Row="3" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTPZEMN}" Style="{StaticResource GAZTSmallBlackLblMediumFont}"/>
                                  <Label Grid.Row="3" Grid.Column="1" Text=""  x:Name="TPMN" Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>

                                  <Label Grid.Row="4" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTPZETIN}" Style="{StaticResource GAZTSmallBlackLblMediumFont}"/>
                                  <Label Grid.Row="4" Grid.Column="1" Text=""  x:Name="TPTIN" Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>

                                  <Label Grid.Row="5" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTPZECNDATE}" Style="{StaticResource GAZTSmallBlackLblMediumFont}"/>
                                  <Label Grid.Row="5" Grid.Column="1" Text=""  x:Name="TPCNDATE" Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>

                                  <Label Grid.Row="6" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTPZEEA}" Style="{StaticResource GAZTSmallBlackLblMediumFont}"/>
                                  <Label Grid.Row="6" Grid.Column="1" Text="" x:Name="TPEA"  Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>


                            </Grid>
                         </Border>

                        <buttons:SfButton Grid.Row="5" Margin="0,16,0,16"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding ZakatExcemptionTPDetailsBtnTapped}" /> 

                    </StackLayout>

                     <StackLayout IsVisible="{Binding ZakatExemptionYearVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                          HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                       

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZakatExemptionYear}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                           
                            <BoxView Grid.Row="2" HorizontalOptions="StartAndExpand" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,10">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />

                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}">
                                 <Label.FormattedText>
                                        <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZakatExemptionYearToBeExempted}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                              </Label>

                            <Border Grid.Row="1" Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding SelectedYear}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="{StaticResource Secondary}" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowExemptionYearPicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>


                                </Grid>
                            </Border>

                           

                            <StackLayout Margin="0,15,0,15" Grid.Row="2">
                            <Border Stroke="#bbbbbb" BackgroundColor="White" StrokeShape="RoundRectangle 10" Padding="10">
                                <StackLayout>
                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>

                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Style="{StaticResource SmallIcon}" HorizontalOptions="Start" Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="#909090" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.Information}"/>
                                            </Image.Source>
                                        </Image>
                                        <Label HorizontalTextAlignment="Start" Grid.Column="1" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatExceptionInfo}" />
                                    </Grid>
                                </StackLayout>
                            </Border>
                        </StackLayout>



                        </Grid>
                        
                        <buttons:SfButton Grid.Row="5" Margin="0,16,0,16"
                                          Background="{Binding ZakatExemptionYearButtonBackGroundColor}"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding ZakatExemptionYearConBtnTapped}" />


                    </StackLayout>



                    <StackLayout IsVisible="{Binding EntityInformationVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                          HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                       

                        <Grid Grid.Row="0" Margin="0,5,0,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0"
                                                LineHeight="0.7"
                                                Text="{x:Static ResourceManager:AppResources.ZakatEntityInformation}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                           
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,10">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />

                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}">
                                 <Label.FormattedText>
                                        <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZakatExemptionEntityType}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                              </Label>

                            <Border Grid.Row="1" Padding="10" Style="{StaticResource GreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding SelectedEntityType}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="{StaticResource Secondary}" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowEntityTypePicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>


                                </Grid>
                            </Border>

                            <Label Grid.Row="2" HorizontalOptions="StartAndExpand" Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}" IsVisible="{Binding IsNew}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.EntityCategory}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Border Grid.Row="3" Padding="10" Style="{StaticResource GreyBorderFrame}" IsVisible="{Binding IsNew}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding SelectedEntityIDCategory}"
                         HorizontalOptions="FillAndExpand"
                         Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="{StaticResource Secondary}" Size="28"
                              Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowEntityCategoryPicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>


                                </Grid>
                            </Border>

                            <Label Grid.Row="4"  IsVisible="{Binding IsCharitabletrustsAndFoundations}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}">
                                 <Label.FormattedText>
                                        <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZakatExemptionCharitableTrust}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                              </Label>

                            <Border Grid.Row="5" Padding="10" Style="{StaticResource GreyBorderFrame}" IsVisible="{Binding IsCharitabletrustsAndFoundations}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding CompanyEstablishmentOther}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="{StaticResource Secondary}" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowComEstablishOtherPicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>


                                </Grid>
                            </Border>

                            <Label Grid.Row="6"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}">
                                 <Label.FormattedText>
                                        <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZakatExemptionNatureOfEntity}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                              </Label>

                            <Border Grid.Row="7"  Padding="10" Style="{StaticResource GreyBorderFrame}">

                                <custom:GAZTBorderlessEntry HorizontalOptions="FillAndExpand"
                                                        Text="{Binding NatureOfEntity}"
                                                        TextColor="{StaticResource NeutralBlack}"
                                                        FontFamily="{StaticResource SomarRegular}" FontSize="15"
                                                        TextChanged="NatureOfEntity_TextChanged"/>
                            </Border>

                            <Label Grid.Row="8"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}" IsVisible="{Binding IsOffspringVisible}">
                                 <Label.FormattedText>
                                        <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZakatExemptionOffSpringPercentage}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                              </Label>

                            <Border Grid.Row="9" Padding="10" Style="{StaticResource GreyBorderFrame}" IsVisible="{Binding IsOffspringVisible}">
                                <custom:GAZTBorderlessEntry
                                                    Keyboard="Numeric"
                                                    HorizontalOptions="FillAndExpand"
                                                            Text="{Binding OffSpringPercentage}"
                                                            TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SomarRegular}" FontSize="15"/>
                            </Border>

                            <Label Grid.Row="10"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}" IsVisible="{Binding IsOffspringVisible}">
                                 <Label.FormattedText>
                                        <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZakatExemptionCharityPercentage}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                              </Label>

                            <Border Grid.Row="11"  Padding="10" Style="{StaticResource GreyBorderFrame}" IsVisible="{Binding IsOffspringVisible}">
                                <custom:GAZTBorderlessEntry
                                                    Keyboard="Numeric"
                                                    HorizontalOptions="FillAndExpand"
                                                    Text="{Binding CharityPercentage}"
                                                    TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SomarRegular}" FontSize="15"/>
                            </Border>

                            
                        </Grid>
                        
                        <buttons:SfButton Grid.Row="10" Margin="0,16,0,16"
                                          Background="{Binding ZakatEntityInfoButtonBackGroundColor}"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Clicked="EntityInfoConBtn_Clicked"/>

                    </StackLayout>

                    <StackLayout IsVisible="{Binding AttachmentInformationVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                        HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">

                        <Label Padding="0,10,0,0"
                                            LineHeight="0.7"
                                            Text="{x:Static ResourceManager:AppResources.CRAttachments}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />

                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                         <StackLayout x:Name="layout_attachment"/>
                       

                    <buttons:SfButton Grid.Row="8"
                                        Margin="0,16,0,16"
                                        Background="{Binding ZakatAttachmentButtonBackGroundColor}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AttachmentsConBtnTapped}"/> 

                </StackLayout>

                    <StackLayout IsVisible="{Binding JustificationInformationVisible}" BackgroundColor="Transparent" Margin="20,10,20,0" Orientation="Vertical"
                          HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <Label Text="{x:Static ResourceManager:AppResources.ZakatExemptionJustificationReq}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />

                        <BoxView HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <Border StrokeShape="RoundRectangle 15"
                                            Margin="0,10,0,20"
                                            HorizontalOptions="FillAndExpand"
                                            Padding="12"
                                            Style="{StaticResource GreyBorderFrameWithShadow}"
                                            VerticalOptions="Fill">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0"
                                        Grid.Column="0"
                                        Source="add"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        HorizontalOptions="Start"
                                        VerticalOptions="CenterAndExpand"></Image>
                                <Label Grid.Row="0"
                                        Grid.Column="1"
                                       Text="{x:Static ResourceManager:AppResources.ZakatExemptionAddJustification}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                        FontSize="16"
                                        VerticalOptions="CenterAndExpand" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddNewJustificationTapped}"></TapGestureRecognizer>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <StackLayout VerticalOptions="Fill" HorizontalOptions="FillAndExpand">
                           
                            <Border Margin="0,0,0,10"
                                                Padding="12"
                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                <custom:GAZTBorderlessEditor Text="{Binding JusticationOne}"
                                                             MinimumHeightRequest="180"
                                                             AutoSize="TextChanges"
                                                             MaxLength="500"
                                                             VerticalOptions="CenterAndExpand"
                                                             HorizontalOptions="FillAndExpand"
                                                             Style="{StaticResource BodyLabelBlack}" />
                            </Border>
                                              
                        </StackLayout>

                        <Border IsVisible="{Binding IsJustificationOneVisible}" 
                                            Margin="0,0,0,10" Padding="12" Style="{StaticResource SfStyleGreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="9*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <custom:GAZTBorderlessEditor Text="{Binding JusticationTwo}"
                                                             MinimumHeightRequest="180"
                                                             AutoSize="TextChanges"
                                                             MaxLength="500"
                                                             VerticalOptions="CenterAndExpand"
                                                             HorizontalOptions="FillAndExpand"
                                                             Style="{StaticResource BodyLabelBlack}" />
                                <Image Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Rotation="90">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont"
                                                            Color="{StaticResource SecondaryNew}"
                                                            Size="24"
                                                            Glyph="{x:Static FontImage:IconFonts.Close}" />
                                    </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding RemoveJustificiationOne}"></TapGestureRecognizer>
                                        </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>
                        
                        
                        
                            <Border IsVisible="{Binding IsJustificationTwoVisible}"
                                             Margin="0,0,0,10"
                                             Padding="12"
                                             Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="9*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <!--<custom:GAZTBorderlessEntry Text="" />-->

                                     <custom:GAZTBorderlessEditor Text="{Binding JusticationThree}"
                                                             MinimumHeightRequest="180"
                                                             AutoSize="TextChanges"
                                                             MaxLength="500"
                                                             VerticalOptions="CenterAndExpand"
                                                             HorizontalOptions="FillAndExpand"
                                                             Style="{StaticResource BodyLabelBlack}" />

                                    <Image Grid.Row="0"
                                           Grid.Column="2"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}"
                                                             Size="24"
                                                             Glyph="{x:Static FontImage:IconFonts.Close}" />
                                        </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding RemoveJustificiationTwo}"></TapGestureRecognizer>
                                            </Image.GestureRecognizers>
                                        </Image>
                                </Grid>
                            </Border>

                            <Border IsVisible="{Binding IsJustificationThreeVisible}"
                                                 Margin="0,0,0,10"
                                                 Padding="12"
                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="9*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <custom:GAZTBorderlessEditor Text="{Binding JusticationFour}"
                                                             MinimumHeightRequest="180"
                                                             AutoSize="TextChanges"
                                                             MaxLength="500"
                                                             VerticalOptions="CenterAndExpand"
                                                             HorizontalOptions="FillAndExpand"
                                                             Style="{StaticResource BodyLabelBlack}" />
                                    <Image Grid.Row="0"
                                            Grid.Column="2"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                                Color="{StaticResource SecondaryNew}"
                                                                Size="24"
