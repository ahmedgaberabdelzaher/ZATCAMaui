<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatExemptionRequest.ZakatExemptionPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="page"
    Title="ZakatExemptionPageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatExemptionRequest}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">
                    <ScrollView
                        HorizontalOptions="FillAndExpand"
                        HorizontalScrollBarVisibility="Never"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>



                            <Grid Grid.Row="0">
                                <commonView:PageIndicatorView
                                    Margin="20,25,20,0"
                                    Completed="{Binding MarkComplete}"
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}"
                                    VerticalOptions="CenterAndExpand"
                                    />
                            </Grid>




                            <Grid Grid.Row="1" VerticalOptions="FillAndExpand">

                                <!--#region TaxPayerDetails-->
                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding ZakatExcemptionTPDetailsVisible}"
                                    VerticalOptions="FillAndExpand">

                                    <Label
                                        Padding="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        LineHeight="0.7"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CRTPDetails}" />
                                    <BoxView HorizontalOptions="StartAndExpand" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Border
                                        Margin="0,10,0,20"
                                        Padding="12"
                                        HorizontalOptions="FillAndExpand"
                                        StrokeShape="RoundRectangle 15"
                                        Style="{StaticResource GreyBorderFrameWithShadow}"
                                        VerticalOptions="Fill">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*" />
                                                <ColumnDefinition Width="50*" />
                                            </Grid.ColumnDefinitions>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                Text="{x:Static ResourceManager:AppResources.CRTPZENAME}" />
                                            <Label
                                                x:Name="TPNAME"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                Text="" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                Text="{x:Static ResourceManager:AppResources.CRTPZECN}" />
                                            <Label
                                                x:Name="TPCN"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                Text="" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                Text="{x:Static ResourceManager:AppResources.CRTPZEACTY}" />
                                            <Label
                                                x:Name="TPACTY"
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                Text="" />

                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                Text="{x:Static ResourceManager:AppResources.CRTPZEMN}" />
                                            <Label
                                                x:Name="TPMN"
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                Text="" />

                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                Text="{x:Static ResourceManager:AppResources.CRTPZETIN}" />
                                            <Label
                                                x:Name="TPTIN"
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                Text="" />

                                            <Label
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                Text="{x:Static ResourceManager:AppResources.CRTPZECNDATE}" />
                                            <Label
                                                x:Name="TPCNDATE"
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                Text="" />

                                            <Label
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                                Text="{x:Static ResourceManager:AppResources.CRTPZEEA}" />
                                            <Label
                                                x:Name="TPEA"
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                Text="" />


                                        </Grid>
                                    </Border>

                                    <buttons:SfButton
                                        Grid.Row="5"
                                        Margin="0,16,0,16"
                                        Command="{Binding ZakatExcemptionTPDetailsBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}" />

                                </StackLayout>
                                <!--#endregion-->
                                <!--#region Zakat exemption year section-->
                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding ZakatExemptionYearVisible}"
                                    VerticalOptions="FillAndExpand">


                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatExemptionYear}" />

                                        <BoxView
                                            Grid.Row="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,10,0,10">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />

                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatExemptionYearToBeExempted}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <custom:CustomSfTextInputView Grid.Row="1">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Keyboard="Text"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding SelectedYear}"
                                                    TextColor="#58595B">
                                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ShowExemptionYearPicker}" />
                                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                </custom:GAZTBorderlessEntry>

                                            </custom:CustomSfTextInputView.TextInputView>
                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowExemptionYearPicker}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                            <inputLayout:SfTextInputLayout.TrailingView>

                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </custom:CustomSfTextInputView>

                                        <StackLayout Grid.Row="2" Margin="0,15,0,15">
                                            <Border
                                                Padding="10"
                                                BackgroundColor="White"
                                                Stroke="#bbbbbb"
                                                StrokeShape="RoundRectangle 10">
                                                <StackLayout>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />

                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource SmallIcon}"
                                                            VerticalOptions="Start">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.Information}"
                                                                    Size="30"
                                                                    Color="#909090" />
                                                            </Image.Source>
                                                        </Image>
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZakatExceptionInfo}" />
                                                    </Grid>
                                                </StackLayout>
                                            </Border>
                                        </StackLayout>



                                    </Grid>

                                    <buttons:SfButton
                                        Grid.Row="5"
                                        Margin="0,16,0,16"
                                        Background="{Binding ZakatExemptionYearButtonBackGroundColor}"
                                        Command="{Binding ZakatExemptionYearConBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}" />


                                </StackLayout>
                                <!--#endregion-->

                                <!--#region Entitiy Information-->
                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding EntityInformationVisible}"
                                    VerticalOptions="FillAndExpand">


                                    <Grid Grid.Row="0" Margin="0,5,0,7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            LineHeight="0.7"
                                            Style="{StaticResource PageTitleBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatEntityInformation}" />

                                        <BoxView
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,10,0,10">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />

                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatExemptionEntityType}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <custom:CustomSfTextInputView Grid.Row="1">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Keyboard="Text"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding SelectedEntityType}"
                                                    TextColor="#58595B">
                                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ShowEntityTypePicker}" />
                                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                </custom:GAZTBorderlessEntry>

                                            </custom:CustomSfTextInputView.TextInputView>
                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowEntityTypePicker}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                            <inputLayout:SfTextInputLayout.TrailingView>

                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </custom:CustomSfTextInputView>
                                        <Label
                                            Grid.Row="2"
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="StartAndExpand"
                                            IsVisible="{Binding IsNew}"
                                            Style="{StaticResource MicroGrayLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.EntityCategory}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <custom:CustomSfTextInputView Grid.Row="3" IsVisible="{Binding IsNew}">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Keyboard="Text"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding SelectedEntityIDCategory}"
                                                    TextColor="#58595B">
                                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ShowEntityCategoryPicker}" />
                                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                </custom:GAZTBorderlessEntry>

                                            </custom:CustomSfTextInputView.TextInputView>
                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowEntityCategoryPicker}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                            <inputLayout:SfTextInputLayout.TrailingView>

                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </custom:CustomSfTextInputView>

                                        <Label
                                            Grid.Row="4"
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="StartAndExpand"
                                            IsVisible="{Binding IsCharitabletrustsAndFoundations}"
                                            Style="{StaticResource MicroGrayLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatExemptionCharitableTrust}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>


                                        <custom:CustomSfTextInputView Grid.Row="5" IsVisible="{Binding IsCharitabletrustsAndFoundations}">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Keyboard="Text"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding CompanyEstablishmentOther}"
                                                    TextColor="#58595B">
                                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ShowComEstablishOtherPicker}" />
                                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                </custom:GAZTBorderlessEntry>

                                            </custom:CustomSfTextInputView.TextInputView>
                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowComEstablishOtherPicker}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                            <inputLayout:SfTextInputLayout.TrailingView>

                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </custom:CustomSfTextInputView>

                                        <Label
                                            Grid.Row="6"
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatExemptionNatureOfEntity}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>

                                        </Label>

                                        <custom:CustomSfTextInputView Grid.Row="7">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="True"
                                                    Keyboard="Text"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding NatureOfEntity}"
                                                    TextChanged="NatureOfEntity_TextChanged"
                                                    TextColor="#58595B" />
                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>



                                        <Label
                                            Grid.Row="8"
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="StartAndExpand"
                                            IsVisible="{Binding IsOffspringVisible}"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatExemptionOffSpringPercentage}" />

                                        <custom:CustomSfTextInputView Grid.Row="9" IsVisible="{Binding IsOffspringVisible}">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="True"
                                                    Keyboard="Numeric"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding OffSpringPercentage}"
                                                    TextColor="#58595B" />

                                            </custom:CustomSfTextInputView.TextInputView>

                                        </custom:CustomSfTextInputView>



                                        <Label
                                            Grid.Row="10"
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="StartAndExpand"
                                            IsVisible="{Binding IsOffspringVisible}"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatExemptionCharityPercentage}" />



                                        <custom:CustomSfTextInputView Grid.Row="11" IsVisible="{Binding IsOffspringVisible}">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    InputTransparent="True"
                                                    Keyboard="Numeric"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding CharityPercentage}"
                                                    TextColor="#58595B" />

                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>


                                    </Grid>

                                    <buttons:SfButton
                                        Grid.Row="10"
                                        Margin="0,16,0,16"
                                        Background="{Binding ZakatEntityInfoButtonBackGroundColor}"
                                        Clicked="EntityInfoConBtn_Clicked"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}" />

                                </StackLayout>
                                <!--#endregion-->

                                <!--#region AttachmentInformation-->
                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding AttachmentInformationVisible}"
                                    VerticalOptions="FillAndExpand">

                                    <Label
                                        Padding="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        LineHeight="0.7"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CRAttachments}" />

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                    <StackLayout x:Name="layout_attachment" />


                                    <buttons:SfButton
                                        Grid.Row="8"
                                        Margin="0,16,0,16"
                                        Background="{Binding ZakatAttachmentButtonBackGroundColor}"
                                        Command="{Binding AttachmentsConBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}" />

                                </StackLayout>
                                <!--#endregion-->

                                <!--#region JustificationInformation-->
                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding JustificationInformationVisible}"
                                    VerticalOptions="FillAndExpand">

                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatExemptionJustificationReq}" />

                                    <BoxView HorizontalOptions="StartAndExpand" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Border
                                        Margin="0,10,0,20"
                                        Padding="12"
                                        HorizontalOptions="FillAndExpand"
                                        StrokeShape="RoundRectangle 15"
                                        Style="{StaticResource GreyBorderFrameWithShadow}"
                                        VerticalOptions="Fill">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="add"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="24" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontSize="16"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatExemptionAddJustification}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding AddNewJustificationTapped}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Border>

                                    <custom:CustomSfTextInputView HorizontalOptions="FillAndExpand" VerticalOptions="Fill">
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEditor
                                                AutoSize="TextChanges"
                                                HorizontalOptions="FillAndExpand"
                                                MaxLength="500"
                                                MinimumHeightRequest="180"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding JusticationOne}"
                                                VerticalOptions="CenterAndExpand" />
                                        </custom:CustomSfTextInputView.TextInputView>
                                    </custom:CustomSfTextInputView>

                                    <custom:CustomSfTextInputView Padding="12" IsVisible="{Binding IsJustificationOneVisible}">
                                        <custom:CustomSfTextInputView.TextInputView>

                                            <custom:GAZTBorderlessEditor
                                                AutoSize="TextChanges"
                                                HorizontalOptions="FillAndExpand"
                                                MaxLength="500"
                                                MinimumHeightRequest="180"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding JusticationTwo}"
                                                VerticalOptions="CenterAndExpand" />
                                        </custom:CustomSfTextInputView.TextInputView>
                                        <inputLayout:SfTextInputLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding RemoveJustificiationOne}" />
                                        </inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image HorizontalOptions="FillAndExpand" Rotation="90">
