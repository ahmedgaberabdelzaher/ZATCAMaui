                            <Border Margin="0,16,0,10" Padding="0,0,0,16"  Style="{StaticResource GreyBorderFrameWithShadow}" IsVisible="{Binding ShowTermsOnSubmit}">

                                <StackLayout Padding="15,15,15,0" VerticalOptions="FillAndExpand">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0" VerticalOptions="CenterAndExpand">
                                            <Image >
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource Primary}" Size="24"
                                                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                                </Image.Source>

                                            </Image>
                                        </Grid>

                                        <Grid Grid.Row="0" Grid.Column="1" VerticalOptions="CenterAndExpand">
                                            <Label Text="{x:Static ResourceManager:AppResources.CRInformation}"
                                            HorizontalOptions="Start"
                                            Style="{StaticResource SectionTitleBlackBold}" />
                                        </Grid>
                                    </Grid>

                                    <Label Text="{x:Static ResourceManager:AppResources.ZakatExemptionTerms}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    Style="{StaticResource BodyLabelGrey}" />

                                </StackLayout>
                            </Border>
                            <!--Additional attachment-->
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical" IsVisible="{Binding IsEditRequired, Converter={StaticResource xBoolToVisibilityConverter}}">
                                <!--Text="{x:Static ResourceManager:AppResources.MemorandumOfAssociation}"-->
                                <Label Text=" "
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <listView:SfListView HorizontalOptions="Center" Grid.Row="0"
                                                    ScrollBarVisibility="Never" IsScrollingEnabled="False"
                                                    VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                                    ItemsSource="{Binding AdditionalAttachmentsListViewData}"
                                                    TapCommand="{Binding AddtionalAtachmentTapped}"
                                                    SelectionMode="SingleDeselect">
                                        <listView:SfListView.ItemTemplate>

                                        <DataTemplate>
                                                <Grid HorizontalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Row="0" Grid.Column="0" Source="newui_ic_pdf" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                            HorizontalOptions="Start" VerticalOptions="Center"/>

                                                            <Label Grid.Row="0" Grid.Column="1"
                                                                    Text="{Binding Filename}"
                                                                    Style="{StaticResource CaptionLabelBlack}"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    VerticalOptions="Center"/>

                                                            <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            Rotation="90">
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}"
                                                                                Size="24"
                                                                                Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                    

                                    <Grid Grid.Row="1" HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0"
                                                            FontFamily="{StaticResource SomarRegular}"
                                                            HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" >
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.FDANewAttachment}"  />
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource SomarRegular}"
                                                        Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                        FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                        HorizontalOptions="FillAndExpand" />
                                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                            Rotation="90">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}" Size="24"
                                                                Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AddtionalAtachmentTapped}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <buttons:SfButton Margin="0,5,0,85" Grid.Row="2"
                                              Text="{x:Static ResourceManager:AppResources.Submit}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding SummaryConBtnTapped}"
                                              VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand" />
                                </Grid>
                            </StackLayout>

                            <buttons:SfButton Margin="0,5,0,85"
                                              IsVisible="{Binding PageOnEditMode, Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                              Text="{x:Static ResourceManager:AppResources.Submit}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding SummaryConBtnTapped}"
                                              VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand" />

                        </StackLayout>
                    </StackLayout>

                    
                </Grid>

            </Grid>
        </ScrollView>
                </Grid>
               

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>


</ContentPage>
