                                                                    <DataTemplate>
                                                                        <StackLayout>
                                                                            <Label
                                                                                HorizontalOptions="EndAndExpand"
                                                                                HorizontalTextAlignment="End"
                                                                                Style="{StaticResource BodyLabelBlack}"
                                                                                Text="{Binding Filename}" />
                                                                        </StackLayout>
                                                                    </DataTemplate>
                                                                </listView:SfListView.ItemTemplate>
                                                            </listView:SfListView>

                                                        </StackLayout>
                                                    </Border>

                                                </StackLayout>
                                            </StackLayout>

                                        </Border>

                                        <!--  Justification Summary  -->
                                        <Border
                                            Margin="0,16,0,10"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrameWithShadow}"
                                            VerticalOptions="FillAndExpand">

                                            <StackLayout
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Vertical"
                                                VerticalOptions="FillAndExpand">

                                                <StackLayout Padding="15" Orientation="Horizontal">
                                                    <Grid
                                                        ColumnDefinitions="Auto,5*,Auto"
                                                        HorizontalOptions="FillAndExpand"
                                                        RowDefinitions="auto">
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Aspect="AspectFit"
                                                            HeightRequest="24"
                                                            HorizontalOptions="Start"
                                                            Source="establishments"
                                                            VerticalOptions="Center"
                                                            WidthRequest="24" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Padding="8,0"
                                                            MaxLines="3"
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text="{x:Static ResourceManager:AppResources.ZakatExemptionJustificationReq}"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="2"
                                                            Padding="8,0"
                                                            FontSize="Medium"
                                                            HorizontalOptions="EndAndExpand"
                                                            IsVisible="{Binding PageOnEditMode, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                                            MaxLines="1"
                                                            Style="{StaticResource GAZTCaptioSecondarylStyle}"
                                                            Text="{x:Static ResourceManager:AppResources.CREdit}"
                                                            VerticalOptions="CenterAndExpand">

                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding GoBackToZakatExemptionJustifications}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>

                                                </StackLayout>


                                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                <StackLayout
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.Justification}" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding JusticationOne}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsJustificationOneVisible}"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.Justification}" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding JusticationTwo}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsJustificationTwoVisible}"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.Justification}" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding JusticationThree}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsJustificationThreeVisible}"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.Justification}" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding JusticationFour}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    IsVisible="{Binding IsJustificationFiveVisible}"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="Justification" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding JusticationFive}" />
                                                </StackLayout>

                                            </StackLayout>

                                        </Border>

                                        <Border
                                            Margin="0,16,0,10"
                                            Padding="0,0,0,16"
                                            IsVisible="{Binding ShowTermsOnSubmit}"
                                            Style="{StaticResource GreyBorderFrameWithShadow}">

                                            <StackLayout Padding="15,15,15,0" VerticalOptions="FillAndExpand">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="40" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Image>
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                                    Size="24"
                                                                    Color="{StaticResource Primary}" />
                                                            </Image.Source>

                                                        </Image>
                                                    </Grid>

                                                    <Grid
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text="{x:Static ResourceManager:AppResources.CRInformation}" />
                                                    </Grid>
                                                </Grid>

                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatExemptionTerms}"
                                                    VerticalOptions="Start" />

                                            </StackLayout>
                                        </Border>
                                        <!--  Additional attachment  -->
                                        <StackLayout
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsEditRequired, Converter={StaticResource xBoolToVisibilityConverter}}"
                                            VerticalOptions="FillAndExpand">
                                            <!--  Text="{x:Static ResourceManager:AppResources.MemorandumOfAssociation}"  -->
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text=" " />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <listView:SfListView
                                                    Grid.Row="0"
                                                    AutoFitMode="Height"
                                                    HorizontalOptions="Center"
                                                    IsScrollingEnabled="False"
                                                    ItemSpacing="5"
                                                    ItemsSource="{Binding AdditionalAttachmentsListViewData}"
                                                    ScrollBarVisibility="Never"
                                                    SelectionMode="SingleDeselect"
                                                    TapCommand="{Binding AddtionalAtachmentTapped}"
                                                    VerticalOptions="Center">
                                                    <listView:SfListView.ItemTemplate>

                                                        <DataTemplate>
                                                            <Grid HorizontalOptions="FillAndExpand">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>

                                                                <Border
                                                                    Grid.Row="0"
                                                                    Margin="0,0,0,10"
                                                                    Padding="12"
                                                                    Style="{StaticResource SfStyleGreyBorderFrame}">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="auto" />
                                                                        </Grid.RowDefinitions>

                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Image
                                                                            Grid.Row="0"
                                                                            Grid.Column="0"
                                                                            Margin="5,0"
                                                                            HeightRequest="25"
                                                                            HorizontalOptions="Start"
                                                                            Source="newui_ic_pdf"
                                                                            VerticalOptions="Center"
                                                                            WidthRequest="25" />

                                                                        <Label
                                                                            Grid.Row="0"
                                                                            Grid.Column="1"
                                                                            HorizontalOptions="FillAndExpand"
                                                                            Style="{StaticResource CaptionLabelBlack}"
                                                                            Text="{Binding Filename}"
                                                                            VerticalOptions="Center" />

                                                                        <Image
                                                                            Grid.Row="0"
                                                                            Grid.Column="2"
                                                                            HorizontalOptions="Center"
                                                                            Rotation="90"
                                                                            VerticalOptions="Center">
                                                                            <Image.Source>
                                                                                <FontImageSource
                                                                                    FontFamily="UserIconFont"
                                                                                    Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                                    Size="24"
                                                                                    Color="{StaticResource SecondaryNew}" />
                                                                            </Image.Source>
                                                                        </Image>
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </listView:SfListView.ItemTemplate>
                                                </listView:SfListView>


                                                <Grid Grid.Row="1" HorizontalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Label
                                                        Grid.Row="0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource MicroGrayLabelStyle}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.FDANewAttachment}" />
                                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <Border
                                                        Grid.Row="1"
                                                        Margin="0,0,0,10"
                                                        Padding="10"
                                                        Style="{StaticResource SfStyleGreyBorderFrame}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource SomarRegular}"
                                                                FontSize="Small"
                                                                HorizontalOptions="FillAndExpand"
                                                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                                TextColor="{StaticResource PrimaryColor}" />
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                HorizontalOptions="Center"
                                                                Rotation="90"
                                                                VerticalOptions="Center">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                                        Size="24"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding AddtionalAtachmentTapped}" />
                                                    </Grid.GestureRecognizers>
                                                </Grid>

                                                <buttons:SfButton
                                                    Grid.Row="2"
                                                    Margin="0,5,0,85"
                                                    Command="{Binding SummaryConBtnTapped}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.Submit}"
                                                    VerticalOptions="FillAndExpand" />
                                            </Grid>
                                        </StackLayout>

                                        <buttons:SfButton
                                            Margin="0,5,0,85"
                                            Command="{Binding SummaryConBtnTapped}"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding PageOnEditMode, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.Submit}"
                                            VerticalOptions="FillAndExpand" />

                                    </StackLayout>
                                </StackLayout>
                                <!--#endregion-->


                            </Grid>

                        </Grid>
                    </ScrollView>
                </Grid>


            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>


</ContentPage>
