<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatExemptionRequest.ZakatExemptionSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Name="page"
    Title="ZakatExemptionSuccessPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>


            <ScrollView
                Grid.Row="0"
                Margin="0,8,0,0"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center">
                <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="Start">

                    <Image Source="Forget_ic_success" />
                    <Label
                        Margin="0,20,0,0"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleBlack}"
                        StyleId="OnBoardText"
                        Text="{x:Static ResourceManager:AppResources.ZakatExemptionRequest}"
                        TextColor="White" />

                    <Label
                        Margin="10,-10,10,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyLabelBlack}"
                        Text="{x:Static ResourceManager:AppResources.ZakatExemptionSuccess}"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />

                </StackLayout>
            </ScrollView>

            <Border
                Grid.Row="1"
                Padding="0,10,0,40"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">

                <Grid
                    Padding="20,0,20,0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0">

                        <ScrollView >
                            <StackLayout Spacing="0">

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,5,15,5" Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Label
                                                x:Name="TaxpayerName"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>
                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,5,15,5" Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Label
                                                x:Name="RequestReferenceNumber"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>

                                        <Image Source="zakat_copy.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopyReferenceNumberButtonClicked" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,5,15,5" Orientation="Horizontal">

                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatReceiptDate}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Label
                                                x:Name="ReceiptDate"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>
                                    </StackLayout>
                                </Border>


                            </StackLayout>
                        </ScrollView>
                    </StackLayout>
                    <StackLayout
                        Grid.Row="1"
                        Padding="0,2,0,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        
                        Spacing="4"
                        VerticalOptions="FillAndExpand">
                        <buttons:SfButton
                            Margin="0,0,0,2"
                            Clicked="Dashboard_Tapped"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.Back}" />


                    </StackLayout>
                </Grid>
            </Border>

        </Grid>
    </ContentPage.Content>
</ContentPage>