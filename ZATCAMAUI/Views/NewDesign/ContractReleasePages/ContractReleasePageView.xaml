<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ContractReleasePages.ContractReleasePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:SfChipGroup="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"

    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    HideSoftInputOnTapped="True"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ContractRelease}"
                    VerticalOptions="Center" />

                <Image
                    Grid.Row="0"
                    Grid.Column="2"
                    HeightRequest="24"
                    HorizontalOptions="EndAndExpand"
                    Source="close"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseClick}" />
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">


                <Grid RowDefinitions="*">

                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <IndicatorView
                                Margin="10"
                                IndicatorColor="LightGray"
                                IndicatorSize="16"
                                SelectedIndicatorColor="{StaticResource PrimaryColor}"
                                HorizontalOptions="End"
                                MaximumVisible="{Binding MaxIndex}"
                                Count="{Binding MaxIndex}"
                                VerticalOptions="CenterAndExpand"
                                Position="{Binding CurrentIndex}"
                                />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsReleaseDetailsVisible}"
                                    RowSpacing="24"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <StackLayout Grid.Row="0">
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.CRRequestDetails}" />
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" />
                                        <BoxView
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                    </StackLayout>

                                    <StackLayout Grid.Row="1">
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.CRContractonName}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <custom:CustomSfTextInputView>
                                            <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                x:Name="ContractNameText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                HorizontalOptions="FillAndExpand"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Unfocused="ContractNameFiledUnfocused" />
                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>
                                    </StackLayout>
                                    <StackLayout Grid.Row="2">

                                        <StackLayout>
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.CRContractNumber}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <custom:CustomSfTextInputView>
                                                 <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                x:Name="ContractNumberText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="{OnPlatform Android=Numeric,
                                                                      iOS=Default}"
                                                TextChanged="OnTextChanged"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Unfocused="ContractNumberUnfocused">

                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behavior:OnlyNumericValuesBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>
                                                 </custom:CustomSfTextInputView.TextInputView>
                                             </custom:CustomSfTextInputView>

                                        </StackLayout>


                                        
                                        
                                    </StackLayout>
                                    <StackLayout Grid.Row="3">
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.CRContractType}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Border
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Padding="10"
                                                Style="{StaticResource GreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding PickedContract}" />
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="Center">
                                                        <Image.Source>

                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                                Size="28"
                                                                Color="{StaticResource SecondaryNew}" />
                                                        </Image.Source>
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding ShowPicker}" />
                                                        </Image.GestureRecognizers>
                                                    </Image>

                                                </Grid>
                                            </Border>
                                    </StackLayout>
                                    <StackLayout Grid.Row="4">
                                        
                                        <SfChipGroup:SfChipGroup
                                                x:Name="ChipGroup_statusFilter"
                                                ChipBackground="Transparent"
                                                ChipStroke="{StaticResource NeutralLightGrey}"
                                                ChipStrokeThickness="1"
                                                ChipType="Choice"
                                                HorizontalOptions="Start"
                                                ItemsSource="{Binding ChipDataFilterlist}"
                                                SelectedChipBackground="{StaticResource PartialBg}"
                                                SelectionChanged="ChipGroup_statusFilter_SelectionChanged"
                                                VerticalOptions="Center">
                                                <SfChipGroup:SfChipGroup.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackLayout WidthRequest="80">
                                                            <Label
                                                                HorizontalOptions="FillAndExpand"
                                                                HorizontalTextAlignment="Center"
                                                                Style="{StaticResource CaptionLabelBlack}"
                                                                StyleId="OnBoardText"
                                                                Text="{Binding Text}" />
                                                        </StackLayout>
                                                    </DataTemplate>
                                                </SfChipGroup:SfChipGroup.ItemTemplate>
                                            </SfChipGroup:SfChipGroup>

                                        <Label HorizontalOptions="StartAndExpand" Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.CRContractStartDate}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        <Border
                                            Padding="10"
                                            Style="{StaticResource GreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{Binding FromDate}" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,0"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Center"
                                                    WidthRequest="24">
                                                    <Image.Source>

                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.Calendar}"
                                                            Size="28"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="NormalCalendar_Tapped" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                            </Grid>
                                        </Border>
                                        <custom:CustomDatePicker
                                            x:Name="NormalCalendar"
                                            Margin="2"
                                            Background="White"
                                            Closed="NormalCalendar_Closed"
                                            HorizontalOptions="FillAndExpand"
                                            ItemHeight="36"
                                            Mode="Dialog"
                                            SelectedItem="{Binding TodayDateStart}"
                                            Style="{StaticResource PickerStyle}">

                                            <custom:CustomDatePicker.ColumnHeaderView>
                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                            </custom:CustomDatePicker.ColumnHeaderView>


                                            <custom:CustomDatePicker.SelectionView>
                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                            </custom:CustomDatePicker.SelectionView>

                                            <custom:CustomDatePicker.HeaderView>

                                                <syncfusion:PickerHeaderView
                                                    Height="46"
                                                    Background="Aqua"
                                                    Text="{x:Static ResourceManager:AppResources.CRContractStartDate}" />

                                            </custom:CustomDatePicker.HeaderView>


                                            <custom:CustomDatePicker.SelectedTextStyle>
                                                <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                            </custom:CustomDatePicker.SelectedTextStyle>

                                            <custom:CustomDatePicker.FooterView>

                                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                    <syncfusion:PickerFooterView.TextStyle>
                                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                    </syncfusion:PickerFooterView.TextStyle>

                                                </syncfusion:PickerFooterView>

                                            </custom:CustomDatePicker.FooterView>

                                        </custom:CustomDatePicker>
                                        <!--  HijriDatePicker  -->
                                        <custom:CustomHijriDatePicker
                                            x:Name="HijriCalendar"
                                            Margin="2"
                                            Background="White"
                                            Closed="NormalCalendar_Closed"
                                            HorizontalOptions="FillAndExpand"
                                            ItemHeight="36"
                                            Mode="Dialog"
                                            SelectedItem="{Binding TodayDateinHijriStart}"
                                            Style="{StaticResource PickerStyle}">

                                            <custom:CustomHijriDatePicker.SelectionView>
                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                            </custom:CustomHijriDatePicker.SelectionView>

                                            <custom:CustomHijriDatePicker.ColumnHeaderView>
                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                            </custom:CustomHijriDatePicker.ColumnHeaderView>

                                            <custom:CustomHijriDatePicker.SelectedTextStyle>
                                                <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                            </custom:CustomHijriDatePicker.SelectedTextStyle>

                                            <custom:CustomHijriDatePicker.HeaderView>

                                                <syncfusion:PickerHeaderView
                                                    Height="46"
                                                    Background="Aqua"
                                                    Text="{x:Static ResourceManager:AppResources.CRContractStartDate}" />

                                            </custom:CustomHijriDatePicker.HeaderView>

                                            <custom:CustomHijriDatePicker.FooterView>

                                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                    <syncfusion:PickerFooterView.TextStyle>
                                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                    </syncfusion:PickerFooterView.TextStyle>

                                                </syncfusion:PickerFooterView>

                                            </custom:CustomHijriDatePicker.FooterView>


                                        </custom:CustomHijriDatePicker>
                                    </StackLayout>
                                    <StackLayout Grid.Row="5">
                                        
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.CRContractEndDate}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Border
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Padding="10"
                                            Style="{StaticResource GreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{Binding ToDate}" />

                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="5,0,5,0"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Center"
                                                    WidthRequest="24">
                                                    <Image.Source>

                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.Calendar}"
                                                            Size="28"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="EndNormalCalendar_Tapped" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                            </Grid>
                                        </Border>
                                        <custom:CustomDatePicker
                                            x:Name="EndDateNormalCalendar"
                                            Margin="2"
                                            Background="White"
                                            Closed="EndDateNormalCalendar_Closed"
                                            HorizontalOptions="FillAndExpand"
                                            ItemHeight="36"
                                            Mode="Dialog"
                                            SelectedItem="{Binding TodayDateEnd}"
                                            Style="{StaticResource PickerStyle}">

                                            <custom:CustomDatePicker.ColumnHeaderView>
                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                            </custom:CustomDatePicker.ColumnHeaderView>


                                            <custom:CustomDatePicker.SelectionView>
                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                            </custom:CustomDatePicker.SelectionView>

                                            <custom:CustomDatePicker.SelectedTextStyle>
                                                <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                            </custom:CustomDatePicker.SelectedTextStyle>


                                            <custom:CustomDatePicker.HeaderView>

                                                <syncfusion:PickerHeaderView
                                                    Height="46"
                                                    Background="Aqua"
                                                    Text="{x:Static ResourceManager:AppResources.CRContractStartDate}" />

                                            </custom:CustomDatePicker.HeaderView>

                                            <custom:CustomDatePicker.FooterView>

                                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                    <syncfusion:PickerFooterView.TextStyle>
                                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                    </syncfusion:PickerFooterView.TextStyle>

                                                </syncfusion:PickerFooterView>

                                            </custom:CustomDatePicker.FooterView>

                                        </custom:CustomDatePicker>

                                        <!--  HijriDatePicker  -->

                                        <custom:CustomHijriDatePicker
                                            x:Name="EndDateHijriCalendar"
                                            Margin="2"
                                            Background="White"
                                            Closed="EndDateNormalCalendar_Closed"
                                            HorizontalOptions="FillAndExpand"
                                            ItemHeight="36"
                                            Mode="Dialog"
                                            SelectedItem="{Binding TodayDateinHijriEnd}"
                                            Style="{StaticResource PickerStyle}">

                                            <custom:CustomHijriDatePicker.SelectionView>
                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                            </custom:CustomHijriDatePicker.SelectionView>

                                            <custom:CustomHijriDatePicker.ColumnHeaderView>
                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                            </custom:CustomHijriDatePicker.ColumnHeaderView>

                                            <custom:CustomHijriDatePicker.SelectedTextStyle>
                                                <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                            </custom:CustomHijriDatePicker.SelectedTextStyle>

                                            <custom:CustomHijriDatePicker.HeaderView>

                                                <syncfusion:PickerHeaderView
                                                    Height="46"
                                                    Background="Aqua"
                                                    Text="{x:Static ResourceManager:AppResources.CRContractStartDate}" />

                                            </custom:CustomHijriDatePicker.HeaderView>

                                            <custom:CustomHijriDatePicker.FooterView>

                                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                    <syncfusion:PickerFooterView.TextStyle>
                                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                    </syncfusion:PickerFooterView.TextStyle>

                                                </syncfusion:PickerFooterView>

                                            </custom:CustomHijriDatePicker.FooterView>

                                        </custom:CustomHijriDatePicker>
                                    </StackLayout>
                                    <StackLayout Grid.Row="6">
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.CRTotalAmountOfContract}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <custom:CustomSfTextInputView>
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                x:Name="ContractTotalAmountText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="{OnPlatform Android=Numeric,
                                                                      iOS=Default}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Unfocused="TotalAmountUnFocused">
                                                
                                            </custom:GAZTBorderlessEntry>
                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>
                                    </StackLayout>

                                    <StackLayout Grid.Row="7">
                                        
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.CRAmountRequiredToRelease}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
<!--                                                x:Name="AmountoReleaseTxt"
-->
                                        <custom:CustomSfTextInputView>
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                Text="{Binding ContractReleaseAmount}"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="{OnPlatform Android=Numeric,
                                                                        iOS=Default}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Unfocused="AmountToReleaseUnfocused">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <xct:EventToCommandBehavior Command="{Binding ReleaseAmtUnfocused}" EventName="Completed" />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>

                                            </custom:CustomSfTextInputView.TextInputView>
                                            </custom:CustomSfTextInputView>

                                    </StackLayout>

                                    <cards:SfCardView
                                        Grid.Row="8"
                                        Padding="10"
                                        BorderColor="{StaticResource NeutralLightGrey}"
                                        BorderWidth="1"
                                        CornerRadius="20">
                                        <StackLayout>
                                            
                                            <StackLayout Orientation="Horizontal">

                                                <Label
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlackMedium}"
                                                Text="{x:Static ResourceManager:AppResources.CRContractprofitEstimatedRate}" />

                                            <Image
                                                HorizontalOptions="End">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>

                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ContractProfitPercentCommand}" />
                                                </Image.GestureRecognizers>

                                            </Image>
                                            </StackLayout>

                                            <Label
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.CRPercentage}" />
                                            <Label
                                                Margin="10,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding PickedContractPercent, StringFormat='{0} %'}" />

                                        </StackLayout>

                                    </cards:SfCardView>

                                    <cards:SfCardView
                                        Grid.Row="9"
                                        Padding="10"
                                        BorderColor="{StaticResource NeutralLightGrey}"
                                        BorderWidth="1"
                                        CornerRadius="20">
                                        <StackLayout>
                                            
                                            <StackLayout Orientation="Horizontal">
                                                <Label
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlackMedium}"
                                                Text="{x:Static ResourceManager:AppResources.CRProfitEstimatedForContract}" />

                                            <Image
                                                HorizontalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ProfitEstimatedContractCommand}" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                            </StackLayout>

                                            <Label
                                               
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.CRAmount}" />
                                            <Label
                                                
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}">
                                                <Label.FormattedText>
                                                    <FormattedString>
