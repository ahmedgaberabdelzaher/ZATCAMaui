<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ContractReleasePages.ContractReleaseSuccessPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    ios:Page.UseSafeArea="True"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <!--<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>-->

    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">

                <Image
                    Aspect="AspectFit"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    Source="Forget_ic_success"
                    VerticalOptions="Center"
                    WidthRequest="120" />

                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PageTitleWhite}"
                    Text="{x:Static ResourceManager:AppResources.ContractRelease}" />
                <Label
                    Margin="0,16,0,0"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BodyLabelWhite}"
                    Text="{x:Static ResourceManager:AppResources.CRYourContractisreleasedsuccessfully}" />
            </StackLayout>
            <ScrollView>
                <Grid>
                    <Border
                        Padding="20"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 20,20,0,0"
                        VerticalOptions="EndAndExpand">
                        <StackLayout>

                            <Frame
                                Margin="10,5,10,5"
                                Padding="0"
                                BorderColor="LightGray"
                                CornerRadius="8"
                                HasShadow="False">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.CRReferenceNumber}"
                                        VerticalOptions="Center" />

                                    <Label
                                        x:Name="ReferenceNumberTxt"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="End"
                                        Style="{StaticResource ValueLabelBlack}"
                                        VerticalOptions="Center" />

                                    <Image Grid.Row="0" Grid.Column="2">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ReferenceNumberCopyTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Frame>
                            <Frame
                                Margin="10,5,10,5"
                                Padding="0"
                                BorderColor="LightGray"
                                CornerRadius="8"
                                HasShadow="False">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.CRContractingNumber}"
                                        VerticalOptions="Center" />

                                    <Label
                                        x:Name="ContractNumberTxt"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="15"
                                        HorizontalOptions="End"
                                        Style="{StaticResource ValueLabelBlack}"
                                        VerticalOptions="Center" />

                                    <Image Grid.Row="0" Grid.Column="2">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ContractNumberCopyTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </Frame>
                            <buttons:SfButton
                                Grid.ColumnSpan="2"
                                Margin="10,20,10,24"
                                Background="{StaticResource Secondary}"
                                Clicked="Download_AcknowledgementForm"
                                CornerRadius="10"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="15"
                                HeightRequest="48"
                                Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                                TextColor="White"
                                VerticalOptions="End"
                                WidthRequest="366" />


                            <Label
                                Margin="10,0,10,15"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource BodyLabelSecondary}"
                                Text="{x:Static ResourceManager:AppResources.ContractRelease}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Dashboard_Tapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </StackLayout>
                    </Border>
                    <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading1}">
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="Black"
                            Opacity="0.4"
                            Orientation="Vertical"
                            VerticalOptions="FillAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="15,15"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Opacity="0.8"
                            Orientation="Vertical"
                            VerticalOptions="Center">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <busyindicator:SfBusyIndicator
                                    x:Name="busyindicatorForLanding"
                                    HorizontalOptions="CenterAndExpand"
                                    IsRunning="True"
                                    AnimationType="Cupertino"
                                    SizeFactor="0.6"
                                    WidthRequest="70"
                                    HeightRequest="70"
                                    IndicatorColor="{StaticResource Secondary}"
                                    TitlePlacement="Bottom"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </Grid>
            </ScrollView>
        </StackLayout>

    </ContentPage.Content>
</ContentPage>