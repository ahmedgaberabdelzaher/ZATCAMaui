<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ContractReleasePages.ContractReleaseListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDContractReleaseRequest}"
                    VerticalOptions="Center" />

                <Image
                    Grid.Row="0"
                    Grid.Column="2"
                    HeightRequest="24"
                    HorizontalOptions="EndAndExpand"
                    Source="close"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseClick}" />
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <StackLayout>
                            <Grid
                                Margin="20,32,20,0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsContractListsVisible}"
                                VerticalOptions="FillAndExpand">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackLayout Orientation="Horizontal">

                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ContractRelease}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        HorizontalOptions="Center"
                                        Source="arrowDropdown"
                                        VerticalOptions="CenterAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="btn_Clicked" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>

                                <Grid
                                    Grid.Row="1"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Margin="0,10,0,20"
                                        Padding="12"
                                        HorizontalOptions="FillAndExpand"
                                        StrokeShape="RoundRectangle 15,15,15,15"
                                        Style="{StaticResource GreyBorderFrameWithShadow}"
                                        VerticalOptions="FillAndExpand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_add1.png"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="24" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                FontSize="15"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.CRRequestContractRelease}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding RequestContractReleaseBtnTapped}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Border>

                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,10,0,0"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="FillAndExpand">

                                        <listView:SfListView
                                            Grid.Row="0"
                                            Margin="0"
                                            Padding="0"
                                            AutoFitMode="Height"
                                            HorizontalOptions="CenterAndExpand"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="0"
                                            ItemTapped="ContractsList_ItemTapped"
                                            ItemsSource="{Binding ContractListViewData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="Single"
                                            VerticalOptions="Start">

                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Grid.Column="0"
                                                        Margin="0,15,0,0"
                                                        Padding="10"
                                                        StrokeShape="RoundRectangle 15,15,15,15"
                                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                                        <Grid
                                                            Margin="0"
                                                            Padding="0"
                                                            RowSpacing="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="50*" />
                                                                <ColumnDefinition Width="50*" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                                                                <Label
                                                                    Margin="0,0,0,10"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource SectionTitleBlack}"
                                                                    Text="{x:Static ResourceManager:AppResources.CRContractReleaseApplicationForm}" />


                                                            </StackLayout>

                                                            <StackLayout Grid.Row="1" Grid.ColumnSpan="2">

                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    HorizontalTextAlignment="Start"
                                                                    Style="{StaticResource ValueLabelGrey}"
                                                                    Text="{Binding Fbnum}"
                                                                    VerticalOptions="CenterAndExpand" />

                                                            </StackLayout>
                                                            <StackLayout
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Grid.ColumnSpan="2"
                                                                HorizontalOptions="FillAndExpand"
                                                                Orientation="Horizontal"
                                                                VerticalOptions="FillAndExpand">


                                                                <Border
                                                                    Padding="8,3,8,3"
                                                                    BackgroundColor="{StaticResource BackgroundGray}"
                                                                    HorizontalOptions="EndAndExpand"
                                                                    StrokeShape="RoundRectangle 14,14,14,14"
                                                                    StrokeThickness="1"
                                                                    VerticalOptions="CenterAndExpand">

                                                                    <Label
                                                                        HorizontalOptions="CenterAndExpand"
                                                                        HorizontalTextAlignment="Center"
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{Binding StatText}"
                                                                        TextColor="{StaticResource Partial}"
                                                                        VerticalOptions="CenterAndExpand">
                                                                        <Label.Triggers>

                                                                            <DataTrigger
                                                                                Binding="{Binding StatText}"
                                                                                TargetType="Label"
                                                                                Value="{x:Static ResourceManager:AppResources.NDBilled}">
                                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.NDBilled}" />
                                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                                                <Setter Property="HorizontalTextAlignment" Value="Center" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                </Border>
                                                            </StackLayout>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>

                                    </Grid>
                                </Grid>

                            </Grid>

                            <Grid
                                Margin="20,10,20,0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding SummaryVisible}"
                                VerticalOptions="FillAndExpand">

                                <StackLayout>

                                    <Grid Margin="0,5,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}"
                                            Text="{x:Static ResourceManager:AppResources.CRSummary}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,-10,0,15"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}" />
                                        <BoxView
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    </Grid>

                                    <Border Margin="0,16,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">

                                        <StackLayout>

                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="establishments"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />
                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.CRReleaseDetails}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <Grid Padding="15,15,15,0" RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />

                                                </Grid.ColumnDefinitions>

                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRContractonName}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ContractName}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="1" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRContractNumber}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="1" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ContractNumber}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="2" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRContractType}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="2" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding PickedContract}" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="3"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal">
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRContractPeriod}" />

                                                    <Label
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <FormattedString.Spans>
                                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding FromDate, StringFormat='{0:MMM yyyy}'}" />
                                                                    <Span Text=" - " />
                                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding ToDate, StringFormat='{0:MMM yyyy}'}" />
                                                                </FormattedString.Spans>
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <StackLayout Grid.Row="4" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRTotalAmountOfContract}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="4" Grid.Column="1">

                                                    <Label HorizontalOptions="EndAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding ContractTotalAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <StackLayout Grid.Row="5" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRAmountRequiredToRelease}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="5" Grid.Column="1">
                                                    <Label HorizontalOptions="EndAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding AmountToRelease, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                            </Grid>
                                        </StackLayout>

                                    </Border>

                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        HorizontalOptions="FillAndExpand"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}"
                                        VerticalOptions="FillAndExpand">
                                        <Grid
                                            Padding="10,3,10,2"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.CRTheValueofZakatdues}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding ZakatDues, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        HorizontalOptions="FillAndExpand"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}"
                                        VerticalOptions="FillAndExpand">
                                        <Grid
                                            Padding="10,3,10,2"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.CRTheValueTaxDues}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TaxDues, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        HorizontalOptions="FillAndExpand"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}"
                                        VerticalOptions="FillAndExpand">
                                        <Grid
                                            Padding="10,3,10,2"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.CRTotalDues}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalDues, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Margin="0,16,0,10"
                                        Padding="0,0,0,16"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">

                                        <StackLayout>

                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>


                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="ic_attachment"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />
                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.CRAttachments}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <StackLayout Padding="15,15,15,0">

                                                <listView:SfListView
                                                    Grid.Row="0"
                                                    AutoFitMode="Height"
                                                    HorizontalOptions="Center"
                                                    IsScrollingEnabled="False"
                                                    ItemTapped="SummaryAttachments_ItemTapped"
                                                    ItemsSource="{Binding ContractCopyAttachmentsListViewData}"
                                                    ScrollBarVisibility="Never"
                                                    SelectionBackground="Transparent"
                                                    SelectionMode="None"
                                                    VerticalOptions="Center">
                                                    <listView:SfListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.CRAttachContract}" />
                                                                </StackLayout>
                                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        Text="{Binding Filename}" />
                                                                </StackLayout>
                                                            </Grid>

                                                        </DataTemplate>
                                                    </listView:SfListView.ItemTemplate>
                                                </listView:SfListView>

                                                <listView:SfListView
                                                    Grid.Row="1"
                                                    AutoFitMode="Height"
                                                    HorizontalOptions="Center"
                                                    IsScrollingEnabled="False"
                                                    ItemTapped="SummaryAttachments_ItemTapped"
                                                    ItemsSource="{Binding InvoiceAttachmentsListViewData}"
                                                    ScrollBarVisibility="Never"
                                                    SelectionBackground="Transparent"
                                                    SelectionMode="None"
                                                    VerticalOptions="Center">
                                                    <listView:SfListView.ItemTemplate>
                                                        <DataTemplate>

                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.CRAttachInvoiceCopy}" />
                                                                </StackLayout>
                                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        Text="{Binding Filename}" />
                                                                </StackLayout>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </listView:SfListView.ItemTemplate>
                                                </listView:SfListView>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRRemarks}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding Remarks}" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRDetailDescription}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding DetailDescription}" />
                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>
                                    </Border>

                                    <buttons:SfButton
                                        Grid.ColumnSpan="2"
                                        Margin="10,10,10,0"
                                        Clicked="Download_AcknowledgementForm"
                                        FontFamily="{StaticResource SomarBold}"
                                        FontSize="15"
                                        HeightRequest="46"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                                        VerticalOptions="End" />

                                    <buttons:SfButton
                                        x:Name="btnDashboard"
                                        Grid.ColumnSpan="2"
                                        Margin="10,10,10,10"
                                        Clicked="Download_Acknowledgement"
                                        FontFamily="{StaticResource SomarBold}"
                                        FontSize="15"
                                        HeightRequest="46"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.CRDownloadConfirmation}"
                                        VerticalOptions="End" />
                                </StackLayout>
                            </Grid>

                        </StackLayout>

                    </ScrollView>

                </Grid>

            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>


    </ContentPage.Content>
</ContentPage>
