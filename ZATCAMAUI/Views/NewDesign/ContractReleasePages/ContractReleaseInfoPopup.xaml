<?xml version="1.0" encoding="utf-8" ?>

<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.ContractReleasePages.ContractReleaseInfoPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}">

    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->

    <Border
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        HorizontalOptions="FillAndExpand"
        IsVisible="true"
        VerticalOptions="End">
        <Grid
            Margin="24,8,24,0"
            BackgroundColor="Transparent"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="End">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <BoxView
                Grid.Row="0"
                HorizontalOptions="Center"
                Style="{StaticResource NeutralGrayBoxViewDrag}"
                VerticalOptions="Start" />

            <Label
                Grid.Row="1"
                Margin="0,0,0,16"
                HorizontalOptions="StartAndExpand"
                Style="{StaticResource SectionTitleBlackBold}"
                Text="{Binding InfoTitle}" />

            <Border
                Grid.Row="2"
                Margin="0,0,0,10"
                Stroke="#B1B1B1"
                StrokeThickness="1"
                Style="{StaticResource GreyBorderFrame}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        HeightRequest="24"
                        HorizontalOptions="Start"
                        Source="ic_vat_info.png"
                        VerticalOptions="Center"
                        WidthRequest="24" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource ValueLabelBlack}"
                        Text="{Binding InfoTitle, StringFormat='{0}'}" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding InfoDesc}" />

                </Grid>
            </Border>

            <buttons:SfButton
                Grid.Row="3"
                Margin="0,24,0,24"
                Command="{Binding ContractInstructionsClicked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.CRDone}" />
        </Grid>
    </Border>

</pages:PopupPage>