<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.MyReturnsPages.GAZTNewDesignMyReturnsNewPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>

                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>

                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>

                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <!--  Back Button  -->
                <StackLayout>

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClicked}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDReturns}"
                    VerticalOptions="Center" />



            </Grid>
            <!--#endregion Header-->

           <Border
                Grid.Row="1"
                Padding="0,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="auto,*">

                    <Grid RowDefinitions="*,*">

                        <Grid RowDefinitions="auto"
                              Padding="10,0"
                              ColumnDefinitions="auto,30">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="28"
                                HorizontalOptions="StartAndExpand"
                                HorizontalTextAlignment="Start"
                                Text="{Binding FilterLabelText}"
                                TextColor="{StaticResource NeutralBlack}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_Clicked" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="Center"
                                Source="arrowDropdown"
                                VerticalOptions="Center">
                                <Image.Margin>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="iOS" Value="5,8,5,0" />
                                        <On Platform="Android" Value="5,10,5,0" />
                                    </OnPlatform>
                                </Image.Margin>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_Clicked" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>

                        <Grid Grid.Row="1"
                              RowDefinitions="*">

                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">

                            <busyindicator:SfChipGroup
                                x:Name="ChipGroup_statusFilter"
                                ChipType="Choice"
                                ItemsSource="{Binding ChipDataFilterlist}"
                                SelectionChanged="ChipGroup_statusFilter_SelectionChanged"
                                Style="{StaticResource ReturnsChipGroup}">
                                <busyindicator:SfChipGroup.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout Style="{StaticResource ChipParentLayout}">
                                            <Image Source="{Binding ImageSource}" Style="{StaticResource ChipIcon}" />
                                            <Label
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding Text}"
                                                TextColor="{Binding TextColor}">
                                                <Label.Margin>
                                                    <OnPlatform x:TypeArguments="Thickness">
                                                        <On Platform="iOS" Value="0,0,0,0" />
                                                        <On Platform="Android" Value="0,0,0,0" />
                                                    </OnPlatform>
                                                </Label.Margin>
                                            </Label>
                                        </StackLayout>
                                    </DataTemplate>
                                </busyindicator:SfChipGroup.ItemTemplate>
                            </busyindicator:SfChipGroup>

                        </ScrollView>
                        </Grid>
                    </Grid>

                    <StackLayout
                        Grid.Row="1"
                        Padding="10,0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <ListView
                            x:Name="ListView_Returns"
                            BackgroundColor="White"
                            HasUnevenRows="True"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsListVisible}"
                            ItemsSource="{Binding ListToDisplay, Mode=TwoWay}"
                            SeparatorVisibility="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Border Margin="0,10"
                                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Padding="0,10">
                                                <Grid Padding="10"
                                                      RowDefinitions="auto,auto"
                                                      ColumnDefinitions="65*,35*"
                                                      RowSpacing="0">

                                                    <StackLayout>
                                                        <Label
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text=""
                                                            VerticalOptions="CenterAndExpand">
                                                            <Label.Triggers>
                                                                <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="ITAX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="ZAKT">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="VATX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="VTEP">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="ETAX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ETReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="WHTX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.WHTreturns1}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label
                                                            Margin="0,10,0,0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{Binding TaxtpText}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>
                                                    <!--  StatusTxt  -->

                                                    <buttons:SfButton
                                                        Grid.Column="1"
                                                        BackgroundColor="{StaticResource BackgroundGray}"
                                                        CornerRadius="20"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        FontSize="Small"
                                                        HeightRequest="40"
                                                        HorizontalOptions="End"
                                                        IsEnabled="False"
                                                        Text="{Binding RetStatTxt}"
                                                        TextColor="{StaticResource Success}"
                                                        VerticalOptions="CenterAndExpand">
                                                        <buttons:SfButton.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding StatusTxt}"
                                                                TargetType="buttons:SfButton"
                                                                Value="Submitted">
                                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundGray}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding StatusTxt}"
                                                                TargetType="buttons:SfButton"
                                                                Value="Non Submitted">
                                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorBg}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding StatusTxt}"
                                                                TargetType="buttons:SfButton"
                                                                Value="Overdue">
                                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="BackgroundColor" Value="{StaticResource ChipPaidColor}" />
                                                            </DataTrigger>


                                                        </buttons:SfButton.Triggers>
                                                    </buttons:SfButton>
                                                </Grid>

                                                <BoxView
                                                    BackgroundColor="LightGray"
                                                    HeightRequest="1"
                                                    HorizontalOptions="FillAndExpand" />

                                                <Grid
                                                    Padding="10"
                                                    ColumnSpacing="15"
                                                    RowDefinitions="auto,auto,auto,auto"
                                                    ColumnDefinitions="auto,*"
                                                    RowSpacing="15">

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="-5">

                                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZReturnPeriod}" />

                                                        <StackLayout Orientation="Horizontal">

                                                            <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding FormatedAbrzu}" />

                                                            <Label Style="{StaticResource ValueLabelBlack}" Text="-" />

                                                            <Label
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding FormatedAbrzo}" />

                                                        </StackLayout>

                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="-5">

                                                        <Label Style="{StaticResource CaptionLabelGrey}"
                                                               Text="{x:Static ResourceManager:AppResources.NDReturnType}" />

                                                        <Label Style="{StaticResource ValueLabelBlack}"
                                                               Text="{Binding FbtText}" />

                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Spacing="-5">

                                                        <Label Style="{StaticResource CaptionLabelGrey}"
                                                               Text="{x:Static ResourceManager:AppResources.NDDescription}" />

                                                        <Label Style="{StaticResource ValueLabelBlack}"
                                                               Text="{Binding TaxPeriod}" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Spacing="-5">

                                                        <Label
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.NDPeriod}" />

                                                        <StackLayout HorizontalOptions="StartAndExpand">

                                                            <Label
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Persl}" />

                                                        </StackLayout>

                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.Column="0"
                                                        Spacing="-5">

                                                        <Label Style="{StaticResource CaptionLabelGrey}"
                                                               Text="{x:Static ResourceManager:AppResources.NDReturnNumber}" />

                                                        <Label Style="{StaticResource ValueLabelBlack}"
                                                               Text="{Binding Fbnum}" />

                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Spacing="-5">

                                                        <Label
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.DueDate}" />

                                                        <StackLayout HorizontalOptions="Start">

                                                            <Label
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding FormatedSingleDueDate}" />

                                                        </StackLayout>

                                                    </StackLayout>
                                                </Grid>

                                            </StackLayout>
                                        </Border>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Label
                            Margin="0,20,0,0"
                            HorizontalOptions="Center"
                            IsVisible="{Binding SetNoDataLabelVisibilityALL}"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}"
                            VerticalOptions="Center" />

                    </StackLayout>

                </Grid>

            </Border>

            <!--#endregion Loader-->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>




    </ContentPage.Content>
</ContentPage>