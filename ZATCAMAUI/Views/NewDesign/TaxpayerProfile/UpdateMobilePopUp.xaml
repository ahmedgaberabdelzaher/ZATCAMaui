<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.UpdateMobilePopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    BackgroundColor="#88000000"
    mc:Ignorable="d">
    <Border
        Padding="0"
        Style="{StaticResource CommonTopCurves}"
         Stroke="{StaticResource NeutralLightGrey}"
        VerticalOptions="EndAndExpand">
        <ScrollView>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <StackLayout Grid.Row="0">

                    <StackLayout
                        x:Name="UpdateMobile"
                        Grid.Row="0"
                        IsVisible="True">
                        <Image
                            Margin="24,16,24,8"
                            HeightRequest="25"
                            HorizontalOptions="End"
                            Source="close"
                            WidthRequest="25">

                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                            </Image.GestureRecognizers>

                        </Image>

                        <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" Style="{StaticResource SeparatorStyle}" />

                        <StackLayout Padding="24,16,24,0">

                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource SectionTitleBlackBold}"
                                Text="{x:Static ResourceManager:AppResources.TPUpdateMobile}" />

                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZCurrentMobileNumber}" />

                            <custom:CustomSfTextInputView OutlineCornerRadius="8">
                                <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                        x:Name="Mobile_Entry"
                                        FlowDirection="LeftToRight"
                                        HorizontalOptions="FillAndExpand"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Placeholder="{x:Static ResourceManager:AppResources.ZCurrentMobileNumber}"
                                        Keyboard="Telephone"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding CurrentMobileNumberEntryText}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalTextAlignment="Center" />

                                </custom:CustomSfTextInputView.TextInputView>
                            </custom:CustomSfTextInputView>

                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.NewMobileNumber}" />

                            <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            x:Name="Mobile_entry"
                                            HorizontalOptions="FillAndExpand"
                                            IsSpellCheckEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.NewMobileNumber}"
                                            Keyboard="Telephone"
                                            MaxLength="{Binding MaxDigids}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding NewMobileNumberEntryText}"
                                            TextColor="{StaticResource PrimaryColor}">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>
                                    </custom:CustomSfTextInputView.TextInputView>

                                    <inputLayout:SfTextInputLayout.LeadingView>
                                        <StackLayout
                                            Padding="2"
                                            Orientation="Horizontal"
                                            Spacing="0"
                                            WidthRequest="45">

                                            <Label
                                                FontSize="14"
                                                x:Name="Label_InternationalnoCode"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{Binding CountryCode}"
                                                TextColor="#002447"
                                                VerticalOptions="CenterAndExpand" />

                                            <BoxView
                                                BackgroundColor="#EBEBEB"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Fill"
                                                WidthRequest="2" />

                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"  />
                                            </StackLayout.GestureRecognizers>

                                        </StackLayout>
                                    </inputLayout:SfTextInputLayout.LeadingView>
                                </custom:CustomSfTextInputView>

                           
                        </StackLayout>
                    </StackLayout>

                    <!--  OTP View  -->
                    <StackLayout
                        x:Name="VerificationView"
                        Grid.Row="0"
                        Padding="24"
                        IsVisible="False">
                        <Label Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.VerificationCode}" />
                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}" />
                        <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />

                        <StackLayout Padding="0,15,0,0">

                            <StackLayout
                                FlowDirection="LeftToRight"
                                HorizontalOptions="CenterAndExpand"
                                IsVisible="{Binding engText}"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalOptions="CenterAndExpand">
                                <Label
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                <Label
                                    x:Name="OTPSentOnThisMobileNumberLbl"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{Binding OTPSentOnThisMobileNumber}" />
                            </StackLayout>

                            <StackLayout
                                FlowDirection="LeftToRight"
                                HorizontalOptions="CenterAndExpand"
                                IsVisible="{Binding Arabictext}"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalOptions="CenterAndExpand">
                                <Label
                                    x:Name="OTPSentOnThisMobileNumberLbl2"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{Binding OTPSentOnThisMobileNumber2}" />
                                <Label
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                            </StackLayout>

                            <Grid Margin="0,-10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Padding="30,20,30,20"
                                    ColumnSpacing="20"
                                    FlowDirection="LeftToRight">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  First OTP Digit Start  -->
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="50"
                                        Stroke="Gray"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Start"
                                        WidthRequest="50">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="OTPFirstEntry"
                                            FontAttributes="Bold"
                                            FontSize="Small"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                            Keyboard="{OnPlatform Android=Numeric,
                                                                  iOS=Default}"
                                            MaxLength="1"
                                            ReturnType="Next"
                                            Text="{Binding OTPFirstDigit}"
                                            TextChanged="OtpFirstEntry_TextChanged"
                                            TextColor="#bbbbbb"
                                            WidthRequest="100">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>

                                    </Border>
                                    <!--  First OTP Digit End  -->

                                    <!--  Second OTP Digit Start  -->
                                    <Border
                                        Grid.Column="1"
                                        HeightRequest="50"
                                        Stroke="Gray"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Start"
                                        WidthRequest="50">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="OTPSecondEntry"
                                            FontAttributes="Bold"
                                            FontSize="Small"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                            Keyboard="{OnPlatform Android=Numeric,
                                                                  iOS=Default}"
                                            MaxLength="1"
                                            ReturnType="Next"
                                            Text="{Binding OTPSecondDigit}"
                                            TextChanged="OtpSecondEntry_TextChanged"
                                            TextColor="#bbbbbb"
                                            WidthRequest="100">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>

                                    </Border>
                                    <!--  Second OTP Digit End  -->

                                    <!--  Third OTP Digit Start  -->
                                    <Border
                                        Grid.Column="2"
                                        HeightRequest="50"
                                        Stroke="Gray"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Start"
                                        WidthRequest="50">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="OTPThirdEntry"
                                            FontAttributes="Bold"
                                            FontSize="Small"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                            Keyboard="{OnPlatform Android=Numeric,
                                                                  iOS=Default}"
                                            MaxLength="1"
                                            ReturnType="Next"
                                            Text="{Binding OTPThirdDigit}"
                                            TextChanged="OtpThirdEntry_TextChanged"
                                            TextColor="#bbbbbb"
                                            WidthRequest="100">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>

                                    </Border>
                                    <!--  Third OTP Digit End  -->

                                    <!--  Fourth OTP Digit Start  -->
                                    <Border
                                        Grid.Column="3"
                                        HeightRequest="50"
                                        Stroke="Gray"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Start"
                                        WidthRequest="50">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="OTPFourthEntry"
                                            FontAttributes="Bold"
                                            FontSize="Small"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                            Keyboard="{OnPlatform Android=Numeric,
                                                                  iOS=Default}"
                                            MaxLength="1"
                                            ReturnType="Next"
                                            Text="{Binding OTPFourthDigit}"
                                            TextChanged="OtpFourthEntry_TextChanged"
                                            TextColor="#bbbbbb"
                                            WidthRequest="100">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>

                                        </custom:GAZTBorderlessEntry>

                                    </Border>
                                    <!--  Fourth OTP Digit End  -->

                                </Grid>
                            </Grid>

                            <StackLayout
                                Margin="0,10,0,0"
                                HorizontalOptions="CenterAndExpand"
                                Orientation="Horizontal">
                                <Image Source="clock" />
                                <Label
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{Binding LblCountDownTimer}"
                                    VerticalOptions="Center" />
                            </StackLayout>
                            <buttons:SfButton
                                Margin="0,10,0,0"
                                Background="Transparent"
                                Clicked="OnResendOTPBtnClicked"
                                FontFamily="{StaticResource SomarRegular}"
                                Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                TextColor="{Binding ResendOTPTextColor}"
                                VerticalOptions="EndAndExpand" />
                        </StackLayout>
                    </StackLayout>

                    <StackLayout Grid.Row="1">
                        <buttons:SfButton
                            x:Name="btn"
                            Margin="24,0,24,24"
                            Clicked="UpdatedClicked"
                            IsEnabled="{Binding BtnEnableFlag}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.TPUpdate}" />
                    </StackLayout>

                </StackLayout>

                <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            </Grid>
        </ScrollView>
    </Border>
</Mopups:PopupPage>