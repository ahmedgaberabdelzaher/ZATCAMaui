<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.TaxpayerProfilePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundImageSource="partials_background.png"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    NavigationPage.HasNavigationBar="False"
    FlowDirection="{Binding AppDirection}"
    
    mc:Ignorable="d">
    
    <ContentPage.Content>
        <Grid RowDefinitions="auto,*" RowSpacing="0">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDProfile}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">


                <StackLayout>

                    <Label
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource LoginMenuTitleWhite}"
                        Text="{Binding TPProfileNameLbl}"
                        TextColor="{StaticResource BlackLabelTextColor}" />

                    <Label
                        Margin="0,0,0,0"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource BodyLabelGrey}"
                        Text="{Binding ResidenceText}" />

                    <ScrollView
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">

                        <StackLayout>

                            <Border
                                Padding="10"
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 16,16,16,16">

                                <StackLayout Orientation="Horizontal">

                                    <StackLayout>

                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZTERReportDetailTIN}" />

                                        <Label
                                            Margin="0,0,0,0"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{Binding TINLabel}" />

                                    </StackLayout>

                                    <Border
                                        Padding="10,0"
                                        BackgroundColor="{StaticResource OpacityPrimary}"
                                        HeightRequest="{OnPlatform Android=50,
                                                                   iOS=32}"
                                        HorizontalOptions="EndAndExpand"
                                        StrokeShape="RoundRectangle 14,14,14,14"
                                        StrokeThickness="1"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="59">

                                        <Label
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding TinStatusLabelText}"
                                            TextColor="{StaticResource Primary}"
                                            VerticalTextAlignment="Center" />

                                    </Border>

                                </StackLayout>

                            </Border>

                            <Label
                                Margin="0,16"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource TPProfileLabelBlackBold}"
                                Text="{x:Static ResourceManager:AppResources.ZZZContactInformation}" />

                            <StackLayout Spacing="10">

                                <StackLayout Orientation="Horizontal">

                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.MobileNumber}" />

                                    <Image HorizontalOptions="EndAndExpand" Source="ic_Edit.png">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMobileEditTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>

                                <inputLayout:SfTextInputLayout
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,0,16,0"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="10"
                                    Stroke="{StaticResource Primary}">

                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="MobileNumberCodeEntry"
                                        FlowDirection="LeftToRight"
                                        HorizontalOptions="FillAndExpand"
                                        IsReadOnly="True"
                                        InputTransparent="True"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding MobileNumber}"
                                        TextColor="{StaticResource PrimaryColor}"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout>

                            </StackLayout>

                            <StackLayout Spacing="10">

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDEmail}" />

                                    <Image HorizontalOptions="EndAndExpand" Source="ic_Edit.png">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEmailEditTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>

                                <inputLayout:SfTextInputLayout
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,0,16,0"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="10"
                                    Stroke="{StaticResource Primary}">

                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                    <custom:GAZTBorderlessEntry
                                        IsReadOnly="True"
                                        InputTransparent="True"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding EmailEntry}" />

                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <StackLayout Spacing="10">

                                <StackLayout Orientation="Horizontal">

                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Password}" />

                                    <Image HorizontalOptions="EndAndExpand" Source="ic_Edit.png">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPasswordEditTapped" />
                                        </Image.GestureRecognizers>

                                    </Image>

                                </StackLayout>

                                <inputLayout:SfTextInputLayout
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,0,16,0"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="10"
                                    Stroke="{StaticResource Primary}">

                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="Password"
                                        IsPassword="True"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding PasswordEntry}" />

                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <Border
                                Padding="16"
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 16,16,16,16">
                                <StackLayout Orientation="Horizontal">
                                    <StackLayout>

                                        <Label
                                            Margin="0,0,0,0"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ManagerDetails}" />
                                    </StackLayout>

                                    <Image HorizontalOptions="EndAndExpand" Source="ic_Edit.png">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnManagerDetailsTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Border>

                        </StackLayout>

                    </ScrollView>

                </StackLayout>




            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>