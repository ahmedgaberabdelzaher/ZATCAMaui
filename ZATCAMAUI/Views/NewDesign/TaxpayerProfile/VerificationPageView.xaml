<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.VerificationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Content>
        <Grid RowDefinitions="*">

            <StackLayout Grid.Row="0" Padding="0,56,0,0">
                <Border
                    BackgroundColor="White"
                    Stroke="DarkGray"
                    StrokeShape="RoundRectangle 10,10,10,10"
                    StrokeThickness="1"
                    Style="{StaticResource CommonTopCurves}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                            <StackLayout>
                                <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.VerificationCode}" />
                                <Label
                                    Padding="0,0,0,16"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.TPOTPSentToEmail}" />
                                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />

                                <StackLayout Padding="0,15,0,0">
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{Binding OTPSentOnThisMobileNumber}" />

                                    <Grid Margin="0,-10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Row="0"
                                            Padding="30,20,30,20"
                                            ColumnSpacing="20"
                                            FlowDirection="LeftToRight">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>


                                            <!--  First OTP Digit Start  -->
                                            <Border
                                                Grid.Column="0"
                                                HeightRequest="50"
                                                Stroke="Gray"
                                                StrokeShape="RoundRectangle 10"
                                                VerticalOptions="Start"
                                                WidthRequest="50">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPFirstEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="{OnPlatform Android=Numeric,
                                                                          iOS=Default}"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPFirstDigit}"
                                                    TextChanged="OtpFirstEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    WidthRequest="100">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                        <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>

                                            </Border>
                                            <!--  First OTP Digit End  -->

                                            <!--  Second OTP Digit Start  -->
                                            <Border
                                                Grid.Column="1"
                                                HeightRequest="50"
                                                Stroke="Gray"
                                                StrokeShape="RoundRectangle 10"
                                                VerticalOptions="Start"
                                                WidthRequest="50">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPSecondEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="{OnPlatform Android=Numeric,
                                                                          iOS=Default}"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPSecondDigit}"
                                                    TextChanged="OtpSecondEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    WidthRequest="100">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                        <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>

                                            </Border>
                                            <!--  Second OTP Digit End  -->

                                            <!--  Third OTP Digit Start  -->
                                            <Border
                                                Grid.Column="2"
                                                HeightRequest="50"
                                                Stroke="Gray"
                                                StrokeShape="RoundRectangle 10"
                                                VerticalOptions="Start"
                                                WidthRequest="50">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPThirdEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="{OnPlatform Android=Numeric,
                                                                          iOS=Default}"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPThirdDigit}"
                                                    TextChanged="OtpThirdEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    WidthRequest="100">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                        <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>

                                            </Border>
                                            <!--  Third OTP Digit End  -->

                                            <!--  Fourth OTP Digit Start  -->
                                            <Border
                                                Grid.Column="3"
                                                HeightRequest="50"
                                                Stroke="Gray"
                                                StrokeShape="RoundRectangle 10"
                                                VerticalOptions="Start"
                                                WidthRequest="50">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPFourthEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="{OnPlatform Android=Numeric,
                                                                          iOS=Default}"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPFourthDigit}"
                                                    TextChanged="OtpFourthEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    Unfocused="OtpFourthEntry_Unfocused"
                                                    WidthRequest="100">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                    </custom:GAZTBorderlessEntry.Behaviors>

                                                </custom:GAZTBorderlessEntry>

                                            </Border>
                                            <!--  Fourth OTP Digit End  -->

                                        </Grid>

                                    </Grid>


                                    <StackLayout
                                        Margin="0,-15,0,0"
                                        HorizontalOptions="Center"
                                        Orientation="Horizontal">
                                        <Image Source="clock" />
                                        <Label
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding LblCountDownTimer}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <buttons:SfButton
                                        Margin="0,16,0,0"
                                        Background="Transparent"
                                        Clicked="OnResendOTPBtnClicked"
                                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                        TextColor="{Binding ResendOTPTextColor}"
                                        VerticalOptions="EndAndExpand" />
                                </StackLayout>

                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.CurrentPassword}" />
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,8,16,8"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="CurrentPassword"
                                        IsPassword="True"
                                        MaxLength="16"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding CurrentPasswordEntry}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:PasswordTextBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image x:Name="CurrentPasswordImg" Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnCurrentPasswordTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>


                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NewPassword}" />
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,8,16,8"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="NewPassword"
                                        IsPassword="True"
                                        MaxLength="16"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding NewPasswordEntry}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:PasswordTextBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image x:Name="NewPasswordImg" Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNewPasswordTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" />
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,8,16,8"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="ConfirmPassword"
                                        IsPassword="True"
                                        MaxLength="16"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding ConfirmPasswordEntry}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:PasswordTextBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image x:Name="ConfirmPasswordImg" Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnConfirmPasswordTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                            </StackLayout>
                        </ScrollView>

                        <Grid
                            Grid.Row="0"
                            Padding="0,0,0,8"
                            BackgroundColor="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White">
                                <Image
                                    HorizontalOptions="Start"
                                    Source="arrowLeft.png"
                                    >
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackArrowTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="White">
                                <Image HeightRequest="30" Source="ic_logo_gazt.png" />
                            </StackLayout>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="2"
                                BackgroundColor="White">
                                <Image HorizontalOptions="End" Source="close.png">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackArrowTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                        </Grid>

                        <buttons:SfButton
                            x:Name="btn"
                            Grid.Row="2"
                            Clicked="VerifyBtnClicked"
                            IsEnabled="{Binding BtnEnableFlag}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.Verify}" />
                    </Grid>
                </Border>
            </StackLayout>

            <custom:Loader Grid.RowSpan="1" IsVisible="{Binding IsLoading}" />



        </Grid>
    </ContentPage.Content>
</ContentPage>