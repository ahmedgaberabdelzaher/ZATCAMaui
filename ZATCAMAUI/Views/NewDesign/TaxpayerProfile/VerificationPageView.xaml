<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.VerificationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0" Padding="0,56,0,0">
                <yummy:PancakeView
                    BackgroundColor="White"
                    CornerRadius="10"
                    Style="{StaticResource CommonTopCurves}">

                    <yummy:PancakeView.Border>
                        <yummy:Border Thickness="1" Color="DarkGray" />
                    </yummy:PancakeView.Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                            <StackLayout>
                                <custom:CustomLabel Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.VerificationCode}" />
                                <custom:CustomLabel
                                    Padding="0,0,0,16"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.TPOTPSentToEmail}" />
                                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />

                                <StackLayout Padding="0,15,0,0">
                                    <custom:CustomLabel
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{Binding OTPSentOnThisMobileNumber}" />

                                    <Grid Margin="0,-10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Row="0"
                                            Padding="30,20,30,20"
                                            ColumnSpacing="20"
                                            FlowDirection="LeftToRight">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>


                                            <!--  First OTP Digit Start  -->
                                            <inputLayout:SfTextInputLayout
                                                Grid.Column="0"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPFirstEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="Numeric"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPFirstDigit}"
                                                    TextChanged="OtpFirstEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    WidthRequest="8">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--  First OTP Digit End  -->

                                            <!--  Second OTP Digit Start  -->
                                            <inputLayout:SfTextInputLayout
                                                Grid.Column="1"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPSecondEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="Numeric"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPSecondDigit}"
                                                    TextChanged="OtpSecondEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    WidthRequest="8">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--  Second OTP Digit End  -->

                                            <!--  Third OTP Digit Start  -->
                                            <inputLayout:SfTextInputLayout
                                                Grid.Column="2"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPThirdEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="Numeric"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPThirdDigit}"
                                                    TextChanged="OtpThirdEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    WidthRequest="8">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--  Third OTP Digit End  -->

                                            <!--  Fourth OTP Digit Start  -->
                                            <inputLayout:SfTextInputLayout
                                                Grid.Column="3"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="OTPFourthEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Keyboard="Numeric"
                                                    MaxLength="1"
                                                    ReturnType="Next"
                                                    Text="{Binding OTPFourthDigit}"
                                                    TextChanged="OtpFourthEntry_TextChanged"
                                                    TextColor="#bbbbbb"
                                                    Unfocused="OtpFourthEntry_Unfocused"
                                                    WidthRequest="8" />
                                            </inputLayout:SfTextInputLayout>
                                            <!--  Fourth OTP Digit End  -->

                                        </Grid>

                                    </Grid>


                                    <StackLayout
                                        Margin="0,-15,0,0"
                                        HorizontalOptions="Center"
                                        Orientation="Horizontal">
                                        <Image Source="clock" />
                                        <custom:CustomLabel
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding LblCountDownTimer}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <buttons:SfButton
                                        Margin="0,16,0,0"
                                        Background="Transparent"
                                        Clicked="OnResendOTPBtnClicked"
                                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                        TextColor="{Binding ResendOTPTextColor}"
                                        VerticalOptions="EndAndExpand" />
                                </StackLayout>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.CurrentPassword}" />
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,8,16,8"
                                    LeadingViewPosition="Inside"
                                     IsHintAlwaysFloated="True"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="CurrentPassword"
                                        IsPassword="True"
                                        MaxLength="16"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding CurrentPasswordEntry}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:PasswordTextBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image x:Name="CurrentPasswordImg" Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnCurrentPasswordTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>


                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NewPassword}" />
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,8,16,8"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                     IsHintAlwaysFloated="True"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="NewPassword"
                                        IsPassword="True"
                                        MaxLength="16"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding NewPasswordEntry}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:PasswordTextBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image x:Name="NewPasswordImg" Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNewPasswordTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" />
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,8,16,8"
                                    LeadingViewPosition="Inside"
                                     IsHintAlwaysFloated="True"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="ConfirmPassword"
                                        IsPassword="True"
                                        MaxLength="16"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding ConfirmPasswordEntry}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:PasswordTextBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image x:Name="ConfirmPasswordImg" Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnConfirmPasswordTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                            </StackLayout>
                        </ScrollView>

                        <Grid
                            Grid.Row="0"
                            Padding="0,0,0,8"
                            BackgroundColor="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White">
                                <Image
                                    HorizontalOptions="Start"
                                    Source="arrowLeft.png"
                                    Style="{DynamicResource BackButtonArrow}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackArrowTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="White">
                                <Image HeightRequest="30" Source="ic_logo_gazt.png" />
                            </StackLayout>
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="2"
                                BackgroundColor="White">
                                <Image HorizontalOptions="End" Source="close.png">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackArrowTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                        </Grid>

                        <buttons:SfButton
                            x:Name="btn"
                            Grid.Row="2"
                            Clicked="VerifyBtnClicked"
                            IsEnabled="{Binding BtnEnableFlag}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.Verify}" />
                    </Grid>
                </yummy:PancakeView>
            </StackLayout>


            <Grid
                Grid.Row="0"
                Grid.RowSpan="1"
                Margin="-20"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>


        </Grid>
    </ContentPage.Content>
</ContentPage>