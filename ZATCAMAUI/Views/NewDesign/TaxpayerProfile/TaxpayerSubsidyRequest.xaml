<?xml version="1.0" encoding="utf-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.TaxpayerSubsidyRequest"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    TitleText="{x:Static ResourceManager:AppResources.TaxPayerSubsidyRequest}">

    <newdesign:BaseContentPage.PancakeView>
        <WebView
            x:Name="SubsidyWebView"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HeightRequest="1000"
            HorizontalOptions="FillAndExpand"
            Navigated="SubsidyWebView_Navigated"
            Navigating="SubsidyWebView_Navigating"
            Source="{Binding WebUrl}"
            VerticalOptions="FillAndExpand" />
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>