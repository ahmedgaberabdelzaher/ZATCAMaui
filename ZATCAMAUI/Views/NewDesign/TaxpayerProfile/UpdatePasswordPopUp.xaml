<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.UpdatePasswordPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    BackgroundColor="#88000000"
    mc:Ignorable="d">

    <Border
        Padding="0"
        Style="{StaticResource CommonTopCurves}"
         Stroke="{StaticResource NeutralLightGrey}"
        VerticalOptions="EndAndExpand">
        <Grid RowDefinitions="*,auto">

            <StackLayout Grid.Row="0">

                <Image
                    Margin="24,16,24,8"
                    HeightRequest="25"
                    HorizontalOptions="End"
                    Source="close"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <BoxView Style="{StaticResource SeparatorStyle}" />

                <StackLayout Padding="24,16,24,0">

                    <Label
                        Margin="0,5"
                        HorizontalOptions="Start"
                        Style="{StaticResource SectionTitleBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.TPUpdatePassword}" />

                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.CurrentPassword}" />

                    <custom:CustomSfTextInputView OutlineCornerRadius="8">
                        <custom:CustomSfTextInputView.TextInputView>
                            <custom:GAZTBorderlessEntry
                                x:Name="CurrentPassword"
                                IsPassword="True"
                                MaxLength="16"
                                Placeholder="{x:Static ResourceManager:AppResources.CurrentPassword}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding CurrentPasswordEntry}"
                                TextColor="{StaticResource NeutralBlack}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:PasswordTextBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>
                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="CurrentPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnCurrentPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </custom:CustomSfTextInputView>


                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NDNewPassword}" />


                    <custom:CustomSfTextInputView OutlineCornerRadius="8">
                        <custom:CustomSfTextInputView.TextInputView>
                            <custom:GAZTBorderlessEntry
                                x:Name="NewPassword"
                                IsPassword="True"
                                MaxLength="16"
                                Placeholder="{x:Static ResourceManager:AppResources.NDNewPassword}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding NewPasswordEntry}"
                                TextColor="{StaticResource NeutralBlack}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:PasswordTextBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>
                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="NewPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNewPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </custom:CustomSfTextInputView>



                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NDConfirmNewPassword}" />

                    <custom:CustomSfTextInputView OutlineCornerRadius="8">
                        <custom:CustomSfTextInputView.TextInputView>
                             <custom:GAZTBorderlessEntry
                                x:Name="ConfirmPassword"
                                IsPassword="True"
                                MaxLength="16"
                                Style="{StaticResource DefaultEntry}"
                                Placeholder="{x:Static ResourceManager:AppResources.NDConfirmNewPassword}"
                                Text="{Binding ConfirmPasswordEntry}"
                                TextColor="{StaticResource NeutralBlack}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:PasswordTextBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>
                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="ConfirmPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnConfirmPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </custom:CustomSfTextInputView>
                </StackLayout>

                <buttons:SfButton
                    x:Name="btn"
                    Margin="24,0,24,24"
                    Clicked="OnUpdateBtnClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.TPUpdate}" />
            </StackLayout>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        </Grid>
    </Border>

</Mopups:PopupPage>
