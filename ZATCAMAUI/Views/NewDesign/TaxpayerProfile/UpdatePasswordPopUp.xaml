<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.UpdatePasswordPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>-->

    <Border
        Padding="0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <Grid RowDefinitions="*,auto">

            <StackLayout Grid.Row="0">

                <Image Margin="24,16,24,8"
                       Source="close"
                       WidthRequest="25"
                       HeightRequest="25"
                       HorizontalOptions="End">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <BoxView Style="{StaticResource SeparatorStyle}" />

                <StackLayout Padding="24,16,24,0">

                    <Label Style="{StaticResource SectionTitleBlackBold}"
                           Margin="0,5"
                           HorizontalOptions="Start"
                           Text="{x:Static ResourceManager:AppResources.TPUpdatePassword}" />

                    <Label Style="{StaticResource CaptionLabelGrey}"
                           HorizontalOptions="Start"
                           Text="{x:Static ResourceManager:AppResources.CurrentPassword}" />

                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                         IsHintAlwaysFloated="True"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            x:Name="CurrentPassword"
                            IsPassword="True"
                            MaxLength="16"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding CurrentPasswordEntry}"
                            TextColor="{StaticResource NeutralBlack}">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviors:PasswordTextBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="CurrentPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnCurrentPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>


                    <Label Style="{StaticResource CaptionLabelGrey}"
                           HorizontalOptions="Start"
                           Text="{x:Static ResourceManager:AppResources.NDNewPassword}" />
                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                         IsHintAlwaysFloated="True"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            x:Name="NewPassword"
                            IsPassword="True"
                            MaxLength="16"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding NewPasswordEntry}"
                            TextColor="{StaticResource NeutralBlack}">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviors:PasswordTextBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="NewPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNewPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>


                    <Label Style="{StaticResource CaptionLabelGrey}"
                           HorizontalOptions="Start"
                           Text="{x:Static ResourceManager:AppResources.NDConfirmNewPassword}" />
                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                         IsHintAlwaysFloated="True"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            x:Name="ConfirmPassword"
                            IsPassword="True"
                            MaxLength="16"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding ConfirmPasswordEntry}"
                            TextColor="{StaticResource NeutralBlack}">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviors:PasswordTextBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="ConfirmPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnConfirmPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>

                <buttons:SfButton
                    x:Name="btn"
                    Margin="24,0,24,24"
                    Clicked="OnUpdateBtnClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.TPUpdate}" />
            </StackLayout>

            <custom:Loader Grid.RowSpan="2"  IsVisible="{Binding IsLoading}"/>
        </Grid>
    </Border>

</pages:PopupPage>
