<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.TaxpayerProfileSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}">
    <ContentPage.Content>
        <StackLayout Padding="24" Orientation="Vertical">
            <Image Margin="0,90,0,0" Source="Forget_ic_success.png" />
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource SectionTitleWhiteBold}"
                Text="{Binding SuccessTitleLbl}" />
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource CaptionLabelWhite}"
                Text="{Binding successCaptionLbl}" />
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource ButtonLabelBlackBold}"
                Text="{Binding ButtonLabelText}"
                TextColor="{StaticResource NewDullOrangeColor}"
                VerticalOptions="EndAndExpand">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnGoToProfileLblTapped" />
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
