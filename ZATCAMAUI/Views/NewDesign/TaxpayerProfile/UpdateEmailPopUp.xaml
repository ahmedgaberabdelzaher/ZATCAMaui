<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.UpdateEmailPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    BackgroundColor="#88000000"
    mc:Ignorable="d">
    <Border
        Padding="0"
        Style="{StaticResource CommonTopCurves}"
         Stroke="{StaticResource NeutralLightGrey}"
        VerticalOptions="EndAndExpand">
        <Grid RowDefinitions="*,auto">

            <StackLayout
                x:Name="UpdateEmail"
                Grid.Row="0"
                IsVisible="True">
                <Image
                    Margin="24,16,24,8"
                    HeightRequest="25"
                    HorizontalOptions="End"
                    Source="close"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" Style="{StaticResource lineSeperator}" />

                <StackLayout Padding="24,16,24,0">
                    <Label
                        Margin="0,5"
                        HorizontalOptions="Start"
                        Style="{StaticResource SectionTitleBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.ZUpdateEmail}" />

                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.ZCurrentEmail}" />

                    <custom:CustomSfTextInputView>
                        <custom:CustomSfTextInputView.TextInputView>
                             <custom:GAZTBorderlessEntry
                                InputTransparent="True"
                                Placeholder="{x:Static ResourceManager:AppResources.ZCurrentEmail}"
                                IsReadOnly="True"
                                Keyboard="Email"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding CurrentEmailText}"
                                TextColor="{StaticResource NeutralBlack}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:AlphaNumericValidatorBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>
                    </custom:CustomSfTextInputView>

                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NewEmail}" />

                    <custom:CustomSfTextInputView >
                        <custom:CustomSfTextInputView.TextInputView>
                             <custom:GAZTBorderlessEntry
                                x:Name="NewEmail_Entry"
                                Placeholder="{x:Static ResourceManager:AppResources.NewEmail}"
                                Keyboard="Email"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding NewEmailText}"
                                TextColor="{StaticResource NeutralBlack}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:AlphaNumericValidatorBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>
                    </custom:CustomSfTextInputView>

                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NDConfirmNewEmail}" />

                    <custom:CustomSfTextInputView >
                        <custom:CustomSfTextInputView.TextInputView>
                             <custom:GAZTBorderlessEntry
                                x:Name="ConfirmEmail_Entry"
                                Placeholder="{x:Static ResourceManager:AppResources.NDConfirmNewEmail}"
                                Keyboard="Email"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding ConfirmEmailText}"
                                TextColor="{StaticResource NeutralBlack}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:AlphaNumericValidatorBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>
                    </custom:CustomSfTextInputView>

                </StackLayout>

                <buttons:SfButton
                    x:Name="btn"
                    Margin="24,0,24,24"
                    Clicked="UpdatedClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.TPUpdate}" />

            </StackLayout>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </Border>

</Mopups:PopupPage>