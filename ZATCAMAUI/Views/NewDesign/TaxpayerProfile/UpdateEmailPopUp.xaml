<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.UpdateEmailPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        Padding="0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <Grid RowDefinitions="*,auto">

            <StackLayout
                x:Name="UpdateEmail"
                Grid.Row="0"
                IsVisible="True">
                <Image
                    Margin="24,16,24,8"
                    HeightRequest="25"
                    HorizontalOptions="End"
                    Source="close"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" Style="{StaticResource lineSeperator}" />

                <StackLayout Padding="24,16,24,0">
                    <Label
                        Margin="0,5"
                        HorizontalOptions="Start"
                        Style="{StaticResource SectionTitleBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.ZUpdateEmail}" />

                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.ZCurrentEmail}" />

                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                        IsHintAlwaysFloated="True"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="10"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            InputTransparent="True"
                            IsReadOnly="True"
                            Keyboard="Email"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding CurrentEmailText}"
                            TextColor="{StaticResource NeutralBlack}">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviors:AlphaNumericValidatorBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>

                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NewEmail}" />
                    <inputLayout:SfTextInputLayout
                        x:Name="Frm_NewEmail"
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                        IsHintAlwaysFloated="True"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="10"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            x:Name="NewEmail_Entry"
                            Keyboard="Email"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding NewEmailText}"
                            TextColor="{StaticResource NeutralBlack}"
                            Unfocused="NewEmail_Entry_Unfocused">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviors:AlphaNumericValidatorBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>

                    <Label
                        HorizontalOptions="Start"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NDConfirmNewEmail}" />
                    <inputLayout:SfTextInputLayout
                        x:Name="Frm_confirmEmail"
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                        IsHintAlwaysFloated="True"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            x:Name="ConfirmEmail_Entry"
                            Keyboard="Email"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding ConfirmEmailText}"
                            TextColor="{StaticResource NeutralBlack}"
                            Unfocused="ConfirmEmail_Entry_Unfocused">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviors:AlphaNumericValidatorBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>

                <buttons:SfButton
                    x:Name="btn"
                    Margin="24,0,24,24"
                    Clicked="UpdatedClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.TPUpdate}" />

            </StackLayout>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </Border>

</Mopups:PopupPage>