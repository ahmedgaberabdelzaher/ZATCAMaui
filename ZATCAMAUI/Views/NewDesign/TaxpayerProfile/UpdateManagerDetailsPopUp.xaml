<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.UpdateManagerDetailsPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">

    <Border
        Padding="0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0">
                <Image Margin="24,16,24,8" HorizontalOptions="Start">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="UserIconFont"
                            Glyph="{x:Static FontImage:IconFonts.Close}"
                            Size="25"
                            Color="{StaticResource SecondaryNew}" />
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <BoxView Style="{StaticResource SeparatorStyle}" />
                <StackLayout Padding="24,16,24,0">
                    <custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.ManagerDetailsTitle}" />


                </StackLayout>

                <listView:SfListView
                    x:Name="outerListView"
                    AutoFitMode="DynamicHeight"
                    BackgroundColor="White"
                    IsVisible="{Binding ShowListview}"
                    ItemsSource="{Binding MgrList}">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="4"
                                Padding="10"
                                Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Margin="8" BackgroundColor="White">
                                    <StackLayout Margin="8,0,8,0" Orientation="Vertical">
                                        <custom:CustomLabel
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="14"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.IDNumber}" />

                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                            <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="FillAndExpand"
                                                IsEnabled="{Binding EnableIDNumber}"
                                                MaxLength="15"
                                                Text="{Binding Mgrid}"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </Border>

                                    </StackLayout>
                                    <StackLayout Margin="8,0,8,0" Orientation="Vertical">
                                        <custom:CustomLabel
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="14"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.ManagerName}" />

                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                            <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="FillAndExpand"
                                                IsEnabled="{Binding EnableManagerName}"
                                                MaxLength="40"
                                                Text="{Binding Mgrnm}"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </Border>

                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">

                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="8,0,4,0"
                                                Orientation="Vertical">
                                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ManagerDetailsDob}" />
                                                <StackLayout HorizontalOptions="StartAndExpand">

                                                    <Border
                                                        Stroke="#B1B1B1"
                                                        StrokeThickness="1"
                                                        Style="{StaticResource GreyBorderFrame}">
                                                        <StackLayout
                                                            Padding="20,8,20,8"
                                                            HorizontalOptions="FillAndExpand"
                                                            Orientation="Horizontal">


                                                            <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding BirthDt}" />

                                                            <StackLayout
                                                                HorizontalOptions="End"
                                                                IsEnabled="{Binding EnableBirthdate}"
                                                                Orientation="Horizontal">
                                                                <Image Margin="5,0">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                            Size="24"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                </Image>

                                                            </StackLayout>
                                                            <StackLayout.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding BindingContext.OutletClosetransferDatePickerClicker, Source={x:Reference outerListView}}"
                                                                    CommandParameter="{Binding .}"
                                                                    NumberOfTapsRequired="1" />
                                                            </StackLayout.GestureRecognizers>


                                                        </StackLayout>
                                                    </Border>

                                                </StackLayout>


                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="8,0,8,0"
                                                Orientation="Vertical">
                                                <custom:CustomLabel
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.MobileNumber}" />

                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <Border Padding="8" Style="{StaticResource GreyBorderFrame}">
                                                    <custom:GAZTBorderlessEntry
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsEnabled="{Binding EnableMobNumber}"
                                                        Keyboard="Numeric"
                                                        MaxLength="15"
                                                        Text="{Binding MobNo}"
                                                        TextColor="{StaticResource NeutralBlack}" />
                                                </Border>

                                            </StackLayout>
                                        </Grid>



                                    </StackLayout>
                                    <StackLayout Margin="8,0,8,0" Orientation="Vertical">
                                        <custom:CustomLabel
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="14"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.Email}" />

                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                            <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="FillAndExpand"
                                                IsEnabled="{Binding EnableEmail}"
                                                Keyboard="Email"
                                                MaxLength="200"
                                                Text="{Binding Email}"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </Border>

                                    </StackLayout>

                                </StackLayout>
                            </Border>

                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>

                <custom:CustomLabel
                    x:Name="NoDataLable"
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    IsVisible="{Binding ShowNoData}"
                    Style="{StaticResource BodyLabelGrey}"
                    Text="{x:Static ResourceManager:AppResources.ZZZVatNoData}" />

                <StackLayout
                    Grid.Row="0"
                    HeightRequest="50"
                    HorizontalOptions="StartAndExpand"
                    IsVisible="{Binding ShowListview}"
                    Orientation="Horizontal">
                    <buttons:SfButton
                        Margin="24,0,24,0"
                        Clicked="OnUpdateBtnClicked"
                        HorizontalOptions="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.Save}"
                        WidthRequest="150" />
                    <buttons:SfButton
                        Margin="24,0,24,0"
                        Clicked="OnDiscardBtnClicked"
                        HorizontalOptions="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.DiscardChanges}"
                        WidthRequest="150" />
                </StackLayout>
            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="1"
                Margin="-20"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">

                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </Border>

</pages:PopupPage>
