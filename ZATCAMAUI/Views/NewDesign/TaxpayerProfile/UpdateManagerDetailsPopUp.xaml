<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerProfile.UpdateManagerDetailsPopUp"
    FlowDirection="{Binding AppDirection}">

    <Border Padding="0" Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0">
                <Image Margin="24,16,24,8" HorizontalOptions="Start">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.Close}"/>
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <BoxView Style="{StaticResource SeparatorStyle}"/>
                <StackLayout Padding="24,16,24,0">
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ManagerDetailsTitle}" Style="{StaticResource SectionTitleBlackBold}"/>

                    
                </StackLayout>

                <listView:SfListView x:Name="outerListView" ItemsSource="{Binding MgrList}" BackgroundColor="White" AutoFitMode="DynamicHeight" IsVisible="{Binding ShowListview}">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Style="{StaticResource GreyBorderFrame}" Margin="4">
                                   <StackLayout Margin="8" BackgroundColor="White">
                                <StackLayout  Orientation="Vertical" Margin="8,0,8,0">
                                    <custom:CustomLabel 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.IDNumber}"  />
                                                
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:GAZTBorderlessEntry IsEnabled="{Binding EnableIDNumber}"
                                        MaxLength="15"
                                        HorizontalOptions="FillAndExpand"
                                        Text="{Binding Mgrid}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </Border>

                                </StackLayout>
                                <StackLayout  Orientation="Vertical" Margin="8,0,8,0">
                                    <custom:CustomLabel 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ManagerName}"  />
                                                
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:GAZTBorderlessEntry IsEnabled="{Binding EnableManagerName}"
                                        HorizontalOptions="FillAndExpand"
                                                            MaxLength="40"
                                        Text="{Binding Mgrnm}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </Border>

                                </StackLayout>
                                 <StackLayout Orientation="Horizontal">

                                    <Grid HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>
                                        <StackLayout  Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="8,0,4,0">
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ManagerDetailsDob}" Style="{StaticResource CaptionLabelGrey}"/>
                                        <StackLayout HorizontalOptions="StartAndExpand" >
                                             
                                             <Border Stroke="#B1B1B1" StrokeThickness="1"
                                                                    Style="{StaticResource GreyBorderFrame}">
                                                    <StackLayout  Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="20,8,20,8" >
                                    

                                                           <custom:CustomLabel Text="{Binding BirthDt}" Style="{StaticResource ValueLabelBlack}"/>
                                       
                                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal" IsEnabled="{Binding EnableBirthdate}">
                                                            <Image Margin="5,0" >
                                                                <Image.Source>
                                                                    <FontImageSource FontFamily="UserIconFont"
                                                                                    Color="{StaticResource SecondaryNew}" Size="24"
                                                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}" />
                                                                </Image.Source>
                                                            </Image>

                                                        </StackLayout>
                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                    NumberOfTapsRequired="1"
                                                                    Command="{Binding BindingContext.OutletClosetransferDatePickerClicker, Source={x:Reference outerListView}}"
                                                                    CommandParameter="{Binding .}" />
                                                        </StackLayout.GestureRecognizers>


                                                    </StackLayout>
                                        </Border>

                                        </StackLayout>

                                        
                                    </StackLayout>
                                        <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="8,0,8,0">
                                    <custom:CustomLabel 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.MobileNumber}"  />
                                                
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <Border Padding="8" Style="{StaticResource GreyBorderFrame}">
                                    <custom:GAZTBorderlessEntry IsEnabled="{Binding EnableMobNumber}"
                                        HorizontalOptions="FillAndExpand"
                                        MaxLength="15"
                                        Keyboard="Numeric"
                                        Text="{Binding MobNo}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </Border>

                                </StackLayout>
                                    </Grid>

                                    
                                    
                                </StackLayout>
                                 <StackLayout  Orientation="Vertical" Margin="8,0,8,0">
                                    <custom:CustomLabel 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.Email}"  />
                                                
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <Border Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:GAZTBorderlessEntry IsEnabled="{Binding EnableEmail}"
                                        Keyboard="Email"
                                        MaxLength="200"
                                        HorizontalOptions="FillAndExpand"
                                        Text="{Binding Email}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </Border>

                                </StackLayout>
                                
                            </StackLayout>
                                </Border>
                            
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                    </listView:SfListView>

                <custom:CustomLabel Grid.Row="0" IsVisible="{Binding ShowNoData}"
                                            x:Name="NoDataLable"
                                            HorizontalOptions="Center"
                                            Text="{x:Static ResourceManager:AppResources.ZZZVatNoData}"
                                            Style="{StaticResource BodyLabelGrey}" />

                <StackLayout Orientation="Horizontal" HorizontalOptions="StartAndExpand" Grid.Row="0" HeightRequest="50" IsVisible="{Binding ShowListview}">
                    <buttons:SfButton Margin="24,0,24,0"
                                      WidthRequest="150"
                              Text="{x:Static ResourceManager:AppResources.Save}"
                              Clicked="OnUpdateBtnClicked"
                                HorizontalOptions="Center"
                              Style="{StaticResource PrimaryButtonStyle}"/>
                    <buttons:SfButton Margin="24,0,24,0"
                                      WidthRequest="150"
                              Text="{x:Static ResourceManager:AppResources.DiscardChanges}"
                             Clicked="OnDiscardBtnClicked"
                                HorizontalOptions="Center"
                              Style="{StaticResource PrimaryButtonStyle}"/>
                </StackLayout>
            </StackLayout>

            <Grid Grid.Row="0" Grid.RowSpan="1" Margin="-20"
                      IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Black"
                             Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Transparent"
                             Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">

                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </Border>

</pages:PopupPage>
