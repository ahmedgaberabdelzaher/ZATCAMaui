<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATServices.VATServicesPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.BackButtonTitle=""
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<CustomControl:DataMarkerConverter x:Key="converter" />-->
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="VATServices" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <StackLayout Spacing="16">
                    <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout
                            Padding="16,8,16,8"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Image Source="ic_RefundR.png" />
                            <custom:CustomLabel
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDRefundsRequest}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />

                        </StackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="VATRefundRequest_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border IsVisible="{Binding ShowVATRegisteredItems}" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout
                            Padding="16,8,16,8"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Image Source="ic_vat_return.png" />
                            <custom:CustomLabel
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDFillingFrequency}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />

                        </StackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ChnageFillingPeriod_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <StackLayout IsVisible="{Binding ShowVATRegisteredItems}" Spacing="16">
                        <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout
                                Padding="16,8,16,8"
                                Orientation="Horizontal"
                                Spacing="20">
                                <Image Source="deregistration.png" />
                                <custom:CustomLabel
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.DBSMVATDeregistration}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />

                            </StackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="VATDeregistrationDetails_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout
                                Padding="16,8,16,8"
                                Orientation="Horizontal"
                                Spacing="20">
                                <Image Source="registration.png" />
                                <custom:CustomLabel
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZVatRegistrationAmendmentTile}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />

                            </StackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="VATAment_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>

                    </StackLayout>

                    <Border IsVisible="{Binding ShowVATRegisteredItems}" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout
                            Padding="16,8,16,8"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Image Source="details.png" />
                            <custom:CustomLabel
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.VATRegistrationDetails}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </StackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="VATRegistration_Details_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border IsVisible="{Binding ShowVATReactivationItems}" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout
                            Padding="16,8,16,8"
                            Orientation="Horizontal"
                            Spacing="20">
                            <Image Source="sf_ic_Paid.png" />
                            <custom:CustomLabel
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZVatRegistrationReactivationTile}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />

                        </StackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="VATReactivation_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>

                </StackLayout>
            </yummy:PancakeView>
            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>

                <Label
                    x:Name="MenuTitleName"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDVATServices}" />


                <Image
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    Source="arrowLeftwhite.png"
                    Style="{DynamicResource BackButtonArrow}"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>