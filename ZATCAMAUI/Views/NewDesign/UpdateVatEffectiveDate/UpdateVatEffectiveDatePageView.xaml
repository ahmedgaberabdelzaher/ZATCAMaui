<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.UpdateVatEffectiveDate.UpdateVatEffectiveDatePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="page"
    Title="UpdateVatEffectiveDatePageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,*">

        <!--#region Header-->
        <Grid
            Padding="20,10"
            ColumnDefinitions="*,2*,*"
            RowDefinitions="auto,*">

            <StackLayout>

                <!--  Back Button  -->
                <Image
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Rotation="0"
                    Source="whiteRightBack.png"
                    VerticalOptions="CenterAndExpand">

                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding AppDirection}"
                            TargetType="Image"
                            Value="LeftToRight">
                            <Setter Property="Rotation" Value="180" />
                        </DataTrigger>
                    </Image.Triggers>

                </Image>

                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </StackLayout.GestureRecognizers>

            </StackLayout>

            <!--  Header Label  -->
            <Label
                Grid.Column="1"
                FontSize="15"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource SectionTitleWhiteBold}"
                Text="{x:Static ResourceManager:AppResources.REQToUpdateVatEffDate}"
                VerticalOptions="Center" />

            <StackLayout
                Grid.Row="0"
                Grid.Column="2"
                HorizontalOptions="EndAndExpand"
                Orientation="Horizontal"
                Spacing="15"
                VerticalOptions="CenterAndExpand">
                <Image
                    HeightRequest="20"
                    IsVisible="{Binding IsSearchButtonVisible}"
                    Source="search"
                    WidthRequest="20">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="searchButtonTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Image
                    HeightRequest="20"
                    Source="filter"
                    WidthRequest="20">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="filterButtonTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>

            <StackLayout
                Grid.Row="1"
                Grid.ColumnSpan="3"
                HorizontalOptions="FillAndExpand"
                Orientation="Horizontal"
                VerticalOptions="FillAndExpand">

                <Grid HorizontalOptions="FillAndExpand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SearchBar
                        x:Name="searchBar"
                        Grid.Column="0"
                        Margin="0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsCloseButtonVisible}"
                        TextChanged="SearchBar_TextChanged"
                        VerticalOptions="FillAndExpand" />

                    <Image
                        Grid.Column="1"
                        HeightRequest="24"
                        IsVisible="{Binding IsCloseButtonVisible}"
                        Source="close"
                        WidthRequest="24">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>
            </StackLayout>

        </Grid>
        <!--#endregion Header-->

        <!--#region Body-->
        <Border
            Grid.Row="1"
            Padding="10,0"
            Style="{StaticResource CommonTopCurves}">

            <Grid RowDefinitions="auto">

                <Grid
                    Grid.Row="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="1"
                        Margin="0,0,0,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <listView:SfListView
                            x:Name="EffectiveDateListView"
                            Grid.Row="0"
                            Grid.Column="0"
                            AutoFitMode="Height"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            ItemSpacing="5"
                            ItemsSource="{Binding CopiedVatLogs}"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                            SelectionBackground="Transparent"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand">
                            <!--  Header Template added  -->
                            <listView:SfListView.HeaderTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ViewCell.View>
                                            <Border
                                                Margin="0,0,0,5"
                                                Padding="12"
                                                HorizontalOptions="FillAndExpand"
                                                StrokeShape="RoundRectangle 15"
                                                Style="{StaticResource GreyBorderFrameWithShadow}"
                                                VerticalOptions="FillAndExpand">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="add"
                                                        VerticalOptions="CenterAndExpand"
                                                        WidthRequest="24" />
                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        FontSize="16"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.VATEffNewRequest}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding AddNewRequestTapped}" />
                                                    </Grid.GestureRecognizers>
                                                </Grid>
                                            </Border>
                                        </ViewCell.View>
                                    </ViewCell>
                                </DataTemplate>
                            </listView:SfListView.HeaderTemplate>

                            <listView:SfListView.ItemTemplate IsVisible="{Binding IsListVisible}">
                                <DataTemplate>
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,15,0,0"
                                        Padding="10"
                                        StrokeShape="RoundRectangle 15"
                                        Style="{StaticResource GreyBorderFWithShadow}">
                                        <StackLayout Padding="0" Spacing="0">
                                            <Grid Padding="10" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>



                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,4"
                                                    HorizontalOptions="Start">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.IBANRefNum}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        Margin="0,-10"
                                                        HorizontalOptions="End"
                                                        Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                        Text="{Binding Fbnum}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                                <BoxView
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,5"
                                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,4">
                                                    <Label
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.EffectModifyDate}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        Margin="0,-10"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                        Text="{Binding ModifyDate, Converter={StaticResource DateFormatConverter}}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="3"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,4">
                                                    <Label
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.EffectDateBeforeUpdate}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        Margin="0,-10"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                        Text="{Binding EffDtBefore, Converter={StaticResource DateFormatConverter}}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="4"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,4">
                                                    <Label
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.EffectDateAfterUpdate}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        Margin="0,-10"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                        Text="{Binding EffDtAfter, Converter={StaticResource DateFormatConverter}}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="5"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,4">
                                                    <Label
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.EffectUpdatedBy}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        Margin="0,-10"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                        Text="{Binding UpdatedBy}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </Grid>

                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Margin="0,100,0,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding NoDataAvailable}"
                        VerticalOptions="FillAndExpand">
                        <Label HorizontalOptions="Center" Text="{x:Static ResourceManager:AppResources.VatEffNoData}" />
                    </Grid>
                </Grid>

            </Grid>

        </Border>
        <!--#endregion Body-->

        <!--  Loader  -->
        <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

    </Grid>
</ContentPage>