<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.NewDesign.UpdateVatEffectiveDate.UpdateVatEffectiveDatePageView"
             Title="UpdateVatEffectiveDatePageView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
            xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
            xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Name="page"
            ios:Page.UseSafeArea="true"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" 
                    ColumnDefinitions="*,2*,*"
                    RowDefinitions="auto,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.REQToUpdateVatEffDate}"
                    VerticalOptions="Center" />

                <StackLayout Spacing="15" Orientation="Horizontal" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="2">
                    <Image Source="search" IsVisible="{TemplateBinding BindingContext.IsSearchButtonVisible}" HeightRequest="20" WidthRequest="20">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="searchButtonTapped"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Source="filter" HeightRequest="20" WidthRequest="20">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="filterButtonTapped"/>
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                Grid.Row="1" Grid.ColumnSpan="3">

                    <Grid HorizontalOptions="FillAndExpand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <SearchBar x:Name="searchBar" Grid.Column="0"  BackgroundColor="White" custom:RoundCornersEffect.CornerRadius="12" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0" TextChanged="SearchBar_TextChanged" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                        </SearchBar>

                        <Image Grid.Column="1" WidthRequest="24" HeightRequest="24" Source="close" IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CloseSearchButton_Tapped">
                                </TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="auto">
                    
                    <Grid Grid.Row="0"   BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,0"  BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <listView:SfListView  x:Name="EffectiveDateListView" HorizontalOptions="FillAndExpand" ScrollBarVisibility="Never"  VerticalOptions="FillAndExpand" Grid.Row="0"  Grid.Column="0" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding CopiedVatLogs}"  BackgroundColor="Transparent" 
                            SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}" SelectionMode="Single" SelectionBackground="Transparent">
                                <!--Header Template added-->
                                <listView:SfListView.HeaderTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ViewCell.View>
                                                <Border  StrokeShape="RoundRectangle 15" Margin="0,0,0,5" HorizontalOptions="FillAndExpand" Padding="12"
                                                 Style="{StaticResource GreyBorderFrameWithShadow}" VerticalOptions="FillAndExpand">
                                                    <Grid >
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"></RowDefinition>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Source="add" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" VerticalOptions="CenterAndExpand"></Image>
                                                        <Label Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.VATEffNewRequest}" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" FontSize="16" VerticalOptions="CenterAndExpand"/>
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding AddNewRequestTapped}"></TapGestureRecognizer>
                                                        </Grid.GestureRecognizers>
                                                    </Grid>
                                                </Border>
                                            </ViewCell.View>
                                            </ViewCell>
                                        </DataTemplate>
                                </listView:SfListView.HeaderTemplate>

                                <listView:SfListView.ItemTemplate IsVisible="{Binding IsListVisible}" >
                                    <DataTemplate>
                                        <Border  Padding="10"  Grid.Column="0" StrokeShape="RoundRectangle 15" Margin="0,15,0,0"
                                                          Style="{StaticResource GreyBorderFWithShadow}">
                                            <StackLayout Padding="0" Spacing="0" >
                                                <Grid  Padding="10" RowSpacing="0" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="auto"/>
                                                    </Grid.ColumnDefinitions>



                                                    <StackLayout Grid.Row="0" Grid.Column="0" Margin="0,4" HorizontalOptions="Start">
                                                        <Label Text="{x:Static ResourceManager:AppResources.IBANRefNum}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"></Label>
                                                        <Label Text="{Binding Fbnum}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="End"></Label>
                                                    </StackLayout>

                                                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}" Margin="0,5" />

                                                    <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4">
                                                        <Label Text="{x:Static ResourceManager:AppResources.EffectModifyDate}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                <Label Text="{Binding ModifyDate,Converter={StaticResource DateFormatConverter}}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="3"  Grid.ColumnSpan="2"  Margin="0,4">
                                                        <Label Text="{x:Static ResourceManager:AppResources.EffectDateBeforeUpdate}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                <Label Text="{Binding EffDtBefore,Converter={StaticResource DateFormatConverter}}"  Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4">
                                                        <Label Text="{x:Static ResourceManager:AppResources.EffectDateAfterUpdate}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                <Label Text="{Binding EffDtAfter,Converter={StaticResource DateFormatConverter}}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4">
                                                        <Label Text="{x:Static ResourceManager:AppResources.EffectUpdatedBy} " Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                        <Label Text="{Binding UpdatedBy}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    </StackLayout>
                                                </Grid>

                                            </StackLayout>
                                        </Border >
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,100,0,0"  BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding NoDataAvailable}">
                            <Label Text="{x:Static ResourceManager:AppResources.VatEffNoData}" HorizontalOptions="Center"/>
                        </Grid>
                    </Grid>

                </Grid>
                
            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
</ContentPage>