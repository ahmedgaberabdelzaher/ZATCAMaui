<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.LogoutPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <Grid RowDefinitions="auto,auto">

            <StackLayout Grid.Row="0" Spacing="0">
                <Label
                    x:Name="confirmationText"
                    Margin="10"
                    Style="{StaticResource BodyLabelBlack}" />
            </StackLayout>
            <HorizontalStackLayout
                Grid.Row="1"
                HorizontalOptions="CenterAndExpand"
                Spacing="30">

                <buttons:SfButton
                    Clicked="OnOkayButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZYes}"
                    WidthRequest="150" />
                <buttons:SfButton
                    Clicked="OnCancelClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZNo}"
                    VerticalOptions="FillAndExpand"
                    WidthRequest="150" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</Mopups:PopupPage>