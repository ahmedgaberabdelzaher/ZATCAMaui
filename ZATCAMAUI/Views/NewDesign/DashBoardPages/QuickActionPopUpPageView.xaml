<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.QuickActionPopUpPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    BackgroundColor="Transparent"
    FlowDirection="{Binding AppDirection}">
    <Border StrokeShape="RoundRectangle 20,20,20,20" VerticalOptions="FillAndExpand">

        <Grid VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="60*" />
                <RowDefinition Height="40*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="80*" />
                <ColumnDefinition Width="10*" />

            </Grid.ColumnDefinitions>
            <Grid
                Grid.Row="0"
                Grid.RowSpan="{x:OnPlatform iOS=2,
                                            Android=2}"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                BackgroundColor="Black"
                Opacity="0.5"
                VerticalOptions="FillAndExpand">

                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

            </Grid>
            <StackLayout
                Grid.Row="1"
                Grid.Column="1"
                Padding="20"
                Orientation="Vertical"
                Spacing="24"
                VerticalOptions="End">

                <Border
                    x:Name="ZAKATReturn"
                    BackgroundColor="White"
                    Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        Orientation="Horizontal">

                        <Label
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource CustomButtonTextStyle}"
                            Text="{x:Static ResourceManager:AppResources.QuickActionShowOverDueReturns}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOverdueReturnClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverdueReturnClicked" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOverdueReturnClicked" />
                    </Border.GestureRecognizers>

                </Border>

                <Border
                    x:Name="ReadInbox"
                    BackgroundColor="White"
                    Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        Orientation="Horizontal">

                        <Label
                            Style="{StaticResource CustomButtonTextStyle}"
                            Text="{x:Static ResourceManager:AppResources.QuickActionShowCertificates}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCorrespondanceClicked" />
                            </Label.GestureRecognizers>
                        </Label>

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCorrespondanceClicked" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </Border>


                <Border
                    x:Name="GetSupport"
                    BackgroundColor="White"
                    Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        Orientation="Horizontal">

                        <Label
                            Style="{StaticResource CustomButtonTextStyle}"
                            Text="{x:Static ResourceManager:AppResources.GetSupport}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGetSupportClicked" />
                            </Label.GestureRecognizers>
                        </Label>

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGetSupportClicked" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </Border>


            </StackLayout>
            <Border
                Grid.Row="2"
                Grid.ColumnSpan="3"
                StrokeShape="RoundRectangle 10,10,10,10"
                HeightRequest="24"
                Opacity="0.5"
                WidthRequest="24">
                <Border.Margin>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="iOS" Value="2,-6,2,0" />
                        <On Platform="Android" Value="2,-6,2,0" />
                    </OnPlatform>
                </Border.Margin>
                <Border.HeightRequest>
                    <OnPlatform x:TypeArguments="x:Double">
                        <On Platform="iOS" Value="4" />
                        <On Platform="Android" Value="4" />
                    </OnPlatform>
                </Border.HeightRequest>
            </Border>

            <StackLayout
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Padding="0,0,0,16">

                <Image
                    x:Name="CloseIcon"
                    Margin="0,8,0,0"
                    HeightRequest="56"
                    Source="quick_Actions_Close.png"
                    WidthRequest="56">

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>
        </Grid>

    </Border>
</pages:PopupPage>