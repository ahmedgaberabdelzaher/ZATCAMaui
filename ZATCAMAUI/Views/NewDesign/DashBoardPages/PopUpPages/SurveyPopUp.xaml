<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.PopUpPages.SurveyPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}">
    <Mopups:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>
    <!--#region SurveyView {Binding IsShowMsgView}-->
    <Grid
        Grid.Row="0"
        Margin="0,0,0,0"
        IsVisible="{Binding IsShowMsgView}"
        VerticalOptions="FillAndExpand">

        <StackLayout
            BackgroundColor="Black"
            Opacity="0.4"
            VerticalOptions="FillAndExpand" />

        <Border
            Padding="20,20,20,25"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">
            <Grid Margin="0,0,0,0">
                <!--#region SurveyIntro-->
                <StackLayout
                    Margin="0"
                    IsVisible="false"
                    VerticalOptions="Center">
                    <StackLayout.Triggers>
                        <DataTrigger
                            Binding="{Binding SurveyCurrentStep}"
                            TargetType="StackLayout"
                            Value="0">
                            <Setter Property="IsVisible" Value="true" />
                        </DataTrigger>
                    </StackLayout.Triggers>
                    <Image
                        Margin="0,20,0,20"
                        HeightRequest="65"
                        HorizontalOptions="CenterAndExpand"
                        Source="SurveyStart"
                        WidthRequest="65" />
                    <Label
                        HorizontalOptions="CenterAndExpand"
                        HorizontalTextAlignment="Start"
                        Style="{StaticResource BodyLabelBlack}"
                        Text="{x:Static ResourceManager:AppResources.SurveyIntroMsg}" />
                    <Grid Margin="10" ColumnDefinitions="*,*">
                        <Border
                            Grid.Column="0"
                            Padding="12"
                            BackgroundColor="#0996D4"
                            StrokeShape="RoundRectangle 14,14,14,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SurveyActionCommand}" CommandParameter="1" />
                            </Border.GestureRecognizers>
                            <Label
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.questionnaire}"
                                TextColor="White" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="12"
                            BackgroundColor="White"
                            Stroke="#4FBBBD"
                            StrokeShape="RoundRectangle 14,14,14,14">
                            <Label
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.NDSkip}"
                                TextColor="#0996D4" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SurveyActionCommand}" CommandParameter="0" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                </StackLayout>
                <!--#endregion-->
                <!--#region FstQuestion-->
                <StackLayout
                    Margin="0,0,0,20"
                    IsVisible="false"
                    VerticalOptions="Center">
                    <StackLayout.Triggers>
                        <DataTrigger
                            Binding="{Binding SurveyCurrentStep}"
                            TargetType="StackLayout"
                            Value="1">
                            <Setter Property="IsVisible" Value="true" />
                        </DataTrigger>
                    </StackLayout.Triggers>
                    <Border
                        Margin="0"
                        Padding="9"
                        BackgroundColor="White"
                        Stroke="#4FBBBD"
                        StrokeShape="RoundRectangle 14,14,14,14">
                        <Label
                            FontSize="16"
                            HorizontalOptions="FillAndExpand"
                            Text="{x:Static ResourceManager:AppResources.SurveyQ1}"
                            TextColor="#0996D4" />
                    </Border>
                    <StackLayout
                        x:Name="menu"
                        BindableLayout.ItemsSource="{Binding ImojiesLst}"
                        HorizontalOptions="CenterAndExpand"
                        Orientation="Horizontal">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <StackLayout x:Name="Item" Margin="10">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            BindingContext="{Binding Source={x:Reference menu}, Path=BindingContext}"
                                            Command="{Binding SlectedImojieCommand}"
                                            CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                    </StackLayout.GestureRecognizers>
                                    <Image
                                        HeightRequest="36"
                                        Source="{Binding ImojieSource}"
                                        WidthRequest="36" />
                                </StackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </StackLayout>
                <!--#endregion-->
                <!--#region SecQuestion-->
                <StackLayout
                    Margin="0"
                    IsVisible="false"
                    Spacing="15"
                    VerticalOptions="Center">
                    <StackLayout.Triggers>
                        <DataTrigger
                            Binding="{Binding SurveyCurrentStep}"
                            TargetType="StackLayout"
                            Value="2">
                            <Setter Property="IsVisible" Value="true" />
                        </DataTrigger>
                    </StackLayout.Triggers>
                    <Label
                        FontSize="18"
                        HorizontalOptions="StartAndExpand"
                        Text="{Binding QuestionTxt}"
                        TextColor="{StaticResource Primary}" />
                    <Border
                        Padding="9"
                        BackgroundColor="White"
                        Stroke="#4FBBBD"
                        StrokeShape="RoundRectangle 14,14,14,14"
                        HeightRequest="100">
                        <custom:GAZTBorderlessEditor Placeholder="اكتب النص هنا " Text="{Binding SQAnswer}" />
                    </Border>
                    <Border
                        Grid.Column="0"
                        Padding="12"
                        BackgroundColor="#0996D4"
                        StrokeShape="RoundRectangle 14,14,14,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddSurveyCommand}" CommandParameter="0" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.Send}"
                            TextColor="White" />
                    </Border>
                </StackLayout>
                <!--#endregion-->
                <!--#endregion SurveyEnd-->
                <StackLayout
                    Margin="0"
                    IsVisible="false"
                    VerticalOptions="CenterAndExpand">
                    <StackLayout.Triggers>
                        <DataTrigger
                            Binding="{Binding SurveyCurrentStep}"
                            TargetType="StackLayout"
                            Value="3">
                            <Setter Property="IsVisible" Value="true" />
                        </DataTrigger>
                    </StackLayout.Triggers>
                    <Image
                        Margin="0,20,0,20"
                        HeightRequest="47"
                        HorizontalOptions="CenterAndExpand"
                        Source="SurveyEnd"
                        WidthRequest="45" />
                    <Label
                        FontSize="25"
                        HorizontalOptions="CenterAndExpand"
                        Text="{x:Static ResourceManager:AppResources.ThankYou}"
                        TextColor="{StaticResource Primary}" />
                    <Label
                        FontSize="16"
                        HorizontalOptions="StartAndExpand"
                        Text="{x:Static ResourceManager:AppResources.DearCustomer}"
                        TextColor="#0996D4" />
                    <Label
                        FontSize="16"
                        HorizontalOptions="StartAndExpand"
                        Text="{x:Static ResourceManager:AppResources.SurveyThankMsg}"
                        TextColor="{StaticResource Primary}" />
                    <Border
                        Grid.Column="0"
                        Padding="12"
                        BackgroundColor="#0996D4"
                        StrokeShape="RoundRectangle 14,14,14,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SurveyNextCommand}" CommandParameter="4" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.Form5Finish}"
                            TextColor="White" />
                    </Border>
                </StackLayout>
                <!--#endregion-->

            </Grid>
        </Border>

    </Grid>
    <!--#endregion-->
</Mopups:PopupPage>

