<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.ChatPotView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    TitleText="{x:Static ResourceManager:AppResources.NDChat}"
    FlowDirection="{Binding AppDirection}">
    <newdesign:BaseContentPage.PancakeView>
        <Grid BackgroundColor="White">

            <WebView x:Name="ChatWebView"
                     WidthRequest="{OnPlatform Android=350,iOS=410}"/>

        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

