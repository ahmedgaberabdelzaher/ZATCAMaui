<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.InfoPopUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        BackgroundColor="{StaticResource NewDullOrangeColor}"
        Stroke="{StaticResource NeutralLightGrey}"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <StackLayout>
            <Grid
                ColumnDefinitions="auto,*"
                ColumnSpacing="16"
                IsVisible="{Binding IsVatRegistrationTileVisible}"
                RowDefinitions="auto,auto,auto,auto,auto"
                RowSpacing="4">
                <Image
                    x:Name="VATInfoImg"
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="StartAndExpand"
                    Source="ic_White_info.png"
                     />

                <Label
                    x:Name="VATTitle"
                    Grid.Row="0"
                    Grid.Column="1"
                     LineHeight="0"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZRegisterinVATNow}"
                    TextColor="White"
                    VerticalOptions="StartAndExpand" />
                <Label
                    x:Name="VATDecp"
                    Grid.Row="1"
                    Grid.Column="1"
                     LineHeight="0"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{x:Static ResourceManager:AppResources.NDLessThan5MinRegister}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Zakat Starts  -->

            <Grid
                ColumnSpacing="16"
                IsVisible="{Binding IsEstablishmentRegistrationTileVisible}"
                RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>
                <Image
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="StartAndExpand"
                    Source="ic_White_info.png"
                     />

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                     LineHeight="0"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{x:Static ResourceManager:AppResources.NDRegisterZAKAT}"
                    TextColor="White"
                    VerticalOptions="StartAndExpand" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    LineHeight="0"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{x:Static ResourceManager:AppResources.NDRegZakatin5mins}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Zakat Ends  -->

            <buttons:SfButton
                x:Name="btnLogout"
                Grid.ColumnSpan="2"
                Margin="10,10,10,0"
                Clicked="btnLogout_Clicked"
                CornerRadius="10"
                FontAttributes="Bold"
                FontFamily="{StaticResource SomarSemiBold}"
                FontSize="15"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZLogout}"
                VerticalOptions="End" />
        </StackLayout>
    </Border>
</Mopups:PopupPage>