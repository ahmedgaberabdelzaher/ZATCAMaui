                                            </StackLayout>
                                            <StackLayout IsVisible="{Binding IsVatRegistrationTileVisible}">
                                                <StackLayout Orientation="Horizontal" Spacing="20">
                                                    <Image Source="documents_White.png" Style="{StaticResource SmallIcon}" />
                                                    <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.VatRegistration}" />
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="Vat_Registration_Tapped" />
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                                <BoxView Margin="0,12,0,0" Style="{StaticResource WhiteLineSeperator}" />
                                            </StackLayout>
                                            <StackLayout Orientation="Horizontal" Spacing="20">
                                                <Image Source="ic_menu_Tax_check.png" Style="{StaticResource SmallIcon}" />
                                                <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.DBApplicationStatus}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnApplicationStatus_Tapped" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                            <BoxView Style="{StaticResource WhiteLineSeperator}" />
                                            <StackLayout Orientation="Horizontal" Spacing="20">
                                                <Image Source="menu_return.png" Style="{StaticResource SmallIcon}" />
                                                <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.GeneralServices}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="General_Services_Tapped" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                            <BoxView Style="{StaticResource WhiteLineSeperator}" />
                                            <!--  Subsidy Request Starts  -->
                                            <StackLayout IsVisible="{Binding IsSubsidyTileVisible}" Spacing="20">
                                                <StackLayout Orientation="Horizontal" Spacing="20">
                                                    <Image Source="taxpayer_subsidy.png" Style="{StaticResource SmallIcon}" />
                                                    <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.TaxPayerSubsidyRequest}" />
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TaxPayerSubsidyRequestTapped" />
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                                <BoxView Style="{StaticResource WhiteLineSeperator}" />
                                            </StackLayout>
                                            <!--  Subsidy Request Ends  -->
                                            <!--  Contact Zatca For Audit Case starts  -->
                                            <StackLayout IsVisible="{Binding IsContactZatcaEmpTileVisible}" Spacing="20">
                                                <StackLayout Orientation="Horizontal" Spacing="20">
                                                    <Image Source="taxpayer_subsidy.png" Style="{StaticResource SmallIcon}" />
                                                    <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.ContactZatcaEmp}" />
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="ContactZatcaEmp_Tapped" />
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                                <BoxView IsVisible="{Binding IsContactZatcaEmpTileVisible}" Style="{StaticResource WhiteLineSeperator}" />
                                            </StackLayout>
                                            <!--  Contact Zatca For Audit Case ends  -->
                                            <!--  CR6264 starts  -->

                                            <Grid
                                                ColumnDefinitions="auto,*"
                                                ColumnSpacing="20">
                                                <Image Source="taxpayer_subsidy.png" Style="{StaticResource SmallIcon}" />
                                                <Label
                                                    Grid.Column="1"
                                                    Style="{StaticResource ButtonLabelWhiteBold}"
                                                    Text="{Binding VatProfitGoodsTileTxt}"/>
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ProfitOnGoods_Tapped" />
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                            <BoxView
                                                x:Name="tileUpdatedBoxView"
                                                Style="{StaticResource WhiteLineSeperator}" />
                                            <!--  CR6264 ends  -->
                                            <!--  RateUS  Starts  -->
                                            <StackLayout Spacing="20">
                                                <StackLayout Orientation="Horizontal" Spacing="20">
                                                    <Image Source="RateUS.png" Style="{StaticResource SmallIcon}" />
                                                    <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.RateUs}" />
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding GoToRateUsCommand}" />
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                                <BoxView Style="{StaticResource WhiteLineSeperator}" />
                                            </StackLayout>
                                            <!--  RateUS Ends  -->

                                            <StackLayout Orientation="Horizontal" Spacing="20">
                                                <Image Source="language.png" Style="{StaticResource SmallIcon}" />

                                                <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.ChangeLanguage}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ChangeLanguage_Tapped" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                            <BoxView Style="{StaticResource WhiteLineSeperator}" />



                                            <StackLayout Orientation="Horizontal" Spacing="20">

                                                <Image Source="education.png" Style="{StaticResource SmallIcon}" />
                                                <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.ZZZEducationLink}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEduLinkTapped" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>

                                            <BoxView Style="{StaticResource WhiteLineSeperator}" />


                                            <StackLayout Orientation="Horizontal" Spacing="20">

                                                <Image Source="customerService.png" Style="{StaticResource SmallIcon}" />
                                                <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.ZZZSupport}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSupportTapped" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>

                                            <BoxView Style="{StaticResource WhiteLineSeperator}" />

                                            <StackLayout Orientation="Horizontal" Spacing="20">
                                                <Image Source="log_out" Style="{StaticResource SmallIcon}" />
                                                <Label Style="{StaticResource ButtonLabelWhiteBold}" Text="{x:Static ResourceManager:AppResources.DBLogOut}" />
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="Logout_Tapped" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="0"
                                        Margin="0"
                                        Padding="15,0,15,0"
                                        Spacing="10">


                                        <Label
                                            MaxLines="2"
                                            Style="{StaticResource PageTitleWhite}"
                                            Text="{Binding TaxpayerName}"
                                            VerticalOptions="Center" />
                                        <Label Style="{StaticResource CaptionLabelWhite}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource PageTitleWhite}" Text="{x:Static ResourceManager:AppResources.NDV}" />
                                                    <Span Text="&#160;&#160;" />
                                                    <Span Style="{StaticResource PageTitleWhite}" Text="{Binding AppVersion}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </StackLayout>
                                </Grid>
                            </Grid>
                        </ScrollView>
                    </Border>

                </Grid>

            </Grid>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Nav Menu Starts  -->
            <custom:NavMenu Grid.Row="1" VerticalOptions="EndAndExpand" />

            <!--#region SurveyView {Binding IsShowMsgView}-->
            <Grid
                Grid.Row="0"
                Margin="0,0,0,0"
                IsVisible="{Binding IsShowMsgView}"
                VerticalOptions="FillAndExpand">

                <StackLayout
                    BackgroundColor="Black"
                    Opacity="0.4"
                    VerticalOptions="FillAndExpand" />

                <Border
                    Padding="20,20,20,25"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 15,15,0,0"
                    Style="{StaticResource CommonTopCurves}"
                    VerticalOptions="EndAndExpand">
                    <Grid Margin="0,0,0,0">

                        <!--#region SurveyIntro-->
                        <StackLayout
                            Margin="0"
                            IsVisible="false"
                            VerticalOptions="Center">
                            <StackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding SurveyCurrentStep}"
                                    TargetType="StackLayout"
                                    Value="0">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                            </StackLayout.Triggers>

                            <Image
                                Margin="0,20,0,20"
                                HeightRequest="65"
                                HorizontalOptions="CenterAndExpand"
                                Source="SurveyStart"
                                WidthRequest="65" />

                            <Label
                                HorizontalTextAlignment="Start"
                                Style="{StaticResource BodyLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.SurveyIntroMsg}" />

                            <Grid
                                Margin="10"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">
                                <Border
                                    Grid.Column="0"
                                    Padding="12"
                                    BackgroundColor="#0996D4"
                                    StrokeShape="RoundRectangle 14,14,14,14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SurveyActionCommand}" CommandParameter="1" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.questionnaire}"
                                        TextColor="White" />
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="12"
                                    BackgroundColor="White"
                                    Stroke="#4FBBBD"
                                    StrokeShape="RoundRectangle 14,14,14,14">
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.NDSkip}"
                                        TextColor="#0996D4" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SurveyActionCommand}" CommandParameter="0" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>

                        </StackLayout>
                        <!--#endregion-->

                        <!--#region FstQuestion-->
                        <StackLayout
                            Margin="0,0,0,20"
                            IsVisible="False"
                            VerticalOptions="Center">
                            <StackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding SurveyCurrentStep}"
                                    TargetType="StackLayout"
                                    Value="1">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                            </StackLayout.Triggers>

                            <Border
                                Margin="0"
                                Padding="9"
                                BackgroundColor="White"
                                Stroke="#4FBBBD"
                                StrokeShape="RoundRectangle 14,14,14,14">
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.SurveyQ1}"
                                    TextColor="#0996D4" />
                            </Border>

                            <StackLayout
                                x:Name="menu"
                                BindableLayout.ItemsSource="{Binding ImojiesLst}"
                                HorizontalOptions="CenterAndExpand"
                                Orientation="Horizontal">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout x:Name="Item" Margin="10">
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    BindingContext="{Binding Source={x:Reference menu}, Path=BindingContext}"
                                                    Command="{Binding SlectedImojieCommand}"
                                                    CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                            </StackLayout.GestureRecognizers>
                                            <Image
                                                HeightRequest="36"
                                                Source="{Binding ImojieSource}"
                                                WidthRequest="36" />
                                        </StackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>

                        </StackLayout>
                        <!--#endregion-->

                        <!--#region SecQuestion-->
                        <StackLayout
                            Margin="0"
                            IsVisible="False"
                            Spacing="15"
                            VerticalOptions="Center">
                            <StackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding SurveyCurrentStep}"
                                    TargetType="StackLayout"
                                    Value="2">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                            </StackLayout.Triggers>
                            <Label
                                FontSize="18"
                                HorizontalOptions="StartAndExpand"
                                Text="{Binding QuestionTxt}"
                                TextColor="{StaticResource Primary}" />
                            <Border
                                Padding="9"
                                BackgroundColor="White"
                                HeightRequest="100"
                                Stroke="#4FBBBD"
                                StrokeShape="RoundRectangle 14,14,14,14">
                                <custom:GAZTBorderlessEditor Placeholder="اكتب النص هنا " Text="{Binding SQAnswer}" />
                            </Border>
                            <Frame
                                Grid.Column="0"
                                Padding="12"
                                BackgroundColor="#0996D4"
                                CornerRadius="14">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddSurveyCommand}" CommandParameter="0" />
                                </Frame.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Send}"
                                    TextColor="White" />
                            </Frame>
                        </StackLayout>
                        <!--#endregion-->

                        <!--#endregion SurveyEnd-->
                        <StackLayout
                            Margin="0"
                            IsVisible="false"
                            VerticalOptions="CenterAndExpand">
                            <StackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding SurveyCurrentStep}"
                                    TargetType="StackLayout"
                                    Value="3">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                            </StackLayout.Triggers>
                            <Image
                                Margin="0,20,0,20"
                                HeightRequest="47"
                                HorizontalOptions="CenterAndExpand"
                                Source="SurveyEnd"
                                WidthRequest="45" />
                            <Label
                                FontSize="25"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.ThankYou}"
                                TextColor="{StaticResource Primary}" />
                            <Label
                                FontSize="16"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.DearCustomer}"
                                TextColor="#0996D4" />
                            <Label
                                FontSize="16"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.SurveyThankMsg}"
                                TextColor="{StaticResource Primary}" />
                            <Border
                                Grid.Column="0"
                                Padding="12"
                                BackgroundColor="#0996D4"
                                StrokeShape="RoundRectangle 14,14,14,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SurveyNextCommand}" CommandParameter="4" />
                                </Border.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Form5Finish}"
                                    TextColor="White" />
                            </Border>
                        </StackLayout>
                        <!--#endregion-->

                    </Grid>
                </Border>

            </Grid>
            <!--#endregion-->

        </Grid>
    </ContentPage.Content>
</ContentPage>
