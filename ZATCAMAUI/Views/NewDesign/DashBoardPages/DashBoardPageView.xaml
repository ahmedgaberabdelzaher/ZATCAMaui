<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.GAZTNewDesignDashBoardPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="True"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding CheckSurveyCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegetiveToPositiveValueConverter x:Key="negetiveToPositiveValueConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <chart:ColumnSeries x:Key="Colors">
                        <chart:ColumnSeries.PaletteBrushes>
                            <Color>YellowGreen</Color>
                            <Color>Blue</Color>
                            <Color>Aqua</Color>
                        </chart:ColumnSeries.PaletteBrushes>
                    </chart:ColumnSeries>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Color x:Key="ShadowLvl0">#EFEFEF</Color>
                    <Style x:Key="GreyBorderFrameWithShadow" TargetType="Border">
                        <Setter Property="BackgroundColor" Value="White" />
                        <Setter Property="StrokeShape" Value="RoundRectangle 14,14,14,14" />
                        <!--<Setter Property="HasShadow" Value="False" />-->
                        <Setter Property="StrokeThickness" Value="1" />
                        <Setter Property="Stroke" Value="{StaticResource NeutralLightGrey}" />
                        <!--<Setter Property="ShadowColor" Value="{StaticResource ShadowLvl0}" />-->
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Content>
        <Grid>
            <Grid
                Margin="0,0,0,-16"
                BackgroundColor="Transparent"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Image
                    x:Name="BGImageLogin"
                    Margin="0,-50,0,0"
                    Aspect="AspectFill"
                    BackgroundColor="Transparent"
                    Source="partials_background.png" />

                <Grid
                    Grid.Row="0"
                    Margin="0"
                    Padding="0,0,0,0"
                    IsVisible="{Binding HomeViewVisible}"
                    RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        CornerRadius="12,12,0,0"
                        VerticalOptions="FillAndExpand">
                        <ScrollView Scrolled="ScrollView_Scrolled" VerticalScrollBarVisibility="Never">
                            <StackLayout Spacing="0">

                                <StackLayout
                                    Padding="15,0,15,8"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="Fill">
                                    <custom:CustomLabel
                                        Margin="0,0,0,10"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        MaxLines="2"
                                        Style="{StaticResource PageTitleWhite}"
                                        StyleId="SingleLabel"
                                        Text="{Binding TaxpayerName}"
                                        VerticalOptions="Center" />

                                    <StackLayout IsVisible="{Binding IsMyObligationsClear}">
                                        <StackLayout Orientation="Horizontal">
                                            <Image
                                                Margin="0,0,5,0"
                                                HeightRequest="15"
                                                Source="ic_maincheck"
                                                WidthRequest="15" />
                                            <custom:CustomLabel FontSize="15" Style="{StaticResource CaptionLabelWhite}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{x:Static ResourceManager:AppResources.DashBoardWellDone}" TextColor="{StaticResource SuccessColor}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.DashBoardNoTaxObligationsPending}" />
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                        <custom:CustomLabel
                                            Margin="0,-10,0,0"
                                            Padding="0"
                                            FontSize="20">

                                            <custom:CustomLabel.FormattedText>

                                                <FormattedString>
                                                    <Span
                                                        FontSize="28"
                                                        Style="{StaticResource ButtonLabelWhiteBold}"
                                                        Text="0.00" />
                                                    <Span Text=" " />
                                                    <Span
                                                        FontSize="15"
                                                        Style="{StaticResource CaptionLabelWhite}"
                                                        Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </StackLayout>

                                    <Border
                                        x:Name="btn_frameToolbar"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        IsVisible="{Binding IsBodyMyTaxVisible}"
                                        StrokeThickness="0"
                                        VerticalOptions="CenterAndExpand">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10,10,10,10" />
                                        </Border.StrokeShape>
                                        <Grid HorizontalOptions="StartAndExpand">

                                            <Frame
                                                BackgroundColor="White"
                                                CornerRadius="15"
                                                Opacity="0.1" />
                                            <StackLayout
                                                Padding="12,5,12,5"
                                                Orientation="Vertical"
                                                Spacing="0">

                                                <Label
                                                    Margin="0"
                                                    Padding="0"
                                                    FontSize="11"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelWhite}"
                                                    Text="{x:Static ResourceManager:AppResources.DashBoardNewMyTaxObligations}" />

                                                <custom:CustomLabel
                                                    Margin="0,-8,0,0"
                                                    Padding="0"
                                                    FontSize="20">

                                                    <custom:CustomLabel.FormattedText>

                                                        <FormattedString>
                                                            <Span
                                                                FontSize="28"
                                                                Style="{StaticResource ButtonLabelWhiteBold}"
                                                                Text="{Binding MyObligationAmountCommas}" />
                                                            <Span Text=" " />
                                                            <Span
                                                                FontSize="15"
                                                                Style="{StaticResource CaptionLabelWhite}"
                                                                Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                            </StackLayout>

                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_ToolbarMyTax" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </StackLayout>
                                <Grid
                                    Padding="15,16,15,8"
                                    BackgroundColor="{StaticResource NewDullOrangeColor}"
                                    ColumnSpacing="16"
                                    IsVisible="{Binding IsEstablishmentRegistrationTileVisible}"
                                    RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Source="ic_White_info.png" />
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDRegisterZAKAT}"
                                        TextColor="White"
                                        VerticalOptions="StartAndExpand" />

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalOptions="EndAndExpand"
                                        Source="WhiteCircle_arrow_right.png"
                                        Style="{DynamicResource BackButtonArrow}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnZakatNowTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <custom:CustomLabel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        LineSpacing="0.7"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDRegZakatin5mins}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <yummy:PancakeView
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Margin="-15,10,-15,-8"
                                        BackgroundColor="White"
                                        CornerRadius="12,12,0,0"
                                        HeightRequest="10" />
                                </Grid>

                                <StackLayout BackgroundColor="White" VerticalOptions="FillAndExpand">
                                    <!--  Pending Bills  -->
                                    <StackLayout IsVisible="{Binding IsPendingBillsVisible}">
                                        <yummy:PancakeView Padding="15,0,15,0" BackgroundColor="White">
                                            <StackLayout Margin="0,15,0,15" VerticalOptions="FillAndExpand">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>



                                                    <custom:CustomLabel
                                                        Grid.Column="0"
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.DashBoardPendingBills}"
                                                        VerticalOptions="Center" />

                                                    <StackLayout
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        IsVisible="{Binding IsBillsTotalAmountEN}"
                                                        Orientation="Horizontal">

                                                        <custom:CustomLabel
                                                            Grid.Column="0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            VerticalOptions="Center">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding BillCount}" />
                                                                    <Span Style="{StaticResource CaptionLabelBlack}" Text="&#160;" />
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Image
                                                            Source="circle_arrow_right.png"
                                                            Style="{DynamicResource BackButtonArrow}"
                                                            VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="TappedOnMyBills" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        IsVisible="{Binding IsBillsTotalAmountAR}"
                                                        Orientation="Horizontal">

                                                        <custom:CustomLabel
                                                            Grid.Column="0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            VerticalOptions="Center">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" />
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="&#160;" />
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding BillCount}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Image
                                                            Source="circle_arrow_right.png"
                                                            Style="{DynamicResource BackButtonArrow}"
                                                            VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="TappedOnMyBills" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </StackLayout>

                                                </Grid>

                                                <cards:SfCardView
                                                    Margin="0,5,0,0"
                                                    BackgroundColor="White"
                                                    CornerRadius="10">
                                                    <StackLayout>

                                                        <listView:SfListView
                                                            AutoFitMode="Height"
                                                            HorizontalOptions="FillAndExpand"
                                                            ItemsSource="{Binding PendingBills}"
                                                            MinimumHeightRequest="{Binding PendingBillsListHeight}"
                                                            SelectionBackground="Transparent"
                                                            VerticalOptions="Center">
                                                            <listView:SfListView.Behaviors>
                                                                <behaviors:ListViewBehavior />
                                                            </listView:SfListView.Behaviors>
                                                            <listView:SfListView.ItemTemplate>
                                                                <DataTemplate>

                                                                    <cards:SfCardView
                                                                        Margin="2"
                                                                        BorderColor="{StaticResource NeutralLightGrey}"
                                                                        BorderWidth="1"
                                                                        CornerRadius="16"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        VerticalOptions="FillAndExpand">

                                                                        <StackLayout
                                                                            Margin="12"
                                                                            Orientation="Vertical"
                                                                            Spacing="2">
                                                                            <Grid HorizontalOptions="FillAndExpand">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="50*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackLayout
                                                                                    Grid.Row="0"
                                                                                    Grid.Column="0"
                                                                                    Orientation="Vertical">

                                                                                    <custom:CustomLabel
                                                                                        Margin="0,-5,0,-5"
                                                                                        Style="{StaticResource BodyLabelBlackMedium}"
                                                                                        Text="{Binding Amount, Converter={StaticResource commaSeparatorConverter}}">

                                                                                        <custom:CustomLabel.FormattedText>

                                                                                            <FormattedString>
                                                                                                <Span Text="{Binding Amount, Converter={StaticResource commaSeparatorConverter}}" />
                                                                                                <Span Text=" " />
                                                                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>

                                                                                    </custom:CustomLabel>

                                                                                    <custom:CustomLabel
                                                                                        Margin="0,-5,0,-5"
                                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                                        Text="{Binding Abtypt}"
                                                                                        VerticalOptions="End" />

                                                                                </StackLayout>

                                                                                <StackLayout
                                                                                    Grid.Row="0"
                                                                                    Grid.Column="1"
                                                                                    Orientation="Vertical">

                                                                                    <Border
                                                                                        Grid.Row="0"
                                                                                        Grid.Column="1"
                                                                                        Padding="12,2,12,2"
                                                                                        HeightRequest="32"
                                                                                        HorizontalOptions="EndAndExpand"
                                                                                        Stroke="{StaticResource SecondaryNew}"
                                                                                        StrokeThickness="1"
                                                                                        VerticalOptions="CenterAndExpand">
                                                                                        <Border.StrokeShape>
                                                                                            <RoundRectangle CornerRadius="20,20,20,20" />
                                                                                        </Border.StrokeShape>
                                                                                        <StackLayout
                                                                                            BindingContext="{Binding .}"
                                                                                            HorizontalOptions="CenterAndExpand"
                                                                                            Orientation="Horizontal">
                                                                                            <Image
                                                                                                Margin="0,0,5,0"
                                                                                                HeightRequest="16"
                                                                                                Source="ic_iconpay_white"
                                                                                                VerticalOptions="CenterAndExpand"
                                                                                                WidthRequest="16" />
                                                                                            <custom:CustomLabel
                                                                                                FontFamily="{StaticResource SomarRegular}"
                                                                                                FontSize="11"
                                                                                                Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                                                                                                TextColor="{StaticResource SecondaryNew}"
                                                                                                VerticalOptions="CenterAndExpand" />

                                                                                        </StackLayout>

                                                                                        <Border.GestureRecognizers>
                                                                                            <TapGestureRecognizer Tapped="BillsPayNowTapped" />
                                                                                        </Border.GestureRecognizers>
                                                                                    </Border>

                                                                                    <custom:CustomLabel
                                                                                        Margin="0,0,0,0"
                                                                                        HorizontalOptions="EndAndExpand"
                                                                                        Style="{StaticResource CaptionLabelGrey}">

                                                                                        <custom:CustomLabel.FormattedText>

                                                                                            <FormattedString>
                                                                                                <Span Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                                                                                                <Span Text=": " />
                                                                                                <Span Text="{Binding FormatedDuedate}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>
                                                                                    </custom:CustomLabel>

                                                                                </StackLayout>

                                                                            </Grid>

                                                                        </StackLayout>
                                                                    </cards:SfCardView>

                                                                </DataTemplate>
                                                            </listView:SfListView.ItemTemplate>

                                                        </listView:SfListView>

                                                    </StackLayout>
                                                </cards:SfCardView>


                                            </StackLayout>
                                        </yummy:PancakeView>
                                    </StackLayout>


                                    <!--  Next Commitments  -->
                                    <StackLayout>
                                        <StackLayout BackgroundColor="LightGray">
                                            <yummy:PancakeView BackgroundColor="White">
                                                <StackLayout Margin="15,15,15,0" VerticalOptions="Start">

                                                    <custom:CustomLabel
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{Binding NextCommitmentsString}"
                                                        VerticalOptions="Center" />
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="30" />
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelBlackMedium}"
                                                            Text="{Binding SelectedCommitmentFilterValue}" />


                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Margin="5,5,5,5"
                                                            HorizontalOptions="Start"
                                                            Source="arrowDropdown"
                                                            VerticalOptions="Start" />
                                                        <custom:CustomButton
                                                            x:Name="btn1"
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            BackgroundColor="Transparent"
                                                            Clicked="btnCommitmentsPickerClicked" />

                                                        <syncfusion:SfPicker
                                                            x:Name="CommitmentsPicker"
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="10,0,10,0"
                                                            BackgroundColor="White"
                                                            FlowDirection="RightToLeft"
                                                            ItemHeight="40"
                                                            Mode="Dialog"
                                                            SelectionChanged="CommitmentsPicker_SelectionChanged">

                                                            <syncfusion:SfPicker.TextStyle>
                                                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralGreay}" />
                                                            </syncfusion:SfPicker.TextStyle>

                                                            <syncfusion:SfPicker.Columns>
                                                                <syncfusion:PickerColumn Width="300" ItemsSource="{Binding CommitmentsListFilter}" />
                                                            </syncfusion:SfPicker.Columns>

                                                            <syncfusion:SfPicker.SelectedTextStyle>
                                                                <syncfusion:PickerTextStyle
                                                                    FontAttributes="Bold"
                                                                    FontSize="15"
                                                                    TextColor="{StaticResource NeutralBlack}" />
                                                            </syncfusion:SfPicker.SelectedTextStyle>

                                                            <syncfusion:SfPicker.ColumnHeaderView>
                                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                                            </syncfusion:SfPicker.ColumnHeaderView>

                                                            <syncfusion:SfPicker.HeaderView>

                                                                <syncfusion:PickerHeaderView
                                                                    Height="55"
                                                                    Background="{StaticResource Primary}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                                                    <syncfusion:PickerHeaderView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                                    </syncfusion:PickerHeaderView.TextStyle>
                                                                </syncfusion:PickerHeaderView>

                                                            </syncfusion:SfPicker.HeaderView>

                                                            <syncfusion:SfPicker.FooterView>

                                                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                                    <syncfusion:PickerFooterView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                    </syncfusion:PickerFooterView.TextStyle>

                                                                </syncfusion:PickerFooterView>

                                                            </syncfusion:SfPicker.FooterView>

                                                            <syncfusion:SfPicker.Behaviors>
                                                                <behaviors:SfPickerBehavior />
                                                            </syncfusion:SfPicker.Behaviors>

                                                        </syncfusion:SfPicker>
                                                    </Grid>

                                                    <Label
                                                        FlowDirection="RightToLeft"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        IsVisible="{Binding SetNoCommitmentsAvailableLabelVisibility}"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.NoAppointmentText}"
                                                        VerticalOptions="Center" />

                                                    <CollectionView
                                                        x:Name="CollectionView_Commitment"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="80"
                                                        HorizontalOptions="FillAndExpand"
                                                        HorizontalScrollBarVisibility="Never"
                                                        IsVisible="{Binding SetMyCommitmentsCollectionVisibility}"
                                                        ItemsLayout="HorizontalList"
                                                        ItemsSource="{Binding BillsAndReturnsCommitments}"
                                                        VerticalOptions="FillAndExpand">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackLayout Margin="8" Orientation="Horizontal">
                                                                    <cards:SfCardView
                                                                        Margin="0,0,0,5"
                                                                        BorderColor="{StaticResource NeutralLightGrey}"
                                                                        BorderWidth="1"
                                                                        CornerRadius="14">
                                                                        <StackLayout Orientation="Horizontal">
                                                                            <cards:SfCardView
                                                                                Margin="{OnPlatform iOS='1',
                                                                                                    Android='0,0,0,-5'}"
                                                                                CornerRadius="14"
                                                                                HeightRequest="80"
                                                                                IsVisible="{Binding IsUnSubmittedReturn}"
                                                                                WidthRequest="80">
                                                                                <StackLayout
                                                                                    HorizontalOptions="Center"
                                                                                    Orientation="Vertical"
                                                                                    Spacing="0"
                                                                                    VerticalOptions="Center">
                                                                                    <custom:CustomLabel
                                                                                        Margin="0,0,0,-2"
                                                                                        HorizontalTextAlignment="Center"
                                                                                        VerticalOptions="End"
                                                                                        VerticalTextAlignment="Center">
                                                                                        <custom:CustomLabel.FormattedText>
                                                                                            <FormattedString>
                                                                                                <Span Style="{StaticResource ValueLabelWhiteMedium}" Text="{Binding Day}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>
                                                                                    </custom:CustomLabel>
                                                                                    <custom:CustomLabel
                                                                                        Margin="0,-2,0,0"
                                                                                        HorizontalTextAlignment="Center"
                                                                                        VerticalOptions="Start"
                                                                                        VerticalTextAlignment="Center">
                                                                                        <custom:CustomLabel.FormattedText>
                                                                                            <FormattedString>
                                                                                                <Span Style="{StaticResource CaptionLabelWhite}" Text="{Binding Month}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>
                                                                                    </custom:CustomLabel>
                                                                                </StackLayout>
                                                                                <cards:SfCardView.Triggers>
                                                                                    <Trigger TargetType="cards:SfCardView" Property="IsVisible" Value="True">
                                                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                                                    </Trigger>
                                                                                </cards:SfCardView.Triggers>
                                                                            </cards:SfCardView>

                                                                            <cards:SfCardView
                                                                                Margin="{OnPlatform iOS='1',
                                                                                                    Android='0,0,0,-5'}"
                                                                                BackgroundColor="Red"
                                                                                CornerRadius="14"
                                                                                HeightRequest="80"
                                                                                IsVisible="{Binding IsPaymentOverdue}"
                                                                                WidthRequest="80">
                                                                                <StackLayout
                                                                                    HorizontalOptions="Center"
                                                                                    Orientation="Vertical"
                                                                                    Spacing="0"
                                                                                    VerticalOptions="Center">
                                                                                    <custom:CustomLabel
                                                                                        Margin="3,0,0,-2"
                                                                                        HorizontalTextAlignment="Center"
                                                                                        VerticalOptions="End"
                                                                                        VerticalTextAlignment="Center">
                                                                                        <custom:CustomLabel.FormattedText>
                                                                                            <FormattedString>
                                                                                                <Span Style="{StaticResource ValueLabelWhiteMedium}" Text="{Binding Day}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>
                                                                                    </custom:CustomLabel>
                                                                                    <custom:CustomLabel
                                                                                        Margin="3,-2,0,0"
