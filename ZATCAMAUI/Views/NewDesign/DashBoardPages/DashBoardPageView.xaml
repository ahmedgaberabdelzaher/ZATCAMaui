<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.GAZTNewDesignDashBoardPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="True"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding CheckSurveyCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid Margin="0,0,0,50" RowDefinitions="*,auto,auto">

                <Image
                    x:Name="BGImageLogin"
                    Margin="0,0,0,0"
                    Aspect="AspectFill"
                    BackgroundColor="Transparent"
                    Source="partials_background.png" />

                <Grid IsVisible="{Binding HomeViewVisible}" RowDefinitions="auto,*">

                    <!--  Header  -->
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,0"
                        HorizontalOptions="FillAndExpand">

                        <Grid ColumnDefinitions="*,40">

                            <StackLayout>
                                <Image
                                    HeightRequest="40"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding IsMenuLogoVisible}"
                                    Source="ic_Gazt.png"
                                    VerticalOptions="Start"
                                    WidthRequest="40" />
                            </StackLayout>

                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="0,-10,0,0"
                                HorizontalOptions="CenterAndExpand">
                                <Border
                                    x:Name="frameToolbar"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalOptions="CenterAndExpand"
                                    IsVisible="{Binding IsToolbarTaxVisible}"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="0"
                                    VerticalOptions="CenterAndExpand">

                                    <Grid HorizontalOptions="StartAndExpand">
                                        <Border
                                            BackgroundColor="White"
                                            Opacity="0.1"
                                            StrokeShape="RoundRectangle 14,14,14,14" />

                                        <StackLayout Padding="10,3" Spacing="0">
                                            <Label
                                                Margin="0"
                                                Padding="0"
                                                FontSize="11"
                                                HorizontalOptions="CenterAndExpand"
                                                Style="{StaticResource CaptionLabelWhite}"
                                                Text="{x:Static ResourceManager:AppResources.DashBoardNewMyTaxObligations}" />
                                            <Label
                                                Margin="0,-8,0,0"
                                                Padding="0"
                                                FontSize="20">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span
                                                            FontSize="20"
                                                            Style="{StaticResource ButtonLabelWhiteBold}"
                                                            Text="{Binding MyObligationAmountCommas}" />
                                                        <Span Text=" " />
                                                        <Span
                                                            FontSize="15"
                                                            Style="{StaticResource CaptionLabelWhite}"
                                                            Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                        </StackLayout>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_ToolbarMyTax" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </StackLayout>

                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    Source="message"
                                    VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_Inbox" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                        </Grid>

                    </StackLayout>

                    <!--  Dashboard  -->
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 12,12,0,0"
                        VerticalOptions="FillAndExpand">

                        <ScrollView Scrolled="ScrollView_Scrolled" Margin="0,0,0,10" VerticalScrollBarVisibility="Never">

                            <StackLayout Spacing="0">

                                <StackLayout
                                    Padding="15,0,15,8"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="Fill">
                                    <Label
                                        Margin="0,0,0,10"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        MaxLines="2"
                                        Style="{StaticResource PageTitleWhite}"
                                        StyleId="SingleLabel"
                                        Text="{Binding TaxpayerName}"
                                        VerticalOptions="Center" />

                                    <StackLayout IsVisible="{Binding IsMyObligationsClear}">
                                        <StackLayout Orientation="Horizontal">
                                            <Image
                                                Margin="0,0,5,0"
                                                HeightRequest="15"
                                                Source="ic_maincheck"
                                                WidthRequest="15" />
                                            <Label FontSize="15" Style="{StaticResource CaptionLabelWhite}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span
                                                            FontSize="15"
                                                            Style="{StaticResource CaptionLabelWhite}"
                                                            Text="{x:Static ResourceManager:AppResources.DashBoardWellDone}"
                                                            TextColor="{StaticResource SuccessColor}" />
                                                        <Span Text=" " />
                                                        <Span
                                                            FontSize="15"
                                                            Style="{StaticResource CaptionLabelWhite}"
                                                            Text="{x:Static ResourceManager:AppResources.DashBoardNoTaxObligationsPending}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <Label
                                            Margin="0,-10,0,0"
                                            Padding="0"
                                            FontSize="20">

                                            <Label.FormattedText>

                                                <FormattedString>
                                                    <Span
                                                        FontSize="28"
                                                        Style="{StaticResource ButtonLabelWhiteBold}"
                                                        Text="0.00" />
                                                    <Span Text=" " />
                                                    <Span
                                                        FontSize="15"
                                                        Style="{StaticResource CaptionLabelWhite}"
                                                        Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                    </StackLayout>

                                    <Border
                                        x:Name="btn_frameToolbar"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        IsVisible="{Binding IsBodyMyTaxVisible}"
                                        StrokeThickness="0"
                                        VerticalOptions="CenterAndExpand">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10,10,10,10" />
                                        </Border.StrokeShape>
                                        <Grid HorizontalOptions="StartAndExpand">

                                            <Border
                                                BackgroundColor="White"
                                                Opacity="0.1"
                                                StrokeShape="RoundRectangle 14,14,14,14" />
                                            <StackLayout Padding="12,5,12,5" Spacing="0">

                                                <Label
                                                    Margin="0"
                                                    Padding="0"
                                                    FontSize="11"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelWhite}"
                                                    Text="{x:Static ResourceManager:AppResources.DashBoardNewMyTaxObligations}" />

                                                <Label
                                                    Margin="0,-8,0,0"
                                                    Padding="0"
                                                    FontSize="20">

                                                    <Label.FormattedText>

                                                        <FormattedString>
                                                            <Span
                                                                FontSize="28"
                                                                Style="{StaticResource ButtonLabelWhiteBold}"
                                                                Text="{Binding MyObligationAmountCommas}" />
                                                            <Span Text=" " />
                                                            <Span
                                                                FontSize="15"
                                                                Style="{StaticResource CaptionLabelWhite}"
                                                                Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                            </StackLayout>

                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_ToolbarMyTax" />
                                        </Border.GestureRecognizers>
                                    </Border>

                                </StackLayout>

                                <Grid
                                    Padding="15,16,15,8"
                                    BackgroundColor="{StaticResource NewDullOrangeColor}"
                                    ColumnDefinitions="auto,*,auto"
                                    ColumnSpacing="16"
                                    IsVisible="{Binding IsEstablishmentRegistrationTileVisible}"
                                    RowDefinitions="auto,auto,auto"
                                    RowSpacing="4">
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Source="ic_White_info.png" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDRegisterZAKAT}"
                                        TextColor="White"
                                        VerticalOptions="StartAndExpand" />

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalOptions="EndAndExpand"
                                        Source="WhiteCircle_arrow_right.png">
                                          <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding AppDirection}" Value="RightToLeft">
                                                        <Setter Property="Rotation" Value="180"></Setter>
                                                    </DataTrigger>

                                                </Image.Triggers>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnZakatNowTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDRegZakatin5mins}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Grid>

                                <StackLayout BackgroundColor="White" VerticalOptions="FillAndExpand">

                                    <!--  Pending Bills  -->
                                    <StackLayout
                                        Padding="10"
                                        IsVisible="{Binding IsPendingBillsVisible}"
                                        Spacing="10">

                                        <Grid ColumnDefinitions="*,*">

                                            <Label
                                                Grid.Column="0"
                                                Style="{StaticResource SectionTitleBlack}"
                                                Text="{x:Static ResourceManager:AppResources.DashBoardPendingBills}"
                                                VerticalOptions="Center" />

                                            <StackLayout
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                IsVisible="{Binding IsBillsTotalAmountEN}"
                                                Orientation="Horizontal"
                                                Spacing="10">

                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding BillCount}" />
                                                            <Span Style="{StaticResource CaptionLabelBlack}" Text="&#160;" />
                                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Image Source="circle_arrow_right.png" 
                                                       VerticalOptions="Center">
                                                      <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding AppDirection}" Value="RightToLeft">
                                                        <Setter Property="Rotation" Value="180"></Setter>
                                                    </DataTrigger>

                                                </Image.Triggers>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TappedOnMyBills" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                            </StackLayout>

                                            <StackLayout
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                IsVisible="{Binding IsBillsTotalAmountAR}"
                                                Orientation="Horizontal"
                                                Spacing="10">

                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    VerticalOptions="Center">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" />
                                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="&#160;" />
                                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding BillCount}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Image Source="circle_arrow_right.png" VerticalOptions="Center">
                                                    <Image.Triggers>
                                                        <DataTrigger TargetType="Image" Binding="{Binding AppDirection}" Value="RightToLeft">
                                                            <Setter Property="Rotation" Value="180"></Setter>
                                                        </DataTrigger>

                                                    </Image.Triggers>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TappedOnMyBills" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                            </StackLayout>

                                        </Grid>

                                        <CollectionView
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="FillAndExpand"
                                            ItemsSource="{Binding PendingBills}"
                                            MinimumHeightRequest="{Binding PendingBillsListHeight}"
                                            VerticalOptions="Center"
                                            VerticalScrollBarVisibility="Never">

                                            <CollectionView.ItemsLayout>
                                                <GridItemsLayout VerticalItemSpacing="5" Orientation="Vertical"/>
                                            </CollectionView.ItemsLayout>

                                            <CollectionView.ItemTemplate>

                                                <DataTemplate>

                                                    <cards:SfCardView
                                                        Padding="5"
                                                        BackgroundColor="Transparent"
                                                        BorderColor="{StaticResource NeutralLightGrey}"
                                                        BorderWidth="1"
                                                        CornerRadius="16"
                                                        HorizontalOptions="FillAndExpand"
                                                        VerticalOptions="FillAndExpand">

                                                        <StackLayout Margin="12">

                                                            <Grid ColumnDefinitions="*,*" HorizontalOptions="FillAndExpand">

                                                                <StackLayout Spacing="5">

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        Style="{StaticResource BodyLabelBlackMedium}"
                                                                        Text="{Binding amount, Converter={StaticResource commaSeparatorConverter}}">

                                                                        <Label.FormattedText>

                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{Binding amount, Converter={StaticResource commaSeparatorConverter}}" />
                                                                                <Span Text=" " />
                                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>

                                                                    </Label>

                                                                    <Label
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{Binding revenueTaxType}"
                                                                        VerticalOptions="End" />

                                                                </StackLayout>

                                                                <StackLayout Grid.Column="1" Spacing="5">

                                                                    <Border
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        Padding="12,2,12,2"
                                                                        HeightRequest="32"
                                                                        HorizontalOptions="EndAndExpand"
                                                                        Stroke="{StaticResource SecondaryNew}"
                                                                        StrokeThickness="1"
                                                                        VerticalOptions="CenterAndExpand">
                                                                        <Border.StrokeShape>
                                                                            <RoundRectangle CornerRadius="20,20,20,20" />
                                                                        </Border.StrokeShape>
                                                                        <StackLayout
                                                                            BindingContext="{Binding .}"
                                                                            HorizontalOptions="CenterAndExpand"
                                                                            Orientation="Horizontal">
                                                                            <Image
                                                                                Margin="0,0,5,0"
                                                                                HeightRequest="16"
                                                                                Source="ic_iconpay_white"
                                                                                VerticalOptions="CenterAndExpand"
                                                                                WidthRequest="16" />
                                                                            <Label
                                                                                FontFamily="{StaticResource SomarRegular}"
                                                                                FontSize="11"
                                                                                Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                                                                                TextColor="{StaticResource SecondaryNew}"
                                                                                VerticalOptions="CenterAndExpand" />

                                                                        </StackLayout>

                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="BillsPayNowTapped" />
                                                                        </Border.GestureRecognizers>
                                                                    </Border>

                                                                    <Label
                                                                        Margin="0,0,0,0"
                                                                        HorizontalOptions="EndAndExpand"
                                                                        Style="{StaticResource CaptionLabelGrey}">

                                                                        <Label.FormattedText>

                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                                                                                <Span Text=": " />
                                                                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding FormatedDuedate}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>

                                                                </StackLayout>

                                                            </Grid>

                                                        </StackLayout>

                                                    </cards:SfCardView>

                                                </DataTemplate>

                                            </CollectionView.ItemTemplate>

                                        </CollectionView>

                                    </StackLayout>


                                    <!--  Next Commitments  -->
                                    <StackLayout Margin="15" VerticalOptions="Start">

                                        <StackLayout>

                                            <Label
                                                Style="{StaticResource SectionTitleBlack}"
                                                Text="{Binding NextCommitmentsString}"
                                                VerticalOptions="Center" />

                                            <Grid ColumnDefinitions="auto,30" RowDefinitions="auto">

                                                <Label Style="{StaticResource ValueLabelBlackMedium}" Text="{Binding SelectedCommitmentFilterValue}" />

                                                <Image
                                                    Grid.Column="1"
                                                    Margin="5,5,5,5"
                                                    HorizontalOptions="Start"
                                                    Source="arrowDropdown"
                                                    VerticalOptions="Start" />

                                                <custom:CustomSfPicker
                                                    x:Name="CommitmentsPicker"
                                                    Margin="10,0"
                                                    BackgroundColor="Transparent"
                                                    ItemHeight="40"
                                                    Mode="Dialog"
                                                    SelectionChanged="CommitmentsPicker_SelectionChanged">

                                                    <custom:CustomSfPicker.TextStyle>
                                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralGreay}" />
                                                    </custom:CustomSfPicker.TextStyle>

                                                    <custom:CustomSfPicker.Columns>
                                                        <syncfusion:PickerColumn
                                                            Width="300"
                                                            ItemsSource="{Binding CommitmentsListFilter}"
                                                            SelectedIndex="0" />
                                                    </custom:CustomSfPicker.Columns>

                                                    <custom:CustomSfPicker.SelectedTextStyle>
                                                        <syncfusion:PickerTextStyle
                                                            FontAttributes="Bold"
                                                            FontSize="15"
                                                            TextColor="{StaticResource NeutralBlack}" />
                                                    </custom:CustomSfPicker.SelectedTextStyle>

                                                    <custom:CustomSfPicker.SelectionView>
                                                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />

                                                    </custom:CustomSfPicker.SelectionView>

                                                    <custom:CustomSfPicker.HeaderView>

                                                        <syncfusion:PickerHeaderView
                                                            Height="55"
                                                            Background="{StaticResource Primary}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                                            <syncfusion:PickerHeaderView.TextStyle>
                                                                <syncfusion:PickerTextStyle TextColor="White" />
                                                            </syncfusion:PickerHeaderView.TextStyle>
                                                        </syncfusion:PickerHeaderView>

                                                    </custom:CustomSfPicker.HeaderView>

                                                    <custom:CustomSfPicker.FooterView>

                                                        <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                                            <syncfusion:PickerFooterView.TextStyle>
                                                                <syncfusion:PickerTextStyle TextColor="White" />
                                                            </syncfusion:PickerFooterView.TextStyle>

                                                        </syncfusion:PickerFooterView>

                                                    </custom:CustomSfPicker.FooterView>


                                                </custom:CustomSfPicker>

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="btnCommitmentsPickerClicked" />

                                                </Grid.GestureRecognizers>

                                            </Grid>

                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsVisible="{Binding SetNoCommitmentsAvailableLabelVisibility}"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.NoAppointmentText}"
                                                VerticalOptions="Center" />

                                            <CollectionView
                                                x:Name="CollectionView_Commitment"
                                                BackgroundColor="Transparent"
                                                HeightRequest="80"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalScrollBarVisibility="Never"
                                                IsVisible="{Binding SetMyCommitmentsCollectionVisibility}"
                                                ItemSizingStrategy="MeasureAllItems"
                                                ItemsSource="{Binding BillsAndReturnsCommitments}"
                                                VerticalOptions="FillAndExpand">

                                                <CollectionView.ItemsLayout>
                                                    <GridItemsLayout HorizontalItemSpacing="10" Orientation="Horizontal" />
                                                </CollectionView.ItemsLayout>

                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>

                                                        <StackLayout Orientation="Horizontal" WidthRequest="350">

                                                            <cards:SfCardView
                                                                BackgroundColor="Transparent"
                                                                BorderColor="{StaticResource NeutralLightGrey}"
                                                                BorderWidth="1"
                                                                CornerRadius="14"
                                                                HorizontalOptions="FillAndExpand">
                                                                <StackLayout Orientation="Horizontal">

                                                                    <cards:SfCardView
                                                                        BackgroundColor="Transparent"
                                                                        CornerRadius="14"
                                                                        HeightRequest="80"
                                                                        IsVisible="{Binding IsUnSubmittedReturn}"
                                                                        WidthRequest="80">
                                                                        <StackLayout
                                                                            HorizontalOptions="Center"
                                                                            Spacing="0"
                                                                            VerticalOptions="Center">
                                                                            <Label
                                                                                HorizontalTextAlignment="Center"
                                                                                VerticalOptions="End"
                                                                                VerticalTextAlignment="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Style="{StaticResource ValueLabelWhiteMedium}" Text="{Binding Day}" />
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                            <Label
                                                                                HorizontalTextAlignment="Center"
                                                                                VerticalOptions="Start"
                                                                                VerticalTextAlignment="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Style="{StaticResource CaptionLabelWhite}" Text="{Binding Month}" />
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                        </StackLayout>
                                                                        <cards:SfCardView.Triggers>
                                                                            <Trigger TargetType="cards:SfCardView" Property="IsVisible" Value="True">
                                                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                                            </Trigger>
                                                                        </cards:SfCardView.Triggers>
                                                                    </cards:SfCardView>

                                                                    <cards:SfCardView
                                                                        BackgroundColor="Transparent"
                                                                        CornerRadius="14"
                                                                        HeightRequest="80"
                                                                        IsVisible="{Binding IsPaymentOverdue}"
                                                                        WidthRequest="80">
                                                                        <StackLayout
                                                                            HorizontalOptions="Center"
                                                                            Spacing="0"
                                                                            VerticalOptions="Center">
                                                                            <Label
                                                                                HorizontalTextAlignment="Center"
                                                                                VerticalOptions="End"
                                                                                VerticalTextAlignment="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Style="{StaticResource ValueLabelWhiteMedium}" Text="{Binding Day}" />
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                            <Label
                                                                                HorizontalTextAlignment="Center"
                                                                                VerticalOptions="Start"
                                                                                VerticalTextAlignment="Center">
                                                                                <Label.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Style="{StaticResource CaptionLabelWhite}" Text="{Binding Month}" />
                                                                                    </FormattedString>
                                                                                </Label.FormattedText>
                                                                            </Label>
                                                                        </StackLayout>

                                                                        <cards:SfCardView.Triggers>
                                                                            <Trigger TargetType="cards:SfCardView" Property="IsVisible" Value="True">
                                                                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                                                            </Trigger>
                                                                        </cards:SfCardView.Triggers>

                                                                    </cards:SfCardView>

                                                                    <StackLayout
                                                                        Padding="10,1"
                                                                        Spacing="0"
                                                                        VerticalOptions="Center">

                                                                        <Label
                                                                            HorizontalOptions="StartAndExpand"
                                                                            IsVisible="{Binding IsUnSubmittedReturn}"
                                                                            Style="{StaticResource ValueLabelBlackMedium}"
                                                                            Text="{Binding inboundCorrespondenceTypeDescription}" />

                                                                        <Label
                                                                            HorizontalOptions="StartAndExpand"
                                                                            IsVisible="{Binding IsPaymentOverdue}"
                                                                            Style="{StaticResource ValueLabelBlackMedium}"
                                                                            Text="{Binding taxTypeDescription}" />

                                                                        <Label
                                                                            HorizontalOptions="StartAndExpand"
                                                                            IsVisible="{Binding IsUnSubmittedReturn}"
                                                                            LineBreakMode="WordWrap"
                                                                            Style="{StaticResource ValueLabelGrey}">
                                                                            <Label.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZTaxPeriod}" />
                                                                                    <Span Text=" : " />
                                                                                    <Span Style="{StaticResource ValueLabelGrey}" Text="{Binding TaxPeriod}" />
                                                                                </FormattedString>
                                                                            </Label.FormattedText>

                                                                        </Label>

                                                                        <Label
                                                                            HorizontalOptions="StartAndExpand"
                                                                            IsVisible="{Binding IsPaymentOverdue}"
                                                                            LineBreakMode="WordWrap"
                                                                            Style="{StaticResource ValueLabelGrey}">
                                                                            <Label.FormattedText>
                                                                                <FormattedString>
