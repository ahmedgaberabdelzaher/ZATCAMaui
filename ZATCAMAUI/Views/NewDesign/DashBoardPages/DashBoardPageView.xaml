                            Spacing="15"
                            VerticalOptions="Center">
                            <StackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding SurveyCurrentStep}"
                                    TargetType="StackLayout"
                                    Value="2">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                            </StackLayout.Triggers>
                            <Label
                                FontSize="18"
                                HorizontalOptions="StartAndExpand"
                                Text="{Binding QuestionTxt}"
                                TextColor="{StaticResource Primary}" />
                            <Frame
                                Padding="9"
                                BackgroundColor="White"
                                BorderColor="#4FBBBD"
                                CornerRadius="14"
                                HeightRequest="100">
                                <custom:GAZTBorderlessEditor Placeholder="اكتب النص هنا " Text="{Binding SQAnswer}" />
                            </Frame>
                            <Frame
                                Grid.Column="0"
                                Padding="12"
                                BackgroundColor="#0996D4"
                                CornerRadius="14">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddSurveyCommand}" CommandParameter="0" />
                                </Frame.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Send}"
                                    TextColor="White" />
                            </Frame>
                        </StackLayout>
                        <!--#endregion-->
                        <!--#endregion SurveyEnd-->
                        <StackLayout
                            Margin="0"
                            IsVisible="false"
                            VerticalOptions="CenterAndExpand">
                            <StackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding SurveyCurrentStep}"
                                    TargetType="StackLayout"
                                    Value="3">
                                    <Setter Property="IsVisible" Value="true" />
                                </DataTrigger>
                            </StackLayout.Triggers>
                            <Image
                                Margin="0,20,0,20"
                                HeightRequest="47"
                                HorizontalOptions="CenterAndExpand"
                                Source="SurveyEnd"
                                WidthRequest="45" />
                            <Label
                                FontSize="25"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.ThankYou}"
                                TextColor="{StaticResource Primary}" />
                            <Label
                                FontSize="16"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.DearCustomer}"
                                TextColor="#0996D4" />
                            <Label
                                FontSize="16"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.SurveyThankMsg}"
                                TextColor="{StaticResource Primary}" />
                            <Frame
                                Grid.Column="0"
                                Padding="12"
                                BackgroundColor="#0996D4"
                                CornerRadius="14">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SurveyNextCommand}" CommandParameter="4" />
                                </Frame.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Form5Finish}"
                                    TextColor="White" />
                            </Frame>
                        </StackLayout>
                        <!--#endregion-->

                    </Grid>
                </yummy:PancakeView>

            </Grid>
            <!--#endregion-->
        </Grid>
    </ContentPage.Content>
</ContentPage>
