<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.DashBoardPages.UpdateActivityInstructionsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    Title="UpdateActivityInstructionsPageView"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <Border
        BackgroundColor="White"
        HorizontalOptions="End"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="End">
        <StackLayout
            Margin="24,8,24,0"
            BackgroundColor="Transparent"
            HorizontalOptions="End"
            VerticalOptions="End">
            <BoxView
                HorizontalOptions="Center"
                Style="{StaticResource NeutralGrayBoxViewDrag}"
                VerticalOptions="Start" />

            <StackLayout Margin="8">

                <StackLayout  Spacing="0">

                    <Label
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding responseMessage}" />
                </StackLayout>
            </StackLayout>

            <StackLayout
                HorizontalOptions="FillAndExpand"
                Orientation="Horizontal"
                VerticalOptions="End">
                <custom:CheckboxCustom
                    Grid.Row="0"
                    Grid.Column="0"
                    IsChecked="{Binding IsInstructionChecked}"
                    IsEnabled="{Binding isInstructionCheckedEnable}"
                    Style="{StaticResource CheckboxHeightWidth32}" />
                <Label
                    Margin="5,10,0,15"
                    Style="{DynamicResource IsInstructionCheckedStyle}"
                    Text="{x:Static ResourceManager:AppResources.VFCCheckBoxDesc}">

                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsInstructionChecked}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsInstructionChecked}"
                            TargetType="Label"
                            Value="False">
                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </StackLayout>
            <buttons:SfButton
                x:Name="btnVATDeregistration"
                Grid.ColumnSpan="2"
                Margin="0,24,0,24"
                Background="{Binding ContinueButtonnBackroundColor}"
                Command="{Binding UpdateActivityClicked}"
                IsEnabled="{Binding IsContinueButtonEnable}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZDone}" />
        </StackLayout>
    </Border>
</Mopups:PopupPage>
