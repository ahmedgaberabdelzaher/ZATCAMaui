                                        </Label.GestureRecognizers>

                                    </Label>
                                </StackLayout>
                                <StackLayout.GestureRecognizers>

                                    <TapGestureRecognizer Command="{Binding TermsAndConditionsCheckBoxCommand}" />

                                </StackLayout.GestureRecognizers>
                            </StackLayout>


                            <!--  Send Report Button  -->
                            <buttons:SfButton
                                Margin="0,40"
                                Command="{Binding SendReportCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.SendReportButton}" />

                        </StackLayout>
