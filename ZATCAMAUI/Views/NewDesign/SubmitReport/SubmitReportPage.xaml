                                            Binding="{Binding IsReadTermsandCondition}"
                                            TargetType="Image"
                                            Value="false">
                                            <Setter Property="Source" Value="emptyCheck.png" />
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>
                                <StackLayout Orientation="Horizontal">
                                    <Label
                                        Margin="0"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="14"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.ViewRestofTermsConditions}"
                                        TextColor="#002447"
                                        VerticalOptions="CenterAndExpand" />
                                    <Label
                                        Margin="0"
                                        FontFamily="{StaticResource SomarRegular}"
