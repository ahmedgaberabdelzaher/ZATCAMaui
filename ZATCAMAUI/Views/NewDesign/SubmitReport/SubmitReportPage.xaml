                                    Source="emptyCheck.png"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="20">

                                    <Image.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SubmitReport.IsNeedReward}"
                                            TargetType="Image"
                                            Value="true">
                                            <Setter Property="Source" Value="CheckMark.png" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding SubmitReport.IsNeedReward}"
                                            TargetType="Image"
                                            Value="false">
                                            <Setter Property="Source" Value="emptyCheck.png" />
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>

