<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.SubmitReport.SubmitReportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding GetCurrentLocationCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding HeaderTitle}"
                    VerticalOptions="Center" />
            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout>

                        <!--  Circle view  -->
                        <Grid
                            Margin="0,30,0,0"
                            ColumnDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="0"
                            HorizontalOptions="CenterAndExpand"
                            IsVisible="false"
                            RowDefinitions="Auto,Auto"
                            VerticalOptions="CenterAndExpand">

                            <!--  Circle button 1  -->
                            <buttons:SfButton
                                Background="Transparent"
                                CornerRadius="15"
                                HeightRequest="30"
                                HorizontalOptions="EndAndExpand"
                                Stroke="#0996D4"
                                StrokeThickness="1"
                                Text="1"
                                TextColor="#0996D4"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="30">
                                <buttons:SfButton.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </buttons:SfButton.Padding>

                            </buttons:SfButton>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="1"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="120" />

                            <!--  Circle button 2  -->
                            <buttons:SfButton
                                Grid.Column="2"
                                Background="Transparent"
                                CornerRadius="15"
                                HeightRequest="30"
                                HorizontalOptions="StartAndExpand"
                                Stroke="#B8BABA"
                                StrokeThickness="1"
                                Text="2"
                                TextColor="#565655"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="30">
                                <buttons:SfButton.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </buttons:SfButton.Padding>

                            </buttons:SfButton>

                            <!--  ReportDetails Label  -->
                            <Label
                                Grid.Row="1"
                                Margin="-20,0,0,0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="{x:Static ResourceManager:AppResources.ZTERReportFormPageTittle}"
                                TextColor="#0996D4" />

                            <!--  Terms Label  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,-25,0"
                                FontFamily="{StaticResource SomarSemiBold}"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Text="{x:Static ResourceManager:AppResources.ZVatRefundTermsAndConditions}"
                                TextColor="#565655" />

                        </Grid>

                        <!--  ReportDetails Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="22"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ZTERReportFormPageTittle}"
                            TextColor="#58595B" />

                        <!--  ReportDetailsNote Label  -->
                        <Label
                            Margin="0,0,0,10"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="12"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ReportDetailsSubTitle}"
                            TextColor="{StaticResource NeutralGreay}" />

                        <!--  Report type Field  -->
                        <StackLayout Spacing="0">

                            <!--  Report Type Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReportType}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Report Type Entry  -->
                            <custom:CustomSfTextInputView VerticalOptions="StartAndExpand">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="reportTypeEntry"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ReportType}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.ReportTypeName}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenReportTypeCommand}" />
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="arrowDropdown" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenReportTypeCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenReportTypeCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  Report Category Field  -->
                        <StackLayout IsVisible="{Binding IsReportCategoryShowen}" Spacing="0">

                            <!--  Report Category Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReportCategory}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Report Category Entry  -->
                            <custom:CustomSfTextInputView VerticalOptions="StartAndExpand">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="reportCategoryEntry"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ReportCategory}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.ReportCategoryName}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenReportCategoryCommand}" />
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="arrowDropdown" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenReportCategoryCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenReportCategoryeCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>


                        <!--  Report Sub Category Field  -->
                        <StackLayout IsVisible="{Binding IsSubCategeoryShow}" Spacing="0">

                            <!--  Report SubCategory Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReportCategory}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Report SubCategory Entry  -->
                            <custom:CustomSfTextInputView VerticalOptions="StartAndExpand">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="reportSubCategoryEntry"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ReportCategory}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.ReportSubCategoryName}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenReportSubCategoryCommand}" />
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="arrowDropdown" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenReportSubCategoryCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenReportSubCategoryCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>


                        <!--  Missing Field  -->
                        <StackLayout IsVisible="{Binding IsMissingFieldShowen}" Spacing="0">

                            <!--  Missing Field Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReportMissingField}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Missing Field Entry  -->
                            <custom:CustomSfTextInputView VerticalOptions="StartAndExpand">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="missingFieldEntry"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ReportMissingField}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.MissedFieldName}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenMissingFieldCommand}" />
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="arrowDropdown" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenMissingFieldCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenMissingFieldCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  ReportDetails Field  -->
                        <StackLayout Spacing="0">

                            <!--  ReportDetails Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReportText}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  ReportDetails Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEditor
                                        x:Name="reportReportDetailsEntry"
                                        AutoSize="TextChanges"
                                        HeightRequest="100"
                                        HorizontalOptions="FillAndExpand"
                                        IsSpellCheckEnabled="True"
                                        IsTextPredictionEnabled="False"
                                        MaxLength="1000"
                                        MinimumHeightRequest="100"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SubmitReport.ReportDetails}" />

                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>

                        </StackLayout>

                        <!--  Location Field  -->
                        <StackLayout Spacing="0">

                            <!--  Location Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZTERReportDetailReportDetailRLocation}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Location Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ReportLocationPlaceholder}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.Location}"
                                        TextColor="#58595B" />

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="reportlocation.png" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowMapCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowMapCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  ViolationDate Field  -->
                        <StackLayout Spacing="0">

                            <!--  ViolationDate Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ViolationDate}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>


                            <!--  ViolationDate Entry  -->
                            <custom:CustomSfTextInputView HasError="{Binding SubmitReport.HasViolationDate}">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="violationDateEntry"
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="dd/MM/yyyy"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding ViolationDateDateString}"
                                        TextColor="#58595B">

                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding DateClickedCommand}" CommandParameter="{x:Reference violationDate}" />
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DateClickedCommand}" CommandParameter="{x:Reference violationDate}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>


                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="menu_calendar" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                            </custom:CustomSfTextInputView>

                            <DatePicker
                                x:Name="violationDate"
                                Date="{Binding SelectedDate}"
                                Format="dd/MM/yyyy"
                                IsVisible="false"
                                MaximumDate="{Binding MaximumDate}">

                                <DatePicker.Behaviors>
                                    <xct:EventToCommandBehavior
                                        Command="{Binding SelectedDateCommand}"
                                        CommandParameter="{x:Reference violationDateEntry}"
                                        EventName="DateSelected" />
                                </DatePicker.Behaviors>

                            </DatePicker>
                        </StackLayout>

                        <!--  Uploaded file Field  -->
                        <StackLayout Spacing="0">

                            <!--  Uploaded files Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReportAttachements}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Uploaded files Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>

                                    <custom:GAZTBorderlessEntry
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ReportAttachements}"
                                        Style="{StaticResource DefaultEntry}"
                                        TextColor="#58595B" />

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="newui_ic_pdf" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadFileCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <Label
                                Margin="0,-15,0,10"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ReportAttachmentHelperText}" />

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding UploadFileCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  PDfUploaded List  -->
                        <StackLayout IsVisible="{Binding IsTherePDFUploaded}" Spacing="0">

                            <!--  PDfUploaded Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="12"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAttachment}" />

                            <!--  Files List  -->
                            <StackLayout
                                x:Name="filesLst"
                                BindableLayout.ItemsSource="{Binding ReportUloadedFiles}"
                                Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout x:Name="Item">

                                            <!--  PDfUploaded Entry  -->
                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>

                                                    <custom:GAZTBorderlessEntry
                                                        InputTransparent="True"
                                                        IsReadOnly="True"
                                                        Keyboard="Text"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding fileFullName}"
                                                        TextColor="#58595B" />

                                                </custom:CustomSfTextInputView.TextInputView>

                                                <inputLayout:SfTextInputLayout.LeadingView>
                                                    <Image Aspect="AspectFit" Source="Generic_attachment_icon" />
                                                </inputLayout:SfTextInputLayout.LeadingView>

                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image Aspect="AspectFit" Source="reportClose.png">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"
                                                                Command="{Binding DeleteAttatchementCommand}"
                                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </inputLayout:SfTextInputLayout.TrailingView>

                                            </custom:CustomSfTextInputView>
                                        </StackLayout>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>

                        </StackLayout>
                        <!--  TIN Field  -->
                        <StackLayout Spacing="0">

                            <!--  TIN Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TIN}" />

                            <!--  TIN Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>

                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.TIN}"
                                        TextColor="#58595B" />

                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>

                        </StackLayout>

                        <!--  Company Name Field  -->
                        <StackLayout Spacing="0">

                            <!--  Company Name Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDTaxEvasionFacilityName}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Company Name Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="reportCompanyNameEntry"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.NDTaxEvasionFacilityName}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.CompanyName}"
                                        TextColor="#58595B" />

                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>

                        </StackLayout>

                        <!--  Commercial Registration Field  -->
                        <StackLayout Spacing="0">

                            <!--  Commercial Registration Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistration}" />

                            <!--  Commercial Registration Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>

                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ESTCommercialRegistration}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.CR}"
                                        TextColor="#58595B" />

                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>
                        </StackLayout>

                        <!--  WorkType Field  -->
                        <StackLayout Spacing="0">

                            <!--  WorkType Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.WorkType}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  WorkType Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="reportWorkTypeEntry"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.WorkType}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SubmitReport.WorkType}"
                                        TextColor="#58595B" />

                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>
                        </StackLayout>

                        <!--  Company Address Field  -->
                        <StackLayout Spacing="0">

                            <!--  Company Address Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDFacilityAddress}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Company Address Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="reportCompanyAddressEntry"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.NDFacilityAddress}"
                                        Style="{StaticResource DefaultEntry}"
