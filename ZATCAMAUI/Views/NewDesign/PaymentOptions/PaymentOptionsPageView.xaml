<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.PaymentOptions.PaymentOptionsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    BackgroundColor="#88000000"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Mopups:PopupPage.Resources>
        <ResourceDictionary>
            <templateSelector:LVUnselectedItemTemplateSelector x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelector x:Key="SelectedIttemTemplateSelector" />

        </ResourceDictionary>
    </Mopups:PopupPage.Resources>

    <Border
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <Grid RowDefinitions="auto,auto,auto">
            <Label
                Margin="10"
                Style="{StaticResource TPProfileLabelBlackBold}"
                Text="{x:Static ResourceManager:AppResources.PaymentMethod}" />

            <StackLayout Grid.Row="1">

                <listView:SfListView
                    x:Name="paymentItemsListView"
                    HorizontalOptions="EndAndExpand"
                    IsScrollingEnabled="False"
                    ItemSpacing="12"
                    ScrollBarVisibility="Never"
                    SelectionBackground="Transparent"
                    SelectionChanged="paymentItemSelectionChanged"
                    SelectionMode="Single"
                    VerticalOptions="Center">

                    <listView:SfListView.ItemTemplate>

                        <DataTemplate>
                            <cards:SfCardView
                                BackgroundColor="{StaticResource PickerBgGray}"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="10"
                                HeightRequest="150"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Start">
                                 <cards:SfCardView.Content>
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal"
                                    VerticalOptions="CenterAndExpand">
                                    <Image
                                        x:Name="PayIcon"
                                        Margin="4,0,0,0"
                                        Aspect="AspectFit"
                                        HeightRequest="100"
                                        HorizontalOptions="Start"
                                        Source="{Binding SelectedCardIcon}"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="100" />
                                    <Label TextColor="Black"
                                        Padding="8,0"
                                        HorizontalOptions="Start"
                                        Text="{Binding CardLabel}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                         </cards:SfCardView.Content>
                            </cards:SfCardView>

                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>

                    <listView:SfListView.ItemsLayout>

                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=1, Tablet=4, Desktop=5}" />

                    </listView:SfListView.ItemsLayout>

                </listView:SfListView>

            </StackLayout>

            <cards:SfCardView
                x:Name="FrameMadaPaymentText"
                Grid.Row="2"
                Padding="10"
                BackgroundColor="#b6e7fc"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">

                <Label
                    x:Name="TextMadaPaymentText"
                    LineHeight="0.8"
                    Style="{StaticResource ValueLabelBlackLight}" />

            </cards:SfCardView>

        </Grid>
    </Border>
</Mopups:PopupPage>