<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.PaymentOptions.PaymentExceptionPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <StackLayout
            Margin="0"
            BackgroundColor="Transparent"
            IsVisible="true">
            <StackLayout
                Padding="40"
                BackgroundColor="Transparent"
                VerticalOptions="CenterAndExpand">
                <Image Aspect="AspectFit" Source="errorNew.png" />
                <Label
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="Large"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static ResourceManager:AppResources.ZZSomethingwentwrong}"
                    TextColor="White" />
                <Label
                    FontFamily="{StaticResource SomarSemiBold}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static ResourceManager:AppResources.ErrorOccuredContactCustomerService}"
                    TextColor="White" />
            </StackLayout>

           <Button
                Margin="20"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Clicked="TryAgainClicked"
                HeightRequest="46"
                Style="{StaticResource PrimaryMauiButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.tryAgain}" />
        </StackLayout>
    </ScrollView>
</Mopups:PopupPage>