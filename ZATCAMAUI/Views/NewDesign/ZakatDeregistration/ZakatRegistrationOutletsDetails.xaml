<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatDeregistration.ZakatRegistrationOutletsDetails"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="false">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">
            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ESTOutletsTabTitleLabel}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <listView:SfListView
                    x:Name="outletsListView"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="-3,0,-3,0"
                    AutoFitMode="Height"
                    HorizontalOptions="Center"
                    IsScrollingEnabled="True"
                    ItemSpacing="5"
                    ItemsSource="{Binding OutletData}"
                    ScrollBarVisibility="Never"
                    SelectionBackground="Transparent"
                    SelectionMode="Single"
                    VerticalOptions="Start">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,16,0,10"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="15"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="establishments"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding Actnm}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                    <Grid Padding="10" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--#region OutletNumber-->
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}" />

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding Actno}" />
                                        <!--#endregion-->


                                        <!--#region OutletCity-->
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTOutletCity}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding City1}" />
                                        <!--#endregion-->



                                        <!--#region LicenseNumber-->
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTAddCRAndOrLicenseDetails}" />

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding Crlicenceno}" />
                                        <!--#endregion-->

                                    </Grid>
                                </StackLayout>
                            </Border>

                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>


            </Border>
            <!--#endregion-->
        </Grid>
    </ContentPage.Content>
</ContentPage>
