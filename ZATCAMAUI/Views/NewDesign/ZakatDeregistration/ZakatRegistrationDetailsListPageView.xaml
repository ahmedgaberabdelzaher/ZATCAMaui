<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatDeregistration.ZakatRegistrationDetailsListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="ZakatReg"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">



    <Grid RowDefinitions="Auto,*">

        <!--#region Header-->
        <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

            <StackLayout>

                <!--  Back Button  -->
                <Image
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Rotation="0"
                    Source="whiteRightBack.png"
                    VerticalOptions="CenterAndExpand">

                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding AppDirection}"
                            TargetType="Image"
                            Value="LeftToRight">
                            <Setter Property="Rotation" Value="180" />
                        </DataTrigger>
                    </Image.Triggers>

                </Image>

                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </StackLayout.GestureRecognizers>

            </StackLayout>

            <!--  Header Label  -->
            <Label
                Grid.Column="1"
                FontSize="15"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource SectionTitleWhiteBold}"
                Text="{x:Static ResourceManager:AppResources.TinDeregistrationRegistrationDetails}"
                VerticalOptions="Center" />

        </Grid>
        <!--#endregion Header-->

        <!--#region Body-->
        <Border
            Grid.Row="1"
            Padding="10,0"
            Style="{StaticResource CommonTopCurves}">

            <Grid RowDefinitions="*">

                <listView:SfListView
                    x:Name="outletDecisionOptionsListView"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    AutoFitMode="Height"
                    CachingStrategy="RecycleTemplate"
                    HorizontalOptions="Center"
                    IsScrollingEnabled="True"
                    ItemSpacing="5"
                    ItemsSource="{Binding ZakatRegListData}"
                    ScrollBarVisibility="Never"
                    SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                    SelectionBackground="Transparent"
                    SelectionChanged="registrationDetailsListView_SelectionChanged"
                    SelectionMode="Single"
                    VerticalOptions="FillAndExpand">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,10,16,0" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,0,10,0"
                                        HeightRequest="20"
                                        HorizontalOptions="Start"
                                        Source="{Binding ZDImageSource}"
                                        VerticalOptions="Center"
                                        WidthRequest="20" />
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                        <Label
                                            Margin="5,-4,5,0"
                                            FontFamily="{StaticResource SomarBold}"
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding ZDTitle}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="5,0,5,0"
                                        HorizontalOptions="Start"
                                        Source="{Binding ArrowImageSource}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>


            </Grid>
        </Border>
        <!--#endregion Body-->

        <!--  Loader  -->
        <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

    </Grid>
</ContentPage>
