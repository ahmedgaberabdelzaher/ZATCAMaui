<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatDeregistration.ZakatRegistrationFinancialDetails"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="false">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid
                Grid.Row="0"
                Padding="20,10"
                ColumnDefinitions="Auto,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VATRFinancialDetails}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="0"
                BackgroundColor="Black"
                Style="{StaticResource CommonTopCurves}">
                <Grid
                    x:Name="VATRDMainGrid"
                    Margin="0"
                    Padding="15"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <!--  Summery  -->
                    <Grid
                        x:Name="SummeryView"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="0,0,0,0"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="true"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" HorizontalOptions="FillAndExpand">
                            <Border
                                Margin="0,10,0,0"
                                Padding="0"
                                HorizontalOptions="FillAndExpand"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8"
                                VerticalOptions="StartAndExpand">


                                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid Padding="5" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>


                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,15,10,10"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="details"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="8,0">
                                            <Label
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.VATRFinancialDetails}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource lineSeperator}" />
                                    <Grid
                                        Padding="10,5,10,10"
                                        ColumnDefinitions="40*,50*"
                                        RowDefinitions="auto,auto,auto,auto,auto,auto,auto">


                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.FORM5AccountingMethod}" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding FinSelectedMethod}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.FORM5CalendarType}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding CalendarType}" />

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTEndOfFiscalMonth}" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding FiscalMonth}" />

                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTEndOfFiscalDay}" />
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding FiscalDay}" />

                                        <Label
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTBusinessCommencementDate}" />
                                        <Label
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding CommDate}" />

                                        <Label
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTDebtEndDate}" />

                                        <Label
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding TaxDate}" />
                                    </Grid>
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </Grid>

                </Grid>
            </Border>
            <!--#endregion-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
