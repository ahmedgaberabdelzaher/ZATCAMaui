                                                        Grid.Column="1"
                                                        Orientation="Horizontal">
                                                        <Label
                                                            HorizontalTextAlignment="End"
                                                            LineBreakMode="MiddleTruncation"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Image
                                                            HorizontalOptions="EndAndExpand"
                                                            Source="Generic_attachment_icon"
                                                            Style="{StaticResource SmallIcon}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                            <!--#endregion-->

                            <!--#region Declaration summary-->
                            <Border
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,16,0,10"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            Orientation="Horizontal">
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="declaration"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <Label
                                                Padding="8,0"
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                    <StackLayout
                                        x:Name="summaryDeclarationListView"
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Padding="5,0"
                                        BindableLayout.ItemsSource="{Binding TinDeregistrationSummaryDeclarationData}"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="Center">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0" RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout Grid.Row="0" Grid.Column="0">
                                                        <Label
                                                            FontSize="Small"
                                                            HorizontalOptions="StartAndExpand"
                                                            HorizontalTextAlignment="Start"
                                                            LineBreakMode="NoWrap"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{Binding SummaryTitle}" />
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="0" Grid.Column="1">
                                                        <Label
                                                            FontSize="Small"
                                                            HorizontalOptions="End"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding SummaryData}" />
                                                    </StackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                            <!--#endregion-->
                        </Grid>
                        <buttons:SfButton
                            x:Name="btnContinueSummary"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,16"
                            Command="{Binding SummaryContinueBtnTapped}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.Submit}" />
                    </Grid>
                </ScrollView>
                <!--#endregion-->
            </Grid>

        </Border>
        <!--#endregion Body-->


        <!--  Loader  -->
        <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

    </Grid>
</ContentPage>