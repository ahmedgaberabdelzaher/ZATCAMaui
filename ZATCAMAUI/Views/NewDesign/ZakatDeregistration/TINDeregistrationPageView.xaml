<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatDeregistration.TINDeregistrationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector"
    x:Name="TinDeReg"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="false">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabelBlack" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <converters:ValueTypeToVisibilityConverter x:Key="valueTypeToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>

            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        StrokeShape="RoundRectangle 15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                    <Grid
                        Grid.Row="0"
                        Margin="8,0"
                        Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistration}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>


                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>


                    </Grid>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>

        <Grid
            Grid.Row="0"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">

            <ScrollView>
                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsReasonViewEnabled}"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationSelectReason}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0" Grid.Column="0">

                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                            <Border
                                Margin="0,0,0,10"
                                Stroke="#B1B1B1"
                                StrokeThickness="1"
                                Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                    <Label
                                        x:Name="selectedReasonLbl"
                                        FontFamily="{StaticResource SomarLight}"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                        Text="{Binding SelectedReason.ReasonDesc}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0"
                                            HeightRequest="15"
                                            HorizontalOptions="Start"
                                            Source="arrowDropdown"
                                            VerticalOptions="Center"
                                            WidthRequest="15" />
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTinRegistrationReasonTapped" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </Grid>

                    <listView:SfListView
                        x:Name="outletDecisionOptionsListView"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        AutoFitMode="Height"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        IsScrollingEnabled="False"
                        IsVisible="{Binding IsOutletDecisionOptionsLVVisible}"
                        ItemSpacing="5"
                        ItemsSource="{Binding OutletDecisionOptions}"
                        ScrollBarVisibility="Never"
                        SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                        SelectionBackground="Transparent"
                        SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                        SelectionMode="Single"
                        VerticalOptions="Center">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="AspectFill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="unselected171x136"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelBlack}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <listView:SfListView.SelectedItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="AspectFill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="re_Tile_Background_S"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelWhite}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.SelectedItemTemplate>
                        <listView:SfListView.ItemsLayout>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                        </listView:SfListView.ItemsLayout>
                    </listView:SfListView>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsOption1Visible}">
                        <Label x:Name="DateLabel" Style="{StaticResource CaptionLabelGrey}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                    <Span Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <StackLayout
                            x:Name="CalLabel"
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                            <Switch
                                x:Name="HijriCalSwitch"
                                HorizontalOptions="CenterAndExpand"
                                IsToggled="{Binding IsHijriCal}"
                                Toggled="HijriCalSwitch_Toggled" />
                            <Label
                                HorizontalOptions="End"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                        </StackLayout>

                        <Grid
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <inputLayout:SfTextInputLayout
                                x:Name="FrmDBO"
                                Margin="0,-10,0,0"
                                Hint="yyyy/MM/dd"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <custom:GAZTBorderlessEntry
                                    x:Name="DateEntry"
                                    BackgroundColor="Gray"
                                    Focused="OnDateEntryFocussed"
                                    FontFamily="{StaticResource SomarLight}"
                                    IsReadOnly="True"
                                    InputTransparent="True"
                                    Placeholder="yyyy/MM/dd"
                                    Style="{StaticResource InputTableEntryLayoutStyle}"
                                    Text="{Binding PickerDobToDisplay}"
                                    TextChanged="DateEntry_TextChanged"
                                    TextColor="{StaticResource NeutralBlack}"
                                    Unfocused="DatePicker_Unfocused"
                                    VerticalTextAlignment="End" />
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <!--<Image Source="arrowDropdown.png"/>-->
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image Margin="5,0">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                    Size="20"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                        </Image>
                                    </StackLayout>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <buttons:SfButton
                                Margin="0,0,0,0"
                                Background="Transparent"
                                Clicked="OnDOBClicked" />

                            <custom:CustomDatePicker
                                x:Name="DpDbo"
                                Margin="10,0,10,0"
                                Background="White"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
                                Closed="DpDbo_Closed"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                Mode="Dialog"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                SelectedItem="{Binding TodayDate}">

                                <custom:CustomDatePicker.ColumnHeaderView>
                                    <syncfusion:PickerColumnHeaderView Height="46" />
                                </custom:CustomDatePicker.ColumnHeaderView>


                                <custom:CustomDatePicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </custom:CustomDatePicker.SelectionView>

                                <custom:CustomDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomDatePicker.SelectedTextStyle>

                                <custom:CustomDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                        Height="46"
                                        Background="{StaticResource Primary}"
                                        Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">

                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerHeaderView.TextStyle>

                                    </syncfusion:PickerHeaderView>

                                </custom:CustomDatePicker.HeaderView>


                                <custom:CustomDatePicker.FooterView>

                                    <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </custom:CustomDatePicker.FooterView>

                            </custom:CustomDatePicker>
                            <!--  HijriDatePicker  -->
                            <custom:CustomHijriDatePicker
                                x:Name="DpDboHijri"
                                Margin="10,0,10,0"
                                Background="White"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
                                Closed="DpDbo_Closed"
                                FlowDirection="RightToLeft"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                Mode="Dialog"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                SelectedItem="{Binding TodayDateinHijri}">

                                <custom:CustomHijriDatePicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </custom:CustomHijriDatePicker.SelectionView>

                                <custom:CustomHijriDatePicker.ColumnHeaderView>
                                    <syncfusion:PickerColumnHeaderView Height="46" />
                                </custom:CustomHijriDatePicker.ColumnHeaderView>

                                <custom:CustomHijriDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                        Height="46"
                                        Background="#EAF7CC"
                                        Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />

                                </custom:CustomHijriDatePicker.HeaderView>

                                <custom:CustomHijriDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomHijriDatePicker.SelectedTextStyle>

                                <custom:CustomHijriDatePicker.FooterView>

                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>
                                </custom:CustomHijriDatePicker.FooterView>


                            </custom:CustomHijriDatePicker>
                            <!--  SelectedItem="{Binding TodayDate}"  -->
                            <!--  HijriDatePicker  -->
                        </Grid>

                    </StackLayout>


                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsOption2Visible}">

                        <!--  Display this view in both cases Transfer outlets to snigle transferee an sub selection all id types-!>  -->

                        <StackLayout>
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                        <Span Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <StackLayout Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                                <Switch
                                    x:Name="HijriCalSwitch1"
                                    HorizontalOptions="CenterAndExpand"
                                    IsToggled="{Binding IsHijriCal, Mode=TwoWay}"
                                    Toggled="HijriCal2Switch_Toggled" />
                                <Label
                                    HorizontalOptions="End"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                            </StackLayout>

                            <Grid>
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmDBO2"
                                    Margin="0,-10,0,0"
                                    Hint="yyyy/MM/dd"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="DateEntry21"
                                        Focused="OnDateEntryFocussed"
                                        FontAttributes="None"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="Small"
                                        IsReadOnly="True"
                                        InputTransparent="True"
                                        Placeholder="yyyy/MM/dd"
                                        Style="{StaticResource InputTableEntryLayoutStyle}"
                                        Text="{Binding PickerDobToDisplay}"
                                        TextChanged="DateEntry_TextChanged"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="DatePicker_Unfocused"
                                        VerticalTextAlignment="End" />
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <!--<Image Source="arrowDropdown.png"/>-->
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="20"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                                <buttons:SfButton
                                    Margin="0,0,0,0"
                                    Background="Transparent"
                                    Clicked="OnDOBClicked"
                                    TextColor="Transparent" />

                                <custom:CustomDatePicker
                                    x:Name="DpDbo2"
                                    Margin="10,0,10,0"
                                    Background="White"
                                    CancelButtonClicked="DpDbo_CancelButtonClicked"
                                    Closed="DpDbo_Closed"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    OkButtonClicked="DOBpicker_OkButtonClicked"
                                    SelectedItem="{Binding TodayDate}">

                                    <custom:CustomDatePicker.ColumnHeaderView>
                                        <syncfusion:PickerColumnHeaderView Height="46" />
                                    </custom:CustomDatePicker.ColumnHeaderView>


                                    <custom:CustomDatePicker.SelectionView>
                                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                    </custom:CustomDatePicker.SelectionView>

                                    <custom:CustomDatePicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomDatePicker.SelectedTextStyle>

                                    <custom:CustomDatePicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="46"
                                            Background="#EAF7CC"
                                            Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />

                                    </custom:CustomDatePicker.HeaderView>


                                    <custom:CustomDatePicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </custom:CustomDatePicker.FooterView>


                                </custom:CustomDatePicker>
                                <!--  HijriDatePicker  -->
                                <custom:CustomHijriDatePicker
                                    x:Name="DpDboHijri2"
                                    Margin="10,0,10,0"
                                    Background="White"
                                    CancelButtonClicked="DpDbo_CancelButtonClicked"
                                    Closed="DpDbo_Closed"
                                    FlowDirection="RightToLeft"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    OkButtonClicked="DOBpicker_OkButtonClicked"
                                    SelectedItem="{Binding TodayDateinHijri}">

                                    <custom:CustomHijriDatePicker.SelectionView>
                                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                    </custom:CustomHijriDatePicker.SelectionView>

                                    <custom:CustomHijriDatePicker.ColumnHeaderView>
                                        <syncfusion:PickerColumnHeaderView Height="46" />
                                    </custom:CustomHijriDatePicker.ColumnHeaderView>

                                    <custom:CustomHijriDatePicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="46"
                                            Background="#EAF7CC"
                                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />

                                    </custom:CustomHijriDatePicker.HeaderView>

                                    <custom:CustomHijriDatePicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomHijriDatePicker.SelectedTextStyle>

                                    <custom:CustomHijriDatePicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>
                                    </custom:CustomHijriDatePicker.FooterView>

                                </custom:CustomHijriDatePicker>
                                <!--  SelectedItem="{Binding TodayDate}"  -->
                                <!--  HijriDatePicker  -->
                            </Grid>

                            <StackLayout Margin="0,20,0,0" IsVisible="{Binding TinText.IsVisible}">
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.TIN}" />
                                <inputLayout:SfTextInputLayout
                                    x:Name="TINNumber"
                                    Margin="0,-6,0,-6"
                                    CharMaxLength="10"
                                    ContainerType="Outlined"
                                    HasError="{Binding FrameTinError}"
                                    IsHintAlwaysFloated="True"
                                    OutlineCornerRadius="13"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="EntryTIN"
                                        FontFamily="{StaticResource SomarLight}"
                                        FontSize="Small"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="{Binding TinText.IsEditable}"
                                        Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                        Text="{Binding TINNumber}"
                                        TextChanged="OnTinEntered"
                                        TextColor="{DynamicResource BlackLabelTextColor}"
                                        Unfocused="BorderlessTINEntry_Unfocused"
                                        VerticalTextAlignment="Start">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <StackLayout>
                                <Label Style="{StaticResource CaptionLabelGrey}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                            <Span Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Border
                                    Margin="0,0,0,10"
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
