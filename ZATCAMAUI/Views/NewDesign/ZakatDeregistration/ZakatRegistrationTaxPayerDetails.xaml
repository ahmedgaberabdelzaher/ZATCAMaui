<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatDeregistration.ZakatRegistrationTaxPayerDetails"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    
  
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                <Grid>

                    <Grid
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsOutletViewEnabled}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Border
                                Margin="0,10,0,0"
                                Padding="0"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8">
                                <StackLayout>

                                    <Grid Padding="5" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,10,10,0"
                                            BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 32,32,32,32"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Opacity=".2"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,10,10,10"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="details"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="8,0">
                                            <Label
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource lineSeperator}" />
                                    <StackLayout Padding="10,5,10,10">
                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.EntityType}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding SelectedEntityType}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTNationalityLabel}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding SelectedRegNationalityType}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding GCCIDType}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding GCCIDTypeIdNumberValue}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding SelectedDOB}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZVATRFirstName}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding FirstName}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTLastNameLabel}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding LastName}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTFathersNameLabel}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding FatherName}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TinDeregistrationGrandFathersName}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding GrandFatherName}" />
                                        </StackLayout>



                                    </StackLayout>
                                </StackLayout>
                            </Border>



                        </Grid>
                    </Grid>
     
                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />


        </Grid>
       


    </ContentPage.Content>

</ContentPage>
