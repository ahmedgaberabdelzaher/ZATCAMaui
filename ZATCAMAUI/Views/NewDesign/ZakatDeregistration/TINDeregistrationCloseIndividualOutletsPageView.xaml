<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatDeregistration.TINDeregistrationCloseIndividualOutletsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:local1="clr-namespace:ZATCAMAUI.ViewModel.SyncFusionEnabledViewModel.ZakatDeregistration"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    x:Name="TinDeregIndOutlets">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabelBlack" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <converters:TINDeregistrationAPermitDregRsnTbValueConverter x:Key="dregRsnTbValueConverter" />
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>

    </ContentPage.Resources>
    <yummy:PancakeView
        Grid.Row="1"
        Padding="0"
        BackgroundColor="White"
        CornerRadius="30,30,0,0">
        <Grid>
            <ScrollView>
                <Grid
                    Margin="20,10,20,0"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="true"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationSelectReason}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                    </Grid>

                    <listView:SfListView
                        x:Name="outletDecisionOptionsListView"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        AutoFitMode="Height"
                        HorizontalOptions="FillAndExpand"
                        IsScrollingEnabled="False"
                        IsVisible="true"
                        ItemSpacing="5"
                        ItemsSource="{Binding PermitOutletDecisionOptions}"
                        ScrollBarVisibility="Never"
                        SelectedItem="{Binding SelectedPermitTypeOutletOption, Mode=TwoWay}"
                        SelectionBackground="Transparent"
                        SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                        SelectionMode="Single"
                        VerticalOptions="FillAndExpand">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="unselected171x136"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelBlack}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <listView:SfListView.SelectedItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="re_Tile_Background_S"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelWhite}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.SelectedItemTemplate>
                        <listView:SfListView.ItemsLayout>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                        </listView:SfListView.ItemsLayout>
                    </listView:SfListView>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsPermitOption1Visible}">
                        <Label>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                    <Span Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <StackLayout
                            x:Name="CalLabel"
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                            <Switch
                                x:Name="HijriCalSwitch"
                                HorizontalOptions="CenterAndExpand"
                                IsToggled="{Binding IsHijriCal}"
                                Toggled="HijriCalSwitch_Toggled" />
                            <Label
                                HorizontalOptions="End"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                        </StackLayout>
                        <Grid
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <inputLayout:SfTextInputLayout
                                x:Name="FrmDBO"
                                Margin="0,-10,0,0"
                                 IsHintAlwaysFloated="True"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <custom:GAZTBorderlessEntry
                                    x:Name="DateEntry"
                                    BackgroundColor="Gray"
                                    Focused="OnDateEntryFocussed"
                                    IsReadOnly="True"
                                    Placeholder="yyyy/MM/dd"
                                    Style="{StaticResource InputTableEntryLayoutStyle}"
                                    Text="{Binding PickerCloseAllDeregDateDisplay}"
                                    TextChanged="DeregDateEntry_TextChanged"
                                    TextColor="{StaticResource NeutralBlack}"
                                    Unfocused="CloseDeregDatePicker_Unfocused"
                                    VerticalTextAlignment="End" />
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <!--<Image Source="arrowDropdown.png"/>-->
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image Margin="5,0">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                    Size="20"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                        </Image>
                                    </StackLayout>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <buttons:SfButton
                                Margin="0,0,0,0"
                                Background="Transparent"
                                Clicked="OnDOBClicked" />
                            <custom:CustomDatePicker
                                x:Name="CloseDeregDatePicker"
                                Margin="10,0,10,0"
                                Background="White"
                                Closed="CloseDeregDatePicker_Closed"
                                FlowDirection="RightToLeft"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                Mode="Dialog"
                                SelectedItem="{Binding TodayDate}">

                                <custom:CustomDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomDatePicker.SelectedTextStyle>

                                <custom:CustomDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView Height="46" Background="#EAF7CC" />

                                </custom:CustomDatePicker.HeaderView>


                                <custom:CustomDatePicker.FooterView>

                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </custom:CustomDatePicker.FooterView>

                                <custom:CustomDatePicker.Behaviors>
                                    <behaviors:SfPickerBehavior />
                                </custom:CustomDatePicker.Behaviors>

                            </custom:CustomDatePicker>

                            <!--  HijriDatePicker  -->
                            <custom:CustomHijriDatePicker
                                x:Name="CloseDeregDatePickerHijri"
                                Margin="10,0,10,0"
                                Background="White"
                                Closed="CloseDeregDatePicker_Closed"
                                FlowDirection="RightToLeft"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                Mode="Dialog"
                                SelectedItem="{Binding TodayDateinHijri}">

                                 <custom:CustomHijriDatePicker.SelectionView >
                                    <syncfusion:PickerSelectionView  Background="{StaticResource Secondary}" />
                                </custom:CustomHijriDatePicker.SelectionView>

                                <custom:CustomHijriDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView Height="46" Background="#EAF7CC" />

                                </custom:CustomHijriDatePicker.HeaderView>

                                <custom:CustomHijriDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomHijriDatePicker.SelectedTextStyle>

                                <custom:CustomHijriDatePicker.FooterView>

                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>
                                </custom:CustomHijriDatePicker.FooterView>

                            </custom:CustomHijriDatePicker>

                        </Grid>


                    </StackLayout>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsPermitOption2Visible}">

                        <StackLayout>
                            <StackLayout>
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                            <Span Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                                    <Switch
                                        x:Name="HijriCalSwitch1"
                                        HorizontalOptions="CenterAndExpand"
                                        IsToggled="{Binding IsHijriCal, Mode=TwoWay}"
                                        Toggled="HijriCal2Switch_Toggled" />
                                    <Label
                                        HorizontalOptions="End"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                                </StackLayout>
                                <Grid>
                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmDBO2"
                                         IsHintAlwaysFloated="True"
                                        Margin="0,-10,0,0"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <custom:GAZTBorderlessEntry
                                            x:Name="DateEntry21"
                                            Focused="OnDateEntryFocussed"
                                            IsReadOnly="True"
                                            Placeholder="yyyy/MM/dd"
                                            Style="{StaticResource InputTableEntryLayoutStyle}"
                                            Text="{Binding PickerCloseAllDeregDateDisplay}"
                                            TextChanged="DeregDateEntry_TextChanged"
                                            TextColor="{StaticResource NeutralBlack}"
                                            Unfocused="CloseDeregDatePicker_Unfocused"
                                            VerticalTextAlignment="End" />
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <!--<Image Source="arrowDropdown.png"/>-->
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                    <buttons:SfButton
                                        Margin="0,0,0,0"
                                        Background="Transparent"
                                        Clicked="OnDOBClicked"
                                        TextColor="Transparent" />

                                    <custom:CustomDatePicker
                                        x:Name="TransferDeregDatePicker"
                                        Margin="10,0,10,0"
                                        Background="White"
                                        Closed="CloseDeregDatePicker_Closed"
                                        FlowDirection="RightToLeft"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="40"
                                        Mode="Dialog"
                                        SelectedItem="{Binding TodayDate}">


                                        <custom:CustomDatePicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </custom:CustomDatePicker.SelectedTextStyle>

                                        <custom:CustomDatePicker.HeaderView>

                                            <syncfusion:PickerHeaderView Height="46" Background="#EAF7CC" />

                                        </custom:CustomDatePicker.HeaderView>


                                        <custom:CustomDatePicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </custom:CustomDatePicker.FooterView>

                                        <custom:CustomDatePicker.Behaviors>
                                            <behaviors:SfPickerBehavior />
                                        </custom:CustomDatePicker.Behaviors>

                                    </custom:CustomDatePicker>

                                    <!--  HijriDatePicker  -->
                                    <custom:CustomHijriDatePicker
                                        x:Name="TransferDeregDatePickerHijri"
                                        Margin="10,0,10,0"
                                        Background="White"
                                        Closed="CloseDeregDatePicker_Closed"
                                        FlowDirection="RightToLeft"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="40"
                                        Mode="Dialog"
                                        SelectedItem="{Binding TodayDateinHijri}">

                                         <custom:CustomHijriDatePicker.SelectionView >
                                            <syncfusion:PickerSelectionView  Background="{StaticResource Secondary}" />
                                        </custom:CustomHijriDatePicker.SelectionView>

                                        <custom:CustomHijriDatePicker.HeaderView>

                                            <syncfusion:PickerHeaderView Height="46" Background="#EAF7CC" />

                                        </custom:CustomHijriDatePicker.HeaderView>

                                        <custom:CustomHijriDatePicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </custom:CustomHijriDatePicker.SelectedTextStyle>

                                        <custom:CustomHijriDatePicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>
                                        </custom:CustomHijriDatePicker.FooterView>


                                    </custom:CustomHijriDatePicker>
                                </Grid>


                            </StackLayout>
                            <StackLayout IsVisible="{Binding TinText.IsVisible}">
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.TIN}" />
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-6,0,-6"
                                    CharMaxLength="10"
                                     IsHintAlwaysFloated="True"
                                    ContainerType="Outlined"
                                    HasError="{Binding FrameTinError}"
                                    OutlineCornerRadius="13"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="EntryTIN"
                                        FontSize="Small"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="{Binding TinText.IsEditable}"
                                        Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                        Text="{Binding TINNumber}"
                                        TextColor="#bbbbbb"
                                        Unfocused="BorderlessTINEntry_Unfocused"
                                        VerticalTextAlignment="Start">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <StackLayout>
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                            <Span Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Border
                                    Margin="0,0,0,10"
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                        <Label
                                            FontFamily="{StaticResource SomarLight}"
                                            HorizontalOptions="Start"
                                            Style="{StaticResource GAZTSmallBlackLabel}"
                                            Text="{Binding SelectedIdtype}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="5,0"
                                                HeightRequest="15"
                                                HorizontalOptions="End"
                                                Source="arrowDropdown"
                                                VerticalOptions="Center"
                                                WidthRequest="15" />
                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </Border>
                            </StackLayout>

                            <StackLayout IsVisible="{Binding IdNumberText.IsVisible}">
                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <Span Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <inputLayout:SfTextInputLayout
                                    Margin="0,-6,0,-6"
                                    ContainerType="Outlined"
                                     IsHintAlwaysFloated="True"
                                    HasError="{Binding FrameIDError}"
                                    OutlineCornerRadius="13"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        x:Name="idNumber"
                                        FontSize="Small"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="{Binding IdNumberText.IsEditable}"
                                        Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                        Text="{Binding SelectedIdNumber}"
                                        TextChanged="IDNumberEntry_TextChanged"
                                        TextColor="#bbbbbb"
                                        Unfocused="EntryIDNo_Unfocused"
                                        VerticalTextAlignment="Start" />
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                        </StackLayout>

                        <StackLayout IsVisible="{Binding DobText.IsVisible}">
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                        <Span Text="ssd" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <StackLayout IsVisible="{Binding IsDobVisible}" Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                                <Switch
                                    x:Name="HijriCalSwitch3"
                                    HorizontalOptions="CenterAndExpand"
                                    IsToggled="{Binding IsDOBHijriCal, Mode=TwoWay}"
                                    Toggled="HijriCal3Switch_Toggled" />
                                <Label
                                    HorizontalOptions="End"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                            </StackLayout>
                            <Grid IsVisible="{Binding IsDobVisible}">
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmDBO1"
                                     IsHintAlwaysFloated="True"
                                    Margin="0,-10,0,0"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="DateEntry23"
                                        Focused="OnTransferDOBDateEntryFocussed"
                                        IsReadOnly="True"
                                        Placeholder="yyyy/MM/dd"
                                        Style="{StaticResource InputTableEntryLayoutStyle}"
                                        Text="{Binding TransferPickerDOBDateDisplay, StringFormat='{0:yyyy/MM/dd}'}"
                                        TextChanged="TransferDOBDateEntry_TextChanged"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="TransferDOBDatePicker_Unfocused"
                                        VerticalTextAlignment="End" />
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <!--<Image Source="arrowDropdown.png"/>-->
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="20"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <buttons:SfButton
                                    Margin="0,0,0,0"
                                    Background="Transparent"
                                    Clicked="OnTransferIDDOBClicked"
                                    IsEnabled="{Binding DobText.IsEditable}" />

                                <custom:CustomDatePicker
                                    x:Name="TransferDOBPicker"
                                    Margin="10,0,10,0"
                                    Background="White"
                                    Closed="TransferDOBPicker_Closed"
                                    FlowDirection="RightToLeft"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectedItem="{Binding TodayDate}">



                                    <custom:CustomDatePicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomDatePicker.SelectedTextStyle>

                                    <custom:CustomDatePicker.HeaderView>

                                        <syncfusion:PickerHeaderView Height="46" Background="#EAF7CC" />

                                    </custom:CustomDatePicker.HeaderView>


                                    <custom:CustomDatePicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </custom:CustomDatePicker.FooterView>

                                    <custom:CustomDatePicker.Behaviors>
                                        <behaviors:SfPickerBehavior />
                                    </custom:CustomDatePicker.Behaviors>

                                </custom:CustomDatePicker>

                                <!--  HijriDatePicker  -->
                                <custom:CustomHijriDatePicker
                                    x:Name="TransferDOBPickerHijri"
                                    Margin="10,0,10,0"
                                    Background="White"
                                    Closed="TransferDOBPicker_Closed"
                                    FlowDirection="RightToLeft"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectedItem="{Binding TodayDateinHijri}">

                                     <custom:CustomHijriDatePicker.SelectionView >
