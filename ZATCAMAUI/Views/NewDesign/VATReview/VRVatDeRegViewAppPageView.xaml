<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATReview.VRVatDeRegViewAppPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
     BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    ios:Page.UseSafeArea="true"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        IsVisible="{Binding IsBackVisible}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VatReview}"
                    VerticalOptions="Center" />

                 <Image
                        Grid.Row="0"
                        Grid.Column="2"
                        HeightRequest="24"
                        HorizontalOptions="EndAndExpand"
                        Source="close"
                        VerticalOptions="CenterAndExpand"
                        WidthRequest="24">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <ScrollView HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                        <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsSummaryViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <Border
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HorizontalOptions="Start"
                                                    Source="details"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Padding="8,0"
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>

                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                        <listView:SfListView
                                            Grid.Row="0"
                                            Margin="8"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemsSource="{Binding VATDeregistrationSummaryReasonData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="None"
                                            VerticalOptions="Center">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{Binding SummaryTitle}" />
                                                        <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding SummaryData}" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </StackLayout>
                                </Border>
                                <Border
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="ic_attachment"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>

                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                        <listView:SfListView
                                            Grid.Row="0"
                                            Margin="8"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemTapped="VRVatDeRegAttachTapped"
                                            ItemsSource="{Binding VatDeRegAttachmentsList}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="None"
                                            VerticalOptions="Center">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.Attachment}" />
                                                        <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding Filename}" />
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="2"
                                                            Margin="5,0"
                                                            HeightRequest="25"
                                                            HorizontalOptions="Start"
                                                            Source="Generic_attachment_icon"
                                                            VerticalOptions="Center"
                                                            WidthRequest="25" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </StackLayout>
                                </Border>
                                <Border
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="declaration"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>

                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                        <listView:SfListView
                                            Grid.Row="0"
                                            Margin="8"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="None"
                                            VerticalOptions="Center">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{Binding SummaryTitle}" />
                                                        <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding SummaryData}" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </StackLayout>
                                </Border>
                            </Grid>

                        </Grid>

                    </ScrollView>

       
                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
       

    </ContentPage.Content>
</ContentPage>