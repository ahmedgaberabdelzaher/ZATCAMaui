<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATReview.VRVatDeRegViewAppPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    FlowDirection="{Binding AppDirection}"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        StrokeShape="RoundRectangle 15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0" Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VatReview}" />


                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="24"
                            HorizontalOptions="EndAndExpand"
                            Source="close"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsSummaryViewEnabled}"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <Border
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="Start"
                                            Source="details"
                                            VerticalOptions="Center" />

                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <listView:SfListView
                                    Grid.Row="0"
                                    Margin="8"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemsSource="{Binding VATDeregistrationSummaryReasonData}"
                                    ScrollBarVisibility="Never"
                                    SelectionBackground="Transparent"
                                    SelectionMode="None"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{Binding SummaryTitle}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding SummaryData}" />
                                            </Grid>

                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </StackLayout>
                        </Border>
                        <Border
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="ic_attachment"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <listView:SfListView
                                    Grid.Row="0"
                                    Margin="8"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemTapped="VRVatDeRegAttachTapped"
                                    ItemsSource="{Binding VatDeRegAttachmentsList}"
                                    ScrollBarVisibility="Never"
                                    SelectionBackground="Transparent"
                                    SelectionMode="None"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.Attachment}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Filename}" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    Margin="5,0"
                                                    HeightRequest="25"
                                                    HorizontalOptions="Start"
                                                    Source="Generic_attachment_icon"
                                                    VerticalOptions="Center"
                                                    WidthRequest="25" />
                                            </Grid>

                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </StackLayout>
                        </Border>
                        <Border
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="declaration"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <listView:SfListView
                                    Grid.Row="0"
                                    Margin="8"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}"
                                    ScrollBarVisibility="Never"
                                    SelectionBackground="Transparent"
                                    SelectionMode="None"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{Binding SummaryTitle}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding SummaryData}" />
                                            </Grid>

                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </StackLayout>
                        </Border>
                    </Grid>

                </Grid>

            </ScrollView>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>