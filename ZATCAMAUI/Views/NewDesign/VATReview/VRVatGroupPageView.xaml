<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATReview.VRVatGroupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        StrokeShape="RoundRectangle 15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0" Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VatReview}" />


                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="CenterAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                            Source="arrowLeftwhite"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="24"
                            HorizontalOptions="CenterAndExpand"
                            Source="close"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <StackLayout Margin="15,0,15,0">
                <Grid Margin="0,5,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource SectionTitleBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VRViewApplication}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,-10,0,15"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource BodyLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}" />
                    <BoxView
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                </Grid>

                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>

                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>


                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="8,0"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    Source="ic_vat_bill"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <Label
                                    Padding="8,0"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.VRVGMemberDetails}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>

                        </Grid>
                        <BoxView
                            BackgroundColor="LightGray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand" />
                        <StackLayout Padding="15,15,15,10">

                            <listView:SfListView
                                Grid.Row="0"
                                AutoFitMode="Height"
                                HorizontalOptions="Center"
                                IsScrollingEnabled="False"
                                ItemsSource="{Binding VRVGTinsListViewData}"
                                ScrollBarVisibility="Never"
                                SelectionBackground="Transparent"
                                SelectionMode="None"
                                VerticalOptions="Center">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VRVGTINNumber}" />
                                            <Label
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding Gpart}" />
                                        </Grid>

                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                        </StackLayout>

                    </StackLayout>
                </Border>

                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>

                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="8,0"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    Source="ic_vat_bill"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <Label
                                    Padding="8,0"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.VRVGAggregatedgrouplevelfinancialdetails}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>

                        </Grid>
                        <BoxView
                            BackgroundColor="LightGray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand" />
                        <StackLayout Padding="10" Spacing="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VRVGGroupVATeligiblesupplies}" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    MaxLines="1"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding VRVGVATeligiblesupplies}" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VRVGGroupVATeligiblepurchases}" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    MaxLines="1"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding VRVGVATeligiblepurchases}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VRVGGroupeffectivedate}" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    MaxLines="1"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding VRVGEffectivedate}" />
                            </Grid>

                        </StackLayout>
                    </StackLayout>
                </Border>

                <Border Margin="0,16,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">

                    <StackLayout>

                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="8,0"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    Source="establishments"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <Label
                                    Padding="8,0"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.VRVGAttachments}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <StackLayout Padding="15,15,15,10">

                            <listView:SfListView
                                Grid.Row="0"
                                AutoFitMode="Height"
                                HorizontalOptions="Center"
                                IsScrollingEnabled="False"
                                ItemTapped="VRVGAttachTapped"
                                ItemsSource="{Binding VRVGAttachmentsListViewData}"
                                ScrollBarVisibility="Never"
                                SelectionBackground="Transparent"
                                SelectionMode="None"
                                VerticalOptions="Center">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VRAttachment}" />
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="5,0"
                                                HeightRequest="25"
                                                HorizontalOptions="Start"
                                                Source="Generic_attachment_icon"
                                                VerticalOptions="Center"
                                                WidthRequest="25" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding Filename}" />
                                        </Grid>

                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                        </StackLayout>
                    </StackLayout>

                </Border>

                <Border
                    Margin="0,16,0,10"
                    Padding="0,0,0,16"
                    Style="{StaticResource GreyBorderFrameWithShadow}">

                    <StackLayout>

                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="8,0"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    Source="establishments"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <Label
                                    Padding="8,0"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.VRDeclaration}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <StackLayout Padding="15,15,15,5">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VRIDType}" />
                                <Label
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding VRVGIDType}" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VRIDNumber}" />
                                <Label
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding VRVGIDNumber}" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VRContactPersonName}" />
                                <Label
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding VRVGContactPersonName}" />
                            </Grid>

                        </StackLayout>
                    </StackLayout>
                </Border>


            </StackLayout>

        </ScrollView>
    </ContentPage.Content>
</ContentPage>