<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATReview.VatReviewPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="http://schemas.syncfusion.com/maui"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingVatReviewCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VatReview}"
                    VerticalOptions="Center" />

                <StackLayout Grid.Row="0" Grid.Column="2">
                    <StackLayout
                        HorizontalOptions="EndAndExpand"
                        Orientation="Horizontal"
                        Rotation="90"
                        Spacing="3"
                        VerticalOptions="CenterAndExpand">
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                    </StackLayout>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding onMoreOptionClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <ScrollView
                        HorizontalOptions="FillAndExpand"
                        HorizontalScrollBarVisibility="Never"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <commonView:PageIndicatorView
                                    Margin="20,25,20,0"
                                    Completed="{Binding MarkComplete}"
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}"
                                    VerticalOptions="CenterAndExpand" />
                            </Grid>


                            <Grid Grid.Row="1" VerticalOptions="FillAndExpand">


                                <!--  Review Reason   -->

                                <StackLayout
                                    Margin="20,10,20,0"
                                    Spacing="10"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding ReviewReasonVisible}"
                                    VerticalOptions="FillAndExpand">

                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VRReviewReason}" />
                                    <Label
                                        Margin="0,-10,0,15"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}" />
                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Grid Grid.Row="1" Margin="0,10,0,10">

                                        <StackLayout>
                                            <Label
                                                Grid.Row="0"
                                                FontFamily="{StaticResource SomarLight}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.VRReviewReason}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                        InputTransparent="True"
                                                        IsReadOnly="True"
                                                        Keyboard="Text"
                                                        Placeholder="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding ReviewReason}"
                                                        TextColor="#58595B">
                                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding ReviewReasonCommand}" />
                                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                    </custom:GAZTBorderlessEntry>

                                                </custom:CustomSfTextInputView.TextInputView>
                                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ReviewReasonCommand}" />
                                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                                </inputLayout:SfTextInputLayout.TrailingView>
                                            </custom:CustomSfTextInputView>
                                        </StackLayout>

                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,10,0,10">
                                        <StackLayout Grid.Row="0">
                                            <Label
                                                FontFamily="{StaticResource SomarLight}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.VRReviewSubReason}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                        InputTransparent="True"
                                                        IsReadOnly="True"
                                                        Keyboard="Text"
                                                        Placeholder="{x:Static ResourceManager:AppResources.VRReviewSubReason}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding SubReviewReason}"
                                                        TextColor="#58595B">
                                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding SubReviewReasonCommand}" />
                                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                    </custom:GAZTBorderlessEntry>

                                                </custom:CustomSfTextInputView.TextInputView>
                                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SubReviewReasonCommand}" />
                                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                                </inputLayout:SfTextInputLayout.TrailingView>
                                            </custom:CustomSfTextInputView>

                                        </StackLayout>
                                    </Grid>

                                    <Grid Grid.Row="3" Margin="0,10,0,10">
                                        <StackLayout>
                                            <Label
                                                Grid.Row="0"
                                                FontFamily="{StaticResource SomarLight}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.VRApplicationReferenceNumber}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                        InputTransparent="True"
                                                        IsReadOnly="True"
                                                        Keyboard="Text"
                                                        Placeholder="{x:Static ResourceManager:AppResources.VRApplicationReferenceNumber}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding ApplicationRefNumber}"
                                                        TextColor="#58595B">
                                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding ApplicationNumRefCommand}" />
                                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                    </custom:GAZTBorderlessEntry>

                                                </custom:CustomSfTextInputView.TextInputView>
                                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ApplicationNumRefCommand}" />
                                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                                </inputLayout:SfTextInputLayout.TrailingView>
                                            </custom:CustomSfTextInputView>
                                        </StackLayout>
                                    </Grid>

                                    <Grid Grid.Row="4" Margin="0,10,0,10">
                                        <StackLayout>
                                            <Label
                                                Grid.Row="0"
                                                FontFamily="{StaticResource SomarLight}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.VRRequestDate}" />

                                            <custom:CustomSfTextInputView
                                                Grid.Row="1">
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                        InputTransparent="True"
                                                        IsReadOnly="True"
                                                        Keyboard="Text"
                                                        Placeholder="{x:Static ResourceManager:AppResources.VRRequestDate}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding FormattedRequestDate}"
                                                        TextColor="#58595B"/>

                                                </custom:CustomSfTextInputView.TextInputView>

                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image Aspect="AspectFit" Source="calendar.png"
                                          WidthRequest="25" HeightRequest="25"/>
                                                </inputLayout:SfTextInputLayout.TrailingView>
                                            </custom:CustomSfTextInputView>
                                        </StackLayout>
                                    </Grid>

                                    <buttons:SfButton
                                        Grid.Row="5"
                                        Margin="0,16,0,16"
                                        BackgroundColor="{Binding ReviewReasonButtonBackGroundColor}"
                                        Command="{Binding ReviewReasonConBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}" />

                                    <Label
                                        Grid.Row="6"
                                        Margin="10,0,10,15"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        IsVisible="{Binding IsApplicationVisible}"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="{Binding ViewApplicationTypeText}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewApplicationTapped}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                </StackLayout>

                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding ReportDetailsVisible}"
                                    VerticalOptions="FillAndExpand">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VRReportDetails}" />
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}" />
                                    <BoxView
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <StackLayout Grid.Row="5" HorizontalOptions="FillAndExpand">
                                        <StackLayout Grid.Row="1" VerticalOptions="FillAndExpand">

                                            <Label
                                                Grid.Row="0"
                                                FontFamily="{StaticResource SomarLight}"
                                                HorizontalOptions="StartAndExpand"
                                                LineHeight="0.5"
                                                Style="{StaticResource MicroGrayLabelStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.VATReviewRequestString}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEditor
                                                        x:Name="Report_Details_Tx"
                                                        AutoSize="TextChanges"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsEnabled="{Binding IsReportDetailsEditable}"
                                                        MaxLength="1000"
                                                        MinimumHeightRequest="120"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding ReportDetails}"
                                                        TextChanged="Report_Details_Tx_TextChanged"
                                                        Unfocused="Report_Details_UnFocused"
                                                        VerticalOptions="CenterAndExpand"
                                                        Keyboard="Text"/>
                                                </custom:CustomSfTextInputView.TextInputView>
                                            </custom:CustomSfTextInputView>

                                        </StackLayout>

                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarLight}"
                                                        Style="{StaticResource MicroGrayLabelStyle}"
                                                        Text="{Binding charCountReportDetails}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            LineHeight="0.8"
                                            Style="{StaticResource ButtonLabelBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.VRHelperText}" />

                                    </StackLayout>

                                    <StackLayout
                                        Margin="0,5,0,10"
                                        BindableLayout.ItemsSource="{Binding AttachmentsListViewData}"
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding IsDraft}"
                                        VerticalOptions="StartAndExpand">


                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}" HorizontalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border
                                                        Grid.Row="0"
                                                        Margin="0,0,0,10"
                                                        Padding="12"
                                                        Style="{StaticResource SfStyleGreyBorderFrame}">
                                                        <Grid VerticalOptions="FillAndExpand">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="5,0"
                                                                HeightRequest="25"
                                                                HorizontalOptions="Start"
                                                                Source="Generic_attachment_icon"
                                                                VerticalOptions="Center"
                                                                WidthRequest="25" />

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                HorizontalOptions="FillAndExpand"
                                                                Style="{StaticResource CaptionLabelBlack}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="FillAndExpand" />
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="2"
                                                                HorizontalOptions="Center"
                                                                Rotation="90"
                                                                VerticalOptions="Center">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                        Size="24"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                    </Border>


                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>

                                    <Grid
                                        Margin="0,10,0,10"
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding IsDraft}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.VRNewAttachment}" />
                                        <Border
                                            Grid.Row="1"
                                            Margin="0,0,0,10"
                                            Padding="10"
                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                    TextColor="{StaticResource PrimaryColor}" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="Center"
                                                    Rotation="90"
                                                    VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                            Size="24"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                        </Grid.GestureRecognizers>

                                    </Grid>

                                    <buttons:SfButton
                                        Grid.Row="8"
                                        Margin="0,16,0,16"
                                        BackgroundColor="{Binding ReportDetailsButtonBackGroundColor}"
                                        Command="{Binding ReportDetailsConBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                        VerticalOptions="EndAndExpand" />

                                </StackLayout>

                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding ReviewDetailsVisible}"
                                    VerticalOptions="FillAndExpand">
                                    <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand"
                                          RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}"
                                            Text="{x:Static ResourceManager:AppResources.VRReviewDetails}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,-10,0,15"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}" />
                                        <BoxView
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                    </Grid>

                                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.VRTaxPeriodofCase}" />

                                        <custom:CustomSfTextInputView Grid.Row="1" Grid.ColumnSpan="2">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.VRTaxPeriodofCase}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding TaxPeriodOfCase}"
                                                    TextColor="{StaticResource Primary}" />
                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>

                                    </Grid>

                                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.VRPeriodFrom}" />

                                        <custom:CustomSfTextInputView Grid.Row="1" Grid.ColumnSpan="2">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.VRPeriodFrom}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding FormattedTaxperdioFromDate}"
                                                    TextColor="{StaticResource Primary}" />

                                            </custom:CustomSfTextInputView.TextInputView>

                                        </custom:CustomSfTextInputView>

                                    </Grid>

                                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.VRPeriodTo}" />

                                        <custom:CustomSfTextInputView Grid.Row="1" Grid.ColumnSpan="2">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.VRPeriodTo}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding FormattedTaxperdioToDate}"
                                                    TextColor="{StaticResource Primary}" />
                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>

                                    </Grid>

                                    <Grid IsVisible="{Binding IsPenlaityAmountVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.VRPenality_amount_in_question}" />

                                        <custom:CustomSfTextInputView Grid.Row="1" Grid.ColumnSpan="2">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.VRPenality_amount_in_question}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding PenalityAmountInQuestion, Converter={StaticResource commaSeparatorConverter}}"
                                                    TextColor="{StaticResource Primary}" />
                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>

                                    </Grid>

                                    <Grid IsVisible="{Binding IsAssessPayOptionVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
