<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATReview.VatReviewPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    FlowDirection="{Binding AppDirection}"
    BackgroundImageSource="partials_background.png"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

  <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </Border>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>


                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VatReview}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>


                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout  Grid.Row="0" Grid.Column="2">
                            <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked }"/>
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>


     <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,25,20,0" MaxNum="{Binding MaxIndex}"
                                                  MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}"
                                                  VerticalOptions="CenterAndExpand" DotSize="12" HorizontalOptions="End"/>
                </Grid>


                <Grid Grid.Row="1" VerticalOptions="FillAndExpand">


                    <!--Review Reason-->

                    <StackLayout IsVisible="{Binding ReviewReasonVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                          HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                        <Grid Grid.Row="0" Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <Label Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,10">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VRReviewReason}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>


                            <Border Grid.Row="1"  Margin="0,5,0,0"  HorizontalOptions="FillAndExpand" StrokeShape="RoundRectangle 12,12,12,12" Stroke="Gray" Padding="10,0,10,0">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <Label IsEnabled="False" Text="{Binding ReviewReason}" 
                                                     Style="{StaticResource BodyLabelBlack}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                                    <Image Source="arrowDropdown.png" WidthRequest="24" HeightRequest="24" Margin="12" VerticalOptions="CenterAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ReviewReasonCommand}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Border>



                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,10" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VRReviewSubReason}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Border Grid.Row="1"    Margin="0,5,0,0"  HorizontalOptions="FillAndExpand" StrokeShape="RoundRectangle 12,12,12,12" Stroke="Gray" Padding="10,0,10,0">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <Label IsEnabled="False" Text="{Binding SubReviewReason}" 
                                                    Style="{StaticResource BodyLabelBlack}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                                    <Image Source="arrowDropdown.png" WidthRequest="24" HeightRequest="24" Margin="12" VerticalOptions="CenterAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SubReviewReasonCommand}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Border>


                        </Grid>

                        <Grid Grid.Row="3" Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" 
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VRApplicationReferenceNumber}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Border Grid.Row="1"   Margin="0,5,0,0"  HorizontalOptions="FillAndExpand" StrokeShape="RoundRectangle 12,12,12,12" Stroke="Gray" Padding="10,0,10,0">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <Label IsEnabled="False" Text="{Binding ApplicationRefNumber}"  
                                                     Style="{StaticResource BodyLabelBlack}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                                    <Image Source="arrowDropdown.png" WidthRequest="24" HeightRequest="24" Margin="12" VerticalOptions="CenterAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ApplicationNumRefCommand}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Border>


                        </Grid>
                        <Grid Grid.Row="4" Margin="0,10,0,10" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" 
                                                Text="{x:Static ResourceManager:AppResources.VRRequestDate}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}"/>

                            <Border Grid.Row="1" HeightRequest="48"     Margin="0,5,0,0"  HorizontalOptions="FillAndExpand" StrokeShape="RoundRectangle 12,12,12,12" Stroke="Gray" Padding="10,0,10,0">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <Label IsEnabled="False" Text="{Binding FormattedRequestDate}" 
                                                    Style="{StaticResource BodyLabelBlack}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>

                                    <Image Source="calendar.png" WidthRequest="20" HeightRequest="20"
                                               Margin="0,0,5,0"/>
                                </StackLayout>
                            </Border>

                        </Grid>
                        <buttons:SfButton Grid.Row="5" Margin="0,16,0,16"
                                          BackgroundColor="{Binding ReviewReasonButtonBackGroundColor}"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding ReviewReasonConBtnTapped}" />

                        <Label Grid.Row="6" Margin="10,0,10,15"
                                            IsVisible="{Binding IsApplicationVisible}"
                                            Text="{Binding ViewApplicationTypeText}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            Style="{StaticResource ValueLabelPrimary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewApplicationTapped}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </StackLayout>

                    <StackLayout IsVisible="{Binding ReportDetailsVisible}" BackgroundColor="Transparent"
                                 Margin="20,10,20,0"
                                 HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.VRReportDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <Label Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <StackLayout Grid.Row="5" HorizontalOptions="FillAndExpand">


                            <Label Grid.Row="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}" LineHeight="0.5">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VATReviewRequestString}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>


                            <Border Grid.Row="1" Margin="0,0,0,3" 
                                              Padding="0,0,0,7"
                                             Style="{StaticResource GreyBorderFrame}" VerticalOptions="FillAndExpand">

                                <StackLayout Orientation="Vertical" VerticalOptions="FillAndExpand">

                                    <custom:GAZTBorderlessEditor x:Name="Report_Details_Tx"
                                                             Unfocused="Report_Details_UnFocused"
                                                             MinimumHeightRequest="120"
                                                             Text="{Binding ReportDetails}"
                                                                 TextChanged="Report_Details_Tx_TextChanged"
                                                             AutoSize="TextChanges"
                                                              MaxLength="1000"
                                                             VerticalOptions="CenterAndExpand"
                                                             IsEnabled="{Binding IsReportDetailsEditable}"
                                                             HorizontalOptions="FillAndExpand"
                                                             Style="{StaticResource BodyLabelBlack}" />
                                </StackLayout>

                            </Border>


                            <Label Grid.Row="2"
                                                HorizontalOptions="EndAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span  Text="{Binding charCountReportDetails}" Style="{StaticResource MicroGrayLabelStyle}" FontFamily="{StaticResource SomarLight}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="3" LineHeight="0.8" Text="{x:Static ResourceManager:AppResources.VRHelperText}"
                    HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ButtonLabelBlackBold}" />

                        </StackLayout>

                        <!--<Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">-->

                        <StackLayout Margin="0,5,0,10" HorizontalOptions="FillAndExpand"
                                                 VerticalOptions="StartAndExpand"
                                                 BindableLayout.ItemsSource="{Binding AttachmentsListViewData}"
                                                 IsEnabled="{Binding IsDraft}">


                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand">
                                        <!--<Grid.GestureRecognizers>
                                                <TapGestureRecognizer />
                                            </Grid.GestureRecognizers>-->
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                             Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon"
                                                           Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                           HorizontalOptions="Start" VerticalOptions="Center" />

                                                <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                                  
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="FillAndExpand"/>
                                                <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           Rotation="90">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}"
                                                                             Size="24"
                                                                             Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Border>


                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <!--</Grid>-->

                        <Grid Margin="0,10,0,10" HorizontalOptions="FillAndExpand" IsEnabled="{Binding IsDraft}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                                Text="{x:Static ResourceManager:AppResources.VRNewAttachment}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />
                            <Border Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                        FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                        HorizontalOptions="FillAndExpand" />
                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}" Size="24"
                                                             Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Border>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                            </Grid.GestureRecognizers>

                        </Grid>

                        <buttons:SfButton Grid.Row="8" Margin="0,16,0,16" VerticalOptions="EndAndExpand"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          BackgroundColor="{Binding ReportDetailsButtonBackGroundColor}"
                                          Command="{Binding ReportDetailsConBtnTapped}" />

                    </StackLayout>

                    <StackLayout IsVisible="{Binding ReviewDetailsVisible}" BackgroundColor="Transparent"
                                 Margin="20,10,20,0"
                                 HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.VRReviewDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <Label Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>




                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRTaxPeriodofCase}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <Border  Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry IsReadOnly="True"
                                                        Text="{Binding TaxPeriodOfCase}"                                                       
                                                        TextColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        
                                                        />

                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRPeriodFrom}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry IsReadOnly="True"
                                                        Text="{Binding FormattedTaxperdioFromDate}"
                                                        TextColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />



                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRPeriodTo}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry IsReadOnly="True"
                                                        Text="{Binding FormattedTaxperdioToDate}"
                                                        TextColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsPenlaityAmountVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRPenality_amount_in_question}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry IsReadOnly="True"
                                                        Text="{Binding PenalityAmountInQuestion,Converter={StaticResource commaSeparatorConverter}}"
                                                        TextColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsAssessPayOptionVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRTotalTaxLiability}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry IsReadOnly="True"
                                                        Text="{Binding TotalTaxLiability}"
                                                        TextColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </Border>

                        </Grid>
                        <!--CR6490 chnages-->
                        <Grid IsVisible="{Binding IsTotalPenaltiesVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.TotalPenalties}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry IsReadOnly="True"
                                                        Text="{Binding TotalPenalities}"
                                                        TextColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsTaxPaidVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{Binding TaxPaidLable}"
                                                HorizontalOptions="StartAndExpand"
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

