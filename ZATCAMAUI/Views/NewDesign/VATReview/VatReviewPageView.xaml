<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATReview.VatReviewPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>


                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VatReview}" />


                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>


    <ContentPage.Content>

        <ScrollView
            HorizontalOptions="FillAndExpand"
            HorizontalScrollBarVisibility="Never"
            VerticalOptions="FillAndExpand"
            VerticalScrollBarVisibility="Never">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView
                        Margin="20,25,20,0"
                        Completed="{Binding MarkComplete}"
                        DotSize="12"
                        HorizontalOptions="End"
                        MaxNum="{Binding MaxIndex}"
                        MinNum="{Binding CurrentIndex}"
                        VerticalOptions="CenterAndExpand" />
                </Grid>


                <Grid Grid.Row="1" VerticalOptions="FillAndExpand">


                    <!--  Review Reason  -->

                    <StackLayout
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding ReviewReasonVisible}"
                        VerticalOptions="FillAndExpand">


                        <Grid Grid.Row="0" Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.VRReviewReason}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,-10,0,15"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,10">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                FontFamily="{StaticResource SomarLight}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VRReviewReason}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>


                            <Border
                                Grid.Row="1"
                                Margin="0,5,0,0"
                                Padding="10,0,10,0"
                                HorizontalOptions="FillAndExpand"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 12,12,12,12">
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal"
                                    VerticalOptions="CenterAndExpand">
                                    <Label
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="False"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding ReviewReason}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        Margin="12"
                                        HeightRequest="24"
                                        Source="arrowDropdown.png"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="24">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ReviewReasonCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Border>



                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,10">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                FontFamily="{StaticResource SomarLight}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VRReviewSubReason}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Border
                                Grid.Row="1"
                                Margin="0,5,0,0"
                                Padding="10,0,10,0"
                                HorizontalOptions="FillAndExpand"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 12,12,12,12">
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal"
                                    VerticalOptions="CenterAndExpand">
                                    <Label
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="False"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SubReviewReason}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        Margin="12"
                                        HeightRequest="24"
                                        Source="arrowDropdown.png"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="24">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SubReviewReasonCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Border>


                        </Grid>

                        <Grid Grid.Row="3" Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                FontFamily="{StaticResource SomarLight}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VRApplicationReferenceNumber}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Border
                                Grid.Row="1"
                                Margin="0,5,0,0"
                                Padding="10,0,10,0"
                                HorizontalOptions="FillAndExpand"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 12,12,12,12">
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal"
                                    VerticalOptions="CenterAndExpand">
                                    <Label
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="False"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding ApplicationRefNumber}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        Margin="12"
                                        HeightRequest="24"
                                        Source="arrowDropdown.png"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="24">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ApplicationNumRefCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Border>


                        </Grid>
                        <Grid Grid.Row="4" Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                FontFamily="{StaticResource SomarLight}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.VRRequestDate}" />

                            <Border
                                Grid.Row="1"
                                Margin="0,5,0,0"
                                Padding="10,0,10,0"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 12,12,12,12">
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal"
                                    VerticalOptions="CenterAndExpand">
                                    <Label
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="False"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding FormattedRequestDate}"
                                        VerticalOptions="CenterAndExpand" />

                                    <Image
                                        Margin="0,0,5,0"
                                        HeightRequest="20"
                                        Source="calendar.png"
                                        WidthRequest="20" />
                                </StackLayout>
                            </Border>

                        </Grid>
                        <buttons:SfButton
                            Grid.Row="5"
                            Margin="0,16,0,16"
                            BackgroundColor="{Binding ReviewReasonButtonBackGroundColor}"
                            Command="{Binding ReviewReasonConBtnTapped}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.VRContinue}" />

                        <Label
                            Grid.Row="6"
                            Margin="10,0,10,15"
                            FontFamily="{StaticResource SomarSemiBold}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding IsApplicationVisible}"
                            Style="{StaticResource ValueLabelPrimary}"
                            Text="{Binding ViewApplicationTypeText}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewApplicationTapped}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </StackLayout>

                    <StackLayout
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding ReportDetailsVisible}"
                        VerticalOptions="FillAndExpand">
                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.VRReportDetails}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,-10,0,15"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <StackLayout Grid.Row="5" HorizontalOptions="FillAndExpand">


                            <Label
                                Grid.Row="0"
                                FontFamily="{StaticResource SomarLight}"
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.5"
                                Style="{StaticResource MicroGrayLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VATReviewRequestString}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>


                            <Border
                                Grid.Row="1"
                                Margin="0,0,0,3"
                                Padding="0,0,0,7"
                                Style="{StaticResource GreyBorderFrame}"
                                VerticalOptions="FillAndExpand">

                                <StackLayout Orientation="Vertical" VerticalOptions="FillAndExpand">

                                    <custom:GAZTBorderlessEditor
                                        x:Name="Report_Details_Tx"
                                        AutoSize="TextChanges"
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding IsReportDetailsEditable}"
                                        MaxLength="1000"
                                        MinimumHeightRequest="120"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding ReportDetails}"
                                        TextChanged="Report_Details_Tx_TextChanged"
                                        Unfocused="Report_Details_UnFocused"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>

                            </Border>


                            <Label
                                Grid.Row="2"
                                FontFamily="{StaticResource SomarRegular}"
                                HorizontalOptions="EndAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            FontFamily="{StaticResource SomarLight}"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{Binding charCountReportDetails}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                Grid.Row="3"
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.8"
                                Style="{StaticResource ButtonLabelBlackBold}"
                                Text="{x:Static ResourceManager:AppResources.VRHelperText}" />

                        </StackLayout>

                        <!--<Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">-->

                        <StackLayout
                            Margin="0,5,0,10"
                            BindableLayout.ItemsSource="{Binding AttachmentsListViewData}"
                            HorizontalOptions="FillAndExpand"
                            IsEnabled="{Binding IsDraft}"
                            VerticalOptions="StartAndExpand">


                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand">
                                        <!--<Grid.GestureRecognizers>
                                                <TapGestureRecognizer />
                                            </Grid.GestureRecognizers>-->
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Margin="0,0,0,10"
                                            Padding="12"
                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="5,0"
                                                    HeightRequest="25"
                                                    HorizontalOptions="Start"
                                                    Source="Generic_attachment_icon"
                                                    VerticalOptions="Center"
                                                    WidthRequest="25" />

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding Filename}"
                                                    VerticalOptions="FillAndExpand" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    HorizontalOptions="Center"
                                                    Rotation="90"
                                                    VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.Close}"
                                                            Size="24"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Border>


                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <!--</Grid>-->

                        <Grid
                            Margin="0,10,0,10"
                            HorizontalOptions="FillAndExpand"
                            IsEnabled="{Binding IsDraft}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                FontFamily="{StaticResource SomarRegular}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.VRNewAttachment}" />
                            <Border
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="10"
                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="Small"
                                        HorizontalOptions="FillAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                        TextColor="{StaticResource PrimaryColor}" />
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="Center"
                                        Rotation="90"
                                        VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                Size="24"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Border>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                            </Grid.GestureRecognizers>

                        </Grid>

                        <buttons:SfButton
                            Grid.Row="8"
                            Margin="0,16,0,16"
                            BackgroundColor="{Binding ReportDetailsButtonBackGroundColor}"
                            Command="{Binding ReportDetailsConBtnTapped}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.VRContinue}"
                            VerticalOptions="EndAndExpand" />

                    </StackLayout>

                    <StackLayout
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding ReviewDetailsVisible}"
                        VerticalOptions="FillAndExpand">
                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.VRReviewDetails}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,-10,0,15"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>




                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource SomarRegular}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.VRTaxPeriodofCase}" />

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                Padding="10"
                                Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry
                                    HorizontalOptions="FillAndExpand"
                                    IsReadOnly="True"
                                    InputTransparent="True"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{Binding TaxPeriodOfCase}"
                                    TextColor="{StaticResource Primary}" />

                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource SomarRegular}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.VRPeriodFrom}" />

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                Padding="10"
                                Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry
                                    HorizontalOptions="FillAndExpand"
                                    IsReadOnly="True"
                                    InputTransparent="True"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{Binding FormattedTaxperdioFromDate}"
                                    TextColor="{StaticResource Primary}" />



                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                FontFamily="{StaticResource SomarRegular}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.VRPeriodTo}" />

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                Padding="10"
                                Style="{StaticResource GreyBorderFrame}">
                                <custom:GAZTBorderlessEntry
                                    HorizontalOptions="FillAndExpand"
                                    IsReadOnly="True"
                                    InputTransparent="True"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{Binding FormattedTaxperdioToDate}"
                                    TextColor="{StaticResource Primary}" />
                            </Border>

                        </Grid>

                        <Grid IsVisible="{Binding IsPenlaityAmountVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
