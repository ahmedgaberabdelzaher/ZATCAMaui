                                                        <Label
                                                            Padding="8,0"
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text="{x:Static ResourceManager:AppResources.VRDeclaration}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="8,0"
                                                        HorizontalOptions="End">
                                                        <Label
                                                            FontSize="Medium"
                                                            Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                            Text="{x:Static ResourceManager:AppResources.CREdit}"
                                                            VerticalOptions="CenterAndExpand">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding GoBackToDeclaration}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </StackLayout>
                                                </Grid>

                                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                <StackLayout Padding="15,15,15,15">

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.VRIDType}" />
                                                        <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlack}"
                                                            Text="{Binding IDType}" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.VRIDNumber}" />
                                                        <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlack}"
                                                            Text="{Binding IDNumber}" />
                                                    </Grid>

                                                    <Grid IsVisible="{Binding IsDOBVisible}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.VRDateOfBirth}" />
                                                        <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlack}"
                                                            Text="{Binding PickedDate, StringFormat='{0:dd MMM yyyy}'}" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.VRContactPersonName}"
                                                            VerticalOptions="FillAndExpand" />
                                                        <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlack}"
                                                            Text="{Binding ContactPersonName}" />
                                                    </Grid>

                                                </StackLayout>
                                            </StackLayout>
                                        </Border>

                                        <buttons:SfButton
                                            Margin="0,5,0,85"
                                            Command="{Binding SummaryConBtnTapped}"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.Submit}"
                                            VerticalOptions="FillAndExpand" />

                                    </StackLayout>
                                </StackLayout>


                            </Grid>
                        </Grid>

                    </ScrollView>

                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>


    </ContentPage.Content>


</ContentPage>