<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATReview.VatReviewBillViewBottomPopUpPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <Border
        BackgroundColor="White"
        HorizontalOptions="End"
        IsVisible="true"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="EndAndExpand">

            <StackLayout Margin="15" VerticalOptions="FillAndExpand">

                <Image
                    HorizontalOptions="EndAndExpand"
                    Source="ic_close"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CloseTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource PageTitleBlack}"
                        Text="{x:Static ResourceManager:AppResources.VRViewBill}" />
                    <BoxView
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                </Grid>


                <Border
                    Margin="0,10,0,10"
                    Style="{StaticResource GreyBorderFrameWithShadow}"
                    VerticalOptions="FillAndExpand">
                    <StackLayout VerticalOptions="FillAndExpand">

                        <Grid
                            Padding="15"
                            ColumnDefinitions="*,auto"
                            RowDefinitions="auto"
                            RowSpacing="0"
                            VerticalOptions="FillAndExpand">

                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="8,0"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    Source="vat_user"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <Label
                                    Padding="8,0"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.VRBillDetails}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>


                        </Grid>

                        <BoxView
                            BackgroundColor="LightGray"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand" />

                        <StackLayout
                            Padding="10"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRDocumentNo}" />
                                    <Label
                                        x:Name="DocumentNumber"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRSADADNumber}" />
                                    <Label
                                        x:Name="SadadNumber"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRDateofPenalty}" />
                                    <Label
                                        x:Name="DateofPenality"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRDescriptionofPenalty}" />
                                    <Label
                                        x:Name="DescriptionOfPenality"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRPeriodKey}" />
                                    <Label
                                        x:Name="Periodkey"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRStartDate}" />
                                    <Label
                                        x:Name="StartDate"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VREndDate}" />
                                    <Label
                                        x:Name="EndDate"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35*" />
                                        <ColumnDefinition Width="65*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRDueDate}" />
                                    <Label
                                        x:Name="DueDate"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                            <StackLayout
                                Margin="0,0,0,30"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRAmount}" />
                                    <Label
                                        x:Name="Amount"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}" />
                                </Grid>
                            </StackLayout>
                        </StackLayout>

                    </StackLayout>

                </Border>

            </StackLayout>

        </ScrollView>

    </Border>

</Mopups:PopupPage>