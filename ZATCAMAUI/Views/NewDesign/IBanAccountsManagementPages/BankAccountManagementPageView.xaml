<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.IBanAccountsManagementPages.BankAccountManagementPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="BankAccountManagementPageView"
    FlowDirection="{Binding AppDirection}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />


        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        StrokeShape="RoundRectangle 15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.NDBankAccManagement}" />

                        <Image
                            x:Name="Image_BacKIcon"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <Grid>
                <Grid
                    Margin="20,32,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Margin="0,10,0,20"
                            Padding="12"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 15,15,15,15"
                            Style="{StaticResource GreyBorderFrameWithShadow}"
                            VerticalOptions="FillAndExpand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    Source="add"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="24" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.AddNewIban}"
                                    VerticalOptions="CenterAndExpand" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddNewIBANTapped}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <Grid
                            Grid.Row="1"
                            Margin="0,0,0,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <listView:SfListView
                                x:Name="outletDecisionOptionsListView"
                                Grid.Row="0"
                                Grid.Column="0"
                                AutoFitMode="Height"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                ItemSpacing="5"
                                ItemsSource="{Binding MainListData}"
                                ScrollBarVisibility="Never"
                                SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                SelectionBackground="Transparent"
                                SelectionMode="Single"
                                VerticalOptions="FillAndExpand">

                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Grid.Column="0"
                                            Margin="0,15,0,0"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 15,15,15,15"
                                            Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Padding="0" Spacing="0">
                                                <Grid Padding="10" RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>



                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="0,4"
                                                        HorizontalOptions="Start">
                                                        <Label
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANRefNum}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,-10"
                                                            HorizontalOptions="End"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Fbnum}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="5"
                                                        HorizontalOptions="End"
                                                        IsVisible="{Binding isUpdateDisabled}">

                                                        <Border
                                                            Grid.Row="0"
                                                            Padding="16,8,16,8"
                                                            BackgroundColor="Gray"
                                                            StrokeShape="RoundRectangle 14,14,14,14"
                                                            HeightRequest="20"
                                                            HorizontalOptions="FillAndExpand"
                                                            Opacity=".8">
                                                            <StackLayout
                                                                Grid.Row="0"
                                                                HorizontalOptions="CenterAndExpand"
                                                                VerticalOptions="Center">

                                                                <Label
                                                                    HorizontalOptions="CenterAndExpand"
                                                                    Style="{StaticResource CaptionLabelWhite}"
                                                                    Text="{Binding StatusText}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>
                                                        </Border>


                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="StatusViewButtons_Tapped" />
                                                        </StackLayout.GestureRecognizers>

                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="5"
                                                        HorizontalOptions="End"
                                                        IsVisible="{Binding isUpdateEnabled}">

                                                        <Border
                                                            Grid.Row="0"
                                                            Padding="16,8,16,8"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            StrokeShape="RoundRectangle 14,14,14,14"
                                                            HeightRequest="20"
                                                            HorizontalOptions="FillAndExpand"
                                                            Opacity=".8">
                                                            <Border.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding StatusText}"
                                                                    TargetType="Border"
                                                                    Value="{x:Static ResourceManager:AppResources.IBanDeactivate}">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding StatusText}"
                                                                    TargetType="Border"
                                                                    Value="{x:Static ResourceManager:AppResources.IBANUpdate}">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding StatusText}"
                                                                    TargetType="Border"
                                                                    Value="{x:Static ResourceManager:AppResources.IBanActivate}">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <StackLayout
                                                                Grid.Row="0"
                                                                HorizontalOptions="CenterAndExpand"
                                                                VerticalOptions="Center">

                                                                <Label
                                                                    HorizontalOptions="CenterAndExpand"
                                                                    Style="{StaticResource CaptionLabelWhite}"
                                                                    Text="{Binding StatusText}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>
                                                        </Border>


                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="StatusViewButtons_Tapped" />
                                                        </StackLayout.GestureRecognizers>

                                                    </StackLayout>



                                                    <BoxView
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,5"
                                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,4">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANAccName}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,-10"
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Koinh}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>



                                                    <StackLayout
                                                        Grid.Row="5"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,4">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANIdType}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,-10"
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding IdtypeDesc}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="6"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,4">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANIdNumber}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,-10"
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Idnumber}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="4"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,4">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBAN}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,-10"
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Iban}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,4">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANBankName}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,-10"
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Bkext}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="7"
                                                        Grid.Column="0"
                                                        Margin="0,4"
                                                        HorizontalOptions="Start">
                                                        <Label
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANStatus}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,-10"
                                                            HorizontalOptions="End"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding StatusDesc}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <!--<StackLayout Grid.Row="5" Grid.ColumnSpan="3" Margin="0,4">
                                    <Label Text="{x:Static ResourceManager:AppResources.IBANIdType}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                    <Label Text="{Binding IdtypeDesc}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                </StackLayout>-->


                                                </Grid>

                                            </StackLayout>
                                        </Border>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                        </Grid>
                    </Grid>

                </Grid>
                <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForLanding"
                                AnimationType="Cupertino"
                                HeightRequest="70"
                                HorizontalOptions="CenterAndExpand"
                                IndicatorColor="{StaticResource Secondary}"
                                IsRunning="True"
                                SizeFactor="0.6"
                                TitlePlacement="Bottom"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="70" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
        </ScrollView>

    </ContentPage.Content>
</ContentPage>
