<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZATCAMAUI.Views.NewDesign.IBanAccountsManagementPages.BankAccountManagementPageView"
    Title="BankAccountManagementPageView"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    FlowDirection="{Binding AppDirection}">

   <ContentPage.Resources>
    <ResourceDictionary>
        <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
            <Setter Property="Rotation" Value="180" />
        </Style>
        <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
            <Setter Property="Rotation" Value="0" />
        </Style>
        <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

      
    </ResourceDictionary>
</ContentPage.Resources>

<ContentPage.ControlTemplate>
    <ControlTemplate>
        <Grid BackgroundColor="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="1" BackgroundColor="Black" StrokeShape="RoundRectangle 15,15,0,0" Padding="0">
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                          Padding="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter VerticalOptions="FillAndExpand"
                                          HorizontalOptions="FillAndExpand"
                                          Grid.Column="0"
                                          Grid.Row="0" BackgroundColor="White" />
                    </Grid>
                </Border>
                <Grid Padding="15,5,15,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="60*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.NDBankAccManagement}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="StartAndExpand"/>

                    <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                           Source="arrowLeftwhite" x:Name="Image_BacKIcon"  Style="{DynamicResource BackButtonArrow}" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}"/>
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Grid>
        </Grid>
    </ControlTemplate>
</ContentPage.ControlTemplate>

<ContentPage.Content>
    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

        <Grid>
            <Grid  BackgroundColor="Transparent"  Margin="20,32,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1"   BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" StrokeShape="RoundRectangle 15,15,15,15" Margin="0,10,0,20" HorizontalOptions="FillAndExpand" Padding="12"  Style="{StaticResource GreyBorderFrameWithShadow}" VerticalOptions="FillAndExpand">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Row="0" Grid.Column="0" Source="add" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" VerticalOptions="CenterAndExpand"></Image>
                            <Label Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.AddNewIban}" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" FontSize="16" VerticalOptions="CenterAndExpand"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddNewIBANTapped}"></TapGestureRecognizer>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,0"  BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <listView:SfListView  x:Name="outletDecisionOptionsListView" HorizontalOptions="FillAndExpand" ScrollBarVisibility="Never"  VerticalOptions="FillAndExpand" Grid.Row="0"  Grid.Column="0" AutoFitMode="Height" ItemSpacing="5"
                                  ItemsSource="{Binding MainListData}"  BackgroundColor="Transparent" 
                        SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}" SelectionMode="Single" SelectionBackground="Transparent">

                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10"  Grid.Column="0" CornerRadius="15" Margin="0,15,0,0"
                                                     HasShadow="True" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0" Spacing="0" >
                                            <Grid  Padding="10" RowSpacing="0" >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>



                                                <StackLayout Grid.Row="0" Grid.Column="0" Margin="0,4" HorizontalOptions="Start">
                                                    <Label Text="{x:Static ResourceManager:AppResources.IBANRefNum}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"></Label>
                                                    <Label Text="{Binding Fbnum}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="End"></Label>
                                                </StackLayout>

                                                <StackLayout IsVisible="{Binding isUpdateDisabled}" Margin="5" Grid.Row="0" Grid.Column="1" HorizontalOptions="End">

                                                    <Frame Grid.Row="0" 
                                                       HorizontalOptions="FillAndExpand"
                                                Padding="16,8,16,8" CornerRadius="14"
                                                HeightRequest="20" Opacity=".8" BackgroundColor="Gray"
                                                 HasShadow="False" >
                                                        <StackLayout Grid.Row="0"  HorizontalOptions="CenterAndExpand" VerticalOptions="Center">
                                                           
                                                            <Label Style="{StaticResource CaptionLabelWhite}" 
                                                                         Text="{Binding StatusText}" HorizontalOptions="CenterAndExpand"  
                                                                            VerticalOptions="CenterAndExpand" >

                                                            </Label>
                                                        </StackLayout>
                                                    </Frame>


                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Tapped="StatusViewButtons_Tapped">
                                                        </TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>

                                                </StackLayout>

                                                <StackLayout IsVisible="{Binding isUpdateEnabled}" Margin="5" Grid.Row="0" Grid.Column="1" HorizontalOptions="End">

                                                    <Frame Grid.Row="0" 
                                                       HorizontalOptions="FillAndExpand"
                                                Padding="16,8,16,8" CornerRadius="14"
                                                HeightRequest="20" Opacity=".8" BackgroundColor="{StaticResource Primary}"
                                                 HasShadow="False" >
                                                        <Frame.Triggers>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.IBanDeactivate}">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.IBANUpdate}">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding StatusText}" Value="{x:Static ResourceManager:AppResources.IBanActivate}">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                            </DataTrigger>
                                                        </Frame.Triggers>
                                                        <StackLayout Grid.Row="0"  HorizontalOptions="CenterAndExpand" VerticalOptions="Center">
                                                          
                                                            <Label Style="{StaticResource CaptionLabelWhite}" 
                                                                         Text="{Binding StatusText}" HorizontalOptions="CenterAndExpand"  
                                                                            VerticalOptions="CenterAndExpand" >

                                                            </Label>
                                                        </StackLayout>
                                                    </Frame>


                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Tapped="StatusViewButtons_Tapped">
                                                        </TapGestureRecognizer>
                                                    </StackLayout.GestureRecognizers>

                                                </StackLayout>



                                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}" Margin="0,5" />

                                                <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4">
                                                    <Label Text="{x:Static ResourceManager:AppResources.IBANAccName}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    <Label Text="{Binding Koinh}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                </StackLayout>



                                                <StackLayout Grid.Row="5"  Grid.ColumnSpan="2"  Margin="0,4">
                                                    <Label Text="{x:Static ResourceManager:AppResources.IBANIdType}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    <Label Text="{Binding IdtypeDesc}"  Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                </StackLayout>

                                                <StackLayout Grid.Row="6" Grid.ColumnSpan="2" Margin="0,4">
                                                    <Label Text="{x:Static ResourceManager:AppResources.IBANIdNumber}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    <Label Text="{Binding Idnumber}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                </StackLayout>
                                                <StackLayout Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4">
                                                    <Label Text="{x:Static ResourceManager:AppResources.IBAN}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    <Label Text="{Binding Iban}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                </StackLayout>
                                                <StackLayout Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4">
                                                    <Label Text="{x:Static ResourceManager:AppResources.IBANBankName}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                    <Label Text="{Binding Bkext}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                                </StackLayout>

                                                <StackLayout Grid.Row="7" Grid.Column="0" Margin="0,4" HorizontalOptions="Start">
                                                    <Label Text="{x:Static ResourceManager:AppResources.IBANStatus}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"></Label>
                                                    <Label Text="{Binding StatusDesc}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="End"></Label>
                                                </StackLayout>

                                                <!--<StackLayout Grid.Row="5" Grid.ColumnSpan="3" Margin="0,4">
                                    <Label Text="{x:Static ResourceManager:AppResources.IBANIdType}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                    <Label Text="{Binding IdtypeDesc}" Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                                </StackLayout>-->


                                            </Grid>

                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>

                    </Grid>
                </Grid>

            </Grid>
            <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                             Opacity="0.4" VerticalOptions="FillAndExpand" />
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                             Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                             <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForLanding"
                                                        AnimationType="Cupertino"
                                                        HeightRequest="70"
                                                        HorizontalOptions="CenterAndExpand"
                                                        IndicatorColor="{StaticResource Secondary}"
                                                        IsRunning="True"
                                                        SizeFactor="0.6"
                                                        TitlePlacement="Bottom"
                                                        VerticalOptions="CenterAndExpand"
                                                        WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ScrollView>

</ContentPage.Content>
</ContentPage>
