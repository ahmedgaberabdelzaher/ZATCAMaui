<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.IBanAccountsManagementPages.BankAccountManagementPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="page"
    Title="BankAccountManagementPageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDBankAccManagement}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <ScrollView HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                        <StackLayout
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            Spacing="30"
                            VerticalOptions="FillAndExpand">

                            <Border
                                HorizontalOptions="FillAndExpand"
                                StrokeShape="RoundRectangle 15,15,15,15"
                                Style="{StaticResource GreyBorderFrameWithShadow}"
                                VerticalOptions="Start">

                                <StackLayout Orientation="Horizontal"
                                             Padding="10">

                                    <Image
                                        HeightRequest="24"
                                        HorizontalOptions="Start"
                                        Source="add"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="24" />

                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                        Text="{x:Static ResourceManager:AppResources.AddNewIban}"
                                        VerticalOptions="CenterAndExpand" />

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddNewIBANTapped}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>

                            </Border>

                            <Grid
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <listView:SfListView
                                    x:Name="outletDecisionOptionsListView"
                                    AutoFitMode="Height"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding MainListData}"
                                    ScrollBarVisibility="Never"
                                    SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                    SelectionBackground="Transparent"
                                    SelectionMode="Single"
                                    VerticalOptions="FillAndExpand">

                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>

                                            <Border
                                                Padding="10"
                                                StrokeShape="RoundRectangle 15,15,15,15"
                                                Style="{StaticResource GreyBorderFrameWithShadow}">

                                               <Grid RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto"
                                                     ColumnDefinitions="*,auto"
                                                     RowSpacing="0">

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        HorizontalOptions="Start">
                                                        <Label
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANRefNum}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            HorizontalOptions="End"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Fbnum}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="End"
                                                        IsVisible="{Binding isUpdateDisabled}">

                                                        <Border
                                                            Grid.Row="0"
                                                            BackgroundColor="Gray"
                                                            Padding="6"
                                                            HorizontalOptions="FillAndExpand"
                                                            Opacity=".8"
                                                            StrokeShape="RoundRectangle 14,14,14,14">
                                                            <StackLayout
                                                                HorizontalOptions="CenterAndExpand"
                                                                VerticalOptions="Center">

                                                                <Label
                                                                    HorizontalOptions="CenterAndExpand"
                                                                    Style="{StaticResource CaptionLabelWhite}"
                                                                    Text="{Binding StatusText}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>
                                                        </Border>


                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="StatusViewButtons_Tapped" />
                                                        </StackLayout.GestureRecognizers>

                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="End"
                                                        IsVisible="{Binding isUpdateEnabled}">

                                                        <Border
                                                            BackgroundColor="{StaticResource Primary}"
                                                            HorizontalOptions="FillAndExpand"
                                                            Opacity=".8"
                                                            Padding="6"
                                                            StrokeShape="RoundRectangle 14,14,14,14">
                                                            <Border.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding StatusText}"
                                                                    TargetType="Border"
                                                                    Value="{x:Static ResourceManager:AppResources.IBanDeactivate}">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding StatusText}"
                                                                    TargetType="Border"
                                                                    Value="{x:Static ResourceManager:AppResources.IBANUpdate}">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding StatusText}"
                                                                    TargetType="Border"
                                                                    Value="{x:Static ResourceManager:AppResources.IBanActivate}">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <StackLayout
                                                                Grid.Row="0"
                                                                HorizontalOptions="CenterAndExpand"
                                                                VerticalOptions="Center">

                                                                <Label
                                                                    HorizontalOptions="CenterAndExpand"
                                                                    Style="{StaticResource CaptionLabelWhite}"
                                                                    Text="{Binding StatusText}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>
                                                        </Border>


                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="StatusViewButtons_Tapped" />
                                                        </StackLayout.GestureRecognizers>

                                                    </StackLayout>

                                                    <BoxView
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,5"
                                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANAccName}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Koinh}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="5"
                                                        Grid.ColumnSpan="2">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANIdType}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding IdtypeDesc}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="6"
                                                        Grid.ColumnSpan="2">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANIdNumber}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Idnumber}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="4"
                                                        Grid.ColumnSpan="2">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBAN}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Iban}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.ColumnSpan="2">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANBankName}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Bkext}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="7"
                                                        Grid.Column="0"
                                                        HorizontalOptions="Start">
                                                        <Label
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IBANStatus}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            HorizontalOptions="End"
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding StatusDesc}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                </Grid>
                                            </Border>

                                        </DataTemplate>

                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>

                            </Grid>

                        </StackLayout>

                    </ScrollView>


                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>



    </ContentPage.Content>
</ContentPage>
