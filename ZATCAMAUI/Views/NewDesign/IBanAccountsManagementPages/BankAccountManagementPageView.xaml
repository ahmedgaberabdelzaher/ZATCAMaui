<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.IBanAccountsManagementPages.BankAccountManagementPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    Title="BankAccountManagementPageView"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDBankAccManagement}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

              <Grid RowDefinitions="*">

                  <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <Grid>
                        <Grid
                            Margin="20,32,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                Grid.Row="1"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Margin="0,10,0,20"
                                    Padding="12"
                                    HorizontalOptions="FillAndExpand"
                                    StrokeShape="RoundRectangle 15,15,15,15"
                                    Style="{StaticResource GreyBorderFrameWithShadow}"
                                    VerticalOptions="FillAndExpand">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="add"
                                            VerticalOptions="CenterAndExpand"
                                            WidthRequest="24" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontSize="16"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.AddNewIban}"
                                            VerticalOptions="CenterAndExpand" />
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AddNewIBANTapped}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Border>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,0,0,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">

                                    <listView:SfListView
                                        x:Name="outletDecisionOptionsListView"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        AutoFitMode="Height"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="FillAndExpand"
                                        ItemSpacing="5"
                                        ItemsSource="{Binding MainListData}"
                                        ScrollBarVisibility="Never"
                                        SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                        SelectionBackground="Transparent"
                                        SelectionMode="Single"
                                        VerticalOptions="FillAndExpand">

                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Grid.Column="0"
                                                    Margin="0,15,0,0"
                                                    Padding="10"
                                                    StrokeShape="RoundRectangle 15,15,15,15"
                                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                                    <StackLayout Padding="0" Spacing="0">
                                                        <Grid Padding="10" RowSpacing="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>



                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="0,4"
                                                                HorizontalOptions="Start">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.IBANRefNum}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <Label
                                                                    Margin="0,-10"
                                                                    HorizontalOptions="End"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding Fbnum}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Margin="5"
                                                                HorizontalOptions="End"
                                                                IsVisible="{Binding isUpdateDisabled}">

                                                                <Border
                                                                    Grid.Row="0"
                                                                    Padding="16,8,16,8"
                                                                    BackgroundColor="Gray"
                                                                    StrokeShape="RoundRectangle 14,14,14,14"
                                                                    HeightRequest="20"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Opacity=".8">
                                                                    <StackLayout
                                                                        Grid.Row="0"
                                                                        HorizontalOptions="CenterAndExpand"
                                                                        VerticalOptions="Center">

                                                                        <Label
                                                                            HorizontalOptions="CenterAndExpand"
                                                                            Style="{StaticResource CaptionLabelWhite}"
                                                                            Text="{Binding StatusText}"
                                                                            VerticalOptions="CenterAndExpand" />
                                                                    </StackLayout>
                                                                </Border>


                                                                <StackLayout.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="StatusViewButtons_Tapped" />
                                                                </StackLayout.GestureRecognizers>

                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Margin="5"
                                                                HorizontalOptions="End"
                                                                IsVisible="{Binding isUpdateEnabled}">

                                                                <Border
                                                                    Grid.Row="0"
                                                                    Padding="16,8,16,8"
                                                                    BackgroundColor="{StaticResource Primary}"
                                                                    StrokeShape="RoundRectangle 14,14,14,14"
                                                                    HeightRequest="20"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Opacity=".8">
                                                                    <Border.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding StatusText}"
                                                                            TargetType="Border"
                                                                            Value="{x:Static ResourceManager:AppResources.IBanDeactivate}">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger
                                                                            Binding="{Binding StatusText}"
                                                                            TargetType="Border"
                                                                            Value="{x:Static ResourceManager:AppResources.IBANUpdate}">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger
                                                                            Binding="{Binding StatusText}"
                                                                            TargetType="Border"
                                                                            Value="{x:Static ResourceManager:AppResources.IBanActivate}">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                                        </DataTrigger>
                                                                    </Border.Triggers>
                                                                    <StackLayout
                                                                        Grid.Row="0"
                                                                        HorizontalOptions="CenterAndExpand"
                                                                        VerticalOptions="Center">

                                                                        <Label
                                                                            HorizontalOptions="CenterAndExpand"
                                                                            Style="{StaticResource CaptionLabelWhite}"
                                                                            Text="{Binding StatusText}"
                                                                            VerticalOptions="CenterAndExpand" />
                                                                    </StackLayout>
                                                                </Border>


                                                                <StackLayout.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="StatusViewButtons_Tapped" />
                                                                </StackLayout.GestureRecognizers>

                                                            </StackLayout>



                                                            <BoxView
                                                                Grid.Row="1"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,5"
                                                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                            <StackLayout
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,4">
                                                                <Label
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.IBANAccName}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <Label
                                                                    Margin="0,-10"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding Koinh}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>



                                                            <StackLayout
                                                                Grid.Row="5"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,4">
                                                                <Label
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.IBANIdType}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <Label
                                                                    Margin="0,-10"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding IdtypeDesc}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="6"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,4">
                                                                <Label
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.IBANIdNumber}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <Label
                                                                    Margin="0,-10"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding Idnumber}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>
                                                            <StackLayout
                                                                Grid.Row="4"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,4">
                                                                <Label
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.IBAN}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <Label
                                                                    Margin="0,-10"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding Iban}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>
                                                            <StackLayout
                                                                Grid.Row="3"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,4">
                                                                <Label
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.IBANBankName}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <Label
                                                                    Margin="0,-10"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding Bkext}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="7"
                                                                Grid.Column="0"
                                                                Margin="0,4"
                                                                HorizontalOptions="Start">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.IBANStatus}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <Label
                                                                    Margin="0,-10"
                                                                    HorizontalOptions="End"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding StatusDesc}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>

                                                        </Grid>

                                                    </StackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>

                                </Grid>
                            </Grid>

                        </Grid>
                        
                    </Grid>

                </ScrollView>


              </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

      

    </ContentPage.Content>
</ContentPage>
