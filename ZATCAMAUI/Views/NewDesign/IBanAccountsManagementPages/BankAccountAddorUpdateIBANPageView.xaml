<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZATCAMAUI.Views.NewDesign.IBanAccountsManagementPages.BankAccountAddorUpdateIBANPageView"
    Title="BankAccountAddorUpdateIBANPageView"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    FlowDirection="{Binding AppDirection}">

 <ContentPage.Resources>
     <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
             <ResourceDictionary>
                 <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                     <Setter Property="Rotation" Value="180" />
                 </Style>
                 <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                     <Setter Property="Rotation" Value="0" />
                 </Style>
             </ResourceDictionary>
         </ResourceDictionary.MergedDictionaries>
     </ResourceDictionary>
 </ContentPage.Resources>
 <ContentPage.ControlTemplate>
     <ControlTemplate>


         <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

             <StackLayout>
                 <Grid Padding="15,5,15,5">
                     <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                     </Grid.RowDefinitions>
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="20*"/>
                         <ColumnDefinition Width="60*"/>
                         <ColumnDefinition Width="20*"/>
                     </Grid.ColumnDefinitions>

                     <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.AddNewIban}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                     <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                            Source="arrowLeftwhite" x:Name="Image_BacKIcon"  Style="{DynamicResource BackButtonArrow}" >
                         <Image.GestureRecognizers>
                             <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}"/>
                         </Image.GestureRecognizers>
                     </Image>
                 </Grid>
                 <Border  VerticalOptions="FillAndExpand" StrokeShape="RoundRectangle 14,14,0,0" Padding="0">
                     <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
               Padding="0,0,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                         <Grid.RowDefinitions>
                             <RowDefinition Height="100*" />
                         </Grid.RowDefinitions>
                         <ContentPresenter VerticalOptions="FillAndExpand"
                     HorizontalOptions="FillAndExpand"
                     Grid.Column="0"
                     Grid.Row="0" BackgroundColor="White"/>
                     </Grid>
                 </Border>
             </StackLayout>

         </Grid>
     </ControlTemplate>
 </ContentPage.ControlTemplate>

 <ContentPage.Content>

     <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
         <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
             <Grid.RowDefinitions>
                 <RowDefinition Height="auto"/>
                 <RowDefinition Height="*"/>
             </Grid.RowDefinitions>
             <Grid Grid.Row="0">
                 <commonView:PageIndicatorView Margin="20,32,20,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand" DotSize="16"/>
             </Grid>
             <Grid Grid.Row="1" IsVisible="{Binding NewFormVisible}">
                 <Grid  BackgroundColor="Transparent" Margin="20,0,20,0"
                   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="24">
                     <Grid.RowDefinitions>
                         <RowDefinition Height="auto" />
                         <RowDefinition Height="80" />
                         <RowDefinition Height="80" />
                         <RowDefinition Height="80" />
                         <RowDefinition Height="80" />
                         <RowDefinition Height="80" />
                         <RowDefinition Height="80" />
                         <RowDefinition Height="80" />
                         <RowDefinition Height="*" />
                         <RowDefinition Height="80" />
                     </Grid.RowDefinitions>

                     <Grid Grid.Row="0" >
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>
                         <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                         Text="{x:Static ResourceManager:AppResources.CRRequestDetails}"
                                         HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource PageTitleBlack}" />
                         <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                         Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}"
                                         HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource BodyLabelGrey}" />
                         <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                     </Grid>

                     <Grid Grid.Row="1" WidthRequest="171">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>


                         <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                             <custom:CustomLabel.FormattedText>
                                 <FormattedString>
                                     <Span Text="{x:Static ResourceManager:AppResources.IBANAccName}"  />
                                     <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                 </FormattedString>
                             </custom:CustomLabel.FormattedText>
                         </custom:CustomLabel>

                         <Border Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}" Stroke="{Binding IsBorderColorRed}">
                             <custom:GAZTBorderlessEntry x:Name="AccountOwnerName" IsEnabled="{Binding isNameEnabled}" 
                                                 HorizontalOptions="FillAndExpand"
                                                         Text="{Binding AccountOwnerName}"
                                                         TextChanged="AccountOwnerNameTextChanged" Unfocused="AccountOwnerName_Unfocused"
                                                         TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SomarRegular}" FontSize="15"/>
                         </Border>

                     </Grid>


                     <Grid Grid.Row="2">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>
                         <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                         HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource ValueLabelBlack}" >
                             <custom:CustomLabel.FormattedText>
                                 <FormattedString>
                                     <Span Text="{x:Static ResourceManager:AppResources.IBANIdType}"  />
                                     <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                 </FormattedString>
                             </custom:CustomLabel.FormattedText>
                         </custom:CustomLabel>

                         <Border Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                             <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="auto" />
                                 </Grid.RowDefinitions>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="auto" />
                                 </Grid.ColumnDefinitions>
                                 <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedIDType}"
                                                 HorizontalOptions="FillAndExpand"
                                                 Style="{StaticResource BodyLabelBlack}" />

                                 <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                     <Image.Source>
                                         <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                      Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                     </Image.Source>
                                     <Image.GestureRecognizers>
                                         <TapGestureRecognizer Command="{Binding ShowIDTypePicker}"/>
                                     </Image.GestureRecognizers>
                                 </Image>


                             </Grid>
                         </Border>

                     </Grid>


                     <Grid Grid.Row="3">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>
                         <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                         HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource ValueLabelBlack}" >
                             <custom:CustomLabel.FormattedText>
                                 <FormattedString>
                                     <Span Text="{Binding IdNumberTitle}"/>
                                     <Span Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                 </FormattedString>
                             </custom:CustomLabel.FormattedText>
                         </custom:CustomLabel>

                         <Border Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                             <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="30" />
                                 </Grid.RowDefinitions>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="auto" />
                                 </Grid.ColumnDefinitions>
                                 <custom:GAZTBorderlessEntry Grid.Row="0" Grid.Column="0" x:Name="EntryIDNumber"  Text="{Binding SelectedIDNumber}"
                                                 HorizontalOptions="FillAndExpand" 
                                                         Unfocused="EntryIDNumber_Unfocused" 
                                                 Style="{StaticResource BodyLabelBlack}" IsEnabled="{Binding isNameEnabled}" />

                                 <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" IsVisible="{Binding IsDropdownVisibile}">
                                     <Image.Source>
                                         <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                      Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                     </Image.Source>
                                     <Image.GestureRecognizers>
                                         <TapGestureRecognizer Command="{Binding ShowIDNumberPicker}"/>
                                     </Image.GestureRecognizers>
                                 </Image>


                             </Grid>
                         </Border>

                     </Grid>
                     <StackLayout Margin="0,0,0,15" Grid.Row="4">
                         <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,20,15,20" HasShadow="False">
                             <StackLayout>
                                 <Grid >
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="auto"/>

                                     </Grid.RowDefinitions>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="20"/>
                                         <ColumnDefinition Width="*"/>
                                     </Grid.ColumnDefinitions>
                                     <Image Style="{StaticResource SmallIcon}" HorizontalOptions="Start" Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
                                         <Image.Source>
                                             <FontImageSource FontFamily="UserIconFont" Color="#909090" Size="30"
                                                     Glyph="{x:Static FontImage:IconFonts.Information}"/>
                                         </Image.Source>
                                     </Image>
                                     <Label HorizontalTextAlignment="Start" Grid.Column="1" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.IBANRefundInfo}" />
                                 </Grid>
                             </StackLayout>
                         </Frame>
                     </StackLayout>
                     <StackLayout Margin="0,0,0,15" Grid.Row="5" IsVisible="{Binding IsIdInfoVisibility}">
                         <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,20,15,20" HasShadow="False">
                             <StackLayout>
                                 <Grid >
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="auto"/>

                                     </Grid.RowDefinitions>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="20"/>
                                         <ColumnDefinition Width="*"/>
                                     </Grid.ColumnDefinitions>
                                     <Image Style="{StaticResource SmallIcon}" HorizontalOptions="Start" Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
                                         <Image.Source>
                                             <FontImageSource FontFamily="UserIconFont" Color="#909090" Size="30"
                                                     Glyph="{x:Static FontImage:IconFonts.Information}"/>
                                         </Image.Source>
                                     </Image>
                                     <Label HorizontalTextAlignment="Start" Grid.Column="1" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" Text="{Binding IdNumberInfo}" />
                                 </Grid>
                             </StackLayout>
                         </Frame>
                     </StackLayout>

                     <Grid Grid.Row="6" WidthRequest="171">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>


                         <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                             <custom:CustomLabel.FormattedText>
                                 <FormattedString>
                                     <Span Text="{x:Static ResourceManager:AppResources.IBAN}"  />
                                     <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                 </FormattedString>
                             </custom:CustomLabel.FormattedText>
                         </custom:CustomLabel>

                         <Border Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                             <custom:GAZTBorderlessEntry x:Name="BankAccountIBAN"
                                                 HorizontalOptions="FillAndExpand"
                                                          TextChanged="IBANTextChanged"
                                                         Text="{Binding IBANValue}"
                                                         Unfocused="IBANFocusChnaged"
                                                         TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SomarRegular}" FontSize="15">
                                 <custom:GAZTBorderlessEntry.Behaviors>
                                     <behaviors:EntryLengthValidatorBehavior MaxLength="24"/>
                                 </custom:GAZTBorderlessEntry.Behaviors>
                             </custom:GAZTBorderlessEntry>
                         </Border>

                     </Grid>

                     <Grid Grid.Row="7" IsEnabled="{Binding IsIBanDropDownEnabled}" >
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>
                         <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                         HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource ValueLabelBlack}" >
                             <custom:CustomLabel.FormattedText>
                                 <FormattedString>
                                     <Span Text="{x:Static ResourceManager:AppResources.IBANBankName}"  />
                                     <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                 </FormattedString>
                             </custom:CustomLabel.FormattedText>
                         </custom:CustomLabel>

                         <Border Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                             <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="auto" />
                                 </Grid.RowDefinitions>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="auto" />
                                 </Grid.ColumnDefinitions>
                                 <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedBankNameField}"
                                                 HorizontalOptions="FillAndExpand"
                                                 Style="{StaticResource BodyLabelBlack}" />

                                 <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                     <Image.Source>
                                         <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                      Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                     </Image.Source>
                                     <Image.GestureRecognizers>
                                         <TapGestureRecognizer Command="{Binding ShowBankNamePicker}"/>
                                     </Image.GestureRecognizers>
                                 </Image>


                             </Grid>
                         </Border>

                     </Grid>
                     <!--Attachment 1-->
                     <Grid Grid.Row="8" IsVisible="{Binding AttachmentVisible}">

                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="*" />
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="*" />
                         </Grid.RowDefinitions>
                         <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                           ScrollBarVisibility="Never" IsScrollingEnabled="False"
                                           VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                           ItemsSource="{Binding IBANBankListViewDataOne}"
                                           TapCommand="{Binding OnAttachmentClickOne}"
                                           SelectionMode="SingleDeselect" SelectionBackground="Transparent">
                             <listView:SfListView.ItemTemplate>
                                 <DataTemplate>
                                     <Grid HorizontalOptions="FillAndExpand">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="auto" />
                                             <RowDefinition Height="auto" />
                                         </Grid.RowDefinitions>

                                         <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                      Style="{StaticResource SfStyleGreyBorderFrame}">
                                             <Grid>
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="auto" />
                                                 </Grid.RowDefinitions>

                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="auto" />
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="auto" />
                                                 </Grid.ColumnDefinitions>
                                                 <Image Grid.Row="0" Grid.Column="0" Source="newui_ic_pdf" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                    HorizontalOptions="Start" VerticalOptions="Center"/>

                                                 <Label Grid.Row="0" Grid.Column="1"
                                                            Text="{Binding Filename}"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            HorizontalOptions="FillAndExpand"
                                                            VerticalOptions="Center"/>

                                                 <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Rotation="90">
                                                     <Image.Source>
                                                         <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}"
                                                                      Size="24"
                                                                      Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                     </Image.Source>
                                                 </Image>
                                             </Grid>
                                         </Border>
                                     </Grid>
                                 </DataTemplate>
                             </listView:SfListView.ItemTemplate>
                         </listView:SfListView>
                         <Grid Grid.Row="1" HorizontalOptions="FillAndExpand">
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                             </Grid.RowDefinitions>
                             <custom:CustomLabel Grid.Row="0"
                                                     FontFamily="{StaticResource SomarBold}"
                                                     HorizontalOptions="StartAndExpand" FontSize="15" 
                                         Style="{StaticResource MicroGrayLabelStyle}" TextColor="{StaticResource PrimaryColor}">
                                 <custom:CustomLabel.FormattedText>
                                     <FormattedString>
                                         <Span Text="{x:Static ResourceManager:AppResources.IBANAttachment1}"  />
                                         <Span  Text=" *" Style="{StaticResource MandatoryRedColorLabel}" />
                                     </FormattedString>
                                 </custom:CustomLabel.FormattedText>
                             </custom:CustomLabel>
                             <Border Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                      Style="{StaticResource SfStyleGreyBorderFrame}">
                                 <Grid>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="auto" />
                                     </Grid.RowDefinitions>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="auto" />
                                     </Grid.ColumnDefinitions>
                                     <custom:CustomLabel Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource SomarRegular}"
                                                 Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                 FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                 HorizontalOptions="FillAndExpand" />
                                     <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                    Rotation="90">
                                         <Image.Source>
                                             <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}" Size="24"
                                                      Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                         </Image.Source>
                                     </Image>
                                 </Grid>
                             </Border>
                             <Grid.GestureRecognizers>
                                 <TapGestureRecognizer Command="{Binding OnAttachmentClickOne}" />
                             </Grid.GestureRecognizers>
                         </Grid>
                         <!--Attachment 2-->
                         <listView:SfListView Grid.Row="3" HorizontalOptions="Center"
                                           ScrollBarVisibility="Never" IsScrollingEnabled="False"
                                           VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                           ItemsSource="{Binding IBANBankListViewDataTwo}"
                                           TapCommand="{Binding OnAttachmentClickTwo}"
                                           SelectionMode="SingleDeselect" SelectionBackground="Transparent">
                             <listView:SfListView.ItemTemplate>
                                 <DataTemplate>
                                     <Grid HorizontalOptions="FillAndExpand">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="auto" />
                                             <RowDefinition Height="auto" />
                                         </Grid.RowDefinitions>

                                         <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                      Style="{StaticResource SfStyleGreyBorderFrame}">
                                             <Grid>
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="auto" />
                                                 </Grid.RowDefinitions>

                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="auto" />
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="auto" />
                                                 </Grid.ColumnDefinitions>
                                                 <Image Grid.Row="0" Grid.Column="0" Source="newui_ic_pdf" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                    HorizontalOptions="Start" VerticalOptions="Center"/>

                                                 <Label Grid.Row="0" Grid.Column="1"
                                                            Text="{Binding Filename}"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            HorizontalOptions="FillAndExpand"
                                                            VerticalOptions="Center"/>

                                                 <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Rotation="90">
                                                     <Image.Source>
                                                         <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}"
                                                                      Size="24"
                                                                      Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                     </Image.Source>
                                                 </Image>
                                             </Grid>
                                         </Border>
                                     </Grid>
                                 </DataTemplate>
                             </listView:SfListView.ItemTemplate>
                         </listView:SfListView>
                         <Grid Grid.Row="4" HorizontalOptions="FillAndExpand">
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                                 <RowDefinition Height="auto" />
                             </Grid.RowDefinitions>
                             <custom:CustomLabel Grid.Row="0"
                                                     FontFamily="{StaticResource SomarBold}"
                                                     HorizontalOptions="StartAndExpand" FontSize="15" 
                                         Style="{StaticResource MicroGrayLabelStyle}" TextColor="{StaticResource PrimaryColor}" >
                                 <custom:CustomLabel.FormattedText>
                                     <FormattedString>
                                         <Span Text="{x:Static ResourceManager:AppResources.IBANAttachment2}"  />
                                         <Span  Text=" *" Style="{StaticResource MandatoryRedColorLabel}" />
                                     </FormattedString>
                                 </custom:CustomLabel.FormattedText>
                             </custom:CustomLabel>
                             <Border Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                      Style="{StaticResource SfStyleGreyBorderFrame}">
                                 <Grid>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="auto" />
                                     </Grid.RowDefinitions>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="auto" />
                                     </Grid.ColumnDefinitions>
                                     <custom:CustomLabel Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource SomarRegular}"
                                                 Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                 FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                 HorizontalOptions="FillAndExpand" />
                                     <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                    Rotation="90">
                                         <Image.Source>
                                             <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}" Size="24"
                                                      Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                         </Image.Source>
                                     </Image>
                                 </Grid>
                             </Border>
                             <Grid.GestureRecognizers>
                                 <TapGestureRecognizer Command="{Binding OnAttachmentClickTwo}" />
                             </Grid.GestureRecognizers>
                         </Grid>

                     </Grid>



                     <Grid Grid.Row="9">

                         <buttons:SfButton  Margin="0,16,0,16" 
                                       Text="{x:Static ResourceManager:AppResources.CRContinue}"
                                       Style="{StaticResource PrimaryButtonStyle}"
                                        HeightRequest="48"
                                        WidthRequest="366"
                                       Command="{Binding ContinueButtonTapped}" />
                     </Grid>

                 </Grid>

             </Grid>

             <Grid Grid.Row="1" IsVisible="{Binding SummaryVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                 <Grid.RowDefinitions>
                     <RowDefinition Height="auto" />

                 </Grid.RowDefinitions>

                 <StackLayout Orientation="Vertical" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

                     <Grid Margin="0,5,0,10">
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>
                         <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                             Text="{x:Static ResourceManager:AppResources.CRSummary}"
                                             HorizontalOptions="StartAndExpand"
                                             Style="{StaticResource PageTitleBlack}" />
                         <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                             Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}"
                                             HorizontalOptions="StartAndExpand"
                                             Style="{StaticResource BodyLabelGrey}" />
                         <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                     </Grid>

                     <Border Margin="0,16,0,10" 
                                      Style="{StaticResource GreyBorderFrameWithShadow}">

                         <StackLayout Orientation="Vertical">

                             <Grid Padding="15" RowSpacing="0">
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="auto" />
                                 </Grid.RowDefinitions>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="auto" />
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="auto" />
                                 </Grid.ColumnDefinitions>

                                 <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                        CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                        Opacity=".2" IsClippedToBounds="True"
                                        BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                        HasShadow="False" />
                                 <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                        HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                        Source="details" />
                                 <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                              Padding="8,0">
                                     <Label Text="{x:Static ResourceManager:AppResources.CRRequestDetails}"
                                            VerticalOptions="CenterAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}" />
                                 </StackLayout>
                                 <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="0,0">
                                     <Label 
                                            Text="{x:Static ResourceManager:AppResources.CREdit}"
                                            VerticalOptions="CenterAndExpand"
                                            Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                         <Label.GestureRecognizers>
                                             <TapGestureRecognizer Command="{Binding GoBackToNewForm}" />
                                         </Label.GestureRecognizers>
                                     </Label>
                                 </StackLayout>
                             </Grid>

                             <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />


                             <Grid Padding="15,15,15,15">
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="auto" />
                                     <RowDefinition Height="auto" />
                                     <RowDefinition Height="auto" />
                                     <RowDefinition Height="auto" />
                                     <RowDefinition Height="auto" />
                                     <RowDefinition Height="auto" />
                                 </Grid.RowDefinitions>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="*"/>

                                 </Grid.ColumnDefinitions>

                                 <StackLayout Grid.Row="0" Grid.Column="0">
                                     <Label Text="{x:Static ResourceManager:AppResources.IBANAccName}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="0" Grid.Column="1" >
                                     <Label Text="{Binding AccountOwnerName}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="1" Grid.Column="0">
                                     <Label Text="{x:Static ResourceManager:AppResources.IBANIdType}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="1" Grid.Column="1" >
                                     <Label Text="{Binding SelectedIDType}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="2" Grid.Column="0">
                                     <Label Text="{x:Static ResourceManager:AppResources.IBANIdNumber}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="2" Grid.Column="1" >
                                     <Label Text="{Binding SelectedIDNumber}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="3" Grid.Column="0">
                                     <Label Text="{x:Static ResourceManager:AppResources.IBAN}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="3" Grid.Column="1" >
                                     <Label Text="{Binding IBANValue}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="4" Grid.Column="0">
                                     <Label Text="{x:Static ResourceManager:AppResources.IBANBankName}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                                 <StackLayout Grid.Row="4" Grid.Column="1" >
                                     <Label Text="{Binding SelectedBankName}" Style="{StaticResource SectionTitleSmallMediumBlack}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                 </StackLayout>
                             </Grid>

                         </StackLayout>

                     </Border>


                     <Border Margin="0,16,0,10" Padding="0,0,0,16" 
                                      Style="{StaticResource GreyBorderFrameWithShadow}" >

                         <StackLayout  Padding="15,15,15,0" VerticalOptions="Fill">

                             <StackLayout
                                     Orientation="Horizontal" >
                                 <Image VerticalOptions="CenterAndExpand">
                                     <Image.Source>
                                         <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                              Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                     </Image.Source>

                                 </Image>
                                 <Label Text="{x:Static ResourceManager:AppResources.CRInformation}"
                                            HorizontalOptions="Start"
                                            VerticalOptions="CenterAndExpand"
                                            Style="{StaticResource BodyLabelBlack}" />
                             </StackLayout>



                             <StackLayout
                                     Orientation="Horizontal" >

                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="1*"/>
                                         <ColumnDefinition Width="9*"/>
                                     </Grid.ColumnDefinitions>
                                     <custom:CheckboxCustom  Grid.Row="0" Grid.Column="0"  IsChecked="{Binding IsInstrunctionChecked}" WidthRequest="32" HeightRequest="32"
                                                                     x:Name="chkDeclaration"  VerticalOptions="Start"/>
                                     <custom:CustomLabel  Grid.Row="0" Grid.Column="1"  x:Name="AckText" Style="{StaticResource BodyLabelGrey}" VerticalOptions="Start"/>


                                 </Grid>


                             </StackLayout>

                         </StackLayout>

                     </Border>

                     <buttons:SfButton  IsEnabled="{Binding IsContinueButtonEnable}" Margin="0,16,0,16"
                                       Text="{x:Static ResourceManager:AppResources.Confirm}"
                                       Style="{StaticResource PrimaryButtonStyle}"
                                       
                                       Command="{Binding SummaryConBtnTapped}"
                                       HeightRequest="48"
                                       WidthRequest="366"/>

                 </StackLayout>
             </Grid>

         </Grid>
     </ScrollView>
 </ContentPage.Content>
</ContentPage>
