<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.IBanAccountsManagementPages.BankAccountAddorUpdateIBANPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="BankAccountAddorUpdateIBANPageView"
    BackgroundImageSource="partials_background.png"
    ios:Page.UseSafeArea="true"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackBtnTapped}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.AddNewIban}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="15"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <ScrollView HorizontalOptions="FillAndExpand"
                                VerticalScrollBarVisibility="Never"
                                VerticalOptions="FillAndExpand">

                        <StackLayout HorizontalOptions="FillAndExpand"
                                     Spacing="10"
                              VerticalOptions="FillAndExpand">

                            <commonView:PageIndicatorView
                                Completed="{Binding MarkComplete}"
                                DotSize="16"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="Start" />

                             <StackLayout
                                IsVisible="{Binding NewFormVisible}"
                                HorizontalOptions="FillAndExpand"
                                Spacing="10"
                                VerticalOptions="FillAndExpand">

                                <Label
                                    LineHeight="0"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.CRRequestDetails}" />

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" />

                                <BoxView
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <!--  IBANAccName   -->
                                <StackLayout Spacing="0">

                                    <!--  IBANAccName Label  -->
                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.IBANAccName}" />
                                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                     <!--  IBANAccName Entry  -->
                                    <custom:CustomSfTextInputView >
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                IsEnabled="{Binding isNameEnabled}"
                                                x:Name="AccountOwnerName"
                                                Placeholder="{x:Static ResourceManager:AppResources.IBANAccName}"
                                                Text="{Binding AccountOwnerName}"
                                                TextChanged="AccountOwnerNameTextChanged"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Style="{StaticResource DefaultEntry}"
                                                Unfocused="AccountOwnerName_Unfocused" />

                                        </custom:CustomSfTextInputView.TextInputView>
                                    </custom:CustomSfTextInputView>

                                </StackLayout>

                                <!--  IBANIdType  -->
                                <StackLayout Spacing="0">

                                    <!--  IBANIdType Label  -->
                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.IBANIdType}" />
                                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!--  IBANIdType Entry  -->
                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                Placeholder="{x:Static ResourceManager:AppResources.IBANIdType}"
                                                IsReadOnly="True"
                                                InputTransparent="True"
                                                Text="{Binding SelectedIDType}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Style="{StaticResource DefaultEntry}"/>

                                        </custom:CustomSfTextInputView.TextInputView>

                                        <inputLayout:SfTextInputLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowIDTypePicker}" />
                                        </inputLayout:SfTextInputLayout.GestureRecognizers>

                                         <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Aspect="AspectFit" Source="greyDropDown" />
                                        </inputLayout:SfTextInputLayout.TrailingView>

                                    </custom:CustomSfTextInputView>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowIDTypePicker}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>

                                <!--  IdNumberTitle  -->
                                <StackLayout Spacing="0">

                                    <!--  IdNumberTitle Label  -->
                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource ValueLabelBlack}"  Text="{Binding IdNumberTitle}" />
                                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!--  IdNumberTitle Entry  -->
                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                IsEnabled="{Binding isNameEnabled}"
                                                Placeholder="{Binding IdNumberTitle}"
                                                Text="{Binding SelectedIDNumber}"
                                                x:Name="EntryIDNumber"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Style="{StaticResource DefaultEntry}"
                                                Unfocused="EntryIDNumber_Unfocused" >

                                                 <custom:GAZTBorderlessEntry.Triggers>

                                                    <DataTrigger
                                                            Binding="{Binding IsDropdownVisibile}"
                                                            TargetType="custom:GAZTBorderlessEntry"
                                                            Value="true">
                                                            <Setter Property="IsReadOnly" Value="True" />
                                                            <Setter Property="InputTransparent" Value="True" />
                                                    </DataTrigger>

                                                    <DataTrigger
                                                            Binding="{Binding IsDropdownVisibile}"
                                                            TargetType="custom:GAZTBorderlessEntry"
                                                            Value="false">
                                                            <Setter Property="IsReadOnly" Value="False" />
                                                            <Setter Property="InputTransparent" Value="False" />
                                                    </DataTrigger>

                                                </custom:GAZTBorderlessEntry.Triggers>

                                            </custom:GAZTBorderlessEntry>

                                        </custom:CustomSfTextInputView.TextInputView>

                                          <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Aspect="AspectFit" Source="greyDropDown"
                                                   IsVisible="{Binding IsDropdownVisibile}"/>
                                        </inputLayout:SfTextInputLayout.TrailingView>

                                         <inputLayout:SfTextInputLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowIDNumberPicker}" />
                                        </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    </custom:CustomSfTextInputView>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowIDNumberPicker}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>

                                <Border Padding="10" 
                                        Stroke="#bbbbbb"
                                        StrokeShape="RoundRectangle 10,10,10,10">

                                    <Grid  ColumnDefinitions="auto,*"
                                           ColumnSpacing="10">

                                        <Image
                                            HorizontalOptions="Start"
                                            Style="{StaticResource SmallIcon}"
                                            VerticalOptions="Start">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Information}"
                                                    Size="30"
                                                    Color="#909090" />
                                            </Image.Source>
                                        </Image>

                                        <Label
                                            Grid.Column="1"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.IBANRefundInfo}" />
                                    </Grid>
                                </Border>

                                <Border Padding="10" 
                                        IsVisible="{Binding IsIdInfoVisibility}"
                                        Stroke="#bbbbbb"
                                        StrokeShape="RoundRectangle 10,10,10,10">

                                    <Grid ColumnDefinitions="auto,*"
                                        ColumnSpacing="10">

                                        <Image
                                            HorizontalOptions="Start"
                                            Style="{StaticResource SmallIcon}"
                                            VerticalOptions="Start">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Information}"
                                                    Size="30"
                                                    Color="#909090" />
                                            </Image.Source>
                                        </Image>

                                        <Label
                                            Grid.Column="1"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding IdNumberInfo}" />
                                    </Grid>

                                </Border>

                                <!--  IBAN  -->
                                <StackLayout Spacing="0" >

                                    <!--  IBAN Label  -->
                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource ValueLabelBlack}"  Text="{x:Static ResourceManager:AppResources.IBAN}" />
                                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!--  IBAN Entry  -->
                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                 x:Name="BankAccountIBAN"
                                                Placeholder="{x:Static ResourceManager:AppResources.IBAN}"
                                                Text="{Binding IBANValue}"
                                                TextChanged="IBANTextChanged"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Style="{StaticResource DefaultEntry}"
                                                Unfocused="IBANFocusChnaged" >
                                                
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:EntryLengthValidatorBehavior MaxLength="24" />
                                                    <xct:EventToCommandBehavior Command="{Binding IBANNumberUnfocused}" EventName="Completed" />
                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>

                                        </custom:CustomSfTextInputView.TextInputView>

                                    </custom:CustomSfTextInputView>

                                </StackLayout>

                                 <!--  IBANBankName  -->
                                <StackLayout Spacing="0" IsEnabled="{Binding IsIBanDropDownEnabled}">

                                    <!--  IBANBankName Label  -->
                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.IBANBankName}"/>
                                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!--  IBANBankName Entry  -->
                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                Placeholder="{x:Static ResourceManager:AppResources.IBANBankName}"
                                                InputTransparent="True"
                                                IsReadOnly="True"
                                                Text="{Binding SelectedBankNameField}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Style="{StaticResource DefaultEntry}" />

                                        </custom:CustomSfTextInputView.TextInputView>

                                          <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Aspect="AspectFit" Source="greyDropDown"/>
                                        </inputLayout:SfTextInputLayout.TrailingView>

                                         <inputLayout:SfTextInputLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowBankNamePicker}" />
                                        </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    </custom:CustomSfTextInputView>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowBankNamePicker}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>

                                <Grid RowDefinitions="auto,*,auto,*"
                                      RowSpacing="10"
                                      IsVisible="{Binding AttachmentVisible}">

                                    <listView:SfListView
                                        Grid.Row="0"
                                        AutoFitMode="Height"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="False"
                                        ItemSpacing="5"
                                        ItemsSource="{Binding IBANBankListViewDataOne}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent"
                                        SelectionMode="SingleDeselect"
                                        TapCommand="{Binding OnAttachmentClickOne}"
                                        VerticalOptions="Center">

                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalOptions="FillAndExpand"
                                                        RowDefinitions="auto,auto">

                                                    <Border
                                                        Grid.Row="0"
                                                        Margin="0,0,0,10"
                                                        Padding="12"
                                                        Style="{StaticResource SfStyleGreyBorderFrame}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="5,0"
                                                                HeightRequest="25"
                                                                HorizontalOptions="Start"
                                                                Source="newui_ic_pdf"
                                                                VerticalOptions="Center"
                                                                WidthRequest="25" />

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                HorizontalOptions="FillAndExpand"
                                                                Style="{StaticResource CaptionLabelBlack}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="Center" />

                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="2"
                                                                HorizontalOptions="Center"
                                                                Rotation="90"
                                                                VerticalOptions="Center">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                        Size="24"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                    </Border>

                                                </Grid>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>

                                    </listView:SfListView>

                                    <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarBold}"
                                            FontSize="15"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            TextColor="{StaticResource PrimaryColor}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarBold}"
                                                        FontSize="15"
                                                        Style="{StaticResource MicroGrayLabelStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.IBANAttachment1}"
                                                        TextColor="{StaticResource PrimaryColor}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text=" *" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Border
                                            Padding="10"
                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <StackLayout Orientation="Horizontal">
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                    TextColor="{StaticResource PrimaryColor}" />
                                                <Image
                                                    HorizontalOptions="Center"
                                                    Rotation="90"
                                                    VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                            Size="24"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                        </Border>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnAttachmentClickOne}" />
                                        </StackLayout.GestureRecognizers>
                                    </StackLayout>

                                    <!--  Attachment 2  -->
                                    <listView:SfListView
                                        Grid.Row="2"
                                        AutoFitMode="Height"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="False"
                                        ItemSpacing="5"
                                        ItemsSource="{Binding IBANBankListViewDataTwo}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent"
                                        SelectionMode="SingleDeselect"
                                        TapCommand="{Binding OnAttachmentClickTwo}"
                                        VerticalOptions="Center">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackLayout HorizontalOptions="FillAndExpand">

                                                    <Border
                                                        Padding="12"
                                                        Style="{StaticResource SfStyleGreyBorderFrame}">

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="5,0"
                                                                HeightRequest="25"
                                                                HorizontalOptions="Start"
                                                                Source="newui_ic_pdf"
                                                                VerticalOptions="Center"
                                                                WidthRequest="25" />

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                HorizontalOptions="FillAndExpand"
                                                                Style="{StaticResource CaptionLabelBlack}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="Center" />

                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="2"
                                                                HorizontalOptions="Center"
                                                                Rotation="90"
                                                                VerticalOptions="Center">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                        Size="24"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>

                                                    </Border>
                                                </StackLayout>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>

                                    <StackLayout Grid.Row="3" HorizontalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarBold}"
                                            FontSize="15"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            TextColor="{StaticResource PrimaryColor}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarBold}"
                                                        FontSize="15"
                                                        Text="{x:Static ResourceManager:AppResources.IBANAttachment2}"
                                                        TextColor="{StaticResource PrimaryColor}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text=" *" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="10"
                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                    TextColor="{StaticResource PrimaryColor}" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="Center"
                                                    Rotation="90"
                                                    VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                            Size="24"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnAttachmentClickTwo}" />
                                        </StackLayout.GestureRecognizers>
                                    </StackLayout>

                                </Grid>

                                <buttons:SfButton
                                        Command="{Binding ContinueButtonTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.CRContinue}"/>

                             </StackLayout>

                            <StackLayout HorizontalOptions="FillAndExpand"
                                       IsVisible="{Binding SummaryVisible}"
                                        Spacing="10"
                                        VerticalOptions="FillAndExpand">

                               <Label
                                    LineHeight="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.CRSummary}" />

                                <Label

                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}" />

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}"
                                         Margin="0,0,0,10"/>

                                <Border Style="{StaticResource GreyBorderFrameWithShadow}">

                                    <StackLayout>

                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                Source="details"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand">
                                                <Label
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.CRRequestDetails}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Padding="0,0"
                                                HorizontalOptions="Center">
                                                <Label
                                                    FontSize="Medium"
                                                    Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.CREdit}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding GoBackToNewForm}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />


                                        <Grid Padding="15,15,15,15">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <StackLayout Grid.Row="0" Grid.Column="0">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.IBANAccName}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding AccountOwnerName}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="1" Grid.Column="0">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.IBANIdType}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="1" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding SelectedIDType}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="2" Grid.Column="0">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.IBANIdNumber}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="2" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding SelectedIDNumber}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="3" Grid.Column="0">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.IBAN}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="3" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding IBANValue}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="4" Grid.Column="0">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.IBANBankName}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="4" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding SelectedBankName}" />
                                            </StackLayout>
                                        </Grid>

                                    </StackLayout>

                                </Border>

                                <Border
                                    Margin="0,16,0,10"
                                    Padding="0,0,0,16"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">

                                    <StackLayout Padding="15,15,15,0" VerticalOptions="Fill">

                                        <StackLayout Orientation="Horizontal">
                                            <Image VerticalOptions="CenterAndExpand">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                        Size="24"
                                                        Color="DarkGray" />
                                                </Image.Source>

                                            </Image>
                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.CRInformation}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>



                                        <StackLayout Orientation="Vertical">

                                            <Grid VerticalOptions="FillAndExpand"
                                                  ColumnSpacing="10">
                                               
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CheckboxCustom
                                                    x:Name="chkDeclaration"
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HeightRequest="32"
                                                    IsChecked="{Binding IsInstrunctionChecked}"
                                                    VerticalOptions="Start"
                                                    WidthRequest="32" />
                                                <Label
                                                    x:Name="AckText"
                                                    Grid.Row="0" HeightRequest="400"
                                                    Grid.Column="1"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    VerticalOptions="Start"
                                                    LineBreakMode="WordWrap"/>


                                            </Grid>


                                        </StackLayout>

                                    </StackLayout>

                                </Border>

                                <buttons:SfButton
                                    Margin="0,16,0,16"
                                    Command="{Binding SummaryConBtnTapped}"
                                    HeightRequest="48"
                                    IsEnabled="{Binding IsContinueButtonEnable}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Confirm}"
                                    WidthRequest="366" />

                            </StackLayout>

                        </StackLayout>

                    </ScrollView>
                </Grid>

            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />


        </Grid>


    </ContentPage.Content>
</ContentPage>
