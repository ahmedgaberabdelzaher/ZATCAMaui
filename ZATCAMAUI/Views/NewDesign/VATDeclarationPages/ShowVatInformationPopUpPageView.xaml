<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.GAZTNewDesignShowVatInformationPopUpPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Mopups:PopupPage.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Mopups:PopupPage.Resources>
    <Border
        x:Name="MainPanCakeView"
        Padding="15"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 8,8,0,0"
        VerticalOptions="EndAndExpand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="InformationList"
                Grid.Row="1"
                BackgroundColor="White"
                HasUnevenRows="True"
                HorizontalOptions="FillAndExpand"
                ItemsSource="{Binding HeaderWithInfoList}"
                SeparatorVisibility="None"
                VerticalOptions="FillAndExpand">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Margin="0,0,0,7" Spacing="15">
                                <Border
                                    Padding="15"
                                    Stroke="{StaticResource DarkGrayTextColor}"
                                    StrokeShape="RoundRectangle 12,12,12,12">
                                    <StackLayout>
                                        <StackLayout IsVisible="{Binding IsHeaderAvailable}">
                                            <StackLayout Orientation="Horizontal">
                                                <Image Source="ic_vat_info" />
                                                <Label
                                                    x:Name="HeaderTextlbl"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{Binding HeaderText}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding Source={x:Reference HeaderTextlbl}, Path=Text.Length}"
                                                            TargetType="Label"
                                                            Value="0">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding Message}" />
                                        </StackLayout>
                                        <StackLayout IsVisible="{Binding IsHeaderAvailable, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}" Orientation="Horizontal">
                                            <Image Source="ic_vat_info" VerticalOptions="Start" />
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding Message}" />
                                        </StackLayout>
                                    </StackLayout>
                                </Border>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackLayout
                Grid.Row="2"
                Margin="0,0,0,0"
                VerticalOptions="FillAndExpand">

                <buttons:SfButton
                    x:Name="btnprimary"
                    Margin="10,0,10,0"
                    Clicked="DoneButtonClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                    VerticalOptions="CenterAndExpand" />

                <buttons:SfButton
                    x:Name="FirstLink"
                    Margin="0,-10,0,3"
                    Background="Transparent"
                    Clicked="FirstLinkClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding FirstLinkText}"
                    TextColor="{StaticResource NewDullOrangeColor}">
                    <buttons:SfButton.Triggers>
                        <DataTrigger
                            Binding="{Binding Source={x:Reference FirstLink}, Path=Text.Length}"
                            TargetType="buttons:SfButton"
                            Value="0">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </buttons:SfButton.Triggers>
                </buttons:SfButton>


                <buttons:SfButton
                    x:Name="SecondLink"
                    Margin="0,-10,0,3"
                    Background="Transparent"
                    Clicked="SecondLinkClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding SecondLinkText}"
                    TextColor="{StaticResource NewDullOrangeColor}">
                    <buttons:SfButton.Triggers>
                        <DataTrigger
                            Binding="{Binding Source={x:Reference SecondLink}, Path=Text.Length}"
                            TargetType="buttons:SfButton"
                            Value="0">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </buttons:SfButton.Triggers>
                </buttons:SfButton>
            </StackLayout>
        </Grid>
    </Border>
</Mopups:PopupPage>


