<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.AdjustmentPopupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        Padding="15"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">
        <StackLayout Spacing="15">

            <Label Style="{StaticResource SectionTitleBlack}" Text="{x:Static ResourceManager:AppResources.AdjustmentAmount}" />

            <ScrollView Grid.Row="1"
                        VerticalScrollBarVisibility="Never">
                <StackLayout Spacing="15">
                    <Border
                        Padding="15"
                        Stroke="{StaticResource DarkGrayTextColor}"
                        StrokeShape="RoundRectangle 12,12,12,12">
                        <StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image Source="ic_vat_info" />
                                <Label
                                    CharacterSpacing="0"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VerifyAdjustmentAmount}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>

                            <Label
                                CharacterSpacing="0"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.AdjustmentAmountDis}" />

                        </StackLayout>
                    </Border>
                </StackLayout>
            </ScrollView>

            <buttons:SfButton
                x:Name="btnprimary"
                Margin="0,0,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="Done"
                VerticalOptions="EndAndExpand" />

        </StackLayout>
    </Border>
</Mopups:PopupPage>