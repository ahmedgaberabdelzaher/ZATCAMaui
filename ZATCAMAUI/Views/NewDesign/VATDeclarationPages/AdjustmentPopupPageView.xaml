<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.AdjustmentPopupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    mc:Ignorable="d"
    FlowDirection="{Binding AppDirection}">
    <Border
        Padding="15"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">
        <StackLayout Spacing="15">

            <Label Style="{StaticResource SectionTitleBlack}" Text="Adjustment Amount" />

            <ScrollView Grid.Row="1">
                <StackLayout Spacing="15">
                    <Frame
                        Padding="15"
                        BorderColor="{StaticResource DarkGrayTextColor}"
                        CornerRadius="12">
                        <StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Image Source="ic_vat_info" />
                                <Label
                                    CharacterSpacing="0"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="Verify Adjustment Amount"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>

                            <Label
                                CharacterSpacing="0"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="The adjustment amount entered is more than 10% larger than the amount of domestic standard-rated sales. please verify the amount entered in the return or continue if the amount entered is correct." />

                        </StackLayout>
                    </Frame>
                </StackLayout>
            </ScrollView>

            <buttons:SfButton
                x:Name="btnprimary"
                Margin="0,0,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="Done"
                VerticalOptions="EndAndExpand" />

        </StackLayout>
    </Border>
</pages:PopupPage>