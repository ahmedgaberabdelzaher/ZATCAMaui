<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.VATCreditCarriedForwardPopUpPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="vATCreditCarriedForwardPopUpPageView"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        Margin="0,150,0,0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="End">
        <StackLayout>
            <Label Style="{StaticResource SectionTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZVatcreditcarriedforward}" />

            <ListView
                BackgroundColor="White"
                HasUnevenRows="True"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsListViewVisible}"
                ItemsSource="{Binding CreditCarriedsList}"
                SeparatorVisibility="None"
                VerticalOptions="FillAndExpand">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border
                                Margin="0,10,0,10"
                                FlowDirection="{Binding Source={x:Reference vATCreditCarriedForwardPopUpPageView}, Path=FlowDirection}"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="20" Spacing="-5">
                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <FormattedString.Spans>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZVatSerialNumber}" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text=" : " />
                                                    <Span Style="{StaticResource ValueLabelGrey}" Text="{Binding LineNo}" />
                                                </FormattedString.Spans>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <FormattedString.Spans>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZReturnReferenceNumber}" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text=" : " />
                                                    <Span Style="{StaticResource ValueLabelGrey}" Text="{Binding Fbnum}" />
                                                </FormattedString.Spans>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <FormattedString.Spans>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZVatDocumentNumber}" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text=" : " />
                                                    <Span Style="{StaticResource ValueLabelGrey}" Text="{Binding DocNo}" />
                                                </FormattedString.Spans>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Style="{StaticResource ValueLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <FormattedString.Spans>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZAmount}" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text=" : " />
                                                    <Span Style="{StaticResource ValueLabelGrey}" Text="{Binding CreditAmt}" />
                                                </FormattedString.Spans>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Label
                HorizontalOptions="Center"
                IsVisible="{Binding IsNoDataLabelVisible}"
                Style="{StaticResource ValueLabelBlack}"
                Text="{x:Static ResourceManager:AppResources.Nodataavailable}"
                VerticalOptions="Center" />

            <buttons:SfButton
                Clicked="OnCloseTapped"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZDone}" />
        </StackLayout>
    </Border>
</Mopups:PopupPage>