<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.RefundAccountPopupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    FlowDirection="{Binding AppDirection}"
    BackgroundColor="#88000000"
    x:Name="refundAccountPopupPageView"
    mc:Ignorable="d">
    <Border
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    BackgroundColor="White"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="5">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BackgroundColor="White"
                        Style="{StaticResource PageTitleBlack}"
                        Text="{x:Static ResourceManager:AppResources.VATRefund}" />

                    <StackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,7"
                            Spacing="15">

                        <StackLayout>
                            <Border Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}"
                                    Padding="15,15,15,15"
                                    BackgroundColor="White">
                                <StackLayout Orientation="Horizontal">
                                    <Image Source="ic_vat_info" VerticalOptions="StartAndExpand" />
                                    <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            LineSpacing="1"
                                            Text="{x:Static ResourceManager:AppResources.IBanRefundsInfo}"
                                            VerticalOptions="EndAndExpand" />
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </StackLayout>

                    <StackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BackgroundColor="White"
                        IsEnabled="{Binding IsIdTypeEnabled}">


                        <StackLayout>
                            <Label
                            BackgroundColor="White"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VatDeregIDType}" />

                            <custom:CustomSfTextInputView x:Name="txtEntryName">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                                    BackgroundColor="Transparent"
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding TxtSelectedIBANType}"
                                                    TextColor="{StaticResource NeutralBlack}"
                                                    VerticalTextAlignment="Center" />
                                </custom:CustomSfTextInputView.TextInputView>

                                <custom:CustomSfTextInputView.TrailingView>
                                    <Image Source="arrowDropdown.png" Style="{StaticResource SmallIcon}" />
                                </custom:CustomSfTextInputView.TrailingView>

                                <custom:CustomSfTextInputView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SfButton_Clicked" />
                                </custom:CustomSfTextInputView.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <custom:CustomSfPicker
                                            x:Name="IDTypeDropdown"
                                            Margin="0"
                                            Background="Transparent"
                                            CancelButtonClicked="IDTypeDropdown_CancelButtonClicked"
                                            IsOpen="False"
                                            ItemHeight="46"
                                            Mode="Dialog"
                                            OkButtonClicked="IDTypeDropdown_OkButtonClicked"
                                            SelectionChanged="IDType_SelectionChanged">

                                <syncfusion:SfPicker.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                </syncfusion:SfPicker.TextStyle>

                                <syncfusion:SfPicker.Columns>
                                    <syncfusion:PickerColumn
                                                    Width="300"
                                                    DisplayMemberPath="Text"
                                                    ItemsSource="{Binding IBANTypesList}"/>
                                </syncfusion:SfPicker.Columns>

                                <syncfusion:SfPicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    TextColor="{StaticResource NeutralBlack}" />
                                </syncfusion:SfPicker.SelectedTextStyle>

                                <syncfusion:SfPicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </syncfusion:SfPicker.SelectionView>

                                <syncfusion:SfPicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                                    Height="55"
                                                    Background="{StaticResource Primary}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZIDType}">
                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                        </syncfusion:PickerHeaderView.TextStyle>
                                    </syncfusion:PickerHeaderView>

                                </syncfusion:SfPicker.HeaderView>

                                <syncfusion:SfPicker.FooterView>

                                    <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </syncfusion:SfPicker.FooterView>

                            </custom:CustomSfPicker>

                        </StackLayout>
                    </StackLayout>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        
                        IsEnabled="{Binding IsIdNumberEnabled}">


                        <Label
                            BackgroundColor="White"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.IDNumber}" />

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                                    BackgroundColor="Transparent"
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding TxtSelectedIBANIDNumber}"
                                                    TextColor="{StaticResource NeutralBlack}"
                                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>

                            <custom:CustomSfTextInputView.TrailingView>
                                <Image Source="arrowDropdown.png" Style="{StaticResource SmallIcon}" />
                            </custom:CustomSfTextInputView.TrailingView>

                            <custom:CustomSfTextInputView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SfButton_Clicked1" />
                            </custom:CustomSfTextInputView.GestureRecognizers>

                        </custom:CustomSfTextInputView>

                        <custom:CustomSfPicker
                                            x:Name="IDNumberDropdown"
                                            Margin="0"
                                            Background="Transparent"
                                            CancelButtonClicked="IDNumberDropdown_CancelButtonClicked"
                                            IsOpen="False"
                                            ItemHeight="46"
                                            Mode="Dialog"
                                            OkButtonClicked="IDNumberDropdown_OkButtonClicked"
                                            SelectionChanged="IDNumber_SelectionChanged">

                            <syncfusion:SfPicker.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </syncfusion:SfPicker.TextStyle>

                            <syncfusion:SfPicker.Columns>
                                <syncfusion:PickerColumn
                                                    Width="300"
                                                    DisplayMemberPath="Text"
                                                    ItemsSource="{Binding IBANIDNumberList}"/>
                            </syncfusion:SfPicker.Columns>

                            <syncfusion:SfPicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    TextColor="{StaticResource NeutralBlack}" />
                            </syncfusion:SfPicker.SelectedTextStyle>

                            <syncfusion:SfPicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                            </syncfusion:SfPicker.SelectionView>

                            <syncfusion:SfPicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                                    Height="55"
                                                    Background="{StaticResource Primary}"
                                                    Text="{x:Static ResourceManager:AppResources.IDNumber}">
                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>
                                </syncfusion:PickerHeaderView>

                            </syncfusion:SfPicker.HeaderView>

                            <syncfusion:SfPicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </syncfusion:SfPicker.FooterView>

                        </custom:CustomSfPicker>

                    </StackLayout>

                    <StackLayout
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BackgroundColor="White"
                        IsEnabled="{Binding IsNewAccountEnabled}"
                        IsVisible="{Binding IsNewAccountButtonVisible}">
                        <Border Margin="0,0,0,0" Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout
                                Padding="15,10,15,10"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Image Source="ic_add_plus.png" />
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelPrimary}"
                                    Text="{Binding NewAccountText}" />
                            </StackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="5" Spacing="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="White">

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NAIBAN}" Style="{StaticResource CaptionLabelGrey}" BackgroundColor="White"/>
                        <listView:SfListView Orientation="Horizontal" x:Name="OtherIbanlist"   AutoFitMode="Height" 
                                         HeightRequest="100"
                                                 VerticalOptions="Fill" HorizontalOptions="FillAndExpand"
                                                 ItemsSource="{Binding IBANList, Mode=TwoWay}" SelectedItem="{Binding SelectedIBAN, Mode=TwoWay}"
                                                  Margin="0"  ScrollBarVisibility="Never">

                            <listView:SfListView.ItemsLayout>
                                <listView:LinearLayout   />
                            </listView:SfListView.ItemsLayout>

                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" WidthRequest="150"  ColumnSpacing="0" RowSpacing="10" Padding="0" Margin="0">

                                        <Image Source="vat_tile_listofsignup_W" x:Name="cardBackGroundImage" Aspect="Fill" HorizontalOptions="FillAndExpand" HeightRequest="100" VerticalOptions="FillAndExpand"/>
                                        <custom:CustomLabel Text="{Binding Iban}" x:Name="cardLabel" Style="{StaticResource CaptionLabelBlack}"
                                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                                      HorizontalOptions="Start"  Padding="20" 
                                                                VerticalOptions="End" HorizontalTextAlignment="Start"
                                                                />
                                    </Grid>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>

                            <listView:SfListView.SelectedItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" WidthRequest="150"  ColumnSpacing="0" RowSpacing="10" Padding="0" Margin="0"   BackgroundColor="Yellow">

                                        <Image x:Name="cardBackGroundImage" Source="vat_tile_listofsignup" Aspect="Fill" HorizontalOptions="FillAndExpand" HeightRequest="100" VerticalOptions="FillAndExpand"/>
                                        <custom:CustomLabel Text="{Binding Iban}" TextColor="White" x:Name="cardLabel" Style="{StaticResource CaptionLabelBlack}"
                                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                                      HorizontalOptions="Start"  Padding="20" 
                                                                VerticalOptions="End" HorizontalTextAlignment="Start"
                                                                />
                                    </Grid>
                                </DataTemplate>
                            </listView:SfListView.SelectedItemTemplate>

                        </listView:SfListView>


                    </StackLayout>

                    <StackLayout  Grid.Row="6" Grid.ColumnSpan="2" Spacing="15" Margin="0,0,0,7">

                        <StackLayout>
                            <Border Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}" BackgroundColor="White"  Padding="15,15,15,15" >
                                <StackLayout Orientation="Horizontal" >
                                    <Image Source="ic_vat_info"/>
                                    <custom:CustomLabel  HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" LineSpacing="1" VerticalOptions="EndAndExpand"   >
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>

                                                <Span Text="{x:Static ResourceManager:AppResources.PleaseGoToIBan}"/>


                                                <Span x:Name="VisitIbanNav" Text="{x:Static ResourceManager:AppResources.VisitIBanManagement}" TextColor="#006450" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                        <custom:CustomLabel.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="IBANAccManagementTapped" CommandParameter="false"/>
                                        </custom:CustomLabel.GestureRecognizers>
                                    </custom:CustomLabel>
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </StackLayout>

                    <StackLayout
                        Grid.Row="7"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BackgroundColor="White"
                        IsEnabled="{Binding IsRefundCheckboxEnabled}"
                        Orientation="Horizontal"
                        Spacing="0">
                        <CheckBox
                            x:Name="chkForDeclarationRefund"
                            IsChecked="{Binding IsDeclarationCheckedForRefund}"
                            VerticalOptions="CenterAndExpand">
                            <CheckBox.Triggers>
                                <DataTrigger
                                    Binding="{Binding Source={x:Reference chkForDeclarationRefund}, Path=IsChecked}"
                                    TargetType="CheckBox"
                                    Value="false">
                                    <Setter Property="Color" />
                                </DataTrigger>
                            </CheckBox.Triggers>
                        </CheckBox>
                        <Label
                            Style="{StaticResource CaptionLabelBlack}"
                            VerticalOptions="CenterAndExpand"
                            VerticalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZZZIAgreeWithThese}" />
                                    <Span Text="&#160;" />
                                    <Span
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}"
                                        TextColor="{StaticResource Primary}" />
                                </FormattedString>
                            </Label.FormattedText>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRefundInCTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <StackLayout
                        Grid.Row="8"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BackgroundColor="White"
                        IsEnabled="{Binding IsConfirmRefundButtonEnabled}">
                        <buttons:SfButton
                            Margin="0,8,0,0"
                            Clicked="Confirm_RefundClicked"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZConfirmRefund}" />
                    </StackLayout>
                </Grid>

                <custom:Loader IsVisible="{Binding IsLoading}" />

            </Grid>
        </StackLayout>
    </Border>
</Mopups:PopupPage>