<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.GAZTNewDesignVATReturnUpdatedUIPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>

            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style x:Key="boxIndicator" TargetType="BoxView">
                <Setter Property="BackgroundColor" Value="{StaticResource NeutralLightGrey}" />
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>

            <Style x:Key="circleFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="HeightRequest" Value="25" />
                <Setter Property="WidthRequest" Value="25" />
                <Setter Property="HasShadow" Value="False" />
            </Style>

            <Style x:Key="EntryHeight48" TargetType="Entry">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="PlaceholderColor" Value="{StaticResource NeutralGreay}" />
            </Style>

            <converters:VATReturnUpdatedUITabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>


                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <yummy:PancakeView
                    Grid.Row="1"
                    Padding="0,0,0,0"
                    BackgroundColor="White"
                    CornerRadius="15,15,0,0">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="VATRMainGrid"
                            Grid.Row="1"
                            Margin="0"
                            Padding="0,15,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            RowSpacing="0"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>

                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>

                        <StackLayout
                            Grid.Row="0"
                            Padding="15,0,15,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="CenterAndExpand">

                            <custom:CustomLabel
                                Margin="0"
                                Padding="0,15,0,0"
                                HorizontalOptions="Start"
                                Style="{StaticResource IconLabelStyle}"
                                Text="{DynamicResource StyleReverseBack}">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackButtonClicked" />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>


                            <commonView:PageIndicatorView
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,15,0,0"
                                Completed="{TemplateBinding BindingContext.MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="EndAndExpand"
                                MaxNum="{TemplateBinding BindingContext.MaxIndex}"
                                MinNum="{TemplateBinding BindingContext.CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />

                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>
                <Grid Grid.Row="0" Padding="15,10,15,10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="20*" />
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalOptions="CenterAndExpand"
                        Style="{StaticResource SectionTitleWhiteBold}"
                        Text="{x:Static ResourceManager:AppResources.VATDeclaration}"
                        VerticalOptions="Center" />

                    <StackLayout Grid.Row="0" Grid.Column="0">

                        <Label
                            Margin="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>



                    <StackLayout Grid.Row="0" Grid.Column="2">
                        <StackLayout
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Rotation="90"
                            Spacing="3"
                            VerticalOptions="CenterAndExpand">
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>

                </Grid>

                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    IsVisible="{TemplateBinding BindingContext.IsNewLoading}">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForReturn"
                                HorizontalOptions="CenterAndExpand"
                                IsRunning="True"
                                AnimationType="Cupertino"
                                SizeFactor="0.6"
                                WidthRequest="70"
                                HeightRequest="70"
                                IndicatorColor="{StaticResource Secondary}"
                                TitlePlacement="Bottom"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>

        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            x:Name="MainGrid"
            Padding="0,0,0,0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="InstrunctionSection"
                Grid.Row="0"
                IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.Instrunction}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackLayout
                    Grid.Row="1"
                    Margin="15,16,15,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <ScrollView
                        BackgroundColor="White"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout BackgroundColor="White" VerticalOptions="StartAndExpand">
                            <Label
                                BackgroundColor="White"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZVatReadInstructions}" />

                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                HorizontalTextAlignment="Start"
                                LineSpacing="0.8"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="EndAndExpand">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="1." />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZPleasefilltherequestedinformationforeachstep}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                HorizontalTextAlignment="Start"
                                LineSpacing="0.8"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="EndAndExpand">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="2." />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZVatSubmittedInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel
                                LineSpacing="0.8"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="EndAndExpand">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="3." />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZVatDateInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel LineSpacing="0.8" Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="4." />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZVatFaqSectionInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                LineSpacing="0.8"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZVatClickFaqInstructions}"
                                TextColor="{StaticResource NewDullOrangeColor}"
                                VerticalOptions="EndAndExpand">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClickedFAQ" />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>

                            <StackLayout Orientation="Horizontal">

                                <custom:CheckboxCustom
                                    x:Name="chkDeclaration"
                                    IsChecked="{Binding IsDeclarationCheckedForInstruction}"
                                    IsEnabled="{Binding IsDeclarationCheckEnabled}"
                                    VerticalOptions="CenterAndExpand" />

                                <custom:CustomLabel
                                    LineSpacing="0.8"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    VerticalOptions="CenterAndExpand"
                                    VerticalTextAlignment="Center">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZVatDeclarationInstructions}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="1"
                                Padding="0,0,0,40"
                                BackgroundColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="EndAndExpand">


                                <buttons:SfButton
                                    Margin="15,8,15,0"
                                    Clicked="OnAmendButtonClicked"
                                    IsVisible="{Binding IsVisibleAmendButton}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZAmend}"
                                    VerticalOptions="CenterAndExpand" />

                                <buttons:SfButton
                                    Margin="15,8,15,0"
                                    Clicked="OnContinueButtonClicked"
                                    IsVisible="{Binding IsMainButtonVisible}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding ContinueText}"
                                    VerticalOptions="CenterAndExpand" />

                                <buttons:SfButton
                                    Margin="15,-10,15,0"
                                    Background="Transparent"
                                    Command="{Binding onRefundClicked}"
                                    IsEnabled="{Binding IsRefundButtonEnabled}"
                                    IsVisible="{Binding IsRefundButtonVisible}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding RefundButtonText}"
                                    TextColor="{StaticResource NewDullOrangeColor}" />

                                <buttons:SfButton
                                    Margin="15,-10,15,0"
                                    Background="Transparent"
                                    Command="{Binding onSecondButtonClicked}"
                                    IsEnabled="{Binding IsGetSadadNumberEnabled}"
                                    IsVisible="{Binding isBtnVisible}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding CreditDetailsText}"
                                    TextColor="{StaticResource NewDullOrangeColor}" />

                                <!--    -->
                                <buttons:SfButton
                                    Margin="15,-10,15,0"
                                    Background="Transparent"
                                    Command="{Binding onCreditForwardClicked}"
                                    IsVisible="{Binding IsCreditForwardBtnVisible}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZCarriedCreditDetails}"
                                    TextColor="{StaticResource NewDullOrangeColor}" />

                            </StackLayout>

                        </StackLayout>

                    </ScrollView>

                    <!--    -->
                </StackLayout>


                <StackLayout
                    Grid.Row="0"
                    Margin="0,10,0,10"
                    BackgroundColor="White"
                    Spacing="0">
                    <StackLayout Margin="15,0,15,0">
                        <custom:CustomLabel
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            LineSpacing="0.8"
                            Style="{StaticResource PageTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.ZInstructions}" />

                        <BoxView Style="{StaticResource lineSeperator}" />
                    </StackLayout>
                </StackLayout>
            </Grid>


            <Grid
                x:Name="VATReturnsSection"
                Grid.Row="0"
                Margin="0,10,0,0"
                BackgroundColor="White"
                IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.VATReturns}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollView Grid.Row="1">
                    <StackLayout BackgroundColor="White">
                        <StackLayout Margin="15,0,15,0">
                            <custom:CustomLabel
                                LineSpacing="0.8"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZZZDoyouhavesalesorpurchasessubjectto5VAT}" />

                            <Grid IsEnabled="{Binding IsFivePercentTaxAmendGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" IsEnabled="{Binding IsYesBoxEnabled}">
                                    <Image x:Name="YesImg" Source="{Binding YesBackgroundImage}" />
                                    <custom:CustomLabel
                                        x:Name="YesLbl"
                                        Margin="10"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZYesText}"
                                        TextColor="{Binding YesLabelColor}"
                                        VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnYesTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                                <Grid Grid.Column="1" IsEnabled="{Binding IsNoBoxEnabled}">
                                    <Image x:Name="NoImg" Source="{Binding NoBackgroundImage}" />
                                    <custom:CustomLabel
                                        x:Name="NoLbl"
                                        Margin="10"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZNoText}"
                                        TextColor="{Binding NoLabelColor}"
                                        VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNoTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Grid>
                            <!--  VAT On Sales Starts  -->

                            <!--  Total VAT Ends  -->
                        </StackLayout>
                        <StackLayout Margin="15,0,15,0" IsVisible="{Binding IsGovtYesNoVisible}">
                            <custom:CustomLabel
                                LineSpacing="0.8"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZZZDoyouhavesalesorpurchasessubjecttoTax}" />

                            <Grid IsEnabled="{Binding IsTaxAmendGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" IsEnabled="{Binding IsTaxYesBoxEnabled}">
                                    <Image x:Name="TaxYesImg" Source="{Binding TaxYesBackgroundImage}" />
                                    <custom:CustomLabel
                                        x:Name="TaxYesLbl"
                                        Margin="10"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZYesText}"
                                        TextColor="{Binding TaxYesLabelColor}"
                                        VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTaxYesTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                                <Grid Grid.Column="1" IsEnabled="{Binding IsTaNoBoxEnabled}">
                                    <Image x:Name="TaxNoImg" Source="{Binding TaxNoBackgroundImage}" />
                                    <custom:CustomLabel
                                        x:Name="TaxNoLbl"
                                        Margin="10"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZNoText}"
                                        TextColor="{Binding TaxNoLabelColor}"
                                        VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTaxNoTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Grid>
                            <!--  VAT On Sales Starts  -->

                            <!--  Total VAT Ends  -->
                        </StackLayout>
                        <StackLayout
                            Grid.Row="1"
                            Padding="0,0,0,40"
                            BackgroundColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="End">

                            <buttons:SfButton
                                Margin="15,8,15,0"
                                Clicked="OnAmendButtonClicked"
                                IsVisible="{Binding IsVisibleAmendButton}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZAmend}"
                                VerticalOptions="CenterAndExpand" />

                            <buttons:SfButton
                                Margin="15,8,15,0"
                                Clicked="OnContinueButtonClicked"
                                IsVisible="{Binding IsMainButtonVisible}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{Binding ContinueText}"
                                VerticalOptions="CenterAndExpand" />

                            <buttons:SfButton
                                Margin="15,-10,15,0"
                                Background="Transparent"
                                Command="{Binding onRefundClicked}"
                                IsEnabled="{Binding IsRefundButtonEnabled}"
                                IsVisible="{Binding IsRefundButtonVisible}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{Binding RefundButtonText}"
                                TextColor="{StaticResource NewDullOrangeColor}" />

                            <buttons:SfButton
                                Margin="15,-10,15,0"
                                Background="Transparent"
                                Command="{Binding onSecondButtonClicked}"
                                IsEnabled="{Binding IsGetSadadNumberEnabled}"
                                IsVisible="{Binding isBtnVisible}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{Binding CreditDetailsText}"
                                TextColor="{StaticResource NewDullOrangeColor}" />

                            <buttons:SfButton
                                Margin="15,-10,15,0"
                                Background="Transparent"
                                Command="{Binding onCreditForwardClicked}"
                                IsVisible="{Binding IsCreditForwardBtnVisible}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZCarriedCreditDetails}"
                                TextColor="{StaticResource NewDullOrangeColor}" />

                        </StackLayout>

                    </StackLayout>
                </ScrollView>
                <StackLayout
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    BackgroundColor="White">
                    <StackLayout Margin="15,0,15,0">
                        <custom:CustomLabel
                            Padding="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            LineSpacing="0.8"
                            Style="{StaticResource PageTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.ZZVATReturnForm}" />
                        <custom:CustomLabel
                            Margin="0,-8,0,0"
                            BackgroundColor="White"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                        <BoxView Style="{StaticResource lineSeperator}" />
                    </StackLayout>
                </StackLayout>
                <!--  View On Hold  -->





                <!--  Views On Hold  -->
            </Grid>


            <Grid
                x:Name="SalesSection"
                Grid.Row="0"
                Margin="0,-15,0,0"
                IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.Sales}}"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollView
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    BackgroundColor="white"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout BackgroundColor="white">
                        <StackLayout Margin="15,0,15,0">
                            <Frame Margin="0" Style="{StaticResource InputTableFrameStyle}">
                                <Grid BindingContext="{Binding ResponseVATDeclarationD}" Style="{StaticResource InputTableGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />

                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80*" />
                                            <ColumnDefinition Width="20*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,0,10,0"
                                            IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                            LineSpacing="0.8"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatStandardRatedSales}" />
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                            Source="ic_vat_info"
                                            Style="{StaticResource ImageStyleForInputTable}" />
                                    </Grid>

                                    <custom:CustomLabel
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="10,0,10,-8"
                                        IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZVatAmountWithSAR}" />
                                    <custom:CustomLabel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="10,0,10,-8"
                                        IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZVatAdjustmentWithSAR}" />


                                    <inputLayout:SfTextInputLayout
                                        x:Name="EntryVatAmountFrame"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                         IsHintAlwaysFloated="True"
                                        Margin="10,0,10,0"
