                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            LineHeight="0.8"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZVatAdjustmentWithSAR}" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            MaxLines="1"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding TotalpurchaseAdj}" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            LineHeight="0.8"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZZVATOnPurchasesForSummarypage}" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            MaxLines="1"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding TotalpurchaseVat}" />
                                                    </Grid>
                                                </StackLayout>
                                            </StackLayout>
                                        </Border>
                                        <!--  VAT On Purchases End  -->

                                        <!--  VAT on Total VAT Start  -->
                                        <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout>
                                                <Grid Padding="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image Source="ic_vat_amount" VerticalOptions="Center" />

                                                    <Label
                                                        Grid.Column="1"
                                                        Padding="8,0"
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        LineHeight="0.8"
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatNetdue}"
                                                        VerticalOptions="Center"
                                                        VerticalTextAlignment="Center" />
                                                </Grid>

                                                <BoxView
                                                    BackgroundColor="LightGray"
                                                    HeightRequest="1"
                                                    HorizontalOptions="FillAndExpand" />

                                                <StackLayout Padding="10" Spacing="10">

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            LineHeight="0.8"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZZVatDueForCurrentPeriod}" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            MaxLines="1"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding TotaldueVat}" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            LineHeight="0.8"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZZVatFromPreviousPeriod}" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            MaxLines="1"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding CreditVat}" />
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            LineHeight="0.8"
                                                            Style="{StaticResource ValueLabelGrey}"
                                                            Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.CarriedValueStringNew}" />
                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            MaxLines="1"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding Preperiodcorr}" />
                                                    </Grid>
                                                </StackLayout>
                                                <StackLayout Padding="10" BackgroundColor="{StaticResource TiffanyBG}">
                                                    <Label
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        LineHeight="0.8"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatNetdue}"
                                                        VerticalTextAlignment="Center" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{Binding NetdueVat}" />
                                                </StackLayout>
                                            </StackLayout>
                                        </Border>
                                        <!--  VAT On Total End  -->

                                        <StackLayout
                                            Margin="0,10"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalOptions="CenterAndExpand">


                                            <custom:CheckboxCustom
                                                x:Name="chkForDeclarationSummary"
                                                IsChecked="{Binding IsDeclarationCheckedForSummary}"
                                                IsEnabled="{Binding IsSummaryCheckEnabled}"
                                                Style="{StaticResource CheckboxHeightWidth32}"
                                                VerticalOptions="CenterAndExpand" />

                                            <Label
                                                HorizontalOptions="Start"
                                                HorizontalTextAlignment="Center"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZNewVATREInstructionsandConditions}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsDeclarationCheckedForSummary}"
                                                        TargetType="Label"
                                                        Value="True">
                                                        <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsDeclarationCheckedForSummary}"
                                                        TargetType="Label"
                                                        Value="False">
                                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnSummaryInCTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                        </StackLayout>

                                    </VerticalStackLayout>

                                    <buttons:SfButton
                                        x:Name="btnpaynow"
                                        Margin="5"
                                        Clicked="OnPayNowButtonClicked"
                                        IsVisible="{Binding IsPayNowVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                                        VerticalOptions="CenterAndExpand" />

                                    <buttons:SfButton
                                        Clicked="OnAmendButtonClicked"
                                        IsVisible="{Binding IsVisibleAmendButton}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZAmend}"
                                        VerticalOptions="CenterAndExpand" />

                                    <buttons:SfButton
                                        Clicked="OnContinueButtonClicked"
                                        IsVisible="{Binding IsMainButtonVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{Binding ContinueText}"
                                        VerticalOptions="CenterAndExpand" />

                                    <buttons:SfButton
                                        Background="Transparent"
                                        Command="{Binding onRefundClicked}"
                                        IsEnabled="{Binding IsRefundButtonEnabled}"
                                        IsVisible="{Binding IsRefundButtonVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{Binding RefundButtonText}"
                                        TextColor="{StaticResource NewDullOrangeColor}" />

                                    <buttons:SfButton
                                        Background="Transparent"
                                        Command="{Binding onSecondButtonClicked}"
                                        IsEnabled="{Binding IsGetSadadNumberEnabled}"
                                        IsVisible="{Binding isBtnVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{Binding CreditDetailsText}"
                                        TextColor="{StaticResource NewDullOrangeColor}" />

                                    <buttons:SfButton
                                        Background="Transparent"
                                        Command="{Binding onCreditForwardClicked}"
                                        IsVisible="{Binding IsCreditForwardBtnVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZCarriedCreditDetails}"
                                        TextColor="{StaticResource NewDullOrangeColor}" />

                                </VerticalStackLayout>

                            </ScrollView>
                        </Grid>

                    </Grid>
                </Grid>

            </Border>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsNewLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>