<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.GAZTNewDesignVATReturnUpdatedUIPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:VATReturnUpdatedUITabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="18"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VATDeclaration}"
                    VerticalOptions="Center" />

                <!--  Dots Shape  -->
                <StackLayout Grid.Column="2">

                    <StackLayout
                        HorizontalOptions="EndAndExpand"
                        Orientation="Horizontal"
                        Rotation="90"
                        Spacing="3"
                        VerticalOptions="CenterAndExpand">
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                    </StackLayout>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnMoreClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->


            <!--  Body  -->
            <Border
                x:Name="MainGrid"
                Grid.Row="1"
                Padding="15"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="auto,*">


                    <!--  Sub Header  -->
                    <StackLayout Orientation="Horizontal">

                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{DynamicResource StyleReverseBack}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BackButtonClicked" />
                            </Label.GestureRecognizers>
                        </Label>

                        <IndicatorView
                            Count="{Binding MaxIndex}"
                            HorizontalOptions="End"
                            IndicatorColor="LightGray"
                            IndicatorSize="16"
                            InputTransparent="True"
                            MaximumVisible="{Binding MaxIndex}"
                            Position="{Binding CurrentIndex}"
                            SelectedIndicatorColor="{StaticResource PrimaryColor}"
                            VerticalOptions="CenterAndExpand" />

                    </StackLayout>

                    <!--  Sub Body  -->
                    <Grid Grid.Row="1">

                        <Grid
                            x:Name="InstrunctionSection"
                            Grid.Row="1"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.Instrunction}}">

                            <Grid
                                HorizontalOptions="FillAndExpand"
                                RowDefinitions="auto,auto,*"
                                RowSpacing="5"
                                VerticalOptions="FillAndExpand">

                                <Label
                                    Grid.Row="0"
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight="0.8"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZInstructions}" />

                                <BoxView Grid.Row="1" Style="{StaticResource lineSeperator}" />

                                <ScrollView
                                    Grid.Row="2"
                                    VerticalOptions="FillAndExpand"
                                    VerticalScrollBarVisibility="Never">

                                    <VerticalStackLayout Spacing="10" VerticalOptions="Start">

                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatReadInstructions}" />

                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            LineHeight="0.8"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            VerticalOptions="EndAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="1." />
                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZPleasefilltherequestedinformationforeachstep}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            LineHeight="0.8"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            VerticalOptions="EndAndExpand">

                                            <Label.FormattedText>
                                                <FormattedString>

                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="2." />

                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatSubmittedInstructions}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label
                                            LineHeight="0.8"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            VerticalOptions="EndAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="3." />
                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatDateInstructions}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label LineHeight="0.8" Style="{StaticResource CaptionLabelGrey}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="4." />
                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatFaqSectionInstructions}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>


                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            LineHeight="0.8"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatClickFaqInstructions}"
                                            TextColor="{StaticResource NewDullOrangeColor}"
                                            VerticalOptions="EndAndExpand">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnClickedFAQ" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <StackLayout Orientation="Horizontal" Spacing="5">

                                            <custom:CheckboxCustom
                                                x:Name="chkDeclaration"
                                                IsChecked="{Binding IsDeclarationCheckedForInstruction}"
                                                IsEnabled="{Binding IsDeclarationCheckEnabled}"
                                                VerticalOptions="CenterAndExpand" />

                                            <Label
                                                LineHeight="0.8"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZVatDeclarationInstructions}"
                                                VerticalOptions="CenterAndExpand"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <buttons:SfButton
                                            Clicked="OnAmendButtonClicked"
                                            IsVisible="{Binding IsVisibleAmendButton}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZZAmend}"
                                            VerticalOptions="CenterAndExpand" />

                                        <buttons:SfButton
                                            Clicked="OnContinueButtonClicked"
                                            IsVisible="{Binding IsMainButtonVisible}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{Binding ContinueText}"
                                            VerticalOptions="CenterAndExpand" />

                                        <buttons:SfButton
                                            Background="Transparent"
                                            Command="{Binding onRefundClicked}"
                                            IsEnabled="{Binding IsRefundButtonEnabled}"
                                            IsVisible="{Binding IsRefundButtonVisible}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{Binding RefundButtonText}"
                                            TextColor="{StaticResource NewDullOrangeColor}" />

                                        <buttons:SfButton
                                            Background="Transparent"
                                            Command="{Binding onSecondButtonClicked}"
                                            IsEnabled="{Binding IsGetSadadNumberEnabled}"
                                            IsVisible="{Binding isBtnVisible}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{Binding CreditDetailsText}"
                                            TextColor="{StaticResource NewDullOrangeColor}" />

                                        <buttons:SfButton
                                            Background="Transparent"
                                            Command="{Binding onCreditForwardClicked}"
                                            IsVisible="{Binding IsCreditForwardBtnVisible}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZCarriedCreditDetails}"
                                            TextColor="{StaticResource NewDullOrangeColor}" />

                                    </VerticalStackLayout>

                                </ScrollView>

                            </Grid>
                        </Grid>

                        <Grid
                            x:Name="VATReturnsSection"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.VATReturns}}"
                            RowDefinitions="auto,auto,auto,*"
                            RowSpacing="10">

                            <Label
                                Grid.Row="0"
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.8"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZZVATReturnForm}" />

                            <Label
                                Grid.Row="1"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />

                            <BoxView Grid.Row="2" Style="{StaticResource lineSeperator}" />

                            <ScrollView Grid.Row="3">
                                <VerticalStackLayout Spacing="10">

                                    <StackLayout Margin="0,0,0,20" Spacing="10">

                                        <Label
                                            LineHeight="0.8"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZDoyouhavesalesorpurchasessubjectto5VAT}" />

                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="10"
                                            IsEnabled="{Binding IsFivePercentTaxAmendGrid}">

                                            <Grid Grid.Column="0" IsEnabled="{Binding IsYesBoxEnabled}">

                                                <Image x:Name="YesImg" Source="{Binding YesBackgroundImage}" />

                                                <Label
                                                    x:Name="YesLbl"
                                                    Margin="10"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZYesText}"
                                                    TextColor="{Binding YesLabelColor}"
                                                    VerticalOptions="Center" />

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnYesTapped" />
                                                </Grid.GestureRecognizers>

                                            </Grid>

                                            <Grid Grid.Column="1" IsEnabled="{Binding IsNoBoxEnabled}">

                                                <Image x:Name="NoImg" Source="{Binding NoBackgroundImage}" />

                                                <Label
                                                    x:Name="NoLbl"
                                                    Margin="10"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZNoText}"
                                                    TextColor="{Binding NoLabelColor}"
                                                    VerticalOptions="Center" />

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnNoTapped" />
                                                </Grid.GestureRecognizers>

                                            </Grid>

                                        </Grid>

                                    </StackLayout>

                                    <StackLayout
                                        Margin="0,0,0,20"
                                        IsVisible="{Binding IsGovtYesNoVisible}"
                                        Spacing="10">

                                        <Label
                                            LineHeight="0.8"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZDoyouhavesalesorpurchasessubjecttoTax}" />

                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="10"
                                            IsEnabled="{Binding IsTaxAmendGrid}">

                                            <Grid Grid.Column="0" IsEnabled="{Binding IsTaxYesBoxEnabled}">

                                                <Image x:Name="TaxYesImg" Source="{Binding TaxYesBackgroundImage}" />

                                                <Label
                                                    x:Name="TaxYesLbl"
                                                    Margin="10"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZYesText}"
                                                    TextColor="{Binding TaxYesLabelColor}"
                                                    VerticalOptions="Center" />

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaxYesTapped" />
                                                </Grid.GestureRecognizers>

                                            </Grid>

                                            <Grid Grid.Column="1" IsEnabled="{Binding IsTaNoBoxEnabled}">

                                                <Image x:Name="TaxNoImg" Source="{Binding TaxNoBackgroundImage}" />

                                                <Label
                                                    x:Name="TaxNoLbl"
                                                    Margin="10"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZNoText}"
                                                    TextColor="{Binding TaxNoLabelColor}"
                                                    VerticalOptions="Center" />

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaxNoTapped" />
                                                </Grid.GestureRecognizers>

                                            </Grid>
                                        </Grid>

                                    </StackLayout>

                                    <buttons:SfButton
                                        Clicked="OnAmendButtonClicked"
                                        IsVisible="{Binding IsVisibleAmendButton}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZAmend}"
                                        VerticalOptions="CenterAndExpand" />

                                    <buttons:SfButton
                                        Clicked="OnContinueButtonClicked"
                                        IsVisible="{Binding IsMainButtonVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{Binding ContinueText}"
                                        VerticalOptions="CenterAndExpand" />

                                    <buttons:SfButton
                                        Background="Transparent"
                                        Command="{Binding onRefundClicked}"
                                        IsEnabled="{Binding IsRefundButtonEnabled}"
                                        IsVisible="{Binding IsRefundButtonVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{Binding RefundButtonText}"
                                        TextColor="{StaticResource NewDullOrangeColor}" />

                                    <buttons:SfButton
                                        Background="Transparent"
                                        Command="{Binding onSecondButtonClicked}"
                                        IsEnabled="{Binding IsGetSadadNumberEnabled}"
                                        IsVisible="{Binding isBtnVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{Binding CreditDetailsText}"
                                        TextColor="{StaticResource NewDullOrangeColor}" />

                                    <buttons:SfButton
                                        Background="Transparent"
                                        Command="{Binding onCreditForwardClicked}"
                                        IsVisible="{Binding IsCreditForwardBtnVisible}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZCarriedCreditDetails}"
                                        TextColor="{StaticResource NewDullOrangeColor}" />


                                </VerticalStackLayout>

                            </ScrollView>

                        </Grid>

                        <Grid
                            x:Name="SalesSection"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.Sales}}"
                            RowDefinitions="auto,auto,*"
                            RowSpacing="0">

                            <Label
                                Grid.Row="0"
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.8"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZVatOnSales}" />

                            <Label
                                Grid.Row="1"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />

                            <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">

                                <VerticalStackLayout>

                                    <Border Style="{StaticResource InputTableFrameStyle}">

                                        <Grid
                                            BindingContext="{Binding ResponseVATDeclarationD}"
                                            ColumnDefinitions="50*,50*"
                                            ColumnSpacing="5"
                                            RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto"
                                            Style="{StaticResource InputTableGridStyle}">

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                ColumnDefinitions="80*,20*"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                                RowDefinitions="auto">
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    LineHeight="0.8"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZVatStandardRatedSales}" />

                                                <!--  Must be visible as its not working now  -->
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    IsVisible="False"
                                                    Source="ic_vat_info"
                                                    Style="{StaticResource ImageStyleForInputTable}" />
                                            </Grid>

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZVatAmountWithSAR}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZVatAdjustmentWithSAR}" />


                                            <inputLayout:SfTextInputLayout
                                                x:Name="EntryVatAmountFrame"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                ContainerType="Outlined"
                                                HorizontalOptions="FillAndExpand"
                                                InputViewPadding="16,0,16,0"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="8">
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="EntryVatAmount"
                                                    Focused="EntryVatAmountFocused"
                                                    IsReadOnly="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsControlEnabledForEntry}"
                                                    Keyboard="Numeric"
                                                    PropertyChanged="EntryVatAmount_PropertyChanged"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding StdsalesAmt}"
                                                    TextChanged="ClickGestureRecognizer_ClickedForVatAmount"
                                                    Unfocused="EntryVatAmount_Unfocused">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                            Max="19"
                                                            numberOfDigitAfterDecimal="2"
                                                            numberOfDigitBeforDecimal="12" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                                <inputLayout:SfTextInputLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference EntryVatAmount}, Path=Text.Length}"
                                                        TargetType="inputLayout:SfTextInputLayout"
                                                        Value="0">
                                                        <Setter Property="HasError" Value="True" />
                                                    </DataTrigger>
                                                </inputLayout:SfTextInputLayout.Triggers>
                                            </inputLayout:SfTextInputLayout>

                                            <inputLayout:SfTextInputLayout
                                                x:Name="EntryVatAdjustmentWithSARFrame"
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                ContainerType="Outlined"
                                                HorizontalOptions="FillAndExpand"
                                                InputViewPadding="16,0,16,0"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsPrevReturn}"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="8">
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="EntryVatAdjustmentWithSAR"
                                                    Focused="EntryVatAdjustmentFocused"
                                                    IsReadOnly="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsControlEnabledForEntry}"
                                                    Keyboard="Numeric"
                                                    PropertyChanged="EntryVatAdjustmentWithSAR_PropertyChanged"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding StdsalesAdj}"
                                                    TextChanged="ClickGestureRecognizer_ClickedForVatAmount"
                                                    Unfocused="EntryVatAdjustmentWithSAR_Unfocused">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                            Max="19"
                                                            numberOfDigitAfterDecimal="2"
                                                            numberOfDigitBeforDecimal="12" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>

                                                <inputLayout:SfTextInputLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference EntryVatAdjustmentWithSAR}, Path=Text.Length}"
                                                        TargetType="inputLayout:SfTextInputLayout"
                                                        Value="0">
                                                        <Setter Property="HasError" Value="True" />
                                                    </DataTrigger>
                                                </inputLayout:SfTextInputLayout.Triggers>
                                            </inputLayout:SfTextInputLayout>

                                            <inputLayout:SfTextInputLayout
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                ContainerType="Outlined"
                                                HorizontalOptions="FillAndExpand"
                                                IsVisible="False"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="8">
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="EntryStdsalesVat"
                                                    InputTransparent="True"
                                                    IsReadOnly="True"
                                                    Keyboard="Numeric"
                                                    Style="{StaticResource InputTableEntryLayoutStyle}"
                                                    Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.StdsalesVat, StringFormat='{0:D2}'}"
                                                    TextColor="#7D858D" />

                                                <inputLayout:SfTextInputLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference EntryVatAdjustmentWithSAR}, Path=Text.Length}"
                                                        TargetType="inputLayout:SfTextInputLayout"
                                                        Value="0">
                                                        <Setter Property="HasError" Value="True" />
                                                    </DataTrigger>
                                                </inputLayout:SfTextInputLayout.Triggers>
                                            </inputLayout:SfTextInputLayout>

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                ColumnDefinitions="80*,20*"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsFifteenPersenctVisible}"
                                                RowDefinitions="auto">
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVatStandardRatedSales15}" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Source="ic_vat_info"
                                                    Style="{StaticResource ImageStyleForInputTable}">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnNewStandardRatedSalesAmount15Clicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Grid>

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsFifteenPersenctVisible}"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZVatAmountWithSAR}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsFifteenPersenctVisible}"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZVatAdjustmentWithSAR}" />

                                            <inputLayout:SfTextInputLayout
                                                x:Name="EntryVatAmountFrame15"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                ContainerType="Outlined"
                                                HorizontalOptions="FillAndExpand"
                                                InputViewPadding="16,0,16,0"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsFifteenPersenctVisible}"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="8">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="EntryVatAmount15"
                                                    Focused="EntryVatAmount15Focused"
                                                    IsReadOnly="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.IsControlEnabledForEntry}"
                                                    Keyboard="Numeric"
                                                    PropertyChanged="EntryVatAmount15_PropertyChanged"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.VATNewModelFor15Percent.StdsalesAmt}"
                                                    TextChanged="ClickGestureRecognizer_ClickedForVatAmount15"
                                                    Unfocused="EntryVatAmount15_Unfocused">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                            Max="19"
                                                            numberOfDigitAfterDecimal="2"
                                                            numberOfDigitBeforDecimal="12" />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                                <inputLayout:SfTextInputLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference EntryVatAmount15}, Path=Text.Length}"
                                                        TargetType="inputLayout:SfTextInputLayout"
                                                        Value="0">
