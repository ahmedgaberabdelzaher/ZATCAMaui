<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.ShowVatInformationConfirmationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        x:Name="MainPanCakeView1"
        Padding="15"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <ListView
                x:Name="InformationList"
                Grid.Row="1"
                BackgroundColor="White"
                HasUnevenRows="True"
                HorizontalOptions="FillAndExpand"
                ItemsSource="{Binding HeaderWithInfoList}"
                SeparatorVisibility="None"
                VerticalOptions="FillAndExpand">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Margin="0,0,0,7" Spacing="15">
                                <Frame
                                    Padding="15"
                                    BorderColor="{StaticResource DarkGrayTextColor}"
                                    CornerRadius="12"
                                    HasShadow="False">
                                    <StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="ic_vat_info" />
                                            <Label
                                                x:Name="HeaderTextlbl"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding HeaderText}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference HeaderTextlbl}, Path=Text.Length}"
                                                        TargetType="Label"
                                                        Value="0">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding Message}" />
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackLayout
                Grid.Row="2"
                Margin="0,0,0,0"
                BackgroundColor="White"
                VerticalOptions="FillAndExpand">

                <buttons:SfButton
                    x:Name="btnprimary"
                    Margin="10,0,10,0"
                    Clicked="YesButtonClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZYes}"
                    VerticalOptions="CenterAndExpand" />
                <buttons:SfButton
                    x:Name="btnprimary1"
                    Margin="10,0,10,0"
                    Clicked="NoButtonClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZNo}"
                    VerticalOptions="CenterAndExpand" />

            </StackLayout>
        </Grid>
    </Border>
</pages:PopupPage>