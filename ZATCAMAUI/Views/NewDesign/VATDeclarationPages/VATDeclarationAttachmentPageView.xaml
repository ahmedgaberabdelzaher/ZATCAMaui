<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.VATDeclarationAttachmentPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    Title="Attachments">
    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>-->

    <yummy:PancakeView
        Grid.Row="0"
        Padding="0"
        HeightRequest="400"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <Grid>
            <StackLayout Grid.Row="0">
                <ScrollView>
                    <Grid Padding="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0" Spacing="0">

                            <StackLayout Spacing="0">
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="CenterAndExpand"
                                    Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachments}"
                                    VerticalOptions="Center" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachmentSizeNotfication}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachmentTypeNotfication}"
                                    VerticalOptions="EndAndExpand" />
                                <custom:CustomLabel
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachmentMaxSizeNotfication}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachments}" />
                                <Border
                                    Margin="0"
                                    Stroke="{StaticResource DarkGrayTextColor}"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{Binding AttachmentName}" />

                                        <Image HorizontalOptions="EndAndExpand" Rotation="90">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                    Size="25"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                        </StackLayout.GestureRecognizers>
                                    </StackLayout>
                                </Border>

                                <StackLayout
                                    Padding="0,10,0,10"
                                    HeightRequest="300"
                                    Orientation="Horizontal">
                                    <ListView
                                        x:Name="list"
                                        BackgroundColor="White"
                                        HasUnevenRows="True"
                                        HorizontalOptions="FillAndExpand"
                                        ItemTapped="Attachmentlist_ItemTapped"
                                        ItemsSource="{Binding AttachmentList}"
                                        SeparatorVisibility="None"
                                        VerticalOptions="FillAndExpand"
                                        VerticalScrollBarVisibility="Never">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <ViewCell>
                                                    <StackLayout Padding="0,5,0,5" HorizontalOptions="FillAndExpand">

                                                        <Border
                                                            Margin="0"
                                                            Stroke="{StaticResource DarkGrayTextColor}"
                                                            StrokeThickness="1"
                                                            Style="{StaticResource GreyBorderFrameWithShadow}">

                                                            <StackLayout Padding="0,10,0,10" Orientation="Horizontal">
                                                                <Image
                                                                    Margin="5"
                                                                    HeightRequest="25"
                                                                    Source="Generic_attachment_icon.png"
                                                                    WidthRequest="25" />

                                                                <Label
                                                                    HorizontalOptions="Start"
                                                                    LineBreakMode="TailTruncation"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding Filename}" />

                                                                <Image Margin="5" HorizontalOptions="EndAndExpand">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                            Size="25"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>


                                                            </StackLayout>

                                                        </Border>
                                                    </StackLayout>
                                                </ViewCell>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                </StackLayout>


                            </StackLayout>



                        </StackLayout>




                    </Grid>
                </ScrollView>
                <StackLayout Padding="10" BackgroundColor="White">
                    <buttons:SfButton
                        Clicked="OnCloseTapped"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZDone}" />

                </StackLayout>
            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="-20"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            SizeFactor="0.7"
                            TextColor="{StaticResource Primary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>

        </Grid>

    </yummy:PancakeView>


</pages:PopupPage>
