<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.SummaryInstruction"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        Margin="0,200,0,0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="End">
        <ScrollView VerticalScrollBarVisibility="Never">
            <StackLayout>
                <Label
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{x:Static ResourceManager:AppResources.ZVatTermsAndConditions}"
                    VerticalOptions="StartAndExpand" />

                <Label
                    HorizontalOptions="StartAndExpand"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    VerticalOptions="EndAndExpand">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="1." />
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatTandCone}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label
                    HorizontalOptions="StartAndExpand"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    VerticalOptions="EndAndExpand">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="2." />
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatTandCtwo}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label
                    HorizontalOptions="StartAndExpand"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    VerticalOptions="EndAndExpand">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="3." />
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatTandCthree}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label
                    HorizontalOptions="StartAndExpand"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    VerticalOptions="EndAndExpand">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="4." />
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVatTandCfour}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Style="{StaticResource CaptionLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZVatCertifyInformation}" />

            </StackLayout>
        </ScrollView>
    </Border>
</Mopups:PopupPage>