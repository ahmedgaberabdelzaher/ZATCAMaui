<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.NewAccountPopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    BackgroundColor="#88000000"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand">
        <StackLayout>
            <Image
                Margin="15,10,15,0"
                HorizontalOptions="EndAndExpand"
                Source="close.png">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Closed_Tapped" />
                </Image.GestureRecognizers>
            </Image>
            <StackLayout>
                <Label
                    Style="{StaticResource ValueLabelBlackBold}"
                    Text="{Binding AccountText}"
                    VerticalOptions="Center" />

                <Label Style="{StaticResource ValueLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.NAIBAN}" />
            </StackLayout>

            <StackLayout Padding="0,0,0,15" FlowDirection="LeftToRight">
                <Border
                    Padding="0"
                    Stroke="LightGray"
                    StrokeShape="RoundRectangle 8,8,8,8">
                    <StackLayout Orientation="Horizontal">
                        <StackLayout
                            Padding="5,8,0,8"
                            HorizontalOptions="Center"
                            Orientation="Horizontal">
                            <StackLayout Orientation="Horizontal">
                                <BoxView
                                    BackgroundColor="{StaticResource Primary}"
                                    CornerRadius="15"
                                    HeightRequest="30"
                                    WidthRequest="30" />
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.NASA}"
                                    VerticalTextAlignment="Center" />

                            </StackLayout>
                        </StackLayout>
                        <BoxView BackgroundColor="LightGray" WidthRequest="1" />
                        <StackLayout Padding="0,5,0,5" Orientation="Horizontal">
                            <custom:GAZTBorderlessEntry
                                x:Name="IbanOne"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="Small"
                                Keyboard="Numeric"
                                MaxLength="2"
                                Placeholder="03"
                                ReturnType="Next"
                                Text="{Binding IbanPartOne}"
                                TextChanged="IbanOne_TextChanged">

                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behavior:OnlyNumericValuesBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>

                            </custom:GAZTBorderlessEntry>
                            <BoxView
                                BackgroundColor="LightGray"
                                HeightRequest="30"
                                WidthRequest="1" />
                            <custom:GAZTBorderlessEntry
                                x:Name="IbanTwo"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="Small"
                                Keyboard="Numeric"
                                MaxLength="8"
                                Placeholder="80000000"
                                ReturnType="Next"
                                Text="{Binding IbanPartTwo}"
                                TextChanged="IbanTwo_TextChanged">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behavior:OnlyNumericValuesBehaviour />
                                    <behavior:EntryFocusBehaviour NextFocusElementName="IbanThree" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                            <BoxView
                                BackgroundColor="LightGray"
                                HeightRequest="30"
                                WidthRequest="1" />
                            <custom:GAZTBorderlessEntry
                                x:Name="IbanThree"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="Small"
                                Keyboard="Numeric"
                                MaxLength="4"
                                Placeholder="0000"
                                ReturnType="Next"
                                Text="{Binding IbanPartThree}"
                                TextChanged="IbanThree_TextChanged">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behavior:OnlyNumericValuesBehaviour />
                                    <behavior:EntryFocusBehaviour NextFocusElementName="IbanFour" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                            <BoxView
                                BackgroundColor="LightGray"
                                HeightRequest="30"
                                WidthRequest="1" />
                            <custom:GAZTBorderlessEntry
                                x:Name="IbanFour"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="Small"
                                Keyboard="Numeric"
                                MaxLength="4"
                                Placeholder="0000"
                                ReturnType="Next"
                                Text="{Binding IbanPartFour}"
                                TextChanged="IbanFour_TextChanged">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behavior:OnlyNumericValuesBehaviour />
                                    <behavior:EntryFocusBehaviour NextFocusElementName="IbanFive" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                            <BoxView
                                BackgroundColor="LightGray"
                                HeightRequest="30"
                                WidthRequest="1" />
                            <custom:GAZTBorderlessEntry
                                x:Name="IbanFive"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="Small"
                                Keyboard="Numeric"
                                MaxLength="4"
                                Placeholder="0000"
                                Text="{Binding IbanPartFive}"
                                TextChanged="IbanFive_TextChanged">

                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behavior:OnlyNumericValuesBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>

                            </custom:GAZTBorderlessEntry>

                        </StackLayout>
                    </StackLayout>

                </Border>
            </StackLayout>

            <buttons:SfButton
                Clicked="IbanAddButtonClicked"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZZZZConfirmRefund}" />
        </StackLayout>
    </Border>
</Mopups:PopupPage>