<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.VATReturnSuccessfullPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0" Padding="15,5,15,0">
                <Image
                    HorizontalOptions="End"
                    Source="close"
                    VerticalOptions="CenterAndExpand" />
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnBackButtonClicked}" />
                </StackLayout.GestureRecognizers>
            </StackLayout>

            <ScrollView
                Grid.Row="1"
                Margin="0,8,0,0"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Start">
                <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="Start">

                    <Image Source="Forget_ic_success" />
                    <Label
                        Margin="0,20,0,0"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleBlack}"
                        StyleId="OnBoardText"
                        Text="{x:Static ResourceManager:AppResources.ZVatReturn}"
                        TextColor="White" />
                    <Label
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsCreditCarriedTextVisible}"
                        Style="{StaticResource CaptionLabelBlack}"
                        StyleId="OnBoardText"
                        Text="{x:Static ResourceManager:AppResources.ZZZZVATReturnsubmitted}"
                        TextColor="White" />
                    <Label
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsSadadNumberVisible}"
                        Style="{StaticResource CaptionLabelBlack}"
                        StyleId="OnBoardText"
                        TextColor="White">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZZZVatReturnSubmittedNew}" />
                                <Span Text="&#160;&#160;" />
                                <Span
                                    Text="{Binding AmountPayable, Converter={StaticResource commaSeparatorConverter}}"
                                    TextColor="White" />
                                <Span Text="&#160;" />
                                <Span
                                    Text="{x:Static ResourceManager:AppResources.ZSAR}"
                                    TextColor="White" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label
                        Margin="0,8,0,0"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsSadadNumberVisible}"
                        Style="{StaticResource CaptionLabelBlack}"
                        StyleId="OnBoardText"
                        Text="{x:Static ResourceManager:AppResources.ZZZZRemembertocompletepayment}"
                        TextColor="White" />

                </StackLayout>
            </ScrollView>

            <Border
                Grid.Row="2"
                Padding="0,10,0,40"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">

                <Grid
                    Padding="20,0,20,0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0">

                        <ScrollView>
                            <StackLayout Spacing="0">
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,5,15,5" Orientation="Horizontal">

                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding ReturnReferenceNumber}" />

                                        </StackLayout>
                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,5,15,5" Orientation="Horizontal">

                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TaxablePeriod}" />
                                        </StackLayout>
                                    </StackLayout>
                                </Border>


                            </StackLayout>
                        </ScrollView>
                    </StackLayout>
                    <StackLayout
                        Grid.Row="1"
                        Padding="0,2,0,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        Spacing="4"
                        VerticalOptions="FillAndExpand">
                        <buttons:SfButton
                            Margin="0,0,0,1"
                            Clicked="OnVATRefreshButtonClicked"
                            IsVisible="{Binding IsRefreshButtonVisible}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZVatRefresh}" />
                        <buttons:SfButton
                            Margin="0,0,0,1"
                            Clicked="OnVATPayNowClicked"
                            IsVisible="{Binding IsSadadNumberVisible}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}" />
                        <buttons:SfButton
                            Margin="0,0,0,1"
                            Background="Transparent"
                            Command="{Binding OnAcknowlwdgementClicked}"
                            IsVisible="{Binding IsAcknowledgementButtonVisible}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.DownloadAcknowlwdgement}"
                            TextColor="{StaticResource NewDullOrangeColor}" />
                        <buttons:SfButton
                            Margin="0,0,0,-10"
                            Background="Transparent"
                            Command="{Binding OnDownloadFormClicked}"
                            IsVisible="{Binding IsButtonVisible}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                            TextColor="{StaticResource NewDullOrangeColor}" />
                    </StackLayout>
                </Grid>
            </Border>

        </Grid>


    </ContentPage.Content>
</ContentPage>