<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeclarationPages.NotesPopUpPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border Style="{StaticResource CommonTopCurves}" VerticalOptions="End">
        <StackLayout>
            <Image HorizontalOptions="EndAndExpand" Source="close.png">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Image.GestureRecognizers>
            </Image>

            <Label Style="{StaticResource SectionTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZVatNotes}" />


            <inputLayout:SfTextInputLayout
                Margin="0,-6,0,-6"
                ContainerType="Outlined"
                HasError="{Binding IsReportDetailHasError}"
                IsHintAlwaysFloated="True"
                OutlineCornerRadius="8"
                Stroke="{StaticResource Primary}">
                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <inputLayout:LabelStyle TextColor="#B00020" />
                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <StackLayout Margin="0,16,0,0" Orientation="Vertical">
                    <Editor
                        x:Name="NoteDetail"
                        AutoSize="TextChanges"
                        FontSize="Small"
                        HeightRequest="200"
                        HorizontalOptions="FillAndExpand"
                        IsSpellCheckEnabled="False"
                        MaxLength="999"
                        Text="{Binding NoteText}"
                        Unfocused="NoteDetail_Unfocused" />

                    <Label
                        FontSize="Micro"
                        HorizontalOptions="EndAndExpand"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding Source={x:Reference NoteDetail}, Path=Text.Length, StringFormat='{0}/999'}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                </StackLayout>


            </inputLayout:SfTextInputLayout>


            <buttons:SfButton
                Margin="0,8,0,0"
                Command="{Binding OnAddButtonClicked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZVatNotesSaveandClose}"
                VerticalOptions="CenterAndExpand" />
            <buttons:SfButton
                Margin="0,8,0,0"
                Command="{Binding OnClearButtonClicked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZVatNotesClearandClose}"
                VerticalOptions="CenterAndExpand" />
        </StackLayout>
    </Border>
</pages:PopupPage>