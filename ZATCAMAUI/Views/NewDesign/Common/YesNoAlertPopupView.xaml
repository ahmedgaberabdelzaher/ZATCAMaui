<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.YesNoAlertPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    FlowDirection="{Binding AppDirection}">
    <Border
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <ScrollView>
            <StackLayout>
                <Label
                    x:Name="MessageText"
                    Margin="10"
                    Style="{StaticResource BodyLabelBlack}" />
                <buttons:SfButton
                    x:Name="btnOK"
                    Clicked="OnOkButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}" />
                <buttons:SfButton
                    x:Name="btnNO"
                    Clicked="OnNoButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackLayout>
        </ScrollView>
    </Border>
</Mopups:PopupPage>