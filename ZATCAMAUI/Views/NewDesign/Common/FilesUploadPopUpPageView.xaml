<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.FilesUploadPopUpPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    FlowDirection="RightToLeft">

    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>-->

    <yummy:PancakeView
        BackgroundColor="White"
        CornerRadius="22,22,0,0"
        VerticalOptions="End">
        <Grid>
            <StackLayout Margin="10,0,10,0" Padding="0,0,0,0">

                <StackLayout Orientation="Vertical">
                    <BoxView
                        HorizontalOptions="Center"
                        Style="{StaticResource NeutralGrayBoxViewDrag}"
                        VerticalOptions="Start" />
                    <buttons:SfButton
                        Margin="10,10,10,10"
                        Background="Transparent"
                        Command="{Binding GoButtonClick}"
                        FontAttributes="Bold"
                        FontSize="Medium"
                        HorizontalOptions="End"
                        Style="{StaticResource GAZTVerifyButton}"
                        Text="{x:Static ResourceManager:AppResources.CRDone}"
                        TextColor="{StaticResource Primary}" />
                </StackLayout>
                <Label
                    Margin="0,0,0,0"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding TitleOne}" />
                <Label
                    Margin="0,0,0,0"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding TitleTwo}" />
                <BoxView Margin="0,0,0,10" Style="{StaticResource lineSeperator}" />
                <ListView
                    x:Name="List"
                    HasUnevenRows="True"
                    HeightRequest="300"
                    HorizontalOptions="FillAndExpand"
                    ItemTapped="Attachmentlist_ItemTapped"
                    ItemsSource="{Binding AttachmentList}"
                    SeparatorVisibility="None"
                    VerticalOptions="FillAndExpand">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ContentView>
                                    <cards:SfCardView
                                        Margin="10"
                                        BackgroundColor="White"
                                        BorderColor="{StaticResource NeutralLightGrey}"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        IndicatorColor="{StaticResource Primary}"
                                        IndicatorPosition="Left"
                                        IndicatorThickness="5"
                                        Opacity=".9">
                                        <StackLayout
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal"
                                            VerticalOptions="CenterAndExpand">
                                            <Grid
                                                BackgroundColor="White"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="2"
                                                Style="{DynamicResource GridStyle}"
                                                VerticalOptions="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70*" />
                                                    <ColumnDefinition Width="15*" />
                                                    <ColumnDefinition Width="15*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="30" />
                                                </Grid.RowDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    LineBreakMode="TailTruncation"
                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                    Text="{Binding Filename}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="2"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Source="ic_delete.png"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="3,0,3,-5"
                                                    FlowDirection="LeftToRight"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MiniGrayLabelStyle}"
                                                    Text="{Binding Erfdt}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </Grid>
                                        </StackLayout>
                                    </cards:SfCardView>
                                </ContentView>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <buttons:SfButton
                    x:Name="btnAddAttachment"
                    Margin="0,0,0,20"
                    Background="{StaticResource Secondary}"
                    Command="{Binding OnAttachmentClick}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="{StaticResource SomarSemiBold}"
                    FontSize="15"
                    HeightRequest="56"
                    StrokeThickness="0"
                    Text="{x:Static ResourceManager:AppResources.FAPAddAttachment}"
                    TextColor="{DynamicResource Gray-White}"
                    VerticalOptions="End" />
            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="{Binding IsLoading}"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="Center" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </yummy:PancakeView>
</pages:PopupPage>