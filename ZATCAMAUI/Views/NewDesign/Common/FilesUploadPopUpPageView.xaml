<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.FilesUploadPopUpPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}">

    <Border
        BackgroundColor="White"
        Stroke="{StaticResource NeutralLightGrey}"
        StrokeShape="RoundRectangle 22,22,0,0"
        VerticalOptions="End">
        <Grid RowDefinitions="Auto,Auto">
            <StackLayout Padding="10" Spacing="10">

                <buttons:SfButton
                    Background="Transparent"
                    Command="{Binding GoButtonClick}"
                    FontAttributes="Bold"
                    FontSize="Medium"
                    HorizontalOptions="End"
                    Text="{x:Static ResourceManager:AppResources.CRDone}"
                    TextColor="{StaticResource Primary}" />

                <Label
                    Margin="0,0,0,0"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding TitleOne}" />

                <Label
                    Margin="0,0,0,0"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding TitleTwo}" />

                <BoxView Margin="0,10" Style="{StaticResource lineSeperator}" />

                <ListView
                    x:Name="List"
                    HasUnevenRows="True"
                    HorizontalOptions="FillAndExpand"
                    ItemsSource="{Binding AttachmentList}"
                    MinimumHeightRequest="100"
                    SelectedItem="{Binding AttachmentItem}"
                    SeparatorVisibility="None"
                    VerticalOptions="FillAndExpand">
                    <ListView.Behaviors>
                        <xct:EventToCommandBehavior Command="{Binding AttachmentItemSelected}" EventName="ItemSelected" />

                    </ListView.Behaviors>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ContentView>
                                    <cards:SfCardView
                                        Margin="10"
                                        BackgroundColor="White"
                                        BorderColor="{StaticResource NeutralLightGrey}"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        IndicatorColor="{StaticResource Primary}"
                                        IndicatorPosition="Left"
                                        IndicatorThickness="5"
                                        Opacity=".9">
                                        <StackLayout
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal"
                                            VerticalOptions="CenterAndExpand">
                                            <Grid
                                                BackgroundColor="White"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="2"
                                                Style="{DynamicResource GridStyle}"
                                                VerticalOptions="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70*" />
                                                    <ColumnDefinition Width="15*" />
                                                    <ColumnDefinition Width="15*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="30" />
                                                </Grid.RowDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    LineBreakMode="TailTruncation"
                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                    Text="{Binding Filename}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="2"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Source="ic_delete.png"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="3,0,3,-5"
                                                    FlowDirection="LeftToRight"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MiniGrayLabelStyle}"
                                                    Text="{Binding Erfdt}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </Grid>
                                        </StackLayout>
                                    </cards:SfCardView>
                                </ContentView>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <buttons:SfButton
                    x:Name="btnAddAttachment"
                    Margin="0,20,0,35"
                    Command="{Binding OnAttachmentClick}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.FAPAddAttachment}" />

            </StackLayout>


            <custom:Loader IsVisible="{Binding IsLoading}" />

        </Grid>

    </Border>
</Mopups:PopupPage>