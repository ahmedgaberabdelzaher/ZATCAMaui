<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.NativeNafath.NativeNafathPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviour="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NafathLoginHeader}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->


            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">
                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand"
                                 Padding="10">

                        <!--  NafathLoginSubHeader Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.NafathLoginSubHeader}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Horizontal Line  -->
                        <BoxView
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2"
                            WidthRequest="20" />

                        <!--  NationalIqamaID Field  -->
                        <StackLayout Spacing="0">

                            <!--  NationalIqamaID Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">

                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.NationalIqamaID}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>

                            </Label>

                            <!--  NationalIqamaID Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                 IsHintAlwaysFloated="True"
                                Stroke="{StaticResource NeutralGreay}">
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <custom:GAZTBorderlessEntry
                                    x:Name="entry"
                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.NationalIqamaID}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding NationalIqamaId}"
                                    TextColor="#58595B">

                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behaviour:OnlyNumericValuesBehaviour />
                                    </custom:GAZTBorderlessEntry.Behaviors>

                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>

                        <!--  GoTo Login Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            Command="{Binding NativeNafathLoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.NDSwitchUser}"
                            VerticalOptions="EndAndExpand">

                            <buttons:SfButton.Triggers>
                                <DataTrigger
                                    Binding="{Binding Source={x:Reference entry}, Path=Text.Length}"
                                    TargetType="buttons:SfButton"
                                    Value="0">
                                    <Setter Property="InputTransparent" Value="True" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </buttons:SfButton.Triggers>

                        </buttons:SfButton>


                    </StackLayout>

                </ScrollView>
                </Grid>
            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>

