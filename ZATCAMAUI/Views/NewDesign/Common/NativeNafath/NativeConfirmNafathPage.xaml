<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.NativeNafath.NativeConfirmNafathPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="15,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="18"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NafathLoginHeader}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->


            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,35,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="20" VerticalOptions="FillAndExpand">

                        <!--  OpenNafath/Confirm Openning Nafath Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            LineBreakMode="WordWrap"
                            LineHeight="1"
                            TextColor="#002447">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.OpenNafath}" />
                                    <Span Text="&#10;" />
                                    <Span FontFamily="{StaticResource SomarRegular}" Text="{x:Static ResourceManager:AppResources.ConfirmOpenningNafath}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!--  Horizontal Line  -->
                        <BoxView
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />

                        <!--  ConfirmOpenningNafath Label  -->
                        <Frame
                            Margin="0,30,0,0"
                            Padding="10"
                            BorderColor="Black"
                            CornerRadius="20"
                            HasShadow="False"
                            HeightRequest="50"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="Start"
                            WidthRequest="50">

                            <!--  ConfirmOpenningNafath Label  -->
                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="20"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                Text="{Binding RandomNumber}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="CenterAndExpand"
                                VerticalTextAlignment="Center" />

                        </Frame>

                        <!--  Cancel Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            Background="Transparent"
                            Command="{Binding BackCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Stroke="Transparent"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.CancelText}"
                            TextColor="{StaticResource Secondary}" />

                    </StackLayout>

                </ScrollView>

            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>

