<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.MoreMenuPopUpPageViewRTwo"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border
        Padding="15"
        BackgroundColor="White"
        Stroke="{StaticResource NeutralLightGrey}"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">
        <StackLayout HorizontalOptions="CenterAndExpand">
            <ListView
                x:Name="btnList"
                Grid.Row="1"
                BackgroundColor="White"
                HasUnevenRows="True"
                HeightRequest="130"
                HorizontalOptions="CenterAndExpand"
                ItemSelected="SelectButton"
                ItemsSource="{Binding VatReturnUIButtons}"
                SeparatorVisibility="None"
                VerticalOptions="FillAndExpand">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>

                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="{Binding}" />

                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>
    </Border>
</Mopups:PopupPage>