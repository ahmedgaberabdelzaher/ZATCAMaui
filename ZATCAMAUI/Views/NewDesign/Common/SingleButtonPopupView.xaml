<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.SingleButtonPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    BackgroundClicked="OnBackGroundClicked"
    FlowDirection="{Binding AppDirection}">
    <Border
        BackgroundColor="White"
        Stroke="Transparent"
        StrokeThickness="0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <ScrollView VerticalScrollBarVisibility="Never">

            <StackLayout>
                <Label
                    x:Name="lblPopupHeader"
                    Margin="0,0,0,16"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource SectionTitleBlackBold}"
                    Text="{x:Static ResourceManager:AppResources.ZVatRefundTermsAndConditions}" />
                <Border
                    Margin="0,0,0,10"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    Style="{StaticResource GreyBorderFrame}">
                    <Label
                        x:Name="MessageText"
                        Margin="5"
                        LineHeight="1"
                        Style="{StaticResource BodyLabelBlack}" />
                </Border>
                <buttons:SfButton
                    x:Name="btnOK"
                    Clicked="OnOkayButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackLayout>
        </ScrollView>
    </Border>
</Mopups:PopupPage>