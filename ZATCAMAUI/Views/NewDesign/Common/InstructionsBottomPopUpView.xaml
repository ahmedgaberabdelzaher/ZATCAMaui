<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.InstructionsBottomPopUpView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    CloseWhenBackgroundIsClicked="False"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">


    <Grid>


        <Border
            Padding="15,0,15,0"
            BackgroundColor="White"
            IsVisible="{Binding IsCancelButtonVisible}"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="EndAndExpand">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>



                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        HorizontalOptions="End"
                        Source="ic_close"
                        VerticalOptions="End">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Close_Tapped}" />
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>

                <Grid Margin="0,32,0,0" HorizontalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>



                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>



                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="15"
                        HorizontalOptions="Center"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructionsTitle}"
                        VerticalOptions="Center" />
                </Grid>




                <ScrollView
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        Orientation="Vertical">



                        <Border
                            Grid.Row="0"
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">



                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>



                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>



                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="false"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.Information}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight="1"
                                    Style="{StaticResource TCBodyLabelGrey}"
                                    Text="{Binding Description}" />
                            </Grid>
                        </Border>



                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackLayout
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                                <custom:CheckboxCustom
                                    CheckChanged="CheckBox_CheckedChanged"
                                    IsChecked="{Binding IsInstuctionsChecked}"
                                    IsEnabled="{Binding IsCheckboxEditable}"
                                    Style="{StaticResource CheckboxHeightWidth32}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight="0.8"
                                    Text="{Binding CheckBoxDescription}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="Label"
                                            Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </StackLayout>
                        </Grid>



                        <buttons:SfButton
                            Margin="0,24,0,24"
                            Background="{Binding ContinueBackGroundColor}"
                            Command="{Binding InstructionsContinueClick}"
                            IsEnabled="{Binding IsContinueEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ButtonTitle}"
                            VerticalOptions="End" />
                    </StackLayout>
                </ScrollView>




            </Grid>
        </Border>


        <Border
            Padding="15,0,15,0"
            BackgroundColor="White"
            IsVisible="{Binding IsInstructions}"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="EndAndExpand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,32,0,0" HorizontalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>



                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>



                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="15"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructionsTitle}"
                        VerticalOptions="CenterAndExpand" />
                </Grid>




                <ScrollView
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        Orientation="Vertical">



                        <Border
                            Grid.Row="0"
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">



                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>



                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>



                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="false"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.Information}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight="1"
                                    Style="{StaticResource TCBodyLabelGrey}"
                                    Text="{Binding Description}" />
                            </Grid>
                        </Border>



                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackLayout
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="StartAndExpand"
                                Orientation="Horizontal">
                                <custom:CheckboxCustom
                                    CheckChanged="CheckBox_CheckedChanged"
                                    IsChecked="{Binding IsInstuctionsChecked}"
                                    IsEnabled="{Binding IsCheckboxEditable}"
                                    Style="{StaticResource CheckboxHeightWidth32}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight="0.8"
                                    Text="{Binding CheckBoxDescription}"
                                    VerticalOptions="CenterAndExpand">

                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="Label"
                                            Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </StackLayout>
                        </Grid>



                        <buttons:SfButton
                            Margin="0,24,0,24"
                            Background="{Binding ContinueBackGroundColor}"
                            Command="{Binding InstructionsContinueClick}"
                            IsEnabled="{Binding IsContinueEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ButtonTitle}"
                            VerticalOptions="End" />
                    </StackLayout>
                </ScrollView>




            </Grid>
        </Border>
        <Border
            Padding="15,0,15,0"
            BackgroundColor="White"
            IsVisible="{Binding IsTerms}"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="EndAndExpand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
                    Margin="0,32,0,0"
                    FontSize="15"
                    HorizontalOptions="Center"
                    Style="{StaticResource ValueLabelBlackBold}"
                    Text="{x:Static ResourceManager:AppResources.BPTermsAndConditions}" />
                <ScrollView Grid.Row="1">
                    <StackLayout
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        Orientation="Vertical">


                        <Border
                            Grid.Row="0"
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0 "
                                    IsVisible="False">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>

                                </Image>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    FontSize="15"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="False"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.Information}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight="1.5"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{Binding Description}" />

                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>


                            <custom:CheckboxCustom
                                Grid.Row="0"
                                Grid.Column="0"
                                CheckChanged="CheckBox_CheckedChanged"
                                IsChecked="{Binding IsTermsChecked}"
                                IsEnabled="{Binding IsCheckboxEditable}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.8"
                                Text="{Binding CheckBoxDescription}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsTermsChecked}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsTermsChecked}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>



                        <buttons:SfButton
                            Margin="0,24,0,24"
                            Background="{Binding ContinueBackGroundColor}"
                            Command="{Binding TermsContinueClick}"
                            IsEnabled="{Binding IsContinueEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ButtonTitle}"
                            VerticalOptions="End" />
                    </StackLayout>

                </ScrollView>

            </Grid>
        </Border>

    </Grid>

</pages:PopupPage>