<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Common.InstructionsBottomPopUpView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundColor="#88000000"
    CloseWhenBackgroundIsClicked="False"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">


    <Grid VerticalOptions="End">
        <Border
            Padding="15,0"
            BackgroundColor="White"
            IsVisible="{Binding IsCancelButtonVisible}"
            Stroke="{StaticResource NeutralLightGrey}"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="End">


            <Grid RowDefinitions="auto,auto,*,*">

                <Image
                    Margin="0,10,0,0"
                    HorizontalOptions="End"
                    Source="ic_close"
                    VerticalOptions="End">

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Close_Tapped}" />
                    </Image.GestureRecognizers>
                </Image>

                <StackLayout
                    Grid.Row="1"
                    Margin="0,32,0,0"
                    HorizontalOptions="StartAndExpand"
                    Orientation="Horizontal">

                    <Image
                        Margin="0,0,5,0"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>

                    <Label
                        FontSize="15"
                        HorizontalOptions="Center"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructionsTitle}"
                        VerticalOptions="Center" />

                </StackLayout>

                <ScrollView
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Never">

                    <StackLayout
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        Spacing="10">

                        <Border
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <Grid
                                Margin="8"
                                ColumnDefinitions="auto,*"
                                RowDefinitions="auto,auto">

                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                </Image>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Description}" />
                            </Grid>

                        </Border>

                        <StackLayout Orientation="Horizontal" Spacing="10">

                            <custom:CheckboxCustom
                                CheckChanged="CheckBox_CheckedChanged"
                                IsChecked="{Binding IsInstuctionsChecked}"
                                IsEnabled="{Binding IsCheckboxEditable}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />

                            <Label
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.8"
                                Text="{Binding CheckBoxDescription}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsInstuctionsChecked}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsInstuctionsChecked}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                        </StackLayout>

                    </StackLayout>

                </ScrollView>

                <buttons:SfButton
                    Grid.Row="3"
                    Margin="0,24"
                    Background="{Binding ContinueBackGroundColor}"
                    Command="{Binding InstructionsContinueClick}"
                    IsEnabled="{Binding IsContinueEnabled}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding ButtonTitle}"
                    VerticalOptions="End" />

            </Grid>

        </Border>

        <Border
            Padding="15,0,15,0"
            BackgroundColor="White"
            IsVisible="{Binding IsInstructions}"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="End">
            <Grid RowDefinitions="auto,*">


                <StackLayout
                    Margin="0,32,0,0"
                    HorizontalOptions="StartAndExpand"
                    Orientation="Horizontal"
                    Spacing="10">

                    <Image
                        Margin="0,0,5,0"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>

                    <Label
                        FontSize="15"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructionsTitle}"
                        VerticalOptions="CenterAndExpand" />
                </StackLayout>


                <ScrollView
                    Grid.Row="1"
                    Orientation="Vertical"
                    VerticalScrollBarVisibility="Never">

                    <Grid
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        RowDefinitions="auto,auto,auto"
                        RowSpacing="10">

                        <Border
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <Grid
                                Margin="8"
                                ColumnDefinitions="auto,*"
                                RowDefinitions="auto,auto">

                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                </Image>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Description}" />
                            </Grid>
                        </Border>

                        <StackLayout
                            Grid.Row="1"
                            HorizontalOptions="StartAndExpand"
                            Orientation="Horizontal"
                            Spacing="10">

                            <custom:CheckboxCustom
                                CheckChanged="CheckBox_CheckedChanged"
                                IsChecked="{Binding IsInstuctionsChecked}"
                                IsEnabled="{Binding IsCheckboxEditable}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />

                            <Label
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.8"
                                Text="{Binding CheckBoxDescription}"
                                VerticalOptions="CenterAndExpand">

                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsInstuctionsChecked}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsInstuctionsChecked}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </StackLayout>

                        <buttons:SfButton
                            Grid.Row="2"
                            Margin="0,24"
                            Background="{Binding ContinueBackGroundColor}"
                            Command="{Binding InstructionsContinueClick}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ButtonTitle}"
                            VerticalOptions="End" />

                    </Grid>
                </ScrollView>



            </Grid>
        </Border>

        <Border
            Padding="15,0"
            BackgroundColor="White"
            IsVisible="{Binding IsTerms}"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="End">
            <Grid RowDefinitions="auto,*,*">

                <Label
                    Grid.Row="0"
                    Margin="0,32,0,0"
                    FontSize="15"
                    HorizontalOptions="Center"
                    Style="{StaticResource ValueLabelBlackBold}"
                    Text="{x:Static ResourceManager:AppResources.BPTermsAndConditions}" />

                <ScrollView Grid.Row="1"
                            Orientation="Vertical"
                            VerticalScrollBarVisibility="Never">

                    <Grid
                        Margin="0,32,0,0"
                        Padding="5,0"
                        RowDefinitions="auto,auto"
                        RowSpacing="10">

                        <Border
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <Grid
                                Margin="8"
                                ColumnDefinitions="auto,*"
                                RowDefinitions="auto,auto">


                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0 "
                                    IsVisible="False">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>

                                </Image>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Description}" />

                            </Grid>
                        </Border>

                        <StackLayout
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="10">

                            <custom:CheckboxCustom
                                CheckChanged="CheckBox_CheckedChanged"
                                IsChecked="{Binding IsTermsChecked}"
                                IsEnabled="{Binding IsCheckboxEditable}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />

                            <Label
                                HorizontalOptions="StartAndExpand"
                                LineHeight="0.8"
                                Text="{Binding CheckBoxDescription}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsTermsChecked}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsTermsChecked}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </StackLayout>

                    </Grid>

                </ScrollView>

                <buttons:SfButton
                    Grid.Row="2"
                    Margin="0,24"
                    Background="{Binding ContinueBackGroundColor}"
                    Command="{Binding TermsContinueClick}"
                    IsEnabled="{Binding IsContinueEnabled}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding ButtonTitle}"
                    VerticalOptions="End" />

            </Grid>
        </Border>

    </Grid>

</Mopups:PopupPage>