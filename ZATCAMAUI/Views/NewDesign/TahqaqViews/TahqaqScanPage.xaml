<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TahqaqViews.TahqaqScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:SupportTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <Border
                Grid.Row="1"
                Margin="0"
                Padding="0"
                IsVisible="{Binding IsShowScanView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid Padding="0,0,0,0" RowDefinitions="auto,auto,*,auto,auto">
                    <Grid
                        x:Name="MainGrid"
                        Grid.RowSpan="5"
                        Margin="0,0,0,0" />
                    <zxing:CameraBarcodeReaderView
                        x:Name="zxing"
                        Grid.RowSpan="5"
                        Margin="0,0,0,0"
                        BackgroundColor="White"
                        BarcodesDetected="zxing_BarcodesDetected" />

                    <Grid Grid.Row="0" HorizontalOptions="FillAndExpand">

                        <Border BackgroundColor="Black" Opacity=".44" />

                        <StackLayout Margin="0,60,0,50">

                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.ScantheQRcode}"
                                TextColor="White" />
                        </StackLayout>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        Margin="2,0,2,-7"
                        FlowDirection="RightToLeft">
                        <Path
                            Margin="-3,-7,-3,0"
                            Data="M 0,0 L 36,0 36,36Z"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="-90"
                            Stroke="transparent"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-5,-15,-5,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Rotation="-90"
                            Source="Path"
                            VerticalOptions="Start" />
                        <Path
                            Margin="-7,-6,-14,0"
                            Data="M 0,0 L 30,0 30,30Z"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-3,-15,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="-180"
                            Source="Path"
                            VerticalOptions="Start" />

                        <Path
                            Margin="-3,0,-3,-.2"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            Rotation="90"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Source="Path"
                            VerticalOptions="End" />
                        <Path
                            Margin="-3,0,-3,0"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="180"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="90"
                            Source="Path"
                            VerticalOptions="End" />

                    </Grid>

                    <Grid Grid.Row="4" HorizontalOptions="FillAndExpand">
                        <Border BackgroundColor="Black" Opacity=".44" />
                        <StackLayout>
                            <Label
                                Grid.Row="3"
                                Margin="0,40,27,0"
                                HorizontalOptions="CenterAndExpand"
                                TextColor="White">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            FontFamily="{StaticResource FontSomarBold}"
                                            FontSize="24"
                                            Text="{x:Static ResourceManager:AppResources.Or}" />
                                        <Span FontSize="16" Text="{x:Static ResourceManager:AppResources.Use}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border
                                Grid.Row="4"
                                Margin="21,27,27,40"
                                Padding="12"
                                BackgroundColor="#00BBBD"
                                StrokeShape="RoundRectangle 14,14,14,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EnterCodeCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.VerificationForm}"
                                    TextColor="White" />
                            </Border>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="15,0"
                IsVisible="{Binding IsCheckWithCode}"
                Style="{StaticResource CommonTopCurves}">
                <Grid RowDefinitions="*">

                    <ScrollView IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}" VerticalScrollBarVisibility="Never">

                        <StackLayout Spacing="10">

                            <StackLayout
                                x:Name="Main"
                                Margin="0"
                                IsVisible="{Binding IsMainPage}">

                                <Label
                                    Margin="0,34,0,5"
                                    FontSize="26"
                                    Text="{x:Static ResourceManager:AppResources.VerificationForm}"
                                    TextColor="#58595B" />

                                <Label
                                    FontSize="14"
                                    IsVisible="False"
                                    Text="{x:Static ResourceManager:AppResources.VerificationFormHint}"
                                    TextColor="#868894" />

                                <BoxView HeightRequest="1" Color="#EBEBEB" />
                            </StackLayout>

                            <StackLayout Margin="0,0,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <Label Style="{StaticResource CaptionLabelGrey}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.QRCode}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <inputLayout:SfTextInputLayout
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    Hint="{x:Static ResourceManager:AppResources.EnterQrCodeHere}"
                                    InputViewPadding="16,0,16,0"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="14">
                                    <custom:GAZTBorderlessEntry
                                        Placeholder="{x:Static ResourceManager:AppResources.EnterQrCodeHere}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding scanCode}"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <Border
                                Margin="0,50"
                                Padding="12"
                                BackgroundColor="#00BBBD"
                                StrokeShape="RoundRectangle 14,14,14,14"
                                VerticalOptions="EndAndExpand">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GetDataForCodeCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Send}"
                                    TextColor="White" />
                            </Border>
                        </StackLayout>
                    </ScrollView>

                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="20,20,20,0"
                IsVisible="{Binding IsShowRsltView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <Image
                                Margin="0,10,0,10"
                                HeightRequest="70"
                                HorizontalOptions="CenterAndExpand"
                                Source="SuccessQr"
                                WidthRequest="70" />
                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Correcttaxstamp}"
                                TextColor="{StaticResource PrimaryColor}" />
                            <Border
                                Margin="0"
                                Padding="0"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8">
                                <StackLayout Margin="16">
                                    <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.QRCode}" />
                                    <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding scanCode}" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ProductDescription}" />
                                    <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding QrRslt.ProductDescription}" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.OrganisationName}" />
                                    <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding QrRslt.OrganisationName}" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="auto,auto">
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.CountryofOrigin}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding QrRslt.CountryOfManufacture}" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ProductionDate}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding QrRslt.DateOfManufacture, StringFormat='{0:dd/MM/yyy}'}" />
                                    </Grid>
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </ScrollView>




                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="20,20,20,0"
                IsVisible="{Binding IsShowFailRsltView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <Image
                                Margin="0,50,0,15"
                                HeightRequest="95"
                                HorizontalOptions="CenterAndExpand"
                                Source="FailedIcon"
                                WidthRequest="95" />
                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Incorrecttaxstamp}"
                                TextColor="{StaticResource PrimaryColor}" />
                            <Border
                                Margin="21,50,27,27"
                                Padding="12"
                                BackgroundColor="#00BBBD"
                                StrokeShape="RoundRectangle 14,14,14,14">
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Submitareport}"
                                    TextColor="White" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenReportsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Label
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Exit}"
                                TextColor="#00BBBD">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                        </StackLayout>
                    </ScrollView>




                </Grid>
            </Border>


            <Grid
                Grid.Row="0"
                Padding="15,10"
                ColumnDefinitions="10*,80*,10*">

                <StackLayout Grid.Column="0">
                    <Image
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.TahqaqService}"
                    VerticalOptions="Center" />
            </Grid>

            <custom:Loader
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="{Binding IsLoading}" />

            <custom:MsgView
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="{Binding IsShowMsgView}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
