<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.LiveVideo.LiveVideoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    ios:Page.UseSafeArea="True"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">



    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
    <ContentPage.Content>

        <Grid Padding="0" RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,5,20,5" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        IsVisible="{Binding IsShowBottomSheet}"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>


                <!--  Live video Label  -->
                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding HeaderTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="0"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="FillAndExpand">

                <Grid RowDefinitions="*" >

                    <ScrollView VerticalScrollBarVisibility="Never"
                            VerticalOptions="FillAndExpand"
                            Margin="0,0,0,100">

                         <StackLayout Padding="10,0" Spacing="20">

                            <!--  Live Video Sub Title Label  -->
                            <Label
                                Margin="0,10,0,0"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="20"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.LiveVideoSubTitle}"
                                TextColor="#58595B" />

                            <!--  Port Field  -->
                            <StackLayout Spacing="0">

                                <!--  Port Label  -->
                                <Label Style="{StaticResource CaptionLabelGrey}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.PortName}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!--  Port Entry  -->
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            InputTransparent="True"
                                            IsReadOnly="True"
                                            Keyboard="Text"
                                            Placeholder="{x:Static ResourceManager:AppResources.SelectPortFirst}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding SelectedPortName}"
                                            TextColor="#58595B">
                                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenPortCommand}" />
                                            </custom:GAZTBorderlessEntry.GestureRecognizers>
                                        </custom:GAZTBorderlessEntry>


                                    </custom:CustomSfTextInputView.TextInputView>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image Aspect="AspectFit" Source="greyDropDown" />
                                    </inputLayout:SfTextInputLayout.TrailingView>

                                     <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenPortCommand}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>

                                </custom:CustomSfTextInputView>
                            

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenPortCommand}" />
                                </StackLayout.GestureRecognizers>

                            </StackLayout>


                            <!--  Video URL  -->
                            <Border
                                Padding="0"
                                HeightRequest="250"
                                IsVisible="{Binding ShowWebView}"
                                Stroke="#EBEBEB"
                                StrokeShape="RoundRectangle 20,20,20,20"
                                WidthRequest="{OnPlatform iOS=370,Android=335}">
                                <WebView Source="{Binding VideoUrl}" />
                            </Border>

                            <!--  Live Video Sub Title Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="18"
                                HorizontalOptions="CenterAndExpand"
                                Text="{Binding SelectedVideo}"
                                TextColor="#58595B"
                                VerticalOptions="Center" />

                            <StackLayout HorizontalOptions="FillAndExpand"
                                         VerticalOptions="FillAndExpand">

                                <Grid
                                    x:Name="videosList"
                                    BindableLayout.ItemsSource="{Binding LiveVideosList}"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="30"
                                    RowDefinitions="150,150"
                                    RowSpacing="30">


                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                x:Name="Item"
                                                Grid.Row="{Binding Row}"
                                                Grid.Column="{Binding Column}"
                                                Padding="0"
                                                Stroke="#EBEBEB"
                                                StrokeShape="RoundRectangle 20">

                                                <Grid Padding="0" RowDefinitions="*,20">

                                                    <!--  Live video Label  -->
                                                    <Label
                                                        Margin="5,0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        FontSize="14"
                                                        HorizontalOptions="CenterAndExpand"
                                                        HorizontalTextAlignment="Center"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding VideoName}"
                                                        TextColor="#58595B"
                                                        VerticalOptions="CenterAndExpand" />

                                                    <!--  Bottom bold frame  -->
                                                    <Border
                                                        Grid.Row="1"
                                                        BackgroundColor="#0996D4"
                                                        StrokeShape="RoundRectangle 0,0,15,15"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsVisible="{Binding IsSelected}"
                                                        Style="{StaticResource CommonTopCurves}"
                                                        VerticalOptions="EndAndExpand" />

                                                </Grid>

                                                <Border.GestureRecognizers>

                                                    <TapGestureRecognizer
                                                        BindingContext="{Binding Source={x:Reference videosList}, Path=BindingContext}"
                                                        Command="{Binding SelectedVideoItemCommand}"
                                                        CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />

                                                </Border.GestureRecognizers>

                                            </Border>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </Grid>

                             </StackLayout>

                         </StackLayout>

                    </ScrollView>

                </Grid>
                
               

            </Border>

            <!--  Bottom Sheet List  -->
            <custom:ListBottomSheet Grid.Row="1" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <custom:BottomMenu Grid.Row="2" VerticalOptions="EndAndExpand" />

        </Grid>

    </ContentPage.Content>
</ContentPage>
