<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ForgotPasswordPages.GAZTNewDesignRecoverUsernamePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundImageSource="partials_background"
    mc:Ignorable="d">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->
    <ContentPage.Content>
        <StackLayout Padding="20">
            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                <Image Margin="0,0,0,20" Source="forget_ic_success"/>
                <custom:CustomLabel
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{x:Static ResourceManager:AppResources.RecoverUserName}"
                    TextColor="White" />
                <custom:CustomLabel
                    HorizontalOptions="FillAndExpand"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BodyLabelBlack}"
                    StyleId="OnBoardText"
                    Text="{x:Static ResourceManager:AppResources.NDUsernameSenttoMobile}"
                    TextColor="White" />
            </StackLayout>
            <StackLayout Spacing="10" VerticalOptions="EndAndExpand">
                <buttons:SfButton
                    Command="{Binding OnLoginButtonClicked}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.LogIn}" />
                <!--<buttons:SfButton Text="{x:Static ResourceManager:AppResources.CheckEmail}" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="Transparent"/>-->
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>