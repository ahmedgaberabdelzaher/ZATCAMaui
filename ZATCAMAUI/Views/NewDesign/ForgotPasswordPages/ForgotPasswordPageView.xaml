<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ForgotPasswordPages.GAZTNewDesignForgotPasswordPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.co/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <cards:SfCardView
            BackgroundColor="Transparent"
            CornerRadius="15">
            <yummy:PancakeView
                Padding="0,0,0,50"
                BackgroundColor="White"
                CornerRadius="15,15,0,0">
                <Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <ScrollView
                            Grid.Row="1"
                            Margin="15,20,15,10"
                            Padding="5,0,5,0"
                            VerticalScrollBarVisibility="Never">
                            <StackLayout Orientation="Vertical">
                                <!--  Start Forgot Password View  -->
                                <StackLayout>

                                    <custom:CustomLabel
                                        IsVisible="{Binding ForgotPwHeadingVisibility}"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ForgotPasswordORUseName}" />
                                    <custom:CustomLabel
                                        IsVisible="{Binding ForgotPwHeadingVisibility}"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.NDSelectTheOptionAndCompleteDetails}" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralLightGrey}"
                                        HeightRequest="1"
                                        IsVisible="{Binding ForgotPwHeadingVisibility}" />
                                    <Grid
                                        Padding="0,20,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        IsVisible="{Binding DefaultCardLayoutVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            VerticalOptions="StartAndExpand">
                                            <cards:SfCardView
                                                BackgroundColor="Transparent"
                                                CornerRadius="20">
                                                <Image Source="{Binding UserNameCardBackgroundImg}" />
                                            </cards:SfCardView>

                                            <StackLayout Padding="16,0,0,16" VerticalOptions="EndAndExpand">
                                                <Image HorizontalOptions="Start" Source="{Binding UserIcon}" />
                                                <custom:CustomLabel
                                                    Style="{StaticResource ValueLabelBlackMedium}"
                                                    Text="{x:Static ResourceManager:AppResources.NDUsername}"
                                                    TextColor="{Binding UserNameTextColor}" />
                                            </StackLayout>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnUserNameCardClicked" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <Grid Grid.Column="1" HorizontalOptions="StartAndExpand">
                                            <cards:SfCardView
                                                BackgroundColor="Transparent"
                                                CornerRadius="20">
                                                <Image Source="{Binding PasswordCardBackgroundImg}" />
                                            </cards:SfCardView>

                                            <StackLayout Padding="16,0,0,16" VerticalOptions="EndAndExpand">
                                                <Image HorizontalOptions="Start" Source="{Binding PasswordIcon}" />
                                                <custom:CustomLabel
                                                    Style="{StaticResource ValueLabelBlackMedium}"
                                                    Text="{x:Static ResourceManager:AppResources.Password}"
                                                    TextColor="{Binding PasswordTextColor}" />
                                            </StackLayout>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPasswordCardClicked" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                    </Grid>



                                    <!--  Starts Entry Fields  -->

                                    <StackLayout x:Name="ForgotUserName" IsVisible="{Binding ForgotUserNameCardLayoutVisibility}">
                                        <custom:CustomLabel
                                            Padding="0,0,0,0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.IDType}" />

                                        <Grid Padding="0,20,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand">


                                                <cards:SfCardView
                                                    BackgroundColor="Transparent"
                                                    CornerRadius="20"
                                                    HeightRequest="104"
                                                    WidthRequest="171">
                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="104" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Aspect="Fill"
                                                            HorizontalOptions="FillAndExpand"
                                                            Source="{Binding CorporateCardBackgroundImg}"
                                                            VerticalOptions="FillAndExpand" />
                                                        <StackLayout VerticalOptions="EndAndExpand">

                                                            <Label
                                                                Padding="16,0,16,16"
                                                                Style="{StaticResource ValueLabelBlackMedium}"
                                                                Text="{x:Static ResourceManager:AppResources.Company}"
                                                                TextColor="{Binding CorporateTextColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </cards:SfCardView>



                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnCorporateCardClicked}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="StartAndExpand">

                                                <cards:SfCardView
                                                    BackgroundColor="Transparent"
                                                    CornerRadius="20"
                                                    HeightRequest="104"
                                                    WidthRequest="171">
                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="104" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Aspect="Fill"
                                                            HorizontalOptions="FillAndExpand"
                                                            Source="{Binding IndividualOrPersonalBusinessCardBackgroundImg}"
                                                            VerticalOptions="FillAndExpand" />
                                                        <StackLayout VerticalOptions="EndAndExpand">

                                                            <Label
                                                                Padding="16,0,16,16"
                                                                Style="{StaticResource ValueLabelBlackMedium}"
                                                                Text="{x:Static ResourceManager:AppResources.Individual}"
                                                                TextColor="{Binding IndividualOrPersonalBusinessTextColor}"
                                                                WidthRequest="{OnIdiom Tablet=120,
                                                                                       Default=120}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </cards:SfCardView>

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnIndividualOrPersonalBusinessCardClicked}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </Grid>
                                    </StackLayout>


                                    <StackLayout
                                        x:Name="ForgotPasswordEntryFields"
                                        Padding="0,10,0,0"
                                        Spacing="20">
                                        <StackLayout IsVisible="{Binding UserIDLayoutVisibility}">
                                            <custom:CustomLabel
                                                Padding="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <inputLayout:SfTextInputLayout
                                                Margin="0,-6,0,-6"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                InputViewPadding="16,0,16,0"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="IDNumberForForGotUserNmae"
                                                    IsEnabled="{Binding SetIDNumberEnability}"
                                                    Keyboard="Numeric"
                                                    Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding IDNumber}"
                                                    TextChanged="OnIdNumberTextChanged">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>

                                        <StackLayout IsVisible="{Binding ForgotPwHeadingVisibility}">
                                            <StackLayout IsVisible="{Binding UserNameLayoutVisibility}">
                                                <custom:CustomLabel
                                                    Padding="0,0,0,0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{Binding UserNameLabelText}" />
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0,-6,0,-6"
                                                    ContainerType="Outlined"
                                                    HasError="False"
                                                    InputViewPadding="16,0,16,0"
                                                    OutlineCornerRadius="8"
                                                    Stroke="{StaticResource Primary}">
                                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="Entry_UserName"
                                                        Placeholder="{Binding UserNameLabelText}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding Email}"
                                                        TextChanged="UserNameTextChanged"
                                                        Unfocused="Entry_UserName_Unfocused">
                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviors:AlphaNumericValidatorBehaviour />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                        </StackLayout>

                                        <Grid IsVisible="{Binding IsTinDopDownVisible}" RowDefinitions="Auto,Auto">
                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <inputLayout:SfTextInputLayout
                                                Grid.Row="1"
                                                Margin="0,-6,0,-6"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                InputViewPadding="16,0,16,0"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}"
                                                Style="{StaticResource TextInputLayout}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <custom:GAZTBorderlessEntry
                                                    IsEnabled="{Binding Enabled}"
                                                    Placeholder="{x:Static ResourceManager:AppResources.TINS}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding TxtTIN}"
                                                    TextColor="#bbbbbb"
                                                    Unfocused="Entry_UserName_Unfocused" />
                                            </inputLayout:SfTextInputLayout>
                                            <Image
                                                Grid.Row="1"
                                                Margin="0,0,15,0"
                                                HorizontalOptions="End"
                                                IsVisible="{Binding IsDropImageVisible}"
                                                Source="arrowDropdown"
                                                Style="{StaticResource SmallIcon}"
                                                VerticalOptions="CenterAndExpand" />
                                            <custom:CustomButton
                                                x:Name="Btn_TinPicker"
                                                Grid.Row="1"
                                                BackgroundColor="Transparent"
                                                Clicked="Btn_TinPicker_Clicked_1"
                                                FontSize="Small"
                                                IsEnabled="{Binding Enabled}" />

                                            <syncfusion:SfPicker
                                                x:Name="Picker_Tins"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                BackgroundColor="White"
                                                FlowDirection="RightToLeft"
                                                ItemHeight="40"
                                                Mode="Dialog"
                                                SelectionChanged="Picker_Tins_SelectionChanged">

                                                <syncfusion:SfPicker.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                </syncfusion:SfPicker.TextStyle>

                                                <syncfusion:SfPicker.SelectedTextStyle>
                                                    <syncfusion:PickerTextStyle
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        TextColor="{StaticResource NeutralBlack}" />
                                                </syncfusion:SfPicker.SelectedTextStyle>

                                                <syncfusion:SfPicker.Columns>
                                                    <syncfusion:PickerColumn
                                                        Width="300"
                                                        DisplayMemberPath="Tin"
                                                        ItemsSource="{Binding TINs}" />
                                                </syncfusion:SfPicker.Columns>

                                                <syncfusion:SfPicker.ColumnHeaderView>
                                                    <syncfusion:PickerColumnHeaderView Height="46" />
                                                </syncfusion:SfPicker.ColumnHeaderView>

                                                <syncfusion:SfPicker.HeaderView>

                                                    <syncfusion:PickerHeaderView Height="55" Background="{StaticResource Primary}">
                                                        <syncfusion:PickerHeaderView.TextStyle>
                                                            <syncfusion:PickerTextStyle
                                                                FontAttributes="Italic"
                                                                FontSize="13"
                                                                TextColor="White" />
                                                        </syncfusion:PickerHeaderView.TextStyle>
                                                    </syncfusion:PickerHeaderView>

                                                </syncfusion:SfPicker.HeaderView>

                                                <syncfusion:SfPicker.FooterView>

                                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                        <syncfusion:PickerFooterView.TextStyle>
                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                        </syncfusion:PickerFooterView.TextStyle>

                                                    </syncfusion:PickerFooterView>

                                                </syncfusion:SfPicker.FooterView>

                                                <syncfusion:SfPicker.Behaviors>
                                                    <behaviors:SfPickerBehavior />
                                                </syncfusion:SfPicker.Behaviors>

                                            </syncfusion:SfPicker>

                                        </Grid>
                                    </StackLayout>



                                    <!--  Ends Entry Fields  -->
                                </StackLayout>
                                <!--  End Forgot Password View  -->

                                <!--  Start of Verification Code  -->
                                <StackLayout Margin="0,5,0,0" IsVisible="{Binding VerificationCodeVisibility}">
                                    <custom:CustomLabel
                                        Padding="0,5,0,0"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VerificationCode}" />
                                    <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}" />
                                    <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />

                                    <StackLayout Padding="0,15,0,0">
                                        <StackLayout HorizontalOptions="CenterAndExpand" Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="Center"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding MobileNumber}" />


                                        </StackLayout>

                                        <StackLayout Padding="0,0,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Grid.Row="0"
                                                    Padding="30,20,30,20"
                                                    ColumnSpacing="24"
                                                    FlowDirection="LeftToRight"
                                                    HeightRequest="48">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>


                                                    <!--  First OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="0"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPFirstEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPFirstDigit}"
                                                            TextChanged="OtpFirstEntry_TextChanged"
                                                            TextColor="#bbbbbb"
                                                            WidthRequest="10">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <!--  First OTP Digit End  -->

                                                    <!--  Second OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="1"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPSecondEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPSecondDigit}"
                                                            TextChanged="OtpSecondEntry_TextChanged"
                                                            TextColor="#bbbbbb"
                                                            WidthRequest="10">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <!--  Second OTP Digit End  -->

                                                    <!--  Third OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="2"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPThirdEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPThirdDigit}"
                                                            TextChanged="OtpThirdEntry_TextChanged"
                                                            TextColor="#bbbbbb"
                                                            WidthRequest="10">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <!--  Third OTP Digit End  -->

                                                    <!--  Fourth OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="3"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPFourthEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPFourthDigit}"
                                                            TextChanged="OtpFourthEntry_TextChanged"
                                                            TextColor="#bbbbbb"
                                                            Unfocused="OtpFourthEntry_Unfocused"
                                                            WidthRequest="10" />
                                                    </inputLayout:SfTextInputLayout>
                                                </Grid>
                                            </Grid>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="Center" Orientation="Horizontal">
                                            <Image Source="clock" />
                                            <custom:CustomLabel
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{Binding LblCountDownTimer}"
                                                VerticalOptions="Center" />
                                        </StackLayout>
                                        <custom:CustomLabel
                                            Margin="0,30,0,0"
                                            FontFamily="{StaticResource SomarBold}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                            TextColor="{Binding ResendOTPTextColor}"
                                            VerticalOptions="EndAndExpand">
                                            <custom:CustomLabel.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnResendOTPClicked}" NumberOfTapsRequired="1" />
                                            </custom:CustomLabel.GestureRecognizers>
                                        </custom:CustomLabel>
                                    </StackLayout>

                                </StackLayout>

                                <!--  End of Verification Code  -->


                                <!--  Start of Password View  -->
                                <StackLayout IsVisible="{Binding PasswordLayoutVisibility}">
                                    <custom:CustomLabel Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.Password}" />
                                    <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.CreateASecurePassword}" />
                                    <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1" />

                                    <StackLayout Padding="0,20,0,0" Spacing="15">
                                        <StackLayout>
                                            <custom:CustomLabel
                                                Padding="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDNewPassword}" />
                                            <inputLayout:SfTextInputLayout
                                                Margin="0,-6,0,-6"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:SfTextInputLayout.TrailingView>

                                                    <Image
                                                        x:Name="NewPasswordIcon"
                                                        HorizontalOptions="Center"
                                                        Source="hidePassword.png"
                                                        VerticalOptions="Center">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNewPasswordTapped" />
                                                        </Image.GestureRecognizers>
                                                    </Image>

                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="NewPassword"
                                                    Grid.Column="0"
                                                    IsPassword="True"
                                                    MaxLength="16"
                                                    Text="{Binding NewPassword}"
                                                    TextChanged="NewPassword_TextChanged">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:PasswordTextBehaviour />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>


                                        <StackLayout>
                                            <custom:CustomLabel
                                                Padding="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" />
                                            <inputLayout:SfTextInputLayout
                                                Margin="0,-6,0,-6"
                                                ContainerType="Outlined"
                                                HasError="False"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="8"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image
                                                        x:Name="ConfirmNewPasswordIcon"
                                                        HorizontalOptions="Center"
                                                        Source="hidePassword.png"
                                                        VerticalOptions="Center">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnConfirmNewPasswordTapped" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </inputLayout:SfTextInputLayout.TrailingView>

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="ConfirmNewPassword"
                                                    Grid.Column="0"
                                                    IsPassword="True"
                                                    MaxLength="16"
                                                    Text="{Binding ConfirmPassword}">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:PasswordTextBehaviour />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>

                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>
                                    </StackLayout>

                                    <StackLayout x:Name="PasswordChecks" Padding="0,15,0,0">
                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding MinEight}" />
                                            <custom:CustomLabel
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.NDAtleast8character}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding CapsSmall}" />
                                            <custom:CustomLabel
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.NDEnglishcapitalandsmallletters}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding MaxSixteen}" />
                                            <custom:CustomLabel
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding NumSymbol}" />
                                            <custom:CustomLabel
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.NDNumbersAndSymbols}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </StackLayout>

                                </StackLayout>
                                <!--  End of Password View  -->



                            </StackLayout>
                        </ScrollView>




                        <StackLayout
                            Grid.Row="2"
                            Margin="20,0,20,0"
                            Padding="0,8,0,0"
                            BackgroundColor="White">
                            <buttons:SfButton
                                x:Name="btnprimary"
                                Margin="0,0,0,10"
                                Command="{Binding OnContinueClick}"
                                IsEnabled="{Binding ContinueButtonEnability}"
                                IsVisible="{Binding IsContinueButtonVisibe}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{Binding ContinueORConfirmButtonText}" />
                        </StackLayout>

                        <Grid
                            Grid.Row="0"
                            Margin="20,0,20,0"
                            BackgroundColor="White"
                            ColumnDefinitions="10*,80*,10*">
                            <Image
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="Center"
                                WidthRequest="34" />

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="Start"
                                Rotation="270"
                                Source="arrowLeft.png"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackTapped" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Image
                                Grid.Column="2"
                                IsVisible="False"
                                Source="close.png" />
                        </Grid>

                        <StackLayout
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            Padding="-20,-20,-20,-10"
                            BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding RecoverUserNameLayout}"
                            VerticalOptions="FillAndExpand">
                            <Grid ColumnDefinitions="100*" RowDefinitions="15*,15*,10*,15*,26*,12*,7*">
                                <Image
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="icon.png"
                                    VerticalOptions="Center" />
                                <custom:CustomLabel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.RecoverUserName}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <custom:CustomLabel
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.UsernameSentToTheRegisteredEmailEndMobileNumber}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <buttons:SfButton
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="5,0,0,0"
                                    Command="{Binding OnLogInClick}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.LogIn}" />

                            </Grid>
                        </StackLayout>


                        <StackLayout
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            Padding="-20,-20,-20,-10"
                            BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding RecoverPasswordLayout}"
                            VerticalOptions="FillAndExpand">
                            <Grid ColumnDefinitions="100*" RowDefinitions="15*,15*,10*,10*,38*,12*">
                                <Image
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="icon.png"
                                    VerticalOptions="Center" />
                                <custom:CustomLabel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.RecoverPassword}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <custom:CustomLabel
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NewPasswordUpdatedSuccessfully}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <buttons:SfButton
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Command="{Binding OnLogInClick}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.LogIn}" />

                            </Grid>
                        </StackLayout>


                    </Grid>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="-20,-20,-20,-10"
                        IsVisible="{Binding IsLoading}">
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="Black"
                            Opacity="0.4"
                            Orientation="Vertical"
                            VerticalOptions="FillAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="15,15"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Opacity="0.8"
                            Orientation="Vertical"
                            VerticalOptions="Center">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <busyindicator:SfBusyIndicator
                                    x:Name="busyindicatorForLanding"
                                    AnimationType="SingleCircle"
                                    HorizontalOptions="CenterAndExpand"
                                    IsRunning="{Binding IsLoading}"
                                    SizeFactor="0.7"
                                    TextColor="{StaticResource Primary}"
                                    TitlePlacement="Bottom"
                                    VerticalOptions="Center" />
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </Grid>

            </yummy:PancakeView>
        </cards:SfCardView>
    </ContentPage.Content>
</ContentPage>