<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ForgotPasswordPages.GAZTNewDesignForgotPasswordPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.co/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Content>
        <cards:SfCardView CornerRadius="15">
            <Border
                Padding="0,0,0,0"
                BackgroundColor="White"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 15,15,0,0">
                <Grid>
                    <Grid RowDefinitions="auto,*,auto">

                        <ScrollView
                            Grid.Row="1"
                            Margin="15,10"
                            VerticalScrollBarVisibility="Never">
                            <StackLayout>

                                <!--  Start Forgot Password View  -->
                                <StackLayout>

                                    <Label
                                        IsVisible="{Binding ForgotPwHeadingVisibility}"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ForgotPasswordORUseName}" />
                                    <Label
                                        IsVisible="{Binding ForgotPwHeadingVisibility}"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.NDSelectTheOptionAndCompleteDetails}" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralLightGrey}"
                                        HeightRequest="1"
                                        IsVisible="{Binding ForgotPwHeadingVisibility}" />
                                    <Grid
                                        Margin="0,20"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding DefaultCardLayoutVisibility}"
                                        RowDefinitions="*">

                                        <Grid HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand">

                                            <cards:SfCardView
                                                BackgroundColor="Transparent"
                                                CornerRadius="20"
                                                HeightRequest="120"
                                                WidthRequest="160">
                                                <Image Aspect="AspectFill" Source="{Binding UserNameCardBackgroundImg}" />
                                            </cards:SfCardView>

                                            <StackLayout Padding="16,0,0,16" VerticalOptions="EndAndExpand">
                                                <Image HorizontalOptions="Start" Source="{Binding UserIcon}" />
                                                <Label
                                                    Style="{StaticResource ValueLabelBlackMedium}"
                                                    Text="{x:Static ResourceManager:AppResources.NDUsername}"
                                                    TextColor="{Binding UserNameTextColor}" />
                                            </StackLayout>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnUserNameCardClicked" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <Grid Grid.Column="1"
                                              HorizontalOptions="StartAndExpand">
                                            <cards:SfCardView
                                                BackgroundColor="Transparent"
                                                CornerRadius="20"
                                                HeightRequest="120"
                                                WidthRequest="160">
                                                <Image Aspect="AspectFill" Source="{Binding PasswordCardBackgroundImg}" />
                                            </cards:SfCardView>

                                            <StackLayout Padding="16,0,0,16" VerticalOptions="EndAndExpand">
                                                <Image HorizontalOptions="Start" Source="{Binding PasswordIcon}" />

                                                <Label
                                                    Style="{StaticResource ValueLabelBlackMedium}"
                                                    Text="{x:Static ResourceManager:AppResources.Password}"
                                                    TextColor="{Binding PasswordTextColor}" />

                                            </StackLayout>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPasswordCardClicked" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                    </Grid>



                                    <!--  Starts Entry Fields  -->
                                    <StackLayout x:Name="ForgotUserName" IsVisible="{Binding ForgotUserNameCardLayoutVisibility}">
                                        <Label
                                            Margin="0,0,0,0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.IDType}" />

                                        <Grid
                                            Margin="0,10,0,0"
                                            ColumnDefinitions="*,*"
                                            RowDefinitions="auto">

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand">


                                                <cards:SfCardView
                                                    BackgroundColor="Transparent"
                                                    CornerRadius="20"
                                                    HeightRequest="120"
                                                    WidthRequest="160">
                                                    <Grid
                                                        ColumnDefinitions="*"
                                                        HorizontalOptions="FillAndExpand"
                                                        RowDefinitions="*"
                                                        VerticalOptions="FillAndExpand">
                                                        <Image
                                                            Aspect="Fill"
                                                            HorizontalOptions="FillAndExpand"
                                                            Source="{Binding CorporateCardBackgroundImg}"
                                                            VerticalOptions="FillAndExpand" />
                                                        <StackLayout VerticalOptions="EndAndExpand">

                                                            <Label
                                                                Padding="16,0,16,16"
                                                                Style="{StaticResource ValueLabelBlackMedium}"
                                                                Text="{x:Static ResourceManager:AppResources.Company}"
                                                                TextColor="{Binding CorporateTextColor}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </cards:SfCardView>



                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnCorporateCardClicked}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>

                                            <Grid Grid.Column="1" HorizontalOptions="StartAndExpand">

                                                <cards:SfCardView
                                                    BackgroundColor="Transparent"
                                                    CornerRadius="20"
                                                    HeightRequest="120"
                                                    WidthRequest="160">
                                                    <Grid
                                                        ColumnDefinitions="*"
                                                        HorizontalOptions="FillAndExpand"
                                                        RowDefinitions="*"
                                                        VerticalOptions="FillAndExpand">
                                                        <Image
                                                            Aspect="Fill"
                                                            HorizontalOptions="FillAndExpand"
                                                            Source="{Binding IndividualOrPersonalBusinessCardBackgroundImg}"
                                                            VerticalOptions="FillAndExpand" />
                                                        <StackLayout VerticalOptions="EndAndExpand">

                                                            <Label
                                                                Padding="16,0,16,16"
                                                                Style="{StaticResource ValueLabelBlackMedium}"
                                                                Text="{x:Static ResourceManager:AppResources.Individual}"
                                                                TextColor="{Binding IndividualOrPersonalBusinessTextColor}"
                                                                WidthRequest="{OnIdiom Tablet=120,
                                                                                       Default=120}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </cards:SfCardView>

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnIndividualOrPersonalBusinessCardClicked}" />
                                                </Grid.GestureRecognizers>

                                            </Grid>
                                        </Grid>
                                    </StackLayout>


                                    <StackLayout
                                        x:Name="ForgotPasswordEntryFields"
                                        Padding="0,10,0,0"
                                        Spacing="20">

                                        <StackLayout IsVisible="{Binding UserIDLayoutVisibility}">
                                            <Label
                                                Padding="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <inputLayout:SfTextInputLayout
                                                ContainerBackground="White"
                                                ContainerType="Outlined"
                                                InputViewPadding="16,0,16,0"
                                                Hint="{x:Static ResourceManager:AppResources.IDNumber}"
                                                OutlineCornerRadius="10"
                                                Stroke="{StaticResource Primary}">
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="IDNumberForForGotUserNmae"
                                                    IsEnabled="{Binding SetIDNumberEnability}"
                                                    Keyboard="Numeric"
                                                    Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding IDNumber}">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>

                                        <StackLayout IsVisible="{Binding ForgotPwHeadingVisibility}">
                                            <StackLayout IsVisible="{Binding UserNameLayoutVisibility}">
                                                <Label
                                                    Padding="0,0,0,0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{Binding UserNameLabelText}" />
                                                <inputLayout:SfTextInputLayout
                                                    ContainerBackground="White"
                                                    ContainerType="Outlined"
                                                    InputViewPadding="16,0,16,0"
                                                    OutlineCornerRadius="10"
                                                    Stroke="{StaticResource Primary}">
                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="Entry_UserName"
                                                        Placeholder="{Binding UserNameLabelText}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding Email}"
                                                        TextChanged="UserNameTextChanged"
                                                        Unfocused="Entry_UserName_Unfocused">
                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviors:AlphaNumericValidatorBehaviour />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                            </StackLayout>
                                        </StackLayout>

                                        <StackLayout IsVisible="{Binding IsTinDopDownVisible}">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <inputLayout:SfTextInputLayout
                                                ContainerBackground="White"
                                                ContainerType="Outlined"
                                                InputViewPadding="16,0,16,0"
                                                IsEnabled="{Binding Enabled}"
                                                Hint="{x:Static ResourceManager:AppResources.TINS}"
                                                OutlineCornerRadius="10"
                                                Stroke="{StaticResource Primary}"
                                                Style="{StaticResource TextInputLayout}">
                                                <custom:GAZTBorderlessEntry
                                                    IsEnabled="{Binding Enabled}"
                                                    Placeholder="{x:Static ResourceManager:AppResources.TINS}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding TxtTIN}"
                                                    TextColor="#bbbbbb"
                                                    Unfocused="Entry_UserName_Unfocused" />
                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image
                                                        Margin="0,0,15,0"
                                                        HorizontalOptions="End"
                                                        IsVisible="{Binding IsDropImageVisible}"
                                                        Source="arrowDropdown"
                                                        Style="{StaticResource SmallIcon}"
                                                        VerticalOptions="CenterAndExpand" />

                                                </inputLayout:SfTextInputLayout.TrailingView>

                                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="Btn_TinPicker_Clicked_1" />

                                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                                            </inputLayout:SfTextInputLayout>

                                            <custom:CustomSfPicker
                                                x:Name="Picker_Tins"
                                                ItemHeight="40"
                                                Mode="Dialog"
                                                SelectionChanged="Picker_Tins_SelectionChanged">

                                                <custom:CustomSfPicker.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                </custom:CustomSfPicker.TextStyle>

                                                <custom:CustomSfPicker.SelectedTextStyle>
                                                    <syncfusion:PickerTextStyle
                                                        FontAttributes="Bold"
                                                        FontSize="15"
                                                        TextColor="{StaticResource NeutralBlack}" />
                                                </custom:CustomSfPicker.SelectedTextStyle>

                                                <custom:CustomSfPicker.Columns>
                                                    <syncfusion:PickerColumn
                                                        Width="300"
                                                        DisplayMemberPath="Tin"
                                                        ItemsSource="{Binding TINs}" />
                                                </custom:CustomSfPicker.Columns>


                                                <custom:CustomSfPicker.SelectionView>
                                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                </custom:CustomSfPicker.SelectionView>

                                                <custom:CustomSfPicker.HeaderView>

                                                    <syncfusion:PickerHeaderView Height="55" Background="{StaticResource Primary}">
                                                        <syncfusion:PickerHeaderView.TextStyle>
                                                            <syncfusion:PickerTextStyle
                                                                FontAttributes="Italic"
                                                                FontSize="13"
                                                                TextColor="White" />
                                                        </syncfusion:PickerHeaderView.TextStyle>
                                                    </syncfusion:PickerHeaderView>

                                                </custom:CustomSfPicker.HeaderView>

                                                <custom:CustomSfPicker.FooterView>

                                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                        <syncfusion:PickerFooterView.TextStyle>
                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                        </syncfusion:PickerFooterView.TextStyle>

                                                    </syncfusion:PickerFooterView>

                                                </custom:CustomSfPicker.FooterView>


                                            </custom:CustomSfPicker>

                                        </StackLayout>
                                    </StackLayout>

                                    <!--  Ends Entry Fields  -->
                                </StackLayout>
                                <!--  End Forgot Password View  -->

                                <!--  Start of Verification Code  -->
                                <StackLayout Margin="0,5,0,0"
                                             IsVisible="{Binding VerificationCodeVisibility}">
                                    <Label
                                        Padding="0,5,0,0"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VerificationCode}" />
                                    <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}" />
                                    <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />

                                    <StackLayout Padding="0,15,0,0">
                                        <StackLayout HorizontalOptions="CenterAndExpand" Orientation="Horizontal">
                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                            <Label
                                                HorizontalOptions="Center"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding MobileNumber}" />


                                        </StackLayout>

                                        <StackLayout Padding="0,0,0,0">
                                            <Grid ColumnDefinitions="*" RowDefinitions="*">
                                                <Grid
                                                    Grid.Row="0"
                                                    Padding="30,0"
                                                    ColumnDefinitions="*,*,*,*"
                                                    ColumnSpacing="24"
                                                    FlowDirection="LeftToRight"
                                                    RowDefinitions="auto">


                                                    <!--  First OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="0"
                                                        ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPFirstEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPFirstDigit}"
                                                            TextChanged="OtpFirstEntry_TextChanged"
                                                            TextColor="#bbbbbb"
                                                            WidthRequest="10">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <!--  First OTP Digit End  -->

                                                    <!--  Second OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="1"
                                                        ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPSecondEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPSecondDigit}"
                                                            TextChanged="OtpSecondEntry_TextChanged"
                                                            TextColor="#bbbbbb"
                                                            WidthRequest="10">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <!--  Second OTP Digit End  -->

                                                    <!--  Third OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="2"
                                                        ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPThirdEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPThirdDigit}"
                                                            TextChanged="OtpThirdEntry_TextChanged"
                                                            TextColor="#bbbbbb"
                                                            WidthRequest="10">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <!--  Third OTP Digit End  -->

                                                    <!--  Fourth OTP Digit Start  -->
                                                    <inputLayout:SfTextInputLayout
                                                        Grid.Column="3"
                                                        ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        Stroke="{StaticResource Primary}">
                                                        <custom:GAZTBorderlessEntry
                                                            x:Name="OTPFourthEntry"
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="Small"
                                                            HorizontalOptions="CenterAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            IsEnabled="{Binding IsOTPEntryEnable}"
                                                            Keyboard="Numeric"
                                                            MaxLength="1"
                                                            ReturnType="Next"
                                                            Text="{Binding OTPFourthDigit}"
                                                            TextColor="#bbbbbb"
                                                            Unfocused="OtpFourthEntry_Unfocused"
                                                            WidthRequest="10" />
                                                    </inputLayout:SfTextInputLayout>
                                                </Grid>
                                            </Grid>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="Center" Orientation="Horizontal">
                                            <Image Source="clock" />
                                            <Label
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{Binding LblCountDownTimer}"
                                                VerticalOptions="Center" />
                                        </StackLayout>
                                        <Label
                                            Margin="0,30,0,0"
                                            FontFamily="{StaticResource SomarBold}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                            TextColor="{Binding ResendOTPTextColor}"
                                            VerticalOptions="EndAndExpand">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnResendOTPClicked}" NumberOfTapsRequired="1" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>

                                </StackLayout>
                                <!--  End of Verification Code  -->

                                <!--  Start of Password View  -->
                                <StackLayout IsVisible="{Binding PasswordLayoutVisibility}">
                                    <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.Password}" />
                                    <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.CreateASecurePassword}" />
                                    <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1" />

                                    <StackLayout Padding="0,20,0,0" Spacing="15">
                                        <StackLayout>
                                            <Label
                                                Padding="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDNewPassword}" />
                                            <inputLayout:SfTextInputLayout
                                                ContainerBackground="White"
                                                ContainerType="Outlined"
                                                Hint="{x:Static ResourceManager:AppResources.NDNewPassword}"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="10"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.TrailingView>

                                                    <Image
                                                        x:Name="NewPasswordIcon"
                                                        HorizontalOptions="Center"
                                                        Source="hidePassword.png"
                                                        VerticalOptions="Center">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNewPasswordTapped" />
                                                        </Image.GestureRecognizers>
                                                    </Image>

                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                <custom:GAZTBorderlessEntry
                                                    x:Name="NewPassword"
                                                    Grid.Column="0"
                                                    IsPassword="True"
                                                    MaxLength="16"
                                                    Text="{Binding NewPassword}"
                                                    TextChanged="NewPassword_TextChanged">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:PasswordTextBehaviour />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>


                                        <StackLayout>
                                            <Label
                                                Padding="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" />
                                            <inputLayout:SfTextInputLayout
                                                ContainerBackground="White"
                                                ContainerType="Outlined"
                                                Hint="{x:Static ResourceManager:AppResources.ZZConfirmpassword}"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="10"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image
                                                        x:Name="ConfirmNewPasswordIcon"
                                                        HorizontalOptions="Center"
                                                        Source="hidePassword.png"
                                                        VerticalOptions="Center">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnConfirmNewPasswordTapped" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </inputLayout:SfTextInputLayout.TrailingView>

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="ConfirmNewPassword"
                                                    Grid.Column="0"
                                                    IsPassword="True"
                                                    MaxLength="16"
                                                    Text="{Binding ConfirmPassword}">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:PasswordTextBehaviour />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>

                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>
                                    </StackLayout>

                                    <StackLayout x:Name="PasswordChecks" Padding="0,15,0,0">
                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding MinEight}" Style="{StaticResource SmallIcon}" />
                                            <Label
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.NDAtleast8character}" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding CapsSmall}" Style="{StaticResource SmallIcon}" />
                                            <Label
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.NDEnglishcapitalandsmallletters}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding MaxSixteen}" Style="{StaticResource SmallIcon}" />
                                            <Label
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <StackLayout Orientation="Horizontal">
                                            <Image Source="{Binding NumSymbol}" Style="{StaticResource SmallIcon}" />
                                            <Label
                                                Padding="5,0,0,0"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.NDNumbersAndSymbols}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </StackLayout>

                                </StackLayout>
                                <!--  End of Password View  -->

                            </StackLayout>

                        </ScrollView>

                        <buttons:SfButton
                            x:Name="btnprimary"
                            Grid.Row="2"
                            Margin="0,30"
                            Command="{Binding OnContinueClick}"
                            IsEnabled="{Binding ContinueButtonEnability}"
                            IsVisible="{Binding IsContinueButtonVisibe}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ContinueORConfirmButtonText}" />

                        <!--  Header  -->
                        <Grid
                            Grid.Row="0"
                            Margin="20,5"
                            BackgroundColor="White"
                            ColumnDefinitions="10*,80*,10*">
                            <Image
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="Center"
                                WidthRequest="34" />

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="Start"
                                Rotation="270"
                                Source="arrowLeft.png"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackTapped" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Image
                                Grid.Column="2"
                                IsVisible="False"
                                Source="close.png" />
                        </Grid>

                        <StackLayout
                            Grid.RowSpan="3"
                            BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding RecoverUserNameLayout}"
                            VerticalOptions="FillAndExpand">
                            <Grid
                                ColumnDefinitions="100*"
                                RowDefinitions="15*,15*,10*,15*,26*,12*,7*"
                                RowSpacing="10"
                                VerticalOptions="CenterAndExpand">
                                <Image
                                    Grid.Row="1"
                                    HorizontalOptions="Center"
                                    Source="InfoIcon.png"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.RecoverUserName}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.UsernameSentToTheRegisteredEmailEndMobileNumber}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <buttons:SfButton
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="5,0,0,0"
                                    Command="{Binding OnLogInClick}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.LogIn}" />

                            </Grid>
                        </StackLayout>

                        <StackLayout
                            Grid.RowSpan="3"
                            BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding RecoverPasswordLayout}"
                            VerticalOptions="FillAndExpand">
                            <Grid
                                ColumnDefinitions="100*"
                                RowDefinitions="15*,15*,10*,10*,38*,12*"
                                RowSpacing="10"
                                VerticalOptions="CenterAndExpand">
                                <Image
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="InfoIcon.png"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.RecoverPassword}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Padding="5,0,0,0"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NewPasswordUpdatedSuccessfully}"
                                    TextColor="White"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <buttons:SfButton
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Command="{Binding OnLogInClick}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.LogIn}" />

                            </Grid>
                        </StackLayout>


                    </Grid>

                    <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

                </Grid>

            </Border>
        </cards:SfCardView>
    </ContentPage.Content>
</ContentPage>