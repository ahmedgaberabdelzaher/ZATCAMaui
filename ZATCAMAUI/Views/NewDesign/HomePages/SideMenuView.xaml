<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.HomePages.SideMenuView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    TitleText="{x:Static ResourceManager:AppResources.NDVATServices}">

    <Grid RowDefinitions="auto,100*,*">

            <Image
                HeightRequest="110"
                HorizontalOptions="CenterAndExpand"
                Source="ZatcaLogoWithTitle"
                VerticalOptions="StartAndExpand"
                WidthRequest="190" />

            
            <CollectionView x:Name="menu"
                            VerticalScrollBarVisibility="Never"
                            Grid.Row="1"
                            VerticalOptions="FillAndExpand"
                            ItemsSource="{Binding SideMenuServiceLst}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <StackLayout x:Name="Item" Spacing="10">

                            <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        BindingContext="{Binding Source={x:Reference menu}, Path=BindingContext}"
                                        Command="{Binding SideMenuNavigationCommand}"
                                        CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                            </StackLayout.GestureRecognizers>

                            <StackLayout
                                Padding="20,15,20,15"
                                HorizontalOptions="StartAndExpand"
                                Orientation="Horizontal"
                                Spacing="15">

                                <Image
                                    HeightRequest="30"
                                    HorizontalOptions="StartAndExpand"
                                    Source="{Binding ImageSource}"
                                    Style="{StaticResource SmallIcon}"
                                    WidthRequest="32" />

                                <Label
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource ValueLabelWhiteBold}"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />

                            </StackLayout>

                            <BoxView
                            Margin="15,0,15,0"
                            HeightRequest="1"
                            Style="{StaticResource WhiteLineSeperator}" />

                        </StackLayout>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

         <custom:BottomMenu Grid.Row="2"
                            Margin="0,-10"
                     VerticalOptions="EndAndExpand" />

           

    </Grid>

</newdesign:BaseContentPage>
