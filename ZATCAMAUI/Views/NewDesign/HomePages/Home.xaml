<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.HomePages.Home"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    Padding="0,45,0,0"
    ios:Page.UseSafeArea="False"
    FlowDirection="{Binding AppDirection}"
    HasBackButton="False"
    TitleText="{x:Static ResourceManager:AppResources.Home}">

    <newdesign:BaseContentPage.PancakeView>

        <Grid RowDefinitions="auto,*,*">

            <Label
                Padding="10"
                FontFamily="{StaticResource SomarBold}"
                FontSize="18"
                Text="{x:Static ResourceManager:AppResources.ZATCAServices}"
                TextColor="{StaticResource Primary}" />

            <StackLayout
                x:Name="HomeMenuLst"
                Grid.Row="1"
                Padding="10"
                BindableLayout.ItemsSource="{Binding MenuLst}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            x:Name="Item"
                            Margin="0,15,0,0"
                            Padding="22"
                            BorderColor="#DDDDDD"
                            CornerRadius="15">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    BindingContext="{Binding Source={x:Reference HomeMenuLst}, Path=BindingContext}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />

                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="30,*">
                                <Image
                                    Grid.Column="0"
                                    HeightRequest="20"
                                    Source="{Binding ImageSource}" />
                                <Label
                                    Grid.Column="1"
                                    Margin="20,0,20,0"
                                    Text="{Binding Name}"
                                    VerticalOptions="CenterAndExpand" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

            <controls:BottomMenu
                x:Name="preLoginMenu"
                Grid.Row="2"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="EndAndExpand" />

            <controls:NavMenu
                x:Name="beforeLoginMenu"
                Grid.Row="2"
                HorizontalOptions="Fill"
                IsVisible="false"
                VerticalOptions="EndAndExpand" />

        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>
