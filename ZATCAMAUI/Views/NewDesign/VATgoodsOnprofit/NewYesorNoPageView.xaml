<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATgoodsOnprofit.NewYesorNoPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="backButton_Tapped" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoods}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->
            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView Padding="20" VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="30">

                        <Grid RowDefinitions="auto,auto">
                            <Label Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQ1}" />

                            <buttons:SfRadioGroup
                                x:Name="RadioQ1"
                                Grid.Row="1"
                                Orientation="Horizontal">

                                <buttons:SfRadioButton
                                    x:Name="YesQ1"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsYesQ1Checked}"
                                    StateChanged="YesQ1_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsYes}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq1}" />

                                <buttons:SfRadioButton
                                    x:Name="NoQ1"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsNoQ1Checked}"
                                    StateChanged="YesQ1_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsNo}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq1}" />

                            </buttons:SfRadioGroup>

                        </Grid>

                        <Grid IsVisible="{Binding basedonQ1}" RowDefinitions="auto,auto">

                            <Label
                                LineBreakMode="WordWrap"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQ2}" />

                            <buttons:SfRadioGroup
                                x:Name="Radio1"
                                Grid.Row="1"
                                Orientation="Horizontal">

                                <buttons:SfRadioButton
                                    x:Name="Yes"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsYesQ2Checked}"
                                    StateChanged="Yes_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsYes}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq2}" />

                                <buttons:SfRadioButton
                                    x:Name="No"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsNoQ2Checked}"
                                    StateChanged="Yes_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsNo}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq2}" />

                            </buttons:SfRadioGroup>

                        </Grid>

                        <buttons:SfButton
                            x:Name="btnSubmit"
                            Clicked="OnSubmitButtonClicked"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZprofitsOnGoodsSubmit}" />

                        <buttons:SfButton
                            x:Name="btnCancel"
                            Clicked="OnCancelButtonClicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZprofitsOnGoodscancel}" />

                    </StackLayout>

                </ScrollView>

            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>

