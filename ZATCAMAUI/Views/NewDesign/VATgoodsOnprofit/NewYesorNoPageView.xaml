<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATgoodsOnprofit.NewYesorNoPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:SFconverters="clr-namespace:ZATCAMAUI.Core.Converters.SyncFusionEnabledConverters"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <SFconverters:StringToColorConvertor x:Key="StringToColorConvertor" />
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->

                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel
                            Grid.Row="0"
                            Grid.Column="1"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="Large"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ZProfitOnGoods}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="backButton_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <StackLayout
                    Grid.Row="0"
                    Padding="24,10,24,10"
                    Orientation="Horizontal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="1"
                            Style="{StaticResource ValueLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQ1}" />
                        <Grid Grid.Row="1" HeightRequest="100">
                            <buttons:SfRadioGroup x:Name="RadioQ1" Orientation="Horizontal">
                                <buttons:SfRadioButton
                                    x:Name="YesQ1"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsYesQ1Checked}"
                                    StateChanged="YesQ1_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsYes}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq1}" />
                                <buttons:SfRadioButton
                                    x:Name="NoQ1"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsNoQ1Checked}"
                                    StateChanged="YesQ1_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsNo}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq1}" />
                            </buttons:SfRadioGroup>
                        </Grid>
                    </Grid>
                </StackLayout>

                <StackLayout
                    Grid.Row="1"
                    Padding="24,10,24,10"
                    IsVisible="{Binding basedonQ1}"
                    Orientation="Horizontal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="1"
                            Style="{StaticResource ValueLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQ2}" />
                        <Grid Grid.Row="1" HeightRequest="100">

                            <buttons:SfRadioGroup x:Name="Radio1" Orientation="Horizontal">
                                <buttons:SfRadioButton
                                    x:Name="Yes"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsYesQ2Checked}"
                                    StateChanged="Yes_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsYes}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq2}" />
                                <buttons:SfRadioButton
                                    x:Name="No"
                                    CheckedColor="{StaticResource SecondaryNew}"
                                    HorizontalOptions="StartAndExpand"
                                    IsChecked="{Binding IsNoQ2Checked}"
                                    StateChanged="Yes_StateChanged"
                                    Text="{x:Static ResourceManager:AppResources.ZProfitOnGoodsQOptionsNo}"
                                    TextColor="{StaticResource Primary}"
                                    UncheckedColor="{Binding rq2}" />
                            </buttons:SfRadioGroup>

                        </Grid>
                    </Grid>
                </StackLayout>

            </Grid>

            <Grid
                Grid.Row="2"
                Grid.Column="0"
                Padding="24,10,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <buttons:SfButton
                    x:Name="btnSubmit"
                    Grid.Row="0"
                    Clicked="OnSubmitButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZprofitsOnGoodsSubmit}"
                    VerticalOptions="FillAndExpand" />
                <buttons:SfButton
                    x:Name="btnCancel"
                    Grid.Row="1"
                    Clicked="OnCancelButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZprofitsOnGoodscancel}"
                    VerticalOptions="FillAndExpand" />
            </Grid>


            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>

