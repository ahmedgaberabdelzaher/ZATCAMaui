<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatForm5.ZakatForm5PageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <converters:ZakatForm5TabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <Style x:Key="BackgroundWhiteBtn" TargetType="buttons:SfButton">
                <Setter Property="Background" Value="White" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{StaticResource NeutralLightGrey}" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="SelectionMode" Value="None" />
            </Style>
            <Style TargetType="Image">
                <Setter Property="Margin" Value="0,5,0,0" />

            </Style>
            <Style x:Name="SelectedBtn" TargetType="buttons:SfButton">
                <Setter Property="Background" Value="AliceBlue" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="Stroke" Value="AliceBlue" />
            </Style>
            <Style x:Key="circleFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}" />
                <Setter Property="CornerRadius" Value="{OnPlatform Android=50, iOS=22}" />
                <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="HeightRequest" Value="25" />
                <Setter Property="WidthRequest" Value="25" />
                <Setter Property="HasShadow" Value="False" />

            </Style>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>


        <yummy:PancakeView
            Grid.Row="0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>


                <!--  Start Of Basic Information View  -->
                <Grid
                    x:Name="BasicInformation"
                    Grid.Row="1"
                    Padding="20,0,20,0"
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:ZakatForm5TabEnum.BasicInformation}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                        <StackLayout>
                            <!--  Start of Return Details  -->
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>

                                    <StackLayout Padding="10" Orientation="Horizontal">
                                        <Image Margin="0" Source="return_vatRefunds.png" />
                                        <!--<Frame Style="{StaticResource circleFrame}">

                                        </Frame>-->
                                        <custom:CustomLabel
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout Padding="10" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Return}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5ZakatEstimation}" />
                                        </StackLayout>
                                        <!--  FORM5ZakatEstimation  -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*" />
                                                <ColumnDefinition Width="60*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDFinancialYear}" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding FinancialYear}" />
                                        </Grid>
                                        <StackLayout>
                                            <custom:CustomLabel
                                                x:Name="PeriodLbl"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5Period}" />
                                            <!--<custom:CustomLabel Style="{StaticResource ValueLabelBlack}" FlowDirection="LeftToRight">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding ZakatFromDate}" />
                                                        <Span Text=" - "/>
                                                        <Span Text="{Binding ZakatToDate}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                                <custom:CustomLabel.Triggers>
                                                    <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding Source={x:Reference PeriodLbl}, Path=Text}" Value="Period">
                                                        <Setter Property="HorizontalOptions" Value="EndAndExpand"/>
                                                        <Setter Property="HorizontalTextAlignment" Value="End"/>
                                                    </DataTrigger>
                                                </custom:CustomLabel.Triggers>
                                            </custom:CustomLabel>-->

                                            <!--<custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding Period}" FlowDirection="LeftToRight" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"></custom:CustomLabel>-->


                                            <StackLayout Orientation="Horizontal">
                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5From}" />
                                                <!--<custom:CustomLabel Text=" " Style="{StaticResource ValueLabelBlack}"/>-->
                                                <!--<custom:CustomLabel Text="{Binding Taxpayer}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>-->
                                                <custom:CustomLabel
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding ZakatFromDate}" />
                                            </StackLayout>




                                            <StackLayout Orientation="Horizontal">
                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5To}" />
                                                <custom:CustomLabel
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding ZakatToDate}" />
                                            </StackLayout>


                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </Border>

                            <!--  End of Return Details  -->
                            <!--  Start of Taxpayer Details  -->
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout Padding="10" Orientation="Horizontal">
                                        <Image Margin="0" Source="vat_user" />
                                        <!--<Frame Style="{StaticResource circleFrame}">

                                        </Frame>-->
                                        <custom:CustomLabel
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.FORM5TaxpayerDetails}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout Padding="10" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Taxpayer}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding Taxpayer}" />
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Branch}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding Branch}" />
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel
                                                x:Name="addressLbL"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZVatAddress}"
                                                WidthRequest="140" />
                                            <custom:CustomLabel
                                                FlowDirection="LeftToRight"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding Address}">
                                                <custom:CustomLabel.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference addressLbL}, Path=Text}"
                                                        TargetType="custom:CustomLabel"
                                                        Value="Address">
                                                        <Setter Property="HorizontalOptions" Value="EndAndExpand" />
                                                        <Setter Property="HorizontalTextAlignment" Value="End" />
                                                    </DataTrigger>
                                                </custom:CustomLabel.Triggers>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDEmail}"
                                                WidthRequest="100" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding UserEmail}" />
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding MobileNumber}" />
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                            <!--  End of Taxpayer Details  -->
                            <!--  Start of Registration Information  -->
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout Padding="10" Orientation="Horizontal">
                                        <Image Margin="0" Source="ic_vat_bill" />
                                        <!--<Frame Style="{StaticResource circleFrame}">

                                        </Frame>-->
                                        <custom:CustomLabel
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.FORM5RegistrationInfo}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout Padding="10" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NoOutlet}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding NumberOfOutlet}" />
                                        </StackLayout>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5ResidencyStatus}" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding Residency_Status}" />
                                        </Grid>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5MainOutlet}"
                                                WidthRequest="180" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding MainOutlet}" />
                                        </StackLayout>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5AccountingMethod}" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding AccountMethod}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5FinancialPeriodEnd}" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding FinancialPeriod}" />
                                        </Grid>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5CalendarType}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding Calendar_Type}" />
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                            <!--  End of Registration Information  -->
                            <!--   <StackLayout Orientation="Horizontal" Margin="0,0,0,15">
                                <CheckBox IsChecked="{Binding IsConditionRadio}" IsEnabled="False"/>
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5IsCorrect}" StyleId="ValueLabel" Style="{StaticResource ValueLabelGrey}" />
                            </StackLayout>-->


                        </StackLayout>
                    </ScrollView>
                    <StackLayout Grid.Row="0" BackgroundColor="White">
                        <custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.FORM5BasicInformation}" />
                        <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                        <BoxView Margin="0,0,0,10" Style="{StaticResource lineSeperator}" />
                    </StackLayout>
                </Grid>
                <!--  End of Basic Information View  -->

                <!--  Start of Financial Information  -->
                <Grid
                    x:Name="FinancialInformation"
                    Grid.Row="1"
                    Padding="20,0,20,0"
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:ZakatForm5TabEnum.FinancialInformation}}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1">

                        <StackLayout>
                            <!--  On Cabs Clicked Starts  -->
                            <StackLayout x:Name="Cabs" IsVisible="{Binding isCabVisible}">

                                <ListView
                                    x:Name="CarList"
                                    BackgroundColor="White"
                                    HasUnevenRows="True"
                                    HorizontalOptions="FillAndExpand"
                                    ItemsSource="{Binding Cabs}"
                                    SelectionMode="None"
                                    SeparatorVisibility="None"
                                    VerticalOptions="FillAndExpand"
                                    VerticalScrollBarVisibility="Never">
                                    <x:Arguments>
                                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                    </x:Arguments>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <!--  Start of General taxi Office  -->

                                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                    <StackLayout>
                                                        <StackLayout Padding="10" Orientation="Horizontal">
                                                            <Image Margin="0" Source="ic_vat_bill" />
                                                            <!--<Frame Style="{StaticResource circleFrame}">

                                                            </Frame>-->
                                                            <!--   <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5GenTaxiOffice}" Style="{StaticResource SectionTitleBlack}"/> -->
                                                            <custom:CustomLabel
                                                                Style="{StaticResource SectionTitleBlack}"
                                                                Text="{Binding ActDesc}"
                                                                VerticalTextAlignment="Center" />
                                                        </StackLayout>

                                                        <BoxView
                                                            BackgroundColor="LightGray"
                                                            HeightRequest="1"
                                                            HorizontalOptions="FillAndExpand" />

                                                        <StackLayout Padding="10" Spacing="10">

                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5OutletName}" />
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding ActDesc}" />
                                                            </StackLayout>

                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NumOfCars}" />
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding NoOfCars}" />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal" Spacing="5">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5AvgDailyIncome}" />
                                                                <custom:CustomLabel
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    StyleId="ValueLabel"
                                                                    WidthRequest="180">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding AgvDlyIncome}" />
                                                                            <Span Text=" " />
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5OccupancyRate}" />
                                                                <!--<Image Source="ic_vat_info">
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnInfoTapped"/>
                                                                    </Image.GestureRecognizers>
                                                                </Image>-->
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding OccRate, StringFormat='{0:F2} %'}" />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NetProfitPer}" />
                                                                <!--<Image Source="ic_vat_info">
                                                                </Image>-->
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding NetPftPer, StringFormat='{0:F2} %'}" />
                                                            </StackLayout>

                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Revenue}" />
                                                                <!--<custom:CustomLabel Text="{Binding Revenue, StringFormat='{0:F2} SAR'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">-->
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding Revenue}" />
                                                                            <Span Text=" " />
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>

                                                            <Grid RowSpacing="0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackLayout
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    Orientation="Horizontal">
                                                                    <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Expenses}" />
                                                                    <!--<Image Source="ic_vat_info" >

                                                                    </Image>-->
                                                                </StackLayout>

                                                                <custom:CustomLabel
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    StyleId="ValueLabel"
                                                                    Text="{Binding IsApplicable}" />
                                                                <custom:CustomLabel
                                                                    Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    HorizontalTextAlignment="End"
                                                                    IsVisible="{Binding IsApplicableVisible}"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    StyleId="ValueLabel">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding Expenses}" />
                                                                            <Span Text=" " />
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>

                                                            </Grid>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NetProfit}" />
                                                                <!--<Image Source="ic_vat_info">

                                                                </Image>-->
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding NetPft}" />
                                                                            <Span Text=" " />
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </StackLayout>
                                                </Border>
                                                <!--  End of General taxi Office  -->
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>
                            <!--  On Cabs Clicked Ends  -->

                            <!--  On Professionals Clicked starts  -->
                            <StackLayout x:Name="Professionals" IsVisible="{Binding isProfessionalVisible}">

                                <ListView
                                    x:Name="ProfessionalsList"
                                    BackgroundColor="White"
                                    HasUnevenRows="True"
                                    HorizontalOptions="FillAndExpand"
                                    ItemsSource="{Binding Professionals}"
                                    SeparatorVisibility="None"
                                    VerticalOptions="FillAndExpand"
                                    VerticalScrollBarVisibility="Never">
                                    <x:Arguments>
                                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                    </x:Arguments>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <!--  Start Of Land Travel Starts  -->
                                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                    <StackLayout>
                                                        <StackLayout Padding="10" Orientation="Horizontal">
                                                            <Image Margin="0" Source="ic_vat_bill" />
                                                            <!--<Frame Style="{StaticResource circleFrame}">

                                                            </Frame>-->
                                                            <custom:CustomLabel Style="{StaticResource SectionTitleBlack}" Text="{Binding ActDesc}" />
                                                        </StackLayout>

                                                        <BoxView
                                                            BackgroundColor="LightGray"
                                                            HeightRequest="1"
                                                            HorizontalOptions="FillAndExpand" />

                                                        <StackLayout Padding="10" Spacing="10">
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel
                                                                    Style="{StaticResource ValueLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.FORM5OutletName}"
                                                                    WidthRequest="140" />
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    StyleId="ValueLabel"
                                                                    Text="{Binding ActDesc}" />
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Revenue}" />
                                                                <custom:CustomLabel HorizontalOptions="EndAndExpand" Style="{StaticResource ValueLabelBlack}">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding Revenue}" />
                                                                            <Span Text=" " />
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                        </FormattedString>
