<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatForm5.ZakatForm5PageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ZakatForm5TabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <Style x:Key="BackgroundWhiteBtn" TargetType="buttons:SfButton">
                <Setter Property="Background" Value="White" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{StaticResource NeutralLightGrey}" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="SelectionMode" Value="None" />
            </Style>
            <Style TargetType="Image">
                <Setter Property="Margin" Value="0,5,0,0" />

            </Style>
            <Style x:Name="SelectedBtn" TargetType="buttons:SfButton">
                <Setter Property="Background" Value="AliceBlue" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="Stroke" Value="AliceBlue" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>

        <Grid RowDefinitions="auto,*">

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                Padding="15,10,15,10"
                ColumnDefinitions="40,100*,40"
                RowDefinitions="auto,auto">

                <Image
                    Grid.Row="0"
                    Grid.Column="1"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    Source="ic_logo_gazt.png"
                    VerticalOptions="Center"
                    WidthRequest="50" />

                <Image
                    x:Name="Image_backArrow"
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Source="arrowLeft"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClick}" />
                    </Image.GestureRecognizers>
                </Image>


                <IndicatorView
                    Count="{Binding MaxIndex}"
                    HorizontalOptions="End"
                    IndicatorColor="LightGray"
                    IndicatorSize="16"
                    InputTransparent="True"
                    MaximumVisible="{Binding MaxIndex}"
                    Position="{Binding CurrentIndex}"
                    SelectedIndicatorColor="{StaticResource PrimaryColor}"
                    VerticalOptions="CenterAndExpand" />
            </Grid>

            <Border
                Grid.Row="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15,15,0,0">

                <Grid RowDefinitions="auto,*,auto" RowSpacing="0">


                    <!--  Start Of Basic Information View  -->
                    <Grid
                        x:Name="BasicInformation"
                        Grid.Row="1"
                        Padding="20,0,20,0"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:ZakatForm5TabEnum.BasicInformation}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                            <StackLayout>
                                <!--  Start of Return Details  -->
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>

                                        <StackLayout Padding="10" Orientation="Horizontal">
                                            <Image
                                                Margin="0"
                                                Source="return_vatRefunds.png"
                                                Style="{StaticResource SmallIcon}" />
                                            <Label
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />

                                        <StackLayout Padding="10" Spacing="10">
                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Return}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.FORM5ZakatEstimation}" />
                                            </StackLayout>
                                            <!--  FORM5ZakatEstimation  -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40*" />
                                                    <ColumnDefinition Width="60*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.NDFinancialYear}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding FinancialYear}" />
                                            </Grid>
                                            <StackLayout>
                                                <Label
                                                    x:Name="PeriodLbl"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.FORM5Period}" />

                                                <StackLayout Orientation="Horizontal">
                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5From}" />
                                                    <Label
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ZakatFromDate}" />
                                                </StackLayout>




                                                <StackLayout Orientation="Horizontal">
                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5To}" />
                                                    <Label
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ZakatToDate}" />
                                                </StackLayout>


                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </Border>

                                <!--  End of Return Details  -->
                                <!--  Start of Taxpayer Details  -->
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>
                                        <StackLayout Padding="10" Orientation="Horizontal">
                                            <Image
                                                Margin="0"
                                                Source="vat_user"
                                                Style="{StaticResource SmallIcon}" />
                                            <Label
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5TaxpayerDetails}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />

                                        <StackLayout Padding="10" Spacing="10">
                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Taxpayer}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Taxpayer}" />
                                            </StackLayout>
                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Branch}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Branch}" />
                                            </StackLayout>
                                            <StackLayout Orientation="Horizontal">
                                                <Label
                                                    x:Name="addressLbL"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZVatAddress}"
                                                    WidthRequest="140" />
                                                <Label
                                                    FlowDirection="LeftToRight"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    StyleId="ValueLabel"
                                                    Text="{Binding Address}">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding Source={x:Reference addressLbL}, Path=Text}"
                                                            TargetType="Label"
                                                            Value="Address">
                                                            <Setter Property="HorizontalOptions" Value="EndAndExpand" />
                                                            <Setter Property="HorizontalTextAlignment" Value="End" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                            <StackLayout Orientation="Horizontal">
                                                <Label
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.NDEmail}"
                                                    WidthRequest="100" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding UserEmail}" />
                                            </StackLayout>
                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding MobileNumber}" />
                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </Border>
                                <!--  End of Taxpayer Details  -->
                                <!--  Start of Registration Information  -->
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>
                                        <StackLayout Padding="10" Orientation="Horizontal">
                                            <Image
                                                Margin="0"
                                                Source="ic_vat_bill"
                                                Style="{StaticResource SmallIcon}" />
                                            <Label
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5RegistrationInfo}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />

                                        <StackLayout Padding="10" Spacing="10">
                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NoOutlet}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding NumberOfOutlet}" />
                                            </StackLayout>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.FORM5ResidencyStatus}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    StyleId="ValueLabel"
                                                    Text="{Binding Residency_Status}" />
                                            </Grid>
                                            <StackLayout Orientation="Horizontal">
                                                <Label
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.FORM5MainOutlet}"
                                                    WidthRequest="180" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    StyleId="ValueLabel"
                                                    Text="{Binding MainOutlet}" />
                                            </StackLayout>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.FORM5AccountingMethod}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    StyleId="ValueLabel"
                                                    Text="{Binding AccountMethod}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.FORM5FinancialPeriodEnd}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding FinancialPeriod}" />
                                            </Grid>
                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5CalendarType}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Calendar_Type}" />
                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </Border>
                                <!--  End of Registration Information  -->
                                <!--   <StackLayout Orientation="Horizontal" Margin="0,0,0,15">
                                    <CheckBox IsChecked="{Binding IsConditionRadio}" IsEnabled="False"/>
                                    <Label Text="{x:Static ResourceManager:AppResources.FORM5IsCorrect}" StyleId="ValueLabel" Style="{StaticResource ValueLabelGrey}" />
                                </StackLayout>-->


                            </StackLayout>
                        </ScrollView>
                        <StackLayout Grid.Row="0" BackgroundColor="White">
                            <Label Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.FORM5BasicInformation}" />
                            <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                            <BoxView Margin="0,0,0,10" Style="{StaticResource lineSeperator}" />
                        </StackLayout>
                    </Grid>
                    <!--  End of Basic Information View  -->

                    <!--  Start of Financial Information  -->
                    <Grid
                        x:Name="FinancialInformation"
                        Grid.Row="1"
                        Padding="20,0,20,0"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:ZakatForm5TabEnum.FinancialInformation}}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ScrollView Grid.Row="1">

                            <StackLayout>
                                <!--  On Cabs Clicked Starts  -->
                                <StackLayout x:Name="Cabs" IsVisible="{Binding isCabVisible}">

                                    <ListView
                                        x:Name="CarList"
                                        BackgroundColor="White"
                                        HasUnevenRows="True"
                                        HorizontalOptions="FillAndExpand"
                                        ItemsSource="{Binding Cabs}"
                                        SelectionMode="None"
                                        SeparatorVisibility="None"
                                        VerticalOptions="FillAndExpand"
                                        VerticalScrollBarVisibility="Never">
                                        <x:Arguments>
                                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                        </x:Arguments>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <ViewCell>
                                                    <!--  Start of General taxi Office  -->

                                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                        <StackLayout>
                                                            <StackLayout Padding="10" Orientation="Horizontal">
                                                                <Image
                                                                    Margin="0"
                                                                    Source="ic_vat_bill"
                                                                    Style="{StaticResource SmallIcon}" />
                                                                <Label
                                                                    Style="{StaticResource SectionTitleBlack}"
                                                                    Text="{Binding ActDesc}"
                                                                    VerticalTextAlignment="Center" />
                                                            </StackLayout>

                                                            <BoxView
                                                                BackgroundColor="LightGray"
                                                                HeightRequest="1"
                                                                HorizontalOptions="FillAndExpand" />

                                                            <StackLayout Padding="10" Spacing="10">

                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5OutletName}" />
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        Text="{Binding ActDesc}" />
                                                                </StackLayout>

                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NumOfCars}" />
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        Text="{Binding NoOfCars}" />
                                                                </StackLayout>
                                                                <StackLayout Orientation="Horizontal" Spacing="5">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5AvgDailyIncome}" />
                                                                    <Label
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        StyleId="ValueLabel"
                                                                        WidthRequest="180">
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding AgvDlyIncome}" />
                                                                                <Span Text=" " />
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>
                                                                </StackLayout>
                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5OccupancyRate}" />
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        Text="{Binding OccRate, StringFormat='{0:F2} %'}" />
                                                                </StackLayout>
                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NetProfitPer}" />
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        Text="{Binding NetPftPer, StringFormat='{0:F2} %'}" />
                                                                </StackLayout>

                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Revenue}" />
                                                                    <!--<Label Text="{Binding Revenue, StringFormat='{0:F2} SAR'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">-->
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}">
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding Revenue}" />
                                                                                <Span Text=" " />
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>
                                                                </StackLayout>

                                                                <Grid RowSpacing="0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto" />

                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackLayout
                                                                        Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        Orientation="Horizontal">
                                                                        <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Expenses}" />
                                                                    </StackLayout>

                                                                    <Label
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        StyleId="ValueLabel"
                                                                        Text="{Binding IsApplicable}" />
                                                                    <Label
                                                                        Grid.Row="1"
                                                                        Grid.Column="1"
                                                                        HorizontalTextAlignment="End"
                                                                        IsVisible="{Binding IsApplicableVisible}"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        StyleId="ValueLabel">
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding Expenses}" />
                                                                                <Span Text=" " />
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>

                                                                </Grid>
                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NetProfit}" />
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}">
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding NetPft}" />
                                                                                <Span Text=" " />
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>
                                                                </StackLayout>
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </Border>
                                                    <!--  End of General taxi Office  -->
                                                </ViewCell>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackLayout>
                                <!--  On Cabs Clicked Ends  -->

                                <!--  On Professionals Clicked starts  -->
                                <StackLayout x:Name="Professionals" IsVisible="{Binding isProfessionalVisible}">

                                    <ListView
                                        x:Name="ProfessionalsList"
                                        BackgroundColor="White"
                                        HasUnevenRows="True"
                                        HorizontalOptions="FillAndExpand"
                                        ItemsSource="{Binding Professionals}"
                                        SeparatorVisibility="None"
                                        VerticalOptions="FillAndExpand"
                                        VerticalScrollBarVisibility="Never">
                                        <x:Arguments>
                                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                        </x:Arguments>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <ViewCell>
                                                    <!--  Start Of Land Travel Starts  -->
                                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                        <StackLayout>
                                                            <StackLayout Padding="10" Orientation="Horizontal">
                                                                <Image
                                                                    Margin="0"
                                                                    Source="ic_vat_bill"
                                                                    Style="{StaticResource SmallIcon}" />
                                                                <Label Style="{StaticResource SectionTitleBlack}" Text="{Binding ActDesc}" />
                                                            </StackLayout>

                                                            <BoxView
                                                                BackgroundColor="LightGray"
                                                                HeightRequest="1"
                                                                HorizontalOptions="FillAndExpand" />

                                                            <StackLayout Padding="10" Spacing="10">
                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label
                                                                        Style="{StaticResource ValueLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.FORM5OutletName}"
                                                                        WidthRequest="140" />
                                                                    <Label
                                                                        HorizontalOptions="EndAndExpand"
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        StyleId="ValueLabel"
                                                                        Text="{Binding ActDesc}" />
                                                                </StackLayout>
                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Revenue}" />
                                                                    <Label HorizontalOptions="EndAndExpand" Style="{StaticResource ValueLabelBlack}">
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding Revenue}" />
                                                                                <Span Text=" " />
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>
                                                                </StackLayout>

                                                                <Grid RowSpacing="0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto" />

                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackLayout
                                                                        Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        Orientation="Horizontal">
                                                                        <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5Expenses}" />
                                                                    </StackLayout>

                                                                    <Label
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        HorizontalTextAlignment="End"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        StyleId="ValueLabel"
                                                                        Text="{Binding IsApplicable}" />
                                                                    <Label
                                                                        Grid.Row="1"
                                                                        Grid.Column="1"
                                                                        HorizontalTextAlignment="End"
                                                                        IsVisible="{Binding IsApplicableVisible}"
                                                                        Style="{StaticResource ValueLabelBlack}"
                                                                        StyleId="ValueLabel">
                                                                        <Label.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding Expenses}" />
                                                                                <Span Text=" " />
                                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                            </FormattedString>
                                                                        </Label.FormattedText>
                                                                    </Label>

                                                                </Grid>

                                                                <StackLayout Orientation="Horizontal">
                                                                    <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FORM5NetProfit}" />
