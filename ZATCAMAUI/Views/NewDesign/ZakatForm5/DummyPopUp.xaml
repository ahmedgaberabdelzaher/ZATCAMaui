<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatForm5.DummyPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Border Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand">
        <StackLayout>
            <Label Style="{StaticResource SectionTitleBlack}" Text="On Occupancy Rated Clicked" />
        </StackLayout>
    </Border>
</Mopups:PopupPage>