<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatForm5.ZakatAcknowledgmentPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingZakatAcknowledgmentPageCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="50*,50*" >
            <StackLayout
                Grid.Row="0"
                VerticalOptions="Center"
                Spacing="20">
                <Image Source="Forget_ic_success" />

                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    StyleId="OnBoardText"
                    Text="{x:Static ResourceManager:AppResources.NDReturnOfZakat}" />

                <Label
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource BodyLabelBlack}"
                    StyleId="OnBoardText"
                    Text="{x:Static ResourceManager:AppResources.FORM5BillAmtAboveObtainCertificate}"
                    TextColor="White" />
            </StackLayout>

            <Border
                Grid.Row="1"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">
                <Grid RowDefinitions="*,auto"
                      RowSpacing="10">

                    <ScrollView Grid.Row="0">
                        <StackLayout>
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Padding="15,10,15,10" Orientation="Horizontal">

                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.FORM5SadadBillNo}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding SadadBillNumber}" />
                                    </StackLayout>
                                </StackLayout>
                            </Border>


                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Padding="15,10,15,10" Orientation="Horizontal">

                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.FORM5TotalZakatPayable}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Label HorizontalOptions="Start" Style="{StaticResource BodyLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding TotalZakatPayble}" />
                                                    <Span Text=" " />
                                                    <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </StackLayout>
                                </StackLayout>
                            </Border>

                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                <Grid
                                    Padding="15,10,15,10"
                                    ColumnSpacing="10"
                                    ColumnDefinitions="auto,*">

                                    <Image Source="ic_vat_info.png"
                                           Style="{StaticResource SmallIcon}"/>

                                    <Label
                                        HorizontalOptions="Start"
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.NDPayBillAmtObtainCertificateAutomaticall}" />
                                </Grid>
                            </Border>
                        </StackLayout>
                    </ScrollView>

                    <buttons:SfButton
                        Grid.Row="1"
                        x:Name="btnprimary"
                        Command="{Binding OnFinishedCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.Form5Finish}" />
                </Grid>
            </Border>

        </Grid>
    </ContentPage.Content>
</ContentPage>