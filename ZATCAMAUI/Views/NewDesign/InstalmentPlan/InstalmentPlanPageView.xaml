<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.InstalmentPlan.InstalmentPlanPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>

            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />

        </ResourceDictionary>


    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VatInstalmentPlan}"
                    VerticalOptions="Center" />


            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">
                    

                    <ScrollView
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">

                        <!--  Code for Zakat & VAT options  -->
                        <Grid
                            HorizontalOptions="FillAndExpand"
                            RowDefinitions="auto,auto"
                            VerticalOptions="FillAndExpand">

                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                RowDefinitions="auto,auto,auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="28"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPlan}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetChooseTaxTypeText}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    HeightRequest="1"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            </Grid>

                            <Grid Grid.Row="1" RowDefinitions="*">

                                <listView:SfListView
                                    x:Name="outletDecisionOptionsListView"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    AutoFitMode="DynamicHeight"
                                    CachingStrategy="RecycleTemplate"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="12"
                                    ItemTemplate="{StaticResource UnselectedItemTemplateSelector}"
                                    ItemsSource="{Binding OutletDecisionOptions}"
                                    ScrollBarVisibility="Never"
                                    SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                    SelectedItemTemplate="{StaticResource SelectedIttemTemplateSelector}"
                                    SelectionBackground="Transparent"
                                    SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Center">

                                    <listView:SfListView.ItemsLayout>

                                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />

                                    </listView:SfListView.ItemsLayout>

                                </listView:SfListView>

                            </Grid>

                        </Grid>

                    </ScrollView>


                </Grid>

            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>

