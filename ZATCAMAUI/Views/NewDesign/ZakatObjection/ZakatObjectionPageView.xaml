<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatObjection.ZakatObjectionPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingZakatObjectionPageViewCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>



    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatObjection}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <commonView:PageIndicatorView
                                    Margin="20,25,0,0"
                                    Completed="{Binding MarkComplete}"
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}"
                                    VerticalOptions="CenterAndExpand" />
                            </Grid>

                            <Grid Grid.Row="1">


                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsVATBillsViewEnabled}"
                                    VerticalOptions="FillAndExpand">

                                    <Grid>
                                        <listView:SfListView
                                            x:Name="ObjectionsList"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding ReturnBills}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="Multiple"
                                            VerticalOptions="Center">

                                            <listView:SfListView.HeaderTemplate>
                                                <DataTemplate>
                                                    <ViewCell>
                                                        <ViewCell.View>
                                                            <Grid FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="1" />
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>

                                                                <Label
                                                                    Grid.Row="1"
                                                                    Grid.ColumnSpan="3"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource SectionTitleBlack}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZOSelectReturn}" />
                                                                <Label
                                                                    Grid.Row="2"
                                                                    Grid.ColumnSpan="3"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource BodyLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZOChooseOneReturn}" />
                                                                <BoxView
                                                                    Grid.Row="3"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="3"
                                                                    HeightRequest="1"
                                                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                                <Border
                                                                    Grid.Row="4"
                                                                    Grid.ColumnSpan="3"
                                                                    Margin="0,10,0,20"
                                                                    Padding="0"
                                                                    Stroke="Gray"
                                                                    StrokeShape="RoundRectangle 12,12,12,12">
                                                                    <SearchBar
                                                                        Margin="0"
                                                                        FontSize="Small"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        HorizontalTextAlignment="Center"
                                                                        IsEnabled="True"
                                                                        Placeholder="{x:Static ResourceManager:AppResources.ZOSearchReturnReferenceNumber}"
                                                                        PlaceholderColor="Gray"
                                                                        Text="{Binding InputData}"
                                                                        TextChanged="SearchItem_PropertyChanged"
                                                                        TextColor="{StaticResource PrimaryColor}"
                                                                        VerticalOptions="FillAndExpand" />
                                                                </Border>

                                                            </Grid>

                                                        </ViewCell.View>
                                                    </ViewCell>
                                                </DataTemplate>
                                            </listView:SfListView.HeaderTemplate>
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <cards:SfCardView
                                                        BackgroundColor="Transparent"
                                                        CornerRadius="10"
                                                        FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                            <Image
                                                                Aspect="AspectFill"
                                                                HorizontalOptions="FillAndExpand"
                                                                Source="re_Tile_Background_S"
                                                                VerticalOptions="FillAndExpand" />
                                                            <Grid
                                                                Padding="10"
                                                                HorizontalOptions="FillAndExpand"
                                                                VerticalOptions="FillAndExpand">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="1" />
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="auto" />
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="50*" />
                                                                    <ColumnDefinition Width="50*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Label
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="2"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource SectionTitleBlack}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZZAKAT}"
                                                                    TextColor="White" />
                                                                <Label
                                                                    Grid.Row="1"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="2"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource MiniNewGrayLabelStyle}"
                                                                    Text="{Binding FinancialPeriod}"
                                                                    TextColor="White" />
                                                                <BoxView
                                                                    Grid.Row="2"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="2"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource NeutralGrayOpacity90BoxView}"
                                                                    VerticalOptions="FillAndExpand" />

                                                                <Label
                                                                    Grid.Row="3"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="2"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    TextColor="White"
                                                                    VerticalOptions="Center"
                                                                    VerticalTextAlignment="Center">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span
                                                                                Style="{StaticResource SectionTitleBlack}"
                                                                                Text="{Binding AssessmentAmountGAZT, StringFormat='{0:N}', Converter={StaticResource commaSeparatorConverter}}"
                                                                                TextColor="White" />
                                                                            <Span
                                                                                Style="{StaticResource SectionTitleBlack}"
                                                                                Text="&#160;"
                                                                                TextColor="White" />
                                                                            <Span
                                                                                Style="{StaticResource SectionTitleBlack}"
                                                                                Text="{x:Static ResourceManager:AppResources.ZSAR}"
                                                                                TextColor="White" />
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </Label>


                                                                <Label
                                                                    Grid.Row="4"
                                                                    Grid.Column="0"
                                                                    Style="{StaticResource MiniNewGrayLabelStyle}"
                                                                    Text="{x:Static ResourceManager:AppResources.CRReferenceNumber}"
                                                                    TextColor="White" />
                                                                <Label
                                                                    Grid.Row="5"
                                                                    Grid.Column="0"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding ReferenceNum}"
                                                                    TextColor="White" />
                                                                <Label
                                                                    Grid.Row="4"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource MiniNewGrayLabelStyle}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZakatYear}"
                                                                    TextColor="White" />
                                                                <Label
                                                                    Grid.Row="5"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding FiscalYear, StringFormat='{0:dd MMM yyyy}'}"
                                                                    TextColor="White" />
                                                            </Grid>
                                                        </Grid>
                                                    </cards:SfCardView>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </Grid>
                                    <Grid VerticalOptions="EndAndExpand">

                                        <buttons:SfButton
                                            x:Name="btnVATBillsContinue"
                                            Margin="0,16,0,16"
                                            Command="{Binding BillContinueBtnTapped}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}" />
                                    </Grid>


                                </StackLayout>

                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsObjectionDetailsEnabled}">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="1" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZOObjectionDetails}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZOCompletebelowdetails}" />
                                        <BoxView
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    </Grid>

                                    <Border Margin="0,16,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">

                                        <StackLayout>

                                            <Grid Padding="5" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>



                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="3,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="establishments"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />
                                                    <Label
                                                        Padding="8,0"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="3,0"
                                                    HorizontalOptions="End"
                                                    IsVisible="False">
                                                    <Label
                                                        FontSize="Medium"
                                                        HorizontalOptions="End"
                                                        Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.ZOViewReturn}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <StackLayout Padding="15,15,15,0">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZOFiscalYear}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding FiscalYear}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZOFinancialPeriod}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding FinancialPeriod}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZOReturnReferenceNumber}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ReferenceNum}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZOTaxType}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding TaxType}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZOAssessmentAmountGAZT}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding AssessmentAmountGAZT, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZORevisedAmount}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding RevisedAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZODisputeAmount}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding DisputeAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>

                                    </Border>

                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZOWritteyourObjectionReason}" />

                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="10"
                                        Style="{StaticResource GreyBorderFrame}">

                                        <custom:GAZTBorderlessEditor
                                            FontSize="Small"
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            MaxLength="1000"
                                            MinimumHeightRequest="150"
                                            PlaceholderColor="Gray"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding ObjectionReasons}" />

                                    </Border>

                                    <buttons:SfButton
                                        Margin="0,16,0,16"
                                        Command="{Binding IsObjectionDetailsTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                        VerticalOptions="EndAndExpand" />

                                </StackLayout>


                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsAttachmentsViewEnabled}"
                                    VerticalOptions="FillAndExpand">


                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="1" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZOAttachments}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZOCompletebelowdetails}" />
                                        <BoxView
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    </Grid>


                                    <Grid HorizontalOptions="FillAndExpand">

                                        <listView:SfListView
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding AttachmentsListViewData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="SingleDeselect"
                                            TapCommand="{Binding NewAttachmentTapped}"
                                            VerticalOptions="Center">


                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}" HorizontalOptions="FillAndExpand">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Border
                                                            Grid.Row="0"
                                                            Margin="0,0,0,10"
                                                            Padding="12"
                                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />
                                                                </Grid.RowDefinitions>

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    Margin="5,0"
                                                                    HeightRequest="25"
                                                                    HorizontalOptions="Start"
                                                                    Source="Generic_attachment_icon"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="25" />

                                                                <Label
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    Style="{StaticResource CaptionLabelBlack}"
                                                                    Text="{Binding Filename}"
                                                                    VerticalOptions="Center" />

                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="2"
                                                                    HorizontalOptions="Center"
                                                                    Rotation="90"
                                                                    VerticalOptions="Center">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                            Size="24"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                </Image>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </Grid>

                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.VRNewAttachment}" />
                                        <Border
                                            Grid.Row="1"
                                            Margin="0,0,0,10"
                                            Padding="10"
                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                    TextColor="{StaticResource PrimaryColor}" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="Center"
                                                    Rotation="90"
                                                    VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                            Size="24"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                        </Grid.GestureRecognizers>

                                    </Grid>

                                    <buttons:SfButton
                                        Margin="0,16,0,16"
                                        Command="{Binding AttachmentsContinueTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                        VerticalOptions="End" />


                                </StackLayout>

                                <StackLayout
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsSecurityPaymentsVisible}"
                                    VerticalOptions="FillAndExpand">

                                    <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
