                                            Grid.Column="0"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZOPeriodFrom}" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding PeriodFrom}" />


                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZOPeriodTo}" />
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding PeriodTo}" />


                                        <Label
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZOTaxType}" />
                                        <Label
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding TaxType}" />

                                        <Label
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZOCurrency}" />
                                        <Label
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding Currency}" />

                                        <Label
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZOAssessmentAmount}" />
                                        <Label
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding AssessmentAmount, Converter={StaticResource commaSeparatorConverter}}" />

                                        <Label
                                            Grid.Row="7"
                                            Grid.Column="0"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZORevisedAmount}" />
                                        <Label
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding RevisedAmount, Converter={StaticResource commaSeparatorConverter}}" />


                                        <Label
                                            Grid.Row="8"
                                            Grid.Column="0"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZODisputeAmount}" />
                                        <Label
                                            Grid.Row="8"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding DisputeAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                    </Grid>

                                </StackLayout>
                            </StackLayout>

                        </Border>

                        <buttons:SfButton
                            Margin="0,16,0,16"
                            Command="{Binding IsWithDrawDetailsTapped}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.VRContinue}"
                            VerticalOptions="End" />

                    </StackLayout>

                    <StackLayout
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsWithdrawAttachmentsVisible}"
                        VerticalOptions="FillAndExpand">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZOAttachments}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZOCompletebelowdetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <StackLayout Orientation="Vertical">


                            <listView:SfListView
                                AutoFitMode="Height"
                                HeightRequest="100"
                                HorizontalOptions="Center"
                                ItemSpacing="5"
                                ItemsSource="{Binding WithdrawAttachmentsListViewData}"
                                SelectionBackground="Transparent"
                                SelectionMode="SingleDeselect"
                                TapCommand="{Binding WithdrawAttachmentTapped}"
                                VerticalOptions="Center">


                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Margin="0,0,0,10"
                                                Padding="12"
                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="5,0"
                                                        HeightRequest="25"
                                                        HorizontalOptions="Start"
                                                        Source="Generic_attachment_icon"
                                                        VerticalOptions="Center"
                                                        WidthRequest="25" />

                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding Filename}"
                                                        VerticalOptions="Center" />


                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        HorizontalOptions="Center"
                                                        Rotation="90"
                                                        VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                Size="24"
                                                                Color="DarkGray" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                            <Label
                                Grid.Row="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZOWithdrawGeneralAttachmentOne}" />

                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,10"
                                    Padding="10"
                                    Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="Small"
                                            HorizontalOptions="FillAndExpand"
                                            Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                            TextColor="{StaticResource PrimaryColor}" />
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="Center"
                                            Rotation="90"
                                            VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                    Size="24"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </Border>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding WithdrawAttachmentTapped}" />
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--  Second Attachment  -->



                            <listView:SfListView
                                AutoFitMode="Height"
                                HeightRequest="100"
                                HorizontalOptions="Center"
                                ItemSpacing="5"
                                ItemsSource="{Binding WithdrawAttachmentsListViewDataTwo}"
                                SelectionBackground="Transparent"
                                SelectionMode="SingleDeselect"
                                TapCommand="{Binding WithdrawAttachmentTappedTwo}"
                                VerticalOptions="Center">


                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                Margin="0,0,0,10"
                                                Padding="12"
                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="5,0"
                                                        HeightRequest="25"
                                                        HorizontalOptions="Start"
                                                        Source="Generic_attachment_icon"
                                                        VerticalOptions="Center"
                                                        WidthRequest="25" />

                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding Filename}"
                                                        VerticalOptions="Center" />
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        HorizontalOptions="Center"
                                                        Rotation="90"
                                                        VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                Size="24"
                                                                Color="DarkGray" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                            <Label
                                Grid.Row="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZOWithdrawGeneralAttachmentTwo}" />

                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,10"
                                    Padding="10"
                                    Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="Small"
                                            HorizontalOptions="FillAndExpand"
                                            Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                            TextColor="{StaticResource PrimaryColor}" />
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="Center"
                                            Rotation="90"
                                            VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                    Size="24"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </Border>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding WithdrawAttachmentTappedTwo}" />
                                </Grid.GestureRecognizers>

                            </Grid>

                        </StackLayout>


                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.CRRemarks}" />
                        <Border
                            Margin="0,5,0,10"
                            Padding="10"
                            Style="{StaticResource GreyBorderFrame}">

                            <custom:GAZTBorderlessEditor
                                FontSize="Small"
                                HorizontalOptions="FillAndExpand"
                                PlaceholderColor="Gray"
                                Style="{StaticResource BodyLabelBlack}"
                                Text="{Binding RemarkNote}" />

                        </Border>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ZOWithdrawlDetailDescription}" />
                        <Border
                            Margin="0,5,0,10"
                            Padding="10"
                            Style="{StaticResource GreyBorderFrame}">

                            <custom:GAZTBorderlessEditor
                                FontSize="Small"
                                HorizontalOptions="FillAndExpand"
                                MaxLength="1000"
                                MinimumHeightRequest="150"
                                PlaceholderColor="Gray"
                                Style="{StaticResource BodyLabelBlack}"
                                Text="{Binding DetailDescriptionNote}" />

                        </Border>

                        <buttons:SfButton
                            Margin="0,10,0,25"
                            Command="{Binding WithdrAttachmentsContinueTapped}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.Submit}"
                            VerticalOptions="End" />
                    </StackLayout>

                    <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="Black"
                            Opacity="0.4"
                            Orientation="Vertical"
                            VerticalOptions="CenterAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="15,15"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Opacity="0.8"
                            Orientation="Vertical"
                            VerticalOptions="CenterAndExpand">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <busyindicator:SfBusyIndicator
                                    x:Name="busyindicatorForLanding"
                                    HorizontalOptions="CenterAndExpand"
                                    IsRunning="True"
                                    AnimationType="Cupertino"
                                    SizeFactor="0.6"
                                    WidthRequest="70"
                                    HeightRequest="70"
                                    IndicatorColor="{StaticResource Secondary}"
                                    TitlePlacement="Bottom"
                                    VerticalOptions="CenterAndExpand"/>
                                <!--  Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"  -->
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </Grid>

            </Grid>
        </ScrollView>

    </ContentPage.Content>
</ContentPage>