<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementsNewFilterPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    FlowDirection="{Binding AppDirection}"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>

                    <Style x:Key="FilterArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="FilterArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>



    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        StrokeShape="RoundRectangle 15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.AccountStatementsFilterTitle}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="24"
                            HorizontalOptions="EndAndExpand"
                            Source="close"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.FilterCloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>



                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="FillAndExpand">
                        <Label
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.TransactionAmount}" />
                        <Border
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <StackLayout
                                Padding="5,8,5,8"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">

                                <Grid HorizontalOptions="FillAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="TxFromAmountEntry"
                                        Grid.Column="0"
                                        Keyboard="Numeric"
                                        Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding FromAmount}"
                                        TextChanged="From_Amount_Changed"
                                        Unfocused="From_Amount_Unfocused" />





                                    <StackLayout
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Orientation="Horizontal">


                                        <Image
                                            Margin="5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="arrowRight"
                                            Style="{DynamicResource FilterArrow}"
                                            WidthRequest="24" />

                                    </StackLayout>

                                    <custom:GAZTBorderlessEntry
                                        x:Name="TxToAmountEntry"
                                        Grid.Column="2"
                                        Keyboard="Numeric"
                                        Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding ToAmount}"
                                        TextChanged="To_Amount_Changed"
                                        Unfocused="To_Amount_Unfocused" />


                                </Grid>
                            </StackLayout>

                        </Border>
                    </StackLayout>

                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="FillAndExpand">
                        <Label
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                        <Border
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <StackLayout
                                Padding="5,8,5,8"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Horizontal">


                                <Grid HorizontalOptions="FillAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <StackLayout
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">


                                        <custom:GAZTBorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TxFromDate, StringFormat='{0:dd MMM yyyy}'}" />


                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>

                                        </StackLayout>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TSDateStartDateClicked" />
                                        </StackLayout.GestureRecognizers>


                                    </StackLayout>
                                    <StackLayout
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Image
                                            Margin="5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="arrowRight"
                                            Style="{DynamicResource FilterArrow}"
                                            WidthRequest="24" />

                                    </StackLayout>

                                    <StackLayout
                                        Grid.Column="2"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">

                                        <custom:GAZTBorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TxToDate, StringFormat='{0:dd MMM yyyy}'}" />
                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>

                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TSDateEndDateClicked" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Border>
                    </StackLayout>
                    <custom:CustomDatePicker
                        x:Name="TxDateNormalCalendar"
                        Margin="2"
                        Background="White"
                        Closed="TxDateNormalCalendar_Closed"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        Mode="Dialog"
                        SelectedItem="{Binding TodayDateNormal}"
                        Style="{StaticResource PickerStyle}">

                        <custom:CustomDatePicker.ColumnHeaderView>
                            <syncfusion:PickerColumnHeaderView Height="46" />
                        </custom:CustomDatePicker.ColumnHeaderView>

                         <custom:CustomDatePicker.SelectionView>
                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                        </custom:CustomDatePicker.SelectionView>


                        <custom:CustomDatePicker.SelectedTextStyle>
                            <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                        </custom:CustomDatePicker.SelectedTextStyle>

                        <custom:CustomDatePicker.HeaderView>

                            <syncfusion:PickerHeaderView Background="{StaticResource SecondaryNew}"
                                                         Height="46"
                                                         Text="{x:Static ResourceManager:AppResources.VRStartDate}" />

                        </custom:CustomDatePicker.HeaderView>


                        <custom:CustomDatePicker.FooterView>

                            <syncfusion:PickerFooterView
                                Background="White"
                                Height="46"
                                CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                <syncfusion:PickerFooterView.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource PrimaryColor}" />
                                </syncfusion:PickerFooterView.TextStyle>

                            </syncfusion:PickerFooterView>

                        </custom:CustomDatePicker.FooterView>

                    </custom:CustomDatePicker>

                    <!--  HijriDatePicker  -->

                    <custom:CustomHijriDatePicker
                        x:Name="TxDateHijriCalendar"
                        Margin="2"
                        Background="White"
                        Closed="TxDateNormalCalendar_Closed"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        Mode="Dialog"
                        SelectedItem="{Binding TodayDateinHijri}">

                        <custom:CustomHijriDatePicker.ColumnHeaderView>
                            <syncfusion:PickerColumnHeaderView Height="46" />
                        </custom:CustomHijriDatePicker.ColumnHeaderView>

                         <custom:CustomHijriDatePicker.SelectionView >
                            <syncfusion:PickerSelectionView  Background="{StaticResource Secondary}" />
                         </custom:CustomHijriDatePicker.SelectionView>

                        <custom:CustomHijriDatePicker.HeaderView>

                            <syncfusion:PickerHeaderView
                                Height="46"
                                Background="{StaticResource SecondaryNew}"
                                Text="{x:Static ResourceManager:AppResources.VREndDate}" />

                        </custom:CustomHijriDatePicker.HeaderView>

                        <custom:CustomHijriDatePicker.SelectedTextStyle>
                            <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                        </custom:CustomHijriDatePicker.SelectedTextStyle>

                        <custom:CustomHijriDatePicker.FooterView>

                            <syncfusion:PickerFooterView
                                Height="46"
                                Background="White"
                                CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                <syncfusion:PickerFooterView.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                </syncfusion:PickerFooterView.TextStyle>

                            </syncfusion:PickerFooterView>

                        </custom:CustomHijriDatePicker.FooterView>

                    </custom:CustomHijriDatePicker>

                    <StackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalOptions="FillAndExpand">
                        <Label
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" />
                        <Border
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <StackLayout Padding="5,8,5,8" Orientation="Horizontal">

                                <Grid HorizontalOptions="FillAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <StackLayout
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">


                                        <custom:GAZTBorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TPFromDate, StringFormat='{0:dd MMM yyyy}'}" />

                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TaxPeriodStartDateClicked" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>

                                    <StackLayout
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Image
                                            Margin="5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            Source="arrowRight"
                                            Style="{DynamicResource FilterArrow}"
                                            WidthRequest="24" />

                                    </StackLayout>

                                    <StackLayout
                                        Grid.Column="2"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">

                                        <custom:GAZTBorderlessEntry
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TPToDate, StringFormat='{0:dd MMM yyyy}'}" />
                                        <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>

                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer x:Name="EndDate" Tapped="TaxPeriodEndDateClicked" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Border>
                    </StackLayout>

                    <custom:CustomDatePicker
                        x:Name="TaxPeriodDateNormalCalendar"
                        Margin="2"
                        Background="White"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        Mode="Dialog"
                        SelectedItem="{Binding TodayDateNormal}"
                        Style="{StaticResource PickerStyle}">

                        <custom:CustomDatePicker.ColumnHeaderView>
                            <syncfusion:PickerColumnHeaderView Height="46" />
                        </custom:CustomDatePicker.ColumnHeaderView>

                         <custom:CustomDatePicker.SelectionView>
                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                        </custom:CustomDatePicker.SelectionView>

                        <custom:CustomDatePicker.SelectedTextStyle>
                            <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                        </custom:CustomDatePicker.SelectedTextStyle>

                        <custom:CustomDatePicker.HeaderView>

                            <syncfusion:PickerHeaderView Background="{StaticResource SecondaryNew}"
                                                         Height="46"
                                                         Text="{x:Static ResourceManager:AppResources.VRStartDate}" />

                        </custom:CustomDatePicker.HeaderView>


                        <custom:CustomDatePicker.FooterView>

                            <syncfusion:PickerFooterView
                                Background="White"
                                Height="46"
                                CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                <syncfusion:PickerFooterView.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource PrimaryColor}" />
                                </syncfusion:PickerFooterView.TextStyle>

                            </syncfusion:PickerFooterView>

                        </custom:CustomDatePicker.FooterView>

                    </custom:CustomDatePicker>

                    <!--  HijriDatePicker  -->

                    <custom:CustomHijriDatePicker
                        x:Name="TaxPeriodDateHijriCalendar"
                        Margin="2"
                        Background="White"
                        HorizontalOptions="FillAndExpand"
                        ItemHeight="36"
                        Mode="Dialog"
                        SelectedItem="{Binding TodayDateinHijri}">

                         <custom:CustomHijriDatePicker.SelectionView >
                            <syncfusion:PickerSelectionView  Background="{StaticResource Secondary}" />
                         </custom:CustomHijriDatePicker.SelectionView>

                         <custom:CustomHijriDatePicker.ColumnHeaderView>
                            <syncfusion:PickerColumnHeaderView Height="46" />
                        </custom:CustomHijriDatePicker.ColumnHeaderView>

                        <custom:CustomHijriDatePicker.SelectedTextStyle>
                            <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                        </custom:CustomHijriDatePicker.SelectedTextStyle>

                        <custom:CustomHijriDatePicker.HeaderView>

                            <syncfusion:PickerHeaderView
                                Height="46"
                                Background="{StaticResource SecondaryNew}"
                                Text="{x:Static ResourceManager:AppResources.VREndDate}" />

                        </custom:CustomHijriDatePicker.HeaderView>

                        <custom:CustomHijriDatePicker.FooterView>

                            <syncfusion:PickerFooterView
                                Height="46"
                                Background="White"
                                CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                <syncfusion:PickerFooterView.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource PrimaryColor}" />
                                </syncfusion:PickerFooterView.TextStyle>

                            </syncfusion:PickerFooterView>

                        </custom:CustomHijriDatePicker.FooterView>
                    </custom:CustomHijriDatePicker>

                    <buttons:SfButton
                        x:Name="btnReasonContinue"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,60,0,60"
                        Command="{Binding FilterBtnCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ACFilterApply}"
                        VerticalOptions="End" />
                </Grid>

            </ScrollView>
            <!--  {Binding IsLoading}  -->
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="False"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>