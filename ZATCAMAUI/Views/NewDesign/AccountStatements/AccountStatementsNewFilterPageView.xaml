<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementsNewFilterPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviour="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>

        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.AccountStatementsFilterTitle}"
                    VerticalOptions="Center" />

                <StackLayout Grid.Column="2">

                    <!--  Back Button  -->
                    <Image
                        HeightRequest="24"
                        HorizontalOptions="EndAndExpand"
                        Source="close"
                        VerticalOptions="CenterAndExpand"
                        WidthRequest="24" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCloseClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">
                    <ScrollView VerticalScrollBarVisibility="Never">

                        <VerticalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                            <VerticalStackLayout HorizontalOptions="FillAndExpand">

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.TransactionAmount}" />

                                <Border
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout
                                        Padding="10"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">

                                        <Grid ColumnDefinitions="*,auto,*" HorizontalOptions="FillAndExpand">

                                            <Border
                                                Padding="5,8,5,8"
                                                Stroke="#B1B1B1"
                                                StrokeThickness="1"
                                                Style="{StaticResource GreyBorderFrame}">

                                                <StackLayout Orientation="Horizontal">

                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="TxFromAmountEntry"
                                                        Keyboard="{OnPlatform Android=Numeric,
                                                                              iOS=Default}"
                                                        Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                                        Text="{Binding FromAmount}"
                                                        TextChanged="From_Amount_Changed"
                                                        Unfocused="From_Amount_Unfocused">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviour:OnlyNumericValuesBehaviour />
                                                        </custom:GAZTBorderlessEntry.Behaviors>

                                                    </custom:GAZTBorderlessEntry>

                                                    <Image
                                                        Margin="5,0"
                                                        HeightRequest="14"
                                                        Source="close"
                                                        WidthRequest="14">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="FromAmount_Tapped" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </StackLayout>

                                            </Border>

                                            <StackLayout
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                Orientation="Horizontal">


                                                <Image
                                                    Margin="5,0"
                                                    HeightRequest="24"
                                                    HorizontalOptions="End"
                                                    Source="arrowRight"
                                                    Style="{DynamicResource FilterArrow}"
                                                    WidthRequest="24" />

                                            </StackLayout>

                                            <Border
                                                Grid.Column="2"
                                                Padding="5,8,5,8"
                                                Stroke="#B1B1B1"
                                                StrokeThickness="1"
                                                Style="{StaticResource GreyBorderFrame}">

                                                <StackLayout Orientation="Horizontal">

                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="TxToAmountEntry"
                                                        Keyboard="{OnPlatform Android=Numeric,
                                                                              iOS=Default}"
                                                        Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                                        Text="{Binding ToAmount}"
                                                        TextChanged="To_Amount_Changed"
                                                        Unfocused="To_Amount_Unfocused">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviour:OnlyNumericValuesBehaviour />

                                                        </custom:GAZTBorderlessEntry.Behaviors>

                                                    </custom:GAZTBorderlessEntry>

                                                    <Image
                                                        Margin="5,0"
                                                        HeightRequest="14"
                                                        Source="close"
                                                        WidthRequest="14">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="ToAmount_Tapped" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </StackLayout>

                                            </Border>
                                        </Grid>
                                    </StackLayout>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout HorizontalOptions="FillAndExpand">

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ASDueDate}" />

                                <Border
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrame}">

                                    <VerticalStackLayout Padding="10" HorizontalOptions="FillAndExpand">


                                        <Grid ColumnDefinitions="*,auto,*" HorizontalOptions="FillAndExpand">

                                            <StackLayout
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">


                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    IsEnabled="False"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                                    Text="{Binding TxFromDate, StringFormat='{0:dd MMM yyyy}'}" />


                                                <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                                    <Image Margin="5,0">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                Size="24"
                                                                Color="{StaticResource SecondaryNew}" />
                                                        </Image.Source>
                                                    </Image>

                                                </StackLayout>
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TSDateStartDateClicked" />
                                                </StackLayout.GestureRecognizers>


                                            </StackLayout>

                                            <StackLayout
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">
                                                <Image
                                                    Margin="5,0"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Center"
                                                    Source="arrowRight"
                                                    Style="{DynamicResource FilterArrow}"
                                                    WidthRequest="24" />

                                            </StackLayout>

                                            <StackLayout
                                                Grid.Column="2"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">

                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    IsEnabled="False"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                                    Text="{Binding TxToDate, StringFormat='{0:dd MMM yyyy}'}" />
                                                <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                                    <Image Margin="5,0">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                Size="24"
                                                                Color="{StaticResource SecondaryNew}" />
                                                        </Image.Source>
                                                    </Image>

                                                </StackLayout>

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TSDateEndDateClicked" />
                                                </StackLayout.GestureRecognizers>

                                            </StackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout HorizontalOptions="FillAndExpand">

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" />

                                <Border
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrame}">

                                    <VerticalStackLayout Padding="10" HorizontalOptions="FillAndExpand">

                                        <Grid ColumnDefinitions="*,auto,*" HorizontalOptions="FillAndExpand">

                                            <StackLayout
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">


                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    IsEnabled="False"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementFrom}"
                                                    Text="{Binding TPFromDate, StringFormat='{0:dd MMM yyyy}'}" />

                                                <StackLayout HorizontalOptions="End">
                                                    <Image Margin="5,0">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                Size="24"
                                                                Color="{StaticResource SecondaryNew}" />
                                                        </Image.Source>
                                                    </Image>
                                                </StackLayout>
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TaxPeriodStartDateClicked" />
                                                </StackLayout.GestureRecognizers>

                                            </StackLayout>

                                            <StackLayout Grid.Column="1" HorizontalOptions="FillAndExpand">
                                                <Image
                                                    Margin="5,0"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Center"
                                                    Source="arrowRight"
                                                    Style="{DynamicResource FilterArrow}"
                                                    WidthRequest="24" />

                                            </StackLayout>

                                            <StackLayout
                                                Grid.Column="2"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">

                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    IsEnabled="False"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ASAccountStatementTo}"
                                                    Text="{Binding TPToDate, StringFormat='{0:dd MMM yyyy}'}" />

                                                <StackLayout HorizontalOptions="End">

                                                    <Image Margin="5,0">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                Size="24"
                                                                Color="{StaticResource SecondaryNew}" />
                                                        </Image.Source>
                                                    </Image>

                                                </StackLayout>

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer x:Name="EndDate" Tapped="TaxPeriodEndDateClicked" />
                                                </StackLayout.GestureRecognizers>

                                            </StackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>

                            <custom:CustomDatePicker
                                x:Name="TxDateNormalCalendar"
                                Margin="2"
                                Background="White"
                                Closed="TxDateNormalCalendar_Closed"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="36"
                                Mode="Dialog"
                                SelectedItem="{Binding TodayDateNormal}"
                                Style="{StaticResource PickerStyle}">

                                <custom:CustomDatePicker.ColumnHeaderView>
                                    <syncfusion:PickerColumnHeaderView Height="46" Background="white" />
                                </custom:CustomDatePicker.ColumnHeaderView>

                                <custom:CustomDatePicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </custom:CustomDatePicker.SelectionView>


                                <custom:CustomDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomDatePicker.SelectedTextStyle>

                                <custom:CustomDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VRStartDate}">

                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerHeaderView.TextStyle>

                                    </syncfusion:PickerHeaderView>

                                </custom:CustomDatePicker.HeaderView>


                                <custom:CustomDatePicker.FooterView>

                                    <syncfusion:PickerFooterView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                        OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </custom:CustomDatePicker.FooterView>

                            </custom:CustomDatePicker>

                            <!--  HijriDatePicker  -->
                            <custom:CustomHijriDatePicker
                                x:Name="TxDateHijriCalendar"
                                Margin="2"
                                Background="White"
                                Closed="TxDateNormalCalendar_Closed"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="36"
                                Mode="Dialog"
                                SelectedItem="{Binding TodayDateinHijri}">

                                <custom:CustomHijriDatePicker.ColumnHeaderView>
                                    <syncfusion:PickerColumnHeaderView Height="46" Background="white" />
                                </custom:CustomHijriDatePicker.ColumnHeaderView>

                                <custom:CustomHijriDatePicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </custom:CustomHijriDatePicker.SelectionView>

                                <custom:CustomHijriDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VREndDate}">

                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerHeaderView.TextStyle>

                                    </syncfusion:PickerHeaderView>

                                </custom:CustomHijriDatePicker.HeaderView>

                                <custom:CustomHijriDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomHijriDatePicker.SelectedTextStyle>

                                <custom:CustomHijriDatePicker.FooterView>

                                    <syncfusion:PickerFooterView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                        OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </custom:CustomHijriDatePicker.FooterView>

                            </custom:CustomHijriDatePicker>

                            <custom:CustomDatePicker
                                x:Name="TaxPeriodDateNormalCalendar"
                                Margin="2"
                                Background="White"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="36"
                                Mode="Dialog"
                                SelectedItem="{Binding TodayDateNormal}"
                                Style="{StaticResource PickerStyle}">

                                <custom:CustomDatePicker.ColumnHeaderView>
                                    <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                                </custom:CustomDatePicker.ColumnHeaderView>

                                <custom:CustomDatePicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </custom:CustomDatePicker.SelectionView>

                                <custom:CustomDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomDatePicker.SelectedTextStyle>

                                <custom:CustomDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VRStartDate}">
                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="white" />
                                        </syncfusion:PickerHeaderView.TextStyle>

                                    </syncfusion:PickerHeaderView>

                                </custom:CustomDatePicker.HeaderView>


                                <custom:CustomDatePicker.FooterView>

                                    <syncfusion:PickerFooterView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                        OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="white" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </custom:CustomDatePicker.FooterView>

                            </custom:CustomDatePicker>

                            <!--  HijriDatePicker  -->
                            <custom:CustomHijriDatePicker
                                x:Name="TaxPeriodDateHijriCalendar"
                                Margin="2"
                                Background="White"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="36"
                                Mode="Dialog"
                                SelectedItem="{Binding TodayDateinHijri}">

                                <custom:CustomHijriDatePicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </custom:CustomHijriDatePicker.SelectionView>

                                <custom:CustomHijriDatePicker.ColumnHeaderView>
                                    <syncfusion:PickerColumnHeaderView Height="46" />
                                </custom:CustomHijriDatePicker.ColumnHeaderView>

                                <custom:CustomHijriDatePicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle FontSize="15" TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomHijriDatePicker.SelectedTextStyle>

                                <custom:CustomHijriDatePicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VREndDate}">

                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="white" />
                                        </syncfusion:PickerHeaderView.TextStyle>

                                    </syncfusion:PickerHeaderView>

                                </custom:CustomHijriDatePicker.HeaderView>

                                <custom:CustomHijriDatePicker.FooterView>

                                    <syncfusion:PickerFooterView
                                        Height="46"
                                        Background="{StaticResource NeutralBlack}"
                                        CancelButtonText="{x:Static ResourceManager:AppResources.ZZCancel}"
                                        OkButtonText="{x:Static ResourceManager:AppResources.ZDone}">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </custom:CustomHijriDatePicker.FooterView>
                            </custom:CustomHijriDatePicker>

                            <buttons:SfButton
                                x:Name="btnReasonClear"
                                Margin="0,60"
                                Clicked="Clearfields"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ACFilterClear}"
                                VerticalOptions="End" />

                            <buttons:SfButton
                                x:Name="btnReasonContinue"
                                Margin="0,60"
                                Command="{Binding FilterBtnCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ACFilterApply}"
                                VerticalOptions="End" />

                        </VerticalStackLayout>

                    </ScrollView>
                </Grid>
            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        </Grid>

    </ContentPage.Content>
</ContentPage>