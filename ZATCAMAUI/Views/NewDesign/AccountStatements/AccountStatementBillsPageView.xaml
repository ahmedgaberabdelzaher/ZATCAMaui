<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementBillsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid
                Padding="20,15"
                ColumnDefinitions="*,3*,*"
                RowDefinitions="*,*">

                <VerticalStackLayout Grid.Row="0" Grid.Column="0">

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackBtnTapped}" />
                    </VerticalStackLayout.GestureRecognizers>

                </VerticalStackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ASAccountStatementDashboardTileText}"
                    VerticalOptions="Center" />

                <StackLayout
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalOptions="EndAndExpand"
                    IsVisible="{Binding IsSearchButtonVisible}"
                    Orientation="Horizontal"
                    Spacing="15"
                    VerticalOptions="CenterAndExpand">
                    <Image
                        HeightRequest="30"
                        Source="search"
                        WidthRequest="30">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="searchButtonTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        HeightRequest="30"
                        Source="filter"
                        WidthRequest="30">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="filterButtonTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    ColumnDefinitions="*,auto"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsCloseButtonVisible}">
                    <SearchBar
                        Grid.Column="0"
                        Margin="0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsCloseButtonVisible}"
                        Placeholder="{x:Static ResourceManager:AppResources.SerachFieldinAcc}"
                        TextChanged="SearchBar_TextChanged"
                        VerticalOptions="FillAndExpand" />
                    <Image
                        Grid.Column="1"
                        HeightRequest="24"
                        Source="close"
                        WidthRequest="24">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="auto,*">

                    <StackLayout>

                        <StackLayout Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="{Binding SelectedTransactionTypeFilter.Txt30, Mode=OneWay}"
                                VerticalOptions="CenterAndExpand">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_Clicked" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Image
                                HorizontalOptions="Center"
                                Source="arrowDropdown"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_Clicked" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>

                        <Label
                            Padding="0,0,0,0"
                            HorizontalOptions="StartAndExpand"
                            VerticalOptions="Start"
                            VerticalTextAlignment="Start">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ACMyTaxObligations}" />
                                    <Span Style="{StaticResource SectionTitleBlackBold}" Text=" : " />
                                    <Span Style="{StaticResource SectionTitleBlackBold}" Text="&#160;" />
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding AmountLabel}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <StackLayout
                            BackgroundColor="Transparent"
                            Orientation="Horizontal"
                            VerticalOptions="Center">

                            <!--  Status Chips  -->

                            <Grid Margin="0,5,0,0" VerticalOptions="Start">
                                <CollectionView
                                    BackgroundColor="Transparent"
                                    HeightRequest="50"
                                    HorizontalOptions="Center"
                                    ItemsLayout="HorizontalList"
                                    ItemsSource="{Binding ChipDataFilterlistForStatus}"
                                    SelectionMode="None"
                                    VerticalOptions="Start"
                                    WidthRequest="320">

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid
                                                Margin="5,0,5,0"
                                                FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                                HorizontalOptions="Start">
                                                <Border
                                                    Grid.Row="0"
                                                    Padding="10,10,10,10"
                                                    BackgroundColor="{Binding TemplateType}"
                                                    HeightRequest="20"
                                                    HorizontalOptions="FillAndExpand"
                                                    Opacity=".2"
                                                    StrokeShape="RoundRectangle 14,14,14,14"
                                                    VerticalOptions="CenterAndExpand" />
                                                <StackLayout Grid.Row="0" Padding="10,0,10,0">
                                                    <Label
                                                        HorizontalOptions="CenterAndExpand"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding Text}"
                                                        TextColor="{Binding TextColor}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ChipsData_Tapped" />
                                                </Grid.GestureRecognizers>


                                            </Grid>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>

                            <StackLayout>
                                <Image
                                    HeightRequest="25"
                                    HorizontalOptions="Center"
                                    Source="Sorting"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="25">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ClickOnSorting" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                        </StackLayout>

                    </StackLayout>

                    <Grid
                        Grid.Row="1"
                        Padding="0"
                        AbsoluteLayout.LayoutBounds="0.5, 0.5, 0.5, 0.5"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        RowDefinitions="3*,auto">

                        <ListView
                            x:Name="Bills"
                            Grid.Row="0"
                            BackgroundColor="White"
                            HasUnevenRows="True"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsListVisible}"
                            ItemTapped="LVNormalStatements_ItemTapped"
                            ItemsSource="{Binding MyBills, Mode=TwoWay}"
                            SelectionMode="None"
                            SeparatorVisibility="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Border
                                            Margin="0,12"
                                            FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                            Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Spacing="0">

                                                <Grid
                                                    Padding="16,4"
                                                    ColumnDefinitions="*,auto"
                                                    RowDefinitions="auto,auto"
                                                    RowSpacing="3">

                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{Binding BillTitle}"
                                                        VerticalOptions="CenterAndExpand" />

                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="10,10,10,10"
                                                        BackgroundColor="{Binding StatusBackGColor}"
                                                        HeightRequest="20"
                                                        HorizontalOptions="FillAndExpand"
                                                        StrokeShape="RoundRectangle 14"
                                                        VerticalOptions="CenterAndExpand" />

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,0"
                                                        Padding="15,12,15,12"
                                                        HorizontalOptions="FillAndExpand"
                                                        Orientation="Horizontal"
                                                        Spacing="2"
                                                        VerticalOptions="FillAndExpand">

                                                        <Label
                                                            HorizontalOptions="EndAndExpand"
                                                            LineBreakMode="WordWrap"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            TextColor="{StaticResource NewDarkGreenColor}"
                                                            VerticalOptions="CenterAndExpand">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{Binding TestDueAmount}"
                                                                        TextColor="{StaticResource NewDarkGreenColor}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <Label
                                                            HorizontalOptions="CenterAndExpand"
                                                            LineBreakMode="WordWrap"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            TextColor="{StaticResource NewDarkGreenColor}"
                                                            VerticalOptions="CenterAndExpand">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZSAR}"
                                                                        TextColor="{StaticResource NewDarkGreenColor}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                    </StackLayout>


                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{Binding FormatedFaedn}"
                                                        VerticalOptions="CenterAndExpand" />

                                                </Grid>

                                            </StackLayout>
                                        </Border>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Label
                            Grid.Row="1"
                            Margin="0,20"
                            HorizontalOptions="Center"
                            IsVisible="{Binding isNoDataLableVisible}"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.NoBillsAvailable}"
                            VerticalOptions="Center" />

                    </Grid>

                </Grid>

            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>