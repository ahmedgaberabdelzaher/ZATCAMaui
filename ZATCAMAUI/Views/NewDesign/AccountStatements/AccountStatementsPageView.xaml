<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:chips="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:sfconverters="clr-namespace:ZATCAMAUI.Core.Converters.SyncFusionEnabledConverters"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sfconverters:StringToColorConvertor x:Key="StringToColorConvertor" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>

                </ResourceDictionary>
                <ResourceDictionary>

                    <DataTemplate x:Key="otherDataTemplate">
                        <ViewCell>
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0" Spacing="0">
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="-10">
                                            <Label
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding Desc}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding TaxtypeDesc}" />
                                        </StackLayout>
                                        <yummy:PancakeView
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="10,10,10,10"
                                            BackgroundColor="{StaticResource Secondary}"
                                            CornerRadius="14"
                                            HeightRequest="20"
                                            HorizontalOptions="End"
                                            Opacity=".2"
                                            VerticalOptions="CenterAndExpand"
                                            WidthRequest="110">
                                            <yummy:PancakeView.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Status}"
                                                    TargetType="yummy:PancakeView"
                                                    Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </yummy:PancakeView.Triggers>
                                            <yummy:PancakeView.Border>
                                                <yummy:Border Thickness="1" />
                                            </yummy:PancakeView.Border>
                                        </yummy:PancakeView>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                HorizontalOptions="CenterAndExpand"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding StatusDesc}"
                                                TextColor="{StaticResource Secondary}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding StatusDesc}"
                                                        TargetType="Label"
                                                        Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Grid>
                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />
                                    <Grid
                                        Padding="10,10,10,10"
                                        ColumnSpacing="5"
                                        RowSpacing="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="-5">
                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASBillAmount}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding Betrh}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Spacing="-5">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASTransactionDate}" />
                                            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Bldat, StringFormat='{0:dd MMM yyyy}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Spacing="-5">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                                            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding PeriodEndDt, StringFormat='{0:dd MMM yyyy}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Spacing="-5">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ASTaxperiod}" />

                                            <custom:CustomLabel
                                                HorizontalOptions="Start"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="SingleLabel">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding PeriodTxt}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                    <DataTemplate x:Key="totalBalances">
                        <ViewCell>
                            <StackLayout>
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ASAccountStatementTotalDebit}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <yummy:PancakeView
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="10,10,10,10"
                                                BackgroundColor="{StaticResource NewDarkGreenColor}"
                                                CornerRadius="14"
                                                HeightRequest="20"
                                                HorizontalOptions="End"
                                                Opacity=".2"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="110">
                                                <yummy:PancakeView.Border>
                                                    <yummy:Border Thickness="1" />
                                                </yummy:PancakeView.Border>
                                            </yummy:PancakeView>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding HeaderSet.D.DebitAmount}"
                                                    TextColor="{StaticResource NewDarkGreenColor}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusDesc}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </Border>
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ASAccountStatementTotalCredit}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <yummy:PancakeView
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="10,10,10,10"
                                                BackgroundColor="{StaticResource ErrorColor}"
                                                CornerRadius="14"
                                                HeightRequest="20"
                                                HorizontalOptions="End"
                                                Opacity=".2"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="110">
                                                <yummy:PancakeView.Border>
                                                    <yummy:Border Thickness="1" />
                                                </yummy:PancakeView.Border>
                                                <yummy:PancakeView.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Status}"
                                                        TargetType="yummy:PancakeView"
                                                        Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </yummy:PancakeView.Triggers>
                                            </yummy:PancakeView>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding HeaderSet.D.CreditAmount}"
                                                    TextColor="{StaticResource ErrorColor}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusDesc}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </Border>
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.AccountStatementTotalBalance}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    IsVisible="{Binding IsTotalAmountVisible}"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{Binding HeaderSet.D.Close}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusDesc}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </Border>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                    <custom:AccountStatementsLVDataTemplateSelector x:Key="lvDataTemplateSelector" TotalBalanceTemplate="{StaticResource totalBalances}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ASAccountStatementDashboardTileText}" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Spacing="15"
                            VerticalOptions="CenterAndExpand">
                            <Image
                                HeightRequest="20"
                                IsVisible="{TemplateBinding BindingContext.IsSearchButtonVisible}"
                                Source="search"
                                WidthRequest="20">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="searchButtonTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image
                                HeightRequest="20"
                                Source="filter"
                                WidthRequest="20">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="filterButtonTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="FillAndExpand">

                            <Grid HorizontalOptions="FillAndExpand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <SearchBar
                                    Grid.Column="0"
                                    Margin="0"
                                    custom:RoundCornersEffect.CornerRadius="12"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}"
                                    TextChanged="SearchBar_TextChanged"
                                    VerticalOptions="FillAndExpand" />
                                <Image
                                    Grid.Column="1"
                                    HeightRequest="24"
                                    IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}"
                                    Source="close"
                                    WidthRequest="24">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                                    </Image.GestureRecognizers>
                                </Image>

                            </Grid>
                        </StackLayout>
                    </Grid>
                    <yummy:PancakeView
                        Padding="0"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,15,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>

            <StackLayout Padding="15" Orientation="Vertical">
                <ListView
                    x:Name="LvwContacts"
                    Margin="5"
                    BackgroundColor="White"
                    HasUnevenRows="True"
                    IsGroupingEnabled="True"
                    ItemTapped="LvwContacts_ItemTapped"
                    ItemsSource="{Binding GroupedData}"
                    SelectionMode="None"
                    SeparatorVisibility="None"
                    VerticalScrollBarVisibility="Never">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout>
                                        <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Padding="0" Spacing="0">
                                                <Grid Padding="15" RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Spacing="-10">
                                                        <Label
                                                            Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                            Text="{Binding Desc}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label
                                                            Margin="0,5,0,0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{Binding FormattedBldat}" />
                                                    </StackLayout>




                                                    <Frame
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="10,10,10,10"
                                                        BackgroundColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}"
                                                        CornerRadius="14"
                                                        HasShadow="False"
                                                        HeightRequest="20"
                                                        HorizontalOptions="FillAndExpand"
                                                        Opacity=".2"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="10,0,10,0"
                                                        HorizontalOptions="FillAndExpand"
                                                        VerticalOptions="FillAndExpand">
                                                        <!--<Label Style="{StaticResource CaptionLabelBlack}" Text="{Binding Betrh}"
                                               TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                        </Label>-->



                                                        <custom:CustomLabel
                                                            HorizontalOptions="CenterAndExpand"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            TextColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}"
                                                            VerticalOptions="CenterAndExpand">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{Binding Betrh, Converter={StaticResource commaSeparatorConverter}}"
                                                                        TextColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}" />
                                                                    <Span Style="{StaticResource CaptionLabelBlack}" Text="&#160;" />
                                                                    <Span
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZSAR}"
                                                                        TextColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                    </StackLayout>
                                                </Grid>

                                            </StackLayout>
                                        </Border>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.GroupHeaderTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ViewCell.View>

                                    <custom:CustomLabel Style="{StaticResource SectionTitleBlack}" Text="{Binding Key}" />

                                </ViewCell.View>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.GroupHeaderTemplate>
                    <ListView.Footer>
                        <Grid>
                            <StackLayout IsVisible="{Binding IsNotHaveStatements}">
                                <custom:CustomLabel
                                    Margin="0,50,0,0"
                                    HorizontalOptions="Center"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ASNoFinancialTransactions}"
                                    VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>
                    </ListView.Footer>
                    <ListView.Header>
                        <StackLayout
                            Grid.Row="0"
                            FlowDirection="RightToLeft"
                            Orientation="Vertical"
                            Spacing="-5">

                            <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                <custom:CustomLabel Style="{StaticResource SectionTitleBlack}" Text="{Binding SelectedTransactionTypeFilter.Txt30, Mode=OneWay}">
                                    <custom:CustomLabel.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btnTransactionTypePicker_Clicked" />
                                    </custom:CustomLabel.GestureRecognizers>
                                </custom:CustomLabel>

                                <Image
                                    Margin="0,5,0,0"
                                    HorizontalOptions="Start"
                                    Source="arrowDropdown"
                                    VerticalOptions="Center">

                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btnTransactionTypePicker_Clicked" />
                                    </Image.GestureRecognizers>

                                </Image>
                                <!--  {Binding IsDownloadBtnVisile}  -->
                                <Image
                                    Margin="5,5,5,0"
                                    HorizontalOptions="EndAndExpand"
                                    IsVisible="False"
                                    Source="download"
                                    VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DownloadBtnTapped}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                            <syncfusion:SfPicker
                                x:Name="TransactionTypePicker"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="10,0,10,0"
                                Background="White"
                                ItemHeight="40"
                                Mode="Dialog"
                                SelectionChanged="TransactionTypePicker_SelectionChanged">

                                <syncfusion:SfPicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{StaticResource NeutralBlack}" />
                                </syncfusion:SfPicker.SelectedTextStyle>

                                <syncfusion:SfPicker.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralGreay}" />
                                </syncfusion:SfPicker.TextStyle>

                                <syncfusion:SfPicker.Columns>
                                    <syncfusion:PickerColumn
                                        Width="300"
                                        DisplayMemberPath="Txt30"
                                        ItemsSource="{Binding TransactionTypeFilter}" />
                                </syncfusion:SfPicker.Columns>

                                <syncfusion:SfPicker.ColumnHeaderView>
                                    <syncfusion:PickerColumnHeaderView Height="46" />
                                </syncfusion:SfPicker.ColumnHeaderView>

                                <syncfusion:SfPicker.HeaderView>

                                    <syncfusion:PickerHeaderView
                                        Height="55"
                                        Background="{StaticResource Primary}"
                                        Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerHeaderView.TextStyle>
                                    </syncfusion:PickerHeaderView>

                                </syncfusion:SfPicker.HeaderView>

                                <syncfusion:SfPicker.FooterView>

                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </syncfusion:SfPicker.FooterView>

                                <syncfusion:SfPicker.Behaviors>
                                    <behaviors:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                            </syncfusion:SfPicker>

                            <!--  {Binding IsYearsChipVisible}  -->
                            <ScrollView
                                HorizontalOptions="Start"
                                HorizontalScrollBarVisibility="Never"
                                IsVisible="{Binding IsYearsChipVisible}"
                                Orientation="Horizontal">
                                <chips:SfChipGroup
                                    x:Name="ChipGroup_Years"
                                    Margin="0,10,0,0"
                                    ChipBackground="Transparent"
                                    ChipStroke="{StaticResource NeutralLightGrey}"
                                    ChipStrokeThickness="1"
                                    ChipType="Choice"
                                    HorizontalOptions="Start"
                                    ItemsSource="{Binding ChipDataFilterlistForYears}"
                                    SelectedChipBackground="{StaticResource PartialBg}"
                                    SelectionChanged="yearChipGroup_SelectionChanged"
                                    VerticalOptions="Center">
                                    <chips:SfChipGroup.ItemTemplate>
                                        <DataTemplate>
                                            <StackLayout
                                                Margin="0"
                                                Padding="5,-2,5,-2"
                                                Orientation="Horizontal"
                                                Spacing="2">
                                                <Image
                                                    HeightRequest="25"
                                                    HorizontalOptions="Center"
                                                    Source="{Binding ImageSource}" />
                                                <custom:CustomLabel
                                                    HorizontalOptions="CenterAndExpand"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding Text}" />
                                            </StackLayout>
                                        </DataTemplate>
                                    </chips:SfChipGroup.ItemTemplate>
                                </chips:SfChipGroup>
                            </ScrollView>

                            <!--  Status Chips  -->


                            <Grid Margin="0,15,0,0" VerticalOptions="Start">
                                <CollectionView
                                    HeightRequest="50"
                                    HorizontalOptions="StartAndExpand"
                                    ItemsLayout="HorizontalList"
                                    ItemsSource="{Binding ChipDataFilterlistForStatus}"
                                    SelectionMode="None"
                                    VerticalOptions="Start">

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>

                                            <StackLayout Margin="5">
                                                <Grid Margin="5,0,5,0">
                                                    <Frame
                                                        Grid.Row="0"
                                                        Padding="10,10,10,10"
                                                        BackgroundColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}"
                                                        CornerRadius="14"
                                                        HasShadow="False"
                                                        HeightRequest="20"
                                                        HorizontalOptions="FillAndExpand"
                                                        Opacity=".2"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <StackLayout Grid.Row="0" Padding="10,0,10,0">
                                                        <!--  TextColor="{Binding Status,Converter={StaticResource StringToColorConvertor}}"  -->
                                                        <custom:CustomLabel
                                                            HorizontalOptions="CenterAndExpand"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            Text="{Binding StatusDesc}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>

                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="ChipsData_Tapped" />
                                                    </Grid.GestureRecognizers>


                                                </Grid>
                                            </StackLayout>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>

                            <!--  {Binding IsSortByVisible}  -->
                            <Grid
                                x:Name="SortByStackLayout"
                                Margin="0,15,0,0"
                                ColumnSpacing="25"
                                IsVisible="False"
                                RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ScrollView
                                    Grid.Column="1"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalScrollBarVisibility="Never"
                                    Orientation="Horizontal">
                                    <StackLayout Orientation="Horizontal">
                                        <buttons:SfButton
                                            x:Name="Button_TransactionTypeFilter"
                                            Background="White"
                                            Clicked="Button_TransactionTypeFilter_Clicked"
                                            CornerRadius="20"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Start"
                                            ImageSource="ic_unpaid"
                                            ShowIcon="True"
                                            Stroke="LightGray"
                                            StrokeThickness="1"
                                            Style="{StaticResource CaptionButtonBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ASTransactionDate}"
                                            VerticalTextAlignment="Center">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding TransactionDateFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="">
                                                    <!--<Setter Property="ImageSource" Value="" />-->
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding TransactionDateFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding TransactionDateFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton
                                            x:Name="Button_TaxPeriodFilter"
                                            Background="White"
                                            Clicked="Button_TaxPeriodFilter_Clicked"
                                            CornerRadius="20"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Start"
                                            ImageSource="ic_unpaid"
                                            ShowIcon="True"
                                            Stroke="LightGray"
                                            StrokeThickness="1"
                                            Style="{StaticResource CaptionButtonBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ASTaxperiod}"
                                            VerticalTextAlignment="Center">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding TaxperiodFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="">
                                                    <!--<Setter Property="ImageSource" Value="" />-->
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding TaxperiodFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding TaxperiodFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton
                                            x:Name="Button_DueDateFilter"
                                            Background="White"
                                            Clicked="Button_DueDateFilter_Clicked"
                                            CornerRadius="20"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Start"
                                            ImageSource="ic_unpaid"
                                            ShowIcon="True"
                                            Stroke="LightGray"
                                            StrokeThickness="1"
                                            Style="{StaticResource CaptionButtonBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ASDueDate}"
                                            VerticalTextAlignment="Center">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding DueDateFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="">
                                                    <!--<Setter Property="ImageSource" Value="" />-->
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding DueDateFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding DueDateFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton
                                            x:Name="Button_BillDiscriptionFilter"
                                            Background="White"
                                            Clicked="Button_BillDiscriptionFilter_Clicked"
                                            CornerRadius="20"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Start"
                                            ImageSource="ic_unpaid"
                                            ShowIcon="True"
                                            Stroke="LightGray"
                                            StrokeThickness="1"
                                            Style="{StaticResource CaptionButtonBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ASBillDescription}"
                                            VerticalTextAlignment="Center">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding BillDescriptionFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="">
                                                    <!--<Setter Property="ImageSource" Value="" />-->
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding BillDescriptionFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding BillDescriptionFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                        <buttons:SfButton
                                            x:Name="Button_BillAmountFilter"
                                            Background="White"
                                            Clicked="Button_BillAmountFilter_Clicked"
                                            CornerRadius="20"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Start"
                                            ImageSource="ic_unpaid"
                                            ShowIcon="True"
                                            Stroke="LightGray"
                                            StrokeThickness="1"
                                            Style="{StaticResource CaptionButtonBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ASBillAmount}"
                                            VerticalTextAlignment="Center">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding BillAmountFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="">
                                                    <!--<Setter Property="ImageSource" Value="" />-->
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="ShowIcon" Value="False" />

                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding BillAmountFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="ascending">
                                                    <Setter Property="ImageSource" Value="ArrowUp" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding BillAmountFilterItem}"
                                                    TargetType="buttons:SfButton"
                                                    Value="descending">
                                                    <Setter Property="ImageSource" Value="Entry_DropDown" />
                                                    <Setter Property="Background" Value="{StaticResource PartialBg}" />
                                                    <Setter Property="ShowIcon" Value="True" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>
                                    </StackLayout>
                                </ScrollView>
                                <StackLayout
                                    Grid.Column="0"
                                    BackgroundColor="White"
                                    HorizontalOptions="Start">
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        VerticalOptions="CenterAndExpand">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.SortBy}" />
                                                <Span Text=":" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                </StackLayout>
                            </Grid>

                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{Binding AmountLabel}" />

                            <StackLayout Margin="10">
                                <Border
                                    Margin="0,10,0,10"
                                    IsVisible="false"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0" Spacing="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.TotalOpeningBalance}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>

                                            <yummy:PancakeView
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="10,10,10,10"
                                                BackgroundColor="{StaticResource Primary}"
                                                CornerRadius="14"
                                                HeightRequest="20"
                                                HorizontalOptions="End"
                                                Opacity=".2"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="110">
                                                <yummy:PancakeView.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsOpeningBalancePositive}"
                                                        TargetType="yummy:PancakeView"
                                                        Value="true">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsOpeningBalancePositive}"
                                                        TargetType="yummy:PancakeView"
                                                        Value="false">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}" />
                                                    </DataTrigger>
                                                </yummy:PancakeView.Triggers>
                                                <yummy:PancakeView.Border>
                                                    <yummy:Border Thickness="1" />
                                                </yummy:PancakeView.Border>
                                            </yummy:PancakeView>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,0,0,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalOptions="FillAndExpand">
                                                <custom:CustomLabel
                                                    HorizontalOptions="EndAndExpand"
                                                    LineBreakMode="WordWrap"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    TextColor="{StaticResource NewDarkGreenColor}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding HeaderSet.D.OpeningAmount}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                    <custom:CustomLabel.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsOpeningBalancePositive}"
                                                            TargetType="custom:CustomLabel"
                                                            Value="true">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding IsOpeningBalancePositive}"
                                                            TargetType="custom:CustomLabel"
                                                            Value="false">
                                                            <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                        </DataTrigger>
                                                    </custom:CustomLabel.Triggers>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel
                                                    HorizontalOptions="CenterAndExpand"
                                                    LineBreakMode="WordWrap"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    TextColor="{StaticResource NewDarkGreenColor}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                    <custom:CustomLabel.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsOpeningBalancePositive}"
                                                            TargetType="custom:CustomLabel"
                                                            Value="true">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding IsOpeningBalancePositive}"
                                                            TargetType="custom:CustomLabel"
                                                            Value="false">
                                                            <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                        </DataTrigger>
                                                    </custom:CustomLabel.Triggers>
                                                </custom:CustomLabel>

                                            </StackLayout>

                                        </Grid>
                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <Grid Padding="0">
                                        <Frame
                                            BackgroundColor="{Binding TotalBalanceBackground}"
                                            HorizontalOptions="FillAndExpand"
                                            Opacity="0.2"
                                            VerticalOptions="FillAndExpand" />
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-10">
                                                <Label
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.AccountStatementTotalBalance}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">


                                                <!--<custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}"
                                                                            TextColor="{Binding TotalBalanceBackground}"   HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" >
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding HeaderSet.D.CloseAmount,Converter={StaticResource commaSeparatorConverter}}" TextColor="{Binding TotalBalanceBackground}" Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                                    <Span Text="&#160;" Style="{StaticResource CaptionLabelBlack}" ></Span>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR} " TextColor="{Binding TotalBalanceBackground}"  Style="{StaticResource SectionTitleBlackBold}" ></Span>
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                   </custom:CustomLabel>-->


                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{Binding HeaderSet.D.CloseAmount}"
                                                    TextColor="{Binding TotalBalanceBackground}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusDesc}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>

                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackLayout>

                            <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal" />
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{Binding AmountLabel}" />
                        </StackLayout>
                    </ListView.Header>
                </ListView>
            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            SizeFactor="0.7" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
