<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementsFiltersPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView
        Padding="10,10,10,10"
        BackgroundColor="White"
        CornerRadius="15,15,0,0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <StackLayout VerticalOptions="Center">
            <listView:SfListView
                x:Name="Bills"
                AutoFitMode="Height"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                IsVisible="true"
                ItemsSource="{Binding FilterList}"
                ScrollBarVisibility="Never"
                VerticalOptions="FillAndExpand">
                <listView:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5,0,5" Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0" Spacing="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="5">
                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding FilterHeader}" />
                                        <Label
                                            Margin="20,0,20,0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="Sort Ascending"
                                            VerticalOptions="CenterAndExpand">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="SortAscending_Tapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label
                                            Margin="20,0,20,0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="Sort Descending"
                                            VerticalOptions="CenterAndExpand">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="SortDescending_Tapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>
                                </Grid>
                                <BoxView
                                    BackgroundColor="LightGray"
                                    HeightRequest="1"
                                    HorizontalOptions="FillAndExpand" />
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </listView:SfListView.ItemTemplate>
            </listView:SfListView>
            <buttons:SfButton
                x:Name="btnprimary"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                VerticalOptions="CenterAndExpand" />
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>

