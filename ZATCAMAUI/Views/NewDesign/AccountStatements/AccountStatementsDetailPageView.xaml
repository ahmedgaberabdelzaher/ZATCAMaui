<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementsDetailPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sfconverters="clr-namespace:ZATCAMAUI.Core.Converters.SyncFusionEnabledConverters"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">


    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <sfconverters:StringToColorConvertor x:Key="StringToColorConvertor" />
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        StrokeShape="RoundRectangle 15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="Large"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ASStatementDetails}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="backButton_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>


                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>



        <StackLayout>
            <Border Margin="10" Style="{StaticResource GreyBorderFrameWithShadow}">
                <StackLayout Padding="0" Spacing="0">
                    <Grid Padding="15" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="0">
                            <Label
                                x:Name="LableCardTitle"
                                Style="{StaticResource SectionTitleSmallMediumBlack}"
                                VerticalOptions="CenterAndExpand" />

                            <StackLayout Orientation="Horizontal">
                                <Label
                                    x:Name="LableFbNum"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                        </StackLayout>
                        <Border
                            x:Name="FrameCardStatus"
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="10,10,10,10"
                            BackgroundColor="{Binding Status, Converter={StaticResource StringToColorConvertor}}"
                            StrokeShape="RoundRectangle 14,14,14,14"
                            HeightRequest="20"
                            HorizontalOptions="FillAndExpand"
                            Opacity=".2"
                            VerticalOptions="CenterAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="10,0,10,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Label
                                x:Name="LableCardStatus"
                                HorizontalOptions="CenterAndExpand"
                                Style="{StaticResource CaptionLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                        <BoxView
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,5"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,5">
                            <Label
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ASSadadBillNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                x:Name="LableSadadNum"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>

                        <!--<StackLayout Grid.Row="2" Grid.Column="1" Margin="0,5">
                            <Label Text="{x:Static ResourceManager:AppResources.ASTransactionDate}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                            <Label x:Name="LableTransactionDate"  Margin="0,-10" Style="{StaticResource SectionTitleSmallMediumBlack}" VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"></Label>
                        </StackLayout>-->
                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,5">
                            <Label
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                x:Name="LableDueDate"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>


                        <StackLayout
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="0,5">
                            <Label
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryTaxPeriod}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                x:Name="LableTaxPeriod"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>


                    </Grid>

                </StackLayout>
            </Border>

            <StackLayout>
                <StackLayout
                    x:Name="TaxTypeGrid"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Border
                        Margin="1"
                        HorizontalOptions="FillAndExpand"
                        Style="{StaticResource GreyBorderFrameWithShadow}"
                        VerticalOptions="FillAndExpand">

                        <Grid
                            Margin="0"
                            Padding="0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="StartAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="TaxTypeDesc"
                                Grid.Row="0"
                                StrokeShape="RoundRectangle 8,8,8,8"
                                HorizontalOptions="FillAndExpand"
                                Opacity=".2"
                                VerticalOptions="FillAndExpand" />
                            <StackLayout
                                Grid.Row="0"
                                Padding="10"
                                VerticalOptions="FillAndExpand">
                                <Label
                                    x:Name="LableTaxType"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text=""
                                    VerticalOptions="CenterAndExpand" />

                            </StackLayout>
                        </Grid>
                    </Border>
                </StackLayout>
                <Grid
                    Margin="0"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="CardAmount"
                        Grid.Row="0"
                        StrokeShape="RoundRectangle 20,20,20,20"
                        HorizontalOptions="FillAndExpand"
                        Opacity=".2" />
                    <StackLayout
                        Grid.Row="0"
                        Padding="10"
                        Orientation="Horizontal">
                        <Label
                            x:Name="LableAmountTitle"
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource BodyLabelBlack}"
                            VerticalOptions="CenterAndExpand" />
                        <Label
                            x:Name="LableAmount"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            Text=""
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </Grid>

                <Grid
                    x:Name="GridAmountRemaining"
                    Margin="0"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="False"
                    VerticalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="CardAmountRemaining"
                        Grid.Row="0"
                        StrokeShape="RoundRectangle 20,20,20,20"
                        HorizontalOptions="FillAndExpand"
                        Opacity=".2" />
                    <StackLayout
                        Grid.Row="0"
                        Padding="10"
                        Orientation="Horizontal">
                        <Label
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource BodyLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.MyBillsRemainingAmount}"
                            VerticalOptions="CenterAndExpand" />
                        <Label
                            x:Name="RemainingAmount"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            Text=""
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </Grid>
            </StackLayout>
        </StackLayout>


    </ContentPage.Content>
</ContentPage>