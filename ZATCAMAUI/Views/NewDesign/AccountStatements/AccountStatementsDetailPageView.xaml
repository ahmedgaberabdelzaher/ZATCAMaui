<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementsDetailPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">


    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ASStatementDetails}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <StackLayout Grid.Row="1">

                <Border Margin="10" Style="{StaticResource GreyBorderFrameWithShadow}">

                    <Grid Padding="15" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="0">
                            <Label
                                x:Name="LableCardTitle"
                                Style="{StaticResource SectionTitleSmallMediumBlack}"
                                VerticalOptions="CenterAndExpand" />

                            <Label
                                x:Name="LableFbNum"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                        <Border
                            x:Name="FrameCardStatus"
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="10,10,10,10"
                            BackgroundColor="{Binding StatusBackGcolor}"
                            HeightRequest="20"
                            HorizontalOptions="FillAndExpand"
                            Opacity=".2"
                            StrokeShape="RoundRectangle 14,14,14,14"
                            VerticalOptions="CenterAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="10,0,10,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Label
                                x:Name="LableCardStatus"
                                HorizontalOptions="CenterAndExpand"
                                Style="{StaticResource CaptionLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                        <BoxView
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,5"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,5">
                            <Label
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ASSadadBillNumber}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                x:Name="LableSadadNum"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>

                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,5">
                            <Label
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                x:Name="LableDueDate"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>


                        <StackLayout
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="0,5">
                            <Label
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryTaxPeriod}"
                                VerticalOptions="CenterAndExpand" />
                            <Label
                                x:Name="LableTaxPeriod"
                                Margin="0,-10"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>


                    </Grid>

                </Border>

                <Border
                    x:Name="TaxTypeGrid"
                    Margin="1"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource GreyBorderFrameWithShadow}"
                    VerticalOptions="FillAndExpand">

                    <Grid
                        Margin="0"
                        Padding="0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="StartAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="TaxTypeDesc"
                            Grid.Row="0"
                            HorizontalOptions="FillAndExpand"
                            Opacity=".2"
                            StrokeShape="RoundRectangle 8,8,8,8"
                            VerticalOptions="FillAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Padding="10"
                            VerticalOptions="FillAndExpand">
                            <Label
                                x:Name="LableTaxType"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelBlack}"
                                Text=""
                                VerticalOptions="CenterAndExpand" />

                        </StackLayout>
                    </Grid>
                </Border>

                <Grid
                    Margin="0"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    RowDefinitions="auto"
                    VerticalOptions="StartAndExpand">

                    <Border
                        x:Name="CardAmount"
                        Grid.Row="0"
                        HorizontalOptions="FillAndExpand"
                        Opacity=".2"
                        StrokeShape="RoundRectangle 20,20,20,20" />

                    <StackLayout
                        Grid.Row="0"
                        Padding="10"
                        Orientation="Horizontal">

                        <Label
                            x:Name="LableAmountTitle"
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource BodyLabelBlack}"
                            VerticalOptions="CenterAndExpand" />

                        <Label
                            x:Name="LableAmount"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            VerticalOptions="CenterAndExpand" />

                    </StackLayout>

                </Grid>

                <Grid
                    x:Name="GridAmountRemaining"
                    Margin="0"
                    Padding="10"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="False"
                    RowDefinitions="auto"
                    VerticalOptions="StartAndExpand">

                    <Border
                        x:Name="CardAmountRemaining"
                        Grid.Row="0"
                        HorizontalOptions="FillAndExpand"
                        Opacity=".2"
                        StrokeShape="RoundRectangle 20,20,20,20" />

                    <StackLayout
                        Grid.Row="0"
                        Padding="10"
                        Orientation="Horizontal">

                        <Label
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource BodyLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.MyBillsRemainingAmount}"
                            VerticalOptions="CenterAndExpand" />

                        <Label
                            x:Name="RemainingAmount"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            VerticalOptions="CenterAndExpand" />

                    </StackLayout>

                </Grid>

                <Border
                    x:Name="ReturnDetails"
                    Margin="0,10,0,10"
                    IsVisible="{Binding isReturnsVisible}"
                    Stroke="{StaticResource Secondary}"
                    Style="{StaticResource GreyBorderFrameWithShadow}">

                    <Grid ColumnDefinitions="80*,20*">

                        <Label
                            Grid.Column="0"
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource GAZTSmallBlackLabel}"
                            Text="{x:Static ResourceManager:AppResources.retDetails}"
                            VerticalOptions="CenterAndExpand" />

                        <Image Grid.Column="1" Source="arrowRight">

                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapCommand}" CommandParameter="ReturnDetails" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>

                </Border>

                <Border
                    x:Name="ObjectionDetails"
                    Margin="0,10,0,10"
                    IsVisible="{Binding isObjectionDetailsVisible}"
                    Stroke="{StaticResource Secondary}"
                    Style="{StaticResource GreyBorderFrameWithShadow}">

                    <Grid ColumnDefinitions="80*,20*">

                        <Label
                            Grid.Column="0"
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource GAZTSmallBlackLabel}"
                            Text="{x:Static ResourceManager:AppResources.ObjDetails}"
                            VerticalOptions="CenterAndExpand" />

                        <Image Grid.Column="1" Source="arrowRight">

                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapCommand}" CommandParameter="ObjDetails" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Border>

                <Border
                    x:Name="ISTPlanDetails"
                    Margin="0,10,0,10"
                    IsVisible="{Binding isBIllDetialsVisble}"
                    Stroke="{StaticResource Secondary}"
                    Style="{StaticResource GreyBorderFrameWithShadow}">

                    <Grid ColumnDefinitions="80*,20*">

                        <Label
                            Grid.Column="0"
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource GAZTSmallBlackLabel}"
                            Text="{x:Static ResourceManager:AppResources.InstalmentDetails}"
                            VerticalOptions="CenterAndExpand" />

                        <Image Grid.Column="1" Source="arrowRight">

                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapCommand}" CommandParameter="InstDetails" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Border>

                <Border
                    x:Name="InstPlanOBDetials"
                    Margin="0,10,0,10"
                    IsVisible="{Binding isInstalmentDetailsVisible}"
                    Stroke="{StaticResource Secondary}"
                    Style="{StaticResource GreyBorderFrameWithShadow}">

                    <Grid ColumnDefinitions="80*,20*">

                        <Label
                            Grid.Column="0"
                            FontSize="15"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource GAZTSmallBlackLabel}"
                            Text="{x:Static ResourceManager:AppResources.InstalmentObjDetails}"
                            VerticalOptions="CenterAndExpand" />

                        <Image Grid.Column="1" Source="arrowRight">

                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapCommand}" CommandParameter="InstObjeORdetails" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Border>

            </StackLayout>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>