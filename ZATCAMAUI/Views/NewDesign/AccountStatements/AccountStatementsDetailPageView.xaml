<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.AccountStatements.AccountStatementsDetailPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ASStatementDetails}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">
                <Grid RowDefinitions="auto,auto">

                    <Border Grid.Row="0" Margin="10" Style="{StaticResource GreyBorderFrameWithShadow}">

                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <StackLayout
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     Spacing="0">
                                <Label
                                     x:Name="LableCardTitle"
                                     Style="{StaticResource SectionTitleSmallMediumBlack}"
                                     VerticalOptions="CenterAndExpand" />

                                <Label
                                     x:Name="LableFbNum"
                                     HorizontalOptions="StartAndExpand"
                                     Style="{StaticResource CaptionLabelGrey}"
                                     VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                            <Border
                                     x:Name="FrameCardStatus"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Padding="10,10,10,10"
                                     BackgroundColor="{Binding StatusBackGcolor}"
                                     HeightRequest="20"
                                     HorizontalOptions="FillAndExpand"
                                     Opacity=".2"
                                     StrokeShape="RoundRectangle 14,14,14,14"
                                     VerticalOptions="CenterAndExpand" />
                            <StackLayout
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Padding="10,0,10,0"
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand">

                                <Label
                                     x:Name="LableCardStatus"
                                     HorizontalOptions="CenterAndExpand"
                                     Style="{StaticResource CaptionLabelBlack}"
                                     VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                            <BoxView
                                     Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Margin="0,5"
                                     Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            <StackLayout
                                     Grid.Row="2"
                                     Grid.Column="0"
                                     Margin="0,5">
                                <Label
                                     HorizontalOptions="FillAndExpand"
                                     Style="{StaticResource CaptionLabelGrey}"
                                     Text="{x:Static ResourceManager:AppResources.ASSadadBillNumber}"
                                     VerticalOptions="CenterAndExpand" />
                                <Label
                                     x:Name="LableSadadNum"
                                     Margin="0,10"
                                     HorizontalOptions="FillAndExpand"
                                     Style="{StaticResource ValueLabelBlack}"
                                     VerticalOptions="CenterAndExpand" />
                            </StackLayout>

                            <StackLayout
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="0,5">
                                <Label
                                     HorizontalOptions="FillAndExpand"
                                     Style="{StaticResource CaptionLabelGrey}"
                                     Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}"
                                     VerticalOptions="CenterAndExpand" />
                                <Label
                                     x:Name="LableDueDate"
                                     Margin="0,10"
                                     HorizontalOptions="FillAndExpand"
                                     Style="{StaticResource ValueLabelBlack}"
                                     VerticalOptions="CenterAndExpand" />
                            </StackLayout>


                            <StackLayout
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Margin="0,5">
                                <Label
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryTaxPeriod}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    x:Name="LableTaxPeriod"
                                    Margin="0,10"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource ValueLabelBlack}"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>


                        </Grid>

                    </Border>
                    <Grid
                        Grid.Row="1"
                        RowDefinitions="auto,auto,auto">
                        <StackLayout
                             Grid.Row="0"
                             Padding="15"
                             VerticalOptions="FillAndExpand">
                            <Label
                                x:Name="LableTaxType"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                Text=""/>
                        </StackLayout>
                        <Grid
                            Grid.Row="1"
                            Margin="0"
                            Padding="10"
                            HorizontalOptions="FillAndExpand"
                            RowDefinitions="auto"
                            VerticalOptions="StartAndExpand">

                            <Border
                            x:Name="CardAmount"
                            Grid.Row="0"
                            HorizontalOptions="FillAndExpand"
                            Opacity=".2"
                            StrokeShape="RoundRectangle 20,20,20,20" />

                            <StackLayout
                            Grid.Row="0"
                            Padding="10"
                            Orientation="Horizontal">

                                <Label
                               x:Name="LableAmountTitle"
                               FontSize="15"
                               HorizontalOptions="FillAndExpand"
                               Style="{StaticResource BodyLabelBlack}"
                               VerticalOptions="CenterAndExpand" />

                                <Label
                               x:Name="LableAmount"
                               HorizontalOptions="EndAndExpand"
                               Style="{StaticResource SectionTitleBlackBold}"
                               VerticalOptions="CenterAndExpand" />

                            </StackLayout>

                        </Grid>

                        <Grid
                            Grid.Row="2"
                            x:Name="GridAmountRemaining"
                            Margin="0"
                            Padding="10"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="False"
                            RowDefinitions="auto"
                            VerticalOptions="StartAndExpand">

                            <Border
                           x:Name="CardAmountRemaining"
                           Grid.Row="0"
                           HorizontalOptions="FillAndExpand"
                           Opacity=".2"
                           StrokeShape="RoundRectangle 20,20,20,20" />

                            <StackLayout
                             Grid.Row="0"
                             Padding="10"
                             Orientation="Horizontal">

                                <Label
                                 FontSize="15"
                                 HorizontalOptions="FillAndExpand"
                                 Style="{StaticResource BodyLabelBlack}"
                                 Text="{x:Static ResourceManager:AppResources.MyBillsRemainingAmount}"
                                 VerticalOptions="CenterAndExpand" />

                                <Label
                                 x:Name="RemainingAmount"
                                 HorizontalOptions="EndAndExpand"
                                 Style="{StaticResource SectionTitleBlackBold}"
                                 VerticalOptions="CenterAndExpand" />

                            </StackLayout>

                        </Grid>
                    </Grid>



                </Grid>

            </Border>

        </Grid>

    </ContentPage.Content>
</ContentPage>