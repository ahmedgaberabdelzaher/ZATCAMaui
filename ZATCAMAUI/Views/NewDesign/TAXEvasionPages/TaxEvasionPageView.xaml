<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TAXEvasionPages.TaxEvasionPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1">
                        <StackLayout>
                            <Border Margin="0,0,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="15,10,15,10"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image Source="ic_add_plus.png" />
                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="Tax Evasion Report" />
                                </StackLayout>
                            </Border>
                            <!--  CARD One Start  -->
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0" Spacing="0">
                                    <StackLayout Padding="17,16,17,16" Orientation="Horizontal">
                                        <StackLayout Spacing="-10">
                                            <Label Style="{StaticResource SectionTitleBlackBold}" Text="Zayad Corporation" />
                                            <Label
                                                FontSize="Small"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="00894790088"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                            <buttons:SfButton
                                                Padding="12,0,12,0"
                                                Background="{StaticResource LightGreenColor}"
                                                CornerRadius="15"
                                                HeightRequest="32"
                                                Text="Open"
                                                TextColor="{StaticResource Primary}" />
                                        </StackLayout>
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout Padding="17,16,17,16" Spacing="0">
                                        <Label
                                            FontSize="Small"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="Report Date"
                                            VerticalOptions="CenterAndExpand" />
                                        <Label
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="06th May 2020"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                            <!--  CARD One End  -->

                            <!--  CARD Two Starts  -->
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0" Spacing="0">
                                    <StackLayout Padding="17,16,17,16" Orientation="Horizontal">
                                        <StackLayout Spacing="-10">
                                            <Label Style="{StaticResource SectionTitleBlackBold}" Text="Zayad Corporation" />
                                            <Label
                                                FontSize="Small"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="00894790088"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                            <buttons:SfButton
                                                Padding="12,0,12,0"
                                                Background="Maroon"
                                                CornerRadius="15"
                                                HeightRequest="32"
                                                Text="Closed"
                                                TextColor="{StaticResource Secondary}" />
                                        </StackLayout>
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout Padding="17,16,17,16" Spacing="0">
                                        <Label
                                            FontSize="Small"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="Report Date"
                                            VerticalOptions="CenterAndExpand" />
                                        <Label
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="06th May 2020"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                            <!--  CARD Two Ends  -->
                        </StackLayout>
                    </ScrollView>

                    <StackLayout
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        BackgroundColor="White">
                        <Label Style="{StaticResource PageTitleBlack}" Text="My Reports" />
                        <StackLayout Orientation="Horizontal" Spacing="24">
                            <buttons:SfButton
                                Padding="12,0,12,0"
                                Background="White"
                                CornerRadius="15"
                                HeightRequest="32"
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeThickness="1"
                                Style="{StaticResource CaptionButtonBlack}"
                                Text="Open" />
                            <buttons:SfButton
                                Padding="12,0,12,0"
                                Background="White"
                                CornerRadius="15"
                                HeightRequest="32"
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeThickness="1"
                                Style="{StaticResource CaptionButtonBlack}"
                                Text="Closed" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Padding="15,10,15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="20*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="Tax Evasion"
                    TextColor="White"
                    VerticalOptions="Center" />
                <StackLayout Grid.Column="0">
                    <Image
                        HorizontalOptions="Start"
                        Source="arrowLeftwhite"
                        VerticalOptions="CenterAndExpand" />
                </StackLayout>

                <StackLayout Grid.Column="2">
                    <Image
                        HorizontalOptions="End"
                        Source="search"
                        VerticalOptions="CenterAndExpand" />
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>