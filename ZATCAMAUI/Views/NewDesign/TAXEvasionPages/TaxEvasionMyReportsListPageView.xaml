<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TAXEvasionPages.TaxEvasionMyReportsListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasBackButton="False"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="15*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.NDTaxEvasion}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <Border
                        Padding="0"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid Margin="10,15,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackLayout Grid.Row="1" Margin="0,0,0,0">
                    <ListView
                        x:Name="ListView_TaxEvasionReportList"
                        BackgroundColor="White"
                        HasUnevenRows="True"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsReportListVisible}"
                        ItemTapped="ListView_TaxEvasionReportList_ItemTapped"
                        ItemsSource="{Binding ListToDisplay, Mode=TwoWay}"
                        SelectedItem="{Binding SelectedTaxEvasionListItem}"
                        SeparatorVisibility="None"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <x:Arguments>
                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                        </x:Arguments>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0" Spacing="0">
                                            <StackLayout Padding="17,16,17,16" Orientation="Horizontal">
                                                <StackLayout Spacing="-10">
                                                    <Label Style="{StaticResource SectionTitleBlackBold}" Text="{Binding CompanyName}" />
                                                    <Label
                                                        FontSize="Small"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{Binding TicketId}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                                    <buttons:SfButton
                                                        Padding="12,0,12,0"
                                                        CornerRadius="15"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HeightRequest="32"
                                                        Text="{Binding Status}">
                                                        <buttons:SfButton.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                TargetType="buttons:SfButton"
                                                                Value="{x:Static ResourceManager:AppResources.ZTEReportReportOpen}">
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                                <Setter Property="Background" Value="{StaticResource BackgroundGray}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                TargetType="buttons:SfButton"
                                                                Value="{x:Static ResourceManager:AppResources.ZTEReportStatusCompleted}">
                                                                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                                                <Setter Property="Background" Value="{StaticResource ChipPaidColor}" />
                                                            </DataTrigger>
                                                        </buttons:SfButton.Triggers>
                                                    </buttons:SfButton>
                                                </StackLayout>
                                            </StackLayout>

                                            <BoxView
                                                BackgroundColor="LightGray"
                                                HeightRequest="1"
                                                HorizontalOptions="FillAndExpand" />

                                            <StackLayout Padding="17,16,17,16" Spacing="0">
                                                <Label
                                                    FontSize="Small"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZTEReportReportDate}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <StackLayout HorizontalOptions="Start">
                                                    <Label
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding CreatedAt}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                            </StackLayout>
                                        </StackLayout>
                                    </Border>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Label
                        Margin="0,20,0,0"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsNoReportLabelVisible}"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NoReportsAvailable}"
                        VerticalOptions="Center" />
                </StackLayout>
                <StackLayout
                    Grid.Row="0"
                    Padding="0,0,0,0"
                    BackgroundColor="White">
                    <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.NDMyReports}" />
                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                        <busyindicator:SfChipGroup
                            x:Name="ChipGroup_statusFilter"
                            Margin="0,10,0,0"
                            ChipBackground="Transparent"
                            ChipStroke="{StaticResource NeutralLightGrey}"
                            ChipStrokeThickness="1"
                            ChipType="Filter"
                            HorizontalOptions="Start"
                            ItemsSource="{Binding ChipDataFilterlist}"
                            SelectedChipBackground="{StaticResource PartialBg}"
                            SelectedChipTextColor="{StaticResource Secondary}"
                            SelectionChanging="ChipGroup_statusFilter_SelectionChanging"
                            VerticalOptions="Center">
                            <busyindicator:SfChipGroup.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout
                                        Margin="0"
                                        Padding="5,-2,5,-2"
                                        HorizontalOptions="StartAndExpand"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <Label
                                            HorizontalOptions="Center"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{Binding Text}" />
                                    </StackLayout>
                                </DataTemplate>
                            </busyindicator:SfChipGroup.ItemTemplate>
                        </busyindicator:SfChipGroup>
                    </ScrollView>
                    <StackLayout>
                        <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout
                                Padding="15,10,15,10"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Image Source="ic_add_plus.png" />
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelPrimary}"
                                    Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}" />
                            </StackLayout>
                        </Border>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AddReport_Tapped" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>

                </StackLayout>
            </Grid>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>
