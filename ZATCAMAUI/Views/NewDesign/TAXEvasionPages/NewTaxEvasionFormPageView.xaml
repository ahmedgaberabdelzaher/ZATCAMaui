                                                Grid.Row="4"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TxtReportDetailCity}" />

                                            <custom:CustomLabel
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionDistrict}" />
                                            <custom:CustomLabel
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TFDAdress}" />

                                            <custom:CustomLabel
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}"
                                                WidthRequest="50" />
                                            <custom:CustomLabel
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TFSAddress}" />
                                        </Grid>

                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>
                                        <StackLayout Padding="16" Orientation="Horizontal">
                                            <Image Source="zakat_details" />
                                            <!--<Frame Style="{StaticResource circleFrame}">



                                            </Frame>-->
                                            <custom:CustomLabel
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportDetails}"
                                                VerticalTextAlignment="Center" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalTextAlignment="Center"
                                                WidthRequest="50">
                                                <custom:CustomLabel.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnEditClicked}" CommandParameter="{x:Static models:NewTaxEvasionTabEnum.ReportDetails}" />
                                                </custom:CustomLabel.GestureRecognizers>
                                            </custom:CustomLabel>
                                        </StackLayout>

                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />

                                        <Grid Padding="15" RowSpacing="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportType}" />
                                            <StackLayout Grid.Row="0" Grid.Column="1">
                                                <custom:CustomLabel
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    StyleId="ValueLabel"
                                                    Text="{Binding TxtReporttype}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportDetails}" />
                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TReportDetail}" />

                                            <custom:CustomLabel
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionAttachments}" />
                                            <!--  Attachment List  -->
                                            <listView:SfListView
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="5"
                                                AutoFitMode="DynamicHeight"
                                                BackgroundColor="White"
                                                HeightRequest="300"
                                                HorizontalOptions="FillAndExpand"
                                                ItemsSource="{Binding UploadedDocumentsListObj}"
                                                SelectionBackground="White"
                                                VerticalOptions="Start">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <inputLayout:SfTextInputLayout
                                                                Margin="0,10,0,0"
                                                                LeadingViewPosition="Inside"
                                                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                                                <inputLayout:SfTextInputLayout.LeadingView>
                                                                    <Image x:Name="Attachment_Tmg" Source="{Binding CorrespondingImageAccoringtoext}" />
                                                                </inputLayout:SfTextInputLayout.LeadingView>
                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="Attachment_Frm"
                                                                    IsReadOnly="True"
                                                                    Style="{StaticResource EntryHeight48}"
                                                                    Text="{Binding FileNameWithExtension}" />
                                                            </inputLayout:SfTextInputLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>

                                        </Grid>

                                    </StackLayout>
                                </Border>
                            </StackLayout>
                        </ScrollView>
                        <!--  End Of Summary  -->

                        <StackLayout
                            Grid.Row="0"
                            Padding="0,0,0,25"
                            BackgroundColor="White">
                            <commonView:PageIndicatorView
                                Grid.Row="1"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}" />

                            <custom:CustomLabel Style="{StaticResource PageTitleBlack}" Text="{Binding PageTitle}" />
                            <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{Binding BodyTitle}" />
                            <BoxView Style="{StaticResource lineSeperator}" />
                        </StackLayout>


                        <StackLayout Grid.Row="2">
                            <buttons:SfButton
                                Command="{Binding OnContinueClicked}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}" />
                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>

                <Grid Grid.Row="0" Padding="15,10,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="60*" />
                        <ColumnDefinition Width="20*" />
                    </Grid.ColumnDefinitions>
                    <custom:CustomLabel
                        Grid.Column="1"
                        HorizontalOptions="CenterAndExpand"
                        Style="{StaticResource SectionTitleBlack}"
                        Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <StackLayout Grid.Column="0">
                        <Image
                            HorizontalOptions="Start"
                            Source="arrowLeftwhite.png"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand" />
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnBackStepClicked}" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>

                    <StackLayout Grid.Column="2">
                        <Image
                            HorizontalOptions="End"
                            Source="close.png"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnGotoReportPageClicked}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                </Grid>
            </Grid>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>