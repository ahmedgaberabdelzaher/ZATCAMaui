<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TAXEvasionPages.NewTaxEvasionFormPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:gmaps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android, UWP">0</On>
            <On Platform="iOS">0,20,0,0</On>
        </OnPlatform>
    </ContentPage.Padding>
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->

            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>

            <Style x:Key="EntryHeight48" TargetType="Entry">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />

                <Setter Property="PlaceholderColor" Value="{StaticResource NeutralGreay}" />
            </Style>

            <Style x:Key="circleFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundGray}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="CornerRadius" Value="50" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
            <converters:NewTaxEvasionTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <yummy:PancakeView
                    Grid.Row="1"
                    Padding="24,32,24,32"
                    Style="{StaticResource CommonTopCurves}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!--  Start Of Reporter Information  -->
                        <ScrollView
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Never"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.ReporterInfo}}"
                            VerticalScrollBarVisibility="Never">
                            <StackLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterName}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,-6,0,-6"
                                    HasError="{Binding IsTnameHasError}"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        IsEnabled="False"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding TName}"
                                        TextChanged="TNameEntry_TextChanged" />
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionMobileNumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmNumber"
                                    ContainerType="Outlined"
                                    FlowDirection="LeftToRight"
                                    HorizontalOptions="FillAndExpand"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:SfTextInputLayout.LeadingView>

                                        <Label
                                            x:Name="mobileNumberPrefix"
                                            Margin="0"
                                            FlowDirection="LeftToRight"
                                            FontSize="Medium"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Text="+966  |"
                                            TextColor="Gray"
                                            VerticalTextAlignment="Center"
                                            WidthRequest="80" />

                                    </inputLayout:SfTextInputLayout.LeadingView>
                                    <Entry
                                        x:Name="TMobNumber"
                                        FlowDirection="LeftToRight"
                                        FontSize="Medium"
                                        HorizontalOptions="FillAndExpand"
                                        IsReadOnly="True"
                                        Keyboard="Telephone"
                                        PlaceholderColor="Gray"
                                        Text="{Binding TMobNumber}"
                                        TextColor="{StaticResource PrimaryColor}" />
                                </inputLayout:SfTextInputLayout>

                                <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterLocation}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterLocation}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,-10,0,0">
                                    <Editor
                                        AutoSize="TextChanges"
                                        IsReadOnly="True"
                                        Text="{Binding RLocation}" />

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image Source="ic_location_Outline.png" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                                <Frame
                                    x:Name="FrmReportLocation"
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    BackgroundColor="White"
                                    Style="{StaticResource GAZTFrameStyleForEntry}">
                                    <gmaps:Map
                                        x:Name="mapView"
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="-12"
                                        HeightRequest="200"
                                        HorizontalOptions="FillAndExpand"
                                        MapClicked="mapView_MapClicked"
                                        MapType="Street"
                                        VerticalOptions="CenterAndExpand" />
                                </Frame>


                            </StackLayout>
                        </ScrollView>
                        <!--  End Of Reporter Information  -->

                        <!--  Facility Information Starts  -->
                        <ScrollView
                            Grid.Row="1"
                            Padding="0,0,0,50"
                            HorizontalScrollBarVisibility="Never"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.FacilityInfo}}"
                            VerticalScrollBarVisibility="Never">
                            <StackLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionFacilityName}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmFName"
                                    Margin="0,-10,0,0"
                                    HasError="{Binding IsFacilityNameHasError}"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="TFaciName"
                                        FontSize="Small"
                                        IsSpellCheckEnabled="False"
                                        Style="{StaticResource EntryHeight48}"
                                        Text="{Binding TFaciName}"
                                        Unfocused="TFaciName_Unfocused">
                                        <Entry.Behaviors>
                                            <behaviors:AlphabetandArabicCharacters />
                                        </Entry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDTaxEvasionTIN}" />
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmTIN"
                                    Margin="0,-10,0,0"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="TxtTIN"
                                        IsSpellCheckEnabled="False"
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        Style="{StaticResource EntryHeight48}"
                                        Text="{Binding TxtTIN}"
                                        Unfocused="TxtTIN_Unfocused">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDTaxEvasionVATNumber}" />
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmVAT"
                                    Margin="0,-10,0,0"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="TVatNumber"
                                        Keyboard="Numeric"
                                        MaxLength="15"
                                        Style="{StaticResource EntryHeight48}"
                                        Text="{Binding TVatNumber}"
                                        Unfocused="TVatNumber_Unfocused">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        HasError="{Binding IsRegionHasError}"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <custom:GAZTBorderlessEntry
                                            x:Name="Region_entry"
                                            Style="{StaticResource EntryHeight48}"
                                            Text="{Binding TxtReportDetailRegion}"
                                            TextChanged="Region_entry_TextChanged" />
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png" />
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                    <custom:CustomButton BackgroundColor="Transparent" Clicked="RegionBtnClicked" />

                                    <syncfusion:SfPicker
                                        x:Name="RegionPicker"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,0,10,0"
                                        Background="White"
                                        FlowDirection="RightToLeft"
                                        ItemHeight="40"
                                        Mode="Dialog"
                                        SelectionChanged="RegionPicker_SelectionChanged">

                                        <syncfusion:SfPicker.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.TextStyle>

                                        <syncfusion:SfPicker.Columns>
                                            <syncfusion:PickerColumn
                                                Width="300"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding RList}" />
                                        </syncfusion:SfPicker.Columns>

                                        <syncfusion:SfPicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" />
                                        </syncfusion:SfPicker.ColumnHeaderView>

                                        <syncfusion:SfPicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.SelectedTextStyle>

                                        <syncfusion:SfPicker.HeaderView>

                                            <syncfusion:PickerHeaderView Height="55" Background="{StaticResource Primary}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </syncfusion:SfPicker.HeaderView>

                                        <syncfusion:SfPicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </syncfusion:SfPicker.FooterView>

                                        <syncfusion:SfPicker.Behaviors>
                                            <behaviors:SfPickerBehavior />
                                        </syncfusion:SfPicker.Behaviors>
                                    </syncfusion:SfPicker>
                                </Grid>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionCity}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        HasError="{Binding IsCityHasError}"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <custom:GAZTBorderlessEntry
                                            x:Name="City_entry"
                                            Style="{StaticResource EntryHeight48}"
                                            Text="{Binding TxtReportDetailCity}"
                                            TextChanged="City_entry_TextChanged" />
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png" />
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                    <custom:CustomButton BackgroundColor="Transparent" Clicked="CityPickerButton_Clicked" />

                                    <syncfusion:SfPicker
                                        x:Name="CityPicker"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,0,10,0"
                                        Background="White"
                                        FlowDirection="RightToLeft"
                                        ItemHeight="40"
                                        Mode="Dialog"
                                        SelectionChanged="CityPicker_SelectionChanged">

                                        <syncfusion:SfPicker.Columns>
                                            <syncfusion:PickerColumn
                                                Width="300"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding CList}" />
                                        </syncfusion:SfPicker.Columns>

                                        <syncfusion:SfPicker.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.TextStyle>

                                        <syncfusion:SfPicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" />
                                        </syncfusion:SfPicker.ColumnHeaderView>

                                        <syncfusion:SfPicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.SelectedTextStyle>

                                        <syncfusion:SfPicker.HeaderView>

                                            <syncfusion:PickerHeaderView Height="55" Background="{StaticResource Primary}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </syncfusion:SfPicker.HeaderView>

                                        <syncfusion:SfPicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </syncfusion:SfPicker.FooterView>

                                        <syncfusion:SfPicker.Behaviors>
                                            <behaviors:SfPickerBehavior />
                                        </syncfusion:SfPicker.Behaviors>

                                    </syncfusion:SfPicker>
                                </Grid>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionDistrict}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <!--<Grid>-->
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmFDAddress"
                                    Margin="0,-10,0,0"
                                    HasError="{Binding IsFDHasError}"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="TFDAdress"
                                        IsSpellCheckEnabled="False"
                                        MaxLength="100"
                                        Style="{StaticResource EntryHeight48}"
                                        Text="{Binding TFDAdress}"
                                        Unfocused="TFDAdress_Unfocused" />
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,-10,0,0"
                                    HasError="{Binding IsFSHasError}"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="TFSAddress"
                                        IsSpellCheckEnabled="False"
                                        MaxLength="100"
                                        Style="{StaticResource EntryHeight48}"
                                        Text="{Binding TFSAddress}"
                                        TextChanged="TFSAddress_TextChanged" />
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                        </ScrollView>
                        <!--  Facility Information Ends  -->

                        <!--  Start Of Report Details  -->
                        <ScrollView
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Never"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.ReportDetails}}"
                            VerticalScrollBarVisibility="Never">
                            <StackLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportType}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <inputLayout:SfTextInputLayout Margin="0,-10,0,0" Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <custom:GAZTBorderlessEntry
                                            IsSpellCheckEnabled="False"
                                            Style="{StaticResource EntryHeight48}"
                                            Text="{Binding TxtReporttype}" />
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png" />
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                    <custom:CustomButton BackgroundColor="Transparent" Clicked="ReportTypeButton_Clicked" />

                                    <syncfusion:SfPicker
                                        x:Name="ReportTypePicker"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,0,10,0"
                                        Background="White"
                                        FlowDirection="RightToLeft"
                                        ItemHeight="40"
                                        Mode="Dialog"
                                        SelectionChanged="ReportTypePicker_SelectionChanged">

                                        <syncfusion:SfPicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" />
                                        </syncfusion:SfPicker.ColumnHeaderView>


                                        <syncfusion:SfPicker.Columns>
                                            <syncfusion:PickerColumn
                                                Width="300"
                                                DisplayMemberPath="Title"
                                                ItemsSource="{Binding ReportTypes}" />
                                        </syncfusion:SfPicker.Columns>

                                        <syncfusion:SfPicker.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.TextStyle>


                                        <syncfusion:SfPicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.SelectedTextStyle>

                                        <syncfusion:SfPicker.HeaderView>

                                            <syncfusion:PickerHeaderView Height="55" Background="{StaticResource Primary}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </syncfusion:SfPicker.HeaderView>

                                        <syncfusion:SfPicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </syncfusion:SfPicker.FooterView>


                                        <syncfusion:SfPicker.Behaviors>
                                            <behaviors:SfPickerBehavior />
                                        </syncfusion:SfPicker.Behaviors>

                                    </syncfusion:SfPicker>
                                </Grid>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportDetails}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmReportDetail"
                                    Margin="0,-6,0,-6"
                                    ContainerType="Outlined"
                                    HasError="{Binding IsReportDetailHasError}"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <StackLayout Margin="0,16,0,0" Orientation="Vertical">
                                        <Editor
                                            x:Name="TReportDetail"
                                            AutoSize="TextChanges"
                                            FontSize="Small"
                                            HorizontalOptions="FillAndExpand"
                                            IsSpellCheckEnabled="False"
                                            MaxLength="999"
                                            Text="{Binding TReportDetail}"
                                            Unfocused="TReportDetail_Unfocused" />

                                        <custom:CustomLabel
                                            FontSize="Micro"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding Source={x:Reference TReportDetail}, Path=Text.Length, StringFormat='{0}/999'}"
                                            VerticalOptions="Start"
                                            VerticalTextAlignment="Start" />
                                    </StackLayout>


                                </inputLayout:SfTextInputLayout>


                                <custom:CustomLabel
                                    x:Name="Attachment_Label"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.NDTaxEvasionAttachments}" />
                                <Grid>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        LeadingViewPosition="Inside"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <inputLayout:SfTextInputLayout.LeadingView>
                                            <Image x:Name="Attachment_Tmg" Source="ic_attachment" />
                                        </inputLayout:SfTextInputLayout.LeadingView>
                                        <custom:GAZTBorderlessEntry
                                            x:Name="Attachment_Frm"
                                            IsReadOnly="True"
                                            Style="{StaticResource EntryHeight48}"
                                            Text="" />
                                    </inputLayout:SfTextInputLayout>
                                    <custom:CustomButton BackgroundColor="Transparent" Clicked="OnAttachmentClick" />
                                </Grid>

                                <!--  Attachment List  -->
                                <listView:SfListView
                                    AutoFitMode="DynamicHeight"
                                    BackgroundColor="White"
                                    HeightRequest="300"
                                    HorizontalOptions="FillAndExpand"
                                    ItemsSource="{Binding UploadedDocumentsListObj}"
                                    SelectionBackground="White"
                                    VerticalOptions="Start">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackLayout>
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0,0,0,0"
                                                    LeadingViewPosition="Inside"
                                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                                    <inputLayout:SfTextInputLayout.LeadingView>
                                                        <Image x:Name="Attachment_Tmg" Source="{Binding CorrespondingImageAccoringtoext}" />
                                                    </inputLayout:SfTextInputLayout.LeadingView>
                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="Attachment_Frm"
                                                        IsReadOnly="True"
                                                        Style="{StaticResource EntryHeight48}"
                                                        Text="{Binding FileNameWithExtension}" />

                                                    <inputLayout:SfTextInputLayout.TrailingView>
                                                        <Image Source="close.png">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </inputLayout:SfTextInputLayout.TrailingView>
                                                </inputLayout:SfTextInputLayout>
                                                <custom:CustomLabel
                                                    Margin="0,-15,0,0"
                                                    FlowDirection="LeftToRight"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{Binding Size, StringFormat='{0} MB'}" />
                                                <!--<custom:CustomButton Command="{Binding OnAttachmentClick}" BackgroundColor="Transparent"  />-->
                                            </StackLayout>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>

                                </listView:SfListView>

                            </StackLayout>

                        </ScrollView>
                        <!--  End Of Reporter Details  -->

                        <!--  Start Of Summary  -->
                        <ScrollView
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Never"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.Summary}}"
                            VerticalScrollBarVisibility="Never">
                            <StackLayout>
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>
                                        <StackLayout Padding="16" Orientation="Horizontal">
                                            <Image HeightRequest="30" Source="vat_user" />
                                            <!--<Frame Style="{StaticResource circleFrame}">



                                            </Frame>-->
                                            <custom:CustomLabel
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.NDReporterInformation}"
                                                VerticalTextAlignment="Center" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource ValueLabelBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalTextAlignment="Center"
                                                WidthRequest="50">
                                                <custom:CustomLabel.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnEditClicked}" CommandParameter="{x:Static models:NewTaxEvasionTabEnum.ReporterInfo}" />
                                                </custom:CustomLabel.GestureRecognizers>
                                            </custom:CustomLabel>
                                        </StackLayout>

                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />

                                        <Grid Padding="15" RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterName}" />
                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TName}" />

                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionMobileNumber}" />
                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TMobNumber}" />

                                            <custom:CustomLabel
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterLocation}" />
                                            <custom:CustomLabel
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding RLocation}" />
                                        </Grid>

                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>
                                        <StackLayout Padding="16" Orientation="Horizontal">
                                            <Image Source="ic_company.png" />
                                            <!--<Frame Style="{StaticResource circleFrame}">



                                            </Frame>-->
                                            <custom:CustomLabel
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.NDFacilityInformation}"
                                                VerticalTextAlignment="Center" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalTextAlignment="Center"
                                                WidthRequest="50">
                                                <custom:CustomLabel.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnEditClicked}" CommandParameter="{x:Static models:NewTaxEvasionTabEnum.FacilityInfo}" />
                                                </custom:CustomLabel.GestureRecognizers>
                                            </custom:CustomLabel>
                                        </StackLayout>

                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />

                                        <Grid Padding="15" RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionFacilityName}" />
                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TFaciName}" />

                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionTIN}" />
                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TxtTIN}" />

                                            <custom:CustomLabel
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionVATNumber}" />
                                            <custom:CustomLabel
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TVatNumber}" />

                                            <custom:CustomLabel
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}" />
                                            <custom:CustomLabel
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                StyleId="ValueLabel"
                                                Text="{Binding TxtReportDetailRegion}" />

                                            <custom:CustomLabel
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionCity}" />
