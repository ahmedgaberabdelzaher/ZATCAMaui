<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class=" ZATCAMAUI.Views.NewDesign.TAXEvasionPages.TaxEvasionVerifyMobileNumberPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    FlowDirection="LeftToRight"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android, UWP">0</On>
            <On Platform="iOS">0,20,0,0</On>
        </OnPlatform>
    </ContentPage.Padding>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <ScrollView>
                <Grid>

                    <StackLayout>
                        <Grid Padding="10,5,10,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*" />
                                <ColumnDefinition Width="70*" />
                                <ColumnDefinition Width="15*" />
                            </Grid.ColumnDefinitions>

                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="Center"
                                Style="{StaticResource SectionTitleWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}" />
                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsBackStepButtonVisible}"
                                Source="arrowLeftwhite"
                                Style="{DynamicResource BackButtonArrow}"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>

                        <yummy:PancakeView
                            Padding="0"
                            CornerRadius="14,14,0,0"
                            VerticalOptions="FillAndExpand">
                            <Grid
                                x:Name="VATRMainGrid"
                                Margin="0"
                                Padding="0,0,0,0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <Grid.RowDefinitions>
                                    <!--<RowDefinition Height="10*" />-->
                                    <RowDefinition Height="100*" />

                                </Grid.RowDefinitions>
                                <ContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand" />
                            </Grid>
                        </yummy:PancakeView>
                    </StackLayout>

                </Grid>
            </ScrollView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <StackLayout
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    Padding="10">
                    <Grid Margin="0,15,0,0" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="1"
                            HeightRequest="50"
                            HorizontalOptions="Center"
                            Source="ic_logo_gazt.png"
                            VerticalOptions="Center"
                            WidthRequest="50" />



                        <Image Grid.Column="2" IsVisible="false">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.Close}"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                    </Grid>
                    <custom:CustomLabel Style="{StaticResource SectionTitleBlack}" Text="{Binding PageTitle}" />
                    <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{Binding PageTitleTag}" />
                    <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1" />
                </StackLayout>

                <!--  Input For Mobile Number  -->
                <StackLayout
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    Padding="10"
                    IsVisible="{Binding IsShowMobileInput}">

                    <custom:CustomLabel
                        Grid.Row="0"
                        Padding="0,0,0,0"
                        Style="{StaticResource CaptionLabelGrey}">

                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>

                    <inputLayout:SfTextInputLayout
                        x:Name="frmMobile"
                        ContainerType="Outlined"
                        FlowDirection="LeftToRight"
                        HorizontalOptions="FillAndExpand"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <inputLayout:SfTextInputLayout.LeadingView>

                            <Label
                                x:Name="mobileNumberPrefix"
                                Margin="0"
                                FlowDirection="LeftToRight"
                                FontSize="Medium"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="+966  |"
                                TextColor="Gray"
                                VerticalTextAlignment="Center"
                                WidthRequest="80" />

                        </inputLayout:SfTextInputLayout.LeadingView>
                        <Entry
                            x:Name="Mobile_Entry"
                            FlowDirection="LeftToRight"
                            FontSize="Medium"
                            HorizontalOptions="FillAndExpand"
                            Keyboard="Telephone"
                            MaxLength="9"
                            PlaceholderColor="Gray"
                            Text="{Binding MobileNumber}"
                            TextColor="{StaticResource PrimaryColor}"
                            Unfocused="Mobile_Entry_Unfocused">
                            <Entry.Behaviors>
                                <behaviors:OnlyNumericValuesBehaviour />
                            </Entry.Behaviors>
                        </Entry>
                    </inputLayout:SfTextInputLayout>

                </StackLayout>

                <!--  Input for OTP Verification  -->
                <StackLayout
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    Padding="0,15,0,0"
                    IsVisible="{Binding IsShowOTPInput}">
                    <custom:CustomLabel
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding OTPSentOnThisMobileNumber}" />
                    <custom:CustomLabel
                        FlowDirection="LeftToRight"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding EncriptedMobileNumber}" />

                    <Grid
                        Padding="30,20,30,20"
                        ColumnSpacing="20"
                        FlowDirection="LeftToRight">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <!--  First OTP Digit Start  -->
                        <inputLayout:SfTextInputLayout
                            Grid.Column="0"
                            ContainerType="Outlined"
                            HasError="False"
                            OutlineCornerRadius="8"
                            Stroke="{StaticResource Primary}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                x:Name="OTPFirstEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="Numeric"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPFirstDigit}"
                                TextChanged="OtpFirstEntry_TextChanged"
                                TextColor="#bbbbbb"
                                WidthRequest="8">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <!--  First OTP Digit End  -->

                        <!--  Second OTP Digit Start  -->
                        <inputLayout:SfTextInputLayout
                            Grid.Column="1"
                            ContainerType="Outlined"
                            HasError="False"
                            OutlineCornerRadius="8"
                            Stroke="{StaticResource Primary}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                x:Name="OTPSecondEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="Numeric"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPSecondDigit}"
                                TextChanged="OtpSecondEntry_TextChanged"
                                TextColor="#bbbbbb"
                                WidthRequest="8">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <!--  Second OTP Digit End  -->

                        <!--  Third OTP Digit Start  -->
                        <inputLayout:SfTextInputLayout
                            Grid.Column="2"
                            ContainerType="Outlined"
                            HasError="False"
                            OutlineCornerRadius="8"
                            Stroke="{StaticResource Primary}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                x:Name="OTPThirdEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="Numeric"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPThirdDigit}"
                                TextChanged="OtpThirdEntry_TextChanged"
                                TextColor="#bbbbbb"
                                WidthRequest="8">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <!--  Third OTP Digit End  -->

                        <!--  Fourth OTP Digit Start  -->
                        <inputLayout:SfTextInputLayout
                            Grid.Column="3"
                            ContainerType="Outlined"
                            HasError="False"
                            OutlineCornerRadius="8"
                            Stroke="{StaticResource Primary}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                x:Name="OTPFourthEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="Numeric"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPFourthDigit}"
                                TextChanged="OtpFourthEntry_TextChanged"
                                TextColor="#bbbbbb"
                                Unfocused="OtpFourthEntry_Unfocused"
                                WidthRequest="8" />
                        </inputLayout:SfTextInputLayout>
                        <!--  Fourth OTP Digit End  -->

                    </Grid>

                    <StackLayout HorizontalOptions="Center" Orientation="Horizontal">
                        <Image Source="clock" />
                        <custom:CustomLabel
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{Binding LblCountDownTimer}"
                            VerticalOptions="Center" />
                    </StackLayout>
                    <buttons:SfButton
                        Margin="0,50,0,0"
                        Background="Transparent"
                        Command="{Binding ResendOTPCommand}"
                        FontFamily="{StaticResource SomarRegular}"
                        IsEnabled="{Binding IsResendOTPEnabled}"
                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                        TextColor="{Binding ResendOtpButtonColor}"
                        VerticalOptions="StartAndExpand" />
                </StackLayout>

                <!--  Continue button  -->
                <buttons:SfButton
                    Grid.Row="2"
                    Margin="20,5,20,20"
                    Clicked="btn_Continue_ClickedAsync"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsShowMobileInput}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

            </Grid>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>
