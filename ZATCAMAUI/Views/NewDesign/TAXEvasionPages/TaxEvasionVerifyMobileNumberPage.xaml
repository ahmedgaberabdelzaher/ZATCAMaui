<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class=" ZATCAMAUI.Views.NewDesign.TAXEvasionPages.TaxEvasionVerifyMobileNumberPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <ScrollView>
                <Grid>

                    <StackLayout>
                        <Grid Padding="10,5,10,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*" />
                                <ColumnDefinition Width="70*" />
                                <ColumnDefinition Width="15*" />
                            </Grid.ColumnDefinitions>

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="Center"
                                Style="{StaticResource SectionTitleWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}" />
                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding IsBackStepButtonVisible}"
                                Source="arrowLeftwhite"
                                
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>

                        <Border
                            Padding="0"
                            StrokeShape="RoundRectangle 15,15,0,0"
                            VerticalOptions="FillAndExpand">
                            <Grid
                                x:Name="VATRMainGrid"
                                Margin="0"
                                Padding="0,0,0,0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <Grid.RowDefinitions>
                                    <!--<RowDefinition Height="10*" />-->
                                    <RowDefinition Height="100*" />

                                </Grid.RowDefinitions>
                                <ContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand" />
                            </Grid>
                        </Border>
                    </StackLayout>

                </Grid>
            </ScrollView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <StackLayout
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    Padding="10">
                    <Grid Margin="0,15,0,0" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="1"
                            HeightRequest="50"
                            HorizontalOptions="Center"
                            Source="ic_logo_gazt.png"
                            VerticalOptions="Center"
                            WidthRequest="50" />



                        <Image Grid.Column="2" IsVisible="false">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.Close}"
                                    Color="{StaticResource SecondaryNew}" />
                            </Image.Source>
                        </Image>
                    </Grid>
                    <Label Style="{StaticResource SectionTitleBlack}" Text="{Binding PageTitle}" />
                    <Label Style="{StaticResource BodyLabelGrey}" Text="{Binding PageTitleTag}" />
                    <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1" />
                </StackLayout>

                <!--  Input For Mobile Number  -->
                <StackLayout
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    Padding="10"
                    IsVisible="{Binding IsShowMobileInput}">

                    <Label
                        Grid.Row="0"
                        Padding="0,0,0,0"
                        Style="{StaticResource CaptionLabelGrey}">

                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.MobileNumber}"  Style="{StaticResource CaptionLabelGrey}"/>
                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <inputLayout:SfTextInputLayout
                        x:Name="frmMobile"
                        ContainerType="Outlined"
                        FlowDirection="LeftToRight"
                        HorizontalOptions="FillAndExpand"
                        IsHintAlwaysFloated="True"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        Stroke="{StaticResource Primary}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <inputLayout:SfTextInputLayout.LeadingView>

                            <Label
                                x:Name="mobileNumberPrefix"
                                Margin="0"
                                FlowDirection="LeftToRight"
                                FontSize="Medium"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="+966  |"
                                TextColor="Gray"
                                VerticalTextAlignment="Center"
                                WidthRequest="80" />

                        </inputLayout:SfTextInputLayout.LeadingView>
                        <custom:GAZTBorderlessEntry
                            x:Name="Mobile_Entry"
                            FlowDirection="LeftToRight"
                            FontSize="Medium"
                            HorizontalOptions="FillAndExpand"
                            Keyboard="Telephone"
                            MaxLength="9"
                            PlaceholderColor="Gray"
                            Text="{Binding MobileNumber}"
                            TextColor="{StaticResource PrimaryColor}"
                            Unfocused="Mobile_Entry_Unfocused">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviors:OnlyNumericValuesBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>

                </StackLayout>

                <!--  Input for OTP Verification  -->
                <StackLayout
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    Padding="0,15,0,0"
                    IsVisible="{Binding IsShowOTPInput}">
                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding OTPSentOnThisMobileNumber}" />
                    <Label
                        FlowDirection="LeftToRight"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding EncriptedMobileNumber}" />

                    <Grid
                        Padding="30,20,30,20"
                        ColumnSpacing="20"
                        FlowDirection="LeftToRight">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <!--  First OTP Digit Start  -->
                        <Border
                            Grid.Column="0"
                            HeightRequest="50"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Start"
                            WidthRequest="50">

                            <custom:GAZTBorderlessEntry
                                x:Name="OTPFirstEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="{OnPlatform Android=Numeric,
                                                      iOS=Default}"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPFirstDigit}"
                                TextChanged="OtpFirstEntry_TextChanged"
                                TextColor="#bbbbbb"
                                WidthRequest="100">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:OnlyNumericValuesBehaviour />
                                    <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </Border>
                        <!--  First OTP Digit End  -->

                        <!--  Second OTP Digit Start  -->
                        <Border
                            Grid.Column="1"
                            HeightRequest="50"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Start"
                            WidthRequest="50">

                            <custom:GAZTBorderlessEntry
                                x:Name="OTPSecondEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="{OnPlatform Android=Numeric,
                                                      iOS=Default}"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPSecondDigit}"
                                TextChanged="OtpSecondEntry_TextChanged"
                                TextColor="#bbbbbb"
                                WidthRequest="100">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:OnlyNumericValuesBehaviour />
                                    <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </Border>
                        <!--  Second OTP Digit End  -->

                        <!--  Third OTP Digit Start  -->
                        <Border
                            Grid.Column="2"
                            HeightRequest="50"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Start"
                            WidthRequest="50">

                            <custom:GAZTBorderlessEntry
                                x:Name="OTPThirdEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="{OnPlatform Android=Numeric,
                                                      iOS=Default}"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPThirdDigit}"
                                TextChanged="OtpThirdEntry_TextChanged"
                                TextColor="#bbbbbb"
                                WidthRequest="100">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:OnlyNumericValuesBehaviour />
                                    <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </Border>
                        <!--  Third OTP Digit End  -->

                        <!--  Fourth OTP Digit Start  -->
                        <Border
                            Grid.Column="3"
                            HeightRequest="50"
                            Stroke="Gray"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Start"
                            WidthRequest="50">

                            <custom:GAZTBorderlessEntry
                                x:Name="OTPFourthEntry"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                IsEnabled="{Binding IsOTPEntryEnable}"
                                Keyboard="{OnPlatform Android=Numeric,
                                                      iOS=Default}"
                                MaxLength="1"
                                ReturnType="Next"
                                Text="{Binding OTPFourthDigit}"
                                TextChanged="OtpFourthEntry_TextChanged"
                                TextColor="#bbbbbb"
                                Unfocused="OtpFourthEntry_Unfocused"
                                WidthRequest="100">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:OnlyNumericValuesBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>

                            </custom:GAZTBorderlessEntry>

                        </Border>
                        <!--  Fourth OTP Digit End  -->

                    </Grid>

                    <StackLayout HorizontalOptions="Center" Orientation="Horizontal">
                        <Image Source="clock" />
                        <Label
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{Binding LblCountDownTimer}"
                            VerticalOptions="Center" />
                    </StackLayout>
                    <buttons:SfButton
                        Margin="0,50,0,0"
                        Background="Transparent"
                        Command="{Binding ResendOTPCommand}"
                        FontFamily="{StaticResource SomarRegular}"
                        IsEnabled="{Binding IsResendOTPEnabled}"
                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                        TextColor="{Binding ResendOtpButtonColor}"
                        VerticalOptions="StartAndExpand" />
                </StackLayout>

                <!--  Continue button  -->
                <buttons:SfButton
                    Grid.Row="2"
                    Margin="20,5,20,20"
                    Clicked="btn_Continue_ClickedAsync"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsShowMobileInput}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

            </Grid>
            <custom:Loader IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>
