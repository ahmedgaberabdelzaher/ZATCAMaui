<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.EDeclarationSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,Auto,*">

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    VerticalOptions="CenterAndExpand" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1" Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Padding="15" VerticalOptions="FillAndExpand">

                        <!--  Success icon  -->
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="150"
                            Source="darkSucces"
                            WidthRequest="150" />

                        <!--  Success Msg1 Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="28"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.CreatedSuccessfully}"
                            TextColor="#002447" />

                        <!--  Success Msg2 Label  -->
                        <Label
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="{x:Static ResourceManager:AppResources.CreatedSuccessfullyMsg}"
                            TextColor="#002447" />

                        <!--#region Disclaimer-->
                        <Border
                            Margin="0,10"
                            Padding="5"
                            BackgroundColor="#FCECCD"
                            Stroke="#FCECCD"
                            StrokeShape="RoundRectangle 8,8,8,8"
                            Style="{StaticResource CommonTopCurves}">

                            <StackLayout Orientation="Horizontal" Spacing="8">

                                <!--  Check Mark Image  -->
                                <Image Aspect="AspectFit" Source="OrangeCircle" />

                                <!--  Feedback Name Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding TravelerDeclarationResponse.FeedbackName}"
                                    TextColor="#F5BF58" />

                            </StackLayout>

                        </Border>
                        <!--#endregion Disclaimer-->

                        <!--#region Frame Declaration Values-->
                        <Border
                            Margin="0,0,0,10"
                            Padding="15"
                            Stroke="#EBEBEB"
                            StrokeShape="RoundRectangle 15,15,15,15"
                            Style="{StaticResource CommonTopCurves}">

                            <!--  Frame Content  -->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal" Spacing="0">

                                    <!--  Doc Image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25" />

                                    <!--  Declaration Label  -->
                                    <Label
                                        Padding="10"
                                        FontSize="20"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.FORM5Declaration}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="1"
                                    HorizontalOptions="FillAndExpand"
                                    WidthRequest="350" />

                                <!--#region Declaration Values-->
                                <Grid
                                    ColumnDefinitions="2*,*"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                    RowSpacing="15">

                                    <!--  Reference number Label  -->
                                    <Label
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmentReferenceNumber}"
                                        TextColor="#999999"
                                        VerticalOptions="Start">

                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CopyCommand}" />
                                        </Label.GestureRecognizers>

                                    </Label>

                                    <!--  Reference number value Label  -->
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding TravelerDeclarationResponse.ReferenceID}"
                                        TextColor="#002447"
                                        VerticalOptions="Start">

                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CopyCommand}" />
                                        </Label.GestureRecognizers>

                                    </Label>

                                    <!--  Payment Status Label  -->
                                    <Label
                                        Grid.Row="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding TravelerDeclarationResponse.paymentIsRequired}"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentPaymentStatus}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Payment status value Label  -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding TravelerDeclarationResponse.paymentIsRequired}"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        VerticalOptions="Start">

                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding TravelerDeclarationResponse.IsNotPaid}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.NotPaidPaymentStatus}" />

                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding TravelerDeclarationResponse.IsNotPaid}"
                                                TargetType="Label"
                                                Value="false">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.PaidPaymentStatus}" />

                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>


                                    <!--  Name Label  -->
                                    <Label
                                        Grid.Row="2"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.ZZName}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Name value Label  -->
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding TravelerDeclarationResponse.fullName}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport Label  -->
                                    <Label
                                        Grid.Row="3"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TravellerPassport}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport value Label  -->
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding TravelerDeclarationResponse.travelID}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />



                                    <!--  Coming/Going from/to Label  -->
                                    <Label
                                        Grid.Row="4"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.ArrivingFromORDepartingTo}"
                                        TextColor="#999999"
                                        VerticalOptions="Start">

                                        <Label.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsArrivingPlaneSelected}"
                                                TargetType="Label"
                                                Value="true">

                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ArrivingFrom}" />

                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsArrivingPlaneSelected}"
                                                TargetType="Label"
                                                Value="false">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.DepartingTo}" />

                                            </DataTrigger>
                                        </Label.Triggers>


                                    </Label>

                                    <!--  Coming/Going from/to Value Label  -->
                                    <Label
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding TravelerDeclarationResponse.ArrivingName}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Port Label  -->
                                    <Label
                                        Grid.Row="5"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.Port}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Port value Label  -->
                                    <Label
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding TravelerDeclarationResponse.PortName}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />



                                    <!--  Trip number Label  -->
                                    <Label
                                        Grid.Row="6"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TripNumber}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Trip number value Label  -->
                                    <Label
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding TravelerDeclarationResponse.flightNumber}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <Label
                                        Grid.Row="7"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TripDate}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <Label
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding TravelerDeclarationResponse.TravelDateString}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </Grid>
                                <!--#endregion Declaration Values-->

                            </StackLayout>

                        </Border>
                        <!--#endregion Frame Declaration Values-->

                        <!--#region Frame Contains Total Fees-->
                        <Border
                            Margin="0,0,0,10"
                            Padding="15"
                            Stroke="#EBEBEB"
                            StrokeShape="RoundRectangle 15,15,15,15"
                            Style="{StaticResource CommonTopCurves}">

                            <!--  Frame Content  -->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal" Spacing="0">

                                    <!--  Doc Image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25" />

                                    <!--  Total fees Label  -->
                                    <Label
                                        Padding="10"
                                        FontSize="20"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="1"
                                    HorizontalOptions="FillAndExpand"
                                    WidthRequest="350" />

                                <!--#region Total Product Fees Values-->
                                <StackLayout x:Name="totalFeesList" BindableLayout.ItemsSource="{Binding TotalFeesList}">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <!--  Items List  -->
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                                                <!--  Item Name Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="Start"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Name}"
                                                    TextColor="#999999"
                                                    VerticalOptions="Start" />

                                                <!--  Count value Label  -->
                                                <Label
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="End"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Id}"
                                                    TextColor="#002447"
                                                    VerticalOptions="Start" />

                                            </Grid>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </StackLayout>
                                <!--#endregion Total Product Fees Values-->

                                <Grid ColumnDefinitions="2*,*">

                                    <!--  Total amount Label  -->
                                    <Label
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TotalAmount}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Total amount value Label  -->
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="End"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        VerticalOptions="Start">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    Text="{Binding TravelerDeclarationResponse.totalFees}"
                                                    TextColor="#002447" />
                                                <Span Text="  " />
                                                <Span
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    Text="{x:Static ResourceManager:AppResources.ZSAR}"
                                                    TextColor="#002447" />
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </Grid>

                            </StackLayout>

                        </Border>
                        <!--#endregion Frame Contains Total Fees-->

                        <!--#region Frame Contains Details Fees-->
                        <Border
                            Margin="0,0,0,15"
                            Padding="15"
                            Stroke="#EBEBEB"
                            StrokeShape="RoundRectangle 15,15,15,15"
                            Style="{StaticResource CommonTopCurves}">

                            <!--  Frame Content  -->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal" Spacing="0">

                                    <!--  Doc Image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25" />

                                    <!--  Details Total fees Label  -->
                                    <Label
                                        Padding="10"
                                        FontSize="20"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.DetailsTotalFeesPayable}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="1"
                                    HorizontalOptions="FillAndExpand"
                                    WidthRequest="350" />

                                <!--#region Details Fees Values-->
                                <StackLayout BindableLayout.ItemsSource="{Binding DetailsTotalFeesList}">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <!--  Items List  -->
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                                                <!--  Item Name Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="Start"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Name}"
                                                    TextColor="#999999"
                                                    VerticalOptions="Start" />

                                                <!--  Value Label  -->
                                                <Label
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="End"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="#002447"
                                                    VerticalOptions="Start">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                FontSize="14"
                                                                Text="{Binding Id}"
                                                                TextColor="#002447" />
                                                            <Span Text="  " />
                                                            <Span
                                                                FontFamily="{StaticResource SomarSemiBold}"
                                                                FontSize="14"
                                                                Text="{x:Static ResourceManager:AppResources.ZSAR}"
                                                                TextColor="#002447" />
                                                        </FormattedString>
                                                    </Label.FormattedText>

                                                </Label>

                                            </Grid>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </StackLayout>
                                <!--#endregion Payment Values-->
                            </StackLayout>

                        </Border>
                        <!--#endregion Frame Contains Fees-->

                        <!--#region Payment Cards-->
                        <StackLayout
                            HeightRequest="100"
                            Margin="0,10"
                            HorizontalOptions="StartAndExpand"
                            Orientation="Horizontal"
                            Spacing="20"
                            VerticalOptions="StartAndExpand">

                            <!--  Visa Card  -->
                            <Grid
                                HeightRequest="94"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background Visa image selected  -->
                                <Image Aspect="AspectFill" Source="{Binding PaymentCard.BackgroundVisaCardImage}" />

                                <StackLayout
                                    Padding="15,20"
                                    HorizontalOptions="FillAndExpand"
                                    Spacing="15"
                                    VerticalOptions="FillAndExpand">

                                    <!--  Visa image selected  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HorizontalOptions="Start"
                                        Source="{Binding PaymentCard.VisaCardImage}"
                                        VerticalOptions="Start" />

                                    <!--  Visa Card Label  -->
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.MasterVisa}"
                                        TextColor="{Binding PaymentCard.VisaCardTextColor}"
                                        VerticalOptions="EndAndExpand" />
                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PaymentCardCommand}" CommandParameter="1" />
                                </Grid.GestureRecognizers>

                            </Grid>


                            <Grid
                                Padding="5"
                                HeightRequest="94"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background SADAD image selected  -->
                                <Image Aspect="AspectFill" Source="{Binding PaymentCard.BackgroundSADADImage}" />


                                <!--  SADAD card  -->
                                <StackLayout
                                    Padding="15,20"
                                    HorizontalOptions="FillAndExpand"
                                    Spacing="15"
                                    VerticalOptions="FillAndExpand">

                                    <!--  SADAD image selected  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HorizontalOptions="Start"
                                        Source="{Binding PaymentCard.SADADImage}"
                                        VerticalOptions="Start" />

                                    <!--  SADAD label  -->
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.Sadad}"
                                        TextColor="{Binding PaymentCard.SADADTextColor}"
                                        VerticalOptions="EndAndExpand" />

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PaymentCardCommand}" CommandParameter="2" />
                                </Grid.GestureRecognizers>

                            </Grid>

                        </StackLayout>

                        <!--  Apple card Not Used now  -->
                        <Grid
                            Padding="5"
                            HeightRequest="94"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="false"
                            WidthRequest="171">

                            <!--  Background image selected  -->
                            <Image Aspect="AspectFill" Source="{Binding PaymentCard.BackgroundAppleImage}" />

                            <!--  Apple card  -->
                            <StackLayout
                                    Padding="15,20"
                                    HorizontalOptions="FillAndExpand"
                                    Spacing="15"
                                    VerticalOptions="FillAndExpand">

                                <!--  Apple image selected  -->
                                <Image
                                    Aspect="AspectFit"
                                    HorizontalOptions="Start"
                                    Source="{Binding PaymentCard.AppleImage}"
                                    VerticalOptions="Start" />

                                <!--  Apple label  -->
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.PaymentMethodApplePay}"
                                    TextColor="{Binding PaymentCard.AppleTextColor}"
                                    VerticalOptions="EndAndExpand" />

                            </StackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PaymentCardCommand}" CommandParameter="3" />
                            </Grid.GestureRecognizers>

                        </Grid>

                        <!--#endregion Payment Cards-->

                        <!--  Pay Now Button  -->
                        <buttons:SfButton
                            Margin="0,10"
                            Background="#0996D4"
                            Command="{Binding GoToPaymentCommand}"
                            IsVisible="{Binding IsPaymentRequired}"
                            Stroke="#0996D4"
                            StrokeThickness="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                            TextColor="White" />

                        <!--  DownLoad Pdf Button  -->
                        <buttons:SfButton
                            Background="#0996D4"
                            Command="{Binding DownlOadFileCommand}"
                            Stroke="#0996D4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.DownloadEdecleraton}"
                            TextColor="White" />

                        <!--  Back to Home Button  -->
                        <buttons:SfButton
                            Background="Transparent"
                            Command="{Binding BackToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.BackToHome}"
                            TextColor="#0996D4" />

                    </StackLayout>

                </ScrollView>


            </Border>
            <!--#endregion Body-->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

             <!--  Popup Msg  -->
            <Grid
                Grid.RowSpan="2"
                Margin="0"
                IsVisible="{Binding IsShowMsgView}"
                VerticalOptions="FillAndExpand">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}" />
                </Grid.GestureRecognizers>

                <StackLayout
                    BackgroundColor="Black"
                    Opacity="0.4"
                    VerticalOptions="FillAndExpand" />

                <Border
                    Padding="20,20,20,10"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 15,15,0,0"
                    Style="{StaticResource CommonTopCurves}"
                    VerticalOptions="EndAndExpand">

                    <StackLayout Margin="0" VerticalOptions="Center">

                        <StackLayout Orientation="Horizontal">

                            <StackLayout Spacing="10">

                                <Label
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{Binding MessageTxt}" />

                                <Label
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{Binding SADADNewTXT}" />

                            </StackLayout>


                            <Image
                                Aspect="AspectFit"
                                HeightRequest="25"
                                HorizontalOptions="EndAndExpand"
                                Source="Copy"
                                VerticalOptions="Start"
                                WidthRequest="25" />

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CopySADADCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <buttons:SfButton
                            Margin="0,10"
                            Command="{Binding CloseMsgViewCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                            VerticalOptions="CenterAndExpand" />

                    </StackLayout>

                </Border>

            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>

