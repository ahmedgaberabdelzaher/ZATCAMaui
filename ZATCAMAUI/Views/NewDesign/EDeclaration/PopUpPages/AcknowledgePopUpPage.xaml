<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.PopUpPages.AcknowledgePopUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    FlowDirection="{Binding AppDirection}">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>


    <Grid VerticalOptions="EndAndExpand">

        <Border
            Padding="20"
            BackgroundColor="White"
            HeightRequest="490"
            Stroke="{StaticResource NeutralLightGrey}"
            StrokeShape="RoundRectangle 15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid RowDefinitions="*">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout>

                        <!--  Header  -->
                        <StackLayout
                            Margin="0,0,0,20"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="StartAndExpand">

                            <!--  Acknowledge Header Label  -->
                            <Label
                                FontSize="28"
                                HorizontalOptions="Start"
                                Text="{x:Static ResourceManager:AppResources.DeclarationAcknowledge}"
                                TextColor="#232323"
                                VerticalOptions="StartAndExpand" />

                            <!--  Close Image  -->
                            <Image
                                HeightRequest="20"
                                HorizontalOptions="EndAndExpand"
                                Source="darkClose.png"
                                VerticalOptions="Center"
                                WidthRequest="20" />

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseAcknowledgePopUpPageCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>

                        <!--#region Frame Contains Image and Text-->
                        <Border
                            Padding="25"
                            Stroke="#EBEBEB"
                            StrokeShape="RoundRectangle 15,15,15,15">

                            <!--  Frame Content  -->
                            <StackLayout Spacing="25">

                                <!--#region Icon and Label-->
                                <StackLayout
                                    HorizontalOptions="Start"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalOptions="Start">

                                    <!--  Infromation Image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="StartAndExpand"
                                        Source="information.png"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="25" />

                                    <!--  Sub Header Label  -->
                                    <Label
                                        FontSize="18"
                                        HorizontalOptions="Start"
                                        Text="{x:Static ResourceManager:AppResources.DeclarationAcknowledge}"
                                        VerticalOptions="Center" />

                                </StackLayout>
                                <!--#endregion Icon and Label-->

                                <!--  Notes Label  -->
                                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="• "
                                                    TextColor="#002447" />
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="{x:Static ResourceManager:AppResources.AcknowledgeNote1}"
                                                    TextColor="#002447" />
                                                <Span Text="&#10;" />
                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="• "
                                                    TextColor="#002447" />
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="{x:Static ResourceManager:AppResources.AcknowledgeNote2}"
                                                    TextColor="#002447" />
                                                <Span Text="&#10;" />
                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="• "
                                                    TextColor="#002447" />
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="{x:Static ResourceManager:AppResources.AcknowledgeNote3}"
                                                    TextColor="#002447" />
                                                <Span Text="&#10;" />
                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="• "
                                                    TextColor="#002447" />
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="{x:Static ResourceManager:AppResources.AcknowledgeNote4}"
                                                    TextColor="#002447" />
                                                <Span Text="&#10;" />
                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="• "
                                                    TextColor="#002447" />
                                                <Span
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="14"
                                                    Text="{x:Static ResourceManager:AppResources.AcknowledgeNote5}"
                                                    TextColor="#002447" />
                                            </FormattedString>

                                        </Label.FormattedText>

                                    </Label>

                                </StackLayout>

                            </StackLayout>

                        </Border>
                        <!--#endregion Frame Contains Image and Text-->

                        <!--  Check Box  -->
                        <StackLayout
                            Margin="0,10"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            Spacing="10">

                            <!--  Check box Image  -->
                            <Image
                                HeightRequest="20"
                                HorizontalOptions="Start"
                                Source="CheckMark.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20">

                                <Image.Triggers>

                                    <DataTrigger
                                        Binding="{Binding SubmitModel.travelerDeclaration.IsTermsChecked}"
                                        TargetType="Image"
                                        Value="True">
                                        <Setter Property="Source" Value="CheckMark.png" />
                                    </DataTrigger>

                                    <DataTrigger
                                        Binding="{Binding SubmitModel.travelerDeclaration.IsTermsChecked}"
                                        TargetType="Image"
                                        Value="False">
                                        <Setter Property="Source" Value="emptyCheck.png" />
                                    </DataTrigger>

                                </Image.Triggers>

                            </Image>

                            <!--  Terms & Conditions  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="14"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.TermsConditions}"
                                TextColor="#232323" />

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CheckBoxCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  Approve Declaration Button  -->
                        <buttons:SfButton
                            Margin="0,20,0,50"
                            Command="{Binding ApproveDeclarationCommand}"
                            FontFamily="{StaticResource SomarBold}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ApproveDeclaration}" />

                    </StackLayout>

                </ScrollView>



            </Grid>

        </Border>

    </Grid>
</Mopups:PopupPage>

