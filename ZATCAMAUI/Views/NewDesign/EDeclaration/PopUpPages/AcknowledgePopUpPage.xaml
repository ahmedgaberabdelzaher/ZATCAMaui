<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.PopUpPages.AcknowledgePopUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:RGPopup.Maui.Animations;assembly=RGPopup.Maui"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    FlowDirection="{Binding AppDirection}">

    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>-->

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="20"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="490"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">
            <ScrollView VerticalScrollBarVisibility="Never">

                <StackLayout>

                    <!--  Header  -->
                    <StackLayout
                        Margin="0,0,0,20"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Horizontal"
                        VerticalOptions="StartAndExpand">

                        <!--  Acknowledge Header Label  -->
                        <custom:CustomLabel
                            FontSize="28"
                            HorizontalOptions="Start"
                            Text="{x:Static ResourceManager:AppResources.DeclarationAcknowledge}"
                            TextColor="#232323"
                            VerticalOptions="StartAndExpand" />

                        <!--  Close Image  -->
                        <Image
                            HeightRequest="20"
                            HorizontalOptions="EndAndExpand"
                            Source="darkClose.png"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="Center"
                            WidthRequest="20" />

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseAcknowledgePopUpPageCommand}" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>

                    <!--#region Frame Contains Image and Text-->
                    <Frame
                        Padding="25"
                        BorderColor="#EBEBEB"
                        CornerRadius="15"
                        HasShadow="False">

                        <!--  Frame Content  -->
                        <StackLayout Spacing="25">

                            <!--#region Icon and Label-->
                            <StackLayout
                                HorizontalOptions="Start"
                                Orientation="Horizontal"
                                VerticalOptions="Start">

                                <!--  Infromation Image  -->
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="25"
                                    HorizontalOptions="StartAndExpand"
                                    Source="information"
                                    VerticalOptions="StartAndExpand"
                                    WidthRequest="25" />

                                <!--  Sub Header Label  -->
                                <custom:CustomLabel
                                    FontSize="18"
                                    HorizontalOptions="Start"
                                    Text="{x:Static ResourceManager:AppResources.DeclarationAcknowledge}"
                                    VerticalOptions="Center" />

                            </StackLayout>
                            <!--#endregion Icon and Label-->

                            <!--  Notes Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                LineHeight="1"
                                TextColor="#002447">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="• " />
                                        <Span Text="{x:Static ResourceManager:AppResources.AcknowledgeNote1}" />
                                        <Span Text="&#10;" />
                                        <Span Text="• " />
                                        <Span Text="{x:Static ResourceManager:AppResources.AcknowledgeNote2}" />
                                        <Span Text="&#10;" />
                                        <Span Text="• " />
                                        <Span Text="{x:Static ResourceManager:AppResources.AcknowledgeNote3}" />
                                        <Span Text="&#10;" />
                                        <Span Text="• " />
                                        <Span Text="{x:Static ResourceManager:AppResources.AcknowledgeNote4}" />
                                        <Span Text="&#10;" />
                                        <Span Text="• " />
                                        <Span Text="{x:Static ResourceManager:AppResources.AcknowledgeNote5}" />
                                    </FormattedString>
                                </Label.FormattedText>

                            </Label>

                        </StackLayout>

                    </Frame>
                    <!--#endregion Frame Contains Image and Text-->

                    <!--HyberLink Label
                    <Label
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="14"
                        Margin="0,20"
                        HorizontalOptions="StartAndExpand"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{x:Static ResourceManager:AppResources.ProhibitedItems}"
                        TextColor="#0996D4"
                        TextDecorations="Underline">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTermsLinkCommand}" />
                        </Label.GestureRecognizers>

                    </Label>-->

                    <!--  Check Box  -->
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        Orientation="Horizontal"
                        Spacing="15">

                        <!--  Check box Image  -->
                        <Image
                            HeightRequest="20"
                            HorizontalOptions="Start"
                            Source="CheckMark.png"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="20">

                            <Image.Triggers>

                                <DataTrigger
                                    Binding="{Binding SubmitModel.travelerDeclaration.IsTermsChecked}"
                                    TargetType="Image"
                                    Value="True">
                                    <Setter Property="Source" Value="CheckMark.png" />
                                </DataTrigger>

                                <DataTrigger
                                    Binding="{Binding SubmitModel.travelerDeclaration.IsTermsChecked}"
                                    TargetType="Image"
                                    Value="False">
                                    <Setter Property="Source" Value="emptyCheck.png" />
                                </DataTrigger>

                            </Image.Triggers>

                        </Image>

                        <!--  Terms & Conditions  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="14"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.TermsConditions}"
                            TextColor="#232323" />

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckBoxCommand}" />
                        </StackLayout.GestureRecognizers>

                    </StackLayout>

                    <!--  Approve Declaration Button  -->
                    <buttons:SfButton
                        Margin="0,20"
                        Command="{Binding ApproveDeclarationCommand}"
                        FontFamily="{StaticResource SomarBold}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ApproveDeclaration}" />


                </StackLayout>

            </ScrollView>

        </yummy:PancakeView>

    </Grid>
</pages:PopupPage>

