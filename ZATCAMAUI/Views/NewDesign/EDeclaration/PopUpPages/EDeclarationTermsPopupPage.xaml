<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.PopUpPages.EDeclarationTermsPopupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    BackgroundColor="#88000000"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    FlowDirection="{Binding AppDirection}">


    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <Border
            Padding="0"
            BackgroundColor="White"
            HeightRequest="490"
            Stroke="{StaticResource NeutralLightGrey}"
            StrokeShape="RoundRectangle 15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid RowDefinitions="*">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout>

                        <!--#region Frame Contains Image and Text-->
                        <Border
                            Padding="20,25"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 14,14,14,14">

                            <StackLayout>
                                <!--  Header 1 Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="16"
                                    HorizontalOptions="Start"
                                    LineHeight="1"
                                    Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderOne}"
                                    TextColor="#002447"
                                    VerticalOptions="Start" />

                                <!--  Notes Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    LineHeight="1"
                                    TextColor="#002447">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="•  "
                                                TextColor="#002447" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}"
                                                TextColor="#002447" />
                                            <Span Text="&#10;" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="•  "
                                                TextColor="#002447" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsTwo}"
                                                TextColor="#002447" />
                                            <Span Text="&#10;" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="•  "
                                                TextColor="#002447" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsThree}"
                                                TextColor="#002447" />
                                            <Span Text="&#10;" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="•  "
                                                TextColor="#002447" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFour}"
                                                TextColor="#002447" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                                <!--  Header 2 Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="16"
                                    HorizontalOptions="Start"
                                    LineHeight="1"
                                    Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderTwo}"
                                    TextColor="#002447"
                                    VerticalOptions="Start" />

                                <!--  Notes Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    LineHeight="1"
                                    TextColor="#002447">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="•  "
                                                TextColor="#002447" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}"
                                                TextColor="#002447" />
                                            <Span Text="&#10;" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="•  "
                                                TextColor="#002447" />
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFive}"
                                                TextColor="#002447" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                            </StackLayout>



                        </Border>

                        <!--  Next Button  -->
                        <buttons:SfButton
                            Margin="0,20,0,50"
                            Command="{Binding GoToProductDeclarationCommand}"
                            FontFamily="{StaticResource SomarBold}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                    </StackLayout>

                </ScrollView>

            </Grid>
        </Border>

    </Grid>
</Mopups:PopupPage>

