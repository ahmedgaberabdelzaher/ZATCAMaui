<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.PopUpPages.EDeclarationTermsPopupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:RGPopup.Maui.Animations;assembly=RGPopup.Maui"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}">


    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <Border
            Padding="0"
            BackgroundColor="White"
            HeightRequest="490"
            StrokeShape="RoundRectangle 15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid RowDefinitions="*">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout>

                        <!--#region Frame Contains Image and Text-->
                        <Frame
                            Padding="20,25"
                            BorderColor="Transparent"
                            CornerRadius="15"
                            HasShadow="False">

                            <StackLayout>
                                <!--  Header 1 Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="16"
                                    HorizontalOptions="Start"
                                    LineHeight="1"
                                    Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderOne}"
                                    TextColor="#002447"
                                    VerticalOptions="Start" />

                                <!--  Notes Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    LineHeight="1"
                                    TextColor="#002447">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="•  " />
                                            <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}" />
                                            <Span Text="&#10;" />
                                            <Span Text="•  " />
                                            <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsTwo}" />
                                            <Span Text="&#10;" />
                                            <Span Text="•  " />
                                            <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsThree}" />
                                            <Span Text="&#10;" />
                                            <Span Text="•  " />
                                            <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFour}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                                <!--  Header 2 Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="16"
                                    HorizontalOptions="Start"
                                    LineHeight="1"
                                    Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderTwo}"
                                    TextColor="#002447"
                                    VerticalOptions="Start" />

                                <!--  Notes Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    LineHeight="1"
                                    TextColor="#002447">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="•  " />
                                            <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}" />
                                            <Span Text="&#10;" />
                                            <Span Text="•  " />
                                            <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFive}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                            </StackLayout>



                        </Frame>

                        <!--  Next Button  -->
                        <buttons:SfButton
                            Margin="0,20,0,50"
                            Command="{Binding GoToProductDeclarationCommand}"
                            FontFamily="{StaticResource SomarBold}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                    </StackLayout>

                </ScrollView>

            </Grid>
        </Border>

    </Grid>
</pages:PopupPage>

