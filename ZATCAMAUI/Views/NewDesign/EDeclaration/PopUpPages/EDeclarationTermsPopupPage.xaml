<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.PopUpPages.EDeclarationTermsPopupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:RGPopup.Maui.Animations;assembly=RGPopup.Maui"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    FlowDirection="{Binding AppDirection}">

    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>-->

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="25"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="490"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid RowDefinitions="*">

                <ScrollView  VerticalScrollBarVisibility="Never">

                <StackLayout>

                    <!--#region Frame Contains Image and Text-->
                    <Frame
                        Padding="25"
                        BorderColor="Transparent"
                        CornerRadius="15"
                        HasShadow="False">

                        <StackLayout>
                            <!--  Header 1 Label  -->
                            <custom:CustomLabel
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="16"
                                HorizontalOptions="Start"
                                LineSpacing="1"
                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderOne}"
                                TextColor="#002447"
                                VerticalOptions="Start" />

                            <!--  Notes Label  -->
                            <custom:CustomLabel
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                LineSpacing="1"
                                TextColor="#002447">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsTwo}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsThree}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFour}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>

                            </custom:CustomLabel>

                            <!--  Header 2 Label  -->
                            <custom:CustomLabel
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="16"
                                HorizontalOptions="Start"
                                LineSpacing="1"
                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderTwo}"
                                TextColor="#002447"
                                VerticalOptions="Start" />

                            <!--  Notes Label  -->
                            <custom:CustomLabel
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                LineSpacing="1"
                                TextColor="#002447">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFive}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>

                            </custom:CustomLabel>

                        </StackLayout>



                    </Frame>

                    <!--  Next Button  -->
                    <buttons:SfButton
                        Margin="0,20,0,50"
                        Command="{Binding GoToProductDeclarationCommand}"
                        FontFamily="{StaticResource SomarBold}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                </StackLayout>

            </ScrollView>

            </Grid>
        </yummy:PancakeView>

    </Grid>
</pages:PopupPage>

