<?xml version="1.0" encoding="UTF-8" ?>
<StackLayout
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews.ProductView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviour="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    IsVisible="false">

    <!--<StackLayout.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </StackLayout.Resources>-->

    <StackLayout.Triggers>
        <DataTrigger
            Binding="{Binding QFlow}"
            TargetType="StackLayout"
            Value="4">
            <Setter Property="IsVisible" Value="true" />
        </DataTrigger>
    </StackLayout.Triggers>

    <!--  TypeItem Field  -->
    <StackLayout Spacing="0">

        <!--  TypeItem Label  -->
        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.TypeItem}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
        </custom:CustomLabel>

        <!--  TypeItem Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
            <custom:GAZTBorderlessEntry
                InputTransparent="True"
                IsReadOnly="True"
                Keyboard="Text"
                Placeholder="{x:Static ResourceManager:AppResources.Select}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding SelectedProductTypes.Name}"
                TextColor="#58595B">

                <custom:GAZTBorderlessEntry.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                </custom:GAZTBorderlessEntry.GestureRecognizers>

            </custom:GAZTBorderlessEntry>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

        </inputLayout:SfTextInputLayout>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
        </StackLayout.GestureRecognizers>

    </StackLayout>

    <!--  ProductName Field  -->
    <StackLayout IsVisible="{Binding IsProductItemHaveSubType}" Spacing="0">

        <!--  ProductName Label  -->
        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.ProductName}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
        </custom:CustomLabel>

        <!--  ProductName Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
            <custom:GAZTBorderlessEntry
                InputTransparent="True"
                IsReadOnly="True"
                Keyboard="Text"
                Placeholder="{x:Static ResourceManager:AppResources.Select}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding SelectedProductSubTypes.Name}"
                TextColor="#58595B">

                <custom:GAZTBorderlessEntry.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                </custom:GAZTBorderlessEntry.GestureRecognizers>

            </custom:GAZTBorderlessEntry>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

        </inputLayout:SfTextInputLayout>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
        </StackLayout.GestureRecognizers>

    </StackLayout>

    <!--  Quantity Field  -->
    <StackLayout Spacing="0">

        <!--  Quantity Label  -->
        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.Quantity}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
        </custom:CustomLabel>

        <!--  Quantity Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
            InputViewPadding="16,0,16,0"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
            <custom:GAZTBorderlessEntry
                Keyboard="Numeric"
                Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding Quantity}"
                TextColor="#58595B">

                <custom:GAZTBorderlessEntry.Behaviors>
                    <behaviour:OnlyNumericValuesBehaviour />
                </custom:GAZTBorderlessEntry.Behaviors>

            </custom:GAZTBorderlessEntry>
        </inputLayout:SfTextInputLayout>

    </StackLayout>

    <!--  Quantity Field  -->
    <StackLayout Spacing="0">

        <!--  Quantity Label  -->
        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.TotalPriceValue}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
        </custom:CustomLabel>

        <!--  Total Value Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
            InputViewPadding="16,0,16,0"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
            <custom:GAZTBorderlessEntry
                Keyboard="Numeric"
                Placeholder="{x:Static ResourceManager:AppResources.TotalPriceValue}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding TotalValue}"
                TextColor="#58595B">

                <custom:GAZTBorderlessEntry.Behaviors>
                    <behaviour:OnlyNumericWithDecimalValuesBehaviour />
                </custom:GAZTBorderlessEntry.Behaviors>

            </custom:GAZTBorderlessEntry>

            <inputLayout:SfTextInputLayout.TrailingView>
                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
            </inputLayout:SfTextInputLayout.TrailingView>
        </inputLayout:SfTextInputLayout>

    </StackLayout>

</StackLayout>

