<?xml version="1.0" encoding="UTF-8" ?>
<StackLayout
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews.ProductView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:numericinput="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    IsVisible="false">
    <StackLayout.Triggers>
        <DataTrigger
            Binding="{Binding QFlow}"
            TargetType="StackLayout"
            Value="4">
            <Setter Property="IsVisible" Value="true" />
        </DataTrigger>
    </StackLayout.Triggers>

    <!--  TypeItem Field  -->
    <StackLayout Spacing="0">

        <!--  TypeItem Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.TypeItem}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  TypeItem Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            Hint="{x:Static ResourceManager:AppResources.Select}"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
            <custom:GAZTBorderlessEntry
                InputTransparent="True"
                IsReadOnly="True"
                Keyboard="Text"
                Placeholder="{x:Static ResourceManager:AppResources.Select}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding SelectedProductTypes.Name}"
                TextColor="#58595B">

                <custom:GAZTBorderlessEntry.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                </custom:GAZTBorderlessEntry.GestureRecognizers>

            </custom:GAZTBorderlessEntry>

            <inputLayout:SfTextInputLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
            </inputLayout:SfTextInputLayout.GestureRecognizers>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

        </inputLayout:SfTextInputLayout>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
        </StackLayout.GestureRecognizers>

    </StackLayout>

    <!--  ProductName Field  -->
    <StackLayout IsVisible="{Binding IsProductItemHaveSubType}" Spacing="0">

        <!--  ProductName Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.ProductName}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  ProductName Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            Hint="{x:Static ResourceManager:AppResources.Select}"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
            <custom:GAZTBorderlessEntry
                InputTransparent="True"
                IsReadOnly="True"
                Keyboard="Text"
                Placeholder="{x:Static ResourceManager:AppResources.Select}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding SelectedProductSubTypes.Name}"
                TextColor="#58595B">

                <custom:GAZTBorderlessEntry.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                </custom:GAZTBorderlessEntry.GestureRecognizers>

            </custom:GAZTBorderlessEntry>

            <inputLayout:SfTextInputLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
            </inputLayout:SfTextInputLayout.GestureRecognizers>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

        </inputLayout:SfTextInputLayout>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
        </StackLayout.GestureRecognizers>

    </StackLayout>

    <!--  Quantity Field  -->
    <StackLayout Spacing="0">

        <!--  Quantity Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.Quantity}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  Quantity Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            Hint="{x:Static ResourceManager:AppResources.Quantity}"
            HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>

            <numericinput:SfNumericEntry
                CustomFormat="N2"
                FontFamily="{StaticResource SomarRegular}"
                FontSize="15"
                HeightRequest="48"
                HorizontalOptions="FillAndExpand"
                Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                PlaceholderColor="{StaticResource NeutralGreay}"
                TextColor="#58595B"
                ValueChangeMode="OnKeyFocus"
                Value="{Binding Quantity}" />
        </inputLayout:SfTextInputLayout>


    </StackLayout>

    <!--  Total Value  Field  -->
    <StackLayout Spacing="0">

        <!--  Total Value  Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.TotalPriceValue}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  Total Value Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            Hint="{x:Static ResourceManager:AppResources.TotalPriceValue}"
            HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>

            <numericinput:SfNumericEntry
                CustomFormat="N2"
                FontFamily="{StaticResource SomarRegular}"
                FontSize="15"
                HeightRequest="48"
                HorizontalOptions="FillAndExpand"
                Placeholder="{x:Static ResourceManager:AppResources.TotalPriceValue}"
                PlaceholderColor="{StaticResource NeutralGreay}"
                TextColor="#58595B"
                ValueChangeMode="OnKeyFocus"
                Value="{Binding TotalValue}" />

            <inputLayout:SfTextInputLayout.TrailingView>
                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
            </inputLayout:SfTextInputLayout.TrailingView>
        </inputLayout:SfTextInputLayout>


    </StackLayout>

</StackLayout>

