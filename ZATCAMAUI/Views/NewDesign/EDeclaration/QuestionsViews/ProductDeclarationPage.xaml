<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews.ProductDeclarationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:questionsviews="clr-namespace:ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary>
                <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            </ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <!--  Back Button  -->
                <StackLayout>

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PrevoiusCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding HeaderTitle}"
                    VerticalOptions="Center" />

                <!--  Cart Image  -->
                <StackLayout
                    Grid.Column="2"
                    HorizontalOptions="End"
                    Spacing="0">

                    <!--  Count Label  -->
                    <Label
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding CardData.Count}"
                        TextColor="#4FBBBD"
                        VerticalOptions="End" />

                    <!--  Cart Image  -->
                    <Image
                        HorizontalOptions="End"
                        Source="eCart.png"
                        VerticalOptions="CenterAndExpand" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>


            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">
                    <ScrollView VerticalScrollBarVisibility="Never">

                        <StackLayout
                            Padding="10,0"
                            Spacing="8"
                            VerticalOptions="FillAndExpand">

                            <!--  Circle view  -->
                            <Grid
                                Margin="0,30,0,10"
                                ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                ColumnSpacing="0"
                                HorizontalOptions="CenterAndExpand"
                                RowDefinitions="Auto"
                                VerticalOptions="Start">

                                <!--  Circle button 1  -->
                                <buttons:SfButton
                                    Background="Transparent"
                                    CornerRadius="15"
                                    HeightRequest="30"
                                    HorizontalOptions="EndAndExpand"
                                    InputTransparent="True"
                                    Stroke="#0996D4"
                                    StrokeThickness="1"
                                    Text="1"
                                    TextColor="#0996D4"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="30">
                                    <buttons:SfButton.Padding>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="Android">0</On>
                                        </OnPlatform>
                                    </buttons:SfButton.Padding>

                                </buttons:SfButton>

                                <!--  Horizontal Line  -->
                                <BoxView
                                    Grid.Column="1"
                                    BackgroundColor="#B8BABA"
                                    HeightRequest="2"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="20" />

                                <!--  Circle button 2  -->
                                <buttons:SfButton
                                    Grid.Column="2"
                                    Background="Transparent"
                                    CornerRadius="15"
                                    HeightRequest="30"
                                    HorizontalOptions="StartAndExpand"
                                    InputTransparent="True"
                                    Stroke="#B8BABA"
                                    StrokeThickness="1"
                                    Text="2"
                                    TextColor="#565655"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="30">
                                    <buttons:SfButton.Padding>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="Android">0</On>
                                        </OnPlatform>
                                    </buttons:SfButton.Padding>

                                </buttons:SfButton>

                                <!--  Horizontal Line  -->
                                <BoxView
                                    Grid.Column="3"
                                    BackgroundColor="#B8BABA"
                                    HeightRequest="2"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="20" />

                                <!--  Circle button 3  -->
                                <buttons:SfButton
                                    Grid.Column="4"
                                    Background="Transparent"
                                    CornerRadius="15"
                                    HeightRequest="30"
                                    HorizontalOptions="StartAndExpand"
                                    InputTransparent="True"
                                    Stroke="#B8BABA"
                                    StrokeThickness="1"
                                    Text="3"
                                    TextColor="#565655"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="30">
                                    <buttons:SfButton.Padding>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="Android">0</On>
                                        </OnPlatform>
                                    </buttons:SfButton.Padding>

                                </buttons:SfButton>

                                <!--  Horizontal Line  -->
                                <BoxView
                                    Grid.Column="5"
                                    BackgroundColor="#B8BABA"
                                    HeightRequest="2"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="20" />

                                <!--  Circle button 4  -->
                                <buttons:SfButton
                                    Grid.Column="6"
                                    Background="Transparent"
                                    CornerRadius="15"
                                    HeightRequest="30"
                                    HorizontalOptions="StartAndExpand"
                                    InputTransparent="True"
                                    Stroke="#B8BABA"
                                    StrokeThickness="1"
                                    Text="4"
                                    TextColor="#565655"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="30">
                                    <buttons:SfButton.Padding>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="Android">0</On>
                                        </OnPlatform>
                                    </buttons:SfButton.Padding>

                                </buttons:SfButton>

                            </Grid>


                            <!--  AddingItems Label  -->
                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="24"
                                HorizontalOptions="StartAndExpand"
                                MaxLines="1"
                                Text="{x:Static ResourceManager:AppResources.AddingItems}"
                                TextColor="{StaticResource Primary}" />

                            <!--  Horizontal Line  -->
                            <BoxView
                                BackgroundColor="{StaticResource NeutralLightGrey}"
                                HeightRequest="1"
                                WidthRequest="350" />

                            <!--  Welcome Label for logged in only  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="20"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                                MaxLines="1"
                                Text="{x:Static ResourceManager:AppResources.Hi}"
                                TextColor="#0996D4" />

                            <!--  User Label for logged in only  -->
                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="20"
                                HorizontalOptions="StartAndExpand"
                                IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                                MaxLines="1"
                                Text="{Binding SubmitModel.travelerDeclaration.FullName}"
                                TextColor="{StaticResource Primary}" />

                            <!--  Question Title Field Label  -->
                            <Label
                                Margin="0,0,0,10"
                                FontSize="14"
                                LineHeight="1"
                                Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding Question}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Margin="0,0,0,10"
                                BackgroundColor="{StaticResource NeutralLightGrey}"
                                HeightRequest="1"
                                IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                                WidthRequest="350" />

                            <!--#region Questions View-->
                            <StackLayout>

                                <!--#region Hint view-->
                                <Border
                                    Padding="10"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    Stroke="#E6E6E6"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    VerticalOptions="StartAndExpand">

                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding QFlow}"
                                            TargetType="Border"
                                            Value="4">
                                            <Setter Property="IsVisible" Value="false" />

                                        </DataTrigger>

                                    </Border.Triggers>

                                    <StackLayout
                                        HorizontalOptions="Start"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalOptions="StartAndExpand">

                                        <!--  info icon  -->
                                        <Image
                                            Aspect="AspectFit"
                                            HeightRequest="20"
                                            HorizontalOptions="Start"
                                            Source="information.png"
                                            VerticalOptions="StartAndExpand"
                                            WidthRequest="20" />

                                        <!--  Question Hint Label  -->
                                        <Label
                                            FontSize="12"
                                            HorizontalOptions="StartAndExpand"
                                            LineHeight="1"
                                            Text="{x:Static ResourceManager:AppResources.ProductDeclarationDisclaimer}"
                                            TextColor="#999999">
                                            <Label.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding QFlow}"
                                                    TargetType="Label"
                                                    Value="2">
                                                    <Setter Property="Text" Value="" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding QFlow}"
                                                    TargetType="Label"
                                                    Value="3">
                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Q2Hint}" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding QFlow}"
                                                    TargetType="Label"
                                                    Value="4">

                                                    <Setter Property="IsVisible" Value="false" />
                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>

                                        <!--  Hint With Two Line  -->
                                        <StackLayout IsVisible="false">

                                            <StackLayout.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding QFlow}"
                                                    TargetType="StackLayout"
                                                    Value="2">
                                                    <Setter Property="IsVisible" Value="true" />
                                                </DataTrigger>

                                            </StackLayout.Triggers>

                                            <!--  Hint Label  -->
                                            <Label
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                LineHeight="1"
                                                Text="{x:Static ResourceManager:AppResources.DeclerationSecondSecurityQuestionYesHint}"
                                                TextColor="#999999" />

                                            <!--  View List Label  -->
                                            <Label
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                LineHeight="1"
                                                Text="{x:Static ResourceManager:AppResources.Viewlist}"
                                                TextColor="#002447"
                                                TextDecorations="Underline">

                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoToProhibitedGoodsLstURlCommand}" />
                                                </Label.GestureRecognizers>

                                            </Label>

                                        </StackLayout>

                                    </StackLayout>

                                </Border>
                                <!--#endregion Hint view-->

                                <!--#region TobacoProduct-->
                                <questionsviews:TobacoView />
                                <!--#endregion TobacoProduct-->

                                <!--#region ProductView-->
                                <questionsviews:ProductView />
                                <!--#endregion ProductView-->

                                <!--#region CurrencyView-->
                                <questionsviews:CurrencyView />
                                <!--#endregion CurrencyView-->

                                <!--#region Security Restricted QuestionView-->
                                <questionsviews:RestrictedView />

                                <!--#endregion RestrictedView-->

                            </StackLayout>
                            <!--#endregion Questions View-->

                            <!--#region Submit and Card-->
                            <StackLayout Margin="0,10" Spacing="10">
                                <!--  Add Item Button  -->
                                <buttons:SfButton
                                    Command="{Binding AddCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.AddItem}" />

                                <!--  Card Border  -->
                                <Border
                                    Padding="10"
                                    BackgroundColor="{StaticResource Primary}"
                                    HorizontalOptions="FillAndExpand"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    VerticalOptions="StartAndExpand">

                                    <StackLayout Orientation="Horizontal" Spacing="10">

                                        <Border
                                            Padding="10"
                                            BackgroundColor="White"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 10,10,10,10"
                                            VerticalOptions="Center">

                                            <!--  Total Number Label  -->
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                Style="{StaticResource CaptionLabelGrey}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span
                                                            FontFamily="{StaticResource SomarRegular}"
                                                            FontSize="14"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{Binding FeesCalculatorResponse.totalPayment, StringFormat='{0:n}'}" />
                                                        <Span Text="  " />
                                                        <Span
                                                            FontFamily="{StaticResource SomarRegular}"
                                                            FontSize="14"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                        </Border>

                                        <!--  Total Fees Payable Label  -->
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="14"
                                            HorizontalOptions="End"
                                            Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                            TextColor="White"
                                            VerticalOptions="CenterAndExpand" />

                                    </StackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </StackLayout>
                            <!--#endregion Submit and Card-->

                            <!--  GoTo Second Product Declaration Button  -->
                            <buttons:SfButton
                                Margin="0,5"
                                Command="{Binding NextCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZNext}"
                                VerticalOptions="EndAndExpand" />

                            <!--  Prevoius Button  -->
                            <buttons:SfButton
                                Margin="0,0,0,25"
                                Background="Transparent"
                                Command="{Binding PrevoiusCommand}"
                                FontFamily="{StaticResource SomarLight}"
                                Stroke="Transparent"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.PerviousButton}"
                                TextColor="{StaticResource Secondary}" />

                        </StackLayout>

                    </ScrollView>
                </Grid>
            </Border>
            <!--#endregion Body-->

            <!--  Bottom Sheet List  -->
            <custom:ListBottomSheet Grid.Row="1" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

