<?xml version="1.0" encoding="UTF-8" ?>
<StackLayout
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews.TobacoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:numericinput="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    IsVisible="false">

    <StackLayout.Triggers>
        <DataTrigger
            Binding="{Binding QFlow}"
            TargetType="StackLayout"
            Value="1">
            <Setter Property="IsVisible" Value="true" />
        </DataTrigger>
    </StackLayout.Triggers>

    <!--  TypeItem Field  -->
    <StackLayout Spacing="0">

        <!--  TypeItem Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TypeItem}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  TypeItem Entry  -->
        <custom:CustomSfTextInputView>
            <custom:CustomSfTextInputView.TextInputView>

                <custom:GAZTBorderlessEntry
                    x:Name="typeItemEntry"
                    InputTransparent="True"
                    IsReadOnly="True"
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding SelectedTobacoType.Name}"
                    TextColor="#58595B">

                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
                    </custom:GAZTBorderlessEntry.GestureRecognizers>

                </custom:GAZTBorderlessEntry>

            </custom:CustomSfTextInputView.TextInputView>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

            <inputLayout:SfTextInputLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
            </inputLayout:SfTextInputLayout.GestureRecognizers>

        </custom:CustomSfTextInputView>

        <Label
            Margin="0,-15,0,10"
            Style="{StaticResource CaptionLabelGrey}"
            Text="{x:Static ResourceManager:AppResources.TobacoTypeNotehint}" />

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
        </StackLayout.GestureRecognizers>


    </StackLayout>

    <!--  Tobaco Fields  -->
    <StackLayout Spacing="0">

        <!--  ProductName Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ProductName}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  ProductName Entry  -->
        <StackLayout>

            <custom:CustomSfTextInputView>
                <custom:CustomSfTextInputView.TextInputView>

                    <custom:GAZTBorderlessEntry
                        x:Name="productNameEntry"
                        InputTransparent="True"
                        IsReadOnly="True"
                        Keyboard="Text"
                        Placeholder="{x:Static ResourceManager:AppResources.Select}"
                        Style="{StaticResource DefaultEntry}"
                        Text="{Binding SelectedTobacoItem.Name}"
                        TextColor="#58595B">

                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
                        </custom:GAZTBorderlessEntry.GestureRecognizers>

                    </custom:GAZTBorderlessEntry>

                </custom:CustomSfTextInputView.TextInputView>


                <inputLayout:SfTextInputLayout.TrailingView>
                    <Image Aspect="AspectFit" Source="greyDropDown" />
                </inputLayout:SfTextInputLayout.TrailingView>

                <inputLayout:SfTextInputLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
                </inputLayout:SfTextInputLayout.GestureRecognizers>

            </custom:CustomSfTextInputView>

            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
            </StackLayout.GestureRecognizers>

        </StackLayout>

        <!--  Total Price Field  -->
        <StackLayout Spacing="0">

            <!--  Total Value Label  -->
            <Label Style="{StaticResource CaptionLabelGrey}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TotalPriceValue}" />
                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!--  Total Value Entry  -->
            <custom:CustomSfTextInputView>
                <custom:CustomSfTextInputView.TextInputView>

                    <numericinput:SfNumericEntry
                        BackgroundColor="Transparent"
                        CustomFormat="N2"
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="15"
                        HeightRequest="48"
                        HorizontalOptions="FillAndExpand"
                        Placeholder="{x:Static ResourceManager:AppResources.Productvalue}"
                        PlaceholderColor="{StaticResource NeutralGreay}"
                        ShowBorder="False"
                        TextColor="#58595B"
                        ValueChangeMode="OnKeyFocus"
                        VerticalOptions="FillAndExpand"
                        Value="{Binding TotalValue}" />

                </custom:CustomSfTextInputView.TextInputView>

                <inputLayout:SfTextInputLayout.HelperLabelStyle>
                    <inputLayout:LabelStyle TextColor="#58595B" />
                </inputLayout:SfTextInputLayout.HelperLabelStyle>

                <inputLayout:SfTextInputLayout.TrailingView>
                    <Label
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.FORM5SAR}"
                        WidthRequest="50" />
                </inputLayout:SfTextInputLayout.TrailingView>

            </custom:CustomSfTextInputView>

            <Label
                Margin="0,-15,0,10"
                Style="{StaticResource CaptionLabelGrey}"
                Text="{x:Static ResourceManager:AppResources.ProductValueHint}" />

        </StackLayout>

        <!--  Weight Field  -->
        <StackLayout IsVisible="{Binding IsWeighVisible}" Spacing="0">

            <!--  Weight Label  -->
            <StackLayout Orientation="Horizontal">

                <Label Style="{StaticResource CaptionLabelGrey}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Weight}" />
                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!--  MeasureUnit label  -->
                <Label
                    FontSize="14"
                    HorizontalOptions="EndAndExpand"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding SelectedTobacoItem.MeasureUnitName}" />

            </StackLayout>

            <!--  Weight Entry  -->
            <custom:CustomSfTextInputView>
                <custom:CustomSfTextInputView.TextInputView>

                    <numericinput:SfNumericEntry
                        BackgroundColor="Transparent"
                        CustomFormat="N2"
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="15"
                        HeightRequest="48"
                        HorizontalOptions="FillAndExpand"
                        Placeholder="{x:Static ResourceManager:AppResources.Weight}"
                        PlaceholderColor="{StaticResource NeutralGreay}"
                        ShowBorder="False"
                        TextColor="#58595B"
                        ValueChangeMode="OnKeyFocus"
                        VerticalOptions="FillAndExpand"
                        Value="{Binding Weight}" />

                </custom:CustomSfTextInputView.TextInputView>

                <inputLayout:SfTextInputLayout.HelperLabelStyle>
                    <inputLayout:LabelStyle TextColor="#58595B" />
                </inputLayout:SfTextInputLayout.HelperLabelStyle>

            </custom:CustomSfTextInputView>

            <Label
                Margin="0,-15,0,10"
                Style="{StaticResource CaptionLabelGrey}"
                Text="{x:Static ResourceManager:AppResources.NumberHint}" />

        </StackLayout>

        <!--  Quantity Field  -->
        <StackLayout Spacing="0">

            <!--  Quantity Label  -->
            <Label Style="{StaticResource CaptionLabelGrey}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Quantity}" />
                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!--  Quantity Entry  -->
            <custom:CustomSfTextInputView>
                <custom:CustomSfTextInputView.TextInputView>

                    <numericinput:SfNumericEntry
                        BackgroundColor="Transparent"
                        CustomFormat="N2"
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="15"
                        HeightRequest="48"
                        HorizontalOptions="FillAndExpand"
                        Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                        PlaceholderColor="{StaticResource NeutralGreay}"
                        ShowBorder="False"
                        TextColor="#58595B"
                        ValueChangeMode="OnKeyFocus"
                        VerticalOptions="FillAndExpand"
                        Value="{Binding Quantity}" />

                </custom:CustomSfTextInputView.TextInputView>

                <inputLayout:SfTextInputLayout.HelperLabelStyle>
                    <inputLayout:LabelStyle TextColor="#58595B" />
                </inputLayout:SfTextInputLayout.HelperLabelStyle>

            </custom:CustomSfTextInputView>

            <Label
                Margin="0,-15,0,10"
                Style="{StaticResource CaptionLabelGrey}"
                Text="{x:Static ResourceManager:AppResources.NumberHint}" />

        </StackLayout>

    </StackLayout>

</StackLayout>

