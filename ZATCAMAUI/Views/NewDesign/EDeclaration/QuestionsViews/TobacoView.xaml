<?xml version="1.0" encoding="UTF-8" ?>
<StackLayout
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews.TobacoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviour="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:numericinput="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    IsVisible="false">

    <!--<StackLayout.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </StackLayout.Resources>-->

    <StackLayout.Triggers>
        <DataTrigger
            Binding="{Binding QFlow}"
            TargetType="StackLayout"
            Value="1">
            <Setter Property="IsVisible" Value="true" />
        </DataTrigger>
    </StackLayout.Triggers>

    <!--  TypeItem Field  -->
    <StackLayout Spacing="0">

        <!--  TypeItem Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.TypeItem}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  TypeItem Entry  -->
        <inputLayout:SfTextInputLayout
            ContainerBackground="White"
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            LeadingViewPosition="Inside"
            IsHintAlwaysFloated="True"
            OutlineCornerRadius="15"
            Stroke="{StaticResource NeutralGreay}">
            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <inputLayout:LabelStyle TextColor="#B00020" />
            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
            <custom:GAZTBorderlessEntry
                x:Name="typeItemEntry"
                InputTransparent="True"
                IsReadOnly="True"
                Keyboard="Text"
                Placeholder="{x:Static ResourceManager:AppResources.Select}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding SelectedTobacoType.Name}"
                TextColor="#58595B">

                <custom:GAZTBorderlessEntry.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
                </custom:GAZTBorderlessEntry.GestureRecognizers>

            </custom:GAZTBorderlessEntry>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

             <inputLayout:SfTextInputLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
            </inputLayout:SfTextInputLayout.GestureRecognizers>

        </inputLayout:SfTextInputLayout>

         <Label
            Margin="3,-10,3,0"
            FontSize="12"
            Text="{x:Static ResourceManager:AppResources.TobacoTypeNotehint}"
            TextColor="#58595B" />

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
        </StackLayout.GestureRecognizers>


    </StackLayout>

    <!--  Tobaco Fields  -->
    <StackLayout Spacing="0">

        <!--  ProductName Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.ProductName}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  ProductName Entry  -->
        <StackLayout>

            <inputLayout:SfTextInputLayout
                ContainerBackground="White"
                ContainerType="Outlined"
                InputViewPadding="16,0,16,0"
                LeadingViewPosition="Inside"
                IsHintAlwaysFloated="True"
                OutlineCornerRadius="15"
                Stroke="{StaticResource NeutralGreay}">
                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <inputLayout:LabelStyle TextColor="#B00020" />
                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <custom:GAZTBorderlessEntry
                    x:Name="productNameEntry"
                    IsReadOnly="True"
                    InputTransparent="True"
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding SelectedTobacoItem.Name}"
                    TextColor="#58595B">

                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
                    </custom:GAZTBorderlessEntry.GestureRecognizers>

                </custom:GAZTBorderlessEntry>

                <inputLayout:SfTextInputLayout.TrailingView>
                    <Image Aspect="AspectFit" Source="greyDropDown" />
                </inputLayout:SfTextInputLayout.TrailingView>

                <inputLayout:SfTextInputLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
                </inputLayout:SfTextInputLayout.GestureRecognizers>
            </inputLayout:SfTextInputLayout>

            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
            </StackLayout.GestureRecognizers>

        </StackLayout>

        <!--  Total Price Field  -->
        <StackLayout Spacing="0">

            <!--  Total Value Label  -->
            <Label Style="{StaticResource CaptionLabelGrey}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static ResourceManager:AppResources.TotalPriceValue}" />
                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!--  Total Value Entry  -->
            <inputLayout:SfTextInputLayout
                ContainerBackground="White"
                ContainerType="Outlined"
                IsHintAlwaysFloated="True"
                InputViewPadding="16,0,16,0"
                LeadingViewPosition="Inside"
                OutlineCornerRadius="15"
                Stroke="{StaticResource NeutralGreay}">
                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <inputLayout:LabelStyle TextColor="#B00020" />
                </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                    <numericinput:SfNumericEntry
                        CustomFormat="N2"
                        ValueChangeMode="OnKeyFocus"
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="15"
                        HeightRequest="48"
                        HorizontalOptions="FillAndExpand"
                        Placeholder="{x:Static ResourceManager:AppResources.Productvalue}"
                        PlaceholderColor="{StaticResource NeutralGreay}"
                        TextColor="#58595B"
                        Value="{Binding TotalValue}" />

                  <inputLayout:SfTextInputLayout.TrailingView>
                        <Label
                            WidthRequest="50"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.FORM5SAR}"/>
                </inputLayout:SfTextInputLayout.TrailingView>

            </inputLayout:SfTextInputLayout>

            <Label
                Margin="3,-10,3,0"
                FontSize="12"
                Text="{x:Static ResourceManager:AppResources.ProductValueHint}"
                TextColor="#58595B" />

        </StackLayout>

        <!--  Weight Field  -->
        <StackLayout IsVisible="{Binding IsWeighVisible}" Spacing="0">

            <!--  Weight Label  -->
            <StackLayout Orientation="Horizontal">

                <Label Style="{StaticResource CaptionLabelGrey}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static ResourceManager:AppResources.Weight}" />
                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!--  MeasureUnit label  -->
                <Label
                    FontSize="14"
                    HorizontalOptions="EndAndExpand"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding SelectedTobacoItem.MeasureUnitName}" />

            </StackLayout>

            <!--  Weight Entry  -->
            <inputLayout:SfTextInputLayout
                ContainerBackground="White"
                IsHintAlwaysFloated="True"
                ContainerType="Outlined"
                InputViewPadding="16,0,16,0"
                LeadingViewPosition="Inside"
                OutlineCornerRadius="15"
                Stroke="{StaticResource NeutralGreay}">
                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <inputLayout:LabelStyle TextColor="#B00020" />
                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <numericinput:SfNumericEntry
                    CustomFormat="N2"
                    ValueChangeMode="OnKeyFocus"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HeightRequest="48"
                    Placeholder="{x:Static ResourceManager:AppResources.Weight}"
                    PlaceholderColor="{StaticResource NeutralGreay}"
                    TextColor="#58595B"
                    Value="{Binding Weight}" />

            </inputLayout:SfTextInputLayout>

             <Label
                Margin="3,-10,3,0"
                FontSize="12"
                Text="{x:Static ResourceManager:AppResources.NumberHint}"
                TextColor="#58595B" />

        </StackLayout>

        <!--  Quantity Field  -->
        <StackLayout Spacing="0">

            <!--  Quantity Label  -->
            <Label Style="{StaticResource CaptionLabelGrey}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static ResourceManager:AppResources.Quantity}" />
                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!--  Quantity Entry  -->
            <inputLayout:SfTextInputLayout
                ContainerBackground="White"
                ContainerType="Outlined"
                IsHintAlwaysFloated="True"
                InputViewPadding="16,0,16,0"
                LeadingViewPosition="Inside"
                OutlineCornerRadius="15"
                Stroke="{StaticResource NeutralGreay}">
                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                    <inputLayout:LabelStyle TextColor="#B00020" />
                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                <numericinput:SfNumericEntry
                    CustomFormat="N2"
                    ValueChangeMode="OnKeyFocus"
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HeightRequest="48"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                    PlaceholderColor="{StaticResource NeutralGreay}"
                    TextColor="#58595B"
                    Value="{Binding Quantity}" />

            </inputLayout:SfTextInputLayout>

             <Label
                Margin="3,-10,3,0"
                FontSize="12"
                Text="{x:Static ResourceManager:AppResources.NumberHint}"
                TextColor="#58595B" />

        </StackLayout>

    </StackLayout>

</StackLayout>

