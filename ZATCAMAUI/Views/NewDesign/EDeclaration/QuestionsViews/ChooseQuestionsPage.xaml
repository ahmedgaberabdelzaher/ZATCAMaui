<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews.ChooseQuestionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <ResourceDictionary>
                <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            </ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PrevoiusCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding HeaderTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Padding="10">

                        <!--  AddingItems Label  -->
                        <Label
                            Margin="0,20"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            Text="{x:Static ResourceManager:AppResources.AddingItems}"
                            TextColor="{StaticResource Primary}" />


                        <!--  Welcome Label for logged in only  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="20"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            MaxLines="1"
                            Text="{x:Static ResourceManager:AppResources.Hi}"
                            TextColor="#0996D4" />

                        <!--  User Label for logged in only  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="20"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            MaxLines="1"
                            Text="{Binding SubmitModel.travelerDeclaration.FullName}"
                            TextColor="{StaticResource Primary}" />

                        <!--#region Question view-->
                        <StackLayout
                            x:Name="itemList"
                            BindableLayout.ItemsSource="{Binding QuestionList}"
                            Spacing="25">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate>

                                    <Frame
                                        x:Name="selectedItem"
                                        Padding="10"
                                        BackgroundColor="{Binding QuestionBackgroundColor}"
                                        BorderColor="#E6E6E6"
                                        CornerRadius="10"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="StartAndExpand">

                                        <StackLayout
                                            Margin="0,0,0,25"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal"
                                            Spacing="15">

                                            <!--  Check Box  -->
                                            <Image
                                                HeightRequest="20"
                                                HorizontalOptions="Start"
                                                Source="emptyCheck.png"
                                                Style="{DynamicResource BackButtonArrow}"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="20">

                                                <Image.Triggers>

                                                    <DataTrigger
                                                        Binding="{Binding IsChecked}"
                                                        TargetType="Image"
                                                        Value="false">
                                                        <Setter Property="Source" Value="emptyCheck.png" />
                                                    </DataTrigger>

                                                    <DataTrigger
                                                        Binding="{Binding IsChecked}"
                                                        TargetType="Image"
                                                        Value="true">
                                                        <Setter Property="Source" Value="CheckMark.png" />
                                                    </DataTrigger>

                                                </Image.Triggers>

                                            </Image>

                                            <!--  Question Text Label  -->
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="14"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{Binding QuestionName}"
                                                TextColor="#002447">

                                                <Label.Triggers>

                                                    <DataTrigger
                                                        Binding="{Binding IsChecked}"
                                                        TargetType="Label"
                                                        Value="true">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsChecked}"
                                                        TargetType="Label"
                                                        Value="false">
                                                        <Setter Property="TextColor" Value="#002447" />
                                                    </DataTrigger>

                                                </Label.Triggers>

                                            </Label>

                                        </StackLayout>

                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference itemList}, Path=BindingContext}"
                                                Command="{Binding SelectedCheckBoxQuestionsCommand}"
                                                CommandParameter="{Binding Source={x:Reference selectedItem}, Path=BindingContext}" />
                                        </Frame.GestureRecognizers>

                                        <Frame.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsChecked}"
                                                TargetType="Frame"
                                                Value="true">
                                                <Setter Property="BackgroundColor" Value="#0996D4" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding IsChecked}"
                                                TargetType="Frame"
                                                Value="false">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </DataTrigger>

                                        </Frame.Triggers>

                                    </Frame>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </StackLayout>

                        <!--#endregion Question view-->

                        <!--  GoTo Question View Button  -->
                        <buttons:SfButton
                            Margin="0,25,0,8"
                            Command="{Binding GoToSelectedQuestionsViewCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}"
                            VerticalOptions="EndAndExpand" />

                        <!--  Pervious Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            Background="Transparent"
                            Command="{Binding BackCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Stroke="Transparent"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PerviousButton}"
                            TextColor="{StaticResource Secondary}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>

