<?xml version="1.0" encoding="UTF-8" ?>
<StackLayout
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews.CurrencyView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:numericinput="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    IsVisible="false">


    <StackLayout.Triggers>
        <DataTrigger
            Binding="{Binding QFlow}"
            TargetType="StackLayout"
            Value="3">

            <Setter Property="IsVisible" Value="true" />

        </DataTrigger>
    </StackLayout.Triggers>

    <!--#region MaterialType Entry-->
    <StackLayout Spacing="0">

        <!--  MaterialType Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.MaterialType}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  MaterialType Entry  -->
        <custom:CustomSfTextInputView >
            <custom:CustomSfTextInputView.TextInputView>

                 <custom:GAZTBorderlessEntry
                    InputTransparent="True"
                    IsReadOnly="True"
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding SelectedMaterialTypes.Name}"
                    TextColor="#58595B">

                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMaterialTypesCommand}" />
                    </custom:GAZTBorderlessEntry.GestureRecognizers>

                </custom:GAZTBorderlessEntry>

            </custom:CustomSfTextInputView.TextInputView>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

            <inputLayout:SfTextInputLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenMaterialTypesCommand}" />
            </inputLayout:SfTextInputLayout.GestureRecognizers>

        </custom:CustomSfTextInputView>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenMaterialTypesCommand}" />
        </StackLayout.GestureRecognizers>

    </StackLayout>
    <!--#endregion MaterialType Entry-->

    <!--#region Purpose View-->
    <StackLayout>
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.Purpose}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <custom:CustomSfTextInputView >
            <custom:CustomSfTextInputView.TextInputView>

                <custom:GAZTBorderlessEntry
                    InputTransparent="True"
                    IsReadOnly="True"
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding SelectedPurposes.Name}"
                    TextColor="#58595B">

                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPurposesCommand}" />
                    </custom:GAZTBorderlessEntry.GestureRecognizers>

                </custom:GAZTBorderlessEntry>

            </custom:CustomSfTextInputView.TextInputView>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

            <inputLayout:SfTextInputLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenPurposesCommand}" />
            </inputLayout:SfTextInputLayout.GestureRecognizers>

        </custom:CustomSfTextInputView>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenPurposesCommand}" />
        </StackLayout.GestureRecognizers>

    </StackLayout>
    <!--#endregion Purpose View-->

    <!--#region Other Purpose Field-->
    <StackLayout IsVisible="false" Spacing="0">

        <StackLayout.Triggers>
            <DataTrigger
                Binding="{Binding SelectedPurposes.ID}"
                TargetType="StackLayout"
                Value="8">
                <Setter Property="IsVisible" Value="true" />
            </DataTrigger>
        </StackLayout.Triggers>

        <!--  Other Purpose Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.OtherPurpose}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  Other Purpose Entry  -->
        <custom:CustomSfTextInputView >
            <custom:CustomSfTextInputView.TextInputView>

               <custom:GAZTBorderlessEntry
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.OtherPurpose}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding OtherPurpose}"
                    TextColor="#58595B" />

            </custom:CustomSfTextInputView.TextInputView>

        </custom:CustomSfTextInputView>

    </StackLayout>
    <!--#endregion Other Purpose Field-->

    <!--#region TotalValue Field-->
    <StackLayout Spacing="0">

        <!--  Quantity Label  -->
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.TotalPriceValue}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!--  Total Value Entry  -->
        <custom:CustomSfTextInputView>
            <custom:CustomSfTextInputView.TextInputView>

                 <numericinput:SfNumericEntry
                    CustomFormat="N2"
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HeightRequest="48"
                    VerticalOptions="FillAndExpand"
                    HorizontalOptions="FillAndExpand"
                    Placeholder="{x:Static ResourceManager:AppResources.TotalPriceValue}"
                    PlaceholderColor="{StaticResource NeutralGreay}"
                    TextColor="#58595B"
                    ValueChangeMode="OnKeyFocus"
                    ShowBorder="False"
                    BackgroundColor="Transparent"
                    Value="{Binding TotalValue}" />

            </custom:CustomSfTextInputView.TextInputView>

            <inputLayout:SfTextInputLayout.HelperLabelStyle>
                <inputLayout:LabelStyle TextColor="#58595B" />
            </inputLayout:SfTextInputLayout.HelperLabelStyle>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
            </inputLayout:SfTextInputLayout.TrailingView>

        </custom:CustomSfTextInputView>

        <Label Text="{x:Static ResourceManager:AppResources.NumberHint}"
               Margin="0,-15,0,10"
               Style="{StaticResource CaptionLabelGrey}"/>

    </StackLayout>
    <!--#endregion TotalValue Field-->

    <!--  Currency Label  -->
    <StackLayout>
        <Label Style="{StaticResource CaptionLabelGrey}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.Currency}" />
                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <custom:CustomSfTextInputView >
            <custom:CustomSfTextInputView.TextInputView>

                <custom:GAZTBorderlessEntry
                    InputTransparent="True"
                    IsReadOnly="True"
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding SelectedCurrencie.Name}"
                    TextColor="#58595B">
                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCurrenciesCommand}" />
                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                </custom:GAZTBorderlessEntry>

            </custom:CustomSfTextInputView.TextInputView>

            <inputLayout:SfTextInputLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCurrenciesCommand}" />
            </inputLayout:SfTextInputLayout.GestureRecognizers>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

        </custom:CustomSfTextInputView>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCurrenciesCommand}" />
        </StackLayout.GestureRecognizers>

    </StackLayout>

    <!--  Permit Label  -->
    <Label Style="{StaticResource CaptionLabelGrey}">
        <Label.FormattedText>
            <FormattedString>
                <Span Text="{x:Static ResourceManager:AppResources.CurrencyPermitLabel}" />
                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
            </FormattedString>
        </Label.FormattedText>
    </Label>

    <Grid ColumnDefinitions="*,15,*" HeightRequest="100">

        <!--#region Yes Option-->
        <Grid Grid.Column="0">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectIsCurrencyPermitCommand}" CommandParameter="1" />
            </Grid.GestureRecognizers>

            <Image
                HeightRequest="136"
                Source="QSelected"
                WidthRequest="171">

                <Image.Triggers>
                    <DataTrigger
                        Binding="{Binding IsCurrencyPermit}"
                        TargetType="Image"
                        Value="false">
                        <Setter Property="Source" Value="QUnselected" />
                    </DataTrigger>
                </Image.Triggers>

            </Image>

            <Label
                Margin="25,10,25,15"
                FontSize="16"
                Text="{x:Static ResourceManager:AppResources.ZYes}"
                TextColor="#FFFFFF"
                VerticalOptions="EndAndExpand">
                <Label.Triggers>

                    <DataTrigger
                        Binding="{Binding IsCurrencyPermit}"
                        TargetType="Label"
                        Value="false">
                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                    </DataTrigger>

                </Label.Triggers>
            </Label>

        </Grid>
        <!--#endregion Yes Option-->

        <!--#region NO Option-->
        <Grid Grid.Column="2">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectIsCurrencyPermitCommand}" CommandParameter="0" />
            </Grid.GestureRecognizers>

            <Image Source="QUnselected.png" VerticalOptions="FillAndExpand">

                <Image.Triggers>

                    <DataTrigger
                        Binding="{Binding IsCurrencyPermit}"
                        TargetType="Image"
                        Value="false">
                        <Setter Property="Source" Value="QSelected" />
                    </DataTrigger>

                </Image.Triggers>
            </Image>

            <Label
                Margin="25,10,25,15"
                FontSize="16"
                Text="{x:Static ResourceManager:AppResources.ZNo}"
                TextColor="{StaticResource Primary}"
                VerticalOptions="EndAndExpand">

                <Label.Triggers>
                    <DataTrigger
                        Binding="{Binding IsCurrencyPermit}"
                        TargetType="Label"
                        Value="false">
                        <Setter Property="TextColor" Value="#FFFFFF" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>
        <!--#endregion NO Option-->

    </Grid>
    <!--#endregion Permit Label-->

    <!--#region Upload File-->
    <StackLayout IsVisible="{Binding IsCurrencyPermit}">

        <!--  Uploaded file Field  -->
        <StackLayout Spacing="0">

            <!--  Uploaded files Label  -->
            <Label Style="{StaticResource CaptionLabelGrey}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static ResourceManager:AppResources.Attachments}" />
                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!--  Uploaded files Entry  -->
            <custom:CustomSfTextInputView >
                <custom:CustomSfTextInputView.TextInputView>

                    <custom:GAZTBorderlessEntry
                        InputTransparent="True"
                        IsReadOnly="True"
                        Keyboard="Text"
                        Placeholder="{x:Static ResourceManager:AppResources.Addattachments}"
                        Style="{StaticResource DefaultEntry}"
                        TextColor="#58595B" />

                </custom:CustomSfTextInputView.TextInputView>

                <inputLayout:SfTextInputLayout.TrailingView>
                    <Image Aspect="AspectFit" Source="newui_ic_pdf" />
                </inputLayout:SfTextInputLayout.TrailingView>

                <inputLayout:SfTextInputLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CurrencyUploadFileCommand}" />
                </inputLayout:SfTextInputLayout.GestureRecognizers>

            </custom:CustomSfTextInputView>

             <Label Text="{x:Static ResourceManager:AppResources.PDFFileHintMB}"
               Margin="0,-15,0,10"
               Style="{StaticResource CaptionLabelGrey}"/>

            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CurrencyUploadFileCommand}" />
            </StackLayout.GestureRecognizers>

        </StackLayout>

        <!--  PDfUploaded List  -->
        <StackLayout Spacing="0">

            <!--  Files List  -->
            <StackLayout
                x:Name="filesLst"
                BindableLayout.ItemsSource="{Binding CurrencyUploadedFiles}"
                Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <StackLayout x:Name="Item">

                            <!--  PDfUploaded Entry  -->
                            <custom:CustomSfTextInputView >
                                <custom:CustomSfTextInputView.TextInputView>

                                    <custom:GAZTBorderlessEntry
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding fileFullName}"
                                        TextColor="#58595B" />

                                </custom:CustomSfTextInputView.TextInputView>

                                 <inputLayout:SfTextInputLayout.LeadingView>
                                    <Image Aspect="AspectFit" Source="Generic_attachment_icon" />
                                </inputLayout:SfTextInputLayout.LeadingView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="reportClose.png">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"
                                                Command="{Binding DeleteAttatchementCommand}"
                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>

                            </custom:CustomSfTextInputView>

                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                
                               

                            </inputLayout:SfTextInputLayout>
                        </StackLayout>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

        </StackLayout>

    </StackLayout>
    <!--#endregion Upload File-->

</StackLayout>

