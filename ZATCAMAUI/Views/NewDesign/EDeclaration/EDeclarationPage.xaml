<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.EDeclarationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    HasBackButton="True"
    TitleText="{x:Static ResourceManager:AppResources.eDeclaration}">
    <newdesign:BaseContentPage.PancakeView>
        <ScrollView VerticalScrollBarVisibility="Never">
            <StackLayout Padding="15">

                <!--#region Header-->

                <!--  Product Declaration Label  -->
                <Label
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="24"
                    HorizontalOptions="StartAndExpand"
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    TextColor="{StaticResource Primary}" />

                <!--  Declaration Note Label  -->
                <Label
                    Margin="0,0,0,10"
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    LineHeight="1"
                    Style="{StaticResource CaptionLabelGrey}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span
                                FontSize="14"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.NewDeclarationNote}"
                                TextColor="{StaticResource NeutralGreay}" />
                            <Span Text=" " />
                            <Span
                                FontSize="14"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.CustomDeclarationInformation}"
                                TextColor="{StaticResource Primary}" />
                        </FormattedString>
                    </Label.FormattedText>

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCustomInformationLinkCommand}" />
                    </Label.GestureRecognizers>

                </Label>


                <!--  Horizontal Line  -->
                <BoxView
                    Margin="0,0,0,0"
                    BackgroundColor="{StaticResource NeutralLightGrey}"
                    HeightRequest="1" />

                <!--#endregion-->

                <!--  Identity type Label  -->
                <Label Margin="0,18,0,6" Style="{StaticResource CaptionLabelGrey}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Identitytype}" />
                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!--#region Visitor&Citizen/Review previous Options-->
                <VerticalStackLayout Spacing="20">

                    <!--#region Visitor/Citizen Options-->
                    <HorizontalStackLayout Spacing="10">

                        <!--#region Visitor Option-->
                        <Grid HeightRequest="140" WidthRequest="160">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelcectIdentityTypeCommand}" CommandParameter="1" />
                            </Grid.GestureRecognizers>

                            <Image Aspect="Fill" Source="UnselectedCard">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IdentityType}"
                                        TargetType="Image"
                                        Value="1">
                                        <Setter Property="Source" Value="Unselected" />
                                        <Setter Property="WidthRequest" Value="150" />
                                        <Setter Property="HeightRequest" Value="140" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>

                            <Image
                                Margin="17,25,17,10"
                                HeightRequest="33"
                                HorizontalOptions="Start"
                                Source="unselectedvisitor.png"
                                VerticalOptions="Start"
                                WidthRequest="30">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IdentityType}"
                                        TargetType="Image"
                                        Value="1">
                                        <Setter Property="Source" Value="visitor" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>

                            <Label
                                Margin="25,10,25,15"
                                FontSize="16"
                                Text="{x:Static ResourceManager:AppResources.Visitor}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="EndAndExpand">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IdentityType}"
                                        TargetType="Label"
                                        Value="1">
                                        <Setter Property="TextColor" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                        <!--#endregion Visitor-->

                        <!--#region Citizen Option-->
                        <Grid HeightRequest="140" WidthRequest="160">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelcectIdentityTypeCommand}" CommandParameter="2" />

                            </Grid.GestureRecognizers>

                            <Image Aspect="Fill" Source="UnselectedCard.png">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IdentityType}"
                                        TargetType="Image"
                                        Value="2">
                                        <Setter Property="Source" Value="Unselected" />
                                        <Setter Property="WidthRequest" Value="150" />
                                        <Setter Property="HeightRequest" Value="140" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>

                            <Image
                                Margin="17,25,17,10"
                                HeightRequest="33"
                                HorizontalOptions="Start"
                                Source="citizien.png"
                                VerticalOptions="Start"
                                WidthRequest="30">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IdentityType}"
                                        TargetType="Image"
                                        Value="2">
                                        <Setter Property="Source" Value="unselectedcitizien" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>

                            <Label
                                Margin="25,10,25,15"
                                FontSize="16"
                                Text="{x:Static ResourceManager:AppResources.Citizen}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="EndAndExpand">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IdentityType}"
                                        TargetType="Label"
                                        Value="2">
                                        <Setter Property="TextColor" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                        </Grid>
                        <!--#endregion Citizen-->

                    </HorizontalStackLayout>
                    <!--#endregion Visitor/Citizen-->

                    <!--#region Review previous Option-->
                    <Grid
                        HeightRequest="150"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="160">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ReviewPreviousCommand}" />

                        </Grid.GestureRecognizers>

                        <Image Aspect="Fill" Source="UnselectedCard.png">
                            <Image.Triggers>
                                <DataTrigger
                                    Binding="{Binding ShowReviewEntries}"
                                    TargetType="Image"
                                    Value="true">
                                    <Setter Property="Source" Value="Unselected" />
                                    <Setter Property="WidthRequest" Value="160" />
                                    <Setter Property="HeightRequest" Value="150" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>

                        <Image
                            Margin="17,25,17,10"
                            HeightRequest="33"
                            HorizontalOptions="Start"
                            Source="reviewapreviousrequest"
                            VerticalOptions="Start"
                            WidthRequest="30">
                            <Image.Triggers>
                                <DataTrigger
                                    Binding="{Binding ShowReviewEntries}"
                                    TargetType="Image"
                                    Value="true">
                                    <Setter Property="Source" Value="unselectedreviewapreviousrequest.png" />

                                </DataTrigger>
                            </Image.Triggers>
                        </Image>

                        <Label
                            Margin="25,10,25,15"
                            FontSize="16"
                            LineBreakMode="WordWrap"
                            Text="{x:Static ResourceManager:AppResources.Reviewapreviousrequest}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="EndAndExpand">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding ShowReviewEntries}"
                                    TargetType="Label"
                                    Value="true">
                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                    </Grid>
                    <!--#endregion Review previous-->

                </VerticalStackLayout>
                <!--#endregion Visitor&Citizen/Review previous View-->

                <!--#region Review Option Entries-->
                <StackLayout Padding="0" IsVisible="{Binding ShowReviewEntries}">


                    <!--  Reference Number Field  -->
                    <StackLayout Spacing="0">

                        <!--  Reference Number Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentReferenceNumber}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!--  Reference Number Entry  -->
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ZakatInstalmentReferenceNumber}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding ReferenceNumber}"
                                    TextColor="#58595B" />
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>
                    </StackLayout>

                    <!--  ID/Passport Field  -->
                    <StackLayout Spacing="0">

                        <!--  ID/Passport Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.IDResidencePassportNumber}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!--  ID/Passport Entry  -->
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.IDResidencePassportNumber}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding IDResidencePassportNumber}"
                                    TextColor="#58595B" />
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>
                    </StackLayout>

                    <!--  GoTo Review Page Button  -->
                    <buttons:SfButton
                        Margin="0,5"
                        Command="{Binding GoToReviewPageCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ReviewRequest}"
                        VerticalOptions="EndAndExpand" />

                    <!--  Pervious Button  -->
                    <buttons:SfButton
                        Margin="0,0,0,25"
                        Background="Transparent"
                        Command="{Binding BackCommand}"
                        FontFamily="{StaticResource SomarLight}"
                        Stroke="Transparent"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.PerviousButton}"
                        TextColor="{StaticResource Secondary}" />

                </StackLayout>
                <!--#endregion Review Option Entries-->

            </StackLayout>
        </ScrollView>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

