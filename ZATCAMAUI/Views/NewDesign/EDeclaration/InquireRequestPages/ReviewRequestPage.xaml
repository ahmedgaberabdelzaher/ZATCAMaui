<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EDeclaration.InquireRequestPages.ReviewRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand">


                        <!--  EDeclaration Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                            TextColor="{StaticResource Primary}" />

                        <!--  EDeclaration Note Label  -->
                        <Label
                            Margin="0,0,0,5"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ElectronicDeclaration}"
                            TextColor="{StaticResource NeutralGreay}" />

                        <!--  Horizontal Line  -->
                        <BoxView
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2"
                            WidthRequest="20" />

                        <!--#region Disclaimer-->
                        <Frame
                            Margin="0,0,0,5"
                            Padding="5"
                            BackgroundColor="#FCECCD"
                            BorderColor="#FCECCD"
                            CornerRadius="8"
                            HasShadow="False"
                            Style="{StaticResource CommonTopCurves}">

                            <StackLayout Orientation="Horizontal" Spacing="8">

                                <!--  Check Mark Image  -->
                                <Image Aspect="AspectFit" Source="OrangeCircle" />

                                <!--  Feedback Name Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Inquire.FeedbackName}"
                                    TextColor="#F5BF58" />

                            </StackLayout>

                        </Frame>
                        <!--#endregion Disclaimer-->

                        <!--#region Frame Declaration Values-->
                        <Frame
                            Margin="0,0,0,10"
                            Padding="15"
                            BorderColor="#EBEBEB"
                            CornerRadius="15"
                            HasShadow="False"
                            Style="{StaticResource CommonTopCurves}">

                            <!--  Frame Content  -->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal" Spacing="0">

                                    <!--  Doc Image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25" />

                                    <!--  Declaration Label  -->
                                    <custom:CustomLabel
                                        Padding="10"
                                        FontSize="20"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.FORM5Declaration}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2"
                                    HorizontalOptions="FillAndExpand"
                                    WidthRequest="20" />

                                <!--#region Declaration Values-->
                                <Grid
                                    ColumnDefinitions="2*,*"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                    RowSpacing="15">

                                    <!--  Reference number Label  -->
                                    <custom:CustomLabel
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmentReferenceNumber}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Reference number value Label  -->
                                    <custom:CustomLabel
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Inquire.ReferenceID}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Payment Status Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding Inquire.paymentIsRequired}"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentPaymentStatus}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Payment status value Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding Inquire.paymentIsRequired}"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        VerticalOptions="Start">

                                        <custom:CustomLabel.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Inquire.IsNotPaid}"
                                                TargetType="custom:CustomLabel"
                                                Value="True">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.NotPaidPaymentStatus}" />

                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding Inquire.IsNotPaid}"
                                                TargetType="custom:CustomLabel"
                                                Value="false">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.PaidPaymentStatus}" />

                                            </DataTrigger>

                                        </custom:CustomLabel.Triggers>

                                    </custom:CustomLabel>


                                    <!--  Name Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="2"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.ZZName}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Name value Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Inquire.fullName}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="3"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TravellerPassport}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport value Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Inquire.travelID}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Coming/Going from/to Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="4"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.ArrivingFromORDepartingTo}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Coming/Going from/to Value Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Inquire.ArrivingName}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Port Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="5"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.Port}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Port value Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Inquire.PortName}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />



                                    <!--  Trip number Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="6"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TripNumber}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Trip number value Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Inquire.flightNumber}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="7"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TripDate}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <custom:CustomLabel
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Inquire.TravelDateString}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </Grid>
                                <!--#endregion Declaration Values-->

                            </StackLayout>

                        </Frame>
                        <!--#endregion Frame Declaration Values-->

                        <!--#region Frame Contains Fees-->
                        <Frame
                            Margin="0,0,0,10"
                            Padding="15"
                            BorderColor="#EBEBEB"
                            CornerRadius="15"
                            HasShadow="False"
                            Style="{StaticResource CommonTopCurves}">

                            <!--  Frame Content  -->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal" Spacing="0">

                                    <!--  Doc Image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25" />

                                    <!--  Total fees Label  -->
                                    <custom:CustomLabel
                                        Padding="10"
                                        FontSize="20"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2"
                                    HorizontalOptions="FillAndExpand"
                                    WidthRequest="20" />

                                <!--#region Payment Values-->
                                <StackLayout x:Name="inquireList" BindableLayout.ItemsSource="{Binding InquireList}">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <!--  Items List  -->
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                                                <!--  Item Name Label  -->
                                                <custom:CustomLabel
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="Start"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Name}"
                                                    TextColor="#999999"
                                                    VerticalOptions="Start" />

                                                <!--  Count value Label  -->
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="End"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Id}"
                                                    TextColor="#002447"
                                                    VerticalOptions="Start" />

                                            </Grid>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </StackLayout>
                                <!--#endregion Payment Values-->

                                <Grid ColumnDefinitions="2*,*">

                                    <!--  Total amount Label  -->
                                    <custom:CustomLabel
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        LineBreakMode="WordWrap"
                                        Text="{x:Static ResourceManager:AppResources.TotalAmount}"
                                        TextColor="#999999"
                                        VerticalOptions="Start" />

                                    <!--  Total amount value in words Label  -->
                                    <custom:CustomLabel
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="14"
                                        HorizontalOptions="End"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        VerticalOptions="Start">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Inquire.totalFees}" />
                                                <Span Text="  " />
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>

                                    </custom:CustomLabel>

                                </Grid>

                            </StackLayout>

                        </Frame>
                        <!--#endregion Frame Contains Fees-->

                        <!--#region Frame Contains Details Fees-->
                        <Frame
                            Margin="0,0,0,15"
                            Padding="15"
                            BorderColor="#EBEBEB"
                            CornerRadius="15"
                            Style="{StaticResource CommonTopCurves}">

                            <!--  Frame Content  -->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal" Spacing="0">

                                    <!--  Doc Image  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25" />

                                    <!--  Details Total fees Label  -->
                                    <custom:CustomLabel
                                        Padding="10"
                                        FontSize="20"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.DetailsTotalFeesPayable}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2"
                                    HorizontalOptions="FillAndExpand"
                                    WidthRequest="20" />

                                <!--#region Details Fees Values-->
                                <StackLayout BindableLayout.ItemsSource="{Binding DetailsTotalFeesList}">

                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <!--  Items List  -->
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                                                <!--  Item Name Label  -->
                                                <custom:CustomLabel
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="Start"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Name}"
                                                    TextColor="#999999"
                                                    VerticalOptions="Start" />

                                                <!--  Value Label  -->
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource SomarSemiBold}"
                                                    FontSize="14"
                                                    HorizontalOptions="End"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="#002447"
                                                    VerticalOptions="Start">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Id}" />
                                                            <Span Text="  " />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>

                                                </custom:CustomLabel>

                                            </Grid>

                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </StackLayout>
                                <!--#endregion Payment Values-->
                            </StackLayout>

                        </Frame>
                        <!--#endregion Frame Contains Fees-->


                        <!--  Online Payment Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            Command="{Binding GoToPaymentCommand}"
                            IsVisible="{Binding Inquire.IsNotPaid}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                            VerticalOptions="EndAndExpand" />

                        <!--  Pervious Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            Background="Transparent"
                            Command="{Binding BackCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Stroke="Transparent"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZCancel}"
                            TextColor="{StaticResource Secondary}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

