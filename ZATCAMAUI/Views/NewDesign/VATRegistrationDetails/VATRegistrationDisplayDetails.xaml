<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRegistrationDetails.VATRegistrationDisplayDetails"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
     xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    ios:Page.UseSafeArea="true"
    x:Name="page"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid
            x:Name="VATRDMainGrid"
            BackgroundColor="{StaticResource Primary}"
            RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid
                Grid.Row="0"
                Padding="20,10"
                BackgroundColor="{StaticResource Primary}"
                ColumnDefinitions="Auto,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VATRegistrationDetailsTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <Border
                Grid.Row="1"
                Padding="20,10"
                BackgroundColor="White"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <ScrollView
                        Grid.Row="1"
                        HorizontalOptions="FillAndExpand"
                        HorizontalScrollBarVisibility="Never"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">

                        <Grid
                            x:Name="SummeryView"
                            Padding="0,0,0,0"
                            IsVisible="{Binding IsSummaryVisible}">

                            <StackLayout>
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="28"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Text="{x:Static ResourceManager:AppResources.VATRegistrationDetailsTitle}"
                                    TextColor="{StaticResource NeutralBlack}"/>

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    Stroke="LightGray"
                                    StrokeShape="RoundRectangle 8,8,8,8">
                                    <Grid RowDefinitions="*,auto,*"
                                          RowSpacing="10">

                                        <StackLayout Padding="5"
                                               Orientation="Horizontal"
                                               Spacing="10">

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                Source="details"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />
                                            <Label
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>

                                        <BoxView Style="{StaticResource lineSeperator}" Grid.Row="1"/>

                                        <Grid Padding="10,5,10,10"
                                              RowSpacing="10"
                                              Grid.Row="2"
                                              RowDefinitions="*,*,*"
                                              ColumnDefinitions="*,*">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRVATEligibleStartDate}" />
                                            <Label
                                                Grid.Row="0"
                                                HorizontalOptions="EndAndExpand"
                                                Grid.Column="1"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.VatEligibleStartDate}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRImportExport}" />
                                            <Label
                                                Grid.Row="1"
                                                HorizontalOptions="EndAndExpand"
                                                Grid.Column="1"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding ImportExportText}" />
                                            <Label
                                                Grid.Row="2"
                                                HorizontalOptions="Start"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.Attachment}" />
                                            <Label
                                                Grid.Row="2"
                                                HorizontalTextAlignment="End"
                                                HorizontalOptions="EndAndExpand"
                                                Grid.Column="1"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding AttachmentName}" />

                                        </Grid>

                                    </Grid>
                                </Border>

                                <!--  Bank Details Summery  -->
                                <Border
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    IsVisible="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.IbanVisibility}"
                                    Stroke="LightGray"
                                    StrokeShape="RoundRectangle 8,8,8,8">
                                    <Grid RowDefinitions="*,auto,*"
                                          RowSpacing="10">

                                        <StackLayout Padding="5"
                                                     Orientation="Horizontal"
                                                     Spacing="10">
                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                Source="positive"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />
                                            <Label
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.NAIBANDetails}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>

                                        <BoxView Style="{StaticResource lineSeperator}" Grid.Row="1"/>

                                        <listView:SfListView
                                            Grid.Row="2"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.IbanList}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="SingleDeselect"
                                            VerticalOptions="Center">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0"
                                                          RowDefinitions="*"
                                                          ColumnDefinitions="*,*"
                                                          RowSpacing="0"
                                                          FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                        <Label
                                                            x:Name="{Binding IbanText}"
                                                            FontSize="Small"
                                                            HorizontalOptions="Start"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.NAIBAN}" />
                                                        <Label
                                                            FontSize="Small"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlack}"
                                                            Text="{Binding Iban}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>

                                    </Grid>
                                </Border>
                                <!--  Sales Details Summery  -->

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    Stroke="LightGray"
                                    StrokeShape="RoundRectangle 8,8,8,8">
                                    <Grid RowDefinitions="*,auto,*"
                                          RowSpacing="10">

                                        <StackLayout Padding="5"
                                                     Spacing="10"
                                                     Orientation="Horizontal">

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                Source="finances"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <Label
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.FORM5FinancialInfo}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>

                                        <BoxView Style="{StaticResource lineSeperator}" Grid.Row="1"/>

                                        <Grid Padding="10,5,10,10"
                                              Grid.Row="2"
                                              RowSpacing="10"
                                              ColumnDefinitions="*,*"
                                              RowDefinitions="*,*,*,*">

                                            <!--  SliderLable1  -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRSummeryOfSalesDetailsComming12months}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion1answerSelected}" />
                                            <Label
                                                Grid.Row="1"
                                                HorizontalOptions="Start"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRSummeryOfSalesDetailsLast12months}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion2answerSelected}" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRSummeryofExpenseDetailsComming12Months}" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion3answerSelected}" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRSummeryOfExpenseDetailsLast12Months}" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion4answerSelected}" />
                                        </Grid>

                                    </Grid>
                                </Border>

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    Stroke="LightGray"
                                    StrokeShape="RoundRectangle 8,8,8,8">
                                    <Grid RowDefinitions="*,auto,*"
                                          RowSpacing="10">

                                        <StackLayout Padding="5"
                                                     Orientation="Horizontal"
                                                     Spacing="10">
                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                Source="vat_user"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                           <Label
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZZVATRFinancialRepresentative}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>

                                        <BoxView Style="{StaticResource lineSeperator}" Grid.Row="1"/>

                                        <Grid Padding="10,5,10,10"
                                              Grid.Row="2"
                                              RowSpacing="10"
                                              RowDefinitions="*,*,*,*,*,*,*"
                                              ColumnDefinitions="*,*">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.TIN}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.GpartFR}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.TxtIDTypeFR}" />

                                            <Label
                                                Grid.Row="2"
                                                HorizontalOptions="Start"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.IdnumberFR}" />

                                            <Label
                                                Grid.Row="3"
                                                HorizontalOptions="Start"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZVATRFirstName}" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.FirstnmFR}" />

                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZVATRSurName}" />
                                            <Label
                                                Grid.Row="4"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Grid.Column="1"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.LastnmFR}" />

                                            <Label
                                                Grid.Row="5"
                                                HorizontalOptions="Start"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.MobileNumber}" />

                                            <Label
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.MobNumberFR}" />

                                            <Label
                                                Grid.Row="6"
                                                HorizontalOptions="Start"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.Email}" />
                                            <Label
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.SmtpAddrFR}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    Stroke="LightGray"
                                    StrokeShape="RoundRectangle 8,8,8,8">
                                    <Grid RowDefinitions="*,auto,*"
                                          RowSpacing="10">
                                        <StackLayout Padding="5"
                                                     Orientation="Horizontal"
                                                     Spacing="10">
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                Source="declaration"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                           <Label
                                                FontSize="Medium"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}"
                                                VerticalOptions="CenterAndExpand" />

                                        </StackLayout>

                                        <BoxView Style="{StaticResource lineSeperator}" Grid.Row="1" />

                                        <Grid Padding="10,5,10,10"
                                              RowSpacing="10"
                                              ColumnDefinitions="*,*"
                                              RowDefinitions="*,*,*"
                                              Grid.Row="2">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                            <Label
                                                Grid.Row="0"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Grid.Column="1"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding IDType}" />

                                            <Label
                                                Grid.Row="1"
                                                HorizontalOptions="Start"
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <Label
                                                Grid.Row="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Grid.Column="1"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding IDNumber}" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRContactPersonName}" />
                                            <Label
                                                Grid.Row="2"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Grid.Column="1"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding ContactPersonName}" />

                                        </Grid>

                                    </Grid>
                                </Border>

                            </StackLayout>
                        </Grid>

                    </ScrollView>
                </Grid>
            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
        </Grid>

    </ContentPage.Content>
</ContentPage>
