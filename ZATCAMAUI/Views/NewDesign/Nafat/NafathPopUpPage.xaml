<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Nafat.NafathPopUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">


    <StackLayout Margin="0,0,0,15">
        <Border
            Margin="50"
            Padding="15,20,15,20"
            BackgroundColor="White"
            Stroke="#bbbbbb"
            StrokeShape="RoundRectangle 10,10,10,10">
            <StackLayout>
                <Label
                    Style="{StaticResource GAZTMicroMediumGrayLabel}"
                    Text="{x:Static ResourceManager:AppResources.ESTNationalityLabel}"
                    TextColor="#010101" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <cards:SfCardView
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="3"
                        Padding="0"
                        CornerRadius="3"
                        HorizontalOptions="FillAndExpand">
                        <!--  Mohit change  -->
                        <Grid>

                            <Image
                                x:Name="GulfImage"
                                Grid.Row="0"
                                Margin="0"
                                Aspect="AspectFill"
                                Source="vat_tile_IbanCard_background_white.png" />

                            <Grid
                                Grid.Row="0"
                                Padding="10"
                                VerticalOptions="End">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <StackLayout Grid.Row="1" Spacing="0">
                                    <Label
                                        x:Name="GulfText"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="Small"
                                        Text="{x:Static ResourceManager:AppResources.ZREGGulfCtzn}"
                                        TextColor="CadetBlue" />
                                </StackLayout>

                            </Grid>

                        </Grid>
                        <cards:SfCardView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TappedGulf" />
                        </cards:SfCardView.GestureRecognizers>
                    </cards:SfCardView>

                    <cards:SfCardView
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="3"
                        Padding="0"
                        CornerRadius="3"
                        HorizontalOptions="FillAndExpand">

                        <Grid
                            Margin="0"
                            Padding="0"
                            VerticalOptions="FillAndExpand">
                            <Border Grid.Row="0" BackgroundColor="White">
                                <Image
                                    x:Name="CitigenImage"
                                    Aspect="AspectFill"
                                    HorizontalOptions="FillAndExpand"
                                    Source="vat_tile_IbanCard_background.png"
                                    VerticalOptions="FillAndExpand" />
                            </Border>

                            <Grid
                                Grid.Row="0"
                                Padding="10"
                                VerticalOptions="End">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <StackLayout Grid.Row="1" Spacing="0">
                                    <Label
                                        x:Name="CitigenText"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        FontSize="Small"
                                        Text="{x:Static ResourceManager:AppResources.ZREGCitizen}"
                                        TextColor="White"
                                        VerticalOptions="End" />
                                </StackLayout>

                            </Grid>
                        </Grid>
                        <cards:SfCardView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TappedCitizen" />
                        </cards:SfCardView.GestureRecognizers>
                    </cards:SfCardView>
                </Grid>



            </StackLayout>

        </Border>

    </StackLayout>
</Mopups:PopupPage>

