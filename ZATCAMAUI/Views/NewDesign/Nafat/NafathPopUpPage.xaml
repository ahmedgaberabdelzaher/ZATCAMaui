<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.Nafat.NafathPopUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    BackgroundColor="#88000000" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">


    <StackLayout Margin="0,0,0,15">
        <Border
            Margin="50"
            Padding="15,20,15,20"
            BackgroundColor="White"
            Stroke="#bbbbbb"
            StrokeShape="RoundRectangle 10,10,10,10">
            <StackLayout>
                <Label
                    Style="{StaticResource GAZTMicroMediumGrayLabel}"
                    Text="{x:Static ResourceManager:AppResources.ESTNationalityLabel}"
                    TextColor="#010101" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0"
                        Padding="0"
                        BackgroundColor="White"
                        ColumnSpacing="0"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <Image
                            Aspect="Fill"
                            HorizontalOptions="FillAndExpand"
                            Source="{Binding CitigenImage}"
                            VerticalOptions="FillAndExpand" />
                        <Label
                            Padding="10"
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="Small"
                            Text="{x:Static ResourceManager:AppResources.ZREGCitizen}"
                            TextColor="{Binding CitigenTextColor}"
                            VerticalOptions="CenterAndExpand" />
                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer Command="{Binding TappedCitizenCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0"
                        Padding="0"
                        ColumnSpacing="0"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <Image
                            Aspect="Fill"
                            HorizontalOptions="FillAndExpand"
                            Source="{Binding GulfImage}"
                            VerticalOptions="FillAndExpand" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="10"
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="Small"
                            Text="{x:Static ResourceManager:AppResources.ZREGGulfCtzn}"
                            TextColor="{Binding GulfTextColor}"
                            VerticalOptions="CenterAndExpand" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TappedGulfCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>
            </StackLayout>

        </Border>

    </StackLayout>
</Mopups:PopupPage>

