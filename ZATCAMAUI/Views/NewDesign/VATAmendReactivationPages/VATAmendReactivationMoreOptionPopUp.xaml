<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATAmendReactivationPages.VATAmendReactivationMoreOptionPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    BackgroundColor="#88000000">
    <ContentPage.Content>
        <Border
            BackgroundColor="White"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="EndAndExpand">
            <StackLayout
                Grid.Row="0"
                HeightRequest="130"
                HorizontalOptions="FillAndExpand"
                Spacing="0"
                VerticalOptions="FillAndExpand">
                <ListView
                    x:Name="optionList"
                    HasUnevenRows="True"
                    HeightRequest="100"
                    HorizontalOptions="FillAndExpand"
                    ItemTapped="OptionItemTapped"
                    SeparatorVisibility="None"
                    VerticalOptions="CenterAndExpand">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <StackLayout
                                    HeightRequest="50"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">
                                    <Label
                                        Margin="10"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding option}"
                                        VerticalTextAlignment="Center" />
                                </StackLayout>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>
        </Border>
    </ContentPage.Content>
</Mopups:PopupPage>
