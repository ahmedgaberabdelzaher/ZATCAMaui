<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATAmendReactivationPages.VATAmendReactivationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector"
    x:Name="VATRegistration"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="12"
                        HorizontalOptions="StartAndExpand"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Source="arrowLeftwhite"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label
                        x:Name="lblPageTitle"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="50,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        MaxLines="2"
                        Style="{StaticResource SectionTitleWhiteBold}"
                        Text="{Binding BindingContext.PageTitle, Source={x:Reference VATRegistration}}"
                        VerticalOptions="CenterAndExpand" />

                </Grid>
                <!-- </Grid>-->
                <Border
                    Grid.Row="1"
                    Padding="0"
                    StrokeShape="RoundRectangle 15,15,0,0"
                    VerticalOptions="FillAndExpand">
                    <Grid
                        x:Name="VATRMainGrid"
                        Margin="0"
                        Padding="0,0,0,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand" />
                    </Grid>
                </Border>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="1"
                Padding="0"
                StrokeShape="RoundRectangle 15,15,0,0">
                <Grid
                    x:Name="VATRMainGrid"
                    Margin="0"
                    Padding="0,15,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="90*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0"
                        Padding="15,15,15,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                            <StackLayout BackgroundColor="White">

                                <Grid
                                    Margin="0"
                                    Padding="0,15,0,10"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="0"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0"
                                        Padding="15"
                                        BackgroundColor="White"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding IsInstrunctionVisible}"
                                        RowSpacing="0"
                                        VerticalOptions="FillAndExpand">
                                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                                            <StackLayout BackgroundColor="White">

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMediumBlackLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" />

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTSmallGoldLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsFirst}" />
                                                <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ1}"
                                                        TextColor="{StaticResource Secondary}" />
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ2}"
                                                        TextColor="{StaticResource Primary}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="VATFaqTapped" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                </StackLayout>
                                                <Label
                                                    Margin="0,-10,0,0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ3}"
                                                    TextColor="{StaticResource NeutralGreay}" />

                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMicroGrayLabel}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="1." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions1}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMicroGrayLabel}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span FontSize="11" Text="2." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions2}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}" VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="3." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions3}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="4." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions4}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}" VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="5." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions5}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="6." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions6}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="7." />
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATAmendInstrunctionsAndConditions7}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <StackLayout Orientation="Horizontal">
                                                    <custom:CheckboxCustom
                                                        x:Name="chkDeclaration"
                                                        IsChecked="{Binding IsInstrunctionChecked}"
                                                        IsEnabled="{Binding InstAndCondition.CBAgreeCondition}"
                                                        Style="{StaticResource CheckboxHeightWidth32}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label Style="{DynamicResource IsInstrunctionCheckedStyle}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                            </StackLayout>
                                        </ScrollView>
                                    </Grid>


                                    <!--  TaxPayers Details  -->
                                    <Grid
                                        x:Name="TaxPayersDetailsView"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="0,10,0,0"
                                        IsVisible="{Binding IsTaxPayersVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="28"
                                                Style="{StaticResource SectionTitleBlackBold28}"
                                                Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                                                VerticalOptions="Center" />
                                            <Label Style="{StaticResource GAZTSmallBlackLbl}" Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                                            <BoxView Margin="0,0,0,15" Style="{StaticResource lineSeperator}" />
                                        </StackLayout>
                                        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">

                                            <Grid
                                                Padding="0"
                                                BackgroundColor="White"
                                                BindingContext="{Binding VATRegistrationDetailsData.d}"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="15"
                                                VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="20*" />
                                                </Grid.RowDefinitions>
                                                <!--  Start Of Read Only or pre-populated  -->

                                                <StackLayout Grid.Row="0">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.TIN}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.TinEntry1, Source={x:Reference VATRegistration}}"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Placeholder="{x:Static ResourceManager:AppResources.TINS}"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Gpartz}"
                                                            TextColor="#bbbbbb">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:OnlyNumericValuesBehaviour />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding TinNm}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="2">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRMainOutlet}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry1, Source={x:Reference VATRegistration}}"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding CrNo}">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:OnlyNumericValuesBehaviour />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>

                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry2, Source={x:Reference VATRegistration}}"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            FontSize="Small"
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding CrNm}"
                                                            TextColor="#bbbbbb" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="3">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRStartDate}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <StackLayout Orientation="Horizontal">
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="Entry_CrStdt"
                                                                Margin="0"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.StartdateToshow}" />
                                                        </StackLayout>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="4">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatAddress}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry1, Source={x:Reference VATRegistration}}"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}" />
                                                    </inputLayout:SfTextInputLayout>
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry2, Source={x:Reference VATRegistration}}"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="5">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRSource}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.SourceEntry, Source={x:Reference VATRegistration}}"
                                                        IsHintAlwaysFloated="True"
                                                        LeadingViewPosition="Inside"
                                                        Stroke="{StaticResource Primary}"
                                                        Style="{StaticResource TextInputLayout}">
                                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <custom:GAZTBorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="6" Margin="0,0,0,15">
                                                    <BoxView Margin="0,5,0,20" Style="{StaticResource lineSeperator}" />

                                                    <StackLayout
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.AddInformationCB, Source={x:Reference VATRegistration}}"
                                                        IsVisible="{Binding BindingContext.TaxPayerDetails.AddInformationCBVisible, Source={x:Reference VATRegistration}}"
                                                        Orientation="Horizontal">
                                                        <custom:CheckboxCustom
                                                            CheckChanged="AddAdditionalInfo_CheckedChanged"
                                                            IsChecked="{Binding BindingContext.IsAddAdditionalInfoChecked, Source={x:Reference VATRegistration}}"
                                                            Style="{StaticResource CheckboxHeightWidth32}"
                                                            VerticalOptions="CenterAndExpand" />

                                                        <Label Style="{DynamicResource IsAddAdditionalInfoCheckedStyle}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.VATRTPDetailsAdditionalInformation}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </StackLayout>

                                                    <Border
                                                        Padding="15,20,15,20"
                                                        BackgroundColor="White"
                                                        IsVisible="{Binding BindingContext.VatEligibleStartDateInsVisible, Source={x:Reference VATRegistration}}"
                                                        Stroke="#bbbbbb"
                                                        StrokeShape="RoundRectangle 10,10,10,10">
                                                        <StackLayout>

                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Information}"
                                                                            Size="30"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                </Image>
                                                                <StackLayout
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    Spacing="0"
                                                                    VerticalOptions="Start">
                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}" />
                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
