                                                    <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.VATRSummeryofExpenseDetailsComming12Months}" />
                                                    <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.quesTion3answerSelected}" />
                                                    <Label
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.VATRSummeryOfExpenseDetailsLast12Months}" />
                                                    <Label
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            HorizontalOptions="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.quesTion4answerSelected}" />

                                                </Grid>

                                            </StackLayout>

                                        </Border>

                                        <!--  -Financial representative summary  -->
                                        <Border Margin="0,24,0,0" Style="{StaticResource ComponentFrameWithRadius14}">

                                            <StackLayout Spacing="0">

                                                <Grid
                                                        Padding="10"
                                                        ColumnSpacing="15"
                                                        HeightRequest="80">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                            Grid.Column="0"
                                                            Aspect="AspectFit"
                                                            HorizontalOptions="CenterAndExpand"
                                                            Source="ChartBar.png"
                                                            Style="{StaticResource ComponentBoxIconSummaryPage}"
                                                            VerticalOptions="CenterAndExpand" />

                                                    <Label
                                                            Grid.Column="1"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZZVATRFinancialRepresentative}"
                                                            VerticalTextAlignment="Center" />

                                                    <StackLayout
                                                            Grid.Column="2"
                                                            HorizontalOptions="CenterAndExpand"
                                                            VerticalOptions="Center">
                                                        <Label
                                                                FontSize="Medium"
                                                                Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                                Text="{x:Static ResourceManager:AppResources.CREdit}"
                                                                VerticalOptions="Center"
                                                                VerticalTextAlignment="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="GoBackToFinacialRepresentativeDetails" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </StackLayout>
                                                </Grid>

                                                <BoxView Style="{StaticResource lineSeperator}" />

                                                <Grid Padding="10,5,10,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*" />
                                                        <ColumnDefinition Width="50*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.TIN}" />
                                                    <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding BindingContext.GpartSum, Source={x:Reference VATRegistration}}" />
                                                    <Label
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                    <Label
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding BindingContext.TxtIDTypeSum, Source={x:Reference VATRegistration}}" />
                                                    <Label
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                    <Label
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding BindingContext.IdnumberSum, Source={x:Reference VATRegistration}}" />
                                                    <Label
                                                            Grid.Row="3"
                                                            Grid.Column="0"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZVATRFirstName}" />
                                                    <Label
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding BindingContext.FirstnmSum, Source={x:Reference VATRegistration}}" />
                                                    <Label
                                                            Grid.Row="4"
                                                            Grid.Column="0"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZZZVATRSurName}" />
                                                    <Label
                                                            Grid.Row="4"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding BindingContext.LastnmSum, Source={x:Reference VATRegistration}}" />
                                                    <Label
                                                            Grid.Row="5"
                                                            Grid.Column="0"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.MobileNumber}" />
                                                    <Label
                                                            Grid.Row="5"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding BindingContext.MobNumberSum, Source={x:Reference VATRegistration}}" />

                                                    <Label
                                                            Grid.Row="6"
                                                            Grid.Column="0"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.Email}" />
                                                    <Label
                                                            Grid.Row="6"
                                                            Grid.Column="1"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource BodyLabelBlackMedium}"
                                                            Text="{Binding BindingContext.SmtpAddrSum, Source={x:Reference VATRegistration}}" />

                                                </Grid>

                                            </StackLayout>

                                        </Border>

                                        <Grid
                                                Margin="0,24,0,0"
                                                ColumnDefinitions="1*,2*,7*"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding IsDeclarationViewEnabled}">
                                            <custom:CheckboxCustom
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    IsChecked="{Binding IsDeclarationChecked}"
                                                    Style="{StaticResource CheckboxHeightWidth32}" />

                                            <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Style="{DynamicResource IsDeclarationCheckedStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVATRDR1}"
                                                    VerticalOptions="CenterAndExpand">
                                                <Label.Margin>
                                                    <OnPlatform x:TypeArguments="Thickness">
                                                        <On Platform="iOS" Value="0,0,0,0" />
                                                        <On Platform="Android" Value="0,14,0,0" />
                                                    </OnPlatform>
                                                </Label.Margin>
                                            </Label>

                                        </Grid>

                                        <StackLayout IsVisible="{Binding IsDeclarationViewEnabled}">
                                            <Label
                                                    Margin="0,20,0,15"
                                                    Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVATRDR2}" />
                                            <Grid
                                                    Padding="0"
                                                    BackgroundColor="White"
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowDefinitions="Auto,Auto,Auto,Auto"
                                                    RowSpacing="15"
                                                    VerticalOptions="FillAndExpand">

                                                <StackLayout Grid.Row="0">

                                                    <Label Grid.Row="0" Style="{StaticResource ComponentHeaderBlackBold}">

                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ComponentHeaderBlackBold}" Text="{x:Static ResourceManager:AppResources.VATRIDType}" />
                                                                <Span Text="*" TextColor="#e84941" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>

                                                    <custom:CustomSfTextInputView Grid.Row="1">
                                                        <custom:CustomSfTextInputView.TextInputView>

                                                            <custom:GAZTBorderlessEntry
                                                                    HorizontalOptions="FillAndExpand"
                                                                    IsEnabled="{Binding Declaration.IDTypeOrNoPicker}"
                                                                    IsSpellCheckEnabled="False"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.VATRIDType}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding TxtIDTypeSR}">

                                                                <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding btnContactID_Clicked}" />
                                                                </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                            </custom:GAZTBorderlessEntry>

                                                        </custom:CustomSfTextInputView.TextInputView>
                                                        <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding btnContactID_Clicked}" />
                                                        </inputLayout:SfTextInputLayout.GestureRecognizers>
                                                        <inputLayout:SfTextInputLayout.TrailingView>
                                                            <Image
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Source="arrowDropdown.png"
                                                                    Style="{StaticResource SmallIcon}" />
                                                        </inputLayout:SfTextInputLayout.TrailingView>
                                                    </custom:CustomSfTextInputView>

                                                    <custom:CustomSfPicker
                                                            x:Name="DDlContactIDType"
                                                            Margin="0,0,0,0"
                                                            Background="White"
                                                            ItemHeight="40"
                                                            Mode="Dialog"
                                                            OkButtonClicked="DDlIDTypeSR_OkayButtonClicked"
                                                            SelectionChanged="DDlContactIDType_SelectionChanged_1">


                                                        <syncfusion:SfPicker.HeaderView>

                                                            <syncfusion:PickerHeaderView
                                                                    Height="40"
                                                                    Background="{StaticResource Primary}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZZIDType}">
                                                                <syncfusion:PickerHeaderView.TextStyle>
                                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                </syncfusion:PickerHeaderView.TextStyle>
                                                            </syncfusion:PickerHeaderView>

                                                        </syncfusion:SfPicker.HeaderView>

                                                        <syncfusion:SfPicker.TextStyle>
                                                            <syncfusion:PickerTextStyle FontSize="13" TextColor="{StaticResource NeutralGreay}" />
                                                        </syncfusion:SfPicker.TextStyle>

                                                        <syncfusion:SfPicker.Columns>
                                                            <syncfusion:PickerColumn
                                                                    Width="270"
                                                                    DisplayMemberPath="Name"
                                                                    ItemsSource="{Binding IdTypeListSR}"
                                                                    SelectedIndex="{Binding IDTypeIndexSR}" />
                                                        </syncfusion:SfPicker.Columns>

                                                        <syncfusion:SfPicker.SelectedTextStyle>
                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                        </syncfusion:SfPicker.SelectedTextStyle>


                                                        <syncfusion:SfPicker.SelectionView>
                                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                        </syncfusion:SfPicker.SelectionView>

                                                        <syncfusion:SfPicker.FooterView>

                                                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                                <syncfusion:PickerFooterView.TextStyle>
                                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                </syncfusion:PickerFooterView.TextStyle>

                                                            </syncfusion:PickerFooterView>

                                                        </syncfusion:SfPicker.FooterView>

                                                    </custom:CustomSfPicker>

                                                </StackLayout>

                                                <StackLayout Grid.Row="1">

                                                    <Label Grid.Row="0" Style="{StaticResource ComponentHeaderBlackBold}">

                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ComponentHeaderBlackBold}" Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                                <Span Text="*" TextColor="#e84941" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>

                                                    <custom:CustomSfTextInputView x:Name="FrmContactIDNumber" IsEnabled="{Binding Declaration.IDTypeOrNoPicker}">
                                                        <custom:CustomSfTextInputView.TextInputView>

                                                            <custom:GAZTBorderlessEntry
                                                                    x:Name="EntryContactIDNumber"
                                                                    IsSpellCheckEnabled="False"
                                                                    Keyboard="Numeric"
                                                                    MaxLength="{Binding MaxLengthIDSR}"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding IdNumberSR}"
                                                                    TextChanged="EntryContactIDNumber_TextChanged"
                                                                    Unfocused="EntryContactIDNumber_Unfocused">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>
                                                </StackLayout>

                                                <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        BackgroundColor="Red">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Label
                                                                x:Name="lblDOB"
                                                                Grid.Row="0"
                                                                IsVisible="false"
                                                                Style="{StaticResource ComponentHeaderBlackBold}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource ComponentHeaderBlackBold}" Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                                    <Span Text="*" TextColor="#e84941" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <custom:CustomSfTextInputView
                                                                x:Name="FrmContactDBO"
                                                                Grid.Row="1"
                                                                HasError="{Binding FrameContactDOBError}"
                                                                IsVisible="false">
                                                            <custom:CustomSfTextInputView.TextInputView>

                                                                <custom:GAZTBorderlessEntry
                                                                        x:Name="ContactDateEntry"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        IsEnabled="False"
                                                                        Placeholder="YYYY/MM/DD"
                                                                        Style="{StaticResource DefaultEntry}"
                                                                        Text="{Binding ContactDOB}"
                                                                        TextChanged="ContactDateEntry_TextChanged" />
                                                            </custom:CustomSfTextInputView.TextInputView>
                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image
                                                                        HorizontalOptions="EndAndExpand"
                                                                        Source="calendar.png"
                                                                        Style="{StaticResource SmallIcon}" />
                                                            </inputLayout:SfTextInputLayout.TrailingView>
                                                        </custom:CustomSfTextInputView>

                                                        <buttons:SfButton
                                                                x:Name="btnSR"
                                                                Margin="0,0,0,0"
                                                                Background="Transparent"
                                                                Clicked="btn4_Clicked"
                                                                IsEnabled="{Binding Declaration.DOBEntry}"
                                                                IsVisible="false" />

                                                        <custom:CustomDatePicker
                                                                x:Name="ContactDOBPicker"
                                                                Margin="2"
                                                                Background="White"
                                                                Closed="ContactDOBPicker_Closed"
                                                                HorizontalOptions="FillAndExpand"
                                                                ItemHeight="45"
                                                                Mode="Dialog"
                                                                OkButtonClicked="ContactDOBPicker_OkButtonClicked"
                                                                SelectedItem="{Binding TodayDate}">

                                                            <custom:CustomDatePicker.ColumnHeaderView>
                                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                                            </custom:CustomDatePicker.ColumnHeaderView>


                                                            <custom:CustomDatePicker.SelectionView>
                                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                            </custom:CustomDatePicker.SelectionView>

                                                            <custom:CustomDatePicker.SelectedTextStyle>
                                                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                            </custom:CustomDatePicker.SelectedTextStyle>

                                                            <custom:CustomDatePicker.HeaderView>

                                                                <syncfusion:PickerHeaderView
                                                                        Height="46"
                                                                        Background="{StaticResource PrimaryColor}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">

                                                                    <syncfusion:PickerHeaderView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                                    </syncfusion:PickerHeaderView.TextStyle>

                                                                </syncfusion:PickerHeaderView>

                                                            </custom:CustomDatePicker.HeaderView>

                                                            <custom:CustomDatePicker.FooterView>

                                                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource PrimaryColor}">

                                                                    <syncfusion:PickerFooterView.TextStyle>
                                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                                    </syncfusion:PickerFooterView.TextStyle>

                                                                </syncfusion:PickerFooterView>

                                                            </custom:CustomDatePicker.FooterView>

                                                        </custom:CustomDatePicker>
                                                    </Grid>
                                                </StackLayout>

                                                <StackLayout Grid.Row="3" BackgroundColor="DarkGreen">
                                                    <Label Grid.Row="0" Style="{StaticResource ComponentHeaderBlackBold}">

                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ComponentHeaderBlackBold}" Text="{x:Static ResourceManager:AppResources.VATRContactPersonName}" />
                                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <custom:CustomSfTextInputView x:Name="FrmContactName" IsEnabled="{Binding Declaration.ContactNameEntry}">
                                                        <custom:CustomSfTextInputView.TextInputView>

                                                            <custom:GAZTBorderlessEntry
                                                                    x:Name="EntryContactName"
                                                                    IsSpellCheckEnabled="False"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.VATRContactPersonName}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding FirstNameSR}"
                                                                    TextChanged="EntryContactName_TextChanged">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:AlphabetandArabicCharacters />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>
                                                </StackLayout>

                                            </Grid>
                                        </StackLayout>

                                        <StackLayout
                                                Margin="10,5"
                                                BackgroundColor="Transparent"
                                                IsVisible="{Binding IsDeclarationViewEnabledNew}"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalOptions="FillAndExpand">


                                            <custom:CheckboxCustom
                                                    IsChecked="{Binding IsDeclarationChecked}"
                                                    MinimumHeightRequest="32"
                                                    MinimumWidthRequest="32"
                                                    VerticalOptions="Start" />

                                            <Label
                                                    HeightRequest="350"
                                                    HorizontalOptions="FillAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    IsVisible="{Binding ShouldShowEN}"
                                                    Style="{StaticResource CheckboxUnselectedFontStyle}"
                                                    Text="{Binding Zterms}"
                                                    TextType="Html" />

                                            <Label
                                                    HeightRequest="350"
                                                    HorizontalOptions="FillAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    IsVisible="{Binding ShouldShowAR}"
                                                    Style="{StaticResource CheckboxUnselectedFontStyle}"
                                                    Text="{Binding Zterms}"
                                                    TextType="Html" />


                                        </StackLayout>

                                    </StackLayout>

                                </Grid>

                                <buttons:SfButton
                                    x:Name="MainButtonName"
                                    Margin="0,0,0,20"
                                    Background="{Binding ContinueButtonnBackroundColor}"
                                    Clicked="btnContinue_Clicked"
                                    CornerRadius="14"
                                    IsEnabled="{Binding IsContinueButtonEnable}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding CurrentStep, TargetNullValue=''}" />

                            </StackLayout>

                        </ScrollView>

                    </Grid>

                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15,15,15,0"
                        Padding="0"
                        BackgroundColor="White">
                        <Grid Margin="0,7,0,0"
                              RowDefinitions="auto,auto"
                              ColumnDefinitions="20*,60*,20*">

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="Start"
                                IsVisible="{Binding IsBackStepButtonVisible}"
                                Source="arrowLeft.png"
                                Rotation="180"
                                VerticalOptions="CenterAndExpand">

                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding AppDirection}"
                                        TargetType="Image"
                                        Value="LeftToRight">
                                        <Setter Property="Rotation" Value="0" />
                                    </DataTrigger>
                                </Image.Triggers>


                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TappedOnBackButton" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />

                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <StackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Orientation="Horizontal"
                                    Rotation="90"
                                    Spacing="3"
                                    VerticalOptions="CenterAndExpand">
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                </StackLayout>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="onMoreOptionClicked" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Padding="10,0,0,10"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand">
                                <commonView:PageIndicatorView
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}" />

                            </StackLayout>

                        </Grid>
                    </StackLayout>

                </Grid>

            </Border>
            <!--#endregion-->

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>