                                                    Margin="0,20,0,15"
                                                    Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVATRDR2}" />
                                                <Grid
                                                    Padding="0"
                                                    BackgroundColor="White"
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowDefinitions="auto,auto,auto"
                                                    RowSpacing="15"
                                                    VerticalOptions="FillAndExpand">

                                                    <StackLayout Grid.Row="0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Label Grid.Row="0" Style="{StaticResource ComponentHeaderBlackBold}">

                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static ResourceManager:AppResources.VATRIDType}" />
                                                                        <Span Text="*" TextColor="#e84941" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                            <inputLayout:SfTextInputLayout
                                                                Grid.Row="1"
                                                                Margin="0,-6,0,-6"
                                                                ContainerType="Outlined"
                                                                HasError="False"
                                                                HorizontalOptions="FillAndExpand"
                                                                InputViewPadding="16,0,16,0"
                                                                IsHintAlwaysFloated="True"
                                                                LeadingViewPosition="Inside"
                                                                Stroke="{StaticResource Primary}"
                                                                Style="{StaticResource TextInputLayout}">
                                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:GAZTBorderlessEntry
                                                                        HorizontalOptions="FillAndExpand"
                                                                        IsEnabled="{Binding Declaration.IDTypeOrNoPicker}"
                                                                        IsSpellCheckEnabled="False"
                                                                        Placeholder="{x:Static ResourceManager:AppResources.VATRIDType}"
                                                                        Style="{StaticResource DefaultEntry}"
                                                                        Text="{Binding TxtIDTypeSR}" />
                                                                    <Image Source="arrowDropdown.png" />
                                                                </StackLayout>
                                                            </inputLayout:SfTextInputLayout>
                                                            <buttons:SfButton
                                                                x:Name="btnContactID"
                                                                Grid.Row="1"
                                                                Margin="0,0,0,0"
                                                                Background="Transparent"
                                                                Clicked="btnContactID_Clicked"
                                                                FontSize="Small"
                                                                IsEnabled="{Binding Declaration.IDTypeOrNoPicker}" />
                                                            <custom:CustomSfPicker
                                                                x:Name="DDlContactIDType"
                                                                Grid.Row="1"
                                                                Margin="0,0,0,0"
                                                                Background="White"
                                                                ItemHeight="40"
                                                                Mode="Dialog"
                                                                OkButtonClicked="DDlIDTypeSR_OkayButtonClicked"
                                                                SelectionChanged="DDlContactIDType_SelectionChanged_1">


                                                                <syncfusion:SfPicker.HeaderView>

                                                                    <syncfusion:PickerHeaderView
                                                                        Height="40"
                                                                        Background="{StaticResource Primary}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZIDType}">
                                                                        <syncfusion:PickerHeaderView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                        </syncfusion:PickerHeaderView.TextStyle>
                                                                    </syncfusion:PickerHeaderView>

                                                                </syncfusion:SfPicker.HeaderView>

                                                                <syncfusion:SfPicker.TextStyle>
                                                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="{StaticResource NeutralGreay}" />
                                                                </syncfusion:SfPicker.TextStyle>

                                                                <syncfusion:SfPicker.Columns>
                                                                    <syncfusion:PickerColumn
                                                                        Width="270"
                                                                        DisplayMemberPath="Name"
                                                                        ItemsSource="{Binding IdTypeListSR}"
                                                                        SelectedIndex="{Binding IDTypeIndexSR}" />
                                                                </syncfusion:SfPicker.Columns>

                                                                <syncfusion:SfPicker.SelectedTextStyle>
                                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                                </syncfusion:SfPicker.SelectedTextStyle>


                                                                <syncfusion:SfPicker.SelectionView>
                                                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                                </syncfusion:SfPicker.SelectionView>

                                                                <syncfusion:SfPicker.FooterView>

                                                                    <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                                        <syncfusion:PickerFooterView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                                        </syncfusion:PickerFooterView.TextStyle>

                                                                    </syncfusion:PickerFooterView>

                                                                </syncfusion:SfPicker.FooterView>

                                                            </custom:CustomSfPicker>
                                                        </Grid>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="1">
                                                        <Label Grid.Row="0" Style="{StaticResource ComponentHeaderBlackBold}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                                    <Span Text="*" TextColor="#e84941" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <inputLayout:SfTextInputLayout
                                                            x:Name="FrmContactIDNumber"
                                                            Margin="0,-6,0,-6"
                                                            ContainerType="Outlined"
                                                            HasError="False"
                                                            HorizontalOptions="FillAndExpand"
                                                            InputViewPadding="16,0,16,0"
                                                            IsEnabled="{Binding Declaration.IDTypeOrNoPicker}"
                                                            IsHintAlwaysFloated="True"
                                                            LeadingViewPosition="Inside"
                                                            Stroke="{StaticResource Primary}"
                                                            Style="{StaticResource TextInputLayout}">
                                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="EntryContactIDNumber"
                                                                IsSpellCheckEnabled="False"
                                                                Keyboard="Numeric"
                                                                MaxLength="{Binding MaxLengthIDSR}"
                                                                Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding IdNumberSR}"
                                                                TextChanged="EntryContactIDNumber_TextChanged"
                                                                Unfocused="EntryContactIDNumber_Unfocused">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="2" Grid.Column="0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Label
                                                                x:Name="lblDOB"
                                                                Grid.Row="0"
                                                                IsVisible="false"
                                                                Style="{StaticResource ComponentHeaderBlackBold}">

                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                                        <Span Text="*" TextColor="#e84941" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                            <inputLayout:SfTextInputLayout
                                                                x:Name="FrmContactDBO"
                                                                Grid.Row="1"
                                                                Margin="0,-6,0,-6"
                                                                ContainerType="Outlined"
                                                                HasError="{Binding FrameContactDOBError}"
                                                                HorizontalOptions="FillAndExpand"
                                                                InputViewPadding="16,0,16,0"
                                                                IsHintAlwaysFloated="True"
                                                                IsVisible="false"
                                                                LeadingViewPosition="Inside"
                                                                Stroke="{StaticResource Primary}"
                                                                Style="{StaticResource TextInputLayout}">
                                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:GAZTBorderlessEntry
                                                                        x:Name="ContactDateEntry"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        IsEnabled="False"
                                                                        Placeholder="YYYY/MM/DD"
                                                                        Style="{StaticResource DefaultEntry}"
                                                                        Text="{Binding ContactDOB}"
                                                                        TextChanged="ContactDateEntry_TextChanged" />
                                                                    <Image HorizontalOptions="End">
                                                                        <Image.Source>
                                                                            <FontImageSource
                                                                                FontFamily="UserIconFont"
                                                                                Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                                Size="20"
                                                                                Color="{StaticResource SecondaryNew}" />
                                                                        </Image.Source>
                                                                    </Image>
                                                                </StackLayout>
                                                            </inputLayout:SfTextInputLayout>

                                                            <buttons:SfButton
                                                                x:Name="btnSR"
                                                                Grid.Row="1"
                                                                Margin="0,0,0,0"
                                                                Background="Transparent"
                                                                Clicked="btn4_Clicked"
                                                                IsEnabled="{Binding Declaration.DOBEntry}"
                                                                IsVisible="false" />

                                                            <custom:CustomDatePicker
                                                                x:Name="ContactDOBPicker"
                                                                Grid.Row="1"
                                                                Margin="2"
                                                                Background="White"
                                                                Closed="ContactDOBPicker_Closed"
                                                                HorizontalOptions="FillAndExpand"
                                                                ItemHeight="45"
                                                                Mode="Dialog"
                                                                OkButtonClicked="ContactDOBPicker_OkButtonClicked"
                                                                SelectedItem="{Binding TodayDate}">

                                                                <custom:CustomDatePicker.ColumnHeaderView>
                                                                    <syncfusion:PickerColumnHeaderView Height="46" />
                                                                </custom:CustomDatePicker.ColumnHeaderView>


                                                                <custom:CustomDatePicker.SelectionView>
                                                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                                </custom:CustomDatePicker.SelectionView>

                                                                <custom:CustomDatePicker.SelectedTextStyle>
                                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                                </custom:CustomDatePicker.SelectedTextStyle>

                                                                <custom:CustomDatePicker.HeaderView>

                                                                    <syncfusion:PickerHeaderView
                                                                        Height="46"
                                                                        Background="{StaticResource PrimaryColor}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">

                                                                        <syncfusion:PickerHeaderView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="White" />
                                                                        </syncfusion:PickerHeaderView.TextStyle>

                                                                    </syncfusion:PickerHeaderView>

                                                                </custom:CustomDatePicker.HeaderView>

                                                                <custom:CustomDatePicker.FooterView>

                                                                    <syncfusion:PickerFooterView Height="46" Background="{StaticResource PrimaryColor}">

                                                                        <syncfusion:PickerFooterView.TextStyle>
                                                                            <syncfusion:PickerTextStyle TextColor="White" />
                                                                        </syncfusion:PickerFooterView.TextStyle>

                                                                    </syncfusion:PickerFooterView>

                                                                </custom:CustomDatePicker.FooterView>

                                                            </custom:CustomDatePicker>
                                                        </Grid>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="3">
                                                        <Label Grid.Row="0" Style="{StaticResource ComponentHeaderBlackBold}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.VATRContactPersonName}" />
                                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <inputLayout:SfTextInputLayout
                                                            x:Name="FrmContactName"
                                                            Margin="0,-6,0,-6"
                                                            ContainerType="Outlined"
                                                            HasError="False"
                                                            HorizontalOptions="FillAndExpand"
                                                            InputViewPadding="16,0,16,0"
                                                            IsEnabled="{Binding Declaration.ContactNameEntry}"
                                                            IsHintAlwaysFloated="True"
                                                            LeadingViewPosition="Inside"
                                                            Stroke="{StaticResource Primary}"
                                                            Style="{StaticResource TextInputLayout}">
                                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="EntryContactName"
                                                                IsSpellCheckEnabled="False"
                                                                Placeholder="{x:Static ResourceManager:AppResources.VATRContactPersonName}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding FirstNameSR}"
                                                                TextChanged="EntryContactName_TextChanged">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:AlphabetandArabicCharacters />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>

                                                </Grid>
                                            </StackLayout>

                                            <Grid
                                                Margin="20,10,20,0"
                                                BackgroundColor="Transparent"
                                                ColumnDefinitions="auto"
                                                HorizontalOptions="FillAndExpand"
                                                IsVisible="{Binding IsDeclarationViewEnabledNew}"
                                                RowDefinitions="auto"
                                                VerticalOptions="FillAndExpand">

                                                <Grid
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    RowDefinitions="auto">

                                                    <StackLayout Grid.Row="0">

                                                        <StackLayout Orientation="Horizontal">

                                                            <custom:CheckboxCustom
                                                                IsChecked="{Binding IsDeclarationChecked}"
                                                                MinimumHeightRequest="32"
                                                                MinimumWidthRequest="32"
                                                                VerticalOptions="Start" />

                                                            <Label
                                                                HeightRequest="350"
                                                                HorizontalOptions="FillAndExpand"
                                                                HorizontalTextAlignment="Start"
                                                                IsVisible="{Binding ShouldShowEN}"
                                                                Style="{StaticResource CheckboxUnselectedFontStyle}"
                                                                Text="{Binding Zterms}"
                                                                TextType="Html"
                                                                VerticalOptions="FillAndExpand" />

                                                            <Label
                                                                HeightRequest="350"
                                                                HorizontalOptions="FillAndExpand"
                                                                HorizontalTextAlignment="{Binding TermsAlignment}"
                                                                IsVisible="{Binding ShouldShowAR}"
                                                                Style="{StaticResource CheckboxUnselectedFontStyle}"
                                                                Text="{Binding Zterms}"
                                                                TextType="Html"
                                                                VerticalOptions="FillAndExpand" />

                                                        </StackLayout>

                                                    </StackLayout>
                                                </Grid>
                                            </Grid>
                                        </StackLayout>
                                    </Grid>

                                </Grid>

                                <buttons:SfButton
                                    x:Name="MainButtonName"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,20"
                                    Background="{Binding ContinueButtonnBackroundColor}"
                                    Clicked="btnContinue_Clicked"
                                    CornerRadius="14"
                                    IsEnabled="{Binding IsContinueButtonEnable}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding CurrentStep}" />
                            </StackLayout>
                        </ScrollView>

                    </Grid>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15,-15,15,0"
                        Padding="0"
                        BackgroundColor="White">
                        <Grid Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="60*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="Start"
                                IsVisible="{Binding IsBackStepButtonVisible}"
                                Source="arrowLeft.png"
                                Style="{DynamicResource BackButtonArrow}"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TappedOnBackButton" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />

                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <StackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Orientation="Horizontal"
                                    Rotation="90"
                                    Spacing="3"
                                    VerticalOptions="CenterAndExpand">
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                </StackLayout>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="onMoreOptionClicked" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Padding="10,0,0,10"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand">
                                <commonView:PageIndicatorView
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}" />

                            </StackLayout>

                        </Grid>
                    </StackLayout>
                </Grid>
            </Border>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="{Binding IsLoading}"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="Center"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>