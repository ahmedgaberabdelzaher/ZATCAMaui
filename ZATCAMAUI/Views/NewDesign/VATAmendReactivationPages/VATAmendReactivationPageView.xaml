<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATAmendReactivationPages.VATAmendReactivationPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    x:Name="VATRegistration"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowSpacing="0"
              RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    MaxLines="2"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding BindingContext.PageTitle, Source={x:Reference VATRegistration}}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="0"
                StrokeShape="RoundRectangle 15,15,0,0">

                <Grid
                    x:Name="VATRMainGrid"
                    Margin="0"
                    Padding="0,15,0,0"
                    BackgroundColor="White"
                    RowDefinitions="10*,90*"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0"
                        Padding="15,15,15,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">

                        <ScrollView HorizontalOptions="FillAndExpand"
                                    VerticalScrollBarVisibility="Never">

                            <StackLayout BackgroundColor="White">

                                <Grid
                                    Margin="0"
                                    Padding="0,15,0,10"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="0"
                                    RowDefinitions="100*"
                                    ColumnDefinitions="100*"
                                    VerticalOptions="FillAndExpand">

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0"
                                        Padding="15"
                                        BackgroundColor="White"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding IsInstrunctionVisible}"
                                        RowSpacing="0"
                                        VerticalOptions="FillAndExpand">
                                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">

                                            <StackLayout BackgroundColor="White">

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMediumBlackLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" />

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTSmallGoldLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsFirst}" />
                                                <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">

                                                    <Label
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ1}"
                                                        TextColor="{StaticResource Secondary}" />
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ2}"
                                                        TextColor="{StaticResource Primary}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="VATFaqTapped" />
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                </StackLayout>
                                                <Label
                                                    Margin="0,10,0,0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZZVATRFAQ3}"
                                                    TextColor="{StaticResource NeutralGreay}" />

                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMicroGrayLabel}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="1." />
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions1}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMicroGrayLabel}"
                                                    VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontSize="11"
                                                                Style="{StaticResource GAZTMicroGrayLabel}"
                                                                Text="2." />
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions2}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}" VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="3." />
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions3}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="4." />
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions4}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}" VerticalOptions="EndAndExpand">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="5." />
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions5}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="6." />
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditions6}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="7." />
                                                            <Span Style="{StaticResource GAZTMicroGrayLabel}" Text="{x:Static ResourceManager:AppResources.ZZZVATAmendInstrunctionsAndConditions7}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <StackLayout Orientation="Horizontal"
                                                             Spacing="10"
                                                             Margin="0,10">
                                                    <custom:CheckboxCustom
                                                        x:Name="chkDeclaration"
                                                        IsChecked="{Binding IsInstrunctionChecked}"
                                                        IsEnabled="{Binding InstAndCondition.CBAgreeCondition}"
                                                        Style="{StaticResource CheckboxHeightWidth32}"
                                                        VerticalOptions="CenterAndExpand" />

                                                    <Label Style="{DynamicResource IsInstrunctionCheckedStyle}"
                                                           Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}" />
                                                </StackLayout>
                                            </StackLayout>

                                        </ScrollView>

                                    </Grid>


                                    <!--  TaxPayers Details  -->
                                    <Grid
                                        x:Name="TaxPayersDetailsView"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        RowDefinitions="auto,auto"
                                        Padding="0,10,0,0"
                                        IsVisible="{Binding IsTaxPayersVisible}">
                                        <StackLayout Grid.Row="0">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="28"
                                                Style="{StaticResource SectionTitleBlackBold28}"
                                                Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                                                VerticalOptions="Center" />

                                            <Label Style="{StaticResource GAZTSmallBlackLbl}"
                                                   Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />

                                            <BoxView Margin="0,0,0,15" Style="{StaticResource lineSeperator}" />

                                        </StackLayout>

                                        <ScrollView Grid.Row="0"
                                                    VerticalScrollBarVisibility="Never">

                                            <Grid
                                                Padding="0"
                                                BackgroundColor="White"
                                                BindingContext="{Binding VATRegistrationDetailsData.d}"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="15"
                                                RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,20*"
                                                VerticalOptions="FillAndExpand">
                                                <!--  Start Of Read Only or pre-populated  -->

                                                <StackLayout Grid.Row="0">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.TIN}" />

                                                    <custom:CustomSfTextInputView
                                                        HorizontalOptions="FillAndExpand"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.TinEntry1, Source={x:Reference VATRegistration}}">
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Gpartz}"
                                                                TextColor="#bbbbbb">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZName}" />

                                                    <custom:CustomSfTextInputView HorizontalOptions="FillAndExpand">
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding TinNm}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="2">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRMainOutlet}" />

                                                    <custom:CustomSfTextInputView
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry1, Source={x:Reference VATRegistration}}">
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding CrNo}">
                                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                                </custom:GAZTBorderlessEntry.Behaviors>
                                                            </custom:GAZTBorderlessEntry>
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                    <custom:CustomSfTextInputView Margin="0,6,0,6" IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry2, Source={x:Reference VATRegistration}}">
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                FontSize="Small"
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding CrNm}"
                                                                TextColor="#bbbbbb" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>
                                                </StackLayout>

                                                <StackLayout Grid.Row="3">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZZVATRStartDate}" />

                                                    <custom:CustomSfTextInputView>
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                x:Name="Entry_CrStdt"
                                                                Margin="0"
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.StartdateToshow}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>
                                                </StackLayout>

                                                <StackLayout Grid.Row="4">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatAddress}" />

                                                    <custom:CustomSfTextInputView IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry1, Source={x:Reference VATRegistration}}">
                                                        <custom:GAZTBorderlessEntry
                                                            InputTransparent="True"
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}" />
                                                    </custom:CustomSfTextInputView>

                                                    <custom:CustomSfTextInputView IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry2, Source={x:Reference VATRegistration}}">
                                                        <custom:CustomSfTextInputView.TextInputView>

                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}" />
                                                        </custom:CustomSfTextInputView.TextInputView>

                                                    </custom:CustomSfTextInputView>
                                                </StackLayout>

                                                <StackLayout Grid.Row="5">

                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRSource}" />

                                                    <custom:CustomSfTextInputView
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.SourceEntry, Source={x:Reference VATRegistration}}">
                                                        <custom:CustomSfTextInputView.TextInputView>
                                                            <custom:GAZTBorderlessEntry
                                                                InputTransparent="True"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source}" />
                                                        </custom:CustomSfTextInputView.TextInputView>
                                                    </custom:CustomSfTextInputView>

                                                </StackLayout>

                                                <StackLayout Grid.Row="6" Margin="0,0,0,15">
                                                    <BoxView Margin="0,5,0,20" Style="{StaticResource lineSeperator}" />

                                                    <StackLayout
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.AddInformationCB, Source={x:Reference VATRegistration}}"
                                                        IsVisible="{Binding BindingContext.TaxPayerDetails.AddInformationCBVisible, Source={x:Reference VATRegistration}}"
                                                        Orientation="Horizontal"
                                                        Spacing="10"
                                                        Margin="0,10">
                                                        <custom:CheckboxCustom
                                                            CheckChanged="AddAdditionalInfo_CheckedChanged"
                                                            IsChecked="{Binding BindingContext.IsAddAdditionalInfoChecked, Source={x:Reference VATRegistration}}"
                                                            Style="{StaticResource CheckboxHeightWidth32}"
                                                            VerticalOptions="CenterAndExpand" />

                                                        <Label Style="{DynamicResource IsAddAdditionalInfoCheckedStyle}" Text="{x:Static ResourceManager:AppResources.VATRTPDetailsAdditionalInformation}" />

                                                    </StackLayout>

                                                    <Border
                                                        Padding="15,20,15,20"
                                                        BackgroundColor="White"
                                                        IsVisible="{Binding BindingContext.VatEligibleStartDateInsVisible, Source={x:Reference VATRegistration}}"
                                                        Stroke="#bbbbbb"
                                                        StrokeShape="RoundRectangle 10,10,10,10">
                                                        <StackLayout>

                                                            <Grid ColumnSpacing="10">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Information}"
                                                                            Size="30"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                </Image>

                                                                <StackLayout
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    Spacing="0"
                                                                    VerticalOptions="Start">
                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}" />
                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZVATRAdditionalInformationInstrunctionsFifthLine}" />
                                                                </StackLayout>
                                                            </Grid>
                                                        </StackLayout>

                                                    </Border>

                                                    <Border
                                                        Padding="15,20,15,20"
                                                        BackgroundColor="White"
                                                        IsVisible="{Binding BindingContext.IsNewVatEligibleDateInsVisible, Source={x:Reference VATRegistration}}"
                                                        Stroke="#bbbbbb"
                                                        StrokeShape="RoundRectangle 10,10,10,10">
                                                        <StackLayout>

                                                            <Grid ColumnDefinitions="20,*" RowDefinitions="auto">

                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Information}"
                                                                            Size="30"
                                                                            Color="#909090" />
                                                                    </Image.Source>
                                                                </Image>

                                                                <StackLayout
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    Spacing="0"
                                                                    VerticalOptions="Start">

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZNewVATRAdditionalInformationInstrunctionsFirstLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZNewVATRAdditionalInformationInstrunctionsSecondLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static ResourceManager:AppResources.ZZZNewVATRAdditionalInformationInstrunctionsThirdLine}" />

                                                                </StackLayout>
                                                            </Grid>
                                                        </StackLayout>

                                                    </Border>

                                                </StackLayout>
                                                <StackLayout Grid.Row="7" >

                                                    <StackLayout>
                                                        <Label
                                                            Padding="0,0,0,0"
                                                            HorizontalOptions="Start"
                                                            Style="{StaticResource ComponentHeaderBlackBold}">

                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource ComponentHeaderBlackBold}" Text="{x:Static ResourceManager:AppResources.VATREligibleStartDate}" />
                                                                    <Span Text="*" TextColor="#e84941" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <custom:CustomSfTextInputView x:Name="FrmEStartDate" IsEnabled="{Binding BindingContext.IsTaxPayerEligDateEnabled, Source={x:Reference VATRegistration}}">


                                                            <custom:CustomSfTextInputView.TextInputView>

                                                                <custom:GAZTBorderlessEntry
                                                                    x:Name="DateEntry"
                                                                    IsEnabled="False"
                                                                    Placeholder="{x:Static ResourceManager:AppResources.ddmmyyyyformat}"
                                                                    Style="{StaticResource DefaultEntry}"
                                                                    Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.VatEligibleStartDate}"
                                                                    TextChanged="DateEntry_TextChanged_1">
                                                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="VATEligibleDateClicked" />
                                                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                                </custom:GAZTBorderlessEntry>

                                                            </custom:CustomSfTextInputView.TextInputView>

                                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="VATEligibleDateClicked" />
                                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                                <Image
                                                                    HorizontalOptions="EndAndExpand"
                                                                    Source="calendar.png"
                                                                    Style="{StaticResource SmallIcon}" />
                                                            </inputLayout:SfTextInputLayout.TrailingView>

                                                        </custom:CustomSfTextInputView>

                                                        <custom:CustomDatePicker
                                                            x:Name="DpEStartDate"
                                                            Background="White"
                                                            Closed="DpEStartDate_Closed"
                                                            FutureDay="False"
                                                            HorizontalOptions="FillAndExpand"
                                                            IsEnabled="{Binding BindingContext.IsTaxPayerEligDateEnabled, Source={x:Reference VATRegistration}}"
                                                            ItemHeight="45"
                                                            Mode="Dialog"
                                                            OkButtonClicked="DpEStartDate_OkButtonClicked"
                                                            SelectedItem="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.TodayDate}">

                                                            <custom:CustomDatePicker.ColumnHeaderView>
                                                                <syncfusion:PickerColumnHeaderView Height="46" />
                                                            </custom:CustomDatePicker.ColumnHeaderView>


                                                            <custom:CustomDatePicker.SelectionView>
                                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                                            </custom:CustomDatePicker.SelectionView>

                                                            <custom:CustomDatePicker.SelectedTextStyle>
                                                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                            </custom:CustomDatePicker.SelectedTextStyle>

                                                            <custom:CustomDatePicker.HeaderView>

                                                                <syncfusion:PickerHeaderView
                                                                    Height="46"
                                                                    Background="{StaticResource PrimaryColor}"
                                                                    Text="{x:Static ResourceManager:AppResources.VATREligibleStartDate}">

