<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATAmendReactivationPages.VATAmendReactivationSuccessfulPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundColor="{StaticResource Primary}"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="BoxView">
                <Setter Property="HeightRequest" Value="10" />
                <Setter Property="WidthRequest" Value="10" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">
                <Image
                    Aspect="AspectFit"
                    HeightRequest="120"
                    Source="Forget_ic_success.png"
                    WidthRequest="120" />
                <Label
                    x:Name="lblSuccessMessage"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PageTitleWhite}"
                    Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgment}" />
                <Label
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BodyLabelWhite}"
                    Text="{x:Static ResourceManager:AppResources.VATAmendReactivationSuccessfulAkwdg}" />
            </StackLayout>
            <ScrollView>
                <Border
                    Margin="0,-20,0,0"
                    Padding="20"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 22,22,0,0"
                    VerticalOptions="EndAndExpand">
                    <StackLayout Padding="0,0,0,10">
                        <Border
                            Margin="0,20,0,0"
                            Padding="0"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 8,8,8,8">
                            <Grid Padding="10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATRSName}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="Label_Name"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    Style="{StaticResource BodyLabelBlackMedium}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,20,0,0"
                            Padding="0"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 8,8,8,8">
                            <StackLayout Padding="10" Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATRSAppNumber}"
                                    VerticalOptions="Center" />
                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                    <Label
                                        x:Name="Label_ApplicationNumber"
                                        Style="{StaticResource BodyLabelBlackMedium}"
                                        Text=""
                                        VerticalOptions="Center" />
                                    <Image Source="MainGrayCopy" Style="{StaticResource SmallIcon}" />
                                </StackLayout>
                            </StackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Image_Copy_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Margin="0,20,0,10"
                            Padding="0"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 8,8,8,8">
                            <StackLayout Padding="10" Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.Date}"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="Label_Date"
                                    HorizontalOptions="EndAndExpand"
                                    Style="{StaticResource BodyLabelBlackMedium}"
                                    VerticalOptions="Center" />
                            </StackLayout>
                        </Border>
                        <buttons:SfButton
                            Grid.ColumnSpan="2"
                            Margin="10,20,10,20"
                            Clicked="SfButton_Clicked"
                            FontAttributes="Bold"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.VatInstalmentDownload}"
                            VerticalOptions="End" />
                        <buttons:SfButton
                            x:Name="btnDashboard"
                            Grid.ColumnSpan="2"
                            Margin="10,0,10,0"
                            Clicked="btnDashboard_Clicked"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}"
                            VerticalOptions="End" />
                    </StackLayout>
                </Border>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>