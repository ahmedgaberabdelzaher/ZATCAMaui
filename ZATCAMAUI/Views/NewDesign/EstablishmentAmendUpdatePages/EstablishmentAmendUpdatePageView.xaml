<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentAmendUpdatePages.EstablishmentAmendUpdatePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:SfChipGroup="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    x:Name="ESTAmendReactivationPage"
    Title="{Binding PageTitle}"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:EstablishmentTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <converters:ESTresidentialStatusConverter x:Key="residentialStatusConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Border
                Margin="0"
                Padding="0"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                StrokeShape="RoundRectangle 15,15,0,0"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ContentPresenter
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </StackLayout>
            </Border>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*,Auto">
            <!--#region Header-->
            <StackLayout
                Grid.Row="0"
                Padding="20,15"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                Spacing="0"
                VerticalOptions="StartAndExpand">
                <!--#region BackButton Row-->
                <Grid
                    Padding="0,0,0,10"
                    ColumnSpacing="0"
                    RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*" />
                        <ColumnDefinition Width="70*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>

                     <Image
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeft.png"
                        VerticalOptions="CenterAndExpand">
                         <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>
                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        HeightRequest="40"
                        Source="ic_logo_gazt.png"
                        WidthRequest="34" />

                    <StackLayout Grid.Row="0" Grid.Column="2">
                        <StackLayout
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Rotation="90"
                            Spacing="3"
                            VerticalOptions="CenterAndExpand">
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnVoidOrSaveDraftClick}" NumberOfTapsRequired="1" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </Grid>
                <!--#endregion-->
                <commonView:PageIndicatorView
                    Completed="{Binding MarkComplete}"
                    DotSize="12"
                    HorizontalOptions="End"
                    MarkSize="24"
                    MaxNum="{Binding MaxIndex}"
                    MinNum="{Binding CurrentIndex}" />
                <Label
                    Margin="0,10,0,0"
                    FontFamily="{StaticResource SomarBold}"
                    HorizontalOptions="Start"
                    Style="{StaticResource PageTitleBlack}"
                    Text="{Binding SelectedTabText}"
                    VerticalOptions="Center" />
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource BodyLabelGrey}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                <BoxView Margin="0,15" Style="{StaticResource lineSeperator}" />

                <!--#region Chip groups-->
                <ScrollView
                    x:Name="TabScrollView"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">

                    <SfChipGroup:SfChipGroup
                        x:Name="TabSfChipGroup"
                        Margin="0,5,0,0"
                        ChipBackground="Transparent"
                        ChipStroke="{StaticResource NeutralLightGrey}"
                        ChipStrokeThickness="1"
                        ChipType="Choice"
                        HorizontalOptions="Start"
                        ItemsSource="{Binding TabList}"
                        SelectedItem="{Binding SelectedTabText}"
                        SelectionChanged="SfChipGroup_SelectionChanged"
                        SelectionChanging="SfChipGroup_SelectionChanging"
                        VerticalOptions="Center">
                        <SfChipGroup:SfChipGroup.ItemTemplate>
                            <DataTemplate>
                                <StackLayout
                                    Margin="0"
                                    Padding="5,2,5,2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Label
                                        HorizontalOptions="CenterAndExpand"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{Binding}" />
                                </StackLayout>
                            </DataTemplate>
                        </SfChipGroup:SfChipGroup.ItemTemplate>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="ChipBackground" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="ChipBackground" Value="{StaticResource PartialBg}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </SfChipGroup:SfChipGroup>

                </ScrollView>
                <!--#endregion-->
            </StackLayout>
            <!--#endregion-->

            <!--#region Body-->
            <Grid
                Grid.Row="1"
                Padding="10,10,10,0"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">


                <!--#region Registration Type-->
                <Grid
                    x:Name="RegistrationTabMainGrid"
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}"
                    VerticalOptions="StartAndExpand">
                    <ScrollView
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <Grid
                            x:Name="RegistrationTab"
                            HorizontalOptions="FillAndExpand"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="24"
                            VerticalOptions="FillAndExpand">
                            <StackLayout Grid.Row="0">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource forLightLabel}"
                                                Text="{x:Static ResourceManager:AppResources.ESTEntityTypeQuestionLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    Padding="0,10,0,0"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding SelectedEntityType}" />
                            </StackLayout>
                            <StackLayout Grid.Row="1">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource forLightLabel}"
                                                Text="{x:Static ResourceManager:AppResources.NDWhatisYourNationality}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    Padding="0,10,0,0"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding SelectedRegNationalityType}" />
                            </StackLayout>
                            <Grid Grid.Row="2" IsVisible="{Binding IsSaudi, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource forLightLabel}"
                                                Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusQuestionLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>
                                <buttons:SfButton
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Background="#cee0dd"
                                    CornerRadius="20"
                                    HorizontalOptions="EndAndExpand"
                                    ImageSize="25"
                                    ImageSource="Paid_check.png"
                                    IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                    ShowIcon="True"
                                    StrokeThickness="1"
                                    Text="{x:Static ResourceManager:AppResources.ESTResidentOptionValue}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="CenterAndExpand" />

                            </Grid>
                            <StackLayout
                                x:Name="NationalityStatusOptionmain"
                                Grid.Row="3"
                                IsVisible="{Binding IsSaudi, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}">
                                <Grid ColumnSpacing="24" RowSpacing="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="104" />
                                        <RowDefinition Height="104" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        x:Name="StayMoreKsagrid"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusStayMoreThanKSAClick}" />
                                        </Grid.GestureRecognizers>
                                        <cards:SfCardView
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            CornerRadius="20"
                                            HeightRequest="104"
                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            WidthRequest="171">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="unselected171x136"
                                                    VerticalOptions="FillAndExpand" />
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <Label Style="{DynamicResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}" />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                        <cards:SfCardView
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            CornerRadius="20"
                                            HeightRequest="104"
                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                            WidthRequest="171">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="selected171x136"
                                                    VerticalOptions="FillAndExpand" />
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <Label Style="{DynamicResource CardLabelWhite}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}" />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                    </Grid>
                                    <Grid
                                        x:Name="OwnhouseGrid"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusRentOwnHouseClick}" />
                                        </Grid.GestureRecognizers>
                                        <cards:SfCardView
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            CornerRadius="20"
                                            HeightRequest="104"
                                            IsVisible="{Binding IsClickedOwnRentOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            WidthRequest="171">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="unselected171x136"
                                                    VerticalOptions="FillAndExpand" />
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <Label Style="{DynamicResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}" />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                        <cards:SfCardView
                                            x:Name="OwnhouseCard"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            CornerRadius="20"
                                            HeightRequest="104"
                                            IsVisible="{Binding IsClickedOwnRentOption}"
                                            WidthRequest="171">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="selected171x136"
                                                    VerticalOptions="FillAndExpand" />
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <Label Style="{DynamicResource CardLabelWhite}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}" />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                    </Grid>
                                    <Grid
                                        x:Name="NoneOfTheAboveGrid"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusNoneOfTheAboveClick}" />
                                        </Grid.GestureRecognizers>
                                        <cards:SfCardView
                                            x:Name="NoneOfTheAboveCard"
                                            CornerRadius="20"
                                            HeightRequest="104"
                                            IsVisible="{Binding IsClickedNoneOfTheAboveOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            WidthRequest="171">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="unselected171x136"
                                                    VerticalOptions="FillAndExpand" />
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <Label Style="{DynamicResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}" />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                        <cards:SfCardView
                                            CornerRadius="20"
                                            HeightRequest="104"
                                            IsVisible="{Binding IsClickedNoneOfTheAboveOption}"
                                            WidthRequest="171">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="selected171x136"
                                                    VerticalOptions="FillAndExpand" />
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <Label Style="{DynamicResource CardLabelWhite}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}" />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                            <!--  Attachment layout start  -->
                            <StackLayout
                                x:Name="RentAttachmentsMainLayout"
                                Grid.Row="4"
                                IsVisible="{Binding IsClickedOwnRentOption}"
                                Spacing="24">
                                <Label Style="{StaticResource ButtonLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.ZVatAttachments}" />
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        Style="{StaticResource forLightLabel}"
                                                        Text="{x:Static ResourceManager:AppResources.ESTProvideAttachmentCopyofRentLabel}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Image
                                            HeightRequest="20"
                                            HorizontalOptions="EndAndExpand"
                                            Source="ic_vat_info.png"
                                            WidthRequest="20">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </StackLayout>
                                    <StackLayout>
                                        <Border
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">
                                            <StackLayout
                                                Padding="5,15,5,15"
                                                IsEnabled="True"
                                                Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{x:Static ResourceManager:AppResources.Attachments}" />
                                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="5,0"
                                                        HeightRequest="20"
                                                        HorizontalOptions="Start"
                                                        Source="ic_attachment"
                                                        VerticalOptions="Center"
                                                        WidthRequest="20" />
                                                </StackLayout>
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnEstablishmentRegistrationAttachmentTapped}" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Border>
                                    </StackLayout>
                                </StackLayout>
                                <StackLayout IsVisible="{Binding IsVisbleRentAttachmentmentList}">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyofRentLabel}" />
                                    <StackLayout
                                        Margin="0,5,0,0"
                                        BindableLayout.ItemsSource="{Binding UploadedRentDocumentsList, Mode=TwoWay}"
                                        Spacing="5"
                                        VerticalOptions="FillAndExpand">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="10"
                                                    Stroke="{StaticResource NeutralGreay}"
                                                    StrokeShape="RoundRectangle 10,10,10,10"
                                                    StrokeThickness="1"
                                                    Style="{StaticResource GreyBorderFrame}">
                                                    <Grid
                                                        ColumnSpacing="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        RowSpacing="0"
                                                        VerticalOptions="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            HorizontalOptions="Center"
                                                            Source="Generic_attachment_icon.png"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            HorizontalOptions="StartAndExpand"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Image
                                                            Grid.Column="2"
                                                            HorizontalOptions="Center"
                                                            Source="close.png"
                                                            VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer CommandParameter="Rentcommand" Tapped="TapRentDeleteGestureRecognizer_Tapped" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout
                                x:Name="NoneOfTheAboveOptionsLayout"
                                Grid.Row="5"
                                IsVisible="{Binding IsClickedNoneOfTheAboveOption}">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontFamily="{StaticResource SomarRegular}"
                                                Style="{StaticResource forLightLabel}"
                                                Text="{x:Static ResourceManager:AppResources.ESTChooseLegalEntityBelowTitleLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout>
                                    <Grid ColumnSpacing="24" RowSpacing="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            x:Name="PermanentEstablishmentGrid"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            ColumnSpacing="24"
                                            RowSpacing="24">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104" />
                                            </Grid.RowDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PermanentEstablishmentLegalEntityClick}" />
                                            </Grid.GestureRecognizers>
                                            <cards:SfCardView
                                                CornerRadius="20"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedPermanentLegalEntity, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="unselected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <Label Style="{DynamicResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                            <cards:SfCardView
                                                CornerRadius="20"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedPermanentLegalEntity}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
