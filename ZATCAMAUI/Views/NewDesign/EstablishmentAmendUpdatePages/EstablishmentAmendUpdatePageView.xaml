                    Command="{Binding OnNextButtonClick}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding NxtButtonLabel}" />
            </Grid>
            <!--#endregion-->

            <!--#region Loader-->
            <custom:Loader Grid.RowSpan="3" IsVisible="{Binding IsLoading}" />
            <!--#endregion-->


        </Grid>
    </ContentPage.Content>
</ContentPage>
