<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentAmendUpdatePages.ActivityItemAmendUpdatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    x:Name="ESTActivityAmendUpdateItemPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:EstablishmentRegistrationActivityTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:EstablishmentMainActivityToVisibilityConverter x:Key="isMainActivityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Border
                Margin="0"
                Padding="0"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                StrokeShape="RoundRectangle 15,15,0,0"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ContentPresenter
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </StackLayout>
            </Border>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            Padding="0"
            ColumnSpacing="0"
            RowDefinitions="Auto, *,Auto"
            RowSpacing="0">




            <!--#region Header-->
            <StackLayout
                Grid.Row="0"
                Padding="20,15"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                Spacing="0"
                VerticalOptions="StartAndExpand">
                <Grid
                    Padding="0,0,0,10"
                    ColumnSpacing="0"
                    RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" />
                        <ColumnDefinition Width="75*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeft.png"
                        VerticalOptions="CenterAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        HeightRequest="27"
                        Source="ic_logo_gazt.png"
                        WidthRequest="27" />
                </Grid>
                <Label
                    Padding="0,5,0,10"
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="28"
                    HorizontalOptions="Start"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{Binding ActivityTitle}"
                    VerticalOptions="Center" />
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HorizontalOptions="StartAndExpand"
                    IsVisible="{Binding DisplayCompleteDetailsLabel}"
                    Style="{StaticResource forLightLabel}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                <BoxView
                    Margin="0,15"
                    BackgroundColor="WhiteSmoke"
                    HeightRequest="1" />
            </StackLayout>
            <!--#endregion-->

            <!--#region Body-->
            <Grid
                Grid.Row="1"
                Padding="20,10,20,0"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">
                <!--#region CR Details Form-->
                <ScrollView
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}}"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill">
                        <Label
                            Margin="0,0,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueCountryLabel}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding ActivityDetails.IssueCountry, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding ActivityDetails.IssueCountry, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRIssueCountry, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueCountrySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueCountrySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueBy}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding ActivityDetails.IssueBy, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding ActivityDetails.IssueBy, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRIssueBy, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueBySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueBySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueCity}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding ActivityDetails.IssueCity, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding ActivityDetails.IssueCity, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRIssueCity, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueCitySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueCitySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZCRName}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <custom:CustomSfTextInputView IsEnabled="{Binding EnableCRInputField}" Style="{StaticResource TextInputLayout}">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Keyboard="Text"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CrName}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZCRNumber}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <StackLayout Padding="0" IsEnabled="{Binding ActivityDetails.CRNo}">

                            <custom:CustomSfTextInputView IsEnabled="{Binding EnableCRInputField}" Style="{StaticResource TextInputLayout}">

                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding CRNumber}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="CREntry_Unfocused"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center">

                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:NumericValidationBehavior />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>

                        </StackLayout>
                        <!--  CR National number start  -->
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ZZCRNationalNumber}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <StackLayout Padding="0" IsEnabled="{Binding ActivityDetails.CRNo}">
                            <custom:CustomSfTextInputView IsEnabled="{Binding EnableCRNationalInputField}" Style="{StaticResource TextInputLayout}">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="{Binding EnableCRNationalInputField}"
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        Text="{Binding CRNationalNumber}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="CR_National_Entry_Unfocused"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center">

                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:NumericValidationBehavior />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </custom:CustomSfTextInputView.TextInputView>
                            </custom:CustomSfTextInputView>
                        </StackLayout>
                        <!--  CR National number   End  -->
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTValidFrom}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding ActivityDetails.ValidFrom, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding ActivityDetails.ValidFrom, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding DisplayCRValidFrom, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="crValidFromButtonClick" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="crValidFromButtonClick" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image
                                    HorizontalOptions="EndAndExpand"
                                    Source="calendar.png"
                                    Style="{StaticResource SmallIcon}" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>

                        <custom:CustomDatePicker
                            x:Name="crValidFromPicker"
                            Margin="10,0,10,0"
                            Background="White"
                            Closed="crValidFromPicker_Closed"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            Mode="Dialog"
                            SelectedItem="{Binding SelectedCRValidFromDate}">

                            <custom:CustomDatePicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                            </custom:CustomDatePicker.ColumnHeaderView>

                            <custom:CustomDatePicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                            </custom:CustomDatePicker.SelectionView>

                            <custom:CustomDatePicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </custom:CustomDatePicker.SelectedTextStyle>


                            <custom:CustomDatePicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                    Height="46"
                                    Background="{StaticResource NeutralBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}">

                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>

                                </syncfusion:PickerHeaderView>
                            </custom:CustomDatePicker.HeaderView>

                            <custom:CustomDatePicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </custom:CustomDatePicker.FooterView>


                        </custom:CustomDatePicker>

                        <custom:CustomHijriDatePicker
                            x:Name="crValidFromHijiriPicker"
                            Margin="10,0,10,0"
                            Background="White"
                            Closed="crValidFromPicker_Closed"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            Mode="Dialog"
                            SelectedItem="{Binding SelectedCRValidFromHijiriDate}">

                            <custom:CustomHijriDatePicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                            </custom:CustomHijriDatePicker.SelectionView>

                            <custom:CustomHijriDatePicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                            </custom:CustomHijriDatePicker.ColumnHeaderView>

                            <custom:CustomHijriDatePicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </custom:CustomHijriDatePicker.SelectedTextStyle>


                            <custom:CustomHijriDatePicker.HeaderView>


                                <syncfusion:PickerHeaderView
                                    Height="46"
                                    Background="{StaticResource NeutralBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}">

                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>

                                </syncfusion:PickerHeaderView>

                            </custom:CustomHijriDatePicker.HeaderView>

                            <custom:CustomHijriDatePicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </custom:CustomHijriDatePicker.FooterView>

                        </custom:CustomHijriDatePicker>

                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding ActivityDetails.IsMainActivityVisible}"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ESTMainActivity}"
                                VerticalOptions="Center" />
                            <buttons:SfSwitch
                                x:Name="CRMainActivity"
                                HorizontalOptions="Center"
                                IsOn="{Binding MainActivity}"
                                StateChanged="CRSwitch_StateChanged"
                                VerticalOptions="Center"
                                Visual="Default" />
                        </StackLayout>
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            Text="{x:Static ResourceManager:AppResources.Attachments}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyOfCRLabel}"
                                VerticalOptions="Center" />

                            <Image
                                HorizontalOptions="Center"
                                Source="ic_vat_info.png"
                                VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout Padding="0" IsEnabled="{Binding ActivityDetails.CRCopy}">
                            <buttons:SfButton
                                Margin="0,5,0,0"
                                Padding="5"
                                Command="{Binding OnTransferCopyOfCRChoiceButtonClick}"
                                CommandParameter="RG01"
                                CornerRadius="14"
                                FontSize="13"
                                HorizontalTextAlignment="Start"
                                ImageAlignment="End"
                                ImageSource="ic_attachment"
                                IsEnabled="{Binding ActivityDetails.CRCopy}"
                                ShowIcon="True"
                                Stroke="{StaticResource NeutralGreay}"
                                StrokeThickness="1"
                                Style="{StaticResource ButtonBlackBold16}"
                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                TextColor="{StaticResource NeutralGreay}" />
                        </StackLayout>

                        <StackLayout
                            Margin="0,5,0,0"
                            BindableLayout.ItemsSource="{Binding CRsCopies}"
                            Spacing="5"
                            VerticalOptions="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        FlowDirection="{Binding Source={x:Reference ESTActivityAmendUpdateItemPage}, Path=FlowDirection}"
                                        Padding="10"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 14,14,14,14"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="Generic_attachment_icon.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding Filename}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding BindingContext.ActivityDetails.DeleteCRcopy, Source={x:Reference ESTActivityAmendUpdateItemPage}}"
                                                Source="closeGrey.png"
                                                VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={Reference ESTActivityAmendUpdateItemPage}, Path=BindingContext.OnDeleteCRsCopyButtonClick}"
                                                        CommandParameter="{Binding .}"
                                                        NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <Label
                            Margin="0,15,0,0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding ActivityDetails.IsTransferCRCopyVisible}"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ESTAttachmentTransferCopyOfCRLabel}"
                            VerticalOptions="Center" />
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            Command="{Binding OnTransferCopyOfCRChoiceButtonClick}"
                            CommandParameter="RG12"
                            CornerRadius="14"
                            FontSize="13"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="ic_attachment"
                            IsVisible="{Binding ActivityDetails.IsTransferCRCopyVisible}"
                            ShowIcon="True"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeThickness="1"
                            Style="{StaticResource ButtonBlackBold16}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                            TextColor="{StaticResource NeutralGreay}" />

                        <StackLayout
                            Margin="0,5,0,0"
                            BindableLayout.ItemsSource="{Binding TransferCRsCopies}"
                            Spacing="5"
                            VerticalOptions="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10"
                                        FlowDirection="{Binding Source={x:Reference ESTActivityAmendUpdateItemPage}, Path=FlowDirection}"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 14,14,14,14"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="Generic_attachment_icon.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding Filename}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding BindingContext.ActivityDetails.DeleteTransferCRCopy, Source={x:Reference ESTActivityAmendUpdateItemPage}}"
                                                Source="close.png"
                                                VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={Reference ESTActivityAmendUpdateItemPage}, Path=BindingContext.OnDeleteTransferCRsCopyButtonClick}"
                                                        CommandParameter="{Binding .}"
                                                        NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <Label
                            Margin="0,15"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            IsVisible="{Binding ActivityDetails.MainGroup}"
                            Text="{x:Static ResourceManager:AppResources.ESTBusinessActivityDetails}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <buttons:SfButton
                            Command="{Binding OnActivitiesButtonClick}"
                            CommandParameter="CRData"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.EstActivities}" />
                    </StackLayout>
                </ScrollView>
                <!--#endregion-->
                <StackLayout
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.ActivityList}}"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <buttons:SfButton
                        Padding="5"
                        Command="{Binding OnNewLicenseButtonClick}"
                        CornerRadius="14"
                        HeightRequest="56"
                        HorizontalTextAlignment="Start"
                        ImageSource="ic_add_plus.png"
                        IsEnabled="{Binding AddLicenseEnabled}"
                        ShowIcon="True"
                        Stroke="{StaticResource NeutralGreay}"
                        StrokeThickness="1"
                        Style="{StaticResource ButtonBlackBold16}"
                        Text="{x:Static ResourceManager:AppResources.ESTAddLicense}"
                        TextColor="{StaticResource NewDarkGreenColor}" />
                    <listView:SfListView
                        Margin="0,15"
                        AutoFitMode="Height"
                        HorizontalOptions="Fill"
                        ItemSpacing="5"
                        ItemsSource="{Binding LicenseData}"
                        ScrollBarVisibility="Never"
                        SelectedItem="{Binding SelectedLicense}"
                        SelectionBackground="Transparent"
                        SelectionMode="Single"
                        VerticalOptions="Start">
                        <listView:SfListView.ItemsLayout>
                            <listView:LinearLayout />
                        </listView:SfListView.ItemsLayout>
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    FlowDirection="{Binding Source={x:Reference ESTActivityAmendUpdateItemPage}, Path=FlowDirection}"
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource NeutralGreay}"
                                    BorderWidth="0.7">
                                    <Grid
                                        Padding="12"
                                        ColumnSpacing="10"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            FontFamily="{StaticResource SomarBold}"
                                            FontSize="15"
                                            HorizontalOptions="FillAndExpand"
                                            Text="{Binding Idnumber}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center" />
                                        <Image
                                            Grid.Column="1"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding Actcat, Converter={StaticResource isMainActivityConverter}}"
                                            Source="check_oval.png"
                                            VerticalOptions="Center" />

                                        <Image
                                            Grid.Column="2"
                                            Source="{Binding ArrowImageSource}"
                                            VerticalOptions="CenterAndExpand" />

                                    </Grid>
                                    <cards:SfCardView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={Reference ESTActivityAmendUpdateItemPage}, Path=BindingContext.OnLicenseSelected}" CommandParameter="{Binding .}" />
                                    </cards:SfCardView.GestureRecognizers>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </StackLayout>
                <!--#region License details form-->
                <ScrollView
                    Margin="0,0,0,30"
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.LicenseDetails}}"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill">
                        <Label
                            Margin="0,0,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueCountryLabel}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding LicenseDetails.IssueCountry, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding LicenseDetails.IssueCountry, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding LicenseIssueCountry, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueCountrySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueCountrySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueBy}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding LicenseDetails.IssueBy, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding LicenseDetails.IssueBy, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding LicenseIssueBy, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueBySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueBySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueCity}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding LicenseDetails.IssueCity, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding LicenseDetails.IssueCity, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding LicenseIssueCity, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueCitySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueCitySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>


                        <custom:CustomSfTextInputView Style="{StaticResource TextInputLayout}">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsEnabled="{Binding LicenseDetails.LicenseNo}"
                                    Keyboard="Numeric"
                                    MaxLength="30"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Text="{Binding LicenseNumber}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center">

                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behaviors:AlphaNumericValidatorBehaviour />
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZLicenseName}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView Style="{StaticResource TextInputLayout}">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsEnabled="{Binding LicenseDetails.LicenseName}"
                                    Keyboard="Plain"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding LicenseName}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTValidFrom}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="{Binding LicenseDetails.ValidFrom, Converter={StaticResource InverseBoolConverter}}"
                                    IsReadOnly="{Binding LicenseDetails.ValidFrom, Converter={StaticResource InverseBoolConverter}}"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding DisplayValidFrom, TargetNullValue=''}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="validFromButtonClick" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="validFromButtonClick" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image
                                    HorizontalOptions="EndAndExpand"
                                    Source="calendar.png"
                                    Style="{StaticResource SmallIcon}" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>
                        <custom:CustomDatePicker
                            x:Name="validFromPicker"
                            Margin="10,0,10,0"
                            Background="White"
                            Closed="validFromPicker_Closed"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            Mode="Dialog"
                            SelectedItem="{Binding SelectedValidFromDate}">

                            <custom:CustomDatePicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                            </custom:CustomDatePicker.ColumnHeaderView>

                            <custom:CustomDatePicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                            </custom:CustomDatePicker.SelectionView>

                            <custom:CustomDatePicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                    Height="46"
                                    Background="{StaticResource NeutralBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}">

                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>

                                </syncfusion:PickerHeaderView>

                            </custom:CustomDatePicker.HeaderView>

                            <custom:CustomDatePicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </custom:CustomDatePicker.SelectedTextStyle>

                            <custom:CustomDatePicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </custom:CustomDatePicker.FooterView>


                        </custom:CustomDatePicker>

                        <custom:CustomHijriDatePicker
                            x:Name="validFromHijiriPicker"
                            Margin="10,0,10,0"
                            Background="White"
                            Closed="validFromPicker_Closed"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            Mode="Dialog"
                            SelectedItem="{Binding SelectedValidFromHijiriDate}">

                            <custom:CustomHijriDatePicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                            </custom:CustomHijriDatePicker.SelectionView>

                            <custom:CustomHijriDatePicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                            </custom:CustomHijriDatePicker.ColumnHeaderView>

                            <custom:CustomHijriDatePicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                    Height="46"
                                    Background="{StaticResource NeutralBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}">

                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>

                                </syncfusion:PickerHeaderView>

                            </custom:CustomHijriDatePicker.HeaderView>


                            <custom:CustomHijriDatePicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </custom:CustomHijriDatePicker.SelectedTextStyle>


                            <custom:CustomHijriDatePicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </custom:CustomHijriDatePicker.FooterView>

                        </custom:CustomHijriDatePicker>

                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding LicenseDetails.IsMainActivityVisible}"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ESTMainActivity}"
                                VerticalOptions="Center" />
                            <buttons:SfSwitch
                                x:Name="LicenseMainActivity"
                                HorizontalOptions="Center"
                                IsOn="{Binding MainActivity}"
                                StateChanged="LicenseSwitch_StateChanged"
                                VerticalOptions="Center"
                                Visual="Default" />
                        </StackLayout>
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            Text="{x:Static ResourceManager:AppResources.Attachments}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyOfLicense}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Image
                                HorizontalOptions="Center"
                                Source="ic_vat_info.png"
                                VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout Padding="0" IsEnabled="{Binding LicenseDetails.LicenseCopy}">
                            <buttons:SfButton
                                Margin="0,5,0,0"
                                Padding="5"
                                Command="{Binding OnTransferCopyOfLicenseChoiceButtonClick}"
                                CommandParameter="RG02"
                                CornerRadius="14"
                                FontSize="13"
                                HorizontalTextAlignment="Start"
                                ImageAlignment="End"
                                ImageSource="ic_attachment"
                                IsEnabled="{Binding LicenseDetails.LicenseCopy}"
                                ShowIcon="True"
                                Stroke="{StaticResource NeutralGreay}"
                                StrokeThickness="1"
                                Style="{StaticResource NoBackgroundButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                TextColor="{StaticResource NeutralGreay}" />
                        </StackLayout>
                        <StackLayout
                            Margin="0,5,0,0"
                            BindableLayout.ItemsSource="{Binding LicensesCopies}"
                            Spacing="5"
                            VerticalOptions="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10"
                                        FlowDirection="{Binding Source={x:Reference ESTActivityAmendUpdateItemPage}, Path=FlowDirection}"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 14,14,14,14"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="Generic_attachment_icon.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding Filename}"
                                                VerticalOptions="CenterAndExpand"
                                                VerticalTextAlignment="Center" />
                                            <StackLayout Grid.Column="2">
                                                <Image
                                                    HorizontalOptions="Center"
                                                    IsVisible="{Binding BindingContext.LicenseDetails.DeleteLicenseCopy, Source={x:Reference ESTActivityAmendUpdateItemPage}}"
                                                    Source="close.png"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={Reference ESTActivityAmendUpdateItemPage}, Path=BindingContext.OnDeleteLicenseCopyButtonClick}"
                                                            CommandParameter="{Binding .}"
                                                            NumberOfTapsRequired="1" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <Label
                            Margin="0,15"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            Text="{x:Static ResourceManager:AppResources.ESTBusinessActivityDetails}"
                            TextColor="{StaticResource NeutralBlack}" />

                        <buttons:SfButton
                            Command="{Binding OnActivitiesButtonClick}"
                            CommandParameter="License"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.EstActivities}" />

                    </StackLayout>
                </ScrollView>
                <!--#endregion-->
            </Grid>
            <Grid
                Grid.Row="2"
                Margin="0,20,0,20"
                Padding="20,0,20,35"
                BackgroundColor="White">
                <buttons:SfButton
                    Command="{Binding OnNextButtonClick}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZNext}" />
            </Grid>
            <!--#endregion-->

            <!--#region Loader-->
            <custom:Loader Grid.RowSpan="3" IsVisible="{Binding IsLoading}" />
            <!--#endregion-->

        </Grid>
    </ContentPage.Content>
</ContentPage>
