<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentAmendUpdatePages.OutletDetailsAmendUpdatePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:EstablishmentRegistrationOutletTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <yummy:PancakeView
                Margin="0"
                Padding="0"
                BackgroundColor="White"
                CornerRadius="{OnPlatform Android='15,15,0,0',
                                          iOS='15'}"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ContentPresenter
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </StackLayout>
            </yummy:PancakeView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            Padding="0"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="1"
                Padding="20,10,20,0"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">
                <ScrollView
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}"
                        Orientation="Vertical"
                        Spacing="0"
                        VerticalOptions="FillAndExpand">
                        <custom:CustomLabel
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="15"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}"
                            TextColor="{StaticResource NeutralGreay}"
                            VerticalOptions="Center" />
                        <custom:CustomLabel
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="15"
                            HorizontalOptions="StartAndExpand"
                            Text="{Binding OutletActNumber}"
                            TextColor="{StaticResource NeutralBlack}"
                            VerticalOptions="Center" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="11"
                            HorizontalOptions="StartAndExpand"
                            TextColor="{StaticResource NeutralGreay}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.OutletTypeField}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            Clicked="OutletType_Clicked"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            IsEnabled="{Binding OutletDetails.OutletType}"
                            ShowIcon="True"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeThickness="1"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding SelectedOutletType}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="11"
                            HorizontalOptions="StartAndExpand"
                            TextColor="{StaticResource NeutralGreay}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTOutletCommercialName}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout
                            Margin="0,-6,0,-6"
                            ContainerType="Outlined"
                            Stroke="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                            IsEnabled="{Binding OutletDetails.OutletName}"
                            LeadingViewPosition="Inside"
                            Style="{StaticResource TextInputLayout}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020"/>

                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <Entry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                IsSpellCheckEnabled="false"
                                Placeholder="{x:Static ResourceManager:AppResources.ESTName}"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding OutletName}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </inputLayout:SfTextInputLayout>
                    </StackLayout>
                </ScrollView>
                <ScrollView
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.ActivityDetails}}"
                    Orientation="Vertical"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical"
                        Spacing="0"
                        VerticalOptions="FillAndExpand">
                        <busyindicator:SfEffectsView TouchDownCommand="{Binding OnActivityItemButtonClick}" TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}">
                            <Border
                                Padding="15"
                                Stroke="{StaticResource NeutralGreay}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <Grid
                                    ColumnSpacing="0"
                                    HorizontalOptions="Fill"
                                    RowSpacing="0"
                                    VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        Source="deregistration.png"
                                        VerticalOptions="Center" />
                                    <custom:CustomLabel
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistration}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </busyindicator:SfEffectsView>
                        <busyindicator:SfEffectsView
                            Margin="0,20"
                            TouchDownCommand="{Binding OnActivityItemButtonClick}"
                            TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.LicenseDetails}">
                            <Border
                                Padding="15"
                                Stroke="{StaticResource NeutralGreay}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <Grid
                                    ColumnSpacing="0"
                                    HorizontalOptions="Fill"
                                    RowSpacing="0"
                                    VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        Source="deregistration.png"
                                        VerticalOptions="Center" />
                                    <custom:CustomLabel
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="{x:Static ResourceManager:AppResources.ESTLicenseDetails}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </busyindicator:SfEffectsView>
                        <Border
                            Padding="15"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            StrokeThickness="1">
                            <Grid
                                ColumnSpacing="0"
                                HorizontalOptions="Fill"
                                RowSpacing="0"
                                VerticalOptions="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="ic_vat_info.png"
                                    VerticalOptions="Center" />
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.Information}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfo}"
                                    VerticalOptions="CenterAndExpand"
                                    VerticalTextAlignment="Start" />
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,20,0,10"
                            Padding="15"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            StrokeThickness="1">
                            <Grid
                                ColumnSpacing="0"
                                HorizontalOptions="Fill"
                                RowSpacing="0"
                                VerticalOptions="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="ic_vat_info.png"
                                    VerticalOptions="Center" />
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.Information}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfoTwo}"
                                    VerticalOptions="CenterAndExpand"
                                    VerticalTextAlignment="Start" />
                            </Grid>
                        </Border>
                    </StackLayout>
                </ScrollView>
                <ScrollView
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.AddressDetails}}"
                    Orientation="Vertical"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical"
                        Spacing="0"
                        VerticalOptions="StartAndExpand">
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            BackgroundColor="AliceBlue"
                            HorizontalOptions="StartAndExpand"
                            HorizontalTextAlignment="Start"
                            Style="{StaticResource ValueLabelBlackBold}"
                            Text="{x:Static ResourceManager:AppResources.ESTPhycicalAddress}"
                            VerticalOptions="StartAndExpand" />
                        <Grid
                            ColumnSpacing="20"
                            HorizontalOptions="FillAndExpand"
                            RowSpacing="0"
                            VerticalOptions="CenterAndExpand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,10,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ESTHouseNumber}"
                                VerticalOptions="Center" />
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="Center">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}" />
                                        <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <inputLayout:SfTextInputLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0"
                                InputViewPadding="10,0,10,0"
                                IsEnabled="{Binding AddressDetails.HouseNo}"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <Entry
                                    Margin="10"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsSpellCheckEnabled="false"
                                    MaxLength="10"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Text="{Binding HouseNumber}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </inputLayout:SfTextInputLayout>
                            <inputLayout:SfTextInputLayout
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0"
                                InputViewPadding="10,0,10,0"
                                IsEnabled="{Binding AddressDetails.BuildinNo}"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <Entry
                                    Margin="10"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsSpellCheckEnabled="false"
                                    MaxLength="20"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Text="{Binding BuildingNumber}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </inputLayout:SfTextInputLayout>
                        </Grid>
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTFloorNumber}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.Floor}"
                            Style="{StaticResource InputTableTextInputLayoutStyle}">
                            <Entry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                IsSpellCheckEnabled="false"
                                MaxLength="10"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Text="{Binding FloorNumber}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.Street}"
                            Style="{StaticResource InputTableTextInputLayoutStyle}">
                            <Entry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                IsSpellCheckEnabled="false"
                                MaxLength="60"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Text="{Binding Street}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTQuarter}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.Quarter}"
                            Style="{StaticResource InputTableTextInputLayoutStyle}">
                            <Entry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                IsSpellCheckEnabled="false"
                                MaxLength="40"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Text="{Binding Quarter}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ZZZZPostalCode}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.PostelCode}"
                            Style="{StaticResource InputTableTextInputLayoutStyle}">
                            <custom:GAZTBorderlessEntry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                IsSpellCheckEnabled="false"
                                Keyboard="Numeric"
                                MaxLength="6"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Text="{Binding PostalCode}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:NumericValidationBehavior />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ESTAddNumber}"
                            VerticalOptions="Center" />
                        <inputLayout:SfTextInputLayout
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.AddNo}"
                            Style="{StaticResource InputTableTextInputLayoutStyle}">
                            <custom:GAZTBorderlessEntry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                IsSpellCheckEnabled="false"
                                MaxLength="10"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Text="{Binding AddNumber}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.CountryText}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            Command="{Binding OnCountrySelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            IsEnabled="{Binding AddressDetails.Country}"
                            ShowIcon="True"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeThickness="1"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding Country}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTProvinance}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            Command="{Binding OnProvinanceSelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            IsEnabled="{Binding AddressDetails.Province}"
                            ShowIcon="True"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeThickness="1"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding Provinance}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTOutletCity}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            Command="{Binding OnCitySelectButtonClick}"
