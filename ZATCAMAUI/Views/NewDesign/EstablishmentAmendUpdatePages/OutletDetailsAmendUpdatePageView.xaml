<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentAmendUpdatePages.OutletDetailsAmendUpdatePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:SfEffectsView="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EstablishmentRegistrationOutletTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Border
                Margin="0"
                Padding="0"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                StrokeShape="RoundRectangle 15,15,0,0"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ContentPresenter
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </StackLayout>
            </Border>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

            <!--#region Header-->
            <StackLayout
                Grid.Row="0"
                Padding="20,15"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                Spacing="0"
                VerticalOptions="StartAndExpand">
                <!--#region BackButtons-->
                <Grid
                    Padding="0,0,0,10"
                    ColumnSpacing="0"
                    RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*" />
                        <ColumnDefinition Width="70*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>


                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Start"
                        Source="arrowLeft.png"
                        VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>


                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        HeightRequest="27"
                        Source="ic_logo_gazt.png"
                        WidthRequest="27" />
                </Grid>
                <!--#endregion-->
                <commonView:PageIndicatorView
                    Completed="{Binding MarkComplete}"
                    DotSize="12"
                    HorizontalOptions="End"
                    MarkSize="24"
                    MaxNum="{Binding MaxIndex}"
                    MinNum="{Binding CurrentIndex}" />
                <Label
                    Padding="0,5,0,10"
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="28"
                    HorizontalOptions="Start"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{Binding SelectedOutletTabText}"
                    VerticalOptions="Center" />
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource forLightLabel}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                <BoxView
                    Margin="0,15"
                    BackgroundColor="WhiteSmoke"
                    HeightRequest="1" />
                <ScrollView
                    x:Name="OutletTabScrollView"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <SfEffectsView:SfChipGroup
                        x:Name="OutletTabSfChipGroup"
                        Margin="0,10,0,0"
                        ChipBackground="Transparent"
                        ChipStroke="{StaticResource NeutralLightGrey}"
                        ChipStrokeThickness="1"
                        ChipType="Choice"
                        HorizontalOptions="Start"
                        ItemsSource="{x:Binding OutletTabSfChipTabList}"
                        SelectedChipBackground="{StaticResource PartialBg}"
                        SelectedItem="{Binding SelectedOutletTabText}"
                        SelectionChanged="SfChipGroup_SelectionChanged"
                        SelectionChanging="OutletTabSfChipGroup_SelectionChanging"
                        VerticalOptions="Center">
                        <SfEffectsView:SfChipGroup.ItemTemplate>
                            <DataTemplate>
                                <StackLayout
                                    Margin="0"
                                    Padding="5,2,5,2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Label
                                        HorizontalOptions="CenterAndExpand"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{Binding}" />
                                </StackLayout>
                            </DataTemplate>
                        </SfEffectsView:SfChipGroup.ItemTemplate>
                    </SfEffectsView:SfChipGroup>
                </ScrollView>
            </StackLayout>
            <!--#endregion-->


            <!--#region Body-->
            <Grid
                Grid.Row="1"
                Padding="20,10,20,0"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">
                <!--#region OutletDetails section-->
                <ScrollView
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}"
                        Spacing="0"
                        VerticalOptions="FillAndExpand">
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="15"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}"
                            TextColor="{StaticResource NeutralGreay}"
                            VerticalOptions="Center" />
                        <Label
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="15"
                            HorizontalOptions="StartAndExpand"
                            Text="{Binding OutletActNumber}"
                            TextColor="{StaticResource NeutralBlack}"
                            VerticalOptions="Center" />
                        <Label
                            Margin="0,10,0,0"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="11"
                            HorizontalOptions="StartAndExpand"
                            TextColor="{StaticResource NeutralGreay}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.OutletTypeField}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            Clicked="OutletType_Clicked"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            IsEnabled="{Binding OutletDetails.OutletType}"
                            ShowIcon="True"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeThickness="1"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding SelectedOutletType, TargetNullValue=''}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <Label
                            Margin="0,10,0,0"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="11"
                            HorizontalOptions="StartAndExpand"
                            TextColor="{StaticResource NeutralGreay}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTOutletCommercialName}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView
                            Margin="0,6,0,6"
                            ContainerType="Outlined"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                            IsEnabled="{Binding OutletDetails.OutletName}"
                            IsHintAlwaysFloated="True"
                            LeadingViewPosition="Inside"
                            Stroke="{StaticResource Primary}"
                            Style="{StaticResource TextInputLayout}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />

                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsSpellCheckEnabled="false"
                                    Placeholder="{x:Static ResourceManager:AppResources.ESTName}"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OutletName}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>
                        </custom:CustomSfTextInputView>
                    </StackLayout>
                </ScrollView>
                <!--#endregion-->
                <!--#region Activity Details-->
                <ScrollView
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.ActivityDetails}}"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        Spacing="0"
                        VerticalOptions="FillAndExpand">
                        <SfEffectsView:SfEffectsView TouchDownCommand="{Binding OnActivityItemButtonClick}" TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}">
                            <Border
                                Padding="15"
                                Stroke="{StaticResource NeutralGreay}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <Grid
                                    ColumnSpacing="0"
                                    HorizontalOptions="Fill"
                                    RowSpacing="0"
                                    VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        Source="deregistration.png"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistration}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        Source="arrowRight.png"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </SfEffectsView:SfEffectsView>
                        <SfEffectsView:SfEffectsView
                            Margin="0,20"
                            TouchDownCommand="{Binding OnActivityItemButtonClick}"
                            TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.LicenseDetails}">
                            <Border
                                Padding="15"
                                Stroke="{StaticResource NeutralGreay}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <Grid
                                    ColumnSpacing="0"
                                    HorizontalOptions="Fill"
                                    RowSpacing="0"
                                    VerticalOptions="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        Source="deregistration.png"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="{x:Static ResourceManager:AppResources.ESTLicenseDetails}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Image
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        Source="arrowRight.png"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </SfEffectsView:SfEffectsView>
                        <Border
                            Padding="15"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            StrokeThickness="1">
                            <Grid
                                ColumnSpacing="0"
                                HorizontalOptions="Fill"
                                RowSpacing="0"
                                VerticalOptions="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="ic_vat_info.png"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.Information}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfo}"
                                    VerticalOptions="CenterAndExpand"
                                    VerticalTextAlignment="Start" />
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,20,0,10"
                            Padding="15"
                            Stroke="{StaticResource NeutralGreay}"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            StrokeThickness="1">
                            <Grid
                                ColumnSpacing="0"
                                HorizontalOptions="Fill"
                                RowSpacing="0"
                                VerticalOptions="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="Center"
                                    Source="ic_vat_info.png"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.Information}"
                                    VerticalOptions="CenterAndExpand" />
                                <Label
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfoTwo}"
                                    VerticalOptions="CenterAndExpand"
                                    VerticalTextAlignment="Start" />
                            </Grid>
                        </Border>
                    </StackLayout>
                </ScrollView>
                <!--#endregion-->
                <!--#region Address details section-->
                <ScrollView
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.AddressDetails}}"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        Spacing="0"
                        VerticalOptions="StartAndExpand">
                        <Label
                            Margin="0,10,0,0"
                            BackgroundColor="AliceBlue"
                            HorizontalOptions="StartAndExpand"
                            HorizontalTextAlignment="Start"
                            Style="{StaticResource ValueLabelBlackBold}"
                            VerticalOptions="StartAndExpand" />
                        <Grid
                            ColumnSpacing="20"
                            HorizontalOptions="FillAndExpand"
                            RowSpacing="0"
                            VerticalOptions="CenterAndExpand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,10,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ESTHouseNumber}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <custom:CustomSfTextInputView
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0"
                                InputViewPadding="10,0,10,0"
                                IsEnabled="{Binding AddressDetails.HouseNo}"
                                IsHintAlwaysFloated="True"
                                Style="{StaticResource TextInputLayout}">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsSpellCheckEnabled="false"
                                        MaxLength="10"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        Text="{Binding HouseNumber}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </custom:CustomSfTextInputView.TextInputView>
                            </custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0"
                                IsEnabled="{Binding AddressDetails.BuildinNo}"
                                IsHintAlwaysFloated="True"
                                Style="{StaticResource TextInputLayout}">
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsSpellCheckEnabled="false"
                                        MaxLength="20"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        Text="{Binding BuildingNumber}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </custom:CustomSfTextInputView.TextInputView>
                            </custom:CustomSfTextInputView>
                        </Grid>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTFloorNumber}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.Floor}"
                            IsHintAlwaysFloated="True"
                            Style="{StaticResource TextInputLayout}">
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsSpellCheckEnabled="false"
                                    MaxLength="10"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Text="{Binding FloorNumber}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>
                        </custom:CustomSfTextInputView>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.Street}"
                            IsHintAlwaysFloated="True"
                            Style="{StaticResource TextInputLayout}">
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsSpellCheckEnabled="false"
                                    MaxLength="60"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Text="{Binding Street}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>
                        </custom:CustomSfTextInputView>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTQuarter}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.Quarter}"
                            IsHintAlwaysFloated="True"
                            Style="{StaticResource TextInputLayout}">
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsSpellCheckEnabled="false"
                                    MaxLength="40"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Text="{Binding Quarter}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>
                        </custom:CustomSfTextInputView>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZPostalCode}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.PostelCode}"
                            IsHintAlwaysFloated="True"
                            Style="{StaticResource TextInputLayout}">
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    IsSpellCheckEnabled="false"
                                    Keyboard="{OnPlatform Android=Numeric,
                                                          iOS=Default}"
                                    MaxLength="6"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Text="{Binding PostalCode}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center">
                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <behaviors:NumericValidationBehavior />
                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
                            </custom:CustomSfTextInputView.TextInputView>
                        </custom:CustomSfTextInputView>
                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ESTAddNumber}"
                            VerticalOptions="Center" />
                        <custom:CustomSfTextInputView
                            Margin="0"
                            InputViewPadding="10,0,10,0"
                            IsEnabled="{Binding AddressDetails.AddNo}"
                            IsHintAlwaysFloated="True"
                            Style="{StaticResource TextInputLayout}">
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="FillAndExpand"
