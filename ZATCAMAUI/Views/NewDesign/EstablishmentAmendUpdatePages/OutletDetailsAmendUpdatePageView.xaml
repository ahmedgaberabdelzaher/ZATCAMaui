                    Padding="0,-5,0,-10"
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="28"
                    HorizontalOptions="Start"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{Binding SelectedOutletTabText}"
                    VerticalOptions="Center" />
                <custom:CustomLabel
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource forLightLabel}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
