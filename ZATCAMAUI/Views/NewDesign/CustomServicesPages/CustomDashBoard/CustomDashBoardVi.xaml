<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.CustomDashBoard.CustomDashBoardVi"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    HasBackButton="False">
    <newdesign:BaseContentPage.PancakeView>
        <Grid>
            <Label FontSize="Body" HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Welcome :" />
                        <Span Text="{Binding Email}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>
