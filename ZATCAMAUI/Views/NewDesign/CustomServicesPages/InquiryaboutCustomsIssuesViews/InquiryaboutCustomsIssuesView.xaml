<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.InquiryaboutCustomsIssuesViews.InquiryaboutCustomsIssuesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="auto,*">
        <Grid
            Grid.Row="0"
            Padding="20,5,20,5"
            ColumnDefinitions="10*,80*,10*">
            <StackLayout Grid.Column="0">
                <Image
                    x:Name="backbutton"
                    HorizontalOptions="Start"
                    Rotation="180"
                    Source="arrowLeftwhite.png"
                    Style="{DynamicResource BackButtonArrow}"
                    VerticalOptions="CenterAndExpand">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding AppDirection}"
                            TargetType="Image"
                            Value="LeftToRight">
                            <Setter Property="Rotation" Value="0" />

                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="BackTapped" />
                </StackLayout.GestureRecognizers>
            </StackLayout>
            <Label
                Grid.Column="1"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineHeight=".9"
                Style="{StaticResource SectionTitleWhiteBold}"
                Text="{x:Static ResourceManager:AppResources.InquiryaboutCustomsIssuesView}"
                VerticalOptions="Center" />
        </Grid>

        <Border
            Grid.Row="1"
            Padding="20,20,20,0"
            Style="{StaticResource CommonTopCurves}">
            <WebView
                x:Name="webc"
                Margin="-20,0,-20,0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand" />
        </Border>
        <custom:Loader
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsLoading}" />
    </Grid>
</ContentPage>


