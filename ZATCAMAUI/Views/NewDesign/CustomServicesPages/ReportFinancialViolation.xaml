<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.ReportFinancialViolation"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    x:Name="TraiffPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding LoadIntialLookupsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="titleLabel" TargetType="Label">
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                    <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                </Style>
                <Style TargetType="Label">
                    <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <StackLayout IsVisible="{Binding IsMainView}">
            <StackLayout Padding="15,5,15,5" Orientation="Horizontal">


                <Image
                    x:Name="Image_BacKIcon"
                    Grid.Row="0"
                    Grid.Column="0"
                    HeightRequest="25"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Rotation="180"
                    Source="GrayBackButton"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsArabicLang}"
                            TargetType="Image"
                            Value="False">
                            <Setter Property="Rotation" Value="0" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    MaxLines="1"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}" />

            </StackLayout>
            <yummy:PancakeView
                Padding="0"
                CornerRadius="14,14,0,0"
                VerticalOptions="FillAndExpand">
                <Grid
                    Margin="0"
                    Padding="0,0,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">


                    <ScrollView VerticalScrollBarVisibility="Never">
                        <StackLayout Margin="24,34,21,5">
                            <Label
                                Margin="0,34,0,5"
                                Style="{x:StaticResource titleLabel}"
                                Text="{x:Static ResourceManager:AppResources.Submitanewreport}" />
                            <Label
                                FontSize="16"
                                Text="{x:Static ResourceManager:AppResources.SelectTheOptionAndCompleteDetails}"
                                TextColor="#999999" />
                            <BoxView HeightRequest="1" Color="#EBEBEB" />
                            <Frame
                                BorderColor="#EBEBEB"
                                CornerRadius="14"
                                HasShadow="False">
                                <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,*">
                                    <Label
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        FontSize="12"
                                        TextColor="#999999"
                                        VerticalOptions="StartAndExpand"
                                        VerticalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontSize="25"
                                                    Text="• "
                                                    TextColor="Black" />
                                                <Span Text="{x:Static ResourceManager:AppResources.BalaghHintFthLne}" />
                                                <Span Text="{x:Static system:Environment.NewLine}" />
                                                <Span
                                                    FontSize="24"
                                                    Text="•"
                                                    TextColor="Black" />
                                                <Span Text="{x:Static ResourceManager:AppResources.BalaghHintSecLne}" />
                                                <Span Text="{x:Static system:Environment.NewLine}" />
                                                <Span
                                                    FontSize="24"
                                                    Text="•"
                                                    TextColor="Black" />
                                                <Span Text="{x:Static ResourceManager:AppResources.BalaghHintThrdLne}" />
                                                <Span Text="{x:Static system:Environment.NewLine}" />
                                                <Span
                                                    FontSize="24"
                                                    Text="•"
                                                    TextColor="Black" />
                                                <Span Text="{x:Static ResourceManager:AppResources.BalaghHintFrthLne}" />

                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HeightRequest="22"
                                        Source="InfoIcon"
                                        WidthRequest="22" />
                                </Grid>
                            </Frame>
                            <StackLayout Margin="0,10,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NameForImprter}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        Placeholder="{x:Static ResourceManager:AppResources.NameForImprter}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding Name}"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <StackLayout Margin="0,9,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.PhoneNumber}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    ErrorText="{x:Static ResourceManager:AppResources.PhoneNotCorrect}"
                                    HasError="{Binding PhoneHasError}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="Red" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        Placeholder="0xxxxxxxxx"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding Phone}"
                                        VerticalTextAlignment="Center">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <StackLayout Margin="0,9,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Email}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    ErrorText="{x:Static ResourceManager:AppResources.Mailnotcorrect}"
                                    HasError="{Binding MailHasError}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="Red" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Email"
                                        Placeholder="{x:Static ResourceManager:AppResources.Email}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding Mail}"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <StackLayout Margin="0,9,0,0">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ReportType}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>

                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        OutlineCornerRadius="14"
                                        Style="{StaticResource InputTableTextInputLayoutStyleWuthoutHeighandWidth}">
                                        <Grid>
                                            <StackLayout Orientation="Horizontal">

                                                <custom:GAZTBorderlessEntry
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ReportType}"
                                                    Style="{StaticResource DefaultEntryWithoutHeigh}"
                                                    Text="{Binding SelectedBalaghType.Name}"
                                                    TextColor="{StaticResource NeutralBlack}"
                                                    VerticalTextAlignment="Center" />
                                                <Image HorizontalOptions="EndAndExpand" Source="arrowDropdown.png" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectBalaghTypeCommand}" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                    </inputLayout:SfTextInputLayout>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectBalaghTypeCommand}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,5,0,9"
                                    ContainerType="Outlined"
                                    ErrorText="{x:Static ResourceManager:AppResources.FieldRequired}"
                                    HasError="{Binding BalaghOtherTypeTxtHasError}"
                                    InputViewPadding="16,0,16,0"
                                    IsVisible="{Binding IsBalaghTypeOOther}"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="Red" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <custom:GAZTBorderlessEntry
                                        Placeholder="{x:Static ResourceManager:AppResources.IndicateTheTypeOfReport}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding BalaghTypeOtherTxt}"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout>

                            </StackLayout>

                            <StackLayout Margin="0,9,0,0">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ReportLocation}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>

                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        OutlineCornerRadius="14"
                                        Style="{StaticResource InputTableTextInputLayoutStyleWuthoutHeighandWidth}">
                                        <Grid>
                                            <StackLayout Orientation="Horizontal">

                                                <custom:GAZTBorderlessEntry
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ReportLocation}"
                                                    Style="{StaticResource DefaultEntryWithoutHeigh}"
                                                    Text="{Binding SelectedPort.Name}"
                                                    TextColor="{StaticResource NeutralBlack}"
                                                    VerticalTextAlignment="Center" />
                                                <Image HorizontalOptions="EndAndExpand" Source="arrowDropdown.png" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenPortsCommand}" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                    </inputLayout:SfTextInputLayout>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenPortsCommand}" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </StackLayout>

                            <StackLayout
                                Margin="0,9,0,0"
                                HeightRequest="200"
                                Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ReportText}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <!--  HasError="{Binding BalaghTxtHasError}"  -->
                                <inputLayout:SfTextInputLayout
                                    ContainerType="Outlined"
                                    ErrorText="{x:Static ResourceManager:AppResources.FieldRequired}"
                                    HeightRequest="137"
                                    OutlineCornerRadius="14"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <Editor
                                        HeightRequest="137"
                                        HorizontalOptions="FillAndExpand"
                                        Text="{Binding Balaghtx}"
                                        VerticalOptions="FillAndExpand" />



                                </inputLayout:SfTextInputLayout>

                            </StackLayout>
                            <StackLayout Margin="0,10,0,10" Padding="0,10,0,10">
                                <Label Text="{x:Static ResourceManager:AppResources.Attachment}" TextColor="#999999" />
                                <BoxView HeightRequest=".8" Color="#999999" />
                                <StackLayout x:Name="filesLst" BindableLayout.ItemsSource="{Binding TicketFiles}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                x:Name="Item"
                                                Margin="0"
                                                Padding="0"
                                                ColumnDefinitions="auto,*,auto"
                                                RowDefinitions="*,auto"
                                                RowSpacing="0">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="0"
                                                    HeightRequest="24"
                                                    Source="PDF"
                                                    VerticalOptions="Start"
                                                    WidthRequest="17" />
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    FontSize="16"
                                                    Text="{Binding filename}"
                                                    TextColor="#232323"
                                                    VerticalOptions="CenterAndExpand" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    FontSize="8"
                                                    TextColor="#999999">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding FileSize}" />
                                                            <Span Text=" " />
                                                            <Span Text="{x:Static ResourceManager:AppResources.MB}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Grid
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="2"
                                                    Margin="0"
                                                    Padding="0"
                                                    HeightRequest="24"
                                                    RowSpacing="0"
                                                    WidthRequest="24">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"
                                                            Command="{Binding DeleteAttatchementCommand}"
                                                            CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                    </Grid.GestureRecognizers>
                                                    <Image
                                                        HeightRequest="24"
                                                        Source="Ellipse"
                                                        WidthRequest="24" />
                                                    <Image
                                                        Margin="8"
                                                        HeightRequest="9"
                                                        Source="cancel"
                                                        WidthRequest="9" />
                                                </Grid>
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="2"
                                                    HeightRequest="24"
                                                    IsVisible="false"
                                                    Source="AddNew"
                                                    WidthRequest="24">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"
                                                            Command="{Binding DeleteAttatchementCommand}"
                                                            CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>
                                <Frame
                                    Margin="0,30,0,34"
                                    Padding="12"
                                    BackgroundColor="White"
                                    BorderColor="#0996D4"
                                    CornerRadius="14"
                                    HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding UploadFileCommand}" />
                                    </Frame.GestureRecognizers>
                                    <StackLayout Orientation="Horizontal">
                                        <Image
                                            Margin="0,0,7,0"
                                            HeightRequest="34"
                                            Source="AddNew"
                                            WidthRequest="34" />
                                        <Label
                                            HorizontalOptions="CenterAndExpand"
                                            Text="{x:Static ResourceManager:AppResources.Addattachments}"
                                            TextColor="{StaticResource PrimaryColor}"
                                            VerticalOptions="CenterAndExpand" />

                                    </StackLayout>
                                </Frame>

                                <StackLayout Orientation="Horizontal">
                                    <Image
                                        HeightRequest="25"
                                        Source="UncheckedCheckBox"
                                        WidthRequest="25">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PolicyCheckedCommand}" />
                                        </Image.GestureRecognizers>
                                        <Image.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPolicyChecked}"
                                                TargetType="Image"
                                                Value="true">
                                                <Setter Property="Source" Value="CheckedCheckbox" />
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    <Label
                                        FontSize="12"
                                        Text="{x:Static ResourceManager:AppResources.BalaghPolicytxt}"
                                        TextColor="{StaticResource PrimaryColor}"
                                        TextDecorations="Underline"
                                        VerticalOptions="CenterAndExpand">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewPrivacyandPolicyCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </StackLayout>

                                <Frame
                                    Margin="0,34,0,15"
                                    Padding="12"
                                    BackgroundColor="#0996D4"
                                    CornerRadius="14"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SendTicketCommand}" />
                                    </Frame.GestureRecognizers>
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.Send}"
                                        TextColor="White"
                                        VerticalOptions="CenterAndExpand" />
                                </Frame>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.CancelText}"
                                    TextColor="#0996D4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </StackLayout>

                        </StackLayout>
                    </ScrollView>

                </Grid>
            </yummy:PancakeView>

        </StackLayout>
        <StackLayout IsVisible="{Binding IsShowSuccessView}">
            <!--  "{Binding IsShowSuccessView}"  -->
            <Image
                Margin="0,137,0,50"
                HeightRequest="120"
                HorizontalOptions="CenterAndExpand"
                Source="Success"
                WidthRequest="120" />
            <Label
                Margin="10,0,10,0"
                FontFamily="{StaticResource SomarSemiBold}"
                FontSize="28"
                HorizontalOptions="CenterAndExpand"
                Text="{x:Static ResourceManager:AppResources.Reportsubmittedsuccessfully}"
                TextColor="White" />
            <Label
                FontSize="16"
                HorizontalOptions="CenterAndExpand"
                Text="{x:Static ResourceManager:AppResources.ReportSentSuccess}"
                TextColor="White" />

            <yummy:PancakeView
                Padding="24,38,24,38"
                BackgroundColor="White"
                CornerRadius="14,14,0,0"
                VerticalOptions="EndAndExpand">

                <StackLayout>
                    <Grid>

                        <Frame
                            BackgroundColor="#0996D4"
                            BorderColor="#0996D4"
                            CornerRadius="14"
                            HasShadow="False"
                            Opacity=".1" />
                        <Frame
                            BackgroundColor="Transparent"
                            BorderColor="#0996D4"
                            CornerRadius="14"
                            HasShadow="False">
                            <Grid
                                ColumnDefinitions="auto,*"
                                ColumnSpacing="5"
                                RowDefinitions="*,*"
                                RowSpacing="10">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{x:Static ResourceManager:AppResources.ReportSendingDate}"
                                    TextColor="#002447" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{x:Static ResourceManager:AppResources.Thereportnumber}"
                                    TextColor="#002447" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    Text="{Binding DateTime, StringFormat='{0:dd-MM-yyyy}'}"
                                    TextColor="#002447" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    Text="{Binding BalaghNoTxt}"
                                    TextColor="#002447" />

                            </Grid>
                        </Frame>
                    </Grid>
                    <Frame
                        Margin="0,37,0,0"
                        Padding="12"
                        BackgroundColor="#0996D4"
                        CornerRadius="14"
                        HasShadow="False"
                        HorizontalOptions="FillAndExpand">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Frame.GestureRecognizers>
                        <Label
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.Backtomainmenu}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand" />
                    </Frame>
                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
        <custom:PickerWithSearch IsVisible="{Binding IsPortsPickerSearch}" />
        <custom:MsgView
            Grid.Row="0"
            Margin="0,0,0,0"
            IsVisible="{Binding IsShowMsgView}"
            VerticalOptions="FillAndExpand" />

        <custom:Loader IsVisible="{Binding IsLoading}" />

    </Grid>
</ContentPage>
