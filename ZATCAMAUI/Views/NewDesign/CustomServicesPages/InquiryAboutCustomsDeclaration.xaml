<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.InquiryAboutCustomsDeclaration"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                    <Style TargetType="Label">
                        <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid
                        x:Name="Main"
                        Padding="15,5,15,5"
                        IsVisible="{TemplateBinding BindingContext.IsMainPage}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.Inquiryaboutacustomsdeclaration}" />

                        <Image
                            x:Name="Image_BacKIcon"
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="25"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Rotation="180"
                            Source="GrayBackButton"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="25">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.BackCommand}" />
                            </Image.GestureRecognizers>
                            <Image.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding BindingContext.IsArabicLang}"
                                    TargetType="Image"
                                    Value="False">
                                    <Setter Property="Rotation" Value="0" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>
                    <Grid
                        x:Name="Details"
                        Padding="15,5,15,5"
                        IsVisible="{TemplateBinding BindingContext.IsDetailsVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.Details}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="25"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Rotation="180"
                            Source="GrayBackButton"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="25">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.BackFromDetailsCommand}" />
                            </Image.GestureRecognizers>
                            <Image.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding BindingContext.IsArabicLang}"
                                    TargetType="Image"
                                    Value="False">
                                    <Setter Property="Rotation" Value="0" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>
                    <Grid
                        x:Name="StatmentDetails"
                        Padding="15,5,15,5"
                        IsVisible="{TemplateBinding BindingContext.IsStatmentDetailsVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.Customsitemdescription}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="30"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Rotation="180"
                            Source="GrayBackButton"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="30">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.BackToDetailsCommand}" />
                            </Image.GestureRecognizers>
                            <Image.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding BindingContext.IsArabicLang}"
                                    TargetType="Image"
                                    Value="False">
                                    <Setter Property="Rotation" Value="0" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>

                    <yummy:PancakeView
                        Padding="0"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">


                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding LoadIntialLookupsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
    <ContentPage.Content>
        <Grid>

            <Grid>
                <Grid.Resources>
                    <ResourceDictionary>
                        <Style x:Key="titleLabel" TargetType="Label">
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                        </Style>
                        <Style TargetType="Label">
                            <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                        </Style>
                    </ResourceDictionary>
                </Grid.Resources>
                <ScrollView
                    Grid.Row="0"
                    Margin="0"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        x:Name="Main"
                        Margin="24,10,24,0"
                        IsVisible="{Binding IsMainPage}">
                        <Label
                            Margin="0,34,0,5"
                            Style="{x:StaticResource titleLabel}"
                            Text="{x:Static ResourceManager:AppResources.Inquiryaboutacustomsdeclaration}" />
                        <Label
                            FontSize="16"
                            Text="{x:Static ResourceManager:AppResources.SelectTheOptionAndCompleteDetails}"
                            TextColor="#999999" />
                        <BoxView HeightRequest="1" Color="#EBEBEB" />
                        <StackLayout>

                            <custom:CustomLabel Margin="0,30,0,0" Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Inquirethrough}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <Grid ColumnDefinitions="*,15,*">
                                <Grid Grid.Column="0">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding FilterByDeclarationInfoCommand}" />

                                    </Grid.GestureRecognizers>
                                    <Image
                                        HeightRequest="136"
                                        Source="Unselected.png"
                                        WidthRequest="171">
                                        <Image.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFilterByDeclarationInformation}"
                                                TargetType="Image"
                                                Value="false">
                                                <Setter Property="Source" Value="UnselectedCard" />
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    <Label
                                        Margin="25,10,25,15"
                                        FontSize="16"
                                        Text="{x:Static ResourceManager:AppResources.InQuerywithstatementinformation}"
                                        TextColor="#FFFFFF"
                                        VerticalOptions="EndAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFilterByDeclarationInformation}"
                                                TargetType="Label"
                                                Value="false">
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding FilterByBusInfoCommand}" />

                                    </Grid.GestureRecognizers>
                                    <Image Source="UnselectedCard.png">
                                        <Image.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFilterByDeclarationInformation}"
                                                TargetType="Image"
                                                Value="false">
                                                <Setter Property="Source" Value="Unselected" />
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    <Label
                                        Margin="25,10,25,15"
                                        FontSize="16"
                                        Text="{x:Static ResourceManager:AppResources.Inquiryforpolicyinformation}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="EndAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFilterByDeclarationInformation}"
                                                TargetType="Label"
                                                Value="false">
                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Grid>

                        </StackLayout>
                        <Frame
                            Padding="5"
                            BackgroundColor="#0996D4"
                            BorderColor="#0996D4"
                            HasShadow="False"
                            IsVisible="{Binding IsFilterByBusInformation}"
                            Opacity=".5">
                            <Label
                                FontSize="14"
                                Text="{x:Static ResourceManager:AppResources.BillInfoInquiryHint}"
                                TextColor="White" />
                        </Frame>
                        <StackLayout Margin="0,19,0,0">

                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Port}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <Grid>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        IsReadOnly="True"
                                        Placeholder="{x:Static ResourceManager:AppResources.Port}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SelectedPort.Name}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalTextAlignment="Center" />
                                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenInquiryFilterCommand}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image Source="arrowDropdown.png" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <!--  IsOpen="{Binding IsPickerOpened}"  -->


                            </Grid>



                            <Grid IsVisible="false">

                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">

                                    <StackLayout Orientation="Horizontal">

                                        <custom:GAZTBorderlessEntry
                                            IsReadOnly="True"
                                            Placeholder="{x:Static ResourceManager:AppResources.Port}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding SelectedPort.Name}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalTextAlignment="Center" />
                                        <Image HorizontalOptions="End" Source="arrowDropdown.png" />
                                    </StackLayout>


                                </inputLayout:SfTextInputLayout>




                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenInquiryFilterCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>

                        </StackLayout>


                        <StackLayout x:Name="InquireByInformation" IsVisible="{Binding IsFilterByDeclarationInformation}">
                            <StackLayout Margin="0,19,0,0">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Declarationtype}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenDeclarationTypesLstCommand}" />
                                    </Grid.GestureRecognizers>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        OutlineCornerRadius="14"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <Grid>
                                            <StackLayout Orientation="Horizontal">
                                                <custom:GAZTBorderlessEntry
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.Declarationtype}"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding SelectedDeclarationType.Value}"
                                                    TextColor="{StaticResource NeutralBlack}"
                                                    VerticalTextAlignment="Center" />
                                                <Image HorizontalOptions="EndAndExpand" Source="arrowDropdown.png" />

                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenDeclarationTypesLstCommand}" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                        <!--
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png"/>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                        -->
                                    </inputLayout:SfTextInputLayout>




                                </Grid>

                            </StackLayout>

                            <StackLayout Margin="0,19,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.DeclarationNumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        Placeholder="{x:Static ResourceManager:AppResources.DeclarationNumber}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding DeclarationNumber}"
                                        VerticalTextAlignment="Center">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <custom:CustomLabel Margin="0,5,0,0" Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.DeclarationDate}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <Grid>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        IsReadOnly="True"
                                        Placeholder="yyyy/MM/dd"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding HijriDateToBeDisplayed}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalTextAlignment="Center" />
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image HorizontalOptions="EndAndExpand" Source="calendar.png" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenHijriPickerCommand}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>

                                </inputLayout:SfTextInputLayout>

                                <!--  HijriDatePicker  -->
                                <custom:CustomHijriDatePicker
                                    x:Name="SignUpDOBHijri"
                                    Margin="2"
                                    Background="White"
                                    FlowDirection="RightToLeft"
                                    HorizontalOptions="FillAndExpand"
                                    IsOpen="{Binding IsOpenHijriPicker}"
                                    ItemHeight="45"
                                    Mode="Dialog"
                                    SelectedItem="{Binding TodayDateinHijri}">

                                    <custom:CustomHijriDatePicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle FontFamily="{StaticResource SomarSemiBold}" TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomHijriDatePicker.SelectedTextStyle>

                                    <custom:CustomHijriDatePicker.TextStyle>
                                        <syncfusion:PickerTextStyle FontFamily="{StaticResource SomarSemiBold}" />
                                    </custom:CustomHijriDatePicker.TextStyle>

                                    <custom:CustomHijriDatePicker.ColumnHeaderView>
                                        <syncfusion:PickerColumnHeaderView Height="50">
                                            <syncfusion:PickerColumnHeaderView.TextStyle FontFamily="{StaticResource SomarSemiBold}" />
                                        </syncfusion:PickerColumnHeaderView>
                                    </custom:CustomHijriDatePicker.ColumnHeaderView>

                                    <custom:CustomHijriDatePicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="46"
                                            Background="White"
                                            Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">
                                            <syncfusion:PickerHeaderView.TextStyle>
                                                <syncfusion:PickerTextStyle FontFamily="{StaticResource SomarSemiBold}" />
                                            </syncfusion:PickerHeaderView.TextStyle>
                                        </syncfusion:PickerHeaderView>

                                    </custom:CustomHijriDatePicker.HeaderView>

                                    <custom:CustomHijriDatePicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </custom:CustomHijriDatePicker.FooterView>


                                    <custom:CustomHijriDatePicker.Behaviors>
                                        <xct:EventToCommandBehavior Command="{Binding SelectedDeclarationTypeDateCommand}" EventName="SelectionChanged" />
                                    </custom:CustomHijriDatePicker.Behaviors>
                                </custom:CustomHijriDatePicker>


                                <custom:CustomHijriDatePicker
                                    Margin="10,0,10,0"
                                    Background="White"
                                    FlowDirection="RightToLeft"
                                    HorizontalOptions="FillAndExpand"
                                    IsOpen="False"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectedItem="{Binding TodayDateinHijri}">

                                    <custom:CustomHijriDatePicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="46"
                                            Background="#EAF7CC"
                                            Text="{x:Static ResourceManager:AppResources.DeclarationDate}">
                                            <syncfusion:PickerHeaderView.TextStyle>
                                                <syncfusion:PickerTextStyle FontFamily="{StaticResource SomarSemiBold}" />
                                            </syncfusion:PickerHeaderView.TextStyle>
                                        </syncfusion:PickerHeaderView>

                                    </custom:CustomHijriDatePicker.HeaderView>

                                    <custom:CustomHijriDatePicker.ColumnHeaderView>
                                        <syncfusion:PickerColumnHeaderView Height="46" />
                                    </custom:CustomHijriDatePicker.ColumnHeaderView>

                                    <custom:CustomHijriDatePicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomHijriDatePicker.SelectedTextStyle>


                                    <custom:CustomHijriDatePicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </custom:CustomHijriDatePicker.FooterView>

                                    <custom:CustomHijriDatePicker.Behaviors>
                                        <xct:EventToCommandBehavior Command="{Binding SelectedDeclarationTypeDateCommand}" EventName="SelectionChanged" />
                                    </custom:CustomHijriDatePicker.Behaviors>
                                </custom:CustomHijriDatePicker>
                                <!--  HijriDatePicker  -->
                            </Grid>
                        </StackLayout>
                        <StackLayout x:Name="InquireByBillInfo" IsVisible="{Binding IsFilterByBusInformation}">


                            <StackLayout Margin="0,19,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Billofladingnumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        Placeholder="{x:Static ResourceManager:AppResources.Billofladingnumber}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding BillInfoNumber}"
                                        VerticalTextAlignment="Center">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <StackLayout Margin="0,19,0,0">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Shippingcompany}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCarrierLstCommand}" />
                                    </Grid.GestureRecognizers>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        OutlineCornerRadius="14"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}">
                                        <Grid>
                                            <StackLayout Orientation="Horizontal">
                                                <custom:GAZTBorderlessEntry
                                                    HorizontalOptions="FillAndExpand"
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.Shippingcompany}"
                                                    Style="{StaticResource DefaultEntry}"
