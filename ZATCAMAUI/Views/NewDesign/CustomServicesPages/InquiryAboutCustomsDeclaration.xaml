                                        </custom:GAZTBorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <!--  Fourth OTP Digit End  -->

                                </Grid>

                            </Grid>


                            <StackLayout
                                Margin="0,-15,0,0"
                                HorizontalOptions="Center"
                                Orientation="Horizontal">
                                <Image Source="clock" />
                                <custom:CustomLabel
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{Binding LblCountDownTimer}"
                                    VerticalOptions="Center" />
                            </StackLayout>
                            <buttons:SfButton
                                Margin="0,16,0,0"
                                Background="Transparent"
                                Command="{Binding ResendOtpCommand}"
                                IsVisible="{Binding IsResendCodeEnabled}"
                                Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                TextColor="{Binding ResendOTPTextColor}"
                                VerticalOptions="EndAndExpand" />
                        </StackLayout>



                    </StackLayout>
                </ScrollView>

                <Grid
                    Grid.Row="0"
                    Padding="0,0,0,8"
                    BackgroundColor="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="White">
                        <Image
                            HorizontalOptions="Start"
                            Source="arrowLeft.png"
                            Style="{DynamicResource BackButtonArrow}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackFromOtpCommand}" NumberOfTapsRequired="1" />
                            </Image.GestureRecognizers>
                            <Image.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsArabicLang}"
                                    TargetType="Image"
                                    Value="True">
                                    <Setter Property="Rotation" Value="180" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </StackLayout>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="White">
                        <Image
                            HeightRequest="47"
                            Source="ic_logo_gazt.png"
                            WidthRequest="41" />
                    </StackLayout>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="2"
                        BackgroundColor="White">
                        <Image HorizontalOptions="End" Source="close.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackFromOtpCommand}" NumberOfTapsRequired="1" />
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                </Grid>

                <buttons:SfButton
                    x:Name="btn"
                    Grid.Row="2"
                    Command="{Binding VerifyOTPCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.Verify}" />
            </Grid>
            <custom:MsgView
                Grid.Row="0"
                Margin="0,0,0,0"
                IsVisible="{Binding IsShowMsgView}"
                VerticalOptions="FillAndExpand" />
            <Grid
                Grid.Row="0"
                Margin="0,0,0,0"
                IsVisible="{Binding IsPortsPickerSearch}"
                VerticalOptions="FillAndExpand">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClosePickerViewCommand}" />
                </Grid.GestureRecognizers>
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <yummy:PancakeView
                    Padding="20,20,20,10"
                    BackgroundColor="White"
                    CornerRadius="15,15,0,0"
                    Style="{StaticResource CommonTopCurves}"
                    VerticalOptions="EndAndExpand">

                    <Grid
                        Margin="0,0,0,0"
                        RowDefinitions="auto,*,auto"
                        VerticalOptions="FillAndExpand">
                        <SearchBar
                            x:Name="PortsSearchBar"
                            Grid.Row="0"
                            Margin="0,0,3,0"
                            FontFamily="{StaticResource SomarBold}"
                            Placeholder="{x:Static ResourceManager:AppResources.ZSearch}"
                            Text="{Binding SearchTxt}">
                            <SearchBar.Behaviors>
                                <xct:EventToCommandBehavior
                                    Command="{Binding SearchInPortsCommand}"
                                    CommandParameter="{Binding Text, Source={x:Reference PortsSearchBar}}"
                                    EventName="TextChanged" />
                            </SearchBar.Behaviors>
                        </SearchBar>
                        <Grid Grid.Row="1">
                            <CollectionView
                                x:Name="PortSearchlst"
                                IsVisible="{Binding IsPickerOpened}"
                                ItemsSource="{Binding Ports}"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7" Padding="10,2,10,2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PortSelectionChangedCommand, Source={x:Reference StatatmentLst}}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <CollectionView
                                x:Name="Declerationlst"
                                IsVisible="{Binding IsDeclarationTypeOpened}"
                                ItemsSource="{Binding DeclarationTypes}"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10" Padding="10,2,10,2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PortSelectionChangedCommand, Source={x:Reference Declerationlst}}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <CollectionView
                                x:Name="CarrierSearchlst"
                                IsVisible="{Binding IsCarrierOpened}"
                                ItemsSource="{Binding Carriers}"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7" Padding="10,2,10,2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PortSelectionChangedCommand, Source={x:Reference Declerationlst}}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding carr_name}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>



                        </Grid>
                        <buttons:SfButton
                            Grid.Row="2"
                            Margin="0,0,0,10"
                            Background="White"
                            Command="{Binding CloseInquiryFilterCommand}"
                            FontSize="16"
                            Stroke="{StaticResource PrimaryColor}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZClose}"
                            TextColor="#0996D4"
                            VerticalOptions="CenterAndExpand" />

                    </Grid>
                </yummy:PancakeView>
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>

