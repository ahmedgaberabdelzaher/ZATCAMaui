<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.InquiryAboutCustomsDeclaration"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                    <Style TargetType="Label">
                        <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding LoadIntialLookupsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--  Header 1  -->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,auto,*"
                IsVisible="{Binding IsMainPage}">

                <!--  Back Button  -->
                <StackLayout IsVisible="{Binding IsBackStepButtonVisible}">

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.Inquiryaboutacustomsdeclaration}"
                    VerticalOptions="Center" />

            </Grid>

            <!--  Header 2  -->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,auto,*"
                IsVisible="{Binding IsDetailsVisible}">

                <!--  Back Button  -->
                <StackLayout IsVisible="{Binding IsBackStepButtonVisible}">

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackFromDetailsCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.Details}"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Header 3  -->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,auto,*"
                IsVisible="{Binding IsStatmentDetailsVisible}">

                <!--  Back Button  -->
                <StackLayout IsVisible="{Binding IsBackStepButtonVisible}">

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackToDetailsCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.Customsitemdescription}"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Header 4  -->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,auto,*"
                IsVisible="{Binding IsOTPView}">

                <!--  Back Button  -->
                <StackLayout>

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackFromOtpCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VerificationCode}"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Body  -->
            <Border
                Grid.Row="1"
                Padding="0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView BackgroundColor="White" VerticalScrollBarVisibility="Never">

                    <StackLayout>

                        <StackLayout.Resources>
                            <ResourceDictionary>
                                <Style x:Key="titleLabel" TargetType="Label">
                                    <Setter Property="FontSize" Value="24" />
                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                    <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                                </Style>
                                <Style TargetType="Label">
                                    <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                                </Style>
                            </ResourceDictionary>
                        </StackLayout.Resources>

                        <StackLayout
                            x:Name="Main"
                            Margin="24,10"
                            IsVisible="{Binding IsMainPage}">

                            <Label Style="{x:StaticResource titleLabel}" Text="{x:Static ResourceManager:AppResources.Inquiryaboutacustomsdeclaration}" />

                            <Label
                                FontSize="16"
                                Text="{x:Static ResourceManager:AppResources.SelectTheOptionAndCompleteDetails}"
                                TextColor="#999999" />

                            <BoxView HeightRequest="1" Color="#EBEBEB" />

                            <!--  Cards  -->
                            <StackLayout>

                                <Label Margin="0,30,0,0" Style="{StaticResource CaptionLabelGrey}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Inquirethrough}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Grid ColumnDefinitions="*,15,*">
                                    <Grid Grid.Column="0">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding FilterByDeclarationInfoCommand}" />

                                        </Grid.GestureRecognizers>

                                        <Image
                                            HeightRequest="130"
                                            Source="Unselected.png"
                                            WidthRequest="161">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsFilterByDeclarationInformation}"
                                                    TargetType="Image"
                                                    Value="false">
                                                    <Setter Property="Source" Value="UnselectedCard" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>

                                        <Label
                                            Margin="25,10,25,15"
                                            FontSize="16"
                                            Text="{x:Static ResourceManager:AppResources.InQuerywithstatementinformation}"
                                            TextColor="#FFFFFF"
                                            VerticalOptions="EndAndExpand">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsFilterByDeclarationInformation}"
                                                    TargetType="Label"
                                                    Value="false">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding FilterByBusInfoCommand}" />

                                        </Grid.GestureRecognizers>
                                        <Image Source="UnselectedCard.png"
                                               HeightRequest="130"
                                               WidthRequest="161">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsFilterByDeclarationInformation}"
                                                    TargetType="Image"
                                                    Value="false">
                                                    <Setter Property="Source" Value="Unselected" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <Label
                                            Margin="25,10,25,15"
                                            FontSize="16"
                                            Text="{x:Static ResourceManager:AppResources.Inquiryforpolicyinformation}"
                                            TextColor="{StaticResource Primary}"
                                            VerticalOptions="EndAndExpand">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsFilterByDeclarationInformation}"
                                                    TargetType="Label"
                                                    Value="false">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>

                                </Grid>

                            </StackLayout>

                            <!--  Hint Border  -->
                            <Border
                                Margin="0,10"
                                Padding="5"
                                BackgroundColor="#0996D4"
                                Stroke="#0996D4"
                                IsVisible="{Binding IsFilterByBusInformation}"
                                Opacity=".5">
                                <Label
                                    FontSize="14"
                                    Text="{x:Static ResourceManager:AppResources.BillInfoInquiryHint}"
                                    TextColor="White" />
                            </Border>

                            <StackLayout Margin="0,19,0,0">

                                <Label Style="{StaticResource CaptionLabelGrey}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Port}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            IsReadOnly="True"
                                            InputTransparent="True"
                                            Placeholder="{x:Static ResourceManager:AppResources.Port}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding SelectedPort.Name}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalTextAlignment="Center" />

                                    </custom:CustomSfTextInputView.TextInputView>
                                        <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenInquiryFilterCommand}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image Source="arrowDropdown.png" />
                                    </inputLayout:SfTextInputLayout.TrailingView>

                                </custom:CustomSfTextInputView>

                            </StackLayout>

                            <StackLayout x:Name="InquireByInformation" IsVisible="{Binding IsFilterByDeclarationInformation}">

                                <StackLayout Margin="0,0,0,0">

                                    <Label Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.Declarationtype}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                             <custom:GAZTBorderlessEntry
                                                IsReadOnly="True"
                                                InputTransparent="True"
                                                Placeholder="{x:Static ResourceManager:AppResources.Declarationtype}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding SelectedDeclarationType.Value}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalTextAlignment="Center" />

                                        </custom:CustomSfTextInputView.TextInputView>

                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image Source="arrowDropdown.png" />
                                            </inputLayout:SfTextInputLayout.TrailingView>

                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenDeclarationTypesLstCommand}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    </custom:CustomSfTextInputView>

                                </StackLayout>

                                <StackLayout>

                                    <Label Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.DeclarationNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                              <custom:GAZTBorderlessEntry
                                                Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                                MaxLength="10"
                                                Placeholder="{x:Static ResourceManager:AppResources.DeclarationNumber}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding DeclarationNumber}"
                                                VerticalTextAlignment="Center">

                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>

                                        </custom:CustomSfTextInputView.TextInputView>

                                    </custom:CustomSfTextInputView>

                                </StackLayout>

                                <StackLayout>
                                    <Label Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.DeclarationDate}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                             <custom:GAZTBorderlessEntry
                                                IsReadOnly="True"
                                                InputTransparent="True"
                                                Placeholder="dd/MM/yyyy"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding HijriDateToBeDisplayed}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalTextAlignment="Center" />

                                        </custom:CustomSfTextInputView.TextInputView>

                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image HorizontalOptions="EndAndExpand"
                                                       WidthRequest="20"
                                                       HeightRequest="20"
                                                       Source="calendar.png" />
                                            </inputLayout:SfTextInputLayout.TrailingView>

                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenHijriPickerCommand}" CommandParameter="{x:Reference declarationdate}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    </custom:CustomSfTextInputView>

                                    <!--  HijriDatePicker  -->
                                    <custom:CustomHijriDatePicker
                                        x:Name="declarationdate"
                                        Margin="10,0"
                                        Background="White"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="40"
                                        Mode="Dialog"
                                        SelectedItem="{Binding TodayDateinHijri}">

                                        <custom:CustomHijriDatePicker.SelectionView>
                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                        </custom:CustomHijriDatePicker.SelectionView>

                                        <custom:CustomHijriDatePicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                                        </custom:CustomHijriDatePicker.ColumnHeaderView>

                                        <custom:CustomHijriDatePicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="46"
                                                Background="{StaticResource NeutralBlack}"
                                                Text="{x:Static ResourceManager:AppResources.DeclarationDate}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle FontFamily="{StaticResource SomarSemiBold}" TextColor="White" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </custom:CustomHijriDatePicker.HeaderView>

                                        <custom:CustomHijriDatePicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </custom:CustomHijriDatePicker.SelectedTextStyle>


                                        <custom:CustomHijriDatePicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </custom:CustomHijriDatePicker.FooterView>

                                        <custom:CustomHijriDatePicker.Behaviors>
                                            <xct:EventToCommandBehavior Command="{Binding SelectedDeclarationTypeDateCommand}" EventName="SelectionChanged" />
                                        </custom:CustomHijriDatePicker.Behaviors>
                                    </custom:CustomHijriDatePicker>

                                </StackLayout>

                            </StackLayout>

                            <StackLayout x:Name="InquireByBillInfo" IsVisible="{Binding IsFilterByBusInformation}">


                                <StackLayout>

                                    <Label Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.Billofladingnumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                              <custom:GAZTBorderlessEntry
                                                Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                                MaxLength="10"
                                                Placeholder="{x:Static ResourceManager:AppResources.Billofladingnumber}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding BillInfoNumber}"
                                                VerticalTextAlignment="Center">

                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>

                                        </custom:CustomSfTextInputView.TextInputView>

                                    </custom:CustomSfTextInputView>
                                </StackLayout>

                                <StackLayout>

                                    <Label Margin="0,5,0,0" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.Shippingcompany}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <custom:CustomSfTextInputView>
                                        <custom:CustomSfTextInputView.TextInputView>
                                             <custom:GAZTBorderlessEntry
                                                HorizontalOptions="FillAndExpand"
                                                IsReadOnly="True"
                                                InputTransparent="True"
                                                Placeholder="{x:Static ResourceManager:AppResources.Shippingcompany}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding SelectedCarrier.carr_name}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalTextAlignment="Center" />

                                        </custom:CustomSfTextInputView.TextInputView>

                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png" />
                                        </inputLayout:SfTextInputLayout.TrailingView>

                                         <inputLayout:SfTextInputLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCarrierLstCommand}" />
                                        </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    </custom:CustomSfTextInputView>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCarrierLstCommand}" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>

                            </StackLayout>


                            <buttons:SfButton
                                Margin="0,20"
                                Background="#0996D4"
                                Command="{Binding SubmitInquiryCommand}"
                                CornerRadius="14"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.Submit}"
                                TextColor="White"/>

                        </StackLayout>

                        <StackLayout Margin="20,0" IsVisible="{Binding IsDetailsVisible}">

                            <Label
                                Margin="0,19,0,0"
                                Style="{x:StaticResource titleLabel}"
                                Text="{x:Static ResourceManager:AppResources.Importerinformation}" />

                            <Border
                                Padding="0"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8">

                                <StackLayout Margin="16">

                                    <Grid Padding="8,0" ColumnDefinitions="1.25*,*">

                                        <StackLayout>
                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Inferentialnumber}" />

                                            <Label
                                                FontSize="16"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding DeclarionByInformationInquireLst[0].InferentialNumber}" />

                                        </StackLayout>

                                        <Grid Grid.Column="1" RowDefinitions="auto">

                                            <Border
                                                Padding="0"
                                                Stroke="#F5BF58"
                                                StrokeShape="RoundRectangle 14,14,14,14"
                                                VerticalOptions="FillAndExpand" />

                                            <Label
                                                Margin="10,3,10,3"
                                                HorizontalOptions="CenterAndExpand"
                                                Text="{Binding DeclarionByInformationInquireLst[0].dcltn_sta_desc}"
                                                TextColor="#F5BF58"
                                                VerticalOptions="CenterAndExpand" />

                                        </Grid>

                                    </Grid>

                                    <BoxView Style="{StaticResource lineSeperator}" />

                                    <StackLayout Margin="15">

                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.NameForImprter}" />

                                        <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding DeclarionByInformationInquireLst[0].arbc_impr_name}" />


                                    </StackLayout>

                                </StackLayout>

                            </Border>

                            <Label
                                Margin="0,34,0,5"
                                Style="{x:StaticResource titleLabel}"
                                Text="{x:Static ResourceManager:AppResources.Statementitems}" />


                            <StackLayout x:Name="StatatmentLst" BindableLayout.ItemsSource="{Binding StatmentItemsLst}">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Margin="0,10,0,10"
                                            Padding="0"
                                            Stroke="LightGray"
                                            StrokeShape="RoundRectangle 8,8,8,8">

                                            <StackLayout Margin="16">

                                                <Grid ColumnDefinitions="*,auto">

                                                    <StackLayout Grid.Column="0" Padding="8,0">

                                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Customsitem}" />

                                                        <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding final_tariff_cd}" />

                                                    </StackLayout>

                                                    <Label
                                                        Grid.Column="1"
                                                        FontSize="14"
                                                        Text="{x:Static ResourceManager:AppResources.Details}"
                                                        TextColor="#0996D4">
                                                        <Label.GestureRecognizers>


                                                            <TapGestureRecognizer Command="{Binding BindingContext.StatmentDetailsCommand, Source={x:Reference StatatmentLst}}" CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>

                                                <BoxView Style="{StaticResource lineSeperator}" />

                                                <Grid
                                                    Margin="16"
                                                    ColumnDefinitions="*,*"
                                                    RowDefinitions="auto,auto">
                                                    <StackLayout Grid.Row="0" Grid.Column="0">
                                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Categoryseries}" />
                                                        <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding item_seq}" />

                                                    </StackLayout>
                                                    <StackLayout Grid.Row="0" Grid.Column="1">
                                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.CountryofOrigin}" />
                                                        <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding crty_arbc_name}" />

                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2">
                                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Customsitemdescription}" />
                                                        <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding tariff_desc}" />

                                                    </StackLayout>
                                                </Grid>


                                            </StackLayout>
                                        </Border>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>


                            <Label
                                Margin="0,34,0,5"
                                Style="{x:StaticResource titleLabel}"
                                Text="{x:Static ResourceManager:AppResources.Feedetails}" />

                            <Border
                                Padding="0"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8">

                                <StackLayout>
                                    <StackLayout Margin="16" BindableLayout.ItemsSource="{Binding DeclarionFeesLst}">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate>
                                                <StackLayout>

                                                    <Grid
                                                        Margin="16"
                                                        ColumnDefinitions="*,*"
                                                        RowDefinitions="auto,auto">

                                                        <StackLayout>

                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.FeeType}" />

                                                            <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding aid_type}" />

                                                        </StackLayout>

                                                        <StackLayout Grid.Column="1">

                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.FeeDescription}" />

                                                            <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding acct_desc}" />

                                                        </StackLayout>

                                                        <StackLayout Grid.Row="1" Grid.ColumnSpan="2">

                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.FeeCost}" />

                                                            <Label Style="{StaticResource BodyLabelBlack}">

                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding amt}" />
                                                                        <Span Text=" " />
                                                                        <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>

                                                            </Label>

                                                        </StackLayout>
                                                    </Grid>

                                                    <BoxView
                                                        HorizontalOptions="FillAndExpand"
                                                        IsVisible="{Binding isHideSeperatorLine}"
                                                        Style="{StaticResource lineSeperator}" />

                                                </StackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>


                                    </StackLayout>

                                    <Grid Margin="16">
                                        <Border
                                            Margin="-16"
                                            BackgroundColor="#0996D4"
                                            StrokeShape="RoundRectangle 8,8,8,8"
                                            HorizontalOptions="FillAndExpand"
                                            Opacity=".1" />

                                        <StackLayout Orientation="Horizontal" VerticalOptions="CenterAndExpand">

                                            <Label
                                                FontSize="20"
                                                Text="{x:Static ResourceManager:AppResources.Total}"
                                                TextColor="#002447" />

                                            <Label HorizontalOptions="EndAndExpand" Style="{StaticResource BodyLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TotalFees}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                    </Grid>

                                </StackLayout>

                            </Border>

                            <Border
                                Margin="0,10"
                                Padding="5"
                                BackgroundColor="#0996D4"
                                Stroke="#0996D4"
                                Opacity=".5">
                                <Label
                                    FontSize="14"
                                    Text="{x:Static ResourceManager:AppResources.FeesHint}"
                                    TextColor="White" />
                            </Border>

                        </StackLayout>

                        <StackLayout
                            x:Name="StatmentDetailsView"
                            Margin="24,55,24,24"
                            IsVisible="{Binding IsStatmentDetailsVisible}">

                            <Border
                                Padding="0"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8">

                                <Grid
                                    Margin="16,16,16,0"
                                    ColumnDefinitions="*,auto"
                                    RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto"
                                    RowSpacing="15">


                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Customsitem}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.final_tariff_cd}" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Categoryseries}" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.item_seq}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.CountryofOrigin}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.crty_arbc_name}" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Valueinforeigncurrency}" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.inv_cost}" />
                                    <Label
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Countrycurrency}" />
                                    <Label
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.curcy_intl_cd}" />
                                    <Label
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Measuringunit}" />
                                    <Label
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.msr_arbc_name}" />
                                    <Label
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsfeesSAR}" />
                                    <Label
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.orgnl_duty}" />
                                    <Label
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsvalueSAR}" />
                                    <Label
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.cif}" />
                                    <Label
                                        Grid.Row="8"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Customsdutyrate}" />
                                    <Label
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.duty_rate}" />
                                    <Label
                                        Grid.Row="9"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Quantity}" />
                                    <Label
                                        Grid.Row="9"
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.inv_qty}" />


                                    <Label
                                        Grid.Row="10"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Customsitemdescription}" />

                                    <Label
                                        Grid.Row="11"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.tariff_desc}" />

                                    <Label
                                        Grid.Row="12"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ItemDescriptions}" />

                                    <Label
                                        Grid.Row="13"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding SelectedStatmentItems.item_desc}" />

                                </Grid>

                            </Border>

                            <Border
                                Margin="0,20,0,0"
                                Padding="12"
                                BackgroundColor="#0996D4"
                                StrokeShape="RoundRectangle 14,14,14,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenFeesDescriptionCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.FeeDescriptions}"
                                    TextColor="#FFFFFF"
                                    VerticalOptions="CenterAndExpand" />
                            </Border>

                        </StackLayout>

                        <!--  OTP View  -->
                        <StackLayout
                            Margin="30"
                            IsVisible="{Binding IsOTPView}"
                            Spacing="35">

                            <StackLayout>
                                <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.VerificationCode}" />

                                <Label
                                    Padding="0,0,0,16"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.EnterVerificationCodeSentToMobile}" />

                                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />

                                <StackLayout Padding="0,15,0,0">
                                    <Label
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{Binding OTPSentOnThisMobileNumber}" />

                                    <Grid
                                        Margin="0,-10,0,0"
                                        ColumnDefinitions="*"
                                        FlowDirection="LeftToRight"
                                        RowDefinitions="*">

                                        <Grid
                                            Grid.Row="0"
                                            Padding="30,20,30,20"
                                            ColumnDefinitions="*,*,*,*"
                                            ColumnSpacing="20">
                                            <Grid.Resources>
                                                <ResourceDictionary>
                                                    <Style TargetType="custom:GAZTBorderlessEntry">
                                                        <Setter Property="Keyboard" Value="{OnPlatform Android=Numeric, iOS=Default}" />
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                        <Setter Property="FontSize" Value="Small" />
                                                        <Setter Property="WidthRequest" Value="8" />
                                                        <Setter Property="HorizontalTextAlignment" Value="Center" />
                                                        <Setter Property="ReturnType" Value="Next" />
                                                        <Setter Property="MaxLength" Value="1" />
                                                        <Setter Property="TextColor" Value="#bbbbbb" />
                                                        <Setter Property="HorizontalOptions" Value="CenterAndExpand" />
                                                        <Setter Property="IsPassword" Value="True" />

                                                    </Style>
                                                    <Style TargetType="inputLayout:SfTextInputLayout">
                                                        <Setter Property="ContainerType" Value="Outlined" />
                                                        <Setter Property="ContainerBackground" Value="White" />
                                                        <Setter Property="OutlineCornerRadius" Value="8" />
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                        <Setter Property="Margin" Value="0" />


                                                    </Style>
                                                </ResourceDictionary>
                                            </Grid.Resources>

                                            <!--  First OTP Digit Start  -->
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Stroke="Gray"
                                                    HeightRequest="50"
                                                    WidthRequest="50"
                                                    VerticalOptions="Start">

                                               <custom:GAZTBorderlessEntry x:Name="OTPFirstEntry"
                                                                            MaxLength="1"
                                                                            Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                                                            WidthRequest="100"
                                                                            Text="{Binding OTPFirstDigit}">
                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviors:OnlyNumericValuesBehaviour />

                                                            <behaviors:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                                            <xct:EventToCommandBehavior
                                                                Command="{Binding GoToNextEntryCommand}"
                                                                CommandParameter="{Binding Source={x:Reference OTPSecondEntry}}"
                                                                EventName="TextChanged" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>

                                                </custom:GAZTBorderlessEntry>
    
                                            </Border>
                                            <!--  First OTP Digit End  -->

                                            <!--  Second OTP Digit Start  -->
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Stroke="Gray"
                                                    HeightRequest="50"
                                                    WidthRequest="50"
                                                    Grid.Column="1"
                                                    VerticalOptions="Start">

                                               <custom:GAZTBorderlessEntry
                                                        x:Name="OTPSecondEntry"
                                                        ClassId="2"
                                                        WidthRequest="100"
                                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                                        MaxLength="1"
                                                        Text="{Binding OTPSecondDigit}">
                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviors:OnlyNumericValuesBehaviour />
                                                            <behaviors:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                                            <xct:EventToCommandBehavior
                                                                Command="{Binding GoToNextEntryCommand}"
                                                                CommandParameter="{Binding Source={x:Reference OTPThirdEntry}}"
                                                                EventName="TextChanged" />

                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                               </custom:GAZTBorderlessEntry>
    
                                            </Border>
                                            <!--  Second OTP Digit End  -->

                                            <!--  Third OTP Digit Start  -->
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Stroke="Gray"
                                                    HeightRequest="50"
                                                    WidthRequest="50"
                                                    Grid.Column="2"
                                                    VerticalOptions="Start">

                                               <custom:GAZTBorderlessEntry
                                                        x:Name="OTPThirdEntry"
                                                        ClassId="3"
                                                        WidthRequest="100"
                                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                                        MaxLength="1"
                                                        Text="{Binding OTPThirdDigit}">
                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviors:OnlyNumericValuesBehaviour />
                                                            <behaviors:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                                            <xct:EventToCommandBehavior
                                                                Command="{Binding GoToNextEntryCommand}"
                                                                CommandParameter="{Binding Source={x:Reference OTPFourthEntry}}"
                                                                EventName="TextChanged" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>
    
                                            </Border>
                                            <!--  Third OTP Digit End  -->

                                            <!--  Fourth OTP Digit Start  -->
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Stroke="Gray"
                                                    HeightRequest="50"
                                                    WidthRequest="50"
                                                    Grid.Column="3"
                                                    VerticalOptions="Start">

                                               <custom:GAZTBorderlessEntry
                                                        x:Name="OTPFourthEntry"
                                                        MaxLength="1"
                                                        WidthRequest="100"
                                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                                        ClassId="4"
                                                        Text="{Binding OTPFourthDigit}">
                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviors:OnlyNumericValuesBehaviour />
                                                            <xct:EventToCommandBehavior Command="{Binding VerifyOTPCommand}" EventName="Completed" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>
    
                                            </Border>
                                            <!--  Fourth OTP Digit End  -->

                                        </Grid>

                                    </Grid>


                                    <StackLayout HorizontalOptions="Center"
                                                 Spacing="10"
                                                 Orientation="Horizontal">
                                        <Image Source="clock" />
                                        <Label
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding LblCountDownTimer}"
                                            VerticalOptions="Center" />
                                    </StackLayout>

                                    <buttons:SfButton
                                        Margin="0,16,0,0"
                                        Background="Transparent"
                                        Command="{Binding ResendOtpCommand}"
                                        IsVisible="{Binding IsResendCodeEnabled}"
                                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                        TextColor="{Binding ResendOTPTextColor}"
                                        VerticalOptions="EndAndExpand" />

                                </StackLayout>

                            </StackLayout>

                            <buttons:SfButton
                                x:Name="btn"
                                Command="{Binding VerifyOTPCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.Verify}" />
                        </StackLayout>

                    </StackLayout>

                </ScrollView>

            </Border>

            <Grid
                Grid.RowSpan="2"
                IsVisible="{Binding IsPortsPickerSearch}"
                VerticalOptions="FillAndExpand">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClosePickerViewCommand}" />
                </Grid.GestureRecognizers>

                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />

                <Border
                    Padding="20,20,20,10"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 15,15,0,0"
                    Style="{StaticResource CommonTopCurves}"
                    VerticalOptions="EndAndExpand">

                    <Grid
                        Margin="0,0,0,0"
                        RowDefinitions="auto,*,auto"
                        VerticalOptions="FillAndExpand">

                     <custom:CustomSfTextInputView>
                        <custom:CustomSfTextInputView.TextInputView>
                            <custom:GAZTBorderlessEntry
                                HorizontalOptions="FillAndExpand"
                                Placeholder="{x:Static ResourceManager:AppResources.SearchField}"
                                PlaceholderColor="#888888"
                                Text="{Binding SearchTxt}"
                                Style="{StaticResource DefaultEntry}"
                                VerticalTextAlignment="Center">

                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <xct:EventToCommandBehavior
                                        Command="{Binding SearchInPortsCommand}"
                                        CommandParameter="{Binding Text, Source={x:Reference PortsSearchBar}}"
                                        EventName="TextChanged" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>

                        <inputLayout:SfTextInputLayout.LeadingView>
                            <Image Aspect="AspectFit" Source="reportSearchBar.png" />
                        </inputLayout:SfTextInputLayout.LeadingView>

                     </custom:CustomSfTextInputView>

                        <Grid Grid.Row="1">

                            <CollectionView
                                x:Name="PortSearchlst"
                                IsVisible="{Binding IsPickerOpened}"
                                ItemsSource="{Binding Ports}"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7" Padding="10,2,10,2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PortSelectionChangedCommand, Source={x:Reference StatatmentLst}}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <CollectionView
                                x:Name="Declerationlst"
                                IsVisible="{Binding IsDeclarationTypeOpened}"
                                ItemsSource="{Binding DeclarationTypes}"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10" Padding="10,2,10,2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PortSelectionChangedCommand, Source={x:Reference Declerationlst}}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <CollectionView
                                x:Name="CarrierSearchlst"
                                IsVisible="{Binding IsCarrierOpened}"
                                ItemsSource="{Binding Carriers}"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="7" Padding="10,2,10,2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PortSelectionChangedCommand, Source={x:Reference Declerationlst}}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding carr_name}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </Grid>

                        <buttons:SfButton
                            Grid.Row="2"
                            Margin="0,0,0,10"
                            Background="White"
                            Command="{Binding CloseInquiryFilterCommand}"
                            FontSize="16"
                            Stroke="{StaticResource PrimaryColor}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZClose}"
                            TextColor="#0996D4"
                            VerticalOptions="CenterAndExpand" />

                    </Grid>
                </Border>
            </Grid>

            <Grid
                Grid.RowSpan="2"
                IsVisible="{Binding IsFeesDescriptionVisible}"
                VerticalOptions="FillAndExpand">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}" />
                </Grid.GestureRecognizers>

                <StackLayout
                    BackgroundColor="Black"
                    Opacity="0.4"
                    VerticalOptions="FillAndExpand" />

                <ScrollView VerticalScrollBarVisibility="Never">
                    <Border
                        Margin="0"
                        Padding="15"
                        Background="White"
                        HorizontalOptions="Fill"
                        Stroke="White"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="EndAndExpand">

                        <StackLayout>

                            <Image
                                HeightRequest="10"
                                HorizontalOptions="CenterAndExpand"
                                Source="Grabber"
                                WidthRequest="38">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseisFeesDescriptionCommand}" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="28"
                                Text="{x:Static ResourceManager:AppResources.FeeDescriptions}"
                                TextColor="{StaticResource Primary}" />

                            <Border
                                BackgroundColor="White"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 14,14,14,14"
                                HorizontalOptions="Fill">

                                <Label
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{Binding FeesDescription.data}"
                                    TextColor="#999999" />
                            </Border>

                            <Border
                                Margin="0,20,0,15"
                                Padding="12"
                                BackgroundColor="#0996D4"
                                StrokeShape="RoundRectangle 14,14,14,14">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseisFeesDescriptionCommand}" />
                                </Border.GestureRecognizers>

                                <Label
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.ZClose}"
                                    TextColor="#FFFFFF"
                                    VerticalOptions="CenterAndExpand" />

                            </Border>
                        </StackLayout>

                    </Border>
                </ScrollView>

            </Grid>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <custom:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

