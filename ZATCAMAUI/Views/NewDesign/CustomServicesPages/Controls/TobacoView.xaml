<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.Controls.TobacoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviour="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    FlowDirection="{Binding AppDirection}">

    <ContentView.Content>
        <!--#region TobacoProduct-->
        <StackLayout>
            <!--  TypeItem Field  -->
            <StackLayout Spacing="0">
                <!--  TypeItem Label  -->
                <Label Style="{StaticResource CaptionLabelGrey}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static ResourceManager:AppResources.TypeItem}" />
                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!--  TypeItem Entry  -->
                <custom:CustomSfTextInputView>
                    <custom:CustomSfTextInputView.TextInputView>
                        <custom:GAZTBorderlessEntry
                            x:Name="typeItemEntry"
                            InputTransparent="True"
                            IsReadOnly="True"
                            Keyboard="Text"
                            Placeholder="{x:Static ResourceManager:AppResources.Select}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding SelectedTobacoType.Name}"
                            TextColor="#58595B">

                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
                            </custom:GAZTBorderlessEntry.GestureRecognizers>

                        </custom:GAZTBorderlessEntry>

                    </custom:CustomSfTextInputView.TextInputView>

                    <inputLayout:SfTextInputLayout.TrailingView>
                            <Image Aspect="AspectFit" Source="greyDropDown" />
                    </inputLayout:SfTextInputLayout.TrailingView>

                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
                    </inputLayout:SfTextInputLayout.GestureRecognizers>

                </custom:CustomSfTextInputView>

                <Label Text="{x:Static ResourceManager:AppResources.TobacoTypeNotehint}"
                        Margin="0,-15,0,10"
                        Style="{StaticResource CaptionLabelGrey}"/>

                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTobacoTypesCommand}" />
                </StackLayout.GestureRecognizers>

            </StackLayout>

            <!--  ProductName Field  -->
            <StackLayout Spacing="0">

                <!--  ProductName Label  -->
                <Label Style="{StaticResource CaptionLabelGrey}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static ResourceManager:AppResources.ProductName}" />
                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!--  ProductName Entry  -->
                <StackLayout>
                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        Hint="{x:Static ResourceManager:AppResources.Select}"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="15"
                        Stroke="{StaticResource NeutralGreay}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            x:Name="productNameEntry"
                            InputTransparent="True"
                            IsReadOnly="True"
                            Keyboard="Text"
                            Placeholder="{x:Static ResourceManager:AppResources.Select}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding SelectedTobacoItem.Name}"
                            TextColor="#58595B">

                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
                            </custom:GAZTBorderlessEntry.GestureRecognizers>

                        </custom:GAZTBorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image Aspect="AspectFit" Source="greyDropDown" />
                        </inputLayout:SfTextInputLayout.TrailingView>

                    </inputLayout:SfTextInputLayout>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTobacoItemssCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Quantity Field  -->
                <StackLayout Spacing="0">

                    <!--  Quantity Label  -->
                    <Label Style="{StaticResource CaptionLabelGrey}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.Quantity}" />
                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!--  Quantity Entry  -->
                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                        Hint="{x:Static ResourceManager:AppResources.Quantity}"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="15"
                        Stroke="{StaticResource NeutralGreay}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            x:Name="quantityEntry"
                            Keyboard="Numeric"
                            Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding Quantity}"
                            TextColor="#58595B">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviour:OnlyNumericValuesBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>

                        </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>

                </StackLayout>

                <!--  Total Value Field  -->
                <StackLayout Spacing="0">

                    <!--  Total value Label  -->
                    <Label Style="{StaticResource CaptionLabelGrey}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.Productvalue}" />
                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!--  Total Value Entry  -->
                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                        Hint="{x:Static ResourceManager:AppResources.TotalPriceValue}"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="15"
                        Stroke="{StaticResource NeutralGreay}">
                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <inputLayout:LabelStyle TextColor="#B00020" />
                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        <custom:GAZTBorderlessEntry
                            Keyboard="Numeric"
                            Placeholder="{x:Static ResourceManager:AppResources.TotalPriceValue}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding TotalValue}"
                            TextColor="#58595B">
                            <custom:GAZTBorderlessEntry.Behaviors>
                                <behaviour:OnlyNumericWithDecimalValuesBehaviour />
                            </custom:GAZTBorderlessEntry.Behaviors>
                        </custom:GAZTBorderlessEntry>
                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>

                </StackLayout>


            </StackLayout>
        </StackLayout>

        <!--#endregion-->

    </ContentView.Content>
</ContentView>

