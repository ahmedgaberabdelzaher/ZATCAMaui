<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.TraifSections"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="TraiffPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding LoadIntialTraiffSectionsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
    <Grid RowDefinitions="Auto,*">

        <!--#region Header-->
        <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

            <!--  Back Button  -->
            <StackLayout>

                <!--  Back Image  -->
                <Image
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Rotation="0"
                    Source="whiteRightBack.png"
                    VerticalOptions="CenterAndExpand">

                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding AppDirection}"
                            TargetType="Image"
                            Value="LeftToRight">
                            <Setter Property="Rotation" Value="180" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsSearchVIewVisible}"
                            TargetType="Image"
                            Value="true">
                            <Setter Property="Source" Value="CloseWhiteIcon" />
                            <Setter Property="WidthRequest" Value="19" />
                            <Setter Property="HeightRequest" Value="19" />
                        </DataTrigger>
                    </Image.Triggers>

                </Image>

                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </StackLayout.GestureRecognizers>

            </StackLayout>

            <!--  Header Label  -->
            <Label
                Grid.Column="1"
                FontSize="15"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                Style="{StaticResource SectionTitleWhiteBold}"
                Text="{Binding Title}"
                VerticalOptions="Center" />

            <!--  Download Image  -->
            <StackLayout Grid.Column="2">

                <Image
                    HeightRequest="25"
                    HorizontalOptions="EndAndExpand"
                    IsVisible="false"
                    Source="ic_downloadWhite"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="25">

                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsSectionView}"
                            TargetType="Image"
                            Value="true">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsSearchVIewVisible}"
                            TargetType="Image"
                            Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Image.Triggers>

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DownloadTraifDataCommand}" />
                    </Image.GestureRecognizers>

                </Image>

                <Image
                    HeightRequest="30"
                    HorizontalOptions="EndAndExpand"
                    IsVisible="false"
                    Source="infoWhiteIcon"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="30">

                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsChapterSection}"
                            TargetType="Image"
                            Value="true">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsHarmonizedTarrifs}"
                            TargetType="Image"
                            Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>

                    </Image.Triggers>

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenNoteCommand}" CommandParameter="2" />
                    </Image.GestureRecognizers>

                </Image>

            </StackLayout>


        </Grid>
        <!--#endregion Header-->

        <Border
            Grid.Row="1"
            Padding="0"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="FillAndExpand">
            <Grid
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">


                <Grid
                    Padding="20"
                    IsVisible="{Binding IsSectionView}"
                    RowDefinitions="auto,*">

                    <custom:CustomSfTextInputView>
                        <custom:CustomSfTextInputView.TextInputView>
                            <custom:GAZTBorderlessEntry
                                HorizontalOptions="FillAndExpand"
                                Placeholder="{x:Static ResourceManager:AppResources.SearchField}"
                                PlaceholderColor="#888888"
                                Style="{StaticResource DefaultEntry}"
                                VerticalTextAlignment="Center">

                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <xct:EventToCommandBehavior
                                        Command="{Binding ViewSearchViewCommand}"
                                        CommandParameter="{Binding SearchKey}"
                                        EventName="Focused" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>

                        </custom:CustomSfTextInputView.TextInputView>

                        <inputLayout:SfTextInputLayout.LeadingView>
                            <Image Aspect="AspectFit" Source="reportSearchBar.png" />
                        </inputLayout:SfTextInputLayout.LeadingView>

                    </custom:CustomSfTextInputView>

                    <CollectionView
                        Grid.Row="1"
                        ItemSizingStrategy="MeasureAllItems"
                        ItemsSource="{Binding TraiffSections}"
                        SelectedItem="{Binding SelectedTraiffSections}"
                        SelectionChangedCommand="{Binding TraiffSectionsSelectionChangedCommand}"
                        SelectionMode="Single"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout VerticalItemSpacing="10" Orientation="Vertical"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout>
                                    <Border
                                        Padding="20,15,17,15"
                                        Stroke="#D8D8D8"
                                        StrokeShape="RoundRectangle 14,14,14,14">
                                        <StackLayout Orientation="Horizontal">
                                            <Label
                                                FontSize="16"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource Primary}" />
                                            <Image
                                                HeightRequest="20"
                                                HorizontalOptions="EndAndExpand"
                                                Rotation="180"
                                                Source="LstArrow"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="10">
                                                <Image.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding AppDirection}"
                                                        TargetType="Image"
                                                        Value="LeftToRight">
                                                        <Setter Property="Rotation" Value="0" />
                                                    </DataTrigger>

                                                </Image.Triggers>

                                            </Image>



                                        </StackLayout>
                                    </Border>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                </Grid>

                <Grid IsVisible="{Binding IsChapterSection}" RowDefinitions="*">

                    <CollectionView
                        ItemsSource="{Binding TraiffChapters}"
                        SelectedItem="{Binding SelectedTraiffChapters}"
                        SelectionChangedCommand="{Binding TraiffChapterSelectionChangedCommand}"
                        SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <custom:TraifItemsControl />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                </Grid>

                <Grid IsVisible="{Binding IsMainHarmonizedTariffs}" RowDefinitions="*">

                    <CollectionView
                        ItemsSource="{Binding MainHarmonizedTariffs}"
                        SelectedItem="{Binding SelectedMainHarmonizedTariffs}"
                        SelectionChangedCommand="{Binding TraiffHarmonizedChangedCommand}"
                        SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <custom:TraifItemsControl />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid IsVisible="{Binding IsSubHarmonizedTariffs}" RowDefinitions="*">

                    <CollectionView
                        x:Name="SubHarmonizedTariffsLst"
                        ItemsSource="{Binding SubHarmonizedTariffs}"
                        SelectedItem="{Binding SelectedSubHarmonizedTariffs}"
                        SelectionChangedCommand="{Binding TraiffSubHarmonizedChangedCommand}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Grid x:Name="Item" Padding="24,6,24,6">

                                    <Border
                                        Padding="20,15,17,15"
                                        Stroke="#D8D8D8"
                                        StrokeShape="RoundRectangle 14,14,14,14">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference SubHarmonizedTariffsLst}, Path=BindingContext}"
                                                Command="{Binding TraiffSubHarmonizedChangedCommand}"
                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                        </Border.GestureRecognizers>

                                        <StackLayout Orientation="Horizontal">
                                            <Label
                                                FontSize="16"
                                                HorizontalOptions="StartAndExpand"
                                                TextColor="{StaticResource Primary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Code}" TextColor="{StaticResource Primary}" />
                                                        <Span Text=" - " TextColor="{StaticResource Primary}" />
                                                        <Span Text="{Binding Name}" TextColor="{StaticResource Primary}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Image
                                                HeightRequest="22"
                                                HorizontalOptions="EndAndExpand"
                                                Source="LstDetailsIcon"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="20" />

                                        </StackLayout>

                                    </Border>

                                </Grid>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Grid>

                <Grid
                    Margin="20"
                    BackgroundColor="White"
                    IsVisible="{Binding IsSearchVIewVisible}"
                    RowDefinitions="auto,auto,auto,auto,*">

                    <Grid
                        Margin="0,0,0,0"
                        ColumnDefinitions="*,auto"
                        ColumnSpacing="10"
                        RowDefinitions="auto">

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    HorizontalOptions="FillAndExpand"
                                    Placeholder="{x:Static ResourceManager:AppResources.SearchField}"
                                    PlaceholderColor="#888888"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SearchKey}"
                                    VerticalTextAlignment="Center">


                                    <custom:GAZTBorderlessEntry.Behaviors>
                                        <xct:EventToCommandBehavior
                                            Command="{Binding SearchCommand}"
                                            CommandParameter="{Binding SearchKey}"
                                            EventName="Completed" />

                                        <xct:EventToCommandBehavior
                                            Command="{Binding ViewSearchViewCommand}"
                                            CommandParameter="{Binding SearchKey}"
                                            EventName="Focused" />

                                    </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>

                            <inputLayout:SfTextInputLayout.LeadingView>
                               <Image Source="topsearchicon" />
                            </inputLayout:SfTextInputLayout.LeadingView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Grid.Column="1"
                            Margin="0,15,0,15"
                            HorizontalOptions="Start"
                            Text="{x:Static ResourceManager:AppResources.Clear}"
                            TextColor="#0996D4"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearSearchTextCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                    </Grid>

                    <Label
                        Grid.Row="1"
                        FontSize="16"
                        HorizontalOptions="Start"
                        Text="{x:Static ResourceManager:AppResources.SearchFor}"
                        TextColor="#002447" />

                    <Grid
                        Grid.Row="2"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="10"
                        IsVisible="{Binding IsSearchFilterVisbible}">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <Style TargetType="Border">
                                    <Setter Property="StrokeShape" Value="RoundRectangle 20,20,20,20" />
                                    <Setter Property="Padding" Value="9" />

                                </Style>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <Border Grid.Column="0" BackgroundColor="#F5F5F5">
                            <Label
                                HorizontalOptions="Center"
                                Text="{x:Static ResourceManager:AppResources.Word}"
                                TextColor="#666666"
                                VerticalOptions="CenterAndExpand">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SearchBy}"
                                        TargetType="Label"
                                        Value="1">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeSearchByCommand}" CommandParameter="1" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding SearchBy}"
                                    TargetType="Border"
                                    Value="1">
                                    <Setter Property="BackgroundColor" Value="#0996D4" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#F5F5F5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeSearchByCommand}" CommandParameter="3" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding SearchBy}"
                                    TargetType="Border"
                                    Value="3">
                                    <Setter Property="BackgroundColor" Value="#0996D4" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label
                                HorizontalOptions="Center"
                                Text="{x:Static ResourceManager:AppResources.HS}"
                                TextColor="#666666"
                                VerticalOptions="CenterAndExpand">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SearchBy}"
                                        TargetType="Label"
                                        Value="3">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="#F5F5F5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeSearchByCommand}" CommandParameter="2" />
                            </Border.GestureRecognizers>
                            <Label
                                HorizontalOptions="Center"
                                Text="{x:Static ResourceManager:AppResources.HSHeading}"
                                TextColor="#666666"
                                VerticalOptions="CenterAndExpand">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SearchBy}"
                                        TargetType="Label"
                                        Value="2">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding SearchBy}"
                                    TargetType="Border"
                                    Value="2">
                                    <Setter Property="BackgroundColor" Value="#0996D4" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>

                    <Label
                        Grid.Row="3"
                        Margin="0,0,0,10"
                        IsVisible="{Binding IsSearchFilterVisbible, Converter={StaticResource InverseBoolConverter}}"
                        TextColor="{StaticResource Primary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding SearchRsltCount}" TextColor="{StaticResource Primary}" />
                                <Span Text=" " />
                                <Span Text="{x:Static ResourceManager:AppResources.SearchRsltCountText}" TextColor="{StaticResource Primary}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Grid Grid.Row="4" RowDefinitions="*">
                        <CollectionView
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsSearchFilterVisbible, Converter={StaticResource InverseBoolConverter}}"
                            ItemsSource="{Binding SearchResultLst}"
                            SelectedItem="{Binding SelectedSearchResultLst}"
                            SelectionChangedCommand="{Binding TraiffSearchSelectionChangedCommand}"
                            SelectionMode="Single"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="10" Orientation="Vertical"/>
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        HorizontalOptions="FillAndExpand"
                                        RowDefinitions="*"
                                        VerticalOptions="FillAndExpand">
                                        <Border
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Stroke="#D8D8D8"
                                            StrokeShape="RoundRectangle 14,14,14,14"
                                            VerticalOptions="FillAndExpand">
                                            <StackLayout>

                                                <Label Text="{Binding Code}" />

                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding Name}"
                                                    TextColor="#0996D4" />

                                                <BoxView HeightRequest="1" Color="#EEEEEE" />

                                                <StackLayout BindableLayout.ItemsSource="{Binding tariffreleaseprocedures}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid
                                                                ColumnDefinitions="auto,*"
                                                                ColumnSpacing="10"
                                                                HorizontalOptions="FillAndExpand"
                                                                VerticalOptions="FillAndExpand">
                                                                <Label
                                                                    FontSize="12"
                                                                    Text="{Binding prcdr_code}"
                                                                    TextColor="#002447" />
                                                                <Label
                                                                    Grid.Column="1"
                                                                    FontSize="12"
                                                                    LineBreakMode="WordWrap"
                                                                    Text="{Binding rlse_prcdr_note}"
                                                                    TextColor="#002447" />
                                                            </Grid>

                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>

                                                </StackLayout>

                                                <BoxView HeightRequest="1" Color="#EEEEEE" />

                                                <Label
                                                    FontSize="12"
                                                    HorizontalOptions="Start"
                                                    TextColor="#002447">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontSize="12"
                                                                Text="{x:Static ResourceManager:AppResources.Duty}"
                                                                TextColor="#002447" />
                                                            <Span
                                                                FontSize="12"
                                                                Text=": "
                                                                TextColor="#002447" />
                                                            <Span
                                                                FontSize="12"
                                                                Text="{Binding tariffdetails[0].dutyName}"
                                                                TextColor="#002447" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                            </StackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>


                </Grid>

                <Grid IsVisible="{Binding IsTarrifSearch}" RowDefinitions="*">
                    <CollectionView
                        x:Name="HarmonizedTariffsInSearchLst"
                        ItemsSource="{Binding HarmonizedTariffslvl3}"
                        SelectedItem="{Binding SelectedSearchTariffs}"
                        SelectionChangedCommand="{Binding SelectedTarrifSearchSelectionChangedCommand}"
                        SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Item" Padding="24,6,24,6">

                                    <Border
                                        Padding="20,15,17,15"
                                        Stroke="#D8D8D8"
                                        StrokeShape="RoundRectangle 14,14,14,14">

                                        <StackLayout Orientation="Horizontal">

                                            <Label
                                                x:Name="nameLabl"
                                                FontSize="16"
                                                HorizontalOptions="StartAndExpand"
                                                TextColor="{StaticResource Primary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span
                                                            FontSize="16"
                                                            Text="{Binding Code}"
                                                            TextColor="{StaticResource Primary}" />
                                                        <Span
                                                            FontSize="16"
                                                            Text=" - "
                                                            TextColor="{StaticResource Primary}" />
                                                        <Span
                                                            FontSize="16"
                                                            Text="{Binding Name}"
                                                            TextColor="{StaticResource Primary}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!--  LstArrow  -->
                                            <Image
                                                HeightRequest="22"
                                                HorizontalOptions="EndAndExpand"
                                                Source="LstArrow"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="20">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        BindingContext="{Binding Source={x:Reference HarmonizedTariffsInSearchLst}, Path=BindingContext}"
                                                        Command="{Binding TraiffSubHarmonizedChangedCommand}"
                                                        CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                </Image.GestureRecognizers>
                                                <Image.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference TraiffPage}, Path=FlowDirection}"
                                                        TargetType="Image"
                                                        Value="RightToLeft">
                                                        <Setter Property="Rotation" Value="180" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="0">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstArrow" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="2">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstArrow" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="5">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstArrow" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="1">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstDetailsIcon" />

                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="3">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstDetailsIcon" />

                                                    </DataTrigger>
                                                </Image.Triggers>
                                            </Image>

                                        </StackLayout>
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>

                <!--  Harmonized Tarrifs  -->
                <Grid IsVisible="{Binding IsHarmonizedTarrifs}" VerticalOptions="FillAndExpand">

                    <CollectionView
                        x:Name="HarmonizedTariffsLst"
                        ItemsSource="{Binding HarmonizedTariffs}"
                        SelectedItem="{Binding SelectedHarmonizedTariffs}"
                        SelectionChangedCommand="{Binding TraiffLevel1SelectionChangedCommand}"
                        SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Item" Padding="24,6,24,6">

                                    <Border
                                        Padding="20,15,17,15"
                                        Stroke="#D8D8D8"
                                        StrokeShape="RoundRectangle 14,14,14,14">
                                        <StackLayout Orientation="Horizontal">
                                            <Label
                                                x:Name="nameLabl"
                                                FontSize="16"
                                                HorizontalOptions="StartAndExpand"
                                                TextColor="{StaticResource Primary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span
                                                            FontSize="16"
                                                            Text="{Binding Code}"
                                                            TextColor="{StaticResource Primary}" />
                                                        <Span
                                                            FontSize="16"
                                                            Text=" - "
                                                            TextColor="{StaticResource Primary}" />
                                                        <Span
                                                            FontSize="16"
                                                            Text="{Binding Name}"
                                                            TextColor="{StaticResource Primary}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <!--  LstArrow  -->
                                            <Image
                                                HeightRequest="22"
                                                HorizontalOptions="EndAndExpand"
                                                Source="LstArrow"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="20">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        BindingContext="{Binding Source={x:Reference HarmonizedTariffsLst}, Path=BindingContext}"
                                                        Command="{Binding TraiffSubHarmonizedChangedCommand}"
                                                        CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                </Image.GestureRecognizers>
                                                <Image.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Source={x:Reference TraiffPage}, Path=FlowDirection}"
                                                        TargetType="Image"
                                                        Value="RightToLeft">
                                                        <Setter Property="Rotation" Value="180" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="0">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstArrow" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="2">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstArrow" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="5">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstArrow" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="1">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
                                                        <Setter Property="Source" Value="LstDetailsIcon" />

                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding item_type}"
                                                        TargetType="Image"
                                                        Value="3">
                                                        <!--  Item type 0 & 2& 5 have sub items  -->
