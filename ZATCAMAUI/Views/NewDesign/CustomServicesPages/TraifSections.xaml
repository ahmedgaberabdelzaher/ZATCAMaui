<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.TraifSections"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    x:Name="TraiffPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding LoadIntialTraiffSectionsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
    <Grid>

        <StackLayout>
            <Grid
                Margin="0,24"
                Padding="15,5,15,5"
                ColumnDefinitions="24,*,auto"
                RowDefinitions="auto">


                <Image
                    x:Name="Image_BacKIcon"
                    Grid.Row="0"
                    Grid.Column="0"
                    HeightRequest="25"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Rotation="180"
                    Source="GrayBackButton"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>

                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsArabicLang}"
                            TargetType="Image"
                            Value="False">
                            <Setter Property="Rotation" Value="0" />

                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsSearchVIewVisible}"
                            TargetType="Image"
                            Value="true">
                            <Setter Property="Source" Value="CloseWhiteIcon" />
                            <Setter Property="WidthRequest" Value="19" />
                            <Setter Property="HeightRequest" Value="19" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0"
                    HorizontalOptions="CenterAndExpand"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding Title}" />
                <Image
                    Grid.Column="2"
                    HeightRequest="22"
                    HorizontalOptions="EndAndExpand"
                    IsVisible="false"
                    Source="ic_downloadWhite"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="19">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsSectionView}"
                            TargetType="Image"
                            Value="true">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsSearchVIewVisible}"
                            TargetType="Image"
                            Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Image.Triggers>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DownloadTraifDataCommand}" />
                    </Image.GestureRecognizers>

                </Image>
                <Image
                    Grid.Column="2"
                    HeightRequest="43"
                    HorizontalOptions="EndAndExpand"
                    IsVisible="false"
                    Source="infoWhiteIcon"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="43">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsChapterSection}"
                            TargetType="Image"
                            Value="true">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsHarmonizedTarrifs}"
                            TargetType="Image"
                            Value="True">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>

                    </Image.Triggers>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenNoteCommand}" CommandParameter="2" />
                    </Image.GestureRecognizers>

                </Image>
            </Grid>
            <yummy:PancakeView
                Padding="0"
                CornerRadius="14,14,0,0"
                VerticalOptions="FillAndExpand">
                <Grid
                    Padding="0,0,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">


                    <StackLayout IsVisible="{Binding IsSectionView}">
                        <Frame
                            BackgroundColor="#F5F5F5"
                            CornerRadius="15"
                            HasShadow="False"
                            IsVisible="false">
                            <Frame.Padding>
                                <OnPlatform x:TypeArguments="Thickness">
                                    <On Platform="Android" Value="0" />
                                    <On Platform="iOS" Value="-8" />
                                </OnPlatform>
                            </Frame.Padding>
                            <SearchBar Placeholder="{x:Static ResourceManager:AppResources.SearchField}">
                                <SearchBar.Behaviors>
                                    <xct:EventToCommandBehavior
                                        Command="{Binding ViewSearchViewCommand}"
                                        CommandParameter="{Binding SearchKey}"
                                        EventName="Focused" />
                                </SearchBar.Behaviors>
                            </SearchBar>

                        </Frame>
                        <inputLayout:SfTextInputLayout
                            Grid.Column="0"
                            Margin="24,20"
                            BackgroundColor="White"
                            ContainerType="Outlined"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="15"
                             IsHintAlwaysFloated="True"
                            Stroke="#B1B1B1"
                            Style="{StaticResource InputTableTextInputLayoutStyle}"
                            VerticalOptions="CenterAndExpand">
                            <inputLayout:SfTextInputLayout.LeadingView>
                                <Image Source="topsearchicon" />
                            </inputLayout:SfTextInputLayout.LeadingView>
                            <custom:GAZTBorderlessEntry
                                Grid.Column="1"
                                HorizontalOptions="FillAndExpand"
                                Placeholder="{x:Static ResourceManager:AppResources.SearchField}"
                                PlaceholderColor="#888888"
                                Style="{StaticResource DefaultEntry}"
                                VerticalTextAlignment="Center">


                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <xct:EventToCommandBehavior
                                        Command="{Binding ViewSearchViewCommand}"
                                        CommandParameter="{Binding SearchKey}"
                                        EventName="Focused" />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>


                        </inputLayout:SfTextInputLayout>
                        <ScrollView VerticalScrollBarVisibility="Never">
                            <CollectionView
                                ItemSizingStrategy="MeasureAllItems"
                                ItemsSource="{Binding TraiffSections}"
                                SelectedItem="{Binding SelectedTraiffSections}"
                                SelectionChangedCommand="{Binding TraiffSectionsSelectionChangedCommand}"
                                SelectionMode="Single"
                                VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout
                                        HorizontalItemSpacing="4"
                                        Orientation="Vertical"
                                        VerticalItemSpacing="0" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout Padding="24,6,24,6">
                                            <Frame
                                                Padding="20,15,17,15"
                                                BorderColor="#D8D8D8"
                                                CornerRadius="14"
                                                HasShadow="False">
                                                <StackLayout Orientation="Horizontal">
                                                    <Label
                                                        FontSize="16"
                                                        HorizontalOptions="StartAndExpand"
                                                        Text="{Binding Name}"
                                                        TextColor="{StaticResource Primary}" />
                                                    <Image
                                                        HeightRequest="20"
                                                        HorizontalOptions="EndAndExpand"
                                                        Rotation="0"
                                                        Source="LstArrow"
                                                        VerticalOptions="CenterAndExpand"
                                                        WidthRequest="10">
                                                        <Image.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Source={x:Reference TraiffPage}, Path=FlowDirection}"
                                                                TargetType="Image"
                                                                Value="RightToLeft">
                                                                <Setter Property="Rotation" Value="180" />
                                                            </DataTrigger>
                                                        </Image.Triggers>

                                                    </Image>

                                                </StackLayout>
                                            </Frame>
                                        </StackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                    </StackLayout>

                    <Grid IsVisible="{Binding IsChapterSection}">

                        <CollectionView
                            ItemsSource="{Binding TraiffChapters}"
                            SelectedItem="{Binding SelectedTraiffChapters}"
                            SelectionChangedCommand="{Binding TraiffChapterSelectionChangedCommand}"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <custom:TraifItemsControl />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Grid Grid.Row="0" IsVisible="{Binding IsSectNote}">
                            <Grid
                                BackgroundColor="Black"
                                HorizontalOptions="Fill"
                                Opacity=".5"
                                VerticalOptions="Fill" />
                            <Frame
                                Margin="10,0,10,10"
                                BackgroundColor="White"
                                BorderColor="#CECECE"
                                CornerRadius="14"
                                HasShadow="False"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <StackLayout>
                                    <StackLayout
                                        Margin="10"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Label
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            Text="{x:Static ResourceManager:AppResources.ZNote}"
                                            TextColor="#042E66" />
                                        <Image
                                            HeightRequest="19"
                                            HorizontalOptions="EndAndExpand"
                                            Source="CloseIcon"
                                            WidthRequest="19">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding CloseNoteCommand}" CommandParameter="1" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </StackLayout>
                                    <ScrollView>
                                        <StackLayout BindableLayout.ItemsSource="{Binding SectionNotesLst}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding ChaptNote}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </ScrollView>
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </Grid>

                    <StackLayout IsVisible="{Binding IsMainHarmonizedTariffs}">

                        <CollectionView
                            ItemsSource="{Binding MainHarmonizedTariffs}"
                            SelectedItem="{Binding SelectedMainHarmonizedTariffs}"
                            SelectionChangedCommand="{Binding TraiffHarmonizedChangedCommand}"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <custom:TraifItemsControl />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                    <StackLayout IsVisible="{Binding IsSubHarmonizedTariffs}">

                        <CollectionView
                            x:Name="SubHarmonizedTariffsLst"
                            ItemsSource="{Binding SubHarmonizedTariffs}"
                            SelectedItem="{Binding SelectedSubHarmonizedTariffs}"
                            SelectionChangedCommand="{Binding TraiffSubHarmonizedChangedCommand}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Item" Padding="24,6,24,6">

                                        <Frame
                                            Padding="20,15,17,15"
                                            BorderColor="#D8D8D8"
                                            CornerRadius="14"
                                            HasShadow="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    BindingContext="{Binding Source={x:Reference SubHarmonizedTariffsLst}, Path=BindingContext}"
                                                    Command="{Binding TraiffSubHarmonizedChangedCommand}"
                                                    CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                            </Frame.GestureRecognizers>
                                            <StackLayout Orientation="Horizontal">
                                                <Label
                                                    FontSize="16"
                                                    HorizontalOptions="StartAndExpand"
                                                    TextColor="{StaticResource Primary}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Code}" />
                                                            <Span Text=" - " />
                                                            <Span Text="{Binding Name}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Image
                                                    HeightRequest="22"
                                                    HorizontalOptions="EndAndExpand"
                                                    Source="LstDetailsIcon"
                                                    VerticalOptions="CenterAndExpand"
                                                    WidthRequest="20" />

                                            </StackLayout>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                    <Grid
                        Padding="24,20"
                        BackgroundColor="White"
                        IsVisible="{Binding IsSearchVIewVisible}">
                        <StackLayout>

                            <Grid
                                Margin="0,0,0,10"
                                ColumnDefinitions="*,auto"
                                RowDefinitions="auto">


                                <inputLayout:SfTextInputLayout
                                    Grid.Column="0"
                                    BackgroundColor="White"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                     IsHintAlwaysFloated="True"
                                    OutlineCornerRadius="15"
                                    Stroke="#B1B1B1"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <inputLayout:SfTextInputLayout.LeadingView>
                                        <Image Source="topsearchicon" />
                                    </inputLayout:SfTextInputLayout.LeadingView>
                                    <custom:GAZTBorderlessEntry
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Placeholder="{x:Static ResourceManager:AppResources.SearchField}"
                                        PlaceholderColor="#888888"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SearchKey}"
                                        VerticalTextAlignment="Center">


                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <xct:EventToCommandBehavior
                                                Command="{Binding SearchCommand}"
                                                CommandParameter="{Binding SearchKey}"
                                                EventName="Completed" />
                                            <xct:EventToCommandBehavior
                                                Command="{Binding ViewSearchViewCommand}"
                                                CommandParameter="{Binding SearchKey}"
                                                EventName="Focused" />

                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,15,0,15"
                                    HorizontalOptions="Start"
                                    Text="{x:Static ResourceManager:AppResources.Clear}"
                                    TextColor="#0996D4"
                                    VerticalOptions="CenterAndExpand">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearSearchTextCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </Grid>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Start"
                                IsVisible="{Binding IsSearchFilterVisbible}"
                                Text="{x:Static ResourceManager:AppResources.SearchFor}"
                                TextColor="#002447" />
                            <Grid ColumnDefinitions="*,*,*" IsVisible="{Binding IsSearchFilterVisbible}">
                                <Grid.Resources>
                                    <ResourceDictionary>
                                        <Style TargetType="Frame">
                                            <Setter Property="CornerRadius" Value="20" />
                                            <Setter Property="Padding" Value="9" />
                                            <Setter Property="HasShadow" Value="False" />

                                        </Style>
                                    </ResourceDictionary>
                                </Grid.Resources>
                                <Frame Grid.Column="0" BackgroundColor="#F5F5F5">
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="{x:Static ResourceManager:AppResources.Word}"
                                        TextColor="#666666"
                                        VerticalOptions="CenterAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding SearchBy}"
                                                TargetType="Label"
                                                Value="1">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChangeSearchByCommand}" CommandParameter="1" />
                                    </Frame.GestureRecognizers>
                                    <Frame.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SearchBy}"
                                            TargetType="Frame"
                                            Value="1">
                                            <Setter Property="BackgroundColor" Value="#0996D4" />
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                                <Frame Grid.Column="1" BackgroundColor="#F5F5F5">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChangeSearchByCommand}" CommandParameter="3" />
                                    </Frame.GestureRecognizers>
                                    <Frame.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SearchBy}"
                                            TargetType="Frame"
                                            Value="3">
                                            <Setter Property="BackgroundColor" Value="#0996D4" />
                                        </DataTrigger>
                                    </Frame.Triggers>
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="{x:Static ResourceManager:AppResources.HS}"
                                        TextColor="#666666"
                                        VerticalOptions="CenterAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding SearchBy}"
                                                TargetType="Label"
                                                Value="3">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Frame>
                                <Frame Grid.Column="2" BackgroundColor="#F5F5F5">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChangeSearchByCommand}" CommandParameter="2" />
                                    </Frame.GestureRecognizers>
                                    <Label
                                        HorizontalOptions="Center"
                                        Text="{x:Static ResourceManager:AppResources.HSHeading}"
                                        TextColor="#666666"
                                        VerticalOptions="CenterAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding SearchBy}"
                                                TargetType="Label"
                                                Value="2">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Frame.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SearchBy}"
                                            TargetType="Frame"
                                            Value="2">
                                            <Setter Property="BackgroundColor" Value="#0996D4" />
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </Grid>
                            <Label
                                Margin="10,10,10,3"
                                IsVisible="{Binding IsSearchFilterVisbible, Converter={StaticResource InverseBoolConverter}}"
                                TextColor="{StaticResource Primary}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding SearchRsltCount}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.SearchRsltCountText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Grid>

                                <CollectionView
                                    Margin="0,25,0,10"
                                    IsVisible="{Binding IsSearchFilterVisbible, Converter={StaticResource InverseBoolConverter}}"
                                    ItemsSource="{Binding SearchResultLst}"
                                    SelectedItem="{Binding SelectedSearchResultLst}"
                                    SelectionChangedCommand="{Binding TraiffSearchSelectionChangedCommand}"
                                    SelectionMode="Single"
                                    VerticalScrollBarVisibility="Never">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout ItemSpacing="20" Orientation="Vertical" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="5,0">
                                                <Frame
                                                    Padding="20,16,20,13"
                                                    BorderColor="#D8D8D8"
                                                    CornerRadius="14"
                                                    HasShadow="False">
                                                    <StackLayout>
                                                        <Label Text="{Binding Code}" />
                                                        <Label
                                                            FontSize="12"
                                                            Text="{Binding Name}"
                                                            TextColor="#0996D4" />
                                                        <BoxView HeightRequest="1" Color="#EEEEEE" />
                                                        <StackLayout BindableLayout.ItemsSource="{Binding tariffreleaseprocedures}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackLayout Orientation="Horizontal">
                                                                        <Label
                                                                            FontSize="12"
                                                                            Text="{Binding prcdr_code}"
                                                                            TextColor="#002447" />
                                                                        <Label
                                                                            FontSize="12"
                                                                            Text="{Binding rlse_prcdr_note}"
                                                                            TextColor="#002447" />
                                                                    </StackLayout>

                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </StackLayout>

                                                        <BoxView HeightRequest="1" Color="#EEEEEE" />
                                                        <Label FontSize="12" TextColor="#002447">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.Duty}" />
                                                                    <Span Text=": " />
                                                                    <Span Text="{Binding tariffdetails[0].dutyName}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </StackLayout>
                                                </Frame>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </Grid>
                        </StackLayout>

                    </Grid>
                    <Grid IsVisible="{Binding IsTarrifSearch}">
                        <CollectionView
                            x:Name="HarmonizedTariffsInSearchLst"
                            ItemsSource="{Binding HarmonizedTariffslvl3}"
                            SelectedItem="{Binding SelectedSearchTariffs}"
                            SelectionChangedCommand="{Binding SelectedTarrifSearchSelectionChangedCommand}"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Item" Padding="24,6,24,6">

                                        <Frame
                                            Padding="20,15,17,15"
                                            BorderColor="#D8D8D8"
                                            CornerRadius="14"
                                            HasShadow="False">
                                            <StackLayout Orientation="Horizontal">
                                                <Label
                                                    x:Name="nameLabl"
                                                    FontSize="16"
                                                    HorizontalOptions="StartAndExpand"
                                                    TextColor="{StaticResource Primary}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Code}" />
                                                            <Span Text=" - " />
                                                            <Span Text="{Binding Name}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <!--  LstArrow  -->
                                                <Image
                                                    HeightRequest="22"
                                                    HorizontalOptions="EndAndExpand"
                                                    Source="LstArrow"
                                                    VerticalOptions="CenterAndExpand"
                                                    WidthRequest="20">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            BindingContext="{Binding Source={x:Reference HarmonizedTariffsInSearchLst}, Path=BindingContext}"
                                                            Command="{Binding TraiffSubHarmonizedChangedCommand}"
                                                            CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                    </Image.GestureRecognizers>
                                                    <Image.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding Source={x:Reference TraiffPage}, Path=FlowDirection}"
                                                            TargetType="Image"
                                                            Value="RightToLeft">
                                                            <Setter Property="Rotation" Value="180" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding item_type}"
                                                            TargetType="Image"
                                                            Value="0">
                                                            <!--  Item type 0 & 2& 5 have sub items  -->
                                                            <Setter Property="Source" Value="LstArrow" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding item_type}"
                                                            TargetType="Image"
                                                            Value="2">
                                                            <!--  Item type 0 & 2& 5 have sub items  -->
                                                            <Setter Property="Source" Value="LstArrow" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding item_type}"
                                                            TargetType="Image"
                                                            Value="5">
                                                            <!--  Item type 0 & 2& 5 have sub items  -->
                                                            <Setter Property="Source" Value="LstArrow" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding item_type}"
                                                            TargetType="Image"
                                                            Value="1">
                                                            <!--  Item type 0 & 2& 5 have sub items  -->
                                                            <Setter Property="Source" Value="LstDetailsIcon" />

                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding item_type}"
                                                            TargetType="Image"
                                                            Value="3">
                                                            <!--  Item type 0 & 2& 5 have sub items  -->
                                                            <Setter Property="Source" Value="LstDetailsIcon" />

                                                        </DataTrigger>
                                                    </Image.Triggers>
                                                </Image>

                                            </StackLayout>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>
                    <!--  Harmonized Tarrifs  -->
                    <Grid IsVisible="{Binding IsHarmonizedTarrifs}" VerticalOptions="FillAndExpand">

                        <CollectionView
