<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.eDeclarations.EDeclerationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="auto,*">
        <yummy:PancakeView
            Grid.Row="1"
            Padding="20,20,20,0"
            Style="{StaticResource CommonTopCurves}">
            <StackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="23">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <Style TargetType="Frame">
                                <Setter Property="CornerRadius" Value="15" />
                                <Setter Property="BorderColor" Value="#DDDDDD" />
                                <Setter Property="Padding" Value="15" />
                            </Style>
                            <Style TargetType="Image">
                                <Setter Property="HeightRequest" Value="41" />
                                <Setter Property="WidthRequest" Value="32" />

                            </Style>
                        </ResourceDictionary>
                    </Grid.Resources>
                    <Frame Grid.Column="0" CornerRadius="20">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToNewEDeclerationCommand}" />
                        </Frame.GestureRecognizers>
                        <StackLayout>
                            <Image Source="EDeclerationicon" />
                            <Label HorizontalOptions="CenterAndExpand" Text="{x:Static ResourceManager:AppResources.eDeclaration}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" CornerRadius="20">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToPreviousEDeclerationCommand}" />
                        </Frame.GestureRecognizers>
                        <StackLayout>
                            <Image Source="EDeclerationicon" />
                            <Label
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Reviewapreviousrequest}"
                                TextColor="#002447" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </StackLayout>
        </yummy:PancakeView>
        <controls:Header TitleText="{x:Static ResourceManager:AppResources.CustomsDeclarationforTravelers}" />
        <controls:Loader
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsLoading}" />
    </Grid>

</ContentPage>
