<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.eDeclarations.ReiewPreviousDeclerations"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:controls="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    FlowDirection="{Binding AppDirection}">
    <Grid RowDefinitions="auto,*">
        <Border
            Grid.Row="1"
            Padding="20,20,20,0"
            Style="{StaticResource CommonTopCurves}">
            <WebView
                x:Name="webc"
                Margin="-20,0,-20,0"
                HorizontalOptions="FillAndExpand"
                Navigating="WebView_Navigating"
                VerticalOptions="FillAndExpand" />
        </Border>
        <controls:Header TitleText="{x:Static ResourceManager:AppResources.CarImport}" />
        <controls:Loader
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsLoading}" />
    </Grid>
</newdesign:BaseContentPage>
