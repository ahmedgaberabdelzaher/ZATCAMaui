<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.Transaction_Reception.TransactionReceptionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    FlowDirection="{Binding AppDirection}"
    HasBackButton="True"
    TitleText="{x:Static ResourceManager:AppResources.TransactionReception}">
    <newdesign:BaseContentPage.PancakeView>
        <Grid Padding="15,20">

            <ScrollView VerticalScrollBarVisibility="Never">
                <StackLayout>

                    <Label
                        FontFamily="{StaticResource SomarSemiBold}"
                        FontSize="18"
                        Text="{x:Static ResourceManager:AppResources.NewTransactionReception}"
                        TextColor="#002447" />

                    <Label
                        FontSize="12"
                        Text="{x:Static ResourceManager:AppResources.Pleasecompletethedata}"
                        TextColor="#999999" />

                    <Label Margin="0,18,0,6" Style="{StaticResource CaptionLabelGrey}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.UserType}" />
                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!--#region Selection Options-->
                    <Grid ColumnDefinitions="*,15,*" RowDefinitions="auto">

                        <!--#region Individula Option-->
                        <Border
                            Grid.Column="0"
                            Margin="0"
                            Padding="0"
                            StrokeShape="RoundRectangle 14,14,14,14">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectUserTypeCommand}" CommandParameter="1" />

                            </Border.GestureRecognizers>

                            <Grid Grid.Column="0">


                                <Image Aspect="Fill" Source="QSelected">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding UserType}"
                                            TargetType="Image"
                                            Value="2">
                                            <Setter Property="Source" Value="QUnselected" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <StackLayout>
                                    <Image
                                        Margin="17,25,17,10"
                                        HeightRequest="50"
                                        HorizontalOptions="Start"
                                        Source="Taxpayer.png"
                                        VerticalOptions="Start"
                                        WidthRequest="30">
                                        <Image.Triggers>
                                            <DataTrigger
                                                Binding="{Binding UserType}"
                                                TargetType="Image"
                                                Value="1">
                                                <Setter Property="Source" Value="SelectefTaxpayer" />
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>

                                    <Label
                                        Margin="10,10,10,10"
                                        FontSize="16"
                                        Text="{x:Static ResourceManager:AppResources.Individual}"
                                        TextColor="#FFFFFF"
                                        VerticalOptions="EndAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding UserType}"
                                                TargetType="Label"
                                                Value="2">
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                </StackLayout>

                            </Grid>

                        </Border>
                        <!--#endregion-->

                        <!--#region Entity Option-->
                        <Border
                            Grid.Column="2"
                            Margin="0"
                            Padding="0"
                            StrokeShape="RoundRectangle 14,14,14,14">
                            <Grid Grid.Column="2">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectUserTypeCommand}" CommandParameter="2" />
                                </Grid.GestureRecognizers>


                                <Image
                                    Grid.Row="0"
                                    Aspect="Fill"
                                    Source="QUnselected.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding UserType}"
                                            TargetType="Image"
                                            Value="2">
                                            <Setter Property="Source" Value="QSelected" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <StackLayout>
                                    <Image
                                        Margin="17,25,17,10"
                                        HeightRequest="50"
                                        HorizontalOptions="Start"
                                        Source="Entity.png"
                                        VerticalOptions="Start"
                                        WidthRequest="30">
                                        <Image.Triggers>
                                            <DataTrigger
                                                Binding="{Binding UserType}"
                                                TargetType="Image"
                                                Value="2">
                                                <Setter Property="Source" Value="SelectedEntity" />
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    <Label
                                        Margin="10"
                                        FontSize="16"
                                        Text="{x:Static ResourceManager:AppResources.Entity}"
                                        TextColor="{StaticResource Primary}"
                                        VerticalOptions="EndAndExpand">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding UserType}"
                                                TargetType="Label"
                                                Value="2">
                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </StackLayout>
                            </Grid>
                        </Border>
                        <!--#endregion-->
                    </Grid>
                    <!--#endregion-->


                    <!--#region  Email Field-->
                    <StackLayout Margin="0,20,0,0" Spacing="0">

                        <!--  Email Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZEmailAddress}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <!--  Email Entry  -->
                        <inputLayout:SfTextInputLayout
                            ContainerBackground="White"
                            ContainerType="Outlined"
                            InputViewPadding="16,0,16,0"
                            IsHintAlwaysFloated="True"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="15"
                            Stroke="{StaticResource NeutralGreay}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                Keyboard="Email"
                                Placeholder="{x:Static ResourceManager:AppResources.ZZEmailAddress}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding Email}"
                                TextColor="#58595B" />
                        </inputLayout:SfTextInputLayout>
                    </StackLayout>
                    <!--#endregion-->

                    <!--#region CR-->
                    <StackLayout IsVisible="{Binding IsEntity}">

                        <StackLayout>

                            <!--  CR Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.UnifiedNumber}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <!--  CR DropDown Entry  -->

                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                Hint="{x:Static ResourceManager:AppResources.UnifiedNumber}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <custom:GAZTBorderlessEntry
                                    x:Name="reportRegionEntry"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.UnifiedNumber}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedCRNo}"
                                    TextColor="#58595B">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GetCurrentUserCRCommand}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GetCurrentUserCRCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GetCurrentUserCRCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>

                        <!--  ADD Button  -->
                        <Border
                            Margin="0,0,0,20"
                            Padding="12"
                            BackgroundColor="White"
                            Stroke="#4FBBBD"
                            StrokeShape="RoundRectangle 14,14,14,14">
                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.AddNewCR}"
                                TextColor="#4FBBBD"
                                VerticalOptions="CenterAndExpand" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DisplayAddNewCRViewCommand}" CommandParameter="1" />

                            </Border.GestureRecognizers>
                        </Border>

                    </StackLayout>
                    <!--#endregion-->

                    <!--#region TinNo View-->
                    <StackLayout IsVisible="{Binding IsTinNoVisible}">
                        <StackLayout Spacing="0">

                            <!--  Tin Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.TIN}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <!--  Tin Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                Hint="{x:Static ResourceManager:AppResources.TIN}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <custom:GAZTBorderlessEntry
                                    x:Name="TinEntry"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding TIN}"
                                    TextColor="#58595B" />

                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                    </StackLayout>

                    <!--#endregion-->

                    <!--#region National Address-->
                    <Border
                        Padding="7"
                        Stroke="Gray"
                        StrokeShape="RoundRectangle 14,14,14,14">
                        <StackLayout>
                            <Label
                                Margin="0,10"
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{x:Static ResourceManager:AppResources.nationaladdress}"
                                TextColor="{StaticResource PrimaryColor}" />
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10"
                                RowDefinitions="auto,auto,auto,auto,auto,auto">

                                <Label>
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Buildingnumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>
                                <!--  Buildingnumber Entry  -->
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    Hint="{x:Static ResourceManager:AppResources.Buildingnumber}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="15"
                                    Stroke="{StaticResource NeutralGreay}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="{OnPlatform Android=Numeric,
                                                              iOS=Default}"
                                        Placeholder="{x:Static ResourceManager:AppResources.Buildingnumber}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding BuildingNo}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviors:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>

                                <Label Grid.Row="0" Grid.Column="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Streetname}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>
                                <!--  Streetname Entry  -->
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    Hint="{x:Static ResourceManager:AppResources.Streetname}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="15"
                                    Stroke="{StaticResource NeutralGreay}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Email"
                                        MaxLength="50"
                                        Placeholder="{x:Static ResourceManager:AppResources.Streetname}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding StreetName}"
                                        TextColor="#58595B" />
                                </inputLayout:SfTextInputLayout>

                                <Label Grid.Row="2" Grid.Column="0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Districtname}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>
                                <!--  Districtname Entry  -->
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    Hint="{x:Static ResourceManager:AppResources.Districtname}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="15"
                                    Stroke="{StaticResource NeutralGreay}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Text"
                                        MaxLength="50"
                                        Placeholder="{x:Static ResourceManager:AppResources.Districtname}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding DistrictName}"
                                        TextColor="#58595B" />
                                </inputLayout:SfTextInputLayout>

                                <Label Grid.Row="2" Grid.Column="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Cityname}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>
                                <!--  Cityname Entry  -->
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    Hint="{x:Static ResourceManager:AppResources.Cityname}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="15"
                                    Stroke="{StaticResource NeutralGreay}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Text"
                                        MaxLength="100"
                                        Placeholder="{x:Static ResourceManager:AppResources.Cityname}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding CityName}"
                                        TextColor="#58595B" />
                                </inputLayout:SfTextInputLayout>



                                <Label
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="{x:Static ResourceManager:AppResources.PostalCode}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.PostalCode}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>
                                <!--  PostalCode Entry  -->
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    Hint="{x:Static ResourceManager:AppResources.PostalCode}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="15"
                                    Stroke="{StaticResource NeutralGreay}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.PostalCode}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding PostalCode}"
                                        TextColor="#58595B" />
                                </inputLayout:SfTextInputLayout>

                                <Label Grid.Row="4" Grid.Column="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.SecondaryNumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>


                                </Label>
                                <!--  Number Secondar Entry  -->
                                <inputLayout:SfTextInputLayout
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    ContainerBackground="White"
                                    ContainerType="Outlined"
                                    Hint="{x:Static ResourceManager:AppResources.SecondaryNumber}"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="15"
                                    Stroke="{StaticResource NeutralGreay}">

                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.SecondaryNumber}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SeconderyNo}"
                                        TextColor="#58595B" />
                                </inputLayout:SfTextInputLayout>

                            </Grid>
                        </StackLayout>
                    </Border>

                    <!--#endregion-->

                    <!--#region  Subject Field-->
                    <StackLayout Margin="0,10,0,0" Spacing="0">
                        <!--  Subject Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Subject}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <!--  Subject Entry  -->
                        <inputLayout:SfTextInputLayout
                            ContainerBackground="White"
                            ContainerType="Outlined"
                            Hint="{x:Static ResourceManager:AppResources.Enterthesubjectofthetransaction}"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="15"
                            Stroke="{StaticResource NeutralGreay}">
                            <custom:GAZTBorderlessEntry
                                Keyboard="Text"
                                Placeholder="{x:Static ResourceManager:AppResources.Enterthesubjectofthetransaction}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding Subject}"
                                TextColor="#58595B" />
                        </inputLayout:SfTextInputLayout>

                    </StackLayout>
                    <!--#endregion-->

                    <!--#region description Field-->
                    <StackLayout Spacing="0">

                        <!--  description Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Transactiondescription}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!--  description Entry  -->
                        <inputLayout:SfTextInputLayout
                            ContainerBackground="White"
                            ContainerType="Outlined"
                            Hint="{x:Static ResourceManager:AppResources.Transactiondescription}"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="15"
                            Stroke="{StaticResource NeutralGreay}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEditor
                                x:Name="reportReportDetailsEntry"
                                AutoSize="TextChanges"
                                HeightRequest="100"
                                HorizontalOptions="FillAndExpand"
                                IsSpellCheckEnabled="True"
                                IsTextPredictionEnabled="False"
                                MaxLength="1000"
                                MinimumHeightRequest="100"
                                Style="{StaticResource BodyLabelBlack}"
                                Text="{Binding Description}" />
                        </inputLayout:SfTextInputLayout>
                    </StackLayout>
                    <!--#endregion-->

                    <!--#region Upload File-->

                    <!--  Uploaded file Field  -->
                    <StackLayout Spacing="0">

                        <!--  Uploaded files Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Attachments}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Addattachments}"
                                    Style="{StaticResource DefaultEntry}"
                                    TextColor="#58595B">

                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding UploadFileCommand}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>

                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>

                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Aspect="AspectFit" Source="newui_ic_pdf" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                        </custom:CustomSfTextInputView>
                        <!--  Uploaded files Entry  -->

                        <Label
                            Margin="0,-15,0,10"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.PDFFileHint}" />

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UploadFileCommand}" />
                        </StackLayout.GestureRecognizers>

                    </StackLayout>

                    <!--  PDfUploaded List  -->
                    <StackLayout Spacing="0">
                        <!--  Files List  -->
                        <StackLayout
                            x:Name="filesLst"
                            BindableLayout.ItemsSource="{Binding TransactionUploadedFiles}"
                            Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout x:Name="Item">

                                        <!--  PDfUploaded Entry  -->
                                        <inputLayout:SfTextInputLayout
                                            ContainerBackground="White"
                                            ContainerType="Outlined"
                                            InputViewPadding="16,0,16,0"
                                            IsHintAlwaysFloated="True"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="15"
                                            Stroke="{StaticResource NeutralGreay}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                InputTransparent="True"
                                                IsReadOnly="True"
                                                Keyboard="Text"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding fileFullName}"
                                                TextColor="#58595B" />
                                            <inputLayout:SfTextInputLayout.LeadingView>
                                                <Image Aspect="AspectFit" Source="Generic_attachment_icon" />
                                            </inputLayout:SfTextInputLayout.LeadingView>

                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image Aspect="AspectFit" Source="reportClose.png">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"
                                                            Command="{Binding DeleteAttatchementCommand}"
                                                            CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </inputLayout:SfTextInputLayout.TrailingView>

                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>

                    </StackLayout>
                    <!--#endregion-->

                    <!--  Send Button  -->
                    <buttons:SfButton
                        Margin="0,40"
                        Background="#0996D4"
                        Command="{Binding SendTransactionCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.Send}" />
                </StackLayout>
            </ScrollView>


        </Grid>

    </newdesign:BaseContentPage.PancakeView>

</newdesign:BaseContentPage>

