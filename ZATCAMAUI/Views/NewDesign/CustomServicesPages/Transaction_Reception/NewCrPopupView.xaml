<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.Transaction_Reception.NewCrPopupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    FlowDirection="{Binding AppDirection}">


    <Mopups:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <Border
            Grid.Row="0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">
            <StackLayout>
                <Image
                    HeightRequest="22"
                    HorizontalOptions="EndAndExpand"
                    Source="CloseIcon"
                    WidthRequest="22">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DisplayAddNewCRViewCommand}" CommandParameter="false" />

                    </Image.GestureRecognizers>

                </Image>
                <!--#region New CR Field-->
                <StackLayout Spacing="0">
                    <!--  New CR Label  -->
                    <Label Style="{StaticResource CaptionLabelGrey}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.AddNewCRTitle}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <!--  New CR  Entry  -->
                    <inputLayout:SfTextInputLayout
                        ContainerBackground="White"
                        ContainerType="Outlined"
                        InputViewPadding="16,0,16,0"
                        IsHintAlwaysFloated="True"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="15"
                        Stroke="{StaticResource NeutralGreay}">
                        <custom:GAZTBorderlessEntry
                            Keyboard="Text"
                            MaxLength="10"
                            Placeholder="{x:Static ResourceManager:AppResources.AddNewCRTitle}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding CRNo}"
                            TextColor="#58595B" />
                    </inputLayout:SfTextInputLayout>

                </StackLayout>
                <!--#endregion-->
                <!--  Add Button  -->
                <buttons:SfButton
                    Margin="0,40"
                    Background="#0996D4"
                    Command="{Binding AddNewCRCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.Add}" />
            </StackLayout>

        </Border>


    </Grid>
</Mopups:PopupPage>



