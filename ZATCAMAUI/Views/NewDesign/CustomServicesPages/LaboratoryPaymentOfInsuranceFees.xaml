<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.LaboratoryPaymentOfInsuranceFees"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="TraiffPage"
    ios:Page.UseSafeArea="true"
    NavigationPage.HasNavigationBar="False"
    TitleText="{Binding TitleText}">
    <newdesign:BaseContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

        </ResourceDictionary>
    </newdesign:BaseContentPage.Resources>

    <newdesign:BaseContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding LoadPortsCommand}" EventName="Appearing" />
    </newdesign:BaseContentPage.Behaviors>

    <newdesign:BaseContentPage.PancakeView>
        <Grid RowDefinitions="*">

            <Grid Padding="15,20">

                <Grid.Resources>
                    <ResourceDictionary>
                        <Style x:Key="titleLabel" TargetType="Label">
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                        </Style>
                        <Style TargetType="Label">
                            <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                        </Style>
                    </ResourceDictionary>
                </Grid.Resources>

                <StackLayout IsVisible="{Binding IsMainView}">

                    <Border
                        Padding="0"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="FillAndExpand">

                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">


                            <ScrollView VerticalScrollBarVisibility="Never">
                                <StackLayout Spacing="10">

                                    <Label Style="{x:StaticResource titleLabel}" Text="{x:Static ResourceManager:AppResources.InquireaboutPaymentofInsuranceTitle}" />

                                    <Label
                                        FontSize="16"
                                        Text="{x:Static ResourceManager:AppResources.SelectTheOptionAndCompleteDetails}"
                                        TextColor="#999999" />

                                    <BoxView HeightRequest="1" Color="#EBEBEB" />

                                    <Frame
                                        Padding="5"
                                        BackgroundColor="#0996D4"
                                        BorderColor="#0996D4"
                                        HasShadow="False"
                                        Opacity=".5">
                                        <Label
                                            FontSize="14"
                                            Text="{x:Static ResourceManager:AppResources.RequestInformation}"
                                            TextColor="White" />
                                    </Frame>

                                    <StackLayout>

                                        <Label Style="{StaticResource CaptionLabelGrey}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.Port}" />
                                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <inputLayout:SfTextInputLayout
                                            ContainerType="Outlined"
                                            Hint="{x:Static ResourceManager:AppResources.Port}"
                                            HorizontalOptions="FillAndExpand"
                                            InputViewPadding="16,0,16,0"
                                            OutlineCornerRadius="14"
                                            Stroke="{StaticResource NeutralGreay}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                IsReadOnly="True"
                                                Placeholder="{x:Static ResourceManager:AppResources.Port}"
                                                Style="{StaticResource DefaultEntryWithoutHeigh}"
                                                Text="{Binding SelectedPort.Name}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalTextAlignment="Center" />

                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image HorizontalOptions="EndAndExpand" Source="arrowDropdown.png" />
                                            </inputLayout:SfTextInputLayout.TrailingView>

                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenPortsCommand}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                        </inputLayout:SfTextInputLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenPortsCommand}" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>

                                    <StackLayout>

                                        <Label Style="{StaticResource CaptionLabelGrey}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.RequestNumber}" />
                                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />

                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <inputLayout:SfTextInputLayout
                                            ContainerType="Outlined"
                                            Hint="{x:Static ResourceManager:AppResources.RequestNumber}"
                                            InputViewPadding="16,0,16,0"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="14"
                                            Stroke="{StaticResource NeutralGreay}">
                                            <custom:GAZTBorderlessEntry
                                                Keyboard="Numeric"
                                                MaxLength="10"
                                                Placeholder="{x:Static ResourceManager:AppResources.RequestNumber}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding RequestNumber}"
                                                VerticalTextAlignment="Center">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behavior:OnlyNumericValuesBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>

                                    <Label Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.RequestDate}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <StackLayout>
                                        <inputLayout:SfTextInputLayout
                                            ContainerType="Outlined"
                                            Hint="dd/MM/yyyy"
                                            InputViewPadding="16,0,16,0"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="16"
                                            Stroke="{StaticResource NeutralGreay}">
                                            <custom:GAZTBorderlessEntry
                                                IsReadOnly="True"
                                                Placeholder="dd/MM/yyyy"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding HijriDateToBeDisplayed}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalTextAlignment="Center" />

                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image HorizontalOptions="EndAndExpand" Source="calendar.png" />
                                            </inputLayout:SfTextInputLayout.TrailingView>

                                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenHijriPickerCommand}" CommandParameter="{x:Reference dateHijri}" />
                                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                                        </inputLayout:SfTextInputLayout>

                                        <!--  HijriDatePicker  -->
                                        <custom:CustomHijriDatePicker
                                            x:Name="dateHijri"
                                            Background="White"
                                            HorizontalOptions="FillAndExpand"
                                            IsOpen="False"
                                            ItemHeight="40"
                                            Mode="Dialog"
                                            SelectedItem="{Binding TodayDateinHijri}">

                                            <custom:CustomHijriDatePicker.SelectionView>
                                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                            </custom:CustomHijriDatePicker.SelectionView>

                                            <custom:CustomHijriDatePicker.ColumnHeaderView>
                                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                                            </custom:CustomHijriDatePicker.ColumnHeaderView>

                                            <custom:CustomHijriDatePicker.HeaderView>

                                                <syncfusion:PickerHeaderView
                                                    Height="46"
                                                    Background="{StaticResource NeutralBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.RequestDate}">

                                                    <syncfusion:PickerHeaderView.TextStyle>
                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                    </syncfusion:PickerHeaderView.TextStyle>
                                                </syncfusion:PickerHeaderView>


                                            </custom:CustomHijriDatePicker.HeaderView>


                                            <custom:CustomHijriDatePicker.SelectedTextStyle>
                                                <syncfusion:PickerTextStyle TextColor="White" />
                                            </custom:CustomHijriDatePicker.SelectedTextStyle>

                                            <custom:CustomHijriDatePicker.FooterView>

                                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                                    <syncfusion:PickerFooterView.TextStyle>
                                                        <syncfusion:PickerTextStyle TextColor="White" />
                                                    </syncfusion:PickerFooterView.TextStyle>

                                                </syncfusion:PickerFooterView>

                                            </custom:CustomHijriDatePicker.FooterView>


                                            <custom:CustomHijriDatePicker.Behaviors>
                                                <xct:EventToCommandBehavior Command="{Binding SelectedRequestDateCommand}" EventName="SelectionChanged" />
                                            </custom:CustomHijriDatePicker.Behaviors>

                                        </custom:CustomHijriDatePicker>
                                        <!--  HijriDatePicker  -->
                                    </StackLayout>

                                    <Frame
                                        Margin="0,20,0,10"
                                        Padding="12"
                                        BackgroundColor="#0996D4"
                                        CornerRadius="14"
                                        HasShadow="False"
                                        HorizontalOptions="FillAndExpand">

                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding InquireCommand}" />
                                        </Frame.GestureRecognizers>

                                        <Label
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            FontSize="16"
                                            HorizontalOptions="CenterAndExpand"
                                            Text="{x:Static ResourceManager:AppResources.Submit}"
                                            TextColor="White"
                                            VerticalOptions="CenterAndExpand" />
                                    </Frame>

                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.Clear}"
                                        TextColor="#0996D4">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ClearCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                </StackLayout>
                            </ScrollView>

                        </Grid>
                    </Border>

                </StackLayout>

                <StackLayout IsVisible="{Binding IsDetailsView}">

                    <Border
                        Padding="0"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Frame
                                Padding="17,32,17,32"
                                BorderColor="#B8BABA"
                                CornerRadius="14"
                                HasShadow="False"
                                VerticalOptions="StartAndExpand">
                                <Label
                                    FontSize="16"
                                    Text="{Binding InsuranceCheckList.data}"
                                    TextColor="#002447" />
                            </Frame>

                        </Grid>
                    </Border>

                </StackLayout>



            </Grid>

            <custom:PickerWithSearch Grid.RowSpan="2" IsVisible="{Binding IsPortsPickerSearch}" />

        </Grid>


    </newdesign:BaseContentPage.PancakeView>

</newdesign:BaseContentPage>
