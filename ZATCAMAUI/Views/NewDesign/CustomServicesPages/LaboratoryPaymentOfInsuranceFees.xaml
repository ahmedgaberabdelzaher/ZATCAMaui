<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.LaboratoryPaymentOfInsuranceFees"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    x:Name="TraiffPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding LoadPortsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="titleLabel" TargetType="Label">
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                    <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                </Style>
                <Style TargetType="Label">
                    <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <StackLayout IsVisible="{Binding IsMainView}">
            <StackLayout Padding="15,5,15,5" Orientation="Horizontal">


                <Image
                    x:Name="Image_BacKIcon"
                    Grid.Row="0"
                    Grid.Column="0"
                    HeightRequest="25"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Rotation="180"
                    Source="GrayBackButton"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsArabicLang}"
                            TargetType="Image"
                            Value="False">
                            <Setter Property="Rotation" Value="0" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.InquireaboutPaymentofInsuranceTitle}" />

            </StackLayout>
            <yummy:PancakeView
                Padding="0"
                CornerRadius="14,14,0,0"
                VerticalOptions="FillAndExpand">
                <Grid
                    Margin="0"
                    Padding="0,0,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">


                    <ScrollView VerticalScrollBarVisibility="Never">
                        <StackLayout Margin="24,34,21,5">
                            <Label
                                Margin="0,34,0,5"
                                Style="{x:StaticResource titleLabel}"
                                Text="{x:Static ResourceManager:AppResources.InquireaboutPaymentofInsuranceTitle}" />
                            <Label
                                FontSize="16"
                                Text="{x:Static ResourceManager:AppResources.SelectTheOptionAndCompleteDetails}"
                                TextColor="#999999" />
                            <BoxView HeightRequest="1" Color="#EBEBEB" />
                            <Frame
                                Padding="5"
                                BackgroundColor="#0996D4"
                                BorderColor="#0996D4"
                                HasShadow="False"
                                Opacity=".5">
                                <Label
                                    FontSize="14"
                                    Text="{x:Static ResourceManager:AppResources.RequestInformation}"
                                    TextColor="White" />
                            </Frame>
                            <StackLayout Margin="0,9,0,0">
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Port}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>

                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        HorizontalOptions="FillAndExpand"
                                        InputViewPadding="8,0,8,0"
                                         IsHintAlwaysFloated="True"
                                        OutlineCornerRadius="14"
                                        Style="{StaticResource InputTableTextInputLayoutStyleWuthoutHeighandWidth}"
                                        VerticalOptions="FillAndExpand">
                                        <Grid>
                                            <StackLayout Orientation="Horizontal">

                                                <custom:GAZTBorderlessEntry
                                                    IsReadOnly="True"
                                                    Placeholder="{x:Static ResourceManager:AppResources.Port}"
                                                    Style="{StaticResource DefaultEntryWithoutHeigh}"
                                                    Text="{Binding SelectedPort.Name}"
                                                    TextColor="{StaticResource NeutralBlack}"
                                                    VerticalTextAlignment="Center" />
                                                <Image HorizontalOptions="EndAndExpand" Source="arrowDropdown.png" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenPortsCommand}" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Grid>
                                    </inputLayout:SfTextInputLayout>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenPortsCommand}" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </StackLayout>

                            <StackLayout Margin="0,9,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.RequestNumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />

                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                     IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        Placeholder="{x:Static ResourceManager:AppResources.RequestNumber}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding RequestNumber}"
                                        VerticalTextAlignment="Center">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behavior:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <custom:CustomLabel Margin="0,5,0,0" Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.RequestDate}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <Grid>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                     IsHintAlwaysFloated="True"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:GAZTBorderlessEntry
                                        IsReadOnly="True"
                                        Placeholder="yyyy/MM/dd"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding HijriDateToBeDisplayed}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalTextAlignment="Center" />
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image HorizontalOptions="EndAndExpand" Source="calendar.png" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenHijriPickerCommand}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>

                                </inputLayout:SfTextInputLayout>

                                <!--  HijriDatePicker  -->
                                <custom:CustomHijriDatePicker
                                    Margin="10,0,10,0"
                                    Background="White"
                                    FlowDirection="RightToLeft"
                                    HorizontalOptions="FillAndExpand"
                                    IsOpen="{Binding IsOpenHijriPicker}"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectedItem="{Binding TodayDateinHijri}">

                                     <custom:CustomHijriDatePicker.SelectionView >
                                            <syncfusion:PickerSelectionView  Background="{StaticResource Secondary}" />
                                     </custom:CustomHijriDatePicker.SelectionView>

                                    <custom:CustomHijriDatePicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="46"
                                            Background="#EAF7CC"
                                            Text="{x:Static ResourceManager:AppResources.RequestDate}" />

                                    </custom:CustomHijriDatePicker.HeaderView>


                                    <custom:CustomHijriDatePicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomHijriDatePicker.SelectedTextStyle>

                                    <custom:CustomHijriDatePicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </custom:CustomHijriDatePicker.FooterView>


                                    <custom:CustomHijriDatePicker.Behaviors>
                                        <xct:EventToCommandBehavior Command="{Binding SelectedRequestDateCommand}" EventName="SelectionChanged" />
                                    </custom:CustomHijriDatePicker.Behaviors>
                                </custom:CustomHijriDatePicker>
                                <!--  HijriDatePicker  -->
                            </Grid>

                            <Frame
                                Margin="0,20,0,10"
                                Padding="12"
                                BackgroundColor="#0996D4"
                                CornerRadius="14"
                                HasShadow="False"
                                HorizontalOptions="FillAndExpand">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding InquireCommand}" />
                                </Frame.GestureRecognizers>
                                <Label
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Submit}"
                                    TextColor="White"
                                    VerticalOptions="CenterAndExpand" />
                            </Frame>
                            <Label
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Clear}"
                                TextColor="#0996D4">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </StackLayout>
                    </ScrollView>

                </Grid>
            </yummy:PancakeView>

        </StackLayout>
        <StackLayout IsVisible="{Binding IsDetailsView}">
            <StackLayout Padding="15,5,15,5" Orientation="Horizontal">


                <Image
                    Grid.Row="0"
                    Grid.Column="0"
                    HeightRequest="25"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Rotation="180"
                    Source="GrayBackButton"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsArabicLang}"
                            TargetType="Image"
                            Value="False">
                            <Setter Property="Rotation" Value="0" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    MaxLines="1"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.InquiryResult}" />

            </StackLayout>
            <yummy:PancakeView
                Padding="0"
                CornerRadius="14,14,0,0"
                VerticalOptions="FillAndExpand">
                <Grid
                    Margin="0"
                    Padding="0,0,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Frame
                        Margin="24,55,24,0"
                        Padding="17,32,17,32"
                        BorderColor="#B8BABA"
                        CornerRadius="14"
                        HasShadow="False"
                        VerticalOptions="StartAndExpand">
                        <Label
                            FontSize="16"
                            Text="{Binding InsuranceCheckList.data}"
                            TextColor="#002447" />
                    </Frame>

                </Grid>
            </yummy:PancakeView>

        </StackLayout>
        <custom:PickerWithSearch IsVisible="{Binding IsPortsPickerSearch}" />
        <custom:MsgView
            Grid.Row="0"
            Margin="0,0,0,0"
            IsVisible="{Binding IsShowMsgView}"
            VerticalOptions="FillAndExpand" />

        <custom:Loader IsVisible="{Binding IsLoading}" />


    </Grid>
</ContentPage>
