<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.CustomFees.CustomFeesFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    xmlns:numericinput="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:view="clr-namespace:ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews"
    HasBackButton="True"
    FlowDirection="{Binding AppDirection}"
    TitleText="{x:Static ResourceManager:AppResources.CustomFeesCalculator}">

    <newdesign:BaseContentPage.PancakeView>

        <Grid>
            <ScrollView
                Grid.Row="0"
                Margin="0,0,0,30"
                VerticalScrollBarVisibility="Never">

                <ScrollView.Triggers>
                    <DataTrigger
                        Binding="{Binding IsshowFeesView}"
                        TargetType="ScrollView"
                        Value="true">
                        <Setter Property="IsVisible" Value="false" />

                    </DataTrigger>
                </ScrollView.Triggers>

                <StackLayout VerticalOptions="Start">


                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="16"
                        Text="{x:Static ResourceManager:AppResources.CustomFeesCalculator}"
                        TextColor="#14395B" />

                    <!--#region Hint view-->
                    <Frame
                        Padding="10"
                        BorderColor="#E6E6E6"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="StartAndExpand">
                        <StackLayout
                            HorizontalOptions="StartAndExpand"
                            Spacing="10"
                            VerticalOptions="FillAndExpand">
                            <Grid ColumnDefinitions="auto,auto" RowDefinitions="auto,auto">
                                <!--  info icon  -->
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="20"
                                    HorizontalOptions="CenterAndExpand"
                                    Source="information.png"
                                    VerticalOptions="StartAndExpand"
                                    WidthRequest="20" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Disclaimer}"
                                    TextColor="#14395B" />
                                <!--  Question Hint Label  -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight=".8"
                                    Text="{x:Static ResourceManager:AppResources.FeesCalcDisclaimerTXt}"
                                    TextColor="Gray" />
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <!--#endregion-->

                    <!--#region Material Selection-->

                    <!--  TypeItem Field  -->
                    <StackLayout Spacing="0">

                        <!--  TypeItem Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.Thetypeofmerchandise}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!--  TypeItem Entry  -->
                        <inputLayout:SfTextInputLayout
                            ContainerBackground="White"
                            ContainerType="Outlined"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                             IsHintAlwaysFloated="True"
                            OutlineCornerRadius="15"
                            Stroke="{StaticResource NeutralGreay}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                InputTransparent="True"
                                IsReadOnly="True"
                                Keyboard="Text"
                                Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding SelectedCalcTypeName}"
                                TextColor="#58595B">
                                <custom:GAZTBorderlessEntry.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                                </custom:GAZTBorderlessEntry.GestureRecognizers>
                            </custom:GAZTBorderlessEntry>
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                        </StackLayout.GestureRecognizers>

                    </StackLayout>

                    <!--#endregion-->

                    <!--#region TProductView-->
                    <StackLayout IsVisible="false" VerticalOptions="StartAndExpand">
                        <StackLayout.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedCalcType}"
                                TargetType="StackLayout"
                                Value="2">
                                <Setter Property="IsVisible" Value="true" />
                            </DataTrigger>

                        </StackLayout.Triggers>

                        <!--  ProductName Field  -->
                        <StackLayout IsVisible="{Binding IsProductItemHaveSubType}" Spacing="0">

                            <!--  ProductName Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Selecttheitem}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  ProductName Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                 IsHintAlwaysFloated="True"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedProductSubTypes.Name}"
                                    TextColor="#58595B">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  Quantity Field  -->
                        <StackLayout IsVisible="false" Spacing="0">

                            <!--  Quantity Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Quantity}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Quantity Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                FlowDirection="LeftToRight"
                                HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                 IsHintAlwaysFloated="True"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                <numericinput:SfNumericEntry
                                    CustomFormat="n"
                                    FlowDirection="LeftToRight"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HeightRequest="48"
                                    HorizontalOptions="Fill"
                                    Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    TextColor="#58595B"
                                    WidthRequest="150"
                                    Value="{Binding Quantity}" />

                            </inputLayout:SfTextInputLayout>

                        </StackLayout>
                        <!--#region units View-->

                        <!--  unit Label  -->
                        <StackLayout IsVisible="false">
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.units}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                 IsHintAlwaysFloated="True"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">

                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedUnit.Name}"
                                    TextColor="#58595B">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <!--#endregion-->

                        <!--  Total Value Field  -->
                        <StackLayout Spacing="0">

                            <!--  Total Value Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Productvalue}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Total Value Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackground="White"
                                ContainerType="Outlined"
                                 IsHintAlwaysFloated="True"
                                FlowDirection="LeftToRight"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                Stroke="{StaticResource NeutralGreay}">

                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>

                                <StackLayout FlowDirection="LeftToRight" Orientation="Horizontal">

                                    <numericinput:SfNumericEntry
                                        CustomFormat="n"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        Placeholder="{x:Static ResourceManager:AppResources.Productvalue}"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        TextColor="#58595B"
                                        WidthRequest="180"
                                        Value="{Binding TotalValue}" />


                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.FORM5SAR}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>

                            </inputLayout:SfTextInputLayout>

                            <Label
                                Margin="3,-10,3,0"
                                FontSize="12"
                                Text="{x:Static ResourceManager:AppResources.ProductValueHint}"
                                TextColor="#58595B" />

                        </StackLayout>

                    </StackLayout>
                    <!--#endregion-->

                    <!--#region TobacoView-->
                    <view:TobacoView IsVisible="false">
                        <view:TobacoView.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedCalcType}"
                                TargetType="view:TobacoView"
                                Value="1">
                                <Setter Property="IsVisible" Value="true" />
                            </DataTrigger>

                        </view:TobacoView.Triggers>

                    </view:TobacoView>
                    <!--#region-->

                    <Frame
                        Margin="0,40,0,0"
                        Padding="10"
                        BackgroundColor="#0996D4"
                        CornerRadius="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CalculateCommand}" />
                        </Frame.GestureRecognizers>
                        <Label
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.Calculate}"
                            TextColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CalculateCommand}" />
                            </Label.GestureRecognizers>

                        </Label>
                    </Frame>

                </StackLayout>
            </ScrollView>

            <Grid Grid.Row="0" IsVisible="{Binding IsshowFeesView}">

                <StackLayout VerticalOptions="Start">

                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="16"
                        Text="{x:Static ResourceManager:AppResources.CustomsFeesValue}"
                        TextColor="#14395B" />

                    <!--  Horizontal Line  -->
                    <BoxView
                        Grid.Column="7"
                        BackgroundColor="#EBEBEB"
                        HeightRequest="1"
                        WidthRequest="20" />

                    <!--#region Fees Details-->

                    <!--  Fees Details frame  -->
                    <ScrollView Margin="0,0,0,30" VerticalScrollBarVisibility="Never">
                        <Frame
                            Padding="10"
                            BorderColor="#E6E6E6"
                            CornerRadius="10"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <StackLayout>

                                <Label
                                    Margin="20"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="16"
                                    Text="{Binding SelectedCalcTypeName}"
                                    TextColor="#14395B" />

                                <BoxView
                                    Grid.Column="7"
                                    BackgroundColor="#EBEBEB"
                                    HeightRequest="1"
                                    WidthRequest="20" />

                                <Grid
                                    Margin="16"
                                    ColumnDefinitions="*,*"
                                    RowDefinitions="auto,auto,auto,auto,auto">

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">

                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Productvalue}" />

                                        <Label Style="{StaticResource BodyLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ProductValue, StringFormat='{0:n}'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>

                                        </Label>
                                        <BoxView
                                            BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="1"
                                            WidthRequest="20" />
                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">

                                        <Label Style="{StaticResource BodyLabelGrey}">

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.CustomsFees}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding CustomFeesPercentage}" />
                                                </FormattedString>
                                            </Label.FormattedText>

                                        </Label>

                                        <!--  CustomsFeesDisclaimer Label  -->
                                        <Label
                                            Margin="0,-10,0,0"
                                            FontSize="12"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.CustomsdeclarationDisclaimer}" />

                                        <Label Style="{StaticResource BodyLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FeesCalculatorResponse.totalDuty, StringFormat='{0:n}'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>

                                        </Label>
                                        <Label
                                            Margin="0,-10,0,0"
                                            FontSize="12"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{Binding CustomFeesCalculate}" />
                                        <BoxView
                                            BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="1"
                                            WidthRequest="20" />
                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">

                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Customsdeclarationissuancefees}" />

                                        <Label Style="{StaticResource BodyLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FeesCalculatorResponse.extraFees, StringFormat='{0:n}'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <BoxView
                                            BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="1"
                                            WidthRequest="20" />
                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        IsVisible="false">

                                        <StackLayout.Triggers>
                                            <DataTrigger
                                                Binding="{Binding SelectedCalcType}"
                                                TargetType="StackLayout"
                                                Value="1">
                                                <Setter Property="IsVisible" Value="true" />
                                            </DataTrigger>

                                        </StackLayout.Triggers>

                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ExciseTax2}" />

                                        <Label Style="{StaticResource BodyLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FeesCalculatorResponse.excise, StringFormat='{0:n}'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label
                                            Margin="0,-10,0,0"
                                            FontSize="12"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{Binding ExiseTaxCaluclat}" />
                                        <BoxView
                                            BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="1"
                                            WidthRequest="20" />
                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">

                                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATCertificates}">

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.VATCertificates}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding VatPercenntage}" />
                                                </FormattedString>
                                            </Label.FormattedText>

                                        </Label>

                                        <!--  VATCertificates Disclamier  -->
                                        <Label
                                            Margin="0,-10,0,0"
                                            FontSize="12"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VATCertificatesDisclaimer}" />

                                        <Label Style="{StaticResource BodyLabelBlack}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FeesCalculatorResponse.vat, StringFormat='{0:n}'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label
                                            Margin="0,-10,0,0"
                                            FontSize="12"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{Binding VatCalculte}" />

                                        <BoxView
                                            BackgroundColor="{StaticResource Primary}"
                                            HeightRequest="1"
                                            WidthRequest="20" />
                                    </StackLayout>
                                </Grid>

                                <Grid Margin="5" VerticalOptions="EndAndExpand">

                                    <Frame
                                        Margin="-16"
                                        BackgroundColor="#0996D4"
                                        CornerRadius="8"
                                        HasShadow="False"
                                        HorizontalOptions="FillAndExpand"
                                        Opacity=".1" />

                                    <StackLayout VerticalOptions="CenterAndExpand">

                                        <StackLayout Orientation="Horizontal">
                                            <Label
                                                FontSize="20"
                                                Text="{x:Static ResourceManager:AppResources.Total2}"
                                                TextColor="#002447" />

                                            <Label HorizontalOptions="EndAndExpand" Style="{StaticResource BodyLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding FeesCalculatorResponse.totalPayment, StringFormat='{0:n}'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>

                                        <!--  Total Disclaimer  -->
                                        <Label
                                            FontSize="12"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.NDTotalDisclaimer}"
                                            TextColor="#002447" />
                                    </StackLayout>

                                </Grid>

                            </StackLayout>

                        </Frame>

                    </ScrollView>


                    <!--#endregion-->

                </StackLayout>

            </Grid>

            <!--  Bottom Sheet List  -->
            <custom:ListBottomSheet Grid.Row="0" IsVisible="{Binding IsShowBottomSheet}" />

        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

