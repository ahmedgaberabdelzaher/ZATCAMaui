<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.CustomServicesPages.CustomFees.CustomFeesFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:newdesign="clr-namespace:ZATCAMAUI.Views.NewDesign"
    xmlns:numericinput="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:view="clr-namespace:ZATCAMAUI.Views.NewDesign.EDeclaration.QuestionsViews"
    FlowDirection="{Binding AppDirection}"
    HasBackButton="True"
    TitleText="{x:Static ResourceManager:AppResources.CustomFeesCalculator}">

    <newdesign:BaseContentPage.PancakeView>

        <Grid Padding="15,20">

            <ScrollView VerticalScrollBarVisibility="Never">

                <ScrollView.Triggers>
                    <DataTrigger
                        Binding="{Binding IsshowFeesView}"
                        TargetType="ScrollView"
                        Value="true">
                        <Setter Property="IsVisible" Value="false" />

                    </DataTrigger>
                </ScrollView.Triggers>

                <StackLayout VerticalOptions="FillAndExpand">


                    <Label
                        Margin="0,10"
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="16"
                        Text="{x:Static ResourceManager:AppResources.CustomFeesCalculator}"
                        TextColor="#14395B" />

                    <!--#region Hint view-->
                    <Border
                        Padding="10"
                        HorizontalOptions="FillAndExpand"
                        Stroke="#E6E6E6"
                        StrokeShape="RoundRectangle 10,10,10,10">

                        <Grid
                            ColumnDefinitions="auto,*"
                            ColumnSpacing="10"
                            RowDefinitions="auto,auto"
                            RowSpacing="10">

                            <!--  info icon  -->
                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                Aspect="AspectFit"
                                HeightRequest="20"
                                HorizontalOptions="CenterAndExpand"
                                Source="information.png"
                                VerticalOptions="Start"
                                WidthRequest="20" />
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="12"
                                HorizontalOptions="Start"
                                Text="{x:Static ResourceManager:AppResources.Disclaimer}"
                                TextColor="#14395B" />
                            <!--  Question Hint Label  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="12"
                                HorizontalOptions="Start"
                                LineBreakMode="WordWrap"
                                LineHeight=".8"
                                Text="{x:Static ResourceManager:AppResources.FeesCalcDisclaimerTXt}"
                                TextColor="Gray" />

                        </Grid>
                    </Border>
                    <!--#endregion-->

                    <!--#region Material Selection-->

                    <!--  TypeItem Field  -->
                    <StackLayout Spacing="0">

                        <!--  TypeItem Label  -->
                        <Label Style="{StaticResource CaptionLabelGrey}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Thetypeofmerchandise}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!--  TypeItem Entry  -->
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedCalcTypeName}"
                                    TextColor="#58595B">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>

                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>

                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>

                        </custom:CustomSfTextInputView>

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                        </StackLayout.GestureRecognizers>

                    </StackLayout>

                    <!--#endregion-->

                    <!--#region ProductView-->
                    <StackLayout IsVisible="false" VerticalOptions="StartAndExpand">
                        <StackLayout.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedCalcType}"
                                TargetType="StackLayout"
                                Value="2">
                                <Setter Property="IsVisible" Value="true" />
                            </DataTrigger>

                        </StackLayout.Triggers>

                        <!--  ProductName Field  -->
                        <StackLayout IsVisible="{Binding IsProductItemHaveSubType}" Spacing="0">

                            <!--  ProductName Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Selecttheitem}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  ProductName Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SelectedProductSubTypes.Name}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  Quantity Field  -->
                        <StackLayout IsVisible="false" Spacing="0">

                            <!--  Quantity Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Quantity}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Quantity Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <numericinput:SfNumericEntry
                                        BackgroundColor="Transparent"
                                        CustomFormat="n"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        ShowBorder="False"
                                        TextColor="#58595B"
                                        VerticalOptions="FillAndExpand"
                                        WidthRequest="150"
                                        Value="{Binding Quantity}" />

                                </custom:CustomSfTextInputView.TextInputView>

                            </custom:CustomSfTextInputView>

                            <Label
                                Margin="0,-15,0,10"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.NumberHint}" />

                        </StackLayout>
                        <!--#region units View-->

                        <!--  unit Label  -->
                        <StackLayout IsVisible="false">
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.units}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SelectedUnit.Name}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </custom:CustomSfTextInputView>


                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <!--#endregion-->

                        <!--  Total Value Field  -->
                        <StackLayout Spacing="0">

                            <!--  Total Value Label  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.Productvalue}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!--  Total Value Entry  -->
                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <numericinput:SfNumericEntry
                                        BackgroundColor="Transparent"
                                        CustomFormat="n"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        Placeholder="{x:Static ResourceManager:AppResources.Productvalue}"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        ShowBorder="False"
                                        TextColor="#58595B"
                                        VerticalOptions="FillAndExpand"
                                        Value="{Binding TotalValue}" />

                                </custom:CustomSfTextInputView.TextInputView>

                                <inputLayout:SfTextInputLayout.HelperLabelStyle>
                                    <inputLayout:LabelStyle TextColor="#58595B" />
                                </inputLayout:SfTextInputLayout.HelperLabelStyle>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.FORM5SAR}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                            </custom:CustomSfTextInputView>

                            <Label
                                Margin="0,-15,0,10"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ProductValueHint}" />

                        </StackLayout>

                    </StackLayout>
                    <!--#endregion-->

                    <!--#region TobacoView-->
                    <view:TobacoView IsVisible="false">
                        <view:TobacoView.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedCalcType}"
                                TargetType="view:TobacoView"
                                Value="1">
                                <Setter Property="IsVisible" Value="true" />
                            </DataTrigger>

                        </view:TobacoView.Triggers>

                    </view:TobacoView>
                    <!--#region-->

                    <Border
                        Margin="0,40,0,0"
                        Padding="10"
                        BackgroundColor="#0996D4"
                        StrokeShape="RoundRectangle 14,14,14,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CalculateCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.Calculate}"
                            TextColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CalculateCommand}" />
                            </Label.GestureRecognizers>

                        </Label>
                    </Border>

                </StackLayout>
            </ScrollView>

            <Grid Grid.Row="0" IsVisible="{Binding IsshowFeesView}">

                <Grid RowDefinitions="auto,*" RowSpacing="10">

                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="16"
                        Text="{x:Static ResourceManager:AppResources.CustomsFeesValue}"
                        TextColor="#14395B" />

                    <!--#region Fees Details-->

                    <!--  Fees Details frame  -->
                    <ScrollView
                        Grid.Row="1"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">

                        <Border
                            Padding="15,10"
                            HorizontalOptions="FillAndExpand"
                            Stroke="#E6E6E6"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            VerticalOptions="StartAndExpand">

                            <StackLayout Spacing="10">

                                <Label
                                    Margin="0"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="16"
                                    Text="{Binding SelectedCalcTypeName}"
                                    TextColor="#14395B" />

                                <BoxView BackgroundColor="#EBEBEB" HeightRequest="1" />

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.Productvalue}" />

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelBlack}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding ProductValue, StringFormat='{0:n}'}" />
                                            <Span Text=" " />
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                                <BoxView BackgroundColor="{StaticResource Primary}" HeightRequest="1" />

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}">

                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.CustomsFees}" />
                                            <Span Text=" " />
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding CustomFeesPercentage}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                                <!--  CustomsFeesDisclaimer Label  -->
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.CustomsdeclarationDisclaimer}" />

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelBlack}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding FeesCalculatorResponse.totalDuty, StringFormat='{0:n}'}" />
                                            <Span Text=" " />
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{Binding CustomFeesCalculate}" />

                                <BoxView BackgroundColor="{StaticResource Primary}" HeightRequest="1" />

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.Customsdeclarationissuancefees}" />

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelBlack}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding FeesCalculatorResponse.extraFees, StringFormat='{0:n}'}" />
                                            <Span Text=" " />
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <BoxView BackgroundColor="{StaticResource Primary}" HeightRequest="1" />

                                <StackLayout IsVisible="False">

                                    <StackLayout.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedCalcType}"
                                            TargetType="StackLayout"
                                            Value="1">
                                            <Setter Property="IsVisible" Value="true" />
                                        </DataTrigger>

                                    </StackLayout.Triggers>

                                    <Label
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ExciseTax2}" />

                                    <Label
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource BodyLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding FeesCalculatorResponse.excise, StringFormat='{0:n}'}" />
                                                <Span Text=" " />
                                                <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label
                                        FontSize="12"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{Binding ExiseTaxCaluclat}" />

                                    <BoxView BackgroundColor="{StaticResource Primary}" HeightRequest="1" />

                                </StackLayout>

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATCertificates}">

                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATCertificates}" />
                                            <Span Text=" " />
                                            <Span Style="{StaticResource BodyLabelGrey}" Text="{Binding VatPercenntage}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                                </Label>

                                <!--  VATCertificates Disclamier  -->
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATCertificatesDisclaimer}" />

                                <Label
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelBlack}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding FeesCalculatorResponse.vat, StringFormat='{0:n}'}" />
                                            <Span Text=" " />
                                            <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{Binding VatCalculte}" />

                                <BoxView BackgroundColor="{StaticResource Primary}" HeightRequest="1" />

                                <Grid Margin="0">

                                    <Border
                                        Margin="-16"
                                        BackgroundColor="#0996D4"
                                        HorizontalOptions="FillAndExpand"
                                        Opacity=".1"
                                        StrokeShape="RoundRectangle 8,8,8,8" />

                                    <StackLayout VerticalOptions="CenterAndExpand">

                                        <StackLayout Orientation="Horizontal">
                                            <Label
                                                FontSize="20"
                                                Text="{x:Static ResourceManager:AppResources.Total2}"
                                                TextColor="#002447" />

                                            <Label HorizontalOptions="EndAndExpand" Style="{StaticResource BodyLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource BodyLabelBlack}" Text="{Binding FeesCalculatorResponse.totalPayment, StringFormat='{0:n}'}" />
                                                        <Span Text=" " />
                                                        <Span Style="{StaticResource BodyLabelBlack}" Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>

                                        <!--  Total Disclaimer  -->
                                        <Label
                                            FontSize="12"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.NDTotalDisclaimer}"
                                            TextColor="#002447" />
                                    </StackLayout>

                                </Grid>

                            </StackLayout>

                        </Border>

                    </ScrollView>


                    <!--#endregion-->

                </Grid>

            </Grid>

        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

