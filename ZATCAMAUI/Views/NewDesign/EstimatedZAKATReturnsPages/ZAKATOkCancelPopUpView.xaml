<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstimatedZAKATReturnsPages.ZAKATOkCancelPopUpView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    BackgroundColor="#88000000">
     <Border
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <Grid RowDefinitions="auto,auto">

            <StackLayout Grid.Row="0" Spacing="0">
                 <Label
                    x:Name="confirmationText"
                    Margin="10"
                    Style="{StaticResource BodyLabelBlack}" />
            </StackLayout>
            <HorizontalStackLayout
                Grid.Row="1"
                HorizontalOptions="CenterAndExpand"
                Spacing="5">

                <buttons:SfButton
                     x:Name="Yes"
                    Clicked="OnOkayButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZYes}"
                    WidthRequest="150" />
                <buttons:SfButton
                     x:Name="No"
                    Clicked="OnCancelClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZNo}"
                    VerticalOptions="FillAndExpand"
                    WidthRequest="150" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</Mopups:PopupPage>
