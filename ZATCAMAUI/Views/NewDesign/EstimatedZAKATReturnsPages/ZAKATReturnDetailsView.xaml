<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstimatedZAKATReturnsPages.ZAKATReturnDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:GAZTBehaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    Title="{Binding ZAKATReturnsPagName}"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="HorizontalEnd" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="EndAndExpand" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="SectionTitleBlackTopNegative10" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,-10,0,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <!--  Back Button  -->
                <StackLayout IsVisible="{Binding IsBackBtnVisible}">

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClicked}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding ZAKATReturnsPagName}"
                    VerticalOptions="Center" />



            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="0"
                Style="{StaticResource CommonTopCurves}">

                <Grid x:Name="MainGrid" RowDefinitions="*">

                    <ScrollView x:Name="scrollView" VerticalScrollBarVisibility="Never">

                        <StackLayout Padding="15,20" Spacing="20">

                            <StackLayout Orientation="Horizontal">
                                <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZZZAKAT}" />

                                <buttons:SfButton
                                    Background="{Binding ICRStatusBG}"
                                    CornerRadius="20"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="Start"
                                    ImageSource="{Binding ICRStatusImage}"
                                    ShowIcon="True"
                                    Style="{StaticResource CaptionButtonBlack}"
                                    Text="{Binding ICRStatus}"
                                    TextColor="{Binding ICRStatusTextColor}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />

                            </StackLayout>

                            <!--  Start of Return Details  -->
                            <Border Margin="0" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout
                                        Padding="10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Image
                                            Margin="0"
                                            Source="return_vatRefunds.png"
                                            Style="{StaticResource SmallIcon}" />

                                        <Label
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}"
                                            VerticalOptions="Center" />
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout
                                        Padding="10"
                                        BindingContext="{Binding ZakatReturnDetail}"
                                        Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.FiscalYear}" />
                                            <Label
                                                Style="{StaticResource HorizontalEnd}"
                                                StyleId="ValueLabel"
                                                Text="{Binding Persl}" />
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <Label
                                                HorizontalOptions="End"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.FinancialPeriodFrom}" />
                                            <StackLayout
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Vertical"
                                                Spacing="0"
                                                StyleId="ValueLabel"
                                                WidthRequest="160">
                                                <Label Style="{StaticResource HorizontalEnd}" Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.FromDate}" />
                                                <Label
                                                    Margin="5"
                                                    Style="{StaticResource HorizontalEnd}"
                                                    StyleId="ValueLabel"
                                                    Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.ToDate}" />

                                            </StackLayout>
                                        </StackLayout>
                                        <StackLayout
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZReturnReferenceNumber}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource HorizontalEnd}"
                                                StyleId="ValueLabel"
                                                Text="{Binding Fbnum}"
                                                WidthRequest="120" />
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </Border>

                            <!--  End of Return Details  -->

                            <!--  Start of Zakat Calculation  -->
                            <Border Margin="0" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout
                                        Padding="10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Image Source="zakat_manageTax" Style="{StaticResource SmallIcon}" />

                                        <Label
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.NDZakatCalculation}"
                                            VerticalOptions="Center" />
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout
                                        Padding="10"
                                        BindingContext="{Binding ZakatReturnDetail}"
                                        Spacing="10">
                                        <Grid ColumnDefinitions="40*,45*,15*">
                                            <Label
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZEstimatedSalesForFiscalYear}" />
                                            <Label Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Estsl, StringFormat='{}{0:0.#}'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="EndAndExpand"
                                                Source="ic_vat_info"
                                                Style="{StaticResource SmallIcon}"
                                                VerticalOptions="Start">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEstimatedSalesForTheFiscalYearInfoClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>


                                        </Grid>
                                        <Grid ColumnDefinitions="40*,45*,15*">

                                            <Label
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.Capital}" />
                                            <Label Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Cpamt, StringFormat='{}{0:0.#}'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="EndAndExpand"
                                                Source="ic_vat_info"
                                                Style="{StaticResource SmallIcon}">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCapitalAmountInformationClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </Grid>
                                        <Grid ColumnDefinitions="40*,45*,15*">

                                            <Label
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatBase}" />
                                            <Label Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Zbamt, StringFormat='{}{0:0.#}'}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="EndAndExpand"
                                                Source="ic_vat_info"
                                                Style="{StaticResource SmallIcon}"
                                                VerticalOptions="Start">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnZAKATBaseAmountInfoClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </Grid>
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                            <!--  End of Zakat Calculation  -->

                            <Border
                                Margin="0,0,0,0"
                                Padding="0"
                                HorizontalOptions="FillAndExpand"
                                StrokeShape="RoundRectangle 12,12,12,12"
                                Style="{StaticResource SfStyleForZakatPlanGreen}">
                                <StackLayout
                                    Padding="12"
                                    BindingContext="{Binding ZakatReturnDetail}"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <Label
                                        FontSize="15"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatAmount}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontSize="15"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource SectionTitleBlack}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Zkamt, StringFormat='{}{0:0.#}'}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Image
                                        Grid.Column="2"
                                        HorizontalOptions="EndAndExpand"
                                        Source="ic_vat_info"
                                        Style="{StaticResource SmallIcon}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnZAKATAmountInfoClicked" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                </StackLayout>
                            </Border>

                            <Border
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeThickness="1"
                                Style="{StaticResource GreyBorderFrameWithShadow1}">
                                <StackLayout>

                                    <StackLayout
                                        Padding="10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Image Source="zakat_details" />


                                        <Label
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZSalesDetails}"
                                            VerticalOptions="Center" />

                                        <Label
                                            HorizontalOptions="EndAndExpand"
                                            IsVisible="{Binding IsEditTextVisible}"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.VATDeregistrationEdit}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEditClicked" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>

                                    <BoxView Style="{StaticResource lineSeperator}" />

                                    <StackLayout
                                        Padding="10,10,10,0"
                                        BindingContext="{Binding ZakatReturnDetail}"
                                        Spacing="0">

                                        <Grid
                                            ColumnDefinitions="*,*"
                                            RowDefinitions="auto,auto,auto,auto,auto,auto,auto"
                                            RowSpacing="0">

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZTotalVATSales}" />
                                                <Image
                                                    HorizontalOptions="EndAndExpand"
                                                    Source="ic_vat_info"
                                                    Style="{StaticResource SmallIcon}">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTotalVATSalesInfoClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZInformationfromrelatedparties}" />

                                            <StackLayout
                                                x:Name="TVSA"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackground="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsHintAlwaysFloated="True"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="TotalVATSalesNew"
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslI}">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                                Max="18"
                                                                isNegativeEnable="True"
                                                                numberOfDigitAfterDecimal="2"
                                                                numberOfDigitBeforDecimal="11" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                    Style="{StaticResource SectionTitleBlackTopNegative10}"
                                                    Text="{Binding TvtslI, StringFormat='{}{0:0.#}'}" />

                                            </StackLayout>

                                            <StackLayout
                                                x:Name="TVSNA"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackground="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsHintAlwaysFloated="True"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslI}" />

                                                </inputLayout:SfTextInputLayout>
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                    Style="{StaticResource SectionTitleBlackTopNegative10}"
                                                    Text="{Binding TvtslI, StringFormat='{}{0:0.#}'}" />

                                            </StackLayout>


                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="10,0,10,0"
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZEstimatedSales}" />

                                            <StackLayout
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="0,0,10,0"
                                                HorizontalOptions="EndAndExpand"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackground="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    InputViewPadding="16,0,16,0"
                                                    IsHintAlwaysFloated="True"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext. isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}">
                                                    <custom:GAZTBorderlessEntry
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslE}" />



                                                </inputLayout:SfTextInputLayout>
                                                <Label
                                                    Margin="10,-10,0,0"
                                                    HorizontalOptions="EndAndExpand"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                    Style="{StaticResource SectionTitleBlackTopNegative10}"
                                                    Text="{Binding TvtslE, StringFormat='{}{0:0.#}'}" />
                                            </StackLayout>

                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext. isEditVisible}"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.InformationFromRelatedPartiesNewValue}" />

                                            <StackLayout
                                                x:Name="TotalVATSalesApplicableLayout"
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    x:Name="TotalVATSalesInputLayout"
                                                    Margin="0"
                                                    ContainerBackground="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsHintAlwaysFloated="True"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="TotalVATSales"
                                                        IsReadOnly="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.SetReadOnlyToTotalVATSales}"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslI}">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                                Max="18"
                                                                isNegativeEnable="True"
                                                                numberOfDigitAfterDecimal="2"
                                                                numberOfDigitBeforDecimal="11" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>


                                            </StackLayout>


                                            <StackLayout
                                                x:Name="TotalVATSalesNotApplicableLayout"
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackground="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsHintAlwaysFloated="True"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        IsReadOnly="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.SetReadOnlyToTotalVATSales}"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="0.00">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                                Max="18"
                                                                isNegativeEnable="True"
                                                                numberOfDigitAfterDecimal="2"
                                                                numberOfDigitBeforDecimal="11" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>


                                            </StackLayout>


                                            <Image
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Margin="0,0,0,10"
                                                HorizontalOptions="EndAndExpand"
                                                Source="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.TotalVATSalesEditImageSource}"
                                                Style="{StaticResource SmallIcon}">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTotalVATSaleEditImageClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                            <BoxView
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="-10,5,-10,15"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                Style="{StaticResource lineSeperator}" />

                                        </Grid>
                                        <!--    -->
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            RowDefinitions="auto,auto,auto,auto,auto,auto,auto"
                                            RowSpacing="0">
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZAveragenumberoflabour}" />

                                                <Image
                                                    HorizontalOptions="EndAndExpand"
                                                    Source="ic_vat_info"
                                                    Style="{StaticResource SmallIcon}">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnAverageNumberOfLabourInfoClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZInformationfromrelatedparties}" />

                                            <StackLayout
                                                x:Name="ANOLA"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Spacing="0">

                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackground="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    InputViewPadding="16,0,16,0"
                                                    IsHintAlwaysFloated="True"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext. isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}">
                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="AverageNumberOfLabourNew"
                                                        Focused="AverageNumberOfLabourInputFocused"
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding LabnoI}"
                                                        Unfocused="AverageNumberOfLabourInputUnFocused">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                                Max="14"
                                                                isNegativeEnable="False"
                                                                numberOfDigitAfterDecimal="2"
                                                                numberOfDigitBeforDecimal="11" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>

                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>

                                                <Label
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                    Style="{StaticResource SectionTitleBlackTopNegative10}"
                                                    Text="{Binding LabnoI, StringFormat='{}{0:0.#}'}" />

                                            </StackLayout>

                                            <StackLayout
                                                x:Name="ANOLNA"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Spacing="0">

                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackground="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    InputViewPadding="16,0,16,0"
                                                    IsHintAlwaysFloated="True"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext. isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}">
                                                    <custom:GAZTBorderlessEntry
