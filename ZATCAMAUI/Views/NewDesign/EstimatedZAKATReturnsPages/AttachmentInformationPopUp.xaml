<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstimatedZAKATReturnsPages.AttachmentInformationPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons">
    <Grid
        Grid.RowSpan="2"
        Margin="0"
        VerticalOptions="FillAndExpand">
        <Border
            Margin="0"
            Padding="0"
            Background="White"
            HorizontalOptions="Fill"
            Stroke="{StaticResource NeutralLightGrey}"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="EndAndExpand">

            <StackLayout
                Padding="20,10"
                HorizontalOptions="FillAndExpand"
                Spacing="15"
                VerticalOptions="FillAndExpand">

                <Label
                    x:Name="InfromatationText"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource BodyLabelBlack}"
                    VerticalTextAlignment="Start" />

                <buttons:SfButton
                    x:Name="btnprimary"
                    Clicked="DoneButtonClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                    VerticalOptions="EndAndExpand"
                    WidthRequest="{OnPlatform Android=310,
                                              iOS=380}" />

            </StackLayout>
        </Border>
    </Grid>
</Mopups:PopupPage>
