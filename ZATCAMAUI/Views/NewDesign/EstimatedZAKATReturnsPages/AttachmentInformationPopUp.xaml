<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstimatedZAKATReturnsPages.AttachmentInformationPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}">
    <Grid
        Grid.RowSpan="2"
        Margin="0"
        VerticalOptions="FillAndExpand">
        <Border
           Padding="0"
            Margin="0"
            Stroke="White"
            Background="White"
            HorizontalOptions="Fill"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="EndAndExpand">

            <StackLayout Padding="20,10"
                        Spacing="15"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                <Label
                   x:Name="InfromatationText"
                   HorizontalOptions="Start"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="Start"
                   Style="{StaticResource BodyLabelBlack}" />

                <buttons:SfButton
                    x:Name="btnprimary"
                    Clicked="DoneButtonClicked"
                    WidthRequest="{OnPlatform Android=310,iOS=380}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                    VerticalOptions="EndAndExpand" />

            </StackLayout>
        </Border>
    </Grid>
</pages:PopupPage>
