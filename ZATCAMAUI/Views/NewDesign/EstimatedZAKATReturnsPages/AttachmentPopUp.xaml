<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstimatedZAKATReturnsPages.AttachmentPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Grid RowDefinitions="100*">

        <Border
            Grid.Row="0"
            Padding="0"
            HeightRequest="400"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">
            <StackLayout>
                <ScrollView>
                    <StackLayout
                        Grid.Row="0"
                        Padding="15"
                        Spacing="0">
                        <!--  Start Of Objection Reason  -->
                        <StackLayout>
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDWriteYourObjectionReason}" />
                            <inputLayout:SfTextInputLayout
                                Margin="0"
                                HorizontalOptions="FillAndExpand"
                                IsHintAlwaysFloated="True"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <custom:GAZTBorderlessEntry
                                    x:Name="ObjectionReason"
                                    Focused="OnObjectionReasonFocused"
                                    Style="{StaticResource InputTableEntryLayoutStyle}"
                                    Text="{Binding ObjectionReason}"
                                    Unfocused="OnObjectionReasonUnFocused" />
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                        <!--  End Of Objection Reason  -->

                        <!--  Start of Attachment Visible  -->
                        <StackLayout Spacing="0">
                            <Label
                                Margin="0,20,0,0"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZTERReportDetailAttachment}" />
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZFilesizeshouldnotbemorethan5MB}" />
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZChooseonlyfilewithextensionForZAKAT}" />
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZMaximumnoof5attachmentscanbeuploaded}" />

                            <Border
                                Margin="0"
                                Stroke="{StaticResource DarkGrayTextColor}"
                                StrokeThickness="1"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentInputPlaceholder}" />

                                    <Image HorizontalOptions="EndAndExpand" Rotation="90">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAttachmentClicked" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAttachmentClicked" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </Border>

                            <StackLayout Padding="0,10,0,10" Orientation="Horizontal">
                                <ListView
                                    x:Name="Attachmentlist"
                                    BackgroundColor="White"
                                    HasUnevenRows="True"
                                    HeightRequest="300"
                                    HorizontalOptions="FillAndExpand"
                                    ItemTapped="Attachmentlist_ItemTapped"
                                    ItemsSource="{Binding ZakatReturnAttachmentsList}"
                                    SeparatorVisibility="None"
                                    VerticalOptions="FillAndExpand"
                                    VerticalScrollBarVisibility="Never">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <StackLayout Padding="0,5,0,5" HorizontalOptions="FillAndExpand">

                                                    <Border
                                                        Margin="0"
                                                        Stroke="{StaticResource DarkGrayTextColor}"
                                                        StrokeThickness="1"
                                                        Style="{StaticResource GreyBorderFrameWithShadow}">

                                                        <StackLayout Padding="0,10,0,10" Orientation="Horizontal">
                                                            <Image
                                                                Margin="5"
                                                                HeightRequest="25"
                                                                Source="{Binding FileImage}"
                                                                WidthRequest="25" />

                                                            <Label
                                                                HorizontalOptions="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Filename}" />

                                                            <Image HorizontalOptions="EndAndExpand">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                        Size="25"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDeleteAttachmentClickedTapped" />
                                                                </Image.GestureRecognizers>
                                                            </Image>


                                                        </StackLayout>

                                                    </Border>
                                                </StackLayout>

                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </StackLayout>
                        </StackLayout>

                        <!--  End of Attachment Visible  -->


                    </StackLayout>



                </ScrollView>
                <!--  Footer Section Starts  -->
                <StackLayout
                    Grid.Row="2"
                    Padding="10"
                    BackgroundColor="White">
                    <buttons:SfButton
                        Clicked="OnSaveClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZDone}" />

                </StackLayout>
                <!--  Footer Section Ends  -->

            </StackLayout>

        </Border>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            IsVisible="{Binding IsLoading}">
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                Margin="-30"
                BackgroundColor="Black"
                Opacity="0.5"
                Orientation="Vertical"
                VerticalOptions="FillAndExpand" />
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                Padding="15,15"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"
                Opacity="0.8"
                Orientation="Vertical"
                VerticalOptions="Center">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <busyindicator:SfBusyIndicator
                        x:Name="busyindicatorForLanding"
                        AnimationType="Cupertino"
                        HeightRequest="70"
                        HorizontalOptions="CenterAndExpand"
                        IndicatorColor="{StaticResource Secondary}"
                        IsRunning="True"
                        SizeFactor="0.6"
                        TitlePlacement="Bottom"
                        VerticalOptions="CenterAndExpand"
                        WidthRequest="70" />
                </StackLayout>
            </StackLayout>
        </Grid>

    </Grid>
</Mopups:PopupPage>