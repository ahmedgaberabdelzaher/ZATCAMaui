<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstimatedZAKATReturnsPages.ErrorMessagePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    FlowDirection="{Binding AppDirection}">

    <Border
        Padding="20,20,20,10"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <StackLayout Margin="0,0,0,0" VerticalOptions="Center">

            <Label
                x:Name="InfromatationText"
                HorizontalTextAlignment="Start"
                Style="{StaticResource BodyLabelBlack}" />
            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelBlack}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span FontFamily="{StaticResource Somar-Regular}" Text="{x:Static ResourceManager:AppResources.LinkText}" />

                    </FormattedString>
                </Label.FormattedText>

            </Label>

            <Button
                x:Name="Link"
                BackgroundColor="White"
                Clicked="Link_Clicked"
                HorizontalOptions="StartAndExpand"
                Text="{x:Static ResourceManager:AppResources.Link}"
                TextColor="Blue" />

            <buttons:SfButton
                x:Name="btnprimary"
                Margin="0,0,0,10"
                Clicked="DoneButtonClicked"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                VerticalOptions="CenterAndExpand" />

        </StackLayout>
    </Border>
</Mopups:PopupPage>

