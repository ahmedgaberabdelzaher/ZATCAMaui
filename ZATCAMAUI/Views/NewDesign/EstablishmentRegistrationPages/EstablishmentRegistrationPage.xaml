<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentRegistrationPages.EstablishmentRegistrationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    x:Name="ESTRegistrationPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:EstablishmentTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:EstablishmentFinanicalMethodsToVisibilityConverter x:Key="methodToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <converters:ESTresidentialStatusConverter x:Key="residentialStatusConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Border
                Margin="0"
                Padding="{OnPlatform Android='0',
                                     iOS='0,0,0,30'}"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                StrokeShape="RoundRectangle 15,15,0,0"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ContentPresenter
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </StackLayout>
            </Border>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid ColumnSpacing="0"
              RowDefinitions="auto,*,auto"
              RowSpacing="0">

            <StackLayout
                Grid.Row="1"
                Padding="10,10,10,0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">

                <!--First Step-->
                <Grid
                    x:Name="RegistrationTabMainGrid"
                    RowDefinitions="*"
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}"
                    VerticalOptions="StartAndExpand">

                    <ScrollView
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">

                        <StackLayout
                            x:Name="RegistrationTab"
                            HorizontalOptions="FillAndExpand"
                            Spacing="20"
                            VerticalOptions="FillAndExpand">

                             <Label HorizontalOptions="Start"
                                    Style="{StaticResource forLightLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTReportBranchQuestionLabel}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        InputTransparent="True"
                                        IsReadOnly="True"
                                        Keyboard="Text"
                                        Placeholder="{x:Static ResourceManager:AppResources.ESTReportBranchQuestionLabel}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding SelectedReportingBranch}"
                                        TextColor="#58595B">
                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnReportingBranchSelectButtonClick}"/>
                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                    </custom:GAZTBorderlessEntry>

                                </custom:CustomSfTextInputView.TextInputView>
                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnReportingBranchSelectButtonClick}"
                                                            />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                                <inputLayout:SfTextInputLayout.TrailingView>

                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </custom:CustomSfTextInputView>

                           <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTEntityTypeQuestionLabel}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label
                                Padding="0,10,0,0"
                                HorizontalOptions="Start"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{Binding SelectedEntityType}" />

                            <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTaxpayerTypeQuestionLabel}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label
                                Padding="0,10,0,0"
                                HorizontalOptions="Start"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{Binding SelectedTaxPayerType}" />

                            <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDWhatisYourNationality}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label
                                Padding="0,10,0,0"
                                HorizontalOptions="Start"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{Binding SelectedRegNationalityType}" />

                             <!--  Resident frame  -->
                            <Grid  IsVisible="{Binding IsSaudi, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                   RowDefinitions="*"
                                   ColumnDefinitions="*,auto">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusQuestionLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <buttons:SfButton
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Background="#cee0dd"
                                    CornerRadius="20"
                                    HorizontalOptions="EndAndExpand"
                                    ImageSize="25"
                                    ImageSource="Paid_check.png"
                                    IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                    ShowIcon="True"
                                    StrokeThickness="1"
                                    Text="{x:Static ResourceManager:AppResources.ESTResidentOptionValue}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="CenterAndExpand" />

                            </Grid>

                              <!--  3 Cards  -->
                            <StackLayout
                                x:Name="NationalityStatusOptionmain"
                                Spacing="20"
                                IsVisible="{Binding IsSaudi, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}">

                                <Grid 
                                    HorizontalOptions="FillAndExpand"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="0"
                                    VerticalOptions="FillAndExpand">

                                    <Grid
                                        x:Name="StayMoreKsagrid"
                                        HeightRequest="100"
                                        Padding="10,0"
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="160">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusStayMoreThanKSAClick}" />
                                        </Grid.GestureRecognizers>

                                        
                                        <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                             IsVisible="{Binding IsClickedStayMoreThanKSAOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            Source="QUnselected"
                                            VerticalOptions="FillAndExpand" />

                                        <Label
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            LineHeight="0"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}"
                                            TextColor="Gray"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />

                                         <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                            Source="QSelected"
                                            VerticalOptions="FillAndExpand" />

                                        <Label
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                            LineHeight="0"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}"
                                            TextColor="White"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />


                                    </Grid>

                                    <Grid
                                        x:Name="OwnhouseGrid"
                                         HeightRequest="100"
                                         Grid.Column="1"
                                         Padding="10,0"
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="160">

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusRentOwnHouseClick}" />
                                        </Grid.GestureRecognizers>

                                        <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsClickedOwnRentOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            Source="QUnselected"
                                            VerticalOptions="FillAndExpand" />

                                        <Label
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedOwnRentOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            LineHeight="0"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}"
                                            TextColor="Gray"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />

                                        <Image
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsClickedOwnRentOption}"
                                            Source="QSelected"
                                            VerticalOptions="FillAndExpand" />

                                        <Label
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedOwnRentOption}"
                                            LineHeight="0"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}"
                                            TextColor="White"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />

                                    </Grid>

                                </Grid>

                                <Grid
                                    x:Name="NoneOfTheAboveGrid"
                                     HeightRequest="100"
                                    Padding="10,0"
                                    HorizontalOptions="StartAndExpand"
                                    VerticalOptions="StartAndExpand"
                                    WidthRequest="160">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NationalityStatusNoneOfTheAboveClick}" />
                                    </Grid.GestureRecognizers>

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Aspect="Fill"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding IsClickedNoneOfTheAboveOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                        Source="QUnselected"
                                        VerticalOptions="FillAndExpand" />

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="10"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsVisible="{Binding IsClickedNoneOfTheAboveOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                        LineHeight="1"
                                        Style="{StaticResource ValueLabelBlackMedium}"
                                        Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}"
                                        TextColor="Gray"
                                        VerticalOptions="CenterAndExpand"
                                        VerticalTextAlignment="Center" />

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Aspect="Fill"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding IsClickedNoneOfTheAboveOption}"
                                        Source="QSelected"
                                        VerticalOptions="FillAndExpand" />

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="10"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsVisible="{Binding IsClickedNoneOfTheAboveOption}"
                                        LineHeight="1"
                                        Style="{StaticResource ValueLabelBlackMedium}"
                                        Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}"
                                        TextColor="White"
                                        VerticalOptions="CenterAndExpand"
                                        VerticalTextAlignment="Center" />

                                </Grid>

                            </StackLayout>

                            <!--  Attachment layout start  -->
                            <StackLayout
                                x:Name="RentAttachmentsMainLayout"
                                IsVisible="{Binding IsClickedOwnRentOption}">
                                <Label Style="{StaticResource ButtonLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.ZVatAttachments}" />

                                <StackLayout Orientation="Horizontal">

                                    <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTProvideAttachmentCopyofRentLabel}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Image
                                        HeightRequest="20"
                                        HorizontalOptions="EndAndExpand"
                                        Source="ic_vat_info.png"
                                        WidthRequest="20">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                </StackLayout>

                                <StackLayout>

                                    <Border
                                        Margin="0,0,0,10"
                                        Stroke="#B1B1B1"
                                        StrokeThickness="1"
                                        Style="{StaticResource GreyBorderFrame}">
                                        <StackLayout
                                            Padding="5,15,5,15"
                                            IsEnabled="True"
                                            Orientation="Horizontal">

                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{x:Static ResourceManager:AppResources.Attachments}" />

                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">

                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    HeightRequest="20"
                                                    HorizontalOptions="Start"
                                                    Source="ic_attachment"
                                                    VerticalOptions="Center"
                                                    WidthRequest="20" />

                                            </StackLayout>
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnEstablishmentRegistrationAttachmentTapped}" />
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </Border>

                                </StackLayout>

                                <StackLayout IsVisible="{Binding IsVisbleRentAttachmentmentList}">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyofRentLabel}" />

                                    <StackLayout
                                        Margin="0,5,0,0"
                                        BindableLayout.ItemsSource="{Binding UploadedRentDocumentsList, Mode=TwoWay}"
                                        Spacing="5"
                                        VerticalOptions="FillAndExpand">

                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,10"
                                                    Padding="10"
                                                    Stroke="{StaticResource NeutralGreay}"
                                                    StrokeShape="RoundRectangle 10,10,10,10"
                                                    StrokeThickness="1"
                                                    Style="{StaticResource GreyBorderFrame}">
                                                    <Grid
                                                        ColumnSpacing="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        RowSpacing="0"
                                                        VerticalOptions="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            HorizontalOptions="Center"
                                                            Source="Generic_attachment_icon.png"
                                                            VerticalOptions="Center" />
                                                        <Label
                                                            Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            HorizontalOptions="StartAndExpand"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Image
                                                            Grid.Column="2"
                                                            HorizontalOptions="Center"
                                                            Source="close.png"
                                                            VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer CommandParameter="Rentcommand" Tapped="TapRentDeleteGestureRecognizer_Tapped" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>

                                    </StackLayout>

                                </StackLayout>

                            </StackLayout>

                            <StackLayout
                                x:Name="NoneOfTheAboveOptionsLayout"
                                IsVisible="{Binding IsClickedNoneOfTheAboveOption}">

                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTChooseLegalEntityBelowTitleLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <StackLayout Margin="0,0,0,10">

                                    <Grid Margin="0,0,0,10"
                                          RowDefinitions="*"
                                          ColumnDefinitions="*">

                                        <Grid
                                            x:Name="PermanentEstablishmentGrid"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            RowDefinitions="104"
                                            ColumnSpacing="24"
                                            RowSpacing="24">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PermanentEstablishmentLegalEntityClick}" />
                                            </Grid.GestureRecognizers>

                                            <cards:SfCardView
                                                CornerRadius="20"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedPermanentLegalEntity, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="unselected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <Label Style="{DynamicResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>

                                            <cards:SfCardView
                                                CornerRadius="20"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedPermanentLegalEntity}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="selected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <Label Style="{DynamicResource CardLabelWhite}" Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>

                                        </Grid>

                                        <Grid
                                            x:Name="OtherTaxableIncomeGrid"
                                            Grid.Row="0"
                                            RowDefinitions="104"
                                            Grid.Column="1">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OtherTaxableIncomeLegalEntityClick}" />
                                            </Grid.GestureRecognizers>

                                            <cards:SfCardView
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                CornerRadius="20"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="unselected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <Label Style="{DynamicResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ESTOtherTaxableIncomeFromSourcesWithinTheKSA}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>

                                            <cards:SfCardView
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                CornerRadius="20"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="selected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <Label Style="{DynamicResource CardLabelWhite}" Text="{x:Static ResourceManager:AppResources.ESTOtherTaxableIncomeFromSourcesWithinTheKSA}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                        </Grid>

                                    </Grid>

                                </StackLayout>

                            </StackLayout>

                            <StackLayout
                                x:Name="PermanentEstablishmentsOptionsLayout"
                                Spacing="10"
                                IsVisible="{Binding IsClickedPermanentLegalEntity}">

                                <Label HorizontalOptions="Start"
                                       Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource CaptionLabelGrey}"
                                                  Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}"
                                                  Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                               <Grid
                                    x:Name="ABranchNonResidentCompanyGrid"
                                    Grid.Row="0"
                                    Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ABranchOfNonResidentCompanyPEClick}" />
                                    </Grid.GestureRecognizers>
                                    <cards:SfCardView
                                        CornerRadius="20"
                                        HeightRequest="104"
                                        IsVisible="{Binding IsClickedABranchOfNonResidentCompanyPE, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                        WidthRequest="171">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Aspect="Fill"
                                                HorizontalOptions="FillAndExpand"
                                                Source="unselected171x136"
                                                VerticalOptions="FillAndExpand" />
                                            <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                <Label
                                                    FontSize="13"
                                                    Style="{DynamicResource CardLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ESTABranchOfNonResidentCompanyLabel}" />
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView>
                                    <cards:SfCardView
                                        CornerRadius="20"
