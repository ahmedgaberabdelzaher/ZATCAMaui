                        <Grid ColumnDefinitions="auto,*"
                              Grid.Row="5"
                              ColumnSpacing="10">

                            <custom:CheckboxCustom
                                IsChecked="{Binding ESTLedge}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="Start" />

                            <Label Text="{x:Static ResourceManager:AppResources.ESTPledgeLabel}"
                                   Grid.Column="1">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding ESTLedge}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding ESTLedge}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                        </Grid>

                    </Grid>

                </ScrollView>
                </Grid>
                
                <buttons:SfButton
                    Margin="0,10,0,10"
                    Command="{Binding OnNextButtonClick}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding NxtButtonLabel}" />

            </StackLayout>

            <StackLayout
                Grid.Row="0"
                Padding="20,15"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                Spacing="0"
                VerticalOptions="StartAndExpand">

                <Grid
                    Padding="0,0,0,10"
                    ColumnSpacing="0"
                    ColumnDefinitions="15*,70*,15*"
                    RowSpacing="0">

                    
                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeft.png"
                        VerticalOptions="CenterAndExpand">
                         <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        HeightRequest="40"
                        Source="ic_logo_gazt.png"
                        WidthRequest="34" />

                    <StackLayout Grid.Row="0" Grid.Column="2">
                        <StackLayout
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Rotation="90"
                            Spacing="3"
                            VerticalOptions="CenterAndExpand">
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                        </StackLayout>
