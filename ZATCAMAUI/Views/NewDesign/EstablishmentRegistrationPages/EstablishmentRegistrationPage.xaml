                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTEndOfFiscalDay}" />
                                        <custom:CustomLabel
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding FiscalDay}"
                                            VerticalOptions="Center" />
                                        <custom:CustomLabel
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTBusinessCommencementDate}" />
                                        <custom:CustomLabel
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding CommDate}"
                                            VerticalOptions="Center" />
                                        <custom:CustomLabel
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTTaxableDate}" />
                                        <custom:CustomLabel
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding TaxDate}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                        </cards:SfCardView>

                        <StackLayout Orientation="Horizontal">
                            <custom:CheckboxCustom
                                IsChecked="{Binding ESTLedge}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />
                            <Label Text="{x:Static ResourceManager:AppResources.ESTPledgeLabel}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding ESTLedge}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding ESTLedge}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <StackLayout
                Grid.Row="0"
                Padding="20,15"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                Orientation="Vertical"
                Spacing="0"
                VerticalOptions="StartAndExpand">
                <Grid
                    Padding="0,0,0,10"
                    ColumnSpacing="0"
                    RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*" />
                        <ColumnDefinition Width="70*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Start"
                        Source="arrowLeft.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        HeightRequest="40"
                        Source="ic_logo_gazt.png"
                        WidthRequest="34" />

                    <StackLayout Grid.Row="0" Grid.Column="2">
                        <StackLayout
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Rotation="90"
                            Spacing="3"
                            VerticalOptions="CenterAndExpand">
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnVoidOrSaveDraftClick}" NumberOfTapsRequired="1" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </Grid>
                <commonView:PageIndicatorView
                    Completed="{Binding MarkComplete}"
                    DotSize="12"
                    HorizontalOptions="End"
                    MarkSize="24"
                    MaxNum="{Binding MaxIndex}"
                    MinNum="{Binding CurrentIndex}" />
                <custom:CustomLabel
                    Margin="0,15,0,0"
                    Padding="0,10,0,0"
                    HorizontalOptions="Start"
                    Style="{StaticResource PageTitleBlack}"
                    Text="{Binding SelectedTabText}"
                    VerticalOptions="Center" />
                <custom:CustomLabel
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource BodyLabelGrey}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                <BoxView
                    Margin="0,15"
                    BackgroundColor="WhiteSmoke"
                    HeightRequest="1" />
                <ScrollView
                    x:Name="TabScrollView"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">


                    <busyindicator:SfChipGroup
                        x:Name="TabSfChipGroup"
                        Margin="0,10,0,0"
                        ChipBackground="Transparent"
                        ChipStroke="{StaticResource NeutralLightGrey}"
                        ChipStrokeThickness="1"
                        ChipType="Choice"
                        HorizontalOptions="Start"
                        ItemsSource="{Binding TabList}"
                        SelectedChipBackground="{StaticResource PartialBg}"
                        SelectedItem="{Binding SelectedTabText}"
                        SelectionChanged="SfChipGroup_SelectionChanged"
                        SelectionChanging="SfChipGroup_SelectionChanging"
                        VerticalOptions="Center">
                        <busyindicator:SfChipGroup.ItemTemplate>
                            <DataTemplate>
                                <StackLayout
                                    Margin="0"
                                    Padding="5,-2,5,-2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <custom:CustomLabel
                                        HorizontalOptions="CenterAndExpand"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{Binding}" />
                                </StackLayout>
                            </DataTemplate>
                        </busyindicator:SfChipGroup.ItemTemplate>
                    </busyindicator:SfChipGroup>
                </ScrollView>
            </StackLayout>
            <Grid
                Grid.Row="2"
                Padding="20,15"
                BackgroundColor="White">
                <buttons:SfButton
                    Command="{Binding OnNextButtonClick}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding NxtButtonLabel}" />
            </Grid>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>


        </Grid>
    </ContentPage.Content>
</ContentPage>
