                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*" />
                                <ColumnDefinition Width="70*" />
                                <ColumnDefinition Width="15*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                HorizontalOptions="Start"
                                Rotation="180"
                                Source="arrowLeft.png"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                                </Image.GestureRecognizers>
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding AppDirection}"
                                        TargetType="Image"
                                        Value="LeftToRight">
                                        <Setter Property="Rotation" Value="0" />
                                    </DataTrigger>
                                </Image.Triggers>

                            </Image>

