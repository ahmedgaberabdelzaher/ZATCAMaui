                                    <StackLayout
                                        Margin="0"
                                        Padding="10"
                                        FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <Label
