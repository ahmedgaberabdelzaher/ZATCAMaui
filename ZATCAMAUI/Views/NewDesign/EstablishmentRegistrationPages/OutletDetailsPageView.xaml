<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentRegistrationPages.OutletDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:SfEffectsView="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:EstablishmentRegistrationOutletTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>

        <Grid RowDefinitions="*">

            <!--#region Body-->
            <Border
                Grid.Row="0"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid
                    Padding="0"
                    ColumnSpacing="0"
                    RowDefinitions="auto,*,auto"
                    RowSpacing="0">

                    <Grid
                        Grid.Row="1"
                        Padding="20,10,20,0"
                        ColumnSpacing="0"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <StackLayout
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}"
                            Spacing="0"
                            VerticalOptions="FillAndExpand">

                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}"
                                TextColor="{StaticResource NeutralGreay}"
                                VerticalOptions="Center" />

                            <Label
                                FontFamily="{StaticResource SomarSemiBold}"
                                FontSize="15"
                                HorizontalOptions="StartAndExpand"
                                Text="{Binding OutletActNumber}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalOptions="Center" />

                            <Label
                                Margin="0,10,0,0"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="11"
                                HorizontalOptions="StartAndExpand"
                                TextColor="{StaticResource NeutralGreay}"
                                VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTOutletCommercialName}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <custom:CustomSfTextInputView>
                                <custom:CustomSfTextInputView.TextInputView>
                                    <custom:GAZTBorderlessEntry
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsSpellCheckEnabled="false"
                                        Placeholder="{x:Static ResourceManager:AppResources.ESTName}"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding OutletName}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </custom:CustomSfTextInputView.TextInputView>
                            </custom:CustomSfTextInputView>
                        </StackLayout>

                        <ScrollView
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.ActivityDetails}}"
                            VerticalOptions="StartAndExpand"
                            VerticalScrollBarVisibility="Never">

                            <StackLayout
                                HorizontalOptions="FillAndExpand"
                                Spacing="0"
                                VerticalOptions="FillAndExpand">

                                <SfEffectsView:SfEffectsView TouchDownCommand="{Binding OnActivityItemButtonClick}" TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}">

                                    <Border
                                        Padding="15"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="deregistration.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource ValueLabelPrimary}"
                                                Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistration}"
                                                VerticalOptions="CenterAndExpand" />

                                            <Image
                                                Grid.Column="2"
                                                Rotation="0"
                                                Source="arrowLeft.png"
                                                VerticalOptions="CenterAndExpand">
                                                <Image.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding AppDirection}"
                                                        TargetType="Image"
                                                        Value="LeftToRight">
                                                        <Setter Property="Rotation" Value="180" />
                                                    </DataTrigger>
                                                </Image.Triggers>

                                            </Image>
                                        </Grid>
                                    </Border>

                                </SfEffectsView:SfEffectsView>

                                <SfEffectsView:SfEffectsView
                                    Margin="0,20"
                                    TouchDownCommand="{Binding OnActivityItemButtonClick}"
                                    TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.LicenseDetails}">

                                    <Border
                                        Padding="15"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="deregistration.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource ValueLabelPrimary}"
                                                Text="{x:Static ResourceManager:AppResources.ESTLicenseDetails}"
                                                VerticalOptions="CenterAndExpand" />

                                            <Image
                                                Grid.Column="2"
                                                Rotation="0"
                                                Source="arrowLeft.png"
                                                VerticalOptions="CenterAndExpand">
                                                <Image.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding AppDirection}"
                                                        TargetType="Image"
                                                        Value="LeftToRight">
                                                        <Setter Property="Rotation" Value="180" />
                                                    </DataTrigger>
                                                </Image.Triggers>

                                            </Image>

                                        </Grid>
                                    </Border>

                                </SfEffectsView:SfEffectsView>

                                <Border
                                    Padding="15"
                                    Stroke="{StaticResource NeutralGreay}"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1">
                                    <Grid
                                        ColumnSpacing="0"
                                        HorizontalOptions="Fill"
                                        RowSpacing="0"
                                        VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="Center"
                                            Source="ic_vat_info.png"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.Information}"
                                            VerticalOptions="CenterAndExpand" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfo}"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Start" />
                                    </Grid>
                                </Border>

                                <Border
                                    Margin="0,20,0,10"
                                    Padding="15"
                                    Stroke="{StaticResource NeutralGreay}"
                                    StrokeShape="RoundRectangle 10,10,10,10"
                                    StrokeThickness="1">
                                    <Grid
                                        ColumnSpacing="0"
                                        HorizontalOptions="Fill"
                                        RowSpacing="0"
                                        VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="Center"
                                            Source="ic_vat_info.png"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.Information}"
                                            VerticalOptions="CenterAndExpand" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfoTwo}"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Start" />
                                    </Grid>
                                </Border>

                            </StackLayout>

                        </ScrollView>

                        <!--#region Address Details-->
                        <ScrollView
                            IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.AddressDetails}}"
                            VerticalOptions="StartAndExpand"
                            VerticalScrollBarVisibility="Never">

                            <StackLayout
                                HorizontalOptions="FillAndExpand"
                                Spacing="0"
                                VerticalOptions="StartAndExpand">
                                <Label
                                    BackgroundColor="AliceBlue"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.ESTPhycicalAddress}"
                                    VerticalOptions="StartAndExpand" />
                                <Grid
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="0"
                                    VerticalOptions="CenterAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTHouseNumber}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <custom:CustomSfTextInputView Grid.Row="1" Grid.Column="0">
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsSpellCheckEnabled="false"
                                                MaxLength="10"
                                                Placeholder="{x:Static ResourceManager:AppResources.ESTHouseNumber}"
                                                PlaceholderColor="{StaticResource NeutralGreay}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding HouseNumber}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center">
                                                <custom:GAZTBorderlessEntry.Behaviors>

                                                    <behaviors:OnlyNumericValuesBehaviour />

                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>
                                        </custom:CustomSfTextInputView.TextInputView>
                                    </custom:CustomSfTextInputView>

                                    <custom:CustomSfTextInputView Grid.Row="1" Grid.Column="1">
                                        <custom:CustomSfTextInputView.TextInputView>
                                            <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsSpellCheckEnabled="false"
                                                Keyboard="Numeric"
                                                MaxLength="20"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}"
                                                PlaceholderColor="{StaticResource NeutralGreay}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding BuildingNumber}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center">
                                                <custom:GAZTBorderlessEntry.Behaviors>

                                                    <behaviors:OnlyNumericValuesBehaviour />

                                                </custom:GAZTBorderlessEntry.Behaviors>

                                            </custom:GAZTBorderlessEntry>
                                        </custom:CustomSfTextInputView.TextInputView>
                                    </custom:CustomSfTextInputView>
                                </Grid>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTFloorNumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            Keyboard="Numeric"
                                            MaxLength="10"
                                            Placeholder="{x:Static ResourceManager:AppResources.ESTFloorNumber}"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding FloorNumber}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center">
                                            <custom:GAZTBorderlessEntry.Behaviors>

                                                <behaviors:OnlyNumericValuesBehaviour />

                                            </custom:GAZTBorderlessEntry.Behaviors>

                                        </custom:GAZTBorderlessEntry>
                                    </custom:CustomSfTextInputView.TextInputView>
                                </custom:CustomSfTextInputView>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            MaxLength="60"
                                            Placeholder="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding Street}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </custom:CustomSfTextInputView.TextInputView>
                                </custom:CustomSfTextInputView>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTQuarter}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            MaxLength="40"
                                            Placeholder="{x:Static ResourceManager:AppResources.ESTQuarter}"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding Quarter}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </custom:CustomSfTextInputView.TextInputView>
                                </custom:CustomSfTextInputView>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZPostalCode}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            Keyboard="Numeric"
                                            MaxLength="6"
                                            Placeholder="{x:Static ResourceManager:AppResources.ZZZZPostalCode}"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding PostalCode}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:NumericValidationBehavior />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>
                                    </custom:CustomSfTextInputView.TextInputView>
                                </custom:CustomSfTextInputView>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ESTAddNumber}"
                                    VerticalOptions="Center" />
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            MaxLength="10"
                                            Placeholder="{x:Static ResourceManager:AppResources.ESTAddNumber}"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding AddNumber}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />


                                    </custom:CustomSfTextInputView.TextInputView>
                                </custom:CustomSfTextInputView>

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.CountryText}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarBold}"
                                            InputTransparent="True"
                                            IsReadOnly="True"
                                            Keyboard="Text"
                                            Placeholder="{x:Static ResourceManager:AppResources.CountryText}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding Country}"
                                            TextColor="{StaticResource NeutralBlack}">
                                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnCountrySelectButtonClick}" />
                                            </custom:GAZTBorderlessEntry.GestureRecognizers>
                                        </custom:GAZTBorderlessEntry>

                                    </custom:CustomSfTextInputView.TextInputView>
                                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnCountrySelectButtonClick}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <inputLayout:SfTextInputLayout.TrailingView>

                                        <Image Aspect="AspectFit" Source="greyDropDown" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </custom:CustomSfTextInputView>

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTProvinance}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarBold}"
                                            InputTransparent="True"
                                            IsReadOnly="True"
                                            Keyboard="Text"
                                            Placeholder="{x:Static ResourceManager:AppResources.ESTProvinance}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding Provinance}"
                                            TextColor="{StaticResource NeutralBlack}">
                                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnProvinanceSelectButtonClick}" />
                                            </custom:GAZTBorderlessEntry.GestureRecognizers>
                                        </custom:GAZTBorderlessEntry>

                                    </custom:CustomSfTextInputView.TextInputView>
                                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnProvinanceSelectButtonClick}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <inputLayout:SfTextInputLayout.TrailingView>

                                        <Image Aspect="AspectFit" Source="greyDropDown" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </custom:CustomSfTextInputView>

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{DynamicResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTOutletCity}" />
                                            <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarBold}"
                                            InputTransparent="True"
                                            IsReadOnly="True"
                                            Keyboard="Text"
                                            Placeholder="{x:Static ResourceManager:AppResources.ESTOutletCity}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding City}"
                                            TextColor="{StaticResource NeutralBlack}">
                                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnCitySelectButtonClick}" />
                                            </custom:GAZTBorderlessEntry.GestureRecognizers>
                                        </custom:GAZTBorderlessEntry>

                                    </custom:CustomSfTextInputView.TextInputView>
                                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnCitySelectButtonClick}" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <inputLayout:SfTextInputLayout.TrailingView>

                                        <Image Aspect="AspectFit" Source="greyDropDown" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </custom:CustomSfTextInputView>

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.ESTPostalAddress}"
                                    VerticalOptions="StartAndExpand" />
                                <StackLayout
