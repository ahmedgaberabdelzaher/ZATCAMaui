<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentRegistrationPages.OutletDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:SfEffectsView="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
           
            <converters:EstablishmentRegistrationOutletTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>

        <Grid RowDefinitions="*">

            <!--#region Body-->
            <Border Grid.Row="0"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                   <Grid
                        Padding="0"
                        RowDefinitions="auto,*,auto"
                        ColumnSpacing="0"
                        RowSpacing="0">

                        <Grid
                            Grid.Row="1"
                            Padding="20,10,20,0"
                            ColumnSpacing="0"
                            HorizontalOptions="FillAndExpand"
                            RowSpacing="0"
                            VerticalOptions="FillAndExpand">
                            <StackLayout
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}"
                                Orientation="Vertical"
                                Spacing="0"
                                VerticalOptions="FillAndExpand">
                                <Label
                                    Margin="0,-10,0,0"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="15"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}"
                                    TextColor="{StaticResource NeutralGreay}"
                                    VerticalOptions="Center" />
                                <Label
                                    Margin="0,-5,0,0"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="15"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding OutletActNumber}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center" />
                                <Label
                                    Margin="0,10,0,0"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="11"
                                    HorizontalOptions="StartAndExpand"
                                    TextColor="{StaticResource NeutralGreay}"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTOutletCommercialName}" />
                                            <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <inputLayout:SfTextInputLayout
                                    ContainerType="Outlined"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,0,16,0"
                                    IsHintAlwaysFloated="True"
                                    LeadingViewPosition="Inside">
                                    <custom:GAZTBorderlessEntry
                                        Margin="10"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HeightRequest="48"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsSpellCheckEnabled="false"
                                        Placeholder="{x:Static ResourceManager:AppResources.ESTName}"
                                        PlaceholderColor="{StaticResource NeutralGreay}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding OutletName}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <ScrollView
                                IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.ActivityDetails}}"
                                Orientation="Vertical"
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Never">
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Vertical"
                                    Spacing="0"
                                    VerticalOptions="FillAndExpand">
                                    <SfEffectsView:SfEffectsView TouchDownCommand="{Binding OnActivityItemButtonClick}" TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}">
                                        <Border
                                            Padding="15"
                                            Stroke="{StaticResource NeutralGreay}"
                                            StrokeShape="RoundRectangle 10,10,10,10"
                                            StrokeThickness="1">
                                            <Grid
                                                ColumnSpacing="0"
                                                HorizontalOptions="Fill"
                                                RowSpacing="0"
                                                VerticalOptions="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    HorizontalOptions="Center"
                                                    Source="deregistration.png"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelPrimary}"
                                                    Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistration}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <Image
                                                    Grid.Column="2"
                                                    HorizontalOptions="Center"
                                                    Source="arrowRight.png"
                                                    Style="{DynamicResource BackButtonArrow}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </SfEffectsView:SfEffectsView>
                                    <SfEffectsView:SfEffectsView
                                        Margin="0,20"
                                        TouchDownCommand="{Binding OnActivityItemButtonClick}"
                                        TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.LicenseDetails}">
                                        <Border
                                            Padding="15"
                                            Stroke="{StaticResource NeutralGreay}"
                                            StrokeShape="RoundRectangle 10,10,10,10"
                                            StrokeThickness="1">
                                            <Grid
                                                ColumnSpacing="0"
                                                HorizontalOptions="Fill"
                                                RowSpacing="0"
                                                VerticalOptions="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Column="0"
                                                    HorizontalOptions="Center"
                                                    Source="deregistration.png"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelPrimary}"
                                                    Text="{x:Static ResourceManager:AppResources.ESTLicenseDetails}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <Image
                                                    Grid.Column="2"
                                                    HorizontalOptions="Center"
                                                    Source="arrowRight.png"
                                                    Style="{DynamicResource BackButtonArrow}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </SfEffectsView:SfEffectsView>
                                    <Border
                                        Padding="15"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="ic_vat_info.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.Information}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfo}"
                                                VerticalOptions="CenterAndExpand"
                                                VerticalTextAlignment="Start" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        Margin="0,20,0,10"
                                        Padding="15"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="ic_vat_info.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.Information}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfoTwo}"
                                                VerticalOptions="CenterAndExpand"
                                                VerticalTextAlignment="Start" />
                                        </Grid>
                                    </Border>
                                </StackLayout>
                            </ScrollView>
                            <ScrollView
                                IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.AddressDetails}}"
                                Orientation="Vertical"
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Never">
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Vertical"
                                    Spacing="0"
                                    VerticalOptions="StartAndExpand">
                                    <Label
                                        Margin="0,10,0,0"
                                        BackgroundColor="AliceBlue"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource ValueLabelBlackBold}"
                                        Text="{x:Static ResourceManager:AppResources.ESTPhycicalAddress}"
                                        VerticalOptions="StartAndExpand" />
                                    <Grid
                                        ColumnSpacing="20"
                                        HorizontalOptions="FillAndExpand"
                                        RowSpacing="0"
                                        VerticalOptions="CenterAndExpand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,10,0,0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTHouseNumber}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,10,0,0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}" />
                                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,-6,0,-6"
                                            ContainerType="Outlined"
                                            HorizontalOptions="FillAndExpand"
                                            InputViewPadding="16,0,16,0"
                                            IsHintAlwaysFloated="True"
                                            LeadingViewPosition="Inside"
                                            Style="{StaticResource TextInputLayout}">
                                            <custom:GAZTBorderlessEntry
                                                Margin="10"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                HeightRequest="48"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsSpellCheckEnabled="false"
                                                MaxLength="10"
                                                PlaceholderColor="{StaticResource NeutralGreay}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding HouseNumber}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </inputLayout:SfTextInputLayout>
                                        <inputLayout:SfTextInputLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            ContainerType="Outlined"
                                            HorizontalOptions="FillAndExpand"
                                            InputViewPadding="16,0,16,0"
                                            IsHintAlwaysFloated="True"
                                            LeadingViewPosition="Inside">
                                            <custom:GAZTBorderlessEntry
                                                Margin="10"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="15"
                                                HeightRequest="48"
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsSpellCheckEnabled="false"
                                                MaxLength="20"
                                                PlaceholderColor="{StaticResource NeutralGreay}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding BuildingNumber}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </inputLayout:SfTextInputLayout>
                                    </Grid>
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ESTFloorNumber}" />
                                                <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <inputLayout:SfTextInputLayout
                                        ContainerType="Outlined"
                                        HorizontalOptions="FillAndExpand"
                                        InputViewPadding="16,0,16,0"
                                        IsHintAlwaysFloated="True"
                                        LeadingViewPosition="Inside">
                                        <custom:GAZTBorderlessEntry
                                            Margin="10"
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HeightRequest="48"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            MaxLength="10"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding FloorNumber}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </inputLayout:SfTextInputLayout>
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}" />
                                                <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-6,0,-6"
                                        ContainerType="Outlined"
                                        HorizontalOptions="FillAndExpand"
                                        InputViewPadding="16,0,16,0"
                                        IsHintAlwaysFloated="True"
                                        LeadingViewPosition="Inside"
                                        Style="{StaticResource TextInputLayout}">
                                        <custom:GAZTBorderlessEntry
                                            Margin="10"
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HeightRequest="48"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            MaxLength="60"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding Street}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </inputLayout:SfTextInputLayout>
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ESTQuarter}" />
                                                <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-6,0,-6"
                                        ContainerType="Outlined"
                                        HorizontalOptions="FillAndExpand"
                                        InputViewPadding="16,0,16,0"
                                        IsHintAlwaysFloated="True"
                                        LeadingViewPosition="Inside"
                                        Style="{StaticResource TextInputLayout}">
                                        <custom:GAZTBorderlessEntry
                                            Margin="10"
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HeightRequest="48"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            MaxLength="40"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding Quarter}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </inputLayout:SfTextInputLayout>
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZZZPostalCode}" />
                                                <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <inputLayout:SfTextInputLayout
                                        ContainerType="Outlined"
                                        HorizontalOptions="FillAndExpand"
                                        InputViewPadding="16,0,16,0"
                                        IsHintAlwaysFloated="True"
                                        LeadingViewPosition="Inside"
                                        Style="{StaticResource TextInputLayout}">
                                        <custom:GAZTBorderlessEntry
                                            Margin="10"
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HeightRequest="48"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                            MaxLength="6"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding PostalCode}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:NumericValidationBehavior />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTAddNumber}"
                                        VerticalOptions="Center" />
                                    <inputLayout:SfTextInputLayout
                                        ContainerType="Outlined"
                                        HorizontalOptions="FillAndExpand"
                                        InputViewPadding="16,0,16,0"
                                        IsHintAlwaysFloated="True"
                                        LeadingViewPosition="Inside"
                                        Style="{StaticResource TextInputLayout}">
                                        <custom:GAZTBorderlessEntry
                                            Margin="10"
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="15"
                                            HeightRequest="48"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="Start"
                                            IsSpellCheckEnabled="false"
                                            MaxLength="10"
                                            PlaceholderColor="{StaticResource NeutralGreay}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding AddNumber}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </inputLayout:SfTextInputLayout>
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.CountryText}" />
                                                <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <buttons:SfButton
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Command="{Binding OnCountrySelectButtonClick}"
                                        CornerRadius="10"
                                        FontFamily="{StaticResource SomarBold}"
                                        FontSize="15"
                                        HorizontalTextAlignment="Start"
                                        ImageAlignment="End"
                                        ImageSource="arrowDropdown.png"
                                        ShowIcon="True"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeThickness="1"
                                        Style="{StaticResource NoBackgroundButtonStyle}"
                                        Text="{Binding Country}"
                                        TextColor="{StaticResource NeutralBlack}" />
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ESTProvinance}" />
                                                <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <buttons:SfButton
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Command="{Binding OnProvinanceSelectButtonClick}"
                                        CornerRadius="10"
                                        FontFamily="{StaticResource SomarBold}"
                                        FontSize="15"
                                        HorizontalTextAlignment="Start"
                                        ImageAlignment="End"
                                        ImageSource="arrowDropdown.png"
                                        ShowIcon="True"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeThickness="1"
                                        Style="{StaticResource NoBackgroundButtonStyle}"
                                        Text="{Binding Provinance}"
                                        TextColor="{StaticResource NeutralBlack}" />
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ESTOutletCity}" />
                                                <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <buttons:SfButton
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Command="{Binding OnCitySelectButtonClick}"
                                        CornerRadius="10"
                                        FontFamily="{StaticResource SomarBold}"
                                        FontSize="15"
                                        HorizontalTextAlignment="Start"
                                        ImageAlignment="End"
                                        ImageSource="arrowDropdown.png"
                                        ShowIcon="True"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeThickness="1"
                                        Style="{StaticResource NoBackgroundButtonStyle}"
                                        Text="{Binding City}"
                                        TextColor="{StaticResource NeutralBlack}" />
                                    <Label
                                        Margin="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource ValueLabelBlackBold}"
                                        Text="{x:Static ResourceManager:AppResources.ESTPostalAddress}"
                                        VerticalOptions="StartAndExpand" />
                                    <StackLayout
                                        Padding="10,0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal"
                                        VerticalOptions="EndAndExpand">
                                        <Label
                                            Margin="0,10,0,0"
                                            BackgroundColor="AliceBlue"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTSameAsPhycical}"
                                            VerticalOptions="Center" />
                                        <buttons:SfSwitch
                                            HorizontalOptions="Center"
                                            IsOn="{Binding PostalAsPhysical}"
                                            VerticalOptions="Center"
                                            Visual="Default" />
                                    </StackLayout>
                                    <StackLayout
                                        HorizontalOptions="FillAndExpand"
                                        IsEnabled="{Binding PostalAsPhysical, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter='invert'}"
                                        IsVisible="{Binding PostalAddressVisibility}"
                                        Orientation="Vertical"
                                        VerticalOptions="StartAndExpand">
                                        <Grid
                                            ColumnSpacing="20"
                                            HorizontalOptions="FillAndExpand"
                                            RowSpacing="0"
                                            VerticalOptions="CenterAndExpand">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Label
