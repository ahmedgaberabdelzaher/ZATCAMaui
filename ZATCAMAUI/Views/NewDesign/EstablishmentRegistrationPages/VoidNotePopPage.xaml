<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentRegistrationPages.VoidNotePopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}">
    <Mopups:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>
    <Mopups:PopupPage.Content>
        <Border
            Padding="10"
            BackgroundColor="White"
            Stroke="Black"
            StrokeThickness="1"
            VerticalOptions="EndAndExpand">
            <Grid RowSpacing="0"
                  RowDefinitions="*,*">

                <custom:CustomSfTextInputView ErrorText="{x:Static ResourceManager:AppResources.ZZZRequired}"
                                               x:Name="notesInputLayout">
                    <custom:CustomSfTextInputView.TextInputView>
                        <custom:GAZTBorderlessEntry
                        x:Name="notes"
                        IsSpellCheckEnabled="false"
                        MaxLength="132"
                        TextChanged="notes_TextChanged" />
                    </custom:CustomSfTextInputView.TextInputView>
                </custom:CustomSfTextInputView>

                <HorizontalStackLayout Spacing="10"
                                       Grid.Row="1"
                                       HorizontalOptions="Center">

                    <buttons:SfButton
                        WidthRequest="150"
                        Clicked="Void_Button_Clicked"
                        HorizontalOptions="FillAndExpand"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ESTZZVoid}" />
                    <buttons:SfButton
                        WidthRequest="150"
                        Clicked="CancelButton_Clicked"
                        HorizontalOptions="FillAndExpand"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZZCancel}" />

                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Mopups:PopupPage.Content>
</Mopups:PopupPage>
