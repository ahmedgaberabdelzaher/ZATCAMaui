<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentRegistrationPages.ActivityItemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    x:Name="ESTActivityItemPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:EstablishmentRegistrationActivityTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:EstablishmentMainActivityToVisibilityConverter x:Key="isMainActivityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid
            Padding="0"
            BackgroundColor="White"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="1"
                Padding="20,10,20,0"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">

                <!--#region CR Details-->
                <ScrollView
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}}"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">

                    <StackLayout
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill">
                        <Label
                            Margin="0,0,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueCountryLabel}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarBold}"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ESTIssueCountryLabel}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRIssueCountry}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueCountrySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueCountrySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueBy}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarBold}"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ESTIssueBy}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRIssueBy}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueBySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueBySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTIssueCity}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarBold}"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ESTIssueCity}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRIssueCity}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnIssueCitySelectButtonClick}" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnIssueCitySelectButtonClick}" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZCRName}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <custom:CustomSfTextInputView IsEnabled="{Binding EnableCRInputField}">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="15"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ZZCRName}"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CrName}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZCRNumber}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <custom:CustomSfTextInputView IsEnabled="{Binding EnableCRInputField}">

                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="15"
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ZCRNumber}"
                                    PlaceholderColor="{StaticResource NeutralGreay}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRNumber}"
                                    TextColor="{StaticResource NeutralBlack}"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                            </custom:CustomSfTextInputView.TextInputView>

                        </custom:CustomSfTextInputView>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ZZCRNationalNumber}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <inputLayout:SfTextInputLayout
                            Margin="0,6,0,6"
                            ContainerType="Outlined"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                            IsEnabled="{Binding EnableCRNationalInputField}"
                            LeadingViewPosition="Inside"
                            Style="{StaticResource TextInputLayout}">
                            <custom:GAZTBorderlessEntry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                Keyboard="Numeric"
                                MaxLength="10"
                                Placeholder="{x:Static ResourceManager:AppResources.ZZCRNationalNumber}"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding CRNationalNumber}"
                                TextColor="{StaticResource NeutralBlack}"
                                Unfocused="CR_National_Entry_Unfocused"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center">

                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:NumericValidationBehavior />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <Label
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTValidFrom}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    FontFamily="{StaticResource SomarBold}"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ESTValidFrom}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding DisplayCRValidFrom}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="crValidFromButtonClick" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="crValidFromButtonClick" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="25"
                                    Source="calendar.png"
                                    WidthRequest="25" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </custom:CustomSfTextInputView>

                        <custom:CustomDatePicker
                            x:Name="crValidFromPicker"
                            Margin="10,0,10,0"
                            Background="White"
                            Closed="crValidFromPicker_Closed"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            Mode="Dialog"
                            SelectedItem="{Binding SelectedCRValidFromDate}">

                            <custom:CustomDatePicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </custom:CustomDatePicker.SelectedTextStyle>

                            <custom:CustomDatePicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                            </custom:CustomDatePicker.ColumnHeaderView>


                            <custom:CustomDatePicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                            </custom:CustomDatePicker.SelectionView>

                            <custom:CustomDatePicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                    Height="46"
                                    Background="{StaticResource NeutralBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}">
                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>

                                </syncfusion:PickerHeaderView>

                            </custom:CustomDatePicker.HeaderView>

                            <custom:CustomDatePicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </custom:CustomDatePicker.FooterView>


                        </custom:CustomDatePicker>

                        <custom:CustomHijriDatePicker
                            x:Name="crValidFromHijiriPicker"
                            Margin="10,0,10,0"
                            Background="White"
                            Closed="crValidFromPicker_Closed"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            Mode="Dialog"
                            SelectedItem="{Binding SelectedCRValidFromHijiriDate}">

                            <custom:CustomHijriDatePicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                            </custom:CustomHijriDatePicker.SelectionView>

                            <custom:CustomHijriDatePicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                            </custom:CustomHijriDatePicker.ColumnHeaderView>

                            <custom:CustomHijriDatePicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </custom:CustomHijriDatePicker.SelectedTextStyle>


                            <custom:CustomHijriDatePicker.HeaderView>
                                <syncfusion:PickerHeaderView
                                    Height="46"
                                    Background="{StaticResource NeutralBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}">
                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>

                                </syncfusion:PickerHeaderView>

                            </custom:CustomHijriDatePicker.HeaderView>



                            <custom:CustomHijriDatePicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="White" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </custom:CustomHijriDatePicker.FooterView>

                        </custom:CustomHijriDatePicker>

                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ESTMainActivity}"
                                VerticalOptions="Center" />
                            <buttons:SfSwitch
                                x:Name="CRMainActivity"
                                HorizontalOptions="Center"
                                IsOn="{Binding MainActivity}"
                                StateChanged="CRSwitch_StateChanged"
                                VerticalOptions="Center"
                                Visual="Default" />
                        </StackLayout>
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            Text="{x:Static ResourceManager:AppResources.Attachments}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyOfCRLabel}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Image
                                HorizontalOptions="Center"
                                Source="ic_vat_info.png"
                                VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                    Style="{StaticResource DefaultEntry}"
                                    TextColor="#58595B">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnTransferCopyOfCRChoiceButtonClick}" CommandParameter="RG01" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnTransferCopyOfCRChoiceButtonClick}" CommandParameter="RG01" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="ic_attachment.png" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </custom:CustomSfTextInputView>

                        <StackLayout
                            Margin="0,5,0,0"
                            BindableLayout.ItemsSource="{Binding CRsCopies}"
                            Spacing="5"
                            VerticalOptions="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        FlowDirection="{Binding Source={x:Reference ESTActivityItemPage}, Path=FlowDirection}"
                                        Padding="10"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="Generic_attachment_icon.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding Filename}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="Center"
                                                Source="close.png"
                                                VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={Reference ESTActivityItemPage}, Path=BindingContext.OnDeleteCRsCopyButtonClick}"
                                                        CommandParameter="{Binding .}"
                                                        NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <Label
                            Margin="0,15,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ESTAttachmentTransferCopyOfCRLabel}"
                            VerticalOptions="Center" />

                        <custom:CustomSfTextInputView>
                            <custom:CustomSfTextInputView.TextInputView>
                                <custom:GAZTBorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                    Style="{StaticResource DefaultEntry}"
                                    TextColor="#58595B">
                                    <custom:GAZTBorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnTransferCopyOfCRChoiceButtonClick}" CommandParameter="RG12" />
                                    </custom:GAZTBorderlessEntry.GestureRecognizers>
                                </custom:GAZTBorderlessEntry>

                            </custom:CustomSfTextInputView.TextInputView>
                            <inputLayout:SfTextInputLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OnTransferCopyOfCRChoiceButtonClick}" CommandParameter="RG12" />
                            </inputLayout:SfTextInputLayout.GestureRecognizers>
                            <inputLayout:SfTextInputLayout.TrailingView>

                                <Image Aspect="AspectFit" Source="ic_attachment.png" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </custom:CustomSfTextInputView>

                        <StackLayout
                            Margin="0,5,0,0"
                            BindableLayout.ItemsSource="{Binding TransferCRsCopies}"
                            Spacing="5"
                            VerticalOptions="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        FlowDirection="{Binding Source={x:Reference ESTActivityItemPage}, Path=FlowDirection}"
                                        Padding="10"
                                        Stroke="{StaticResource NeutralGreay}"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="Generic_attachment_icon.png"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding Filename}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="Center"
                                                Source="close.png"
                                                VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={Reference ESTActivityItemPage}, Path=BindingContext.OnDeleteTransferCRsCopyButtonClick}"
                                                        CommandParameter="{Binding .}"
                                                        NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <Label
                            Margin="0,15"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            Text="{x:Static ResourceManager:AppResources.ESTBusinessActivityDetails}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <buttons:SfButton
                            Command="{Binding OnActivitiesButtonClick}"
                            CommandParameter="CRData"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ESTActivity}" />

                    </StackLayout>

                </ScrollView>
                <!--#endregion-->

                <!--#region Activity List-->
                <StackLayout
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.ActivityList}}"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">

                    <custom:CustomSfTextInputView>
                        <custom:CustomSfTextInputView.TextInputView>
                            <custom:GAZTBorderlessEntry
                                InputTransparent="True"
                                IsReadOnly="True"
                                Keyboard="Text"
                                Placeholder="{x:Static ResourceManager:AppResources.ESTAddLicense}"
                                Style="{StaticResource DefaultEntry}"
                                TextColor="#58595B">
                                <custom:GAZTBorderlessEntry.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnNewLicenseButtonClick}" />
