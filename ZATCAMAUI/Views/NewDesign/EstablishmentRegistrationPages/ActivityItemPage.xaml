                            Closed="validFromPicker_Closed"
                            FlowDirection="RightToLeft"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            Mode="Dialog"
                            SelectedItem="{Binding SelectedValidFromDate}">

                            <custom:CustomDatePicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </custom:CustomDatePicker.SelectedTextStyle>


                            <custom:CustomDatePicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                            </custom:CustomDatePicker.ColumnHeaderView>

                            <custom:CustomDatePicker.HeaderView>

                                <syncfusion:PickerHeaderView Background="#EAF7CC" Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}" />

                            </custom:CustomDatePicker.HeaderView>

                            <custom:CustomDatePicker.FooterView>

                                <syncfusion:PickerFooterView Background="#EAF7CC">

