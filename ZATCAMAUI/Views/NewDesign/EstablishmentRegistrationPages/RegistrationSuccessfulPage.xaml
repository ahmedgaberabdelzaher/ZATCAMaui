<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentRegistrationPages.RegistrationSuccessfulPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    FlowDirection="{Binding AppDirection}"
    ios:Page.UseSafeArea="False"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <Grid
            Padding="0"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout
                Grid.Row="0"
                Margin="0,45,0,0"
                Padding="20"
                HorizontalOptions="Center"
                VerticalOptions="FillAndExpand">
                <Image Source="Forget_ic_success" />
                <Label
                    Margin="0,20,0,10"
                    HorizontalOptions="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ESTRegistrationSuccessful}" />
                <Label
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource BodyLabelBlack}"
                    StyleId="OnBoardText"
                    Text="{x:Static ResourceManager:AppResources.ESTGAZTAcknowledgesTheReceiptRegApplication}"
                    TextColor="White" />
            </StackLayout>
            <Border
                Grid.Row="1"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">
                <Grid
                    HorizontalOptions="Fill"
                    RowSpacing="15"
                    VerticalOptions="Fill">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical"
                        VerticalOptions="Start"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Spacing="15" VerticalOptions="StartAndExpand">
                            <Border
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <StackLayout
                                    Padding="10"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTName}" />
                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding Name}" />
                                </StackLayout>
                            </Border>
                            <Border
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <StackLayout
                                    Padding="10"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTReferenceNumber}" />
                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding Fbnumx}" />
                                </StackLayout>
                            </Border>
                            <Border
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <StackLayout
                                    Padding="10"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Date}" />
                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding DateText}" />
                                </StackLayout>
                            </Border>
                            <Border
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                StrokeThickness="1">
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ESTFutureRefernceAndCommunicationFinalMsg}" />
                            </Border>
                        </StackLayout>
                    </ScrollView>
                    <buttons:SfButton
                        Grid.Row="1"
                        Background="White"
                        Clicked="GoToDashBoardButtonClick"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ESTGoToDashboard}"
                        TextColor="{StaticResource Primary}" />
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>
