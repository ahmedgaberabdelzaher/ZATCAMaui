<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.NewDesign.EscalatedCasesGSTC.EscalatedCasesGSTCPageView"
             Title="EscalatedCasesGSTCPageView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
             xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Name="page"
             ios:Page.UseSafeArea="true"
             BackgroundImageSource="partials_background.png"
             FlowDirection="{Binding AppDirection}"
             NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10"
                  RowDefinitions="auto,*"
                  ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.GSTCEscalatedCasesGSTC}"
                    VerticalOptions="Center" />

                <!--Searh Icon-->
                <StackLayout Spacing="15"
                            Orientation="Horizontal"
                            VerticalOptions="CenterAndExpand"
                            HorizontalOptions="EndAndExpand"
                            Grid.Column="2">

                    <Image Source="search"
                            IsVisible="{Binding IsSearchButtonVisible}"
                            HeightRequest="20"
                            WidthRequest="20">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="searchButtonTapped"/>
                        </Image.GestureRecognizers>

                    </Image>
                           
                </StackLayout>

                <!--Search Bar-->
                <Grid HorizontalOptions="FillAndExpand"
                      Grid.Row="1"
                      IsVisible="{Binding IsCloseButtonVisible}"
                      ColumnDefinitions="*,auto"
                      Grid.ColumnSpan="3">

                    <SearchBar x:Name="searchBar"
                                Grid.Column="0"
                                Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                BackgroundColor="White"
                                custom:RoundCornersEffect.CornerRadius="12"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand"
                                Margin="0"
                                TextChanged="SearchBar_TextChanged"/>

                    <Image Grid.Column="1"
                            WidthRequest="24"
                            HeightRequest="24"
                            Source="close">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CloseSearchButton_Tapped">
                            </TapGestureRecognizer>
                        </Image.GestureRecognizers>

                    </Image>

                </Grid>

            </Grid>
            <!--#endregion Header-->

            <!--Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                <Grid VerticalOptions="StartAndExpand"
                      RowDefinitions="*"
                      Margin="10">

                    <ListView x:Name="ListView_Returns"
                                ItemsSource="{Binding CopiedCaseDetailedListViewData}"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand"
                                HasUnevenRows="True" BackgroundColor="White" SeparatorVisibility="None" VerticalScrollBarVisibility="Never" SelectionMode="None">
                        <ListView.ItemTemplate IsVisible="{Binding IsListVisible}">
                            <DataTemplate>
                                <ViewCell>
                                    <Border Margin="0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0,10">
                                            <Grid Padding="10" RowSpacing="15" ColumnSpacing="15">

                                                <Grid.RowDefinitions >
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                            
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>


                                                <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCCaseNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel Text="{Binding CaseNumber}"  Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>

                                                <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCName}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel Text="{Binding Name}" Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>

                                                <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5" HorizontalOptions="FillAndExpand">
                                                    <custom:CustomLabel HorizontalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.GSTCCaseDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel HorizontalTextAlignment="Start"   Text="{Binding CaseDateString}" Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>

                                                <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCCaseStage}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel HorizontalTextAlignment="Start"   Text="{Binding ZMileStone}" Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>

                                                <!--newly added-->
                                                <StackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCDegreeOfLitigation}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel HorizontalTextAlignment="Start"   Text="{Binding ZDegreeLitigation}" Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>
                                                </Grid>

                                                <Grid Padding="10" RowSpacing="15" ColumnSpacing="15">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                       
                                                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand">
                                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCCaseClassification}" Style="{StaticResource CaptionLabelGrey}"/>
                                                            <custom:CustomLabel HorizontalTextAlignment="Start" Text="{Binding ZCaseClassificationDes}" Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCCaseType}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <custom:CustomLabel HorizontalTextAlignment="Start" Text="{Binding ZCaseType}" Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>
                                                </Grid >
                                     
                                            <Grid Padding="10" RowSpacing="15" ColumnSpacing="15">
                                                        <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand" >
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCType}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel HorizontalTextAlignment="Start"  Text="{Binding ZType}" Style="{StaticResource ValueLabelBlack}"/>
                                                </StackLayout>

                                                <StackLayout Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCObjectionNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel Text="{Binding GrevienceNumber}"  Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>
                                        
                                                <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCCaseSubject}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel Text="{Binding CaseSubject}"  Style="{StaticResource ValueLabelBlack}" />
                                                </StackLayout>
                                                </Grid>
                                                <Grid Padding="10" RowSpacing="15" ColumnSpacing="15">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5" HorizontalOptions="FillAndExpand"  >
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCCaseLink}" Style="{StaticResource CaptionLabelGrey}"/>
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.GSTCNoteText}"  Style="{StaticResource ValueLabelBlack}">
                                                    </custom:CustomLabel>
                                                </StackLayout>
                                            </Grid>

                                        </StackLayout>
                                    </Border >
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>


                    <Label Margin="0,40,0,0"
                           Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}"
                           Style="{StaticResource CaptionLabelGrey}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding NoDataAvailable}"/>

           
                </Grid>

            </Border>

            <custom:Loader Grid.RowSpan="2"
                           IsVisible="{Binding IsLoading}"/>

        </Grid>
        

    </ContentPage.Content>
</ContentPage>
