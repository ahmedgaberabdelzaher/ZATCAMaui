<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EscalatedCasesGSTC.EscalatedCasesGSTCPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Name="page"
    Title="EscalatedCasesGSTCPageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,2*,*"
                RowDefinitions="auto,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.GSTCEscalatedCasesGSTC}"
                    VerticalOptions="Center" />

                <!--  Searh Icon  -->
                <StackLayout
                    Grid.Column="2"
                    HorizontalOptions="EndAndExpand"
                    Orientation="Horizontal"
                    Spacing="15"
                    VerticalOptions="CenterAndExpand">

                    <Image
                        HeightRequest="20"
                        IsVisible="{Binding IsSearchButtonVisible}"
                        Source="search"
                        WidthRequest="20">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="searchButtonTapped" />
                        </Image.GestureRecognizers>

                    </Image>

                </StackLayout>

                <!--  Search Bar  -->
                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    ColumnDefinitions="*,auto"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsCloseButtonVisible}">

                    <SearchBar
                        x:Name="searchBar"
                        Grid.Column="0"
                        Margin="0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        Keyboard="{OnPlatform Android=Numeric,
                                              iOS=Default}"
                        TextChanged="SearchBar_TextChanged"
                        VerticalOptions="FillAndExpand" />

                    <Image
                        Grid.Column="1"
                        HeightRequest="24"
                        Source="close"
                        WidthRequest="24">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                        </Image.GestureRecognizers>

                    </Image>

                </Grid>

            </Grid>
            <!--#endregion Header-->

            <!--  Body  -->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid
                    Margin="10"
                    RowDefinitions="*"
                    VerticalOptions="StartAndExpand">

                    <ListView
                        x:Name="ListView_Returns"
                        BackgroundColor="White"
                        HasUnevenRows="True"
                        HorizontalOptions="FillAndExpand"
                        ItemsSource="{Binding CopiedCaseDetailedListViewData}"
                        SelectionMode="None"
                        SeparatorVisibility="None"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <ListView.ItemTemplate IsVisible="{Binding IsListVisible}">
                            <DataTemplate>
                                <ViewCell>
                                    <Border Margin="0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0,10">
                                            <Grid
                                                Padding="10"
                                                ColumnSpacing="15"
                                                RowSpacing="15">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />

                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>


                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCCaseNumber}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding CaseNumber}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCName}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding Name}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.GSTCCaseDate}" />
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding CaseDateString}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCCaseStage}" />
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ZMileStone}" />
                                                </StackLayout>

                                                <!--  newly added  -->
                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCDegreeOfLitigation}" />
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ZDegreeLitigation}" />
                                                </StackLayout>
                                            </Grid>

                                            <Grid
                                                Padding="10"
                                                ColumnSpacing="15"
                                                RowSpacing="15">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCCaseClassification}" />
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ZCaseClassificationDes}" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCCaseType}" />
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ZCaseType}" />
                                                </StackLayout>
                                            </Grid>

                                            <Grid
                                                Padding="10"
                                                ColumnSpacing="15"
                                                RowSpacing="15">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCType}" />
                                                    <custom:CustomLabel
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ZType}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCObjectionNumber}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding GrevienceNumber}" />
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCCaseSubject}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding CaseSubject}" />
                                                </StackLayout>
                                            </Grid>
                                            <Grid
                                                Padding="10"
                                                ColumnSpacing="15"
                                                RowSpacing="15">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Spacing="-5">
                                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.GSTCCaseLink}" />
                                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.GSTCNoteText}" />
                                                </StackLayout>
                                            </Grid>

                                        </StackLayout>
                                    </Border>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>


                    <Label
                        Margin="0,40,0,0"
                        HorizontalOptions="Center"
                        IsVisible="{Binding NoDataAvailable}"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}"
                        VerticalOptions="Center" />


                </Grid>

            </Border>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>


    </ContentPage.Content>
</ContentPage>
