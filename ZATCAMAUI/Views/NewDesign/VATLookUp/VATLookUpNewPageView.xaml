<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATLookUp.VATLookUpNewPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <Border
                Grid.Row="1"
                Margin="0"
                Padding="15"
                IsVisible="{Binding IsMainView}"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="FillAndExpand">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <StackLayout>

                        <StackLayout Spacing="10">

                            <Label
                                LineHeight=".8"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}" />

                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVATLookUpTitleSub}" />

                            <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1" />

                            <StackLayout>

                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZSearchParameter}" />

                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            IsReadOnly="True"
                                            InputTransparent="True"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtSearchParameter}"
                                            TextColor="{StaticResource Primary}" />

                                    </custom:CustomSfTextInputView.TextInputView>
                                     <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="PPicker_btn_Clicked" />
                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                </custom:CustomSfTextInputView>

                                <custom:CustomSfPicker
                                    x:Name="PPicker"
                                    Background="white"
                                    IsOpen="False"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectionChanged="PPicker_SelectionChanged">

                                    <syncfusion:SfPicker.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralGreay}" />
                                    </syncfusion:SfPicker.TextStyle>

                                    <syncfusion:SfPicker.Columns>
                                        <syncfusion:PickerColumn
                                            Width="300"
                                            DisplayMemberPath="ParameterType"
                                            ItemsSource="{Binding ParameterTypeList}" />
                                    </syncfusion:SfPicker.Columns>

                                    <syncfusion:SfPicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            TextColor="White" />
                                    </syncfusion:SfPicker.SelectedTextStyle>



                                    <syncfusion:SfPicker.SelectionView>
                                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                    </syncfusion:SfPicker.SelectionView>

                                    <syncfusion:SfPicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="55"
                                            Background="{StaticResource Primary}"
                                            Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                            <syncfusion:PickerHeaderView.TextStyle>
                                                <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                            </syncfusion:PickerHeaderView.TextStyle>
                                        </syncfusion:PickerHeaderView>

                                    </syncfusion:SfPicker.HeaderView>

                                    <syncfusion:SfPicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="{StaticResource NeutralBlack}">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="White" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </syncfusion:SfPicker.FooterView>

                                </custom:CustomSfPicker>

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PPicker_btn_Clicked" />
                                </StackLayout.GestureRecognizers>

                            </StackLayout>

                            <StackLayout>

                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding SelectedParameterType.ParameterType}" />

                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                            MaxLength="{Binding MaxDigids}"
                                            Placeholder="{Binding SelectedParameterType.ParameterType}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding LookupNumber}"
                                            TextColor="{StaticResource Primary}">

                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>

                                        </custom:GAZTBorderlessEntry>

                                    </custom:CustomSfTextInputView.TextInputView>

                                     <inputLayout:SfTextInputLayout.TrailingView>
                                        <Label
                                            Margin="0,0,0,4"
                                            FontSize="Title"
                                            HorizontalOptions="End"
                                            IsEnabled="{Binding IsTooltipEnableVisible}"
                                            IsVisible="{Binding IsTooltipEnableVisible}"
                                            Style="{StaticResource IconLabelStyle}"
                                            Text="{StaticResource Help}"
                                            TextColor="{StaticResource SecondaryNew}"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </inputLayout:SfTextInputLayout.TrailingView>

                                </custom:CustomSfTextInputView>

                            </StackLayout>


                            <Border
                                Margin="0,10,0,10"
                                IsVisible="{Binding IsNameVisible}"
                                Style="{StaticResource GreyBorderFrame}">

                                <StackLayout
                                    Padding="15,10,15,10"
                                    IsVisible="{Binding IsNameVisible}"
                                    Orientation="Horizontal"
                                    Spacing="10">

                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZZTaxPayerName}" />

                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding Name}" />

                                </StackLayout>

                            </Border>

                        </StackLayout>

                        <buttons:SfButton
                            x:Name="btnScan"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZQRScanner}"
                            VerticalOptions="EndAndExpand" />

                        <buttons:SfButton
                            x:Name="btnSearch"
                            Margin="0,20"
                            Command="{Binding OnSearchButtonClicked}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding LookUpButtonText}"
                            VerticalOptions="End" />

                    </StackLayout>

                </ScrollView>
            </Border>

            <!--#region Scan View-->
            <Grid Padding="0,0,0,0"
                  Grid.Row="1"
                  IsVisible="{Binding IsShowScanView}"
                  RowDefinitions="1.2*,*,*,*,*">
                    <Grid
                        x:Name="MainGrid"
                        Grid.RowSpan="5"
                        Margin="0,0,0,0" />

                    <zxing:CameraBarcodeReaderView
                        x:Name="zxing"
                        Grid.RowSpan="5"
                        Margin="0,0,0,0"
                        BackgroundColor="White"
                        BarcodesDetected="zxing_BarcodesDetected" />

                    <Grid Grid.Row="0" HorizontalOptions="FillAndExpand">
                        <Border BackgroundColor="Black" Opacity=".44" />

                        <StackLayout Margin="0,30,0,30">

                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="22"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.ScantheQRcode}"
                                TextColor="White" />

                            <BoxView HeightRequest="30" />
                        </StackLayout>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        Margin="2,0,2,-7"
                        FlowDirection="RightToLeft">
                        <Path
                            Margin="-3,-7,-3,0"
                            Data="M 0,0 L 36,0 36,36Z"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="-90"
                            Stroke="transparent"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-5,-15,-5,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Rotation="-90"
                            Source="Path"
                            VerticalOptions="Start" />
                        <Path
                            Margin="-7,-6,-15,0"
                            Data="M 0,0 L 30,0 30,30Z"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-3,-15,-5,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="-180"
                            Source="Path"
                            VerticalOptions="Start" />

                        <Path
                            Margin="-3,0,-3,-.2"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            Rotation="90"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Source="Path"
                            VerticalOptions="End" />
                        <Path
                            Margin="-3,0,-3,0"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="180"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="90"
                            Source="Path"
                            VerticalOptions="End" />

                    </Grid>


                    <Grid Grid.Row="4" HorizontalOptions="FillAndExpand">
                        <Border BackgroundColor="Black" Opacity=".44" />
                        <StackLayout>
                            <Label
                                Grid.Row="3"
                                Margin="0,40,27,0"
                                HorizontalOptions="CenterAndExpand"
                                TextColor="White">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontFamily="{StaticResource FontSomarBold}" FontSize="24" />
                                        <Span FontSize="16" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border
                                Grid.Row="4"
                                Margin="21,27,27,40"
                                Padding="12"
                                BackgroundColor="Transparent"
                                StrokeShape="RoundRectangle 14,14,14,14">

                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    TextColor="White" />
                            </Border>
                        </StackLayout>
                    </Grid>
            </Grid>

            <!--#endregion-->

            <!--#region Success Result View-->
            <Border
                Grid.Row="1"
                Margin="0"
                Padding="20"
                IsVisible="{Binding IsShowRsltView}"
                Style="{StaticResource CommonTopCurves}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <Image
                                Margin="0,10,0,10"
                                HeightRequest="70"
                                HorizontalOptions="CenterAndExpand"
                                Source="SuccessQr"
                                WidthRequest="70">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Image"
                                        Value="false">
                                        <Setter Property="Source" Value="failQR.png" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Image"
                                        Value="true">
                                        <Setter Property="Source" Value="SuccessQr.png" />
                                    </DataTrigger>
                                </Image.Triggers>

                            </Image>
                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.RegisteredVAT}"
                                TextColor="{StaticResource PrimaryColor}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Label"
                                        Value="false">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.UnregisteredFacility}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Label"
                                        Value="true">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.RegisteredVAT}" />
                                    </DataTrigger>
                                </Label.Triggers>


                            </Label>
                            <Border
                                Margin="0"
                                Padding="0"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8">
                                <StackLayout Margin="16">
                                    <Grid Padding="8,0" ColumnDefinitions="1.25*,*">
                                        <Label
                                            Grid.Row="0"
                                            FontFamily="{StaticResource FontSomarBold}"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource PrimaryColor}" />
                                        <Grid Grid.Column="1" RowDefinitions="auto">
                                            <Border
                                                Padding="0"
                                                BackgroundColor="#62B34F"
                                                StrokeShape="RoundRectangle 14,14,14,14"
                                                Opacity=".1"
                                                VerticalOptions="FillAndExpand">
                                                <Border.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Border"
                                                        Value="false">
                                                        <Setter Property="BackgroundColor" Value="#E84A41" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Border"
                                                        Value="true">
                                                        <Setter Property="BackgroundColor" Value="#62B34F" />
                                                    </DataTrigger>
                                                </Border.Triggers>

                                            </Border>
                                            <Label
                                                Margin="10,3,10,3"
                                                HorizontalOptions="CenterAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.Correct}"
                                                TextColor="#62B34F"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Label"
                                                        Value="false">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Incorrect}" />
                                                        <Setter Property="TextColor" Value="#E84A41" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Label"
                                                        Value="true">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Correct}" />
                                                        <Setter Property="TextColor" Value="#62B34F" />
                                                    </DataTrigger>
                                                </Label.Triggers>

                                            </Label>

                                        </Grid>
                                    </Grid>
                                    <BoxView Style="{StaticResource lineSeperator}" />
                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10"
                                        RowDefinitions="auto,auto">
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VATRegistrationNumber}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            FontSize="14"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding VatNumber}" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.TIN}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontSize="14"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TIN}" />



                                    </Grid>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VATCertificateNumber}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding VATCertificateNumber}" />

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding Region}" />

                                </StackLayout>
                            </Border>

                        </StackLayout>
                    </ScrollView>




                </Grid>

            </Border>
            <!--#endregion-->

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <custom:Header TitleText="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}" />


        </Grid>
    </ContentPage.Content>
</ContentPage>
