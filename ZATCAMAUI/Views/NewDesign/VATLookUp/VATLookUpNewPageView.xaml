<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATLookUp.VATLookUpNewPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    BackgroundImageSource="partials_background.png"
    FlowDirection="LeftToRight"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android, UWP">0</On>
            <On Platform="iOS">0,20,0,0</On>
        </OnPlatform>
    </ContentPage.Padding>

    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">
            <yummy:PancakeView
                Grid.Row="1"
                Margin="0"
                Padding="0"
                IsVisible="{Binding IsMainView}"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="FillAndExpand">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <StackLayout Grid.Row="0">
                        <ScrollView VerticalScrollBarVisibility="Never">
                            <StackLayout Padding="10">
                                <custom:CustomLabel
                                    LineSpacing=".8"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}" />
                                <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZVATLookUpTitleSub}" />
                                <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Padding="0,0,0,0"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZSearchParameter}" />

                                    <inputLayout:SfTextInputLayout
                                        Grid.Row="1"
                                        Margin="0,-6,0,-6"
                                        ContainerType="Outlined"
                                        HasError="False"
                                        OutlineCornerRadius="8"
                                        Stroke="{StaticResource Primary}">
                                        <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <inputLayout:LabelStyle TextColor="#B00020" />
                                        </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <custom:GAZTBorderlessEntry
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtSearchParameter}"
                                            TextColor="{StaticResource Primary}" />
                                    </inputLayout:SfTextInputLayout>
                                    <custom:CustomButton
                                        x:Name="PPicker_btn"
                                        Grid.Row="1"
                                        BackgroundColor="Transparent"
                                        Clicked="PPicker_btn_Clicked"
                                        FontSize="Small" />

                                    <syncfusion:SfPicker
                                        x:Name="PPicker"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Background="white"
                                        ItemHeight="40"
                                        Mode="Dialog"
                                        SelectionChanged="PPicker_SelectionChanged">

                                        <syncfusion:SfPicker.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralGreay}" />
                                        </syncfusion:SfPicker.TextStyle>

                                        <syncfusion:SfPicker.Columns>
                                            <syncfusion:PickerColumn
                                                Width="300"
                                                DisplayMemberPath="ParameterType"
                                                ItemsSource="{Binding ParameterTypeList}" />
                                        </syncfusion:SfPicker.Columns>

                                        <syncfusion:SfPicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.SelectedTextStyle>

                                        <syncfusion:SfPicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" />
                                        </syncfusion:SfPicker.ColumnHeaderView>


                                        <syncfusion:SfPicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="55"
                                                Background="{StaticResource Primary}"
                                                Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </syncfusion:SfPicker.HeaderView>

                                        <syncfusion:SfPicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </syncfusion:SfPicker.FooterView>


                                        <syncfusion:SfPicker.Behaviors>
                                            <behaviors:SfPickerBehavior />
                                        </syncfusion:SfPicker.Behaviors>
                                    </syncfusion:SfPicker>

                                    <StackLayout Grid.Row="2">
                                        <custom:CustomLabel
                                            Padding="0,0,0,0"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding SelectedParameterType.ParameterType}" />
                                        <inputLayout:SfTextInputLayout
                                            x:Name="frmLookupNumner"
                                            Margin="0,-6,0,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            OutlineCornerRadius="8"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                MaxLength="{Binding MaxDigids}"
                                                Placeholder="{Binding SelectedParameterType.ParameterType}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding LookupNumber}"
                                                TextColor="{StaticResource Primary}">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:OnlyNumericValuesBehaviour />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Label
                                                    Margin="0,0,0,4"
                                                    FontSize="Title"
                                                    HorizontalOptions="End"
                                                    IsEnabled="{Binding IsTooltipEnableVisible}"
                                                    IsVisible="{Binding IsTooltipEnableVisible}"
                                                    Style="{StaticResource IconLabelStyle}"
                                                    Text="{StaticResource Help}"
                                                    TextColor="{StaticResource SecondaryNew}"
                                                    VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>

                                    <Border
                                        Grid.Row="3"
                                        Margin="0,10,0,10"
                                        IsVisible="{Binding IsNameVisible}"
                                        Style="{StaticResource GreyBorderFrame}">
                                        <StackLayout
                                            Padding="15,10,15,10"
                                            IsVisible="{Binding IsNameVisible}"
                                            Orientation="Horizontal">
                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZTaxPayerName}" />
                                            <StackLayout HorizontalOptions="StartAndExpand" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Name}" />

                                            </StackLayout>
                                        </StackLayout>
                                    </Border>

                                </Grid>
                            </StackLayout>

                        </ScrollView>

                    </StackLayout>
                    <StackLayout
                        Grid.Row="1"
                        Padding="10,5,10,30"
                        BackgroundColor="White"
                        HorizontalOptions="Center">
                        <buttons:SfButton
                            x:Name="btnScan"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZQRScanner}" />
                        <buttons:SfButton
                            x:Name="btnSearch"
                            Command="{Binding OnSearchButtonClicked}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding LookUpButtonText}" />

                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

            <!--#region Scan View-->
            <yummy:PancakeView
                Grid.Row="1"
                Margin="0"
                Padding="0"
                IsVisible="{Binding IsShowScanView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid Padding="0,0,0,0" RowDefinitions="1.2*,*,*,*,*">
                    <Grid
                        x:Name="MainGrid"
                        Grid.RowSpan="5"
                        Margin="0,0,0,0" />

                    <zxing:CameraBarcodeReaderView
                        x:Name="zxing"
                        Grid.RowSpan="5"
                        Margin="0,0,0,0"
                        BackgroundColor="White"
                        BarcodesDetected="zxing_BarcodesDetected" />

                    <Grid Grid.Row="0" HorizontalOptions="FillAndExpand">
                        <Frame BackgroundColor="Black" Opacity=".44" />

                        <StackLayout Margin="0,30,0,30">

                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="22"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.ScantheQRcode}"
                                TextColor="White" />

                            <BoxView HeightRequest="30" />
                        </StackLayout>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        Margin="2,0,2,-7"
                        FlowDirection="RightToLeft">
                        <Path
                            Margin="-3,-7,-3,0"
                            Data="M 0,0 L 36,0 36,36Z"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="-90"
                            Stroke="transparent"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-5,-15,-5,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Rotation="-90"
                            Source="Path"
                            VerticalOptions="Start" />
                        <Path
                            Margin="-7,-6,-15,0"
                            Data="M 0,0 L 30,0 30,30Z"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-3,-15,-5,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="-180"
                            Source="Path"
                            VerticalOptions="Start" />

                        <Path
                            Margin="-3,0,-3,-.2"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            Rotation="90"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Source="Path"
                            VerticalOptions="End" />
                        <Path
                            Margin="-3,0,-3,0"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="180"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="90"
                            Source="Path"
                            VerticalOptions="End" />

                    </Grid>


                    <Grid Grid.Row="4" HorizontalOptions="FillAndExpand">
                        <Frame BackgroundColor="Black" Opacity=".44" />
                        <StackLayout>
                            <Label
                                Grid.Row="3"
                                Margin="0,40,27,0"
                                HorizontalOptions="CenterAndExpand"
                                TextColor="White">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontFamily="{StaticResource FontSomarBold}" FontSize="24" />
                                        <Span FontSize="16" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Frame
                                Grid.Row="4"
                                Margin="21,27,27,40"
                                Padding="12"
                                BackgroundColor="Transparent"
                                CornerRadius="14"
                                HasShadow="False">

                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    TextColor="White" />
                            </Frame>
                        </StackLayout>
                    </Grid>
                </Grid>
            </yummy:PancakeView>

            <!--#endregion-->
            <!--#region Success Result View-->

            <yummy:PancakeView
                Grid.Row="1"
                Margin="0"
                Padding="20"
                IsVisible="{Binding IsShowRsltView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <Image
                                Margin="0,10,0,10"
                                HeightRequest="70"
                                HorizontalOptions="CenterAndExpand"
                                Source="SuccessQr"
                                WidthRequest="70">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Image"
                                        Value="false">
                                        <Setter Property="Source" Value="failQR.png" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Image"
                                        Value="true">
                                        <Setter Property="Source" Value="SuccessQr.png" />
                                    </DataTrigger>
                                </Image.Triggers>

                            </Image>
                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.RegisteredVAT}"
                                TextColor="{StaticResource PrimaryColor}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Label"
                                        Value="false">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.UnregisteredFacility}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsVatLookUp}"
                                        TargetType="Label"
                                        Value="true">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.RegisteredVAT}" />
                                    </DataTrigger>
                                </Label.Triggers>


                            </Label>
                            <Frame
                                Margin="0"
                                Padding="0"
                                BorderColor="LightGray"
                                CornerRadius="8"
                                HasShadow="False">
                                <StackLayout Margin="16">
                                    <Grid Padding="8,0" ColumnDefinitions="1.25*,*">
                                        <Label
                                            Grid.Row="0"
                                            FontFamily="{StaticResource FontSomarBold}"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource PrimaryColor}" />
                                        <Grid Grid.Column="1" RowDefinitions="auto">
                                            <Frame
                                                Padding="0"
                                                BackgroundColor="#62B34F"
                                                CornerRadius="14"
                                                HasShadow="False"
                                                Opacity=".1"
                                                VerticalOptions="FillAndExpand">
                                                <Frame.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Frame"
                                                        Value="false">
                                                        <Setter Property="BackgroundColor" Value="#E84A41" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Frame"
                                                        Value="true">
                                                        <Setter Property="BackgroundColor" Value="#62B34F" />
                                                    </DataTrigger>
                                                </Frame.Triggers>

                                            </Frame>
                                            <Label
                                                Margin="10,3,10,3"
                                                HorizontalOptions="CenterAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.Correct}"
                                                TextColor="#62B34F"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Label"
                                                        Value="false">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Incorrect}" />
                                                        <Setter Property="TextColor" Value="#E84A41" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsVatLookUp}"
                                                        TargetType="Label"
                                                        Value="true">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Correct}" />
                                                        <Setter Property="TextColor" Value="#62B34F" />
                                                    </DataTrigger>
                                                </Label.Triggers>

                                            </Label>

                                        </Grid>
                                    </Grid>
                                    <BoxView Style="{StaticResource lineSeperator}" />
                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10"
                                        RowDefinitions="auto,auto">
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VATRegistrationNumber}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            FontSize="14"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding VatNumber}" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.TIN}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontSize="14"
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding TIN}" />



                                    </Grid>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VATCertificateNumber}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding VATCertificateNumber}" />

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding Region}" />

                                </StackLayout>
                            </Frame>

                        </StackLayout>
                    </ScrollView>




                </Grid>
            </yummy:PancakeView>

            <!--#endregion-->
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>

            <custom:Header
                Grid.Row="0"
                Padding="0,35,0,10"
                TitleText="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}">
                <custom:Header.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="iOS" Value="0,10,0,10" />
                        <On Platform="Android" Value="0,10,0,10" />
                    </OnPlatform>
                </custom:Header.Padding>

            </custom:Header>
        </Grid>
    </ContentPage.Content>
</ContentPage>
