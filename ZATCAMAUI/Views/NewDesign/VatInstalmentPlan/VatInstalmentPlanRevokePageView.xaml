<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.NewDesign.VatInstalmentPlan.VatInstalmentPlanRevokePageView"
             Title="VatInstalmentPlanRevokePageView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
            xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
            xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Name="page"
            xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
            ios:Page.UseSafeArea="true"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

 <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                    VerticalOptions="Center" />

                <Image  Grid.Row="0" Grid.Column="2"
                        VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"
                        Source="close" 
                        HeightRequest="24"
                        WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseClick}"/>
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                    <Grid RowDefinitions="*">

                         <ScrollView HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
            <Grid
                      BackgroundColor="Transparent"
                      Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="50*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0"
                          Grid.Column="0"
                          Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <custom:CustomLabel Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.VATInstalmentRevok}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            FontSize="28" />
                    <custom:CustomLabel Grid.Row="1"
                                            Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentRevokSubTitle}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Margin="0,0,0,8" />
                    <BoxView Grid.Row="2"
                                 Grid.Column="0"
                                 Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    <listView:SfListView  Grid.Row="3" 
                                              HorizontalOptions="CenterAndExpand"
                                              ScrollBarVisibility="Never"
                                              Margin="0"
                                              Padding="0"
                                              IsScrollingEnabled="False"
                                              VerticalOptions="StartAndExpand"
                                              AutoFitMode="Height"
                                              ItemSpacing="0"
                                              ItemTapped="VATInstalmentRevokeList_ItemTapped"
                                              ItemsSource="{Binding VATInstalmentRevokeList}"
                                              SelectionMode="Single"
                                              SelectionBackground="Transparent">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"  Grid.Column="0" StrokeShape="RoundRectangle 15" Margin="0,15,0,0" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <Grid Padding="0" RowSpacing="0" Margin="0" >
                                        <Grid.RowDefinitions >
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50*" />
                                            <ColumnDefinition Width="50*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <custom:CustomLabel  Grid.Row="0" Grid.ColumnSpan="2"  Text="Reference No." HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource ValueLabelGrey}" Margin="0" />

                                         <Label Grid.Row="0" Grid.Column="1" Text="{Binding Fbnum}" Style="{StaticResource  SectionTitleBlack}"    HorizontalTextAlignment="Start" 
                                               HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"/>
              
                                        

                                        <StackLayout Grid.Row="2"
                                                         Grid.Column="0"
                                                         Spacing="-5">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatInstalmentInstalmentAmount}"
                                                       Style="{StaticResource CaptionLabelGrey}" />
                                            <Label Text="{Binding TotAmt,Converter={StaticResource commaSeparatorConverter}}"
                                                       Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>
                                        <StackLayout Grid.Row="2" 
                                                         Grid.Column="1"
                                                         Spacing="-5">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatDueAmount}"
                                                       Style="{StaticResource CaptionLabelGrey}" />
                                            <Label Text="{Binding DueAmt,Converter={StaticResource commaSeparatorConverter}}"
                                                       Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>

                                        <StackLayout Grid.Row="3"
                                                         Grid.Column="0"
                                                         Spacing="-5">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNumberOfInstalments}"
                                                       Style="{StaticResource CaptionLabelGrey}" />
                                            <Label Text="{Binding PlanDur}"
                                                       Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>
                                        <StackLayout Grid.Row="3"
                                                         Grid.Column="1"
                                                         Spacing="-5"
                                                         HorizontalOptions="FillAndExpand"
                                                         VerticalOptions="FillAndExpand">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDownPaymentAmount}"
                                                       Style="{StaticResource CaptionLabelGrey}" />
                                            <Label Text="{Binding DpAmt,Converter={StaticResource commaSeparatorConverter}}"
                                                       Style="{StaticResource ValueLabelBlack}"
                                                       HorizontalOptions="FillAndExpand"
                                                       VerticalOptions="FillAndExpand" />
                                        </StackLayout>
                                        <StackLayout Grid.Row="4"
                                                         Grid.ColumnSpan="2"
                                                         Spacing="-5">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSubmissionDate}"
                                                       Style="{StaticResource CaptionLabelGrey}" />
                                            <Label Text="{Binding SubmitDt}"
                                                       Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                    </listView:SfListView>


                </Grid>
            </Grid>
        </ScrollView>

                    </Grid>
            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>