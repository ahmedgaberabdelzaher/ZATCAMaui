<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VatInstalmentPlan.VatInstalmentPlanRevokePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="page"
    Title="VatInstalmentPlanRevokePageView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                    VerticalOptions="Center" />

                <Image
                    Grid.Row="0"
                    Grid.Column="2"
                    HeightRequest="24"
                    HorizontalOptions="EndAndExpand"
                    Source="close"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseClick}" />
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">

                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="28"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.VATInstalmentRevok}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentRevokSubTitle}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <listView:SfListView
                                    Grid.Row="3"
                                    Margin="0"
                                    Padding="0"
                                    AutoFitMode="Height"
                                    HorizontalOptions="CenterAndExpand"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="0"
                                    ItemTapped="VATInstalmentRevokeList_ItemTapped"
                                    ItemsSource="{Binding VATInstalmentRevokeList}"
                                    ScrollBarVisibility="Never"
                                    SelectionBackground="Transparent"
                                    SelectionMode="Single"
                                    VerticalOptions="StartAndExpand">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Grid.Column="0"
                                                Margin="0,15,0,0"
                                                Padding="10"
                                                StrokeShape="RoundRectangle 15"
                                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                                <Grid
                                                    Margin="0"
                                                    Padding="0"
                                                    RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*" />
                                                        <ColumnDefinition Width="50*" />
                                                    </Grid.ColumnDefinitions>

                                                    <custom:CustomLabel
                                                        Grid.Row="0"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="Reference No." />

                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{Binding Fbnum}"
                                                        VerticalOptions="CenterAndExpand" />



                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Spacing="-5">
                                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentInstalmentAmount}" />
                                                        <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding TotAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Spacing="-5">
                                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatDueAmount}" />
                                                        <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding DueAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.Column="0"
                                                        Spacing="-5">
                                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNumberOfInstalments}" />
                                                        <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding PlanDur}" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        HorizontalOptions="FillAndExpand"
                                                        Spacing="-5"
                                                        VerticalOptions="FillAndExpand">
                                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDownPaymentAmount}" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding DpAmt, Converter={StaticResource commaSeparatorConverter}}"
                                                            VerticalOptions="FillAndExpand" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="4"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="-5">
                                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSubmissionDate}" />
                                                        <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding SubmitDt}" />
                                                    </StackLayout>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>

                                </listView:SfListView>


                            </Grid>
                        </Grid>
                    </ScrollView>

                </Grid>
            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>