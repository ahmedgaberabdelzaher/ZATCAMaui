<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZATCAMAUI.Views.NewDesign.VatInstalmentPlan.VATInstalmentPopupRevokePageView"
             Title="VATInstalmentPopupRevokePageView"
             xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
            xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
            x:Name="page"
            ios:Page.UseSafeArea="true"
            xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
            xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
            BackgroundImageSource="partials_background.png"
            FlowDirection="{Binding AppDirection}"
            NavigationPage.HasNavigationBar="False">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>
       <Grid 
            BackgroundColor="White"
            Margin="20,10,20,0"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                Grid.Column="0"
                Text="{x:Static ResourceManager:AppResources.VATInstalmentRevok}"
                HorizontalOptions="StartAndExpand"
                Style="{StaticResource SectionTitleBlackBold}"
                FontSize="28" />

            <Label Grid.Row="1"
                Grid.Column="0"
                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentRevokSubTitle}"
                HorizontalOptions="StartAndExpand"
                Style="{StaticResource BodyLabelGrey}"
                Margin="0,0,0,8" />

            <BoxView Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

        </Grid>
    </Grid>
</Mopups:PopupPage>