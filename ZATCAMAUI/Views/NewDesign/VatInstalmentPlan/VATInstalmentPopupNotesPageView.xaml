<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VatInstalmentPlan.VATInstalmentPopupNotesPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    Title="VATInstalmentPopupNotesPageView"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>


    <Border
        Padding="15,0,15,0"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Confirmation  -->
            <StackLayout
                x:Name="Confirmation"
                Grid.Row="0"
                IsVisible="{Binding IsConfirmationPageVisible}"
                >
                <StackLayout
                    Margin="0,16,0,0"
                    HorizontalOptions="StartAndExpand"
                    Orientation="Horizontal">
                    <Image
                        Margin="0,0,5,0"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <Label
                        FontSize="15"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.ZZZConfirmationMsg}"
                        VerticalOptions="CenterAndExpand" />

                </StackLayout>

                <ScrollView
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        Margin="0,16,0,0"
                        Padding="5,0,5,0"
                        >
                        <Border
                            Grid.Row="0"
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">

                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineHeight="1"
                                    Style="{StaticResource TCBodyLabelGrey}"
                                    Text="{Binding VATRevokeMessage}" />
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                        </Grid>

                    </StackLayout>
                </ScrollView>


            </StackLayout>
            <!--  Notes  -->
            <StackLayout
                x:Name="Notes"
                Grid.Row="1"
                IsVisible="{Binding NotesPageVisible}"
                >

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Label
                        Grid.Row="0"
                        FontSize="15"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.RevokeNotes}" />

                    <cards:SfCardView
                        Grid.Row="2"
                        Margin="10"
                        Padding="10,0,10,0"
                        BorderColor="Gray"
                        BorderWidth="0.2"
                        CornerRadius="15"
                        HeightRequest="150"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">
                        <Editor
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            Text="{Binding NoteEditor}"
                            VerticalOptions="FillAndExpand" />
                    </cards:SfCardView>

                </Grid>

            </StackLayout>
            <!--  OTP  -->
            <StackLayout
                x:Name="OTP"
                Grid.Row="2"
                IsVisible="{Binding IsOtpPageVisible}"
                >
                <StackLayout
                    Margin="0,16,0,0"
                    HorizontalOptions="StartAndExpand"
                    Orientation="Horizontal">
                    <Image
                        Margin="0,0,5,0"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <Label
                        FontSize="15"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VerificationCode}"
                        VerticalOptions="CenterAndExpand" />

                </StackLayout>
                <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.OTPSentToMobile}" />

                <Label Style="{StaticResource BodyLabelGrey}" Text="{Binding MobileNumber}" />


                <StackLayout Padding="0,15,0,0">

                    <StackLayout Orientation="Horizontal">

                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.VRApplicationNumber}" />
                        <Label Style="{StaticResource BodyLabelGrey}" Text="{Binding ApplicationNumber}" />
                    </StackLayout>


                    <StackLayout Padding="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Row="0"
                                Padding="30,20,30,20"
                                ColumnSpacing="20"
                                FlowDirection="LeftToRight">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>



                                <!--  First OTP Digit Start  -->
                                <Border
                                    Grid.Column="0"
                                    HeightRequest="50"
                                    Stroke="Gray"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Start"
                                    WidthRequest="50">

                                    <custom:GAZTBorderlessEntry
                                        x:Name="OTPFirstEntry"
                                        FontAttributes="Bold"
                                        FontSize="Small"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        Keyboard="{OnPlatform Android=Numeric,
                                                              iOS=Default}"
                                        MaxLength="1"
                                        ReturnType="Next"
                                        Text="{Binding OTPFirstDigit}"
                                        TextChanged="OtpFirstEntry_TextChanged"
                                        TextColor="#bbbbbb"
                                        WidthRequest="100">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behavior:OnlyNumericValuesBehaviour />
                                            <behavior:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </Border>
                                <!--  First OTP Digit End  -->

                                <!--  Second OTP Digit Start  -->
                                <Border
                                    Grid.Column="1"
                                    HeightRequest="50"
                                    Stroke="Gray"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Start"
                                    WidthRequest="50">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="OTPSecondEntry"
                                        FontAttributes="Bold"
                                        FontSize="Small"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                        Keyboard="{OnPlatform Android=Numeric,
                                                              iOS=Default}"
                                        MaxLength="1"
                                        ReturnType="Next"
                                        Text="{Binding OTPSecondDigit}"
                                        TextChanged="OtpSecondEntry_TextChanged"
                                        TextColor="#bbbbbb"
                                        WidthRequest="100">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behavior:OnlyNumericValuesBehaviour />
                                            <behavior:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </Border>
                                <!--  Second OTP Digit End  -->

                                <!--  Third OTP Digit Start  -->
                                <Border
                                    Grid.Column="2"
                                    HeightRequest="50"
                                    Stroke="Gray"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Start"
                                    WidthRequest="50">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="OTPThirdEntry"
                                        FontAttributes="Bold"
                                        FontSize="Small"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                        Keyboard="{OnPlatform Android=Numeric,
                                                              iOS=Default}"
                                        MaxLength="1"
                                        ReturnType="Next"
                                        Text="{Binding OTPThirdDigit}"
                                        TextChanged="OtpThirdEntry_TextChanged"
                                        TextColor="#bbbbbb"
                                        WidthRequest="100">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behavior:OnlyNumericValuesBehaviour />
                                            <behavior:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </Border>
                                <!--  Third OTP Digit End  -->

                                <!--  Fourth OTP Digit Start  -->
                                <Border
                                    Grid.Column="3"
                                    HeightRequest="50"
                                    Stroke="Gray"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Start"
                                    WidthRequest="50">
                                    <custom:GAZTBorderlessEntry
                                        x:Name="OTPFourthEntry"
                                        FontAttributes="Bold"
                                        FontSize="Small"
                                        HorizontalOptions="CenterAndExpand"
                                        HorizontalTextAlignment="Center"
                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                        Keyboard="{OnPlatform Android=Numeric,
                                                              iOS=Default}"
                                        MaxLength="1"
                                        ReturnType="Next"
                                        Text="{Binding OTPFourthDigit}"
                                        TextColor="#bbbbbb"
                                        WidthRequest="100">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behavior:OnlyNumericValuesBehaviour />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                    </custom:GAZTBorderlessEntry>
                                </Border>
                                <!--  Fourth OTP Digit End  -->



                            </Grid>

                            <Label
                                Grid.Row="1"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.AccountLocked}" />

                        </Grid>
                    </StackLayout>

                    <StackLayout HorizontalOptions="Center" Orientation="Horizontal">
                        <Image Source="clock" />
                        <Label
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{Binding LblCountDownTimer}"
                            VerticalOptions="Center" />
                    </StackLayout>
                    <buttons:SfButton
                        Margin="0,50,0,0"
                        Background="Transparent"
                        Command="{Binding OnResendOTPClicked}"
                        IsEnabled="{Binding IsResendOTPEnabled}"
                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                        TextColor="{Binding ResendOTPTextColor}"
                        VerticalOptions="EndAndExpand" />
                </StackLayout>
            </StackLayout>

            <buttons:SfButton
                Grid.Row="4"
                Grid.Column="0"
                Margin="0,5,0,5"
                Command="{Binding CancelButton}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZZCancel}"
                VerticalOptions="End" />
            <buttons:SfButton
                Grid.Row="5"
                Grid.Column="0"
                Margin="0,5,0,5"
                Command="{Binding ContinueClick}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{Binding NextSubmitText}"
                VerticalOptions="End" />
        </Grid>

    </Border>




</Mopups:PopupPage>