                                                                WidthRequest="25" />
                                                        </StackLayout>
                                                        <StackLayout
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Spacing="-2">
                                                            <Label
                                                                HorizontalOptions="End"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="FillAndExpand" />
                                                        </StackLayout>
                                                    </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </StackLayout>
                                </Border>

                            </Grid>


                            <Grid Grid.Row="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0">
                                    <Border
                                        Grid.Row="0"
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}">
                                        <Grid Padding="10,3,10,2" HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>



                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding MonthlyInstalment, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0">
                                    <Border
                                        Grid.Row="0"
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}">
                                        <StackLayout
                                            Padding="10,3,10,2"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.VatInstalmentAgrPenalty}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding VATPenalityAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                        </StackLayout>
                                    </Border>
                                </Grid>



                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0">

                                    <Border
                                        Grid.Row="0"
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}">
                                        <StackLayout
                                            Padding="10,3,10,2"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetTotalAmount}" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding VATBillDueAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                        </StackLayout>
                                    </Border>
                                </Grid>

                                <Grid
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,10">

                                    <StackLayout>

                                        <buttons:SfButton
                                            x:Name="SummarybtnContinue"
                                            Margin="0,16,0,16"
                                            Command="{Binding SummaryContinueBtnTapped}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.Submit}" />

                                    </StackLayout>
                                </Grid>
                            </Grid>

                        </Grid>


                    </Grid>

                </ScrollView>

            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>
