<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VatInstalmentPlan.VatInstalmentPlanPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

        </ResourceDictionary>


    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                    VerticalOptions="Center" />

                <StackLayout
                    Grid.Column="2"
                    HorizontalOptions="EndAndExpand"
                    Orientation="Horizontal"
                    Rotation="90"
                    Spacing="3"
                    VerticalOptions="CenterAndExpand">
                    <BoxView
                        BackgroundColor="{StaticResource SecondaryNew}"
                        CornerRadius="3"
                        HeightRequest="5"
                        WidthRequest="5" />
                    <BoxView
                        BackgroundColor="{StaticResource SecondaryNew}"
                        CornerRadius="3"
                        HeightRequest="5"
                        WidthRequest="5" />
                    <BoxView
                        BackgroundColor="{StaticResource SecondaryNew}"
                        CornerRadius="3"
                        HeightRequest="5"
                        WidthRequest="5" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding onMoreOptionClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>


            </Grid>
            <!--#endregion Header-->

            <Border
                Grid.Row="1"
                Padding="15"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">

                    <Grid Grid.Row="0">

                        <!--  Code for Zakat & VAT options  -->
                        <Grid
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsSelectionViewEnabled}"
                            RowDefinitions="auto,auto,*"
                            RowSpacing="10"
                            VerticalOptions="FillAndExpand">


                            <commonView:PageIndicatorView
                                Margin="20,25,0,0"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />

                            <Grid Grid.Row="1" RowDefinitions="auto,auto">

                                <Label
                                    Padding="0,5,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPlan}" />

                                <BoxView
                                    Grid.Row="2"
                                    HeightRequest="1"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            </Grid>

                            <Grid Grid.Row="2" VerticalOptions="StartAndExpand">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,10,0,0">

                                    <Border Padding="10" Style="{StaticResource SfStyleGreyBorderFrame}">
                                        <StackLayout Orientation="Horizontal">

                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.VATAmountDue}"
                                                VerticalOptions="Center" />

                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource SectionTitleBlack}"
                                                Text="{Binding VATDueAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}"
                                                VerticalOptions="Center" />

                                        </StackLayout>
                                    </Border>

                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,10,0,10"
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <Grid Margin="8">
                                        <StackLayout Orientation="Vertical">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Row="0" Grid.Column="0 ">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                            Size="24"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>

                                                </Image>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.Information}" />
                                            </Grid>
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VatDueAmountInstruction}"
                                                VerticalOptions="Fill" />

                                        </StackLayout>
                                    </Grid>
                                </Border>

                                <Grid
                                    Grid.Row="2"
                                    Margin="0,10,0,10"
                                    ColumnSpacing="10"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <custom:CheckboxCustom
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        IsChecked="{Binding IsFirstCheckboxChecked}"
                                        Style="{StaticResource CheckboxHeightWidth32}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Label Grid.Row="0" Grid.Column="1">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.VatInstalmentContinueCheckboxText}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFirstCheckboxChecked}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding IsFirstCheckboxChecked}"
                                                TargetType="Label"
                                                Value="False">
                                                <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>


                                <buttons:SfButton
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,10,0,20"
                                    Background="{Binding IsSelectionContinueBackGroundColor}"
                                    Command="{Binding ReasonContinueBtnTapped}"
                                    IsEnabled="{Binding IsFirstCheckboxChecked}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

                            </Grid>
                        </Grid>

                        <!--  Code for VAT Agreeemtns  -->
                        <Grid
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsAgreementViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <commonView:PageIndicatorView
                                    Margin="20,25,0,0"
                                    Completed="{Binding MarkComplete}"
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}"
                                    VerticalOptions="CenterAndExpand" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="0,5,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VATInstalmentAgrement}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATInstalmetRequestInstalmentDesc}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    HeightRequest="1"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                            </Grid>

                            <Grid Grid.Row="2">

                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSchedule}" />

                            </Grid>

                            <Grid Grid.Row="3" Margin="0,10,0,0">

                                <cards:SfCardView CornerRadius="20">
                                    <StackLayout Padding="10">

                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" />

                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}"
                                            Text="{Binding NoOfInstalments}" />

                                        <Border
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 10,10,10,10">
                                            <StackLayout>
                                                <Slider
                                                    Margin="5,5,5,10"
                                                    IsEnabled="{Binding IsViewEnable}"
                                                    Maximum="{Binding MaxInstalments}"
                                                    MaximumTrackColor="LightSlateGray"
                                                    Minimum="{Binding MinInstalments}"
                                                    MinimumTrackColor="{StaticResource Primary}"
                                                    ThumbColor="{StaticResource Primary}"
                                                    ValueChanged="Installment_ValueChanged"
                                                    Value="{Binding NoOfInstalments}" />

                                            </StackLayout>
                                        </Border>
                                        <StackLayout Padding="10" Orientation="Horizontal">


                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding MinInstalmentsTitle}"
                                                VerticalTextAlignment="Center" />



                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding MaxInstalmentsTitle}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </StackLayout>
                                </cards:SfCardView>

                            </Grid>

                            <Grid
                                Grid.Row="4"
                                Margin="0,10,0,10"
                                VerticalOptions="End">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Margin="0,20,0,0"
                                    Padding="0"
                                    StrokeShape="RoundRectangle 12,12,12,12"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="False"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">
                                    <StackLayout
                                        Padding="10,3,10,2"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}" />
                                        <Label
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlack}"
                                            Text="{Binding TotalAmountSAR, Converter={StaticResource commaSeparatorConverter}}" />
                                    </StackLayout>
                                </Border>

                                <Grid Grid.Row="1">

                                    <buttons:SfButton
                                        Margin="0,16,0,16"
                                        Command="{Binding AggrementContinueBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDetails}" />

                                </Grid>
                            </Grid>

                        </Grid>

                        <!--  Code for Zakat & VAT Attachments  -->
                        <Grid
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsAttachmentsViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <commonView:PageIndicatorView
                                    Margin="20,25,0,0"
                                    Completed="{Binding MarkComplete}"
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}"
                                    VerticalOptions="CenterAndExpand" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="0,5,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAttachments}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentPleaseProvideWithSupportingDocuments}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,15,0,0"
                                    HeightRequest="1"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0">
                                <listView:SfListView
                                    x:Name="attachmentsListView"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding AttachmentsListViewData}"
                                    ScrollBarVisibility="Never"
                                    SelectionBackground="Transparent"
                                    SelectionChanged="attachmentsListView_SelectionChanged"
                                    SelectionMode="SingleDeselect"
                                    TapCommand="{Binding NewAttachmentTapped}"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Border
                                                    Grid.Row="0"
                                                    Margin="0,0,0,10"
                                                    Padding="12"
                                                    Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="5,0"
                                                            HeightRequest="25"
                                                            HorizontalOptions="Start"
                                                            Source="Generic_attachment_icon"
                                                            VerticalOptions="Center"
                                                            WidthRequest="25" />

                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="Center" />
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="2"
                                                            HorizontalOptions="Center"
                                                            Rotation="90"
                                                            VerticalOptions="Center">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                    Size="24"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </Border>


                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>

                            <Grid
                                Grid.Row="3"
                                Grid.Column="0"
                                HorizontalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource MicroGrayLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.FDANewAttachment}" />
                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,10"
                                    Padding="10"
                                    Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="Small"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                            TextColor="{StaticResource PrimaryColor}" />
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="Center"
                                            Rotation="90"
                                            VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                    Size="24"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </Border>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                </Grid.GestureRecognizers>

                            </Grid>
                            <Grid
                                Grid.Row="4"
                                Grid.Column="0"
                                VerticalOptions="End">
                                <StackLayout>
                                    <buttons:SfButton
                                        x:Name="btnAttachmentContinue"
                                        Margin="0,16"
                                        Command="{Binding AttachmentsContinueBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}" />
                                </StackLayout>
                            </Grid>

                        </Grid>

                        <!--  Code for VAT Bill selection  -->
                        <Grid
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsVATBillsViewEnabled}"
                            VerticalOptions="FillAndExpand">

                            <listView:SfListView
                                x:Name="BillsVATListVIew"
                                AutoFitMode="DynamicHeight"
                                HorizontalOptions="FillAndExpand"
                                ItemSpacing="10"
                                ItemTapped="Bills_ItemTapped"
                                SelectionBackground="Transparent"
                                SelectionChanging="listView_SelectionChanging"
                                SelectionMode="Multiple"
                                VerticalOptions="FillAndExpand">


                                <listView:SfListView.HeaderTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ViewCell.View>

                                                <Grid RowDefinitions="auto,auto,auto,auto,auto">

                                                    <commonView:PageIndicatorView
                                                        Margin="20,25,0,0"
                                                        Completed="{Binding MarkComplete}"
                                                        DotSize="12"
                                                        HorizontalOptions="End"
                                                        MaxNum="{Binding MaxIndex}"
                                                        MinNum="{Binding CurrentIndex}"
                                                        VerticalOptions="CenterAndExpand" />

                                                    <Label
                                                        Grid.Row="1"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource PageTitleBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.ZakatSelectBillsPageViewSelectBills}" />

                                                    <Label
                                                        Grid.Row="2"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZakatSelectBillsPageViewSelectBillsGray}" />

                                                    <BoxView
                                                        Grid.Row="3"
                                                        HeightRequest="1"
                                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                    <Border
                                                        Grid.Row="4"
                                                        Margin="0,15"
                                                        Padding="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        Stroke="Gray"
                                                        StrokeShape="RoundRectangle 12,12,12,12"
                                                        VerticalOptions="FillAndExpand">

                                                        <SearchBar
                                                            Margin="0"
                                                            HorizontalOptions="FillAndExpand"
                                                            HorizontalTextAlignment="Center"
                                                            Placeholder="{x:Static ResourceManager:AppResources.VatInstalmentSearchPlaceholder}"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{Binding InputData}"
                                                            TextChanged="SearchItem_PropertyChanged"
                                                            VerticalOptions="FillAndExpand" />

                                                    </Border>

                                                </Grid>

                                            </ViewCell.View>
                                        </ViewCell>
                                    </DataTemplate>
                                </listView:SfListView.HeaderTemplate>

                                <listView:SfListView.FooterTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ViewCell.View>

                                                <Grid RowDefinitions="auto,*">
                                                    <Border
                                                        Margin="0,10,0,0"
                                                        Padding="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        StrokeShape="RoundRectangle 12,12,12,12"
                                                        Style="{StaticResource SfStyleForZakatPlanGreen}"
                                                        VerticalOptions="FillAndExpand">

                                                        <StackLayout
                                                            Padding="10,3"
                                                            HorizontalOptions="FillAndExpand"
                                                            Orientation="Horizontal"
                                                            VerticalOptions="FillAndExpand">
                                                            <Label
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{x:Static ResourceManager:AppResources.VatInstalmentTotalBillsSelected}"
                                                                VerticalOptions="CenterAndExpand" />
                                                            <Label
                                                                HorizontalOptions="EndAndExpand"
                                                                Style="{StaticResource SectionTitleBlack}"
                                                                Text="{Binding TotalAmountSAR}"
                                                                VerticalOptions="CenterAndExpand" />
                                                        </StackLayout>
                                                    </Border>

                                                    <buttons:SfButton
                                                        x:Name="btnVATBillsContinue"
                                                        Grid.Row="1"
                                                        Margin="0,16,0,80"
                                                        Background="{Binding IsBillContinueBackGroundColor}"
                                                        Command="{Binding BillContinueBtnTapped}"
                                                        IsEnabled="{Binding IsBillContinueEnabled}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}" />

                                                </Grid>

                                            </ViewCell.View>
                                        </ViewCell>
                                    </DataTemplate>
                                </listView:SfListView.FooterTemplate>

                                <listView:SfListView.ItemTemplate>

                                    <DataTemplate>
                                        <cards:SfCardView BackgroundColor="Transparent" CornerRadius="10">

                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Image
                                                    Aspect="AspectFill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="vat_tile_IbanCard_background_white"
                                                    VerticalOptions="FillAndExpand" />
                                                <Grid
                                                    Padding="10"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Label
                                                        Grid.Row="0"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource SectionTitleBlack}"
