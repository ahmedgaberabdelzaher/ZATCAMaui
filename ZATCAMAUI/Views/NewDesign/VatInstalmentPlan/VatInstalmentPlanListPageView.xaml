                            SelectionBackground="Transparent"
                            SelectionMode="Single"
                            VerticalOptions="Center">
                            <listView:SfListView.ItemTemplate>



                                <DataTemplate>
                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0" Spacing="0">
                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Spacing="-5">
                                                    <Label
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentAgreementNumber}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding AgreementNo}" />
                                                </StackLayout>

                                            </Grid>
                                            <BoxView
                                                BackgroundColor="LightGray"
                                                HeightRequest="1"
                                                HorizontalOptions="FillAndExpand" />
                                            <Grid Padding="10,10,10,10" RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Spacing="-5">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentMonthlyInstallment}" />
                                                    <custom:CustomLabel>
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding InstalmentAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="-5">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalAmountRemaining}" />
                                                    <custom:CustomLabel>
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding RemainingAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.ColumnSpan="2"
                                                    Spacing="-5">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentRelevantTax}" />
                                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding PeriodText}" />
                                                </StackLayout>
                                            </Grid>



                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                        <custom:CustomLabel
                            x:Name="NoDataLable"
                            Grid.Row="0"
                            HorizontalOptions="Center"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ZZZVatNoData}" />
                    </Grid>
                </Grid>

                <!--  Display Details Page  -->

                <Grid
                    Margin="20,0,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsDisplayDetailsVisible}"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>

                        <custom:CustomLabel
                            Grid.Row="0"
                            FontSize="28"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            Text="{x:Static ResourceManager:AppResources.VATCertificates}" />
                        <custom:CustomLabel
                            Grid.Row="1"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentDisplayInstalmentSchedule}">

                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.VATInstalmentAgreementNumber}" />
                                    <Span Text=": " />
                                    <Span Text="{Binding AgreementNumber}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <BoxView Grid.Row="2" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    </Grid>



                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <listView:SfListView
                            x:Name="VATInstalmentDisplayDetailsViewPage"
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Margin="0"
                            Padding="0"
                            AutoFitMode="Height"
                            HorizontalOptions="CenterAndExpand"
                            IsScrollingEnabled="False"
                            ItemSpacing="0"
                            ItemsSource="{Binding RequestForScheduleDetails}"
                            ScrollBarVisibility="Never"
                            SelectionBackground="Transparent"
                            SelectionMode="Single"
                            VerticalOptions="Center">
                            <listView:SfListView.ItemTemplate>

                                <DataTemplate>
                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0" Spacing="0">
                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Spacing="-10">
                                                    <Label
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.Instalment}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding NoOfMonths}" />
                                                </StackLayout>
                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="10,5,10,5"
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource GreyBorderFrameWithShadow}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="Center"
                                                        Style="{StaticResource SmallGoldLabelStyle}"
                                                        Text="{Binding Status}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </Border>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="CenterAndExpand"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                TargetType="Label"
                                                                Value="{x:Static ResourceManager:AppResources.VATInstalmentStatusRefunded}">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATInstalmentStatusRefunded}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                TargetType="Label"
                                                                Value="{x:Static ResourceManager:AppResources.VATInstalementStatusInProcess}">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATInstalementStatusInProcess}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Secondary}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </StackLayout>

                                            </Grid>
                                            <BoxView
                                                BackgroundColor="LightGray"
                                                HeightRequest="1"
                                                HorizontalOptions="FillAndExpand" />
                                            <Grid Padding="10,10,10,10" RowSpacing="15">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Spacing="-5">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentMonthlyInstallment}" />
                                                    <custom:CustomLabel HorizontalOptions="StartAndExpand">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding InstalmentAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="-5">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentAmountRemaining}" />
                                                    <custom:CustomLabel HorizontalOptions="StartAndExpand">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding RemainingAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Spacing="-5">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalAmountPaid}" />
                                                    <custom:CustomLabel HorizontalOptions="StartAndExpand">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalPaidAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Spacing="-5">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}" />
                                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding DueDate}" />
                                                </StackLayout>

                                            </Grid>

                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>

                    </Grid>

                    <StackLayout
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,10,0,0">
                        <Frame
                            Grid.Row="0"
                            Margin="0,20,0,0"
                            Padding="0"
                            CornerRadius="12"
                            HasShadow="False"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource SfStyleForZakatPlanGreen}">
                            <Grid Padding="10,10,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel
                                    Grid.Column="0"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VATInstalmentPlanListTotalNumberOfMonths}" />
                                <custom:CustomLabel
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding ScheduleNoOfMonths}" />
                            </Grid>

                        </Frame>
                    </StackLayout>
                    <StackLayout
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Margin="0,10,0,0"
                        IsVisible="False">
                        <Frame
                            Grid.Row="0"
                            Margin="0,20,0,0"
                            Padding="0"
                            CornerRadius="12"
                            HasShadow="False"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource SfStyleForZakatPlanGreen}">
                            <Grid Padding="10,10,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VATInstalmentPlanListTotalMonthlyInstalments}" />
                                <custom:CustomLabel
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding ScheduleMonthlyInstalment}" />
                            </Grid>
                        </Frame>
                    </StackLayout>
                    <StackLayout
                        Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Margin="0,10,0,0">
                        <Frame
                            Grid.Row="0"
                            Margin="0,20,0,0"
                            Padding="0"
                            CornerRadius="12"
                            HasShadow="False"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource SfStyleForZakatPlanGreen}">
                            <Grid Padding="10,10,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel
                                    Grid.Column="0"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalAmountPaid}" />

                                <custom:CustomLabel Grid.Column="1" HorizontalOptions="EndAndExpand">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding ScheduleTotalAmountPaid, Converter={StaticResource commaSeparatorConverter}}" />
                                            <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                            <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                            </Grid>
                        </Frame>
                    </StackLayout>
                    <StackLayout
                        Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Margin="0,10,0,20">
                        <Frame
                            Grid.Row="0"
                            Margin="0,20,0,0"
                            Padding="0"
                            CornerRadius="12"
                            HasShadow="False"
                            HorizontalOptions="FillAndExpand"
                            Style="{StaticResource SfStyleForZakatPlanGreen}">
                            <Grid Padding="10,10,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalAmountRemaining}" />

                                <custom:CustomLabel
                                    Grid.Column="1"
                                    HorizontalOptions="EndAndExpand"
                                    VerticalOptions="CenterAndExpand">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding ScheduleAmountRemaining, Converter={StaticResource commaSeparatorConverter}}" />
                                            <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                            <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                            </Grid>
                        </Frame>
                    </StackLayout>

                </Grid>


                <!--  Loadig Indiacatr  -->


                <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Black"
                        Opacity="0.4"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="15,15"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Opacity="0.8"
                        Orientation="Vertical"
                        VerticalOptions="Center">
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <busyindicator:SfBusyIndicator
                                x:Name="busyindicatorForLanding"
                                HorizontalOptions="CenterAndExpand"
                                IsRunning="True"
                                AnimationType="Cupertino"
                                SizeFactor="0.6"
                                WidthRequest="70"
                                HeightRequest="70"
                                IndicatorColor="{StaticResource Secondary}"
                                TitlePlacement="Bottom"
                                VerticalOptions="CenterAndExpand" />
                        </StackLayout>
                    </StackLayout>
                </Grid>



            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>

