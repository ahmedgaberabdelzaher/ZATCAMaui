<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRefunds.VATRefundDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    x:Name="VATRefundDetails"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegetiveToPositiveValueConverter x:Key="negetiveToPositiveValueConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VATRefundDetails}"
                    VerticalOptions="Center" />

                <Image
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalOptions="End"
                    Source="close"
                    VerticalOptions="Center">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsNewReqSummary}"
                            TargetType="Image"
                            Value="true">
                            <Setter Property="IsVisible" Value="true" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsNewReqSummary}"
                            TargetType="Image"
                            Value="false">
                            <Setter Property="IsVisible" Value="false" />
                        </DataTrigger>
                    </Image.Triggers>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VoidButton_Tapped" />
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid>

                    <ScrollView
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <Grid
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Grid.Row="0"
                                Margin="10"
                                Padding="0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="true"
                                VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2">
                                    <Grid.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsNewReqSummary}"
                                            TargetType="Grid"
                                            Value="true">
                                            <Setter Property="IsVisible" Value="false" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsNewReqSummary}"
                                            TargetType="Grid"
                                            Value="false">
                                            <Setter Property="IsVisible" Value="true" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="Fill">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            BackgroundColor="Transparent">
                                            <Label
                                                FontSize="15"
                                                Style="{StaticResource PageTitleBlack}"
                                                Text="{x:Static ResourceManager:AppResources.VATRefund}" />
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                IsVisible="{Binding VatRefundsListResultModel.IsEditable}"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRReviewInformation}" />
                                            <Label
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{Binding VATRefundsHeaderSet.RefundFbnum}">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding VatRefundsListResultModel.IsEditable}"
                                                        TargetType="Label"
                                                        Value="false">
                                                        <Setter Property="IsVisible" Value="true" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding VatRefundsListResultModel.IsEditable}"
                                                        TargetType="Label"
                                                        Value="true">
                                                        <Setter Property="IsVisible" Value="false" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                        </StackLayout>
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="10,10,10,10"
                                            BackgroundColor="{StaticResource Secondary}"
                                            HeightRequest="20"
                                            HorizontalOptions="CenterAndExpand"
                                            IsVisible="true"
                                            Opacity=".2"
                                            StrokeShape="RoundRectangle 14,14,14,14"
                                            StrokeThickness="1"
                                            VerticalOptions="Center"
                                            WidthRequest="80">

                                            <Border.Triggers>
                                                <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                <DataTrigger
                                                    Binding="{Binding VATRefundsHeaderSet.Status}"
                                                    TargetType="Border"
                                                    Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding VatRefundsListResultModel.IsEditable}"
                                                    TargetType="Border"
                                                    Value="false">
                                                    <Setter Property="IsVisible" Value="true" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding VatRefundsListResultModel.IsEditable}"
                                                    TargetType="Border"
                                                    Value="true">
                                                    <Setter Property="IsVisible" Value="false" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="15,0"
                                            HorizontalOptions="EndAndExpand"
                                            IsVisible="true"
                                            VerticalOptions="Center"
                                            WidthRequest="80">
                                            <Label
                                                HorizontalOptions="CenterAndExpand"
                                                MaxLines="1"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding VATRefundsHeaderSet.Status}"
                                                TextColor="{StaticResource Secondary}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                    <DataTrigger
                                                        Binding="{Binding VATRefundsHeaderSet.Status}"
                                                        TargetType="Label"
                                                        Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding VatRefundsListResultModel.IsEditable}"
                                                        TargetType="Label"
                                                        Value="false">
                                                        <Setter Property="IsVisible" Value="true" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding VatRefundsListResultModel.IsEditable}"
                                                        TargetType="Label"
                                                        Value="true">
                                                        <Setter Property="IsVisible" Value="false" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Grid>

                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,16,0,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0">
                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="amount"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />

                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRefundAmounts}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <Grid Margin="8,0,8,8" Padding="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />

                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRefundsReassesmentAmount}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding VATRefundsHeaderSet.ReassessAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                                <StackLayout Grid.Row="1" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRefundsTotalOffset}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="1" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding VATRefundsHeaderSet.OffsetTot, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                                <StackLayout Grid.Row="2" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRefundsNetCreditBalance}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="2" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding VATRefundsHeaderSet.NetCreditBal, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                                <Border
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                  
                                                    BackgroundColor="{StaticResource Primary}"
                                                    HeightRequest="55"
                                                    HorizontalOptions="FillAndExpand"
                                                    Opacity="0.1"
                                                    StrokeShape="RoundRectangle 15,15,15,15" />
                                                <StackLayout
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Padding="0,10,0,0"
                                                    Margin="10,2"
                                                    Orientation="Horizontal"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        MaxLines="2"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRefundsRequestedAmount}"
                                                        WidthRequest="90" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Padding="0,10,0,0"
                                                    HorizontalOptions="End"
                                                    Orientation="Horizontal"
                                                    VerticalOptions="Center">
                                                    <Label HorizontalOptions="End" Style="{StaticResource SectionTitleBlackBold}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding VATRefundsHeaderSet.RequestedAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                            </Grid>
                                        </StackLayout>
                                    </Border>
                                    <Border
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,16,0,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0">
                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--<Border Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                        HasShadow="False">
                                                </Border>-->
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="amount"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />

                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.NAIBAN}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <Grid Margin="8,0,8,8" Padding="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />

                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VatDeregIDType}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding SelectedIbanIdType}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="1" Grid.Column="0">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource BodyLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                </StackLayout>
                                                <StackLayout Grid.Row="1" Grid.Column="1">
                                                    <Label
                                                        HorizontalOptions="End"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding VatRefundsDisplayDataModel.Idnumber}" />
                                                </StackLayout>
                                                <!--<StackLayout Grid.Row="2" Grid.Column="0" HorizontalOptions="Start">-->
                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.NAIBAN}" />
                                                <!--</StackLayout>-->
                                                <!--<StackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="EndAndExpand">-->
                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding VatRefundsDisplayDataModel.Iban}" />
                                                <!--</StackLayout>-->
                                            </Grid>
                                        </StackLayout>
                                    </Border>


                                    <listView:SfListView
                                        x:Name="summaryDeclarationListView"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="-3,0,-3,0"
                                        AutoFitMode="Height"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="True"
                                        ItemSpacing="5"
                                        ItemsSource="{Binding VATRefundsSubItemReturnsSet}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent"
                                        SelectionMode="SingleDeselect"
                                        VerticalOptions="Center">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,16,0,40" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                    <StackLayout Padding="0">
                                                        <Grid Padding="15" RowSpacing="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!--<Border Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                            HasShadow="False">
                                                            </Border>-->
                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Padding="8,0"
                                                                Orientation="Horizontal">
                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    Aspect="AspectFit"
                                                                    HeightRequest="24"
                                                                    HorizontalOptions="Start"
                                                                    Source="return_vatRefunds"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="24" />

                                                                <Label
                                                                    Padding="8,0"
                                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                                    Text="{x:Static ResourceManager:AppResources.VatReturns}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                            </StackLayout>
                                                        </Grid>

                                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                        <Grid Margin="8,0,8,8" Padding="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />

                                                            </Grid.ColumnDefinitions>
                                                            <StackLayout Grid.Row="0" Grid.Column="0">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    HorizontalTextAlignment="Start"
                                                                    Style="{StaticResource BodyLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.ASFBNum}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="0" Grid.Column="1">
                                                                <Label
                                                                    HorizontalOptions="End"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding ReturnFbnum}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="1" Grid.Column="0">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    HorizontalTextAlignment="Start"
                                                                    Style="{StaticResource BodyLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.ReturnPeriod}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="1" Grid.Column="1">
                                                                <Label
                                                                    HorizontalOptions="End"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding ReturnPeriod}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="2" Grid.Column="0">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    HorizontalTextAlignment="Start"
                                                                    Style="{StaticResource BodyLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestDetailsCreditBalance}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="2" Grid.Column="1">
                                                                <Label
                                                                    HorizontalOptions="End"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding CreditBal, StringFormat='{0:0.00}', Converter={StaticResource negetiveToPositiveValueConverter}}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="3" Grid.Column="0">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    HorizontalTextAlignment="Start"
                                                                    Style="{StaticResource BodyLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestDetailsReassessedBalance}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="3" Grid.Column="1">
                                                                <Label
                                                                    HorizontalOptions="End"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding ReassessBal, Converter={StaticResource commaSeparatorConverter}}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="4" Grid.Column="0">
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    HorizontalTextAlignment="Start"
                                                                    Style="{StaticResource BodyLabelGrey}"
                                                                    Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestDetailsOffset}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="4" Grid.Column="1">
                                                                <Label
                                                                    HorizontalOptions="End"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding Offsets, Converter={StaticResource commaSeparatorConverter}}" />
                                                            </StackLayout>
                                                            <!--<StackLayout Grid.Row="5" Grid.Column="0">-->
                                                            <Label
                                                                Grid.Row="5"
                                                                Grid.Column="0"
                                                                HorizontalOptions="Start"
