<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRefunds.VATRefundsNewRequestPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    ios:Page.UseSafeArea="true"
    x:Name="page"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VATRefund}"
                    VerticalOptions="Center" />

                <StackLayout Grid.Row="0" Grid.Column="2">
                    <StackLayout
                        HorizontalOptions="EndAndExpand"
                        Orientation="Horizontal"
                        Rotation="90"
                        Spacing="3"
                        VerticalOptions="CenterAndExpand">
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                    </StackLayout>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid>

                    <ScrollView VerticalOptions="FillAndExpand"
                                VerticalScrollBarVisibility="Never">
                        <Grid VerticalOptions="Fill">
                            <Grid
                                Margin="20,10,20,0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="true"
                                ColumnSpacing="10"
                                VerticalOptions="FillAndExpand">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60*" />
                                    <ColumnDefinition Width="40*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VATRefundDetails}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                                    <BoxView
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                </Grid>


                                <StackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="1"
                                    Margin="0,16,0,0">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                    <Border
                                        Margin="0,0,0,10"
                                        Stroke="#B1B1B1"
                                        StrokeThickness="1"
                                        Style="{StaticResource GreyBorderFrame}">

                                        <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding SelectedIdtype}" />
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    HeightRequest="15"
                                                    HorizontalOptions="Start"
                                                    Source="arrowDropdown"
                                                    VerticalOptions="Center"
                                                    WidthRequest="15" />
                                            </StackLayout>

                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding IbanIdTypeTapped}" />
                                            </StackLayout.GestureRecognizers>

                                        </StackLayout>
                                    </Border>
                                </StackLayout>

                                <StackLayout
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="1"
                                    Margin="0,16,0,0">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                    <Border
                                        Margin="0,0,0,10"
                                        Stroke="#B1B1B1"
                                        StrokeThickness="1"
                                        Style="{StaticResource GreyBorderFrame}">

                                        <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{Binding SelectedIdNumber}" />
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    HeightRequest="15"
                                                    HorizontalOptions="Start"
                                                    Source="arrowDropdown"
                                                    VerticalOptions="Center"
                                                    WidthRequest="15" />
                                            </StackLayout>

                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding IbanIdNumberTapped}" />
                                            </StackLayout.GestureRecognizers>

                                        </StackLayout>
                                    </Border>
                                </StackLayout>

                                <StackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,16,0,8">
                                    <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VATRefundAccounts}" />
                                    <Border IsVisible="{Binding IsAddAccountVisisble}" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout
                                            Padding="15,10,15,10"
                                            IsVisible="{Binding IsAddAccountVisisble}"
                                            Orientation="Horizontal">
                                            <Image
                                                HeightRequest="20"
                                                Source="add"
                                                WidthRequest="20" />
                                            <Label
                                                Margin="8,0,8,0"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelPrimary}"
                                                Text="{x:Static ResourceManager:AppResources.VATRefundsAddAccount}" />
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="NewAccount_Clicked" />
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </Border>
                                </StackLayout>


                                <listView:SfListView
                                    x:Name="BankOptionsListView"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding IbanData}"
                                    ScrollBarVisibility="Never"
                                    SelectedItem="{Binding SelectedIbanData, Mode=TwoWay}"
                                    SelectionBackground="Transparent"
                                    SelectionMode="Single"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <cards:SfCardView
                                                BackgroundColor="Transparent"
                                                CornerRadius="20"
                                                HeightRequest="136"
                                                WidthRequest="171">
                                                <Grid
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowSpacing="10"
                                                    VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30*" />
                                                        <RowDefinition Height="70*" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.RowSpan="3"
                                                        Grid.Column="0"
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="vat_tile_listofsignup_W"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="0"
                                                        Margin="5,0,5,30"
                                                        Spacing="0">
                                                        <Image
                                                            Margin="15,0,15,15"
                                                            Aspect="Fill"
                                                            HeightRequest="32"
                                                            HorizontalOptions="End"
                                                            IsVisible="false"
                                                            Source="positive"
                                                            VerticalOptions="Center"
                                                            WidthRequest="32" />

                                                        <Label
                                                            Margin="20,0,20,0"
                                                            HorizontalOptions="Start"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            Text=""
                                                            TextColor="{StaticResource PrimaryColor}"
                                                            VerticalOptions="End" />
                                                        <Label
                                                            Margin="20,0,20,0"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            Text="{Binding Iban}"
                                                            TextColor="{StaticResource PrimaryColor}"
                                                            VerticalOptions="EndAndExpand" />
                                                    </StackLayout>

                                                </Grid>
                                            </cards:SfCardView>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                    <listView:SfListView.SelectedItemTemplate>
                                        <DataTemplate>
                                            <cards:SfCardView
                                                BackgroundColor="Transparent"
                                                CornerRadius="20"
                                                HeightRequest="136"
                                                WidthRequest="171"
                                                FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                <Grid
                                                    ColumnSpacing="0"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowSpacing="10"
                                                    VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30*" />
                                                        <RowDefinition Height="70*" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.RowSpan="3"
                                                        Grid.Column="0"
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="vat_tile_listofsignup"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="0"
                                                        Margin="5,0,5,30"
                                                        Spacing="0">
                                                        <Image
                                                            Margin="15,0,15,15"
                                                            Aspect="Fill"
                                                            HeightRequest="32"
                                                            HorizontalOptions="End"
                                                            IsVisible="false"
                                                            Source="negative"
                                                            VerticalOptions="Center"
                                                            WidthRequest="32" />

                                                        <Label
                                                            Margin="20,0,20,0"
                                                            HorizontalOptions="Start"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            Text="{Binding BankDetails.IBAN}"
                                                            TextColor="White"
                                                            VerticalOptions="End" />
                                                        <Label
                                                            Margin="20,0,20,0"
                                                            HorizontalOptions="EndAndExpand"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            Text="{Binding Iban}"
                                                            TextColor="White"
                                                            VerticalOptions="EndAndExpand" />
                                                    </StackLayout>

                                                </Grid>
                                            </cards:SfCardView>
                                        </DataTemplate>
                                    </listView:SfListView.SelectedItemTemplate>
                                    <listView:SfListView.ItemsLayout>
                                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                    </listView:SfListView.ItemsLayout>
                                </listView:SfListView>
                                <Border
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Grid.Column="0"
                                    Margin="0,20,0,10"
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Margin="8">
                                        <StackLayout Orientation="Horizontal" Spacing="0">
                                            <Image
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_vat_info.png"
                                                VerticalOptions="Center"
                                                WidthRequest="24" >
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding IBANAccManagementTapped}" CommandParameter="IBANAccTapped" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                            <Label
                                                Margin="10,0,10,0"
                                                HorizontalTextAlignment="Start"
                                                HorizontalOptions="StartAndExpand"
                                                VerticalOptions="EndAndExpand"
                                                Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.PleaseGoToIBan}"/>
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static ResourceManager:AppResources.VisitIBanManagement}" TextColor="{StaticResource Secondary}" >
                                                            <Span.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding IBANAccManagementTapped}" CommandParameter="IBANAccTapped" />
                                                            </Span.GestureRecognizers>
                                                        </Span>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding IBANAccManagementTapped}" CommandParameter="IBANAccTapped" />
                                        </StackLayout.GestureRecognizers>
                                    </StackLayout>
                                </Border>
                                <listView:SfListView
                                        Margin="3"
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        BackgroundColor="Transparent"
                                        ItemsSource="{Binding VatfrmRefundsModel}"
                                        x:Name="VATrefundDetailsView"
                                        IsScrollingEnabled="True"
                                        VerticalOptions="FillAndExpand"
                                        SelectionGesture="Tap"
                                        AutoFitMode="DynamicHeight"
                                        SelectionMode="Multiple"
                                        ItemSpacing="4">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <cards:SfCardView
                                                Margin="0,10,0,10"
                                                FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                                BorderColor="{StaticResource Secondary}"
                                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                                <Grid
                                                    Padding="10"
                                                    x:Name="Item_template"
                                                    BackgroundColor="Transparent">
                                                    <Grid.RowDefinitions >
                                                        <RowDefinition Height="1*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="0"
                                                        BackgroundColor="Transparent">
                                                        <Label 
                                                             Text="{x:Static ResourceManager:AppResources.VATRefundsFBNum}"
                                                             Style="{StaticResource CaptionLabelGrey}"  />

                                                        <Label 
                                                             Text="{Binding Fbnum}"
                                                             Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>

                                                    <buttons:SfCheckBox
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="End"
                                                        IsChecked="{Binding IsItemSelected}"
                                                        StateChanged="SfCheckBox_StateChanged"/>

                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Grid.Column="0" >
                                                        <Label 
                                                            Text="{x:Static ResourceManager:AppResources.VATRefundsperiod}"
                                                            Style="{StaticResource CaptionLabelGrey}" />

                                                        <Label 
                                                            Text="{Binding Perslt}"
                                                            Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Grid.Column="1" >
                                                        <Label 
                                                            Text="{x:Static ResourceManager:AppResources.VATRefundsCRAMT}"
                                                            Style="{StaticResource CaptionLabelGrey}" />
                                                        <Label 
                                                            Text="{Binding Betrw}"
                                                            Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>

                               
                                <Border
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,16,0,8"
                                    Padding="18"
                                    BackgroundColor="{StaticResource Primary}"
                                    HeightRequest="36"
                                    HorizontalOptions="FillAndExpand"
                                    Opacity="0.1"
                                    StrokeShape="RoundRectangle 15,15,15,15" />
                                <StackLayout
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal">
                                    <StackLayout
                                        Padding="16,8,16,0"
                                        HorizontalOptions="Start"
                                        Orientation="Horizontal"
                                        VerticalOptions="Center">
                                        <Label
                                            LineHeight="0.8"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.VATRefundAmounts}" />
                                    </StackLayout>
                                    <StackLayout
                                        Padding="16,8,16,0"
                                        HorizontalOptions="EndAndExpand"
                                        Orientation="Horizontal"
                                        VerticalOptions="Center">
                                        <Label HorizontalOptions="EndAndExpand" Style="{StaticResource SectionTitleBlackBold}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding VatRefundsDisplayDataModel.Rfamt, Converter={StaticResource commaSeparatorConverter}}" />
                                                    <Span Text=" " />
                                                    <Span Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </StackLayout>
                                </StackLayout>
                                <Border
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,20,0,10"
                                    Stroke="#B1B1B1"
                                    StrokeThickness="1"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Margin="8">
                                        <StackLayout Orientation="Horizontal" Spacing="0">
                                            <Image
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_vat_info.png"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />
                                            <Label
                                                Margin="10,0,10,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.Information}" />
                                        </StackLayout>
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestConfirmationMessage}" />

                                    </StackLayout>
                                </Border>
                                <buttons:SfButton
                                    x:Name="btnReasonContinue"
                                    Grid.Row="8"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,16"
                                    Clicked="ContinueButton_Tapped"
                                    HeightRequest="48"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

                            </Grid>

                        </Grid>
                    </ScrollView>

                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>



    </ContentPage.Content>
</ContentPage>
