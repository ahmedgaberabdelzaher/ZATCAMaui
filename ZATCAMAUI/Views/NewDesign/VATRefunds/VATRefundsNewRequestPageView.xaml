<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRefunds.VATRefundsNewRequestPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    FlowDirection="{Binding AppDirection}"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VATRefund}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>

                    <Border
                        Padding="0"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <ScrollView VerticalOptions="FillAndExpand">
                <Grid VerticalOptions="Fill">
                    <Grid
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="true"
                        VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="40*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.VATRefundDetails}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                        </Grid>


                        <StackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="1"
                            Margin="0,16,0,0">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                            <Border
                                Margin="0,0,0,10"
                                Stroke="#B1B1B1"
                                StrokeThickness="1"
                                Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                        Text="{Binding SelectedIdtype}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0"
                                            HeightRequest="15"
                                            HorizontalOptions="Start"
                                            Source="arrowDropdown"
                                            VerticalOptions="Center"
                                            WidthRequest="15" />
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IbanIdTypeTapped}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </Border>
                        </StackLayout>

                        <StackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="1"
                            Margin="0,16,0,0">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                            <Border
                                Margin="0,0,0,10"
                                Stroke="#B1B1B1"
                                StrokeThickness="1"
                                Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                        Text="{Binding SelectedIdNumber}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0"
                                            HeightRequest="15"
                                            HorizontalOptions="Start"
                                            Source="arrowDropdown"
                                            VerticalOptions="Center"
                                            WidthRequest="15" />
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IbanIdNumberTapped}" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </Border>
                        </StackLayout>

                        <StackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,8">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.VATRefundAccounts}" />
                            <Border IsVisible="{Binding IsAddAccountVisisble}" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="15,10,15,10"
                                    IsVisible="{Binding IsAddAccountVisisble}"
                                    Orientation="Horizontal">
                                    <Image
                                        HeightRequest="20"
                                        Source="add"
                                        WidthRequest="20" />
                                    <Label
                                        Margin="8,0,8,0"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="{x:Static ResourceManager:AppResources.VATRefundsAddAccount}" />
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="NewAccount_Clicked" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </Border>
                        </StackLayout>


                        <listView:SfListView
                            x:Name="BankOptionsListView"
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            AutoFitMode="Height"
                            HorizontalOptions="Center"
                            IsScrollingEnabled="False"
                            ItemSpacing="5"
                            ItemsSource="{Binding IbanData}"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedIbanData, Mode=TwoWay}"
                            SelectionBackground="Transparent"
                            SelectionChanged="BankOptionsListView_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="Center">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView
                                        BackgroundColor="Transparent"
                                        CornerRadius="20"
                                        HeightRequest="136"
                                        WidthRequest="171">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="FillAndExpand"
                                            RowSpacing="10"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*" />
                                                <RowDefinition Height="70*" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Aspect="Fill"
                                                HorizontalOptions="FillAndExpand"
                                                Source="vat_tile_listofsignup_W"
                                                VerticalOptions="FillAndExpand" />
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Margin="5,0,5,30"
                                                Spacing="0">
                                                <Image
                                                    Margin="15,0,15,15"
                                                    Aspect="Fill"
                                                    HeightRequest="32"
                                                    HorizontalOptions="End"
                                                    IsVisible="false"
                                                    Source="positive"
                                                    VerticalOptions="Center"
                                                    WidthRequest="32" />

                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text=""
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    VerticalOptions="End" />
                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding Iban}"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    VerticalOptions="EndAndExpand" />
                                            </StackLayout>

                                        </Grid>
                                    </cards:SfCardView>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                            <listView:SfListView.SelectedItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView
                                        BackgroundColor="Transparent"
                                        CornerRadius="20"
                                        HeightRequest="136"
                                        WidthRequest="171">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="FillAndExpand"
                                            RowSpacing="10"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30*" />
                                                <RowDefinition Height="70*" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Aspect="Fill"
                                                HorizontalOptions="FillAndExpand"
                                                Source="vat_tile_listofsignup"
                                                VerticalOptions="FillAndExpand" />
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Margin="5,0,5,30"
                                                Spacing="0">
                                                <Image
                                                    Margin="15,0,15,15"
                                                    Aspect="Fill"
                                                    HeightRequest="32"
                                                    HorizontalOptions="End"
                                                    IsVisible="false"
                                                    Source="negative"
                                                    VerticalOptions="Center"
                                                    WidthRequest="32" />

                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding BankDetails.IBAN}"
                                                    TextColor="White"
                                                    VerticalOptions="End" />
                                                <Label
                                                    Margin="20,0,20,0"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding Iban}"
                                                    TextColor="White"
                                                    VerticalOptions="EndAndExpand" />
                                            </StackLayout>

                                        </Grid>
                                    </cards:SfCardView>
                                </DataTemplate>
                            </listView:SfListView.SelectedItemTemplate>
                            <listView:SfListView.ItemsLayout>
                                <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                            </listView:SfListView.ItemsLayout>
                        </listView:SfListView>
                        <Border
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,20,0,10"
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Margin="8">
                                <StackLayout Orientation="Horizontal" Spacing="0">
                                    <Image
                                        HeightRequest="24"
                                        HorizontalOptions="Start"
                                        Source="ic_vat_info.png"
                                        VerticalOptions="Center"
                                        WidthRequest="24" />
                                    <Label
                                        Margin="10,0,10,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.Information}" />
                                </StackLayout>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestUpdateIBANInfo}" />

                            </StackLayout>
                        </Border>
                        <Frame
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,8"
                            Padding="18"
                            BackgroundColor="{StaticResource Primary}"
                            CornerRadius="15"
                            HasShadow="False"
                            HeightRequest="24"
                            HorizontalOptions="FillAndExpand"
                            Opacity="0.1" />
                        <StackLayout
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <StackLayout
                                Padding="16,8,16,0"
                                HorizontalOptions="Start"
                                Orientation="Horizontal"
                                VerticalOptions="Center">
                                <Label
                                    LineHeight="0.8"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VATRefundAmounts}" />
                            </StackLayout>
                            <StackLayout
                                Padding="16,8,16,0"
                                HorizontalOptions="End"
                                Orientation="Horizontal"
                                VerticalOptions="Center">
                                <Label HorizontalOptions="EndAndExpand" Style="{StaticResource SectionTitleBlackBold}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding VatRefundsDisplayDataModel.Rfamt, Converter={StaticResource commaSeparatorConverter}}" />
                                            <Span Text=" " />
                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                        </StackLayout>
                        <Border
                            Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,20,0,10"
                            Stroke="#B1B1B1"
                            StrokeThickness="1"
                            Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Margin="8">
                                <StackLayout Orientation="Horizontal" Spacing="0">
                                    <Image
                                        HeightRequest="24"
                                        HorizontalOptions="Start"
                                        Source="ic_vat_info.png"
                                        VerticalOptions="Center"
                                        WidthRequest="24" />
                                    <Label
                                        Margin="10,0,10,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.Information}" />
                                </StackLayout>
                                <Label
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestConfirmationMessage}" />

                            </StackLayout>
                        </Border>
                        <buttons:SfButton
                            x:Name="btnReasonContinue"
                            Grid.Row="8"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,16"
                            Clicked="ContinueButton_Tapped"
                            HeightRequest="48"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

                    </Grid>

                </Grid>
            </ScrollView>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>
