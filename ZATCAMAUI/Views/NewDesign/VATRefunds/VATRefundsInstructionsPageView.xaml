<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRefunds.VATRefundsInstructionsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    FlowDirection="{Binding AppDirection}"
    BackgroundColor="#88000000">

    <Border
        Grid.Row="0"
        Grid.Column="0"
        BackgroundColor="White"
        HorizontalOptions="End"
        IsVisible="{Binding IsInstructionsVisible}"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="End">
        <StackLayout
            Grid.Row="0"
            Grid.Column="0"
            Margin="24,8,24,0"
            BackgroundColor="Transparent"
            HorizontalOptions="End"
            VerticalOptions="End">
            <BoxView
                HorizontalOptions="Center"
                Style="{StaticResource NeutralGrayBoxViewDrag}"
                VerticalOptions="Start" />
            <Label
                Margin="0,0,0,16"
                HorizontalOptions="StartAndExpand"
                Style="{StaticResource SectionTitleBlackBold}"
                Text="{x:Static ResourceManager:AppResources.ZInstructions}" />
            <Border
                Margin="0,0,0,10"
                Stroke="#B1B1B1"
                StrokeThickness="1"
                Style="{StaticResource GreyBorderFrame}">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <StackLayout Margin="8">
                        <StackLayout Orientation="Horizontal" Spacing="0">
                            <Image
                                Margin="10,0,10,0"
                                HeightRequest="24"
                                HorizontalOptions="Start"
                                Source="ic_vat_info.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <Label
                                Margin="10,0,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.VatRefundsConfirmationTit}" />
                        </StackLayout>
                        <Label
                            HorizontalOptions="StartAndExpand"
                            LineHeight="0.8"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VatRefundsConfirmDetails}" />

                        <StackLayout Orientation="Horizontal" Spacing="0">
                            <Image
                                Margin="10,0,10,0"
                                HeightRequest="24"
                                HorizontalOptions="Start"
                                Source="ic_vat_info.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <Label
                                Margin="10,0,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZInstructions}" />
                        </StackLayout>
                        <Label
                            HorizontalOptions="StartAndExpand"
                            LineHeight="0.8"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ZVatRefundInstructions}" />

                    </StackLayout>
                </ScrollView>
            </Border>
            <StackLayout
                HorizontalOptions="FillAndExpand"
                Orientation="Horizontal"
                VerticalOptions="End">

                <custom:CheckboxCustom
                    Grid.Row="0"
                    Grid.Column="0"
                    IsChecked="{Binding IsInstructionsChecked}"
                    Style="{StaticResource CheckboxHeightWidth32}" />


                <Label
                    Margin="5,10,0,15"
                    Style="{StaticResource GAZTMicroMediumGrayLabel}"
                    Text="{x:Static ResourceManager:AppResources.ZVatDeclarationInstructions}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsInstructionsChecked}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsInstructionsChecked}"
                            TargetType="Label"
                            Value="False">
                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </StackLayout>
            <buttons:SfButton
                x:Name="btnConfirmVATRefundInstructions"
                Grid.ColumnSpan="2"
                Margin="0,24,0,24"
                Clicked="VATRefundRequestInstructions_Tapped"
                IsEnabled="{Binding IsInstructionsChecked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.VATRefundRequestTtitle}">
                <buttons:SfButton.Triggers>
                    <DataTrigger
                        Binding="{Binding IsInstructionsChecked}"
                        TargetType="buttons:SfButton"
                        Value="true">
                        <Setter Property="Background" Value="{StaticResource Secondary}" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding IsInstructionsChecked}"
                        TargetType="buttons:SfButton"
                        Value="false">
                        <Setter Property="Background" Value="{StaticResource NeutralGreay}" />
                    </DataTrigger>
                </buttons:SfButton.Triggers>
            </buttons:SfButton>
        </StackLayout>
    </Border>

</Mopups:PopupPage>
