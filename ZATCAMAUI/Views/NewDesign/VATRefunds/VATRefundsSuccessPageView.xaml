<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRefunds.VATRefundsSuccessPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    FlowDirection="{Binding AppDirection}"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>-->
    <ContentPage.Content>
        <ScrollView>
            <StackLayout
                Margin="0"
                BackgroundColor="Transparent"
                IsVisible="{Binding IsAccountUnlockedSuccessViewVisible}">
                <Grid
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    IsVisible="true">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*" />
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="35*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        BackgroundColor="Transparent"
                        HorizontalOptions="CenterAndExpand"
                        Opacity="0"
                        Source="partials_background"
                        VerticalOptions="Start" />

                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Padding="40,120,40,40"
                        VerticalOptions="Start">
                        <Image Aspect="AspectFit" Source="Forget_ic_success.png" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.VATRefund}"
                            TextColor="White" />
                        <Label
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource BodyLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.VATRefundsRequestSuccess}"
                            TextColor="White" />
                    </StackLayout>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Padding="0"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="End">
                        <StackLayout
                            Margin="30,60,30,40"
                            HorizontalOptions="Center"
                            VerticalOptions="End">
                            <Border Margin="0,0,0,8" Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}"
                                        VerticalOptions="Center" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding VatNewReqSummaryData.Fbnumx}" />
                                    </StackLayout>

                                </StackLayout>
                            </Border>
                            <buttons:SfButton
                                x:Name="btnDownloadConfirmation"
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,16,0,0"
                                Clicked="btnRefunds_Clicked"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.NDRefunds}" />

                            <buttons:SfButton
                                x:Name="btnGoToDasboard"
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,16"
                                Clicked="btnGoToDasboard_Clicked"
                                Style="{StaticResource NoBackgroundButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}"
                                TextColor="{StaticResource Primary}" />
                        </StackLayout>
                    </Border>

                </Grid>
            </StackLayout>

        </ScrollView>
    </ContentPage.Content>
</ContentPage>
