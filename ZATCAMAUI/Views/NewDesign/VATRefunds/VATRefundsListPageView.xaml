<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRefunds.VATRefundsListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:SfChipGroup="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid
                Padding="20,10"
                ColumnDefinitions="*,2*,*"
                RowDefinitions="auto,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDRefundsRequest}"
                    VerticalOptions="Center" />

                <StackLayout
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalOptions="EndAndExpand"
                    Orientation="Horizontal"
                    Spacing="15"
                    VerticalOptions="CenterAndExpand">
                    <Image
                        IsVisible="{Binding IsSearchButtonVisible}"
                        Source="search"
                        Style="{StaticResource SmallIcon}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SearchButton_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        IsVisible="{Binding IsCloseButtonVisible}"
                        Source="close"
                        Style="{StaticResource SmallIcon}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>

                </StackLayout>
                <SearchBar
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0"
                    custom:RoundCornersEffect.CornerRadius="12"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsCloseButtonVisible}"
                    TextChanged="SearchBar_TextChanged"
                    VerticalOptions="FillAndExpand" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid>

                    <Grid Padding="16,16,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <StackLayout Grid.Row="0" Spacing="0">
                            <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.VATRefund}" />
                            <Label
                                Margin="0,-3,0,32"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{Binding TotalReassessmentAmount}" />
                            <Border Style="{StaticResource GreyBorderFrameButtonWithShadow}">
                                <StackLayout Orientation="Horizontal">
                                    <Image
                                        Margin="16"
                                        Source="ic_add1.png"
                                        Style="{StaticResource SmallIcon}" />
                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource BodyLabelPrimaryMedium}"
                                        Text="{x:Static ResourceManager:AppResources.VATRefundsRequest}" />
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="NewRefundRequest_Tapped" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </Border>
                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding AmountLabel}" />
                            <SfChipGroup:SfChipGroup
                                x:Name="ChipGroup_statusFilter"
                                ChipBackground="Transparent"
                                ChipPadding="1"
                                ChipType="Choice"
                                HorizontalOptions="Start"
                                ItemsSource="{Binding ChipDataFilterlist}"
                                SelectedChipBackground="{StaticResource Primary}"
                                VerticalOptions="Center">
                                <SfChipGroup:SfChipGroup.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout
                                            Margin="0"
                                            Padding="0"
                                            Spacing="2">
                                            <SfChipGroup:SfChip
                                                BackgroundColor="White"
                                                CornerRadius="20"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="11"
                                                HeightRequest="32"
                                                ImageAlignment="Left"
                                                ImageSource="{Binding ImageSource}"
                                                SelectionIndicatorColor="AliceBlue"
                                                ShowCloseButton="False"
                                                ShowIcon="True"
                                                ShowSelectionIndicator="False"
                                                Stroke="{StaticResource NeutralLightGrey}"
                                                StrokeThickness="1"
                                                Text="{Binding Text}"
                                                TextColor="{StaticResource NeutralBlack}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </DataTemplate>
                                </SfChipGroup:SfChipGroup.ItemTemplate>
                            </SfChipGroup:SfChipGroup>
                        </StackLayout>
                        <listView:SfListView
                            x:Name="vatRefundsListView"
                            Grid.Row="1"
                            AutoFitMode="Height"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="true"
                            ItemsSource="{Binding VATRefundsSet}"
                            SelectionBackground="Transparent"
                            SelectionChanged="vatRefundDetailsListView_SelectionChanged"
                            VerticalOptions="FillAndExpand">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0" Spacing="0">
                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Spacing="-3">
                                                    <Label
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ZZVAT}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding RefundFbnum}" />
                                                </StackLayout>
                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="10,10,10,10"
                                                    BackgroundColor="{StaticResource Secondary}"
                                                    HeightRequest="20"
                                                    HorizontalOptions="End"
                                                    Opacity=".2"
                                                    StrokeShape="RoundRectangle 14,14,14,14"
                                                    StrokeThickness="1"
                                                    VerticalOptions="CenterAndExpand"
                                                    WidthRequest="60">

                                                    <Border.Triggers>
                                                        <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                        <DataTrigger
                                                            Binding="{Binding Status}"
                                                            TargetType="Border"
                                                            Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="CenterAndExpand"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding Status}"
                                                        TextColor="{StaticResource Secondary}"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label.Triggers>
                                                            <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                            <DataTrigger
                                                                Binding="{Binding Status}"
                                                                TargetType="Label"
                                                                Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </StackLayout>
                                            </Grid>
                                            <BoxView
                                                BackgroundColor="LightGray"
                                                HeightRequest="1"
                                                HorizontalOptions="FillAndExpand" />
                                            <Grid Padding="10,10,10,10" RowSpacing="15">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Spacing="-1">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestTotalRequestedAmount}" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{Binding RequestedAmt}"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding RequestedAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Spacing="-1">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRefundsReassesmentAmount}" />
                                                    <Label HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelBlackMedium}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{Binding ReassessAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="-1">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATRefundsTotalOffset}" />
                                                    <Label HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelBlackMedium}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{Binding OffsetTot, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Spacing="-1">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATRefundsNetCreditBalance}" />
                                                    <Label HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelBlackMedium}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{Binding NetCreditBal, Converter={StaticResource commaSeparatorConverter}}" />
                                                                <Span Text=" " />
                                                                <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Spacing="-1">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VATRefundsRequestDate}" />
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource BodyLabelBlackMedium}"
                                                        Text="{Binding RefundReqDtString}" />
                                                </StackLayout>
                                            </Grid>

                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>

                    </Grid>

                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>



    </ContentPage.Content>
</ContentPage>
