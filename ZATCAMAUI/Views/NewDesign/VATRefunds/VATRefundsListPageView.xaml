<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATRefunds.VATRefundsListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                        <Setter Property="HeightRequest" Value="24" />
                        <Setter Property="WidthRequest" Value="24" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                        <Setter Property="HeightRequest" Value="24" />
                        <Setter Property="WidthRequest" Value="24" />
                    </Style>
                    <converters:NegativeStringConverter x:Key="negativeStringConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.NDRefundsRequest}" />

                        <Image
                            x:Name="btnBack"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Spacing="15"
                            VerticalOptions="CenterAndExpand">
                            <Image
                                IsVisible="{TemplateBinding BindingContext.IsSearchButtonVisible}"
                                Source="search"
                                Style="{StaticResource SmallIcon}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="SearchButton_Tapped" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image
                                IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}"
                                Source="close"
                                Style="{StaticResource SmallIcon}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="CloseSearchButton_Tapped" />
                                </Image.GestureRecognizers>
                            </Image>

                        </StackLayout>
                        <SearchBar
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0"
                            custom:RoundCornersEffect.CornerRadius="12"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsCloseButtonVisible}"
                            TextChanged="SearchBar_TextChanged"
                            VerticalOptions="FillAndExpand" />
                    </Grid>

                    <Border
                        Padding="0"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid Padding="16,16,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <StackLayout Grid.Row="0" Spacing="0">
                    <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.VATRefund}" />
                    <Label
                        Margin="0,-3,0,32"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding TotalReassessmentAmount}" />
                    <Border Style="{StaticResource GreyBorderFrameButtonWithShadow}">
                        <StackLayout Orientation="Horizontal">
                            <Image
                                Margin="16"
                                Source="ic_add1.png"
                                Style="{StaticResource SmallIcon}" />
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource BodyLabelPrimaryMedium}"
                                Text="{x:Static ResourceManager:AppResources.VATRefundsRequest}" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NewRefundRequest_Tapped" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Border>
                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding AmountLabel}" />
                    <busyindicator:SfChipGroup
                        x:Name="ChipGroup_statusFilter"
                        ChipBackground="Transparent"
                        ChipPadding="1"
                        ChipType="Choice"
                        HorizontalOptions="Start"
                        ItemsSource="{Binding ChipDataFilterlist}"
                        SelectedChipBackground="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <busyindicator:SfChipGroup.ItemTemplate>
                            <DataTemplate>
                                <StackLayout
                                    Margin="0"
                                    Padding="0"
                                    Spacing="2">
                                    <busyindicator:SfChip
                                        BackgroundColor="White"
                                        CornerRadius="20"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="11"
                                        HeightRequest="32"
                                        ImageAlignment="Left"
                                        ImageSource="{Binding ImageSource}"
                                        SelectionIndicatorColor="AliceBlue"
                                        ShowCloseButton="False"
                                        ShowIcon="True"
                                        ShowSelectionIndicator="False"
                                        Stroke="{StaticResource NeutralLightGrey}"
                                        StrokeThickness="1"
                                        Text="{Binding Text}"
                                        TextColor="{StaticResource NeutralBlack}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </StackLayout>
                            </DataTemplate>
                        </busyindicator:SfChipGroup.ItemTemplate>
                    </busyindicator:SfChipGroup>
                </StackLayout>
                <listView:SfListView
                    x:Name="vatRefundsListView"
                    Grid.Row="1"
                    AutoFitMode="Height"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="true"
                    ItemsSource="{Binding VATRefundsSet}"
                    SelectionBackground="Transparent"
                    SelectionChanged="vatRefundDetailsListView_SelectionChanged"
                    VerticalOptions="FillAndExpand">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0" Spacing="0">
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="-3">
                                            <Label
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ZZVAT}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding RefundFbnum}" />
                                        </StackLayout>
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="10,10,10,10"
                                            BackgroundColor="{StaticResource Secondary}"
                                            HeightRequest="20"
                                            HorizontalOptions="End"
                                            Opacity=".2"
                                            StrokeShape="RoundRectangle 14,14,14,14"
                                            StrokeThickness="1"
                                            VerticalOptions="CenterAndExpand"
                                            WidthRequest="60">

                                            <Border.Triggers>
                                                <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                <DataTrigger
                                                    Binding="{Binding Status}"
                                                    TargetType="Border"
                                                    Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                HorizontalOptions="CenterAndExpand"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding Status}"
                                                TextColor="{StaticResource Secondary}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.Triggers>
                                                    <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                    <DataTrigger
                                                        Binding="{Binding Status}"
                                                        TargetType="Label"
                                                        Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}" />
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Grid>
                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />
                                    <Grid Padding="10,10,10,10" RowSpacing="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Spacing="-1">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZVatRefundRequestTotalRequestedAmount}" />
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding RequestedAmt}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding RequestedAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>

                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Spacing="-1">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRefundsReassesmentAmount}" />
                                            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelBlackMedium}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding ReassessAmt, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Spacing="-1">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATRefundsTotalOffset}" />
                                            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelBlackMedium}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding OffsetTot, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Spacing="-1">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATRefundsNetCreditBalance}" />
                                            <Label HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelBlackMedium}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding NetCreditBal, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Spacing="-1">
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATRefundsRequestDate}" />
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlackMedium}"
                                                Text="{Binding RefundReqDtString}" />
                                        </StackLayout>
                                    </Grid>

                                </StackLayout>
                            </Border>
                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>

            </Grid>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>
