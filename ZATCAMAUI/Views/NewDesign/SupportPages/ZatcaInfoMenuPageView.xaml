<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.SupportPages.ZatcaInfoMenuPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:settings="clr-namespace:ZATCAMAUI.Core.AppConfigurations"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:SupportTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
           
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="1"
                Padding="20,20,20,0"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Parent View Starts  -->
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0" Spacing="24">

                            <Border Style="{StaticResource GreyBorderFrameWithShadowSupportPage}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image
                                        HeightRequest="50"
                                        Source="education.png"
                                        WidthRequest="25" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsZATCAIntegrat}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenu1Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadowSupportPage}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image Source="ic_menu_Tax_check.png" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsZatcaDelca}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenu2Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border
                                Padding="5"
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 14,14,14,14"
                                IsVisible="{x:Static settings:PageSettings.IsIncludeLapFees}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image Source="ic_menu_Tax_check.png" />
                                    <Label
                                        LineHeight="1"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.InquireaboutPaymentofInsuranceTitle}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToInquireaboutPaymentofInsurance}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border
                                Padding="5"
                                Stroke="{StaticResource NeutralLightGrey}"
                                StrokeShape="RoundRectangle 14,14,14,14">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image
                                        HeightRequest="50"
                                        Source="EDeclerationicon"
                                        WidthRequest="25" />
                                    <Label
                                        LineHeight="1"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsDeclarationforTravelers}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToCustomsDeclarationforTravelers}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </StackLayout>
                    </ScrollView>
                    <!--  Parent View End  -->

                    <!--  Chat View starts  -->
                    <Grid
                        Padding="0,0,0,0"
                        BackgroundColor="AliceBlue"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.customsTarrifs}}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <custom:MyWebView
                            x:Name="CustomsTraffis"
                            Navigated="CustomsTraffis_Navigated"
                            Navigating="CustomsTraffis_Navigating" />
                    </Grid>
                    <!--  Chat View Ends  -->

                    <!--  Customs View starts  -->
                    <Grid
                        Padding="0,0,0,0"
                        BackgroundColor="AliceBlue"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.customsDelecrations}}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <custom:MyWebView
                            x:Name="CustomsView"
                            Navigated="CustomsView_Navigated"
                            Navigating="CustomsView_Navigating" />
                    </Grid>
                    <!--  Customs View Ends  -->
                </Grid>
            </Border>
            <custom:Loader Grid.Row="1" IsVisible="{Binding IsLoading}"/>

            <Grid Grid.Row="0" Padding="20,5,20,5"
                  ColumnDefinitions="10*,80*,10*">

                <StackLayout Grid.Column="0">
                    <Image
                        HorizontalOptions="Start"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackArrowTapped" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding PageTitle}"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>