<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.GenericPickers.CalendarPickerPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    BackgroundClicked="PopupPage_BackgroundClicked"
    FlowDirection="{Binding AppDirection}">
    <Border
        BackgroundColor="White"
        HorizontalOptions="End"
        IsVisible="true"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="End">
        <StackLayout Orientation="Vertical">

            <Border
                Margin="0,0,0,5"
                Padding="0"
                Style="{StaticResource GreyBorderFrameWithShadow}">
                <StackLayout Orientation="Vertical">
                    <BoxView
                        HorizontalOptions="Center"
                        Style="{StaticResource NeutralGrayBoxViewDrag}"
                        VerticalOptions="Start" />

                    <buttons:SfButton
                        x:Name="CalendarDoneButton"
                        Margin="10,0,10,0"
                        Background="Transparent"
                        Clicked="PopupClose_Clicked"
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Medium"
                        HorizontalOptions="StartAndExpand"
                        Text="{x:Static ResourceManager:AppResources.CRDone}"
                        TextColor="{StaticResource Primary}" />
                </StackLayout>
            </Border>

            <StackLayout
                Margin="24,8,24,0"
                BackgroundColor="Transparent"
                HorizontalOptions="End"
                IsVisible="{Binding IsCurrentDatePickerVisible}"
                VerticalOptions="End">
                <Label
                    x:Name="CalendarTitle"
                    Margin="0,16,0,16"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource SectionTitleBlackBold}"
                    Text="{Binding DatePickerTitle}" />

                <custom:CustomDatePicker
                    x:Name="calendarPicker"
                    Margin="2"
                    IsOpen="True"
                    ItemHeight="36"
                    SelectedItem="{Binding SelectedDate}"
                    SelectionChanged="genericPicker_SelectionChanged">
                    <custom:CustomDatePicker.SelectedTextStyle>
                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                    </custom:CustomDatePicker.SelectedTextStyle>

                    <custom:CustomDatePicker.ColumnHeaderView>
                        <syncfusion:PickerColumnHeaderView Height="46" />
                    </custom:CustomDatePicker.ColumnHeaderView>
                    <custom:CustomDatePicker.SelectionView>
                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                    </custom:CustomDatePicker.SelectionView>

                    <custom:CustomDatePicker.HeaderView>

                        <syncfusion:PickerHeaderView
                            Height="46"
                            Background="#EAF7CC"
                            Text="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}" />

                    </custom:CustomDatePicker.HeaderView>

                    <custom:CustomDatePicker.FooterView>

                        <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                            <syncfusion:PickerFooterView.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                            </syncfusion:PickerFooterView.TextStyle>

                        </syncfusion:PickerFooterView>

                    </custom:CustomDatePicker.FooterView>
                </custom:CustomDatePicker>
            </StackLayout>
            <StackLayout
                Margin="24,8,24,0"
                BackgroundColor="Transparent"
                HorizontalOptions="End"
                IsVisible="{Binding IsFutureDatePickerVisible}"
                VerticalOptions="End">

                <Label
                    x:Name="FutureCalendarTitle"
                    Margin="0,16,0,16"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource SectionTitleBlackBold}"
                    Text="{Binding DatePickerTitle}" />
                <custom:CustomDatePicker
                    x:Name="futureCalendarPicker"
                    Margin="2"
                    IsOpen="True"
                    ItemHeight="36"
                    SelectedItem="{Binding SelectedDate}"
                    SelectionChanged="genericPicker_SelectionChanged"
                    Style="{StaticResource CalendarPickerStyle}" />

            </StackLayout>
        </StackLayout>
    </Border>
</Mopups:PopupPage>
