<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.GenericPickers.NewPopupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:customcontrol="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    FlowDirection="{Binding AppDirection}">
    <ContentPage.Content>
        <AbsoluteLayout>
            <BoxView
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="Transparent"/>
            <Border
                x:Name="picker"
                Padding="0"
                AbsoluteLayout.LayoutBounds="1,1,1,.4"
                AbsoluteLayout.LayoutFlags="All"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15,15,0,0"
                VerticalOptions="FillAndExpand">
                <StackLayout Orientation="Vertical">

                    <Border
                        Margin="0,0,0,5"
                        Padding="0"
                        Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Orientation="Vertical">
                            <BoxView
                                HorizontalOptions="Center"
                                Style="{StaticResource NeutralGrayBoxViewDrag}"
                                VerticalOptions="Start" />
                            <buttons:SfButton
                                x:Name="PickerDoneButton"
                                Margin="10,0,10,0"
                                Background="Transparent"
                                Clicked="PopupClose_Clicked"
                                FontAttributes="Bold"
                                FontSize="Medium"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.CRDone}"
                                TextColor="{StaticResource Primary}" />
                        </StackLayout>
                    </Border>


                    <StackLayout
                        Margin="0,8,0,0"
                        Padding="24,0"
                        Orientation="Vertical">
                        <customcontrol:CustomSfPicker
                            x:Name="TaxTypePicker"
                            Background="White"
                            IsOpen="True"
                            ItemHeight="56"
                            Mode="Default">

                            <customcontrol:CustomSfPicker.TextStyle>
                                <syncfusion:PickerTextStyle
                                    FontFamily="{OnPlatform iOS=Somar-SemiBold,
                                                            Android=GAZT_FONT_BOLD}"
                                    FontSize="15"
                                    TextColor="{StaticResource NeutralBlack}" />
                            </customcontrol:CustomSfPicker.TextStyle>

                            <customcontrol:CustomSfPicker.Columns>
                                <syncfusion:PickerColumn Width="300" DisplayMemberPath="TaxType" />
                            </customcontrol:CustomSfPicker.Columns>


                            <customcontrol:CustomSfPicker.SelectionView>
                                <syncfusion:PickerSelectionView Background="LightGray" />
                            </customcontrol:CustomSfPicker.SelectionView>

                            <customcontrol:CustomSfPicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle
                                    FontAttributes="Bold"
                                    FontFamily="{OnPlatform iOS=Somar-SemiBold,
                                                            Android=GAZT_FONT_BOLD}"
                                    FontSize="15"
                                    TextColor="{StaticResource NeutralBlack}" />
                            </customcontrol:CustomSfPicker.SelectedTextStyle>


                            <customcontrol:CustomSfPicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                    Height="55"
                                    Background="{StaticResource Primary}"
                                    Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle FontFamily="{OnPlatform iOS=Somar-SemiBold, Android=GAZT_FONT_BOLD}" TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>
                                </syncfusion:PickerHeaderView>

                            </customcontrol:CustomSfPicker.HeaderView>

                            <customcontrol:CustomSfPicker.FooterView>

                                <syncfusion:PickerFooterView Height="46">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </customcontrol:CustomSfPicker.FooterView>

                        </customcontrol:CustomSfPicker>
                    </StackLayout>

                </StackLayout>



            </Border>
        </AbsoluteLayout>
    </ContentPage.Content>
</Mopups:PopupPage>
