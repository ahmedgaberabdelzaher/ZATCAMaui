<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.MyBillsPages.MyBillsSadadDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    BackgroundColor="White"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    ios:Page.UseSafeArea="true"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

          
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Content>

         <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="0*,100*,0*">

                 <Image
                    Grid.Row="0"
                    Grid.Column="1"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    Source="ic_logo_gazt.png"
                    VerticalOptions="Center"
                    WidthRequest="50" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border Grid.Row="1"
                    Padding="10,0"
                    Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">
                    
                    <ScrollView VerticalOptions="FillAndExpand">
                        <StackLayout Padding="10" VerticalOptions="FillAndExpand">
                            <Label Style="{StaticResource SectionTitleBlack}" Text="{x:Static ResourceManager:AppResources.SADADDetailss}" />
                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReviewSADADBillDetailss}" />

                            <Grid VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackLayout Grid.Row="0" Spacing="0">
                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                        <StackLayout Padding="15,10,15,10" Orientation="Horizontal">

                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.SADADNumber}" />
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding SadadBindNumber}" />


                                            </StackLayout>
                                            <Image Source="zakat_copy.png">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCopySADADNumberButtonClicked" />
                                                </Image.GestureRecognizers>

                                            </Image>
                                        </StackLayout>
                                    </Border>

                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                        <StackLayout Padding="15,10,15,10" Orientation="Horizontal">

                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZSADADGAZTId}" />
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="020" />
                                            </StackLayout>
                                        </StackLayout>
                                    </Border>

                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="10"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}"
                                        VerticalOptions="FillAndExpand">
                                        <Grid
                                            Padding="10,3,10,2"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.TotalAmount}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                        </Grid>
                                    </Border>

                                </StackLayout>

                                <StackLayout
                                    Grid.Row="1"
                                    Padding="0,2,0,0"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Vertical"
                                    Spacing="4"
                                    VerticalOptions="End">
                                    <buttons:SfButton
                                        Margin="0,0,0,20"
                                        Clicked="DoneClicked"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.CRDone}" />

                                </StackLayout>
                            </Grid>
                        </StackLayout>

                    </ScrollView>

                </Grid>

            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>

</ContentPage>