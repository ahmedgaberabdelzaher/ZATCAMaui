<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.MyBillsPages.MyBillsSadadDetailsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    FlowDirection="LeftToRight"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*" />
                            <ColumnDefinition Width="100*" />
                            <ColumnDefinition Width="0*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Row="0"
                            Grid.Column="1"
                            HeightRequest="50"
                            HorizontalOptions="Center"
                            Source="ic_logo_gazt.png"
                            VerticalOptions="Center"
                            WidthRequest="50" />

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalOptions="FillAndExpand">
                <ScrollView VerticalOptions="FillAndExpand">
                    <StackLayout Padding="10" VerticalOptions="FillAndExpand">
                        <custom:CustomLabel Style="{StaticResource SectionTitleBlack}" Text="{x:Static ResourceManager:AppResources.SADADDetailss}" />
                        <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ReviewSADADBillDetailss}" />

                        <Grid VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackLayout Grid.Row="0" Spacing="0">
                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">

                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.SADADNumber}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <custom:CustomLabel
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding SadadBindNumber}" />


                                        </StackLayout>
                                        <Image Source="zakat_copy.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopySADADNumberButtonClicked" />
                                            </Image.GestureRecognizers>

                                        </Image>
                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">

                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZSADADGAZTId}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <custom:CustomLabel
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="020" />
                                        </StackLayout>
                                    </StackLayout>
                                </Border>

                                <Frame
                                    Margin="0,10,0,0"
                                    Padding="10"
                                    CornerRadius="12"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}"
                                    VerticalOptions="FillAndExpand">
                                    <Grid
                                        Padding="10,3,10,2"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.TotalAmount}"
                                            VerticalOptions="CenterAndExpand" />
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </Grid>
                                </Frame>

                            </StackLayout>

                            <StackLayout
                                Grid.Row="1"
                                Padding="0,2,0,0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                Orientation="Vertical"
                                Spacing="4"
                                VerticalOptions="End">
                                <buttons:SfButton
                                    Margin="0,0,0,20"
                                    Clicked="DoneClicked"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.CRDone}" />

                            </StackLayout>
                        </Grid>
                    </StackLayout>

                </ScrollView>

            </Grid>

        </Grid>

    </ContentPage.Content>

</ContentPage>