<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.MyBillsPages.GAZTNewDesignMyBillsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    x:Name="myBills"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.DashBoardPendingBills}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">


                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid
                        x:Name="pageBinder"
                        Padding="24,32,24,5"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Padding="0"
                            BackgroundColor="Transparent">

                            <StackLayout Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{Binding FilterLabelText}"
                                    VerticalOptions="CenterAndExpand">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btn_Clicked" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Image
                                    HorizontalOptions="Center"
                                    Source="arrowDropdown"
                                    VerticalOptions="CenterAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btn_Clicked" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                            <Label
                                Padding="0,0,0,0"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="Start"
                                VerticalTextAlignment="Start">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashBoardMyTaxObligations}" />
                                        <Span Style="{StaticResource SectionTitleBlackBold}" Text="&#160;" />
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding AmountLabel}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <StackLayout
                                Margin="0,16,0,0"
                                BackgroundColor="Transparent"
                                Orientation="Horizontal"
                                VerticalOptions="Center">
                                <buttons:SfChipGroup
                                    x:Name="ChipGroup_statusFilter"
                                    Margin="0"
                                    Padding="0"
                                    ChipBackground="Transparent"
                                    ChipStroke="{StaticResource NeutralLightGrey}"
                                    ChipStrokeThickness="1"
                                    ChipType="Choice"
                                    HeightRequest="32"
                                    HorizontalOptions="Start"
                                    IsClippedToBounds="True"
                                    ItemsSource="{Binding ChipDataFilterlist}"
                                    SelectedChipBackground="Transparent"
                                    SelectionChanged="chipgroup_SelectionChanged"
                                    SelectionIndicatorColor="Transparent"
                                    VerticalOptions="Center">
                                    <buttons:SfChipGroup.ItemTemplate>
                                        <DataTemplate>

                                            <StackLayout
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal"
                                                Spacing="2">

                                                <Image
                                                    HeightRequest="25"
                                                    HorizontalOptions="Center"
                                                    Source="{Binding ImageSource}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Margin="0,0,5,0"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding Text}"
                                                    TextColor="{Binding TextColor}"
                                                    VerticalOptions="Center"
                                                    VerticalTextAlignment="Center" />
                                            </StackLayout>

                                        </DataTemplate>
                                    </buttons:SfChipGroup.ItemTemplate>
                                </buttons:SfChipGroup>
                            </StackLayout>
                        </StackLayout>
                        <StackLayout Grid.Row="1" Padding="0">

                            <ListView
                                x:Name="Bills"
                                BackgroundColor="White"
                                HasUnevenRows="True"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsListVisible}"
                                ItemsSource="{Binding MyBills, Mode=TwoWay}"
                                SeparatorVisibility="None" 
                                VerticalOptions="FillAndExpand"
                                VerticalScrollBarVisibility="Never">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Border  FlowDirection="{Binding Source={x:Reference myBills}, Path=FlowDirection}" Margin="0,12" Style="{StaticResource GreyBorderFrameWithShadow}">
                                                <StackLayout Spacing="0">
                                                    <Grid Padding="16,4" RowSpacing="3">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                                            <Label
                                                                Style="{StaticResource SectionTitleBlackBold}"
                                                                Text="{Binding Abtypt}"
                                                                VerticalOptions="CenterAndExpand" />
                                                            <Label
                                                                Style="{StaticResource CaptionLabelGrey}"
                                                                Text="{Binding Txt30}"
                                                                VerticalOptions="CenterAndExpand" />
                                                        </StackLayout>


                                                        <Border
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Padding="12,0,12,0"
                                                            HeightRequest="32"
                                                            HorizontalOptions="EndAndExpand"
                                                            Stroke="{StaticResource SecondaryNew}"
                                                            StrokeShape="RoundRectangle 20,20,20,20"
                                                            StrokeThickness="1"
                                                            VerticalOptions="CenterAndExpand">
                                                            <StackLayout
                                                                BindingContext="{Binding .}"
                                                                HorizontalOptions="CenterAndExpand"
                                                                Orientation="Horizontal">
                                                                <Image
                                                                    Margin="0,0,5,0"
                                                                    HeightRequest="16"
                                                                    Source="ic_iconpay_white"
                                                                    VerticalOptions="CenterAndExpand"
                                                                    WidthRequest="16" />
                                                                <Label
                                                                    FontFamily="{StaticResource SomarRegular}"
                                                                    FontSize="11"
                                                                    Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                                                                    TextColor="{StaticResource SecondaryNew}"
                                                                    VerticalOptions="CenterAndExpand" />
                                                                <StackLayout.GestureRecognizers>
                                                                    <TapGestureRecognizer CommandParameter="" Tapped="payNow_Tapped" />
                                                                </StackLayout.GestureRecognizers>
                                                            </StackLayout>

                                                        </Border>
                                                        <!--</StackLayout>-->
                                                    </Grid>
                                                    <BoxView
                                                        BackgroundColor="{StaticResource NeutralLightGrey}"
                                                        HeightRequest="1"
                                                        HorizontalOptions="FillAndExpand" />
                                                    <Grid Padding="16,8,16,4" RowSpacing="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />

                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackLayout
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,0,0,14"
                                                            HorizontalOptions="StartAndExpand">
                                                            <Label
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource CaptionLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.NDInvoiceDueamount}" />
                                                            <Label HorizontalOptions="StartAndExpand">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding TestDueAmount}" />
                                                                        <Span Style="{StaticResource SectionTitleBlackBold}" Text="&#160;" />
                                                                        <Span Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,0,0,14"
                                                            IsVisible="{Binding IsPeriodVisible}">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDPeriod}" />
                                                            <!--<Label Text="{Binding Period}" Style="{StaticResource ValueLabelBlack}" />-->
                                                            <StackLayout Orientation="Horizontal">
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding PeriodPart1}" />
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="-" />
                                                                <Label
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding PeriodPart2}" />
                                                            </StackLayout>
                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Margin="0,0,0,10"
                                                            HorizontalOptions="StartAndExpand"
                                                            IsVisible="{Binding IsPartiallyPaidVisibile}">
                                                            <StackLayout.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding IsPartiallyPaidVisibile}"
                                                                    TargetType="StackLayout"
                                                                    Value="false">
                                                                    <Setter Property="HeightRequest" Value="0" />
                                                                </DataTrigger>
                                                            </StackLayout.Triggers>
                                                            <Label
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource CaptionLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.MyBillsPaidAmount}" />
                                                            <Label HorizontalOptions="StartAndExpand">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalPaidAmt}" />
                                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            Margin="0,0,0,10"
                                                            HorizontalOptions="StartAndExpand"
                                                            IsVisible="{Binding IsPartiallyPaidVisibile}">
                                                            <StackLayout.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding IsPartiallyPaidVisibile}"
                                                                    TargetType="StackLayout"
                                                                    Value="false">
                                                                    <Setter Property="HeightRequest" Value="0" />
                                                                </DataTrigger>
                                                            </StackLayout.Triggers>
                                                            <Label
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource CaptionLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.MyBillsRemainingAmount}" />
                                                            <Label HorizontalOptions="StartAndExpand">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalRemainingAmount}" />
                                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="3"
                                                            Grid.Column="0"
                                                            Margin="0,0,0,20">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.InvoiceStatus}" />
                                                            <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding StatusText}" />
                                                        </StackLayout>



                                                        <StackLayout
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            Margin="0,0,0,20">
                                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DueDate}" />
                                                            <StackLayout HorizontalOptions="Start">
                                                                <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding FormatedFaedn}" />
                                                            </StackLayout>

                                                        </StackLayout>

                                                    </Grid>

                                                </StackLayout>
                                            </Border>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Label
                                Margin="0,20,0,0"
                                HorizontalOptions="Center"
                                IsVisible="{Binding isNoDataLableVisible}"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.NoBillsAvailable}"
                                VerticalOptions="Center" />

                        </StackLayout>


                    </Grid>

                </Grid>

            </Border>
            <!--#endregion Body-->


            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>