<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.MyBillsPages.GAZTNewDesignMyBillsPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:local="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StringToColor x:Key="StringToColor" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.DashBoardPendingBills}"
                            VerticalOptions="Center" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>

                    <Border
                        Padding="0"
                        StrokeShape="RoundRectangle 15,15,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,-16,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </Border>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid
                x:Name="pageBinder"
                Padding="24,32,24,5"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackLayout
                    Grid.Row="0"
                    Padding="0"
                    BackgroundColor="Transparent">

                    <StackLayout Orientation="Horizontal">
                        <Label
                            HorizontalOptions="Start"
                            Style="{StaticResource PageTitleBlack}"
                            Text="{Binding FilterLabelText}"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_Clicked" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Image
                            HorizontalOptions="Center"
                            Source="arrowDropdown"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_Clicked" />
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>

                    <Label
                        Padding="0,0,0,0"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashBoardMyTaxObligations}" />
                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="&#160;" />
                                <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding AmountLabel}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <!--<Label Text="{Binding AmountLabel}" Style="{StaticResource CaptionLabelGrey}"/>-->
                    <StackLayout
                        Margin="0,16,0,0"
                        BackgroundColor="Transparent"
                        Orientation="Horizontal"
                        VerticalOptions="Center">
                        <buttons:SfChipGroup
                            x:Name="ChipGroup_statusFilter"
                            Margin="0"
                            Padding="0"
                            ChipBackground="Transparent"
                            ChipStroke="{StaticResource NeutralLightGrey}"
                            ChipStrokeThickness="1"
                            ChipType="Choice"
                            HeightRequest="32"
                            HorizontalOptions="Start"
                            IsClippedToBounds="True"
                            ItemsSource="{Binding ChipDataFilterlist}"
                            SelectedChipBackground="Transparent"
                            SelectionChanged="chipgroup_SelectionChanged"
                            SelectionIndicatorColor="Transparent"
                            VerticalOptions="Center">
                            <buttons:SfChipGroup.ItemTemplate>
                                <DataTemplate>

                                    <StackLayout
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal"
                                        Spacing="2">

                                        <Image
                                            HeightRequest="25"
                                            HorizontalOptions="Center"
                                            Source="{Binding ImageSource}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Margin="0,0,5,0"
                                            HorizontalOptions="CenterAndExpand"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{Binding Text}"
                                            TextColor="{Binding TextColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                </DataTemplate>
                            </buttons:SfChipGroup.ItemTemplate>
                        </buttons:SfChipGroup>
                    </StackLayout>
                </StackLayout>
                <StackLayout Grid.Row="1" Padding="0">

                    <ListView
                        x:Name="Bills"
                        BackgroundColor="White"
                        HasUnevenRows="True"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsListVisible}"
                        ItemsSource="{Binding MyBills, Mode=TwoWay}"
                        SeparatorVisibility="None"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Border Margin="0,12" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Spacing="0">
                                            <Grid Padding="16,4" RowSpacing="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{Binding Abtypt}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <Label
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{Binding Txt30}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>


                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="12,0,12,0"
                                                    HeightRequest="32"
                                                    HorizontalOptions="EndAndExpand"
                                                    Stroke="{StaticResource SecondaryNew}"
                                                    StrokeShape="RoundRectangle 20,20,20,20"
                                                    StrokeThickness="1"
                                                    VerticalOptions="CenterAndExpand">
                                                    <StackLayout
                                                        BindingContext="{Binding .}"
                                                        HorizontalOptions="CenterAndExpand"
                                                        Orientation="Horizontal">
                                                        <Image
                                                            Margin="0,0,5,0"
                                                            HeightRequest="16"
                                                            Source="ic_iconpay_white"
                                                            VerticalOptions="CenterAndExpand"
                                                            WidthRequest="16" />
                                                        <Label
                                                            FontFamily="{StaticResource SomarRegular}"
                                                            FontSize="11"
                                                            Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                                                            TextColor="{StaticResource SecondaryNew}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer CommandParameter="" Tapped="payNow_Tapped" />
                                                        </StackLayout.GestureRecognizers>
                                                    </StackLayout>

                                                </Border>
                                                <!--</StackLayout>-->
                                            </Grid>
                                            <BoxView
                                                BackgroundColor="{StaticResource NeutralLightGrey}"
                                                HeightRequest="1"
                                                HorizontalOptions="FillAndExpand" />
                                            <Grid Padding="16,8,16,4" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />

                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,0,0,14"
                                                    HorizontalOptions="StartAndExpand">
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.NDInvoiceDueamount}" />
                                                    <Label HorizontalOptions="StartAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="{Binding TestDueAmount}" />
                                                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="&#160;" />
                                                                <Span Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,0,0,14"
                                                    IsVisible="{Binding IsPeriodVisible}">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDPeriod}" />
                                                    <!--<Label Text="{Binding Period}" Style="{StaticResource ValueLabelBlack}" />-->
                                                    <StackLayout Orientation="Horizontal">
                                                        <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding PeriodPart1}" />
                                                        <Label Style="{StaticResource ValueLabelBlack}" Text="-" />
                                                        <Label
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding PeriodPart2}" />
                                                    </StackLayout>
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,10"
                                                    HorizontalOptions="StartAndExpand"
                                                    IsVisible="{Binding IsPartiallyPaidVisibile}">
                                                    <StackLayout.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsPartiallyPaidVisibile}"
                                                            TargetType="StackLayout"
                                                            Value="false">
                                                            <Setter Property="HeightRequest" Value="0" />
                                                        </DataTrigger>
                                                    </StackLayout.Triggers>
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.MyBillsPaidAmount}" />
                                                    <Label HorizontalOptions="StartAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalPaidAmt}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,10"
                                                    HorizontalOptions="StartAndExpand"
                                                    IsVisible="{Binding IsPartiallyPaidVisibile}">
                                                    <StackLayout.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsPartiallyPaidVisibile}"
                                                            TargetType="StackLayout"
                                                            Value="false">
                                                            <Setter Property="HeightRequest" Value="0" />
                                                        </DataTrigger>
                                                    </StackLayout.Triggers>
                                                    <Label
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.MyBillsRemainingAmount}" />
                                                    <Label HorizontalOptions="StartAndExpand">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding TotalRemainingAmount}" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <StackLayout
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,20">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.InvoiceStatus}" />
                                                    <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding StatusText}" />
                                                </StackLayout>



                                                <StackLayout
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,20">
                                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DueDate}" />
                                                    <StackLayout HorizontalOptions="Start">
                                                        <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding FormatedFaedn}" />
                                                    </StackLayout>

                                                </StackLayout>

                                            </Grid>

                                        </StackLayout>
                                    </Border>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Label
                        Margin="0,20,0,0"
                        HorizontalOptions="Center"
                        IsVisible="{Binding isNoDataLableVisible}"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{x:Static ResourceManager:AppResources.NoBillsAvailable}"
                        VerticalOptions="Center" />

                </StackLayout>


            </Grid>
            <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>