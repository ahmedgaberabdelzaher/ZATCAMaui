<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.MyBillsPages.MyBillsMultiplePayableList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    BackgroundColor="#88000000"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <Mopups:PopupPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </Mopups:PopupPage.Resources>
    <Border
        Margin="0,20,0,0"
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackLayout
                Grid.Row="0"
                Margin="0,10,0,10"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="EndAndExpand">
                <Label Style="{StaticResource ButtonLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.ZNote}" />
                <Label Style="{StaticResource ButtonLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.MultipleBillsThisBillHasOtherLiabilities}" />
            </StackLayout>

            <Border Grid.Row="1" BackgroundColor="Transparent">


                <listView:SfListView
                    AutoFitMode="Height"
                    HorizontalOptions="FillAndExpand"
                    ItemsSource="{Binding MultiplePayableBills}"
                    SelectionBackground="Transparent"
                    VerticalOptions="Center">
                    <listView:SfListView.Behaviors>
                        <behavior:ListViewBehavior />
                    </listView:SfListView.Behaviors>

                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>

                            <cards:SfCardView
                                Margin="2"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="16"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <StackLayout Margin="12" Spacing="2">
                                    <Grid HorizontalOptions="FillAndExpand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout Grid.Row="0" Grid.Column="0">

                                            <Label Style="{StaticResource BodyLabelBlackMedium}" Text="{Binding TestDueAmount, Converter={StaticResource commaSeparatorConverter}}">

                                                <Label.FormattedText>

                                                    <FormattedString>
                                                        <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{Binding TestDueAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Text=" " />
                                                        <Span Style="{StaticResource BodyLabelBlackMedium}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>

                                            </Label>

                                            <Label
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{Binding Txt30}"
                                                VerticalOptions="End" />


                                        </StackLayout>
                                        <StackLayout Grid.Row="0" Grid.Column="1">
                                            <Border
                                                Padding="12,2,12,2"
                                                HeightRequest="32"
                                                HorizontalOptions="EndAndExpand"
                                                StrokeShape="RoundRectangle 20,20,20,20"
                                                StrokeThickness="0"
                                                VerticalOptions="CenterAndExpand">
                                                <Border.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding StatusText}"
                                                        TargetType="Border"
                                                        Value="{x:Static ResourceManager:AppResources.BillsNotPaid}">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource ErrorBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding StatusText}"
                                                        TargetType="Border"
                                                        Value="{x:Static ResourceManager:AppResources.PartiallyPaid}">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource PartialBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding StatusText}"
                                                        TargetType="Border"
                                                        Value="{x:Static ResourceManager:AppResources.Paid}">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessBg}" />
                                                    </DataTrigger>
                                                </Border.Triggers>


                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="11"
                                                    Text="{Binding StatusText}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding StatusText}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.BillsNotPaid}">
                                                            <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding StatusText}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.PartiallyPaid}">
                                                            <Setter Property="TextColor" Value="{StaticResource Partial}" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding StatusText}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.Paid}">
                                                            <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>

                                                </Label>

                                            </Border>
                                        </StackLayout>

                                    </Grid>


                                    <Grid HorizontalOptions="FillAndExpand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">

                                            <Label
                                                Margin="0,0,0,0"
                                                HorizontalOptions="End"
                                                Style="{StaticResource CaptionLabelGrey}">

                                                <Label.FormattedText>

                                                    <FormattedString>
                                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                                                        <Span Style="{StaticResource CaptionLabelGrey}" Text=": " />
                                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding FormatedFaedn}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>

                                    </Grid>

                                </StackLayout>
                            </cards:SfCardView>

                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>
            </Border>
            <buttons:SfButton
                Grid.Row="2"
                Margin="0,10,0,10"
                Clicked="ContinueButtonClicked"
                HeightRequest="48"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                WidthRequest="366" />
        </Grid>
    </Border>
</Mopups:PopupPage>
