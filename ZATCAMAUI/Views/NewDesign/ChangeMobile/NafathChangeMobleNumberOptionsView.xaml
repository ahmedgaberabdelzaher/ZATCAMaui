<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.ChangeMobile.NafathChangeMobleNumberOptionsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    x:Name="page"
    Title="NafathChangeMobleNumberOptionsView"
    FlowDirection="{Binding AppDirection}">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <ContentPage.Content>
        <StackLayout>
            <Border
                Padding="0"
                BackgroundColor="Green"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">
                <StackLayout
                    BackgroundColor="Orange"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <StackLayout
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="CenterAndExpand">
                        <Grid BackgroundColor="{StaticResource Secondary}" HorizontalOptions="FillAndExpand">
                            <Label
                                FontSize="24"
                                HorizontalOptions="Center"
                                Style="{StaticResource SectionTitleWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.ChangeMobileNumber}"
                                VerticalOptions="Start" />
                            <Image
                                BackgroundColor="Transparent"
                                HorizontalOptions="End"
                                Source="ic_close.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                        <StackLayout Padding="20">
                            <RadioButton
                                Content="{x:Static ResourceManager:AppResources.IndividualOrEstablishment}"
                                IsChecked="{Binding IndividualEnabled, Mode=TwoWay}"
                                Style="{StaticResource SectionTitleBlackBold}" />
                            <RadioButton
                                Content="{x:Static ResourceManager:AppResources.NDCompany}"
                                IsChecked="{Binding CompanyEnabled, Mode=TwoWay}"
                                Style="{StaticResource SectionTitleBlackBold}" />
                            <Label
                                IsVisible="{Binding IsError}"
                                Text="{Binding ErrorMessage}"
                                TextColor="{StaticResource ErrorColor}" />
                            <buttons:SfButton
                                Margin="10"
                                Command="{Binding ChangeMobileNumberCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.OKText}" />
                        </StackLayout>
                    </StackLayout>
                </StackLayout>
            </Border>
        </StackLayout>
    </ContentPage.Content>
</Mopups:PopupPage>
