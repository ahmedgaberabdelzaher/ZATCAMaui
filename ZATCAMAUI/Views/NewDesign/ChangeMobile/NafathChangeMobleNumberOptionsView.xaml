<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.ChangeMobile.NafathChangeMobleNumberOptionsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    x:Name="page"
    Title="NafathChangeMobleNumberOptionsView"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <ContentPage.Content>
        <StackLayout>
            <Border
                Padding="0"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">
                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                        <StackLayout
                            BackgroundColor="{StaticResource Secondary}"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal">
                            <Label
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Style="{StaticResource SectionTitleWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.ChangeMobileNumber}"
                                VerticalOptions="Start" />
                            <Image HorizontalOptions="EndAndExpand">
                                <Image.Source>
                                    <FontImageSource
                                        FontFamily="UserIconFont"
                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                        Size="25"
                                        Color="White" />
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout Padding="20">
                            <RadioButton
                                Content="{x:Static ResourceManager:AppResources.IndividualOrEstablishment}"
                                IsChecked="{Binding IndividualEnabled, Mode=TwoWay}"
                                Style="{StaticResource SectionTitleBlackBold}" />
                            <RadioButton
                                Content="{x:Static ResourceManager:AppResources.NDCompany}"
                                IsChecked="{Binding CompanyEnabled, Mode=TwoWay}"
                                Style="{StaticResource SectionTitleBlackBold}" />
                            <Label
                                IsVisible="{Binding IsError}"
                                Text="{Binding ErrorMessage}"
                                TextColor="{StaticResource ErrorColor}" />
                            <Button
                                Margin="10"
                                Command="{Binding ChangeMobileNumberCommand}"
                                Style="{StaticResource PrimaryMauiButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.OKText}" />
                        </StackLayout>
                    </StackLayout>
                </StackLayout>
            </Border>
        </StackLayout>
    </ContentPage.Content>
</Mopups:PopupPage>
