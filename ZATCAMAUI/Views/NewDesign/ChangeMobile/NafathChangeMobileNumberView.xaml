<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ChangeMobile.NafathChangeMobileNumberView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Name="page"
    Title="NafathChangeMobileNumberView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>

        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ResetMobileNumber}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">
                <StackLayout
                    Padding="10"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Image Source="logo_gazt.png" />
                    <Label Text="{x:Static ResourceManager:AppResources.PleaseChooseTinNumber}" />
                    <Border Padding="4" Style="{StaticResource GreyBorderFrame}">
                        <StackLayout
                            Padding="8,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal">
                            <custom:GAZTBorderlessEntry
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="Small"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="False"
                                Text="{Binding SelectedTIN}"
                                TextColor="{StaticResource PrimaryColor}" />
                            <Image
                                HorizontalOptions="EndAndExpand"
                                Source="arrowDropdown.png"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SnipperTappedCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Border>
                    <Label
                        IsVisible="{Binding IsError}"
                        Text="{Binding TinError}"
                        TextColor="{StaticResource ErrorColor}" />
                    <Label Margin="0,32,0,0" Text="{x:Static ResourceManager:AppResources.NewMobileNumber}" />
                    <Border Padding="4" Style="{StaticResource GreyBorderFrame}">
                        <StackLayout
                            Padding="0"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalOptions="CenterAndExpand">
                            <Image Source="arrowDropdown.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CountryCodesCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                            <buttons:SfButton
                                Background="Transparent"
                                Command="{Binding CountryCodesCommand}"
                                Text="{Binding CountryCode}"
                                TextColor="{StaticResource PrimaryColor}" />
                            <custom:GAZTBorderlessEntry
                                Margin="5,0,0,0"
                                MaxLength="{Binding MaxLength}"
                                Keyboard="{OnPlatform Android=Telephone,
                                                        iOS=Default}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding MobileNumber}"
                                TextColor="{StaticResource PrimaryColor}">
                                <custom:GAZTBorderlessEntry.Behaviors>
                                    <behaviors:OnlyNumericValuesBehaviour />
                                </custom:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </StackLayout>
                    </Border>
                    <Label
                        IsVisible="{Binding IsError}"
                        Text="{Binding MobileNumberError}"
                        TextColor="{StaticResource ErrorColor}" />
                    <buttons:SfButton
                        Margin="0,32,0,0"
                        Command="{Binding NextCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZZNext}" />
                </StackLayout>
            </Border>

             <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />
            <!--#endregion Body-->
        </Grid>
    </ContentPage.Content>
</ContentPage>