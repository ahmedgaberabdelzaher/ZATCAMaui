<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.FormBundleStatusPages.FormBundleStatusPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    x:Name="page"
    mc:Ignorable="d">
    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZFormBundleStatus}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <Border
                Grid.Row="1"
                Padding="0"
                Style="{StaticResource CommonTopCurves}">
                <Grid RowDefinitions="*">

                    <ScrollView Padding="20" VerticalScrollBarVisibility="Never">

                        <StackLayout>

                            <!--  Start Of Type  -->
                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <StackLayout>
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                       <custom:GAZTBorderlessEntry
                                            InputTransparent="True"
                                            IsReadOnly="True"
                                            Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtFBtype}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalTextAlignment="Center" />

                                    </custom:CustomSfTextInputView.TextInputView>

                                     <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image Source="arrowDropdown.png" />
                                    </inputLayout:SfTextInputLayout.TrailingView>

                                     <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBundleTypeClicked" />

                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                </custom:CustomSfTextInputView>

                                <custom:CustomSfPicker
                                    x:Name="BundleType"
                                    Background="White"
                                    IsOpen="False"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectionChanged="BundleType_SelectionChanged">

                                    <custom:CustomSfPicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="55"
                                            Background="{StaticResource Primary}"
                                            Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                            <syncfusion:PickerHeaderView.TextStyle>
                                                <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                            </syncfusion:PickerHeaderView.TextStyle>
                                        </syncfusion:PickerHeaderView>

                                    </custom:CustomSfPicker.HeaderView>


                                    <custom:CustomSfPicker.SelectionView>
                                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                    </custom:CustomSfPicker.SelectionView>

                                    <custom:CustomSfPicker.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomSfPicker.TextStyle>

                                    <custom:CustomSfPicker.Columns>
                                        <syncfusion:PickerColumn
                                            Width="300"
                                            DisplayMemberPath="Txt50"
                                            ItemsSource="{Binding FormBundleList}"
                                            SelectedIndex="{Binding IDTypeIndex}" />
                                    </custom:CustomSfPicker.Columns>

                                    <custom:CustomSfPicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomSfPicker.SelectedTextStyle>

                                    <custom:CustomSfPicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="White" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </custom:CustomSfPicker.FooterView>


                                </custom:CustomSfPicker>

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBundleTypeClicked" />

                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <!--  End Of Type  -->

                            <Label Style="{StaticResource CaptionLabelGrey}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <StackLayout>
                                <custom:CustomSfTextInputView>
                                    <custom:CustomSfTextInputView.TextInputView>
                                        <custom:GAZTBorderlessEntry
                                            InputTransparent="True"
                                            IsReadOnly="True"
                                            Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtFBnum}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalTextAlignment="Center" />

                                    </custom:CustomSfTextInputView.TextInputView>

                                     <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image Source="arrowDropdown.png" />
                                    </inputLayout:SfTextInputLayout.TrailingView>

                                     <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBundleNumberClicked" />

                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                </custom:CustomSfTextInputView>

                                <custom:CustomSfPicker
                                    x:Name="BundleNumber"
                                    Background="White"
                                    IsOpen="False"
                                    ItemHeight="40"
                                    Mode="Dialog"
                                    SelectionChanged="BundleNumber_SelectionChanged">

                                    <custom:CustomSfPicker.HeaderView>

                                        <syncfusion:PickerHeaderView
                                            Height="55"
                                            Background="{StaticResource Primary}"
                                            Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}">
                                            <syncfusion:PickerHeaderView.TextStyle>
                                                <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                            </syncfusion:PickerHeaderView.TextStyle>
                                        </syncfusion:PickerHeaderView>

                                    </custom:CustomSfPicker.HeaderView>


                                    <custom:CustomSfPicker.SelectionView>
                                        <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                    </custom:CustomSfPicker.SelectionView>

                                    <custom:CustomSfPicker.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomSfPicker.TextStyle>

                                    <custom:CustomSfPicker.Columns>
                                        <syncfusion:PickerColumn
                                            Width="300"
                                            DisplayMemberPath="Fbnum"
                                            ItemsSource="{Binding FormBundleApplicatioNumberList}"
                                            SelectedIndex="{Binding IDTypeIndex}" />
                                    </custom:CustomSfPicker.Columns>

                                    <custom:CustomSfPicker.SelectedTextStyle>
                                        <syncfusion:PickerTextStyle
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            TextColor="{StaticResource NeutralBlack}" />
                                    </custom:CustomSfPicker.SelectedTextStyle>

                                    <custom:CustomSfPicker.FooterView>

                                        <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                            <syncfusion:PickerFooterView.TextStyle>
                                                <syncfusion:PickerTextStyle TextColor="White" />
                                            </syncfusion:PickerFooterView.TextStyle>

                                        </syncfusion:PickerFooterView>

                                    </custom:CustomSfPicker.FooterView>

                                </custom:CustomSfPicker>

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBundleNumberClicked" />

                                </StackLayout.GestureRecognizers>
                            </StackLayout>

                            <ListView
                                Margin="0,10,0,10"
                                BackgroundColor="White"
                                HasUnevenRows="True"
                                VerticalScrollBarVisibility="Never"
                                HorizontalOptions="FillAndExpand"
                                ItemTapped="ListView_ItemTapped"
                                ItemsSource="{Binding ListFormBudles}"
                                SeparatorVisibility="None"
                                VerticalOptions="Start">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}"
                                                    FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                <StackLayout Padding="10">
                                                    <StackLayout Orientation="Horizontal">
                                                        <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZStatus}" />
                                                        <Label
                                                            HorizontalOptions="EndAndExpand"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding FbStatus}" />
                                                    </StackLayout>
                                                </StackLayout>
                                            </Border>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                        </StackLayout>

                    </ScrollView>

                </Grid>
            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>