<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.FormBundleStatusPages.FormBundleStatusPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <!--<ScrollView> -->
                <StackLayout>
                    <!--  Start Of Type  -->
                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" />
                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>
                    <Grid>
                        <inputLayout:SfTextInputLayout
                            x:Name="txtBundleType"
                            Margin="0,6,0,6"
                            ContainerType="Outlined"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                             IsHintAlwaysFloated="True"
                            OutlineCornerRadius="8"
                            Stroke="{StaticResource Primary}"
                            Style="{StaticResource TextInputLayout}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                IsReadOnly="True"
                                Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding TxtFBtype}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalTextAlignment="Center" />
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Source="arrowDropdown.png" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>
                        <buttons:SfButton Background="Transparent" Clicked="OnBundleTypeClicked" />
                        <syncfusion:SfPicker
                            x:Name="BundleType"
                            Margin="10,0,10,0"
                            Background="White"
                            Closed="BundleType_Closed"
                            FlowDirection="RightToLeft"
                            ItemHeight="40"
                            Mode="Dialog"
                            OkButtonClicked="BundleType_OkButtonClicked"
                            SelectionChanged="BundleType_SelectionChanged">

                            <syncfusion:SfPicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                    Height="55"
                                    Background="{StaticResource Primary}"
                                    Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}">
                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>
                                </syncfusion:PickerHeaderView>

                            </syncfusion:SfPicker.HeaderView>

                            <syncfusion:SfPicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" />
                            </syncfusion:SfPicker.ColumnHeaderView>

                            <syncfusion:SfPicker.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </syncfusion:SfPicker.TextStyle>

                            <syncfusion:SfPicker.Columns>
                                <syncfusion:PickerColumn
                                    Width="300"
                                    DisplayMemberPath="Txt50"
                                    ItemsSource="{Binding FormBundleList}"
                                    SelectedIndex="{Binding IDTypeIndex}" />
                            </syncfusion:SfPicker.Columns>

                            <syncfusion:SfPicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    TextColor="{StaticResource NeutralBlack}" />
                            </syncfusion:SfPicker.SelectedTextStyle>

                            <syncfusion:SfPicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </syncfusion:SfPicker.FooterView>

                            <syncfusion:SfPicker.Behaviors>
                                <behaviors:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>

                        </syncfusion:SfPicker>
                    </Grid>
                    <!--  End Of Type  -->

                    <custom:CustomLabel Margin="0,16,0,0" Style="{StaticResource CaptionLabelGrey}">
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}" />
                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>

                    <Grid>
                        <inputLayout:SfTextInputLayout
                            x:Name="txtBundleNumber"
                            Margin="0,6,0,6"
                            ContainerType="Outlined"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                             IsHintAlwaysFloated="True"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="8"
                            Stroke="{StaticResource Primary}"
                            Style="{StaticResource TextInputLayout}">
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle TextColor="#B00020" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            <custom:GAZTBorderlessEntry
                                IsReadOnly="True"
                                Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding TxtFBnum}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalTextAlignment="Center" />
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Source="arrowDropdown.png" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>

                        <buttons:SfButton Background="Transparent" Clicked="OnBundleNumberClicked" />

                        <syncfusion:SfPicker
                            x:Name="BundleNumber"
                            Margin="10,0,10,0"
                            Background="White"
                            FlowDirection="RightToLeft"
                            ItemHeight="40"
                            Mode="Dialog"
                            OkButtonClicked="BundleNumber_OkButtonClicked"
                            SelectionChanged="BundleNumber_SelectionChanged">

                            <syncfusion:SfPicker.HeaderView>

                                <syncfusion:PickerHeaderView
                                    Height="55"
                                    Background="{StaticResource Primary}"
                                    Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}">
                                    <syncfusion:PickerHeaderView.TextStyle>
                                        <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                    </syncfusion:PickerHeaderView.TextStyle>
                                </syncfusion:PickerHeaderView>

                            </syncfusion:SfPicker.HeaderView>

                            <syncfusion:SfPicker.ColumnHeaderView>
                                <syncfusion:PickerColumnHeaderView Height="46" />
                            </syncfusion:SfPicker.ColumnHeaderView>

                            <syncfusion:SfPicker.TextStyle>
                                <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                            </syncfusion:SfPicker.TextStyle>

                            <syncfusion:SfPicker.Columns>
                                <syncfusion:PickerColumn
                                    Width="300"
                                    DisplayMemberPath="Fbnum"
                                    ItemsSource="{Binding FormBundleApplicatioNumberList}"
                                    SelectedIndex="{Binding IDTypeIndex}" />
                            </syncfusion:SfPicker.Columns>

                            <syncfusion:SfPicker.SelectedTextStyle>
                                <syncfusion:PickerTextStyle
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    TextColor="{StaticResource NeutralBlack}" />
                            </syncfusion:SfPicker.SelectedTextStyle>

                            <syncfusion:SfPicker.FooterView>

                                <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                    <syncfusion:PickerFooterView.TextStyle>
                                        <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                    </syncfusion:PickerFooterView.TextStyle>

                                </syncfusion:PickerFooterView>

                            </syncfusion:SfPicker.FooterView>


                            <syncfusion:SfPicker.Behaviors>
                                <behaviors:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>

                        </syncfusion:SfPicker>
                    </Grid>

                    <ListView
                        Margin="0,10,0,10"
                        BackgroundColor="White"
                        HasUnevenRows="True"
                        HorizontalOptions="FillAndExpand"
                        ItemTapped="ListView_ItemTapped"
                        ItemsSource="{Binding ListFormBudles}"
                        SeparatorVisibility="None"
                        VerticalOptions="Start">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="10">
                                            <StackLayout Orientation="Horizontal">
                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZStatus}" />
                                                <custom:CustomLabel
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding FbStatus}" />
                                            </StackLayout>
                                        </StackLayout>
                                    </Border>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
                <!--</ScrollView> -->
            </yummy:PancakeView>


            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*" />
                    <ColumnDefinition Width="70*" />
                    <ColumnDefinition Width="15*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZFormBundleStatus}"
                    TextColor="White" />

                <Image
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Source="arrowLeftwhite"
                    Style="{DynamicResource BackButtonArrow}"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>