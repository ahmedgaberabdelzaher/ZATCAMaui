<?xml version="1.0" encoding="UTF-8" ?>
<ViewCell
    x:Class="ZATCAMAUI.Views.NewDesign.Template.SelectedItemTemplateNoIcon"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls">
    <ViewCell.View>
        <Grid Padding="4">
            <cards:SfCardView
                BackgroundColor="Transparent"
                CornerRadius="20"
                HeightRequest="104"
                WidthRequest="171">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Aspect="Fill"
                        HorizontalOptions="FillAndExpand"
                        Source="re_Tile_Background_S"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        Style="{DynamicResource CardParentStacklayout}"
                        VerticalOptions="End">
                        <custom:CustomLabel
                            FontSize="Small"
                            Style="{DynamicResource CardLabelWhite}"
                            Text="{Binding CardLabel}" />
                    </StackLayout>
                </Grid>
            </cards:SfCardView>
        </Grid>
    </ViewCell.View>
</ViewCell>