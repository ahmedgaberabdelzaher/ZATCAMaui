<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.Template.DashboardAnonymousMenuPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="ShadowLvl0">#EFEFEF</Color>
            <Style x:Key="GreyBorderFrameWithShadow" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14,14,14,14" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{StaticResource NeutralLightGrey}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>

            <Image
                x:Name="BGImageLogin"
                Margin="0,-50,0,0"
                Aspect="AspectFill"
                Source="partials_background.png" />
            <Grid x:Name="OldMenu">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackLayout
                    Grid.Row="0"
                    Padding="10,30,10,0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalOptions="Start">
                    <Image
                        HeightRequest="40"
                        HorizontalOptions="StartAndExpand"
                        Source="ic_Gazt.png"
                        VerticalOptions="Start"
                        WidthRequest="40" />

                    <Image
                        HorizontalOptions="End"
                        Source="close"
                        VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="GoBackTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <StackLayout.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="iOS" Value="0,20,0,0" />
                            <On Platform="Android" Value="0,0,0,0" />
                        </OnPlatform>
                    </StackLayout.Margin>
                </StackLayout>

                <ScrollView
                    Grid.Row="1"
                    Margin="0,20,10,0"
                    Padding="15,15,0,0"
                    HorizontalOptions="FillAndExpand">
                    <StackLayout
                        Padding="0,0,0,10"
                        HorizontalOptions="FillAndExpand"
                        Spacing="20">
                        <StackLayout Spacing="5">
                            <Label
                                HorizontalTextAlignment="Start"
                                Style="{StaticResource PageTitleWhite}"
                                Text="{x:Static ResourceManager:AppResources.NDServices}"
                                VerticalOptions="Center" />
                            <Label Style="{StaticResource CaptionLabelWhite}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.NDV}" />
                                        <Span Text="&#160;&#160;" />
                                        <Span Text="{Binding AppVersion}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <BoxView Style="{StaticResource WhiteLineSeperator}" />
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Image Source="password_key.png" Style="{StaticResource SmallIcon}" />
                            <Label
                                Style="{StaticResource ValueLabelWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnVATRefundTapped" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>

                        <BoxView Style="{StaticResource WhiteLineSeperator}" />

                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Image Source="vat_new_Establishment_W.png" Style="{StaticResource SmallIcon}" />


                            <Label
                                Style="{StaticResource ValueLabelWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.ZatcaInfoMenu}"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnZatcaInfoMenuTapped" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <BoxView Style="{StaticResource WhiteLineSeperator}" />

                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Image Source="taxEvasion.png" Style="{StaticResource SmallIcon}" />


                            <Label
                                Style="{StaticResource ValueLabelWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnTaxEvasionTapped" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>

                        <BoxView Style="{StaticResource WhiteLineSeperator}" />

                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Image Source="customerService" Style="{StaticResource SmallIcon}" />


                            <Label
                                Style="{StaticResource ValueLabelWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.ZZZSupport}"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnSupportTapped" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <BoxView Style="{StaticResource WhiteLineSeperator}" />

                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Image Source="education" Style="{StaticResource SmallIcon}" />


                            <Label
                                Style="{StaticResource ValueLabelWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.ZZZEducationLink}"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnEduLinkTapped" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <BoxView Style="{StaticResource WhiteLineSeperator}" />
                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Image Source="education" Style="{StaticResource SmallIcon}" />
                            <Label
                                Style="{StaticResource ValueLabelWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.ExciseTax}"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="GoToExisTax" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <BoxView Style="{StaticResource WhiteLineSeperator}" />
                        <StackLayout Orientation="Horizontal" Spacing="20">
                            <Image Source="ThaqaqIcon" Style="{StaticResource SmallIcon}" />
                            <Label
                                Style="{StaticResource ValueLabelWhiteBold}"
                                Text="{x:Static ResourceManager:AppResources.TahqaqService}"
                                VerticalOptions="Center" />
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="GoToTahqaqService" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <BoxView Style="{StaticResource WhiteLineSeperator}" />
                    </StackLayout>
                </ScrollView>
                <Grid
                    Grid.Row="3"
                    Margin="0,0,0,57"
                    HeightRequest="73"
                    RowSpacing="0"
                    VerticalOptions="EndAndExpand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="60*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <BoxView
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HeightRequest="1"
                        Style="{StaticResource WhiteLineSeperator}" />
                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="20,0,20,0"
                        HorizontalOptions="Start"
                        Orientation="Horizontal"
                        Spacing="20">
                        <Image
                            HorizontalOptions="Start"
                            Source="language"
                            Style="{StaticResource SmallIcon}" />
                        <Label
                            HorizontalTextAlignment="Start"
                            Style="{StaticResource ValueLabelWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ZZZChangetoLanguage}"
                            VerticalOptions="Center" />
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ChangeLanguage_Tapped" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    <BoxView
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource VerticalWhiteLineSeperator}"
                        WidthRequest="1" />
                    <StackLayout
                        Grid.Row="1"
                        Grid.Column="2"
                        Padding="20,0,20,0"
                        HorizontalOptions="StartAndExpand"
                        Orientation="Horizontal"
                        Spacing="20">
                        <Image
                            HorizontalOptions="StartAndExpand"
                            Source="user_profile"
                            Style="{StaticResource SmallIcon}" />
                        <Label
                            HorizontalTextAlignment="Start"
                            Style="{StaticResource ValueLabelWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.NDSwitchUser}"
                            VerticalOptions="Center" />
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="SwitchUser_Tapped" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    <BoxView
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HeightRequest="1"
                        Style="{StaticResource WhiteLineSeperator}" />
                </Grid>

                <custom:Loader Grid.RowSpan="3" IsVisible="{Binding IsLoading}"/>
              
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>