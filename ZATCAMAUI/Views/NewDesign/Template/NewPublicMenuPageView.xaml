<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.Template.DashboardAnonymousMenuPageView1"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="ShadowLvl0">#EFEFEF</Color>
            <!--<Color x:Key="ShadowLvl1">{StaticResource NeutralBlack}</Color>
            <Color x:Key="ShadowLvl2">{StaticResource NeutralBlack}</Color>-->
            <Style x:Key="GreyBorderFrameWithShadow" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14,14,14,14" />
                <!--<Setter Property="HasShadow" Value="True" />-->
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{StaticResource NeutralLightGrey}" />
                <!--<Setter Property="ShadowColor" Value="{StaticResource ShadowLvl0}" />-->
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <ScrollView>
                    <StackLayout>
                        <StackLayout Spacing="16">
                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTaxEvasionTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image
                                        HeightRequest="25"
                                        Source="ic_logo_gazt.png"
                                        WidthRequest="25" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZAboutUs}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Aboutus_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDPrivacyPolicy}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PrivacyPolicy_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="customerServiceColor.png" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZSupport}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSupportTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.AppVersion}" />
                                                <Span Text="&#160;&#160;" />
                                                <Span Text="{Binding AppVersion}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </custom:CustomLabel>
                                </StackLayout>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZChangetoLanguage}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ChangeLanguage_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </yummy:PancakeView>

            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*" />
                    <ColumnDefinition Width="70*" />
                    <ColumnDefinition Width="15*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDTaxManagement}" />


                <Image
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    Source="arrowLeftwhite.png"
                    Style="{DynamicResource BackButtonArrow}"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="GoBackTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>