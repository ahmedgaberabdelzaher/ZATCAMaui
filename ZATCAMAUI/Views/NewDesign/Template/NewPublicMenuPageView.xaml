<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.Template.DashboardAnonymousMenuPageView1"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="GreyBorderFrameWithShadow" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14,14,14,14" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{StaticResource NeutralLightGrey}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <ScrollView>
                    <StackLayout>
                        <StackLayout Spacing="16">
                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTaxEvasionTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image
                                        HeightRequest="25"
                                        Source="ic_logo_gazt.png"
                                        WidthRequest="25" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZAboutUs}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Aboutus_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDPrivacyPolicy}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PrivacyPolicy_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="customerServiceColor.png" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZSupport}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSupportTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.AppVersion}" />
                                                <Span Text="&#160;&#160;" />
                                                <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding AppVersion}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                            </Border>

                            <Border Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="20">
                                    <Image Source="ic_vat_return.png" />
                                    <Label
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZChangetoLanguage}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />

                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ChangeLanguage_Tapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </Border>

            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*" />
                    <ColumnDefinition Width="70*" />
                    <ColumnDefinition Width="15*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDTaxManagement}" />


                <Image
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    Source="arrowLeftwhite.png"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="GoBackTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>