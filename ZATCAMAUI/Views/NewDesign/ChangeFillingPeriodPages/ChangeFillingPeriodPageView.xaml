<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ChangeFillingPeriodPages.ChangeFillingPeriodPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviour="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector" xmlns:inputLayout="http://schemas.syncfusion.com/maui"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriod}"
                    VerticalOptions="Center" />

                <StackLayout Grid.Row="0" Grid.Column="2">
                    <StackLayout
                        HorizontalOptions="EndAndExpand"
                        Orientation="Horizontal"
                        Rotation="90"
                        Spacing="3"
                        VerticalOptions="CenterAndExpand">
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                    </StackLayout>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding onMoreOptionClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid>

                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--<Grid Grid.Row="0" >-->
                            <commonView:PageIndicatorView
                                Margin="24,32,24,0"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HeightRequest="16"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />
                            <!--</Grid>-->

                            <Grid Grid.Row="1">

                                <!--  Frequency Details screen  -->

                                <Grid
                                    Margin="20,10,20,0"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsFrequencyViewEnabled}"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="1" />
                                        </Grid.RowDefinitions>
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="28"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetailsSub}" />
                                        <BoxView
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50*" />
                                            <ColumnDefinition Width="50*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Row="0"
                                            Margin="10"
                                            Padding="10,3,10,3"
                                            HorizontalOptions="FillAndExpand"
                                            Stroke="Gray"
                                            StrokeShape="RoundRectangle 12"
                                            VerticalOptions="FillAndExpand">
                                            <StackLayout>
                                                <Label
                                                    Grid.Row="0"
                                                    Margin="0"
                                                    Padding="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource ValueLabelBlackBold}"
                                                    Text="{Binding CurrentFrequency}" />

                                            </StackLayout>
                                        </Border>

                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="10"
                                            Padding="10,3,10,3"
                                            HorizontalOptions="FillAndExpand"
                                            Stroke="Gray"
                                            StrokeShape="RoundRectangle 12,12,12,12"
                                            VerticalOptions="FillAndExpand">
                                            <StackLayout>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0"
                                                    Padding="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}"
                                                    VerticalOptions="Start" />

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,8,0,0"
                                                    Padding="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource ValueLabelBlackBold}"
                                                    Text="{Binding NewFrequency}"
                                                    VerticalOptions="Start" />

                                            </StackLayout>
                                        </Border>
                                    </Grid>

                                    <Grid
                                        HorizontalOptions="StartAndExpand"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        ColumnSpacing="0"
                                        HeightRequest="80"
                                        RowSpacing="0"
                                        WidthRequest="171">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        
                                        

                                        

                                    </Grid>


                                    <StackLayout HorizontalOptions="StartAndExpand"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        HeightRequest="80"
                                        WidthRequest="171" >
                                            <Label
                                            Grid.Row="0"
                                            Margin="0"
                                            Padding="0"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MiniNewGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource MiniNewGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                            <Border
                                                Grid.Row="1"
                                                Margin="0,5,0,0"
                                                Padding="10,0,10,0"
                                                HorizontalOptions="FillAndExpand"
                                                Stroke="Gray"
                                                StrokeShape="RoundRectangle 12,12,12,12">
                                                <StackLayout
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal"
                                                    VerticalOptions="CenterAndExpand">
                                                    <custom:GAZTBorderlessEntry
                                                        FontFamily="{StaticResource SomarBold}"
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsEnabled="False"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding EffectiveDatePicked}"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="CenterAndExpand">
                                                        <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                                        </custom:GAZTBorderlessEntry.GestureRecognizers>
                                                    </custom:GAZTBorderlessEntry>

                                                    <Image
                                                        Margin="12"
                                                        HeightRequest="24"
                                                        Source="arrowDropdown.png"
                                                        VerticalOptions="CenterAndExpand"
                                                        WidthRequest="24">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                                        </Image.GestureRecognizers>
                                                    </Image>

                                                 </StackLayout>
                                                <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </StackLayout>

                                    <StackLayout Orientation="Horizontal"
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Spacing="10"
                                        IsVisible="{Binding IsDecCheckBoxVisible}">

                                        <custom:CheckboxCustom
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                CheckChanged="OnFrequechCheckChanged"
                                                IsChecked="{Binding IsFrequencyDetailsChecked}"
                                                Style="{StaticResource CheckboxHeightWidth32}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Text="{x:Static ResourceManager:AppResources.VFCFrequencyDetailsCheckBoxString}">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsFrequencyDetailsChecked}"
                                                        TargetType="Label"
                                                        Value="True">
                                                        <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsFrequencyDetailsChecked}"
                                                        TargetType="Label"
                                                        Value="False">
                                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        <!--<Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            


                                        </Grid>-->
                                    </StackLayout>

                                    <buttons:SfButton
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    BackgroundColor="{Binding FrequencyDetailsButtonBackGroundColor}"
                                    Command="{Binding FrequencyContinueBtnTapped}"
                                    HeightRequest="48"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

                                </Grid>



                                <!--  Attachments screen  -->

                                <StackLayout
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsAttachmentsViewEnabled}"
                                    VerticalOptions="FillAndExpand">
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="28"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsSub}" />
                                        <BoxView
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />


                                    <Grid
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>


                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />

                                        </Grid.RowDefinitions>


                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                            <listView:SfListView
                                                x:Name="AttachmentTypeOption"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                AutoFitMode="Height"
                                                HorizontalOptions="Center"
                                                IsScrollingEnabled="False"
                                                ItemSpacing="5"
                                                ItemTemplate="{StaticResource UnselectedItemTemplateSelector}"
                                                ItemsSource="{Binding OutletDecisionOptions}"
                                                ScrollBarVisibility="Never"
                                                SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                                SelectedItemTemplate="{StaticResource SelectedIttemTemplateSelector}"
                                                SelectionBackground="Transparent"
                                                SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                                                SelectionMode="Single"
                                                VerticalOptions="Center">
                                                <listView:SfListView.ItemsLayout>
                                                    <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                                </listView:SfListView.ItemsLayout>
                                            </listView:SfListView>
                                        </StackLayout>
                                    </Grid>
                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        IsVisible="{Binding ShowAttachments}">
                                        <Grid
                                            Grid.Row="0"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsTwoYearsAtachmentsVisible}">
                                            <listView:SfListView
                                                AutoFitMode="Height"
                                                HorizontalOptions="Center"
                                                IsScrollingEnabled="False"
                                                ItemSpacing="5"
                                                ItemsSource="{Binding YearsattachmentsListViewData}"
                                                ScrollBarVisibility="Never"
                                                SelectionBackground="Transparent"
                                                SelectionMode="SingleDeselect"
                                                TapCommand="{Binding NewAttachmentTapped}"
                                                VerticalOptions="Center">


                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalOptions="FillAndExpand">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Border
                                                                Grid.Row="0"
                                                                Margin="0,0,0,10"
                                                                Padding="12"
                                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image
                                                                        Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        Margin="5,0"
                                                                        HeightRequest="25"
                                                                        HorizontalOptions="Start"
                                                                        Source="Generic_attachment_icon"
                                                                        VerticalOptions="Center"
                                                                        WidthRequest="25" />

                                                                    <Label
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{Binding Filename}"
                                                                        VerticalOptions="Center" />
                                                                    <Image
                                                                        Grid.Row="0"
                                                                        Grid.Column="2"
                                                                        HorizontalOptions="Center"
                                                                        Rotation="90"
                                                                        VerticalOptions="Center">
                                                                        <Image.Source>
                                                                            <FontImageSource
                                                                                FontFamily="UserIconFont"
                                                                                Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                                Size="24"
                                                                                Color="{StaticResource SecondaryNew}" />
                                                                        </Image.Source>
                                                                    </Image>
                                                                </Grid>
                                                            </Border>

                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>
                                        </Grid>

                                        <Grid
                                            Grid.Row="0"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsMonthsAtachmentsVisible}">

                                            <listView:SfListView
                                                AutoFitMode="Height"
                                                HorizontalOptions="Center"
                                                IsScrollingEnabled="False"
                                                ItemSpacing="5"
                                                ItemsSource="{Binding MonthsattachmentsListViewData}"
                                                ScrollBarVisibility="Never"
                                                SelectionBackground="Transparent"
                                                SelectionMode="SingleDeselect"
                                                TapCommand="{Binding NewAttachmentTapped}"
                                                VerticalOptions="Center">


                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalOptions="FillAndExpand">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Border
                                                                Grid.Row="0"
                                                                Margin="0,0,0,10"
                                                                Padding="12"
                                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image
                                                                        Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        Margin="5,0"
                                                                        HeightRequest="25"
                                                                        HorizontalOptions="Start"
                                                                        Source="Generic_attachment_icon"
                                                                        VerticalOptions="Center"
                                                                        WidthRequest="25" />

                                                                    <Label
                                                                        Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        Style="{StaticResource CaptionLabelBlack}"
                                                                        Text="{Binding Filename}"
                                                                        VerticalOptions="Center" />
                                                                    <Image
                                                                        Grid.Row="0"
                                                                        Grid.Column="2"
                                                                        HorizontalOptions="Center"
                                                                        Rotation="90"
                                                                        VerticalOptions="Center">
                                                                        <Image.Source>
                                                                            <FontImageSource
                                                                                FontFamily="UserIconFont"
                                                                                Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                                Size="24"
                                                                                Color="{StaticResource SecondaryNew}" />
                                                                        </Image.Source>
                                                                    </Image>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>
                                        </Grid>

                                        <Grid
                                            Grid.Row="0"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsOthersAtachmentsVisible}"
                                            VerticalOptions="FillAndExpand" />

                                        <Grid Grid.Row="1" HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.VRNewAttachment}" />
                                            <Border
                                                Grid.Row="1"
                                                Margin="0,0,0,10"
                                                Padding="10"
                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                        TextColor="{StaticResource PrimaryColor}" />
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="Center"
                                                        Rotation="90"
                                                        VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                                Size="24"
                                                                Color="{StaticResource SecondaryNew}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <Label
                                                Grid.Row="2"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.VatInstalment5MB}" />

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                            </Grid.GestureRecognizers>

                                        </Grid>
                                    </StackLayout>

                                    <Border
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,0"
                                        Padding="15"
                                        HorizontalOptions="FillAndExpand"
                                        Stroke="LightGray"
                                        StrokeShape="RoundRectangle 12,12,12,12"
                                        VerticalOptions="FillAndExpand">
                                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                                            <StackLayout Orientation="Horizontal">
                                                <Image
                                                    HeightRequest="20"
                                                    Source="ic_vat_info"
                                                    WidthRequest="20" />
                                                <Label
                                                    CharacterSpacing="0"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.Attachments}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <Label
                                                HorizontalOptions="FillAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VFCAttachmnetsInfo}"
                                                VerticalOptions="FillAndExpand" />

                                        </StackLayout>
                                    </Border>

                                     <buttons:SfButton
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            BackgroundColor="{Binding AttachButtonBackGroundColor}"
                                            Command="{Binding AttachmentsContinueBtnTapped}"
                                            HeightRequest="48"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />
                                       

                                </StackLayout>

                                <!--  Declaration screen  -->

                                <StackLayout
                                    
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsDeclarationViewEnabled}"
                                    VerticalOptions="FillAndExpand">
                                    
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="28"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlackBold}"
                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclaration}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclarationSub}" />
                                    <BoxView
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <!--<Grid
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        IsVisible="{Binding IsDeclarationViewEnabledNew}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />

                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">

                                            <StackLayout Orientation="Horizontal">
                                                <custom:CheckboxCustom
                                                    CheckChanged="CheckBox_CheckedChanged"
                                                    IsChecked="{Binding IsCheckboxChecked}"
                                                    MinimumHeightRequest="32"
                                                    MinimumWidthRequest="32"
                                                    VerticalOptions="Start" />


