<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  x:Class="ZATCAMAUI.Views.NewDesign.ChangeFillingPeriodPages.ChangeFillingPeriodPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector"/>
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" BackgroundColor="Black" StrokeShape="RoundRectangle 15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </Border>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriod}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout  Grid.Row="0" Grid.Column="2">
                            <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked }"/>
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid>
                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!--<Grid Grid.Row="0" >-->
                <commonView:PageIndicatorView HeightRequest="16" Margin="24,32,24,0"  MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand" HorizontalOptions="End" DotSize="12" />
                <!--</Grid>-->

                <Grid Grid.Row="1">

                    <!--Frequency Details screen-->

                    <Grid IsVisible="{Binding IsFrequencyViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlackBold}" FontSize="28" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetailsSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Frame Grid.Row="0" HasShadow="False"  HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Margin="10" Padding="10,3,10,3" VerticalOptions="FillAndExpand">
                                <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="0,5,0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelGrey}" Margin="0" Padding="0" />
                                    <custom:CustomLabel Grid.Row="1" Text="{Binding CurrentFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlackBold}" Margin="0,8,0,0" Padding="0"  />
                                </Grid>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1" HasShadow="False" Margin="10" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3" VerticalOptions="FillAndExpand">
                                <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="0,5,0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" VerticalOptions="Start" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelGrey}"  Margin="0" Padding="0"   />

                                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" VerticalOptions="Start" Text="{Binding NewFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlackBold}" Margin="0,8,0,0" Padding="0" />
                                </Grid>
                            </Frame>
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0" HeightRequest="80" WidthRequest="171" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}" HorizontalOptions="StartAndExpand" Style="{StaticResource MiniNewGrayLabelStyle}" FontFamily="{StaticResource SomarRegular}" Margin="0" Padding="0">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <Frame Grid.Row="1" HasShadow="False" Margin="0,5,0,0"  HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,0,10,0">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <custom:GAZTBorderlessEntry  IsEnabled="False" Text="{Binding EffectiveDatePicked}" 
                                                    PlaceholderColor="Gray"  FontSize="Small" TextColor="{StaticResource PrimaryColor}" FontFamily="{StaticResource SomarBold}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                            </custom:GAZTBorderlessEntry.GestureRecognizers>
                                        </custom:GAZTBorderlessEntry>
                                    <Image Source="arrowDropdown.png" WidthRequest="24" HeightRequest="24" Margin="12" VerticalOptions="CenterAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                    </Frame.GestureRecognizers>
                                </Frame>

                        </Grid>

                        <StackLayout Grid.Row="3" Margin="10,25,10,0" Grid.ColumnSpan="2" IsVisible="{Binding IsDecCheckBoxVisible}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <custom:CheckboxCustom  Grid.Row="0" Grid.Column="0"
                                                                       Style="{StaticResource CheckboxHeightWidth32}"
                                                                         VerticalOptions="CenterAndExpand"  CheckChanged="OnFrequechCheckChanged" IsChecked="{Binding IsFrequencyDetailsChecked}"/>
                                <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.VFCFrequencyDetailsCheckBoxString}" Grid.Row="0" Grid.Column="1" HorizontalTextAlignment="Start"  HorizontalOptions="StartAndExpand">
                                    <!--<custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span    />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>-->
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsFrequencyDetailsChecked}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsFrequencyDetailsChecked}" Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>


                            </Grid>
                        </StackLayout>

                        <Frame Margin="-20,0,-20,0" Grid.Row="4" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False">

                            <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" BackgroundColor="{Binding FrequencyDetailsButtonBackGroundColor}" WidthRequest="366" HeightRequest="48"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding FrequencyContinueBtnTapped}" />

                        </Frame>
                    </Grid>



                    <!--Attachments screen-->

                    <StackLayout IsVisible="{Binding IsAttachmentsViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}" HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource SectionTitleBlackBold}" FontSize="28" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>


                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>

                            </Grid.RowDefinitions>


                            <StackLayout Grid.Row="0" Grid.Column="0" >
                                <listView:SfListView HorizontalOptions="Center" x:Name="AttachmentTypeOption" ScrollBarVisibility="Never" IsScrollingEnabled="False"  VerticalOptions="Center" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding OutletDecisionOptions}" SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"  SelectionMode="Single"
                                       SelectedItemTemplate="{StaticResource SelectedIttemTemplateSelector}"
                                      ItemTemplate="{StaticResource UnselectedItemTemplateSelector}"
                                      SelectionBackground="Transparent" SelectionChanged="outletDecisionOptionsListView_SelectionChanged">
                                    <listView:SfListView.ItemsLayout>
                                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                    </listView:SfListView.ItemsLayout>
                                </listView:SfListView>
                            </StackLayout>
                        </Grid>
                        <StackLayout Grid.Row="2" IsVisible="{Binding ShowAttachments}" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid Grid.Row="0" IsVisible="{Binding IsTwoYearsAtachmentsVisible}" HorizontalOptions="FillAndExpand">
                                <listView:SfListView HorizontalOptions="Center"
                                             ScrollBarVisibility="Never" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding YearsattachmentsListViewData}"
                                             TapCommand="{Binding NewAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackground="Transparent">


                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>

                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="Center"/>
                                                        <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </Border>

                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>

                            <Grid Grid.Row="0" IsVisible="{Binding IsMonthsAtachmentsVisible}" HorizontalOptions="FillAndExpand">

                                <listView:SfListView HorizontalOptions="Center"
                                             ScrollBarVisibility="Never" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding MonthsattachmentsListViewData}"
                                             TapCommand="{Binding NewAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackground="Transparent">


                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>

                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="Center"/>
                                                        <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>

                            <Grid Grid.Row="0" IsVisible="{Binding IsOthersAtachmentsVisible}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                            </Grid>

                            <Grid Grid.Row="1" HorizontalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" FontFamily="{StaticResource SomarRegular}"
                                            Text="{x:Static ResourceManager:AppResources.VRNewAttachment}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />
                                <Border Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource SomarRegular}"
                                                    Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                    FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                    HorizontalOptions="FillAndExpand" />
                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                       Rotation="90">
                                            <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont"
                                                                     Color="{StaticResource SecondaryNew}" Size="24"
                                                         Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </Border>
                                <custom:CustomLabel Grid.Row="2"
                                            Text="{x:Static ResourceManager:AppResources.VatInstalment5MB}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </StackLayout>

                        <Frame Grid.Row="3" Margin="0,10,0,0" Grid.ColumnSpan="2" CornerRadius="12" BorderColor="LightGray" Padding="15" HasShadow="False" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                            <StackLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Orientation="Vertical">

                                <StackLayout Orientation="Horizontal" >
                                    <Image Source="ic_vat_info" HeightRequest="20" WidthRequest="20"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Attachments}" Style="{StaticResource CaptionLabelBlack}" CharacterSpacing="0" VerticalOptions="CenterAndExpand"/>
                                </StackLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static 
                                        ResourceManager:AppResources.VFCAttachmnetsInfo}" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Start"
                                                        VerticalOptions="FillAndExpand"/>

                            </StackLayout>
                        </Frame>

                        <Frame Margin="-20,0,-20,0" Grid.Row="4" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False" HorizontalOptions="FillAndExpand">

                            <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" BackgroundColor="{Binding AttachButtonBackGroundColor}" WidthRequest="366" HeightRequest="48"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AttachmentsContinueBtnTapped}" HorizontalOptions="FillAndExpand" />

                        </Frame>

                    </StackLayout>

                    <!--Declaration screen-->

                    <Grid IsVisible="{Binding IsDeclarationViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclaration}" HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource SectionTitleBlackBold}" FontSize="28" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclarationSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                        </Grid>
                            <Grid Grid.Row="1"  Grid.ColumnSpan="2" IsVisible="{Binding IsDeclarationViewEnabledNew}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>

                                </Grid.RowDefinitions>
                                <StackLayout Grid.Row="0">

                                    <StackLayout  Orientation="Horizontal">
                                        <custom:CheckboxCustom VerticalOptions="Start" CheckChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsCheckboxChecked}" MinimumHeightRequest="32" MinimumWidthRequest="32"/>


                                        <Label TextType="Html" HeightRequest="350" Text="{Binding Zterms}" HorizontalTextAlignment="{Binding TermsAlignment}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Style="{StaticResource CheckboxUnselectedFontStyle}"/>

                                    </StackLayout>
                                </StackLayout>
                            </Grid>

                        <StackLayout Grid.Row="1" Margin="0,25,0,10"  Grid.ColumnSpan="2"  Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="End" IsVisible="{Binding IsDeclarationViewEnabledOld}"
                                     >



                            <StackLayout Orientation="Horizontal" >
                                        <custom:CheckboxCustom  
                                                            Style="{StaticResource CheckboxHeightWidth32}"
                                                                VerticalOptions="CenterAndExpand" CheckChanged="CheckBox_CheckedChanged"  IsChecked="{Binding IsCheckboxChecked}"/>
                                        <Label Text="{x:Static ResourceManager:AppResources.CFPDeclarationCheckbox}" FontFamily="{StaticResource SomarRegular}" FontSize="11"
                                                HorizontalTextAlignment="Start" >
                                            <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCheckboxChecked}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCheckboxChecked}" Value="False">
                                                        <Setter Property="TextColor" Value="{StaticResource NeutralGreay}" />
                                                    </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                </StackLayout>

                        </StackLayout>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0" HeightRequest="80" WidthRequest="171" IsVisible="{Binding IsDeclarationViewEnabledOld}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>

                                <custom:CustomLabel Grid.Row="0" FontFamily="{StaticResource SomarRegular}" Text="{x:Static ResourceManager:AppResources.VFCIDType}" HorizontalOptions="StartAndExpand" Style="{StaticResource MiniNewGrayLabelStyle}" Margin="0" Padding="0">

                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VFCIDType}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <Frame Grid.Row="1" HasShadow="False"  Margin="0,5,0,0" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,0,10,0"  >
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <custom:GAZTBorderlessEntry IsEnabled="False" Text="{Binding IDType}"
                                                                FontFamily="{StaticResource SomarBold}"
                                        FontSize="Small" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" MinimumHeightRequest="50"/>
                                    <Image Source="arrowDropdown.png" WidthRequest="24" HeightRequest="24" Margin="12" VerticalOptions="CenterAndExpand">

                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding IdTypeSpinnerTapped}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Frame>

                        </Grid>
                        <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsDeclarationViewEnabledOld}">

                                                    <Grid   HeightRequest="80" WidthRequest="366" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>

                                    <custom:CustomLabel Grid.Row="0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        Text="{x:Static ResourceManager:AppResources.VFCIDNumber}" HorizontalOptions="StartAndExpand" Style="{StaticResource MiniNewGrayLabelStyle}" Margin="0" Padding="0">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VFCIDNumber}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <Frame Grid.Row="1" HasShadow="False"  Margin="0,5,0,0" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,0,10,0"  >

                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <custom:GAZTBorderlessEntry TextChanged="IdNumberTextChanged" Keyboard="Numeric" Text="{Binding IDNumber}" Unfocused="OnIDNumberFocusChanged"
                                                           TextColor="{StaticResource PrimaryColor}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" Style="{StaticResource DefaultEntry}"/>

                                </StackLayout>
                            </Frame>

                        </Grid>

                        <Grid  IsVisible="{Binding IsDOBVisible}"  HeightRequest="80" WidthRequest="366"  >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>

                                    <custom:CustomLabel Grid.Row="0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        Text="{x:Static ResourceManager:AppResources.VFCDateofBirth}" HorizontalOptions="StartAndExpand" Style="{StaticResource MiniNewGrayLabelStyle}" Margin="0" Padding="0">

                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VFCDateofBirth}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <Frame Grid.Row="1" HasShadow="False"  Margin="0,5,0,0" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,0,10,0"  >
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">

                                    <custom:GAZTBorderlessEntry IsEnabled="False" Text="{Binding PickedDate,StringFormat='{0:dd MMM yyyy}'}"
                                                              VerticalOptions="CenterAndExpand" Style="{StaticResource DefaultEntry}"
                                                                HorizontalOptions="FillAndExpand" />
                                    <Image Source="calendar.png" WidthRequest="24" HeightRequest="24"  VerticalOptions="CenterAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowDatePicker}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Frame>

                        </Grid>



                        </StackLayout>
                        <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0" HeightRequest="80" WidthRequest="171" IsVisible="{Binding IsDeclarationViewEnabledOld}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>

                                <custom:CustomLabel Grid.Row="0"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    Text="{x:Static ResourceManager:AppResources.VFCContactPersonName}" HorizontalOptions="StartAndExpand" Style="{StaticResource MiniNewGrayLabelStyle}" Margin="0" Padding="0">

                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VFCContactPersonName}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <Frame Grid.Row="1" HasShadow="False"  Margin="0,5,0,0" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,0,10,0"  >
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <custom:GAZTBorderlessEntry x:Name="ContactPersonEntry" Unfocused="ContactPersonTextUnFocus" Text="{Binding ContactPersonName}" IsEnabled="{Binding ContractPersonEditable}"
                                                    TextColor="{StaticResource PrimaryColor}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                                                HeightRequest="50" Style="{StaticResource DefaultEntry}"/>
                                </StackLayout>
                            </Frame>
                        </Grid>

                        <Frame Margin="-20,0,-20,0" Grid.Row="5" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False" HorizontalOptions="FillAndExpand">
                            <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" BackgroundColor="{Binding DeclarationButtonBackGroundColor}" WidthRequest="366" HeightRequest="48"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DeclarationContinueBtnTapped}" HorizontalOptions="FillAndExpand" />

                        </Frame>
                    </Grid>

                    <!--Summary screens-->

                    <Grid IsVisible="{Binding IsSummaryViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlackBold}" FontSize="28" />
                            <custom:CustomLabel Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPlanSummaryReview}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                            <Border Margin="0,16,0,10" Grid.Row="3" Grid.ColumnSpan="2"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>-->

                                        <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Padding="8,0" Orientation="Horizontal">
                                           <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Start" VerticalOptions="Center"  Aspect="AspectFit" Source="ic_reviewDetails"/>

                                            <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="End" Grid.Row="0" Grid.Column="1" Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                           VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoBackToFrequencyDetails}" ></TapGestureRecognizer>
                                                </Label.GestureRecognizers>
                                            </Label>

                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Grid Padding="15" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                        </Grid>

                                        <Grid Grid.Row="0" Grid.Column="1">
                                            <Label Text="{Binding CurrentFrequency}"
                                               HorizontalOptions="EndAndExpand"
                                               Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>

                                        <Grid Grid.Row="1" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                        </Grid>

                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Label Text="{Binding NewFrequency}"
                                               HorizontalOptions="EndAndExpand"
                                               Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>

                                        <Grid Grid.Row="2" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                        </Grid>

                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <Label Text="{Binding EffectiveDatePicked}"
                                               HorizontalOptions="EndAndExpand"
                                               Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>

                                    </Grid>
                                </StackLayout>
                            </Border >

                            <!-- Attachments Section -->


                            <Border IsVisible="{Binding IsAtachmentsVisible}" Margin="0,16,0,10" Grid.Row="4" Grid.ColumnSpan="2"   Style="{StaticResource GreyBorderFrameWithShadow}">

                                <StackLayout Padding="0">

                                    <Grid Padding="15" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Padding="8,0" Orientation="Horizontal">
                                            <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Start" VerticalOptions="Center"  Aspect="AspectFit" Source="ic_attachment"/>

                                            <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="End" Grid.Row="0" Grid.Column="1" Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                           VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoBackToAttachments}" ></TapGestureRecognizer>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <StackLayout Grid.Row="0" HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  BindableLayout.ItemsSource="{Binding YearsattachmentsListViewData}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="5,0">
                                                    <!--<Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>-->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Column="0"
                                                                 Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsTwoYears}"
                                                                 Style="{StaticResource ValueLabelGrey}" />
                                                    <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}" 
                                                                 Style="{StaticResource ValueLabelBlack}"
                                                                 HorizontalOptions="EndAndExpand"
                                                                 HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>


                                    <StackLayout Grid.Row="0" HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      BindableLayout.ItemsSource="{Binding MonthsattachmentsListViewData}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="5,0">
                                                    <!--<Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>-->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Column="0"
                                                                     Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsTwelveMonths}"
                                                                     Style="{StaticResource ValueLabelGrey}" />
                                                    <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                     Style="{StaticResource ValueLabelBlack}"
                                                                     HorizontalOptions="EndAndExpand"
                                                                     HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>

                                    <StackLayout Grid.Row="0" HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  BindableLayout.ItemsSource="{Binding OtherAttachmentsListViewData}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="5,0">
                                                    <!--<Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>-->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Column="0"
                                                                 Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsOtherDocuments}"
                                                                 Style="{StaticResource ValueLabelGrey}" />
                                                    <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                 Style="{StaticResource ValueLabelBlack}"
                                                                 HorizontalOptions="EndAndExpand"
                                                                 HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>
                            </Border >

                            <!-- Installment Agreement Section-->

                            <Border Margin="0,16,0,10" Grid.Row="5" Grid.ColumnSpan="2"   Style="{StaticResource GreyBorderFrameWithShadow}" IsVisible="{Binding IsDeclarationViewEnabledOld}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>-->
                                        <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Padding="8,0" Orientation="Horizontal">
                                            <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Start" VerticalOptions="Center"  Aspect="AspectFit" Source="declaration"/>

                                            <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclaration}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="End" Grid.Row="0" Grid.Column="1" Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                           VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoBackToDeclaration}" ></TapGestureRecognizer>
                                                </Label.GestureRecognizers>
                                            </Label>

                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Grid Padding="15" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VFCIDType}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                        </Grid>

                                        <Grid Grid.Row="0" Grid.Column="1">
                                            <Label Text="{Binding IDType}"
                                               HorizontalOptions="End"
                                               Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>

                                        <Grid Grid.Row="1" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VFCIDNumber}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                        </Grid>

                                        <Grid Grid.Row="1" Grid.Column="1">
                                            <Label HorizontalOptions="End" Text="{Binding IDNumber}"
                                               Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>

                                        <Grid Grid.Row="2" IsVisible="{Binding IsDOBVisible}" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VFCDateofBirth}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                        </Grid>

                                        <Grid Grid.Row="2" IsVisible="{Binding IsDOBVisible}" Grid.Column="1">
                                            <Label Text="{Binding PickedDate,StringFormat='{0:dd MMM yyyy}'}"
                                               HorizontalOptions="End"
                                               Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>

                                        <Grid Grid.Row="3" Grid.Column="0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VFCContactPersonName}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                        </Grid>

                                        <Grid Grid.Row="3" Grid.Column="1">
                                            <Label Text="{Binding ContactPersonName}"
                                               HorizontalOptions="End"
                                               Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>
                                    </Grid>
                                </StackLayout>
                            </Border >

                            <StackLayout Grid.Row="6"  Grid.ColumnSpan="2">

                                <buttons:SfButton  Margin="0,16,0,16" Text="{x:Static ResourceManager:AppResources.Submit}"
                                   Style="{StaticResource PrimaryButtonStyle}"  Command="{Binding SummaryContinueBtnTapped}" 
                                               WidthRequest="366" HeightRequest="48"/>

                            </StackLayout>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollView>
        <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                        Opacity="0.4" VerticalOptions="FillAndExpand" />
            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                        Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                         <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                </StackLayout>
            </StackLayout>
        </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>
