<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ChangeFillingPeriodPages.ChangeFillingPeriodPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriod}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--<Grid Grid.Row="0" >-->
                    <commonView:PageIndicatorView
                        Margin="24,32,24,0"
                        Completed="{Binding MarkComplete}"
                        DotSize="12"
                        HeightRequest="16"
                        HorizontalOptions="End"
                        MaxNum="{Binding MaxIndex}"
                        MinNum="{Binding CurrentIndex}"
                        VerticalOptions="CenterAndExpand" />
                    <!--</Grid>-->

                    <Grid Grid.Row="1">

                        <!--  Frequency Details screen  -->

                        <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsFrequencyViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="28"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetailsSub}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            </Grid>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <Frame
                                    Grid.Row="0"
                                    Margin="10"
                                    Padding="10,3,10,3"
                                    BorderColor="Gray"
                                    CornerRadius="12"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">
                                    <Grid
                                        Padding="0,5,0,5"
                                        ColumnSpacing="0"
                                        HorizontalOptions="FillAndExpand"
                                        RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Margin="0"
                                            Padding="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}" />
                                        <custom:CustomLabel
                                            Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Padding="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlackBold}"
                                            Text="{Binding CurrentFrequency}" />
                                    </Grid>
                                </Frame>

                                <Frame
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10"
                                    Padding="10,3,10,3"
                                    BorderColor="Gray"
                                    CornerRadius="12"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">
                                    <Grid
                                        Padding="0,5,0,5"
                                        ColumnSpacing="0"
                                        HorizontalOptions="FillAndExpand"
                                        RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0"
                                            Padding="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}"
                                            VerticalOptions="Start" />

                                        <custom:CustomLabel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,8,0,0"
                                            Padding="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlackBold}"
                                            Text="{Binding NewFrequency}"
                                            VerticalOptions="Start" />
                                    </Grid>
                                </Frame>
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                ColumnSpacing="0"
                                HeightRequest="80"
                                RowSpacing="0"
                                WidthRequest="171">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Margin="0"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarRegular}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource MiniNewGrayLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <Frame
                                    Grid.Row="1"
                                    Margin="0,5,0,0"
                                    Padding="10,0,10,0"
                                    BorderColor="Gray"
                                    CornerRadius="12"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand">
                                    <StackLayout
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal"
                                        VerticalOptions="CenterAndExpand">
                                        <custom:GAZTBorderlessEntry
                                            FontFamily="{StaticResource SomarBold}"
                                            FontSize="Small"
                                            HorizontalOptions="FillAndExpand"
                                            IsEnabled="False"
                                            PlaceholderColor="Gray"
                                            Text="{Binding EffectiveDatePicked}"
                                            TextColor="{StaticResource PrimaryColor}"
                                            VerticalOptions="CenterAndExpand">
                                            <custom:GAZTBorderlessEntry.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                            </custom:GAZTBorderlessEntry.GestureRecognizers>
                                        </custom:GAZTBorderlessEntry>
                                        <Image
                                            Margin="12"
                                            HeightRequest="24"
                                            Source="arrowDropdown.png"
                                            VerticalOptions="CenterAndExpand"
                                            WidthRequest="24">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </StackLayout>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}" />
                                    </Frame.GestureRecognizers>
                                </Frame>

                            </Grid>

                            <StackLayout
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="10,25,10,0"
                                IsVisible="{Binding IsDecCheckBoxVisible}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <custom:CheckboxCustom
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        CheckChanged="OnFrequechCheckChanged"
                                        IsChecked="{Binding IsFrequencyDetailsChecked}"
                                        Style="{StaticResource CheckboxHeightWidth32}"
                                        VerticalOptions="CenterAndExpand" />
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Text="{x:Static ResourceManager:AppResources.VFCFrequencyDetailsCheckBoxString}">
                                        <custom:CustomLabel.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFrequencyDetailsChecked}"
                                                TargetType="custom:CustomLabel"
                                                Value="True">
                                                <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding IsFrequencyDetailsChecked}"
                                                TargetType="custom:CustomLabel"
                                                Value="False">
                                                <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                            </DataTrigger>
                                        </custom:CustomLabel.Triggers>
                                    </custom:CustomLabel>


                                </Grid>
                            </StackLayout>

                            <Frame
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="-20,0,-20,0"
                                HasShadow="False"
                                VerticalOptions="End">

                                <buttons:SfButton
                                    Background="{Binding FrequencyDetailsButtonBackGroundColor}"
                                    Command="{Binding FrequencyContinueBtnTapped}"
                                    HeightRequest="48"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                    WidthRequest="366" />

                            </Frame>
                        </Grid>



                        <!--  Attachments screen  -->

                        <StackLayout
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsAttachmentsViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="28"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsSub}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            </Grid>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>


                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />

                                </Grid.RowDefinitions>


                                <StackLayout Grid.Row="0" Grid.Column="0">
                                    <listView:SfListView
                                        x:Name="AttachmentTypeOption"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        AutoFitMode="Height"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="False"
                                        ItemSpacing="5"
                                        ItemTemplate="{StaticResource UnselectedItemTemplateSelector}"
                                        ItemsSource="{Binding OutletDecisionOptions}"
                                        ScrollBarVisibility="Never"
                                        SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                        SelectedItemTemplate="{StaticResource SelectedIttemTemplateSelector}"
                                        SelectionBackground="Transparent"
                                        SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                                        SelectionMode="Single"
                                        VerticalOptions="Center">
                                        <listView:SfListView.LayoutManager>
                                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                        </listView:SfListView.LayoutManager>
                                    </listView:SfListView>
                                </StackLayout>
                            </Grid>
                            <StackLayout
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsVisible="{Binding ShowAttachments}">
                                <Grid
                                    Grid.Row="0"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsTwoYearsAtachmentsVisible}">
                                    <listView:SfListView
                                        AutoFitMode="Height"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="False"
                                        ItemSpacing="5"
                                        ItemsSource="{Binding YearsattachmentsListViewData}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent"
                                        SelectionMode="SingleDeselect"
                                        TapCommand="{Binding NewAttachmentTapped}"
                                        VerticalOptions="Center">


                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Margin="0,0,0,10"
                                                        Padding="12"
                                                        Style="{StaticResource SfStyleGreyBorderFrame}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="5,0"
                                                                HeightRequest="25"
                                                                HorizontalOptions="Start"
                                                                Source="Generic_attachment_icon"
                                                                VerticalOptions="Center"
                                                                WidthRequest="25" />

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                HorizontalOptions="FillAndExpand"
                                                                Style="{StaticResource CaptionLabelBlack}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="Center" />
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="2"
                                                                HorizontalOptions="Center"
                                                                Rotation="90"
                                                                VerticalOptions="Center">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                        Size="24"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                    </Border>

                                                </Grid>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                </Grid>

                                <Grid
                                    Grid.Row="0"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsMonthsAtachmentsVisible}">

                                    <listView:SfListView
                                        AutoFitMode="Height"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="False"
                                        ItemSpacing="5"
                                        ItemsSource="{Binding MonthsattachmentsListViewData}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent"
                                        SelectionMode="SingleDeselect"
                                        TapCommand="{Binding NewAttachmentTapped}"
                                        VerticalOptions="Center">


                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        Margin="0,0,0,10"
                                                        Padding="12"
                                                        Style="{StaticResource SfStyleGreyBorderFrame}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Margin="5,0"
                                                                HeightRequest="25"
                                                                HorizontalOptions="Start"
                                                                Source="Generic_attachment_icon"
                                                                VerticalOptions="Center"
                                                                WidthRequest="25" />

                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                HorizontalOptions="FillAndExpand"
                                                                Style="{StaticResource CaptionLabelBlack}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="Center" />
                                                            <Image
                                                                Grid.Row="0"
                                                                Grid.Column="2"
                                                                HorizontalOptions="Center"
                                                                Rotation="90"
                                                                VerticalOptions="Center">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                        Size="24"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                </Grid>

                                <Grid
                                    Grid.Row="0"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding IsOthersAtachmentsVisible}"
                                    VerticalOptions="FillAndExpand" />

                                <Grid Grid.Row="1" HorizontalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        FontFamily="{StaticResource SomarRegular}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource MicroGrayLabelStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VRNewAttachment}" />
                                    <Border
                                        Grid.Row="1"
                                        Margin="0,0,0,10"
                                        Padding="10"
                                        Style="{StaticResource SfStyleGreyBorderFrame}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                TextColor="{StaticResource PrimaryColor}" />
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="Center"
                                                Rotation="90"
                                                VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <custom:CustomLabel
                                        Grid.Row="2"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource MicroGrayLabelStyle}"
                                        Text="{x:Static ResourceManager:AppResources.VatInstalment5MB}" />

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                    </Grid.GestureRecognizers>

                                </Grid>
                            </StackLayout>

                            <Frame
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Padding="15"
                                BorderColor="LightGray"
                                CornerRadius="12"
                                HasShadow="False"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">
                                <StackLayout
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Vertical"
                                    VerticalOptions="FillAndExpand">

                                    <StackLayout Orientation="Horizontal">
                                        <Image
                                            HeightRequest="20"
                                            Source="ic_vat_info"
                                            WidthRequest="20" />
                                        <custom:CustomLabel
                                            CharacterSpacing="0"
                                            Style="{StaticResource CaptionLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.Attachments}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                    <custom:CustomLabel
