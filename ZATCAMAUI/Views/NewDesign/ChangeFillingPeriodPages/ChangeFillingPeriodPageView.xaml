                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VFCIDType}" />

                                            </Grid>

                                            <Grid Grid.Row="0" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{Binding IDType}" />
                                            </Grid>

                                            <Grid Grid.Row="1" Grid.Column="0">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VFCIDNumber}" />

                                            </Grid>

                                            <Grid Grid.Row="1" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{Binding IDNumber}" />
                                            </Grid>

                                            <Grid
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                IsVisible="{Binding IsDOBVisible}">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VFCDateofBirth}" />

                                            </Grid>

                                            <Grid
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                IsVisible="{Binding IsDOBVisible}">
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{Binding PickedDate, StringFormat='{0:dd MMM yyyy}'}" />
                                            </Grid>

                                            <Grid Grid.Row="3" Grid.Column="0">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VFCContactPersonName}" />

                                            </Grid>

                                            <Grid Grid.Row="3" Grid.Column="1">
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    Text="{Binding ContactPersonName}" />
                                            </Grid>
                                        </Grid>
                                    </StackLayout>
                                </Border>

                                <StackLayout Grid.Row="6" Grid.ColumnSpan="2">

                                    <buttons:SfButton
                                        Margin="0,16,0,16"
                                        Command="{Binding SummaryContinueBtnTapped}"
                                        HeightRequest="48"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.Submit}"
                                        WidthRequest="366" />

                                </StackLayout>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollView>
            <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            SizeFactor="0.7"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>