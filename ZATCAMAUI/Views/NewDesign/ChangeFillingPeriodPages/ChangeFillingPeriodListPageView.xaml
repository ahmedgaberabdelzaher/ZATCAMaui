<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ChangeFillingPeriodPages.ChangeFillingPeriodListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingChangeFillingPeriodListCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDFillingFrequency}"
                    VerticalOptions="Center" />


                <Image
                    Grid.Row="0"
                    Grid.Column="2"
                    HeightRequest="24"
                    HorizontalOptions="EndAndExpand"
                    Source="close"
                    VerticalOptions="CenterAndExpand"
                    WidthRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                </Image>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid RowDefinitions="*">
                    <ScrollView
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout>

                            <Grid
                                Margin="20,10,20,0"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsMyRequestsViewEnabled}"
                                RowDefinitions="auto,auto,*"
                                VerticalOptions="FillAndExpand">

                                <Grid Grid.Row="0" RowDefinitions="auto,auto,1">
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="0,10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDFillingFrequency}" />

                                    <BoxView
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="FillAndExpand"
                                    RowDefinitions="auto"
                                    VerticalOptions="FillAndExpand">

                                    <Border
                                        Grid.Row="0"
                                        Margin="0,20,0,0"
                                        Padding="16"
                                        HorizontalOptions="FillAndExpand"
                                        StrokeShape="RoundRectangle 15,15,15,15"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                Margin="0"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_add1.png"
                                                WidthRequest="24" />
                                            <Label
                                                x:Name="Filinglbl"
                                                Grid.Column="1"
                                                FontSize="15"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodButtonText}"
                                                VerticalOptions="Start" />


                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding MyRequestsButtonTapped}" />
                                            </Grid.GestureRecognizers>

                                        </Grid>


                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" VerticalOptions="Start">

                                    <listView:SfListView
                                        AutoFitMode="DynamicHeight"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="False"
                                        ItemsSource="{Binding MyRequestsListViewData}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent"
                                        SelectionMode="SingleDeselect"
                                        TapCommand="{Binding RequestItemTapCommand}"
                                        VerticalOptions="FillAndExpand">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Grid.Column="0"
                                                    Margin="0,15,0,0"
                                                    Padding="10"
                                                    FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                                    StrokeShape="RoundRectangle 15,15,15,15"
                                                    Style="{StaticResource GreyBorderFrameWithShadow}"
                                                    VerticalOptions="FillAndExpand">
                                                    <Grid VerticalOptions="FillAndExpand">

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50*" />
                                                            <ColumnDefinition Width="50*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackLayout
                                                            Grid.Row="0"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,0,0,5"
                                                            HorizontalOptions="StartAndExpand"
                                                            VerticalOptions="FillAndExpand">
                                                            <Label
                                                                Margin="0"
                                                                Padding="0"
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource SectionTitleBlackBold}"
                                                                Text="{Binding FbtText}"
                                                                VerticalOptions="FillAndExpand" />
                                                        </StackLayout>
                                                        <StackLayout
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            VerticalOptions="FillAndExpand">

                                                            <Label
                                                                HorizontalOptions="StartAndExpand"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource ValueLabelGrey}"
                                                                Text="{Binding Fbnum}"
                                                                VerticalOptions="CenterAndExpand" />

                                                        </StackLayout>
                                                        <Border
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Padding="8,3,8,3"
                                                            BackgroundColor="{StaticResource PartialBg}"
                                                            HorizontalOptions="EndAndExpand"
                                                            StrokeShape="RoundRectangle 14,14,14,14"
                                                            StrokeThickness="1"
                                                            VerticalOptions="CenterAndExpand">

                                                            <Label
                                                                HorizontalOptions="CenterAndExpand"
                                                                HorizontalTextAlignment="Center"
                                                                Style="{StaticResource CaptionLabelBlack}"
                                                                Text="{Binding FbustTxt}"
                                                                TextColor="{StaticResource Partial}"
                                                                VerticalOptions="CenterAndExpand">
                                                                <Label.Triggers>

                                                                    <DataTrigger
                                                                        Binding="{Binding FbustTxt}"
                                                                        TargetType="Label"
                                                                        Value="{x:Static ResourceManager:AppResources.NDBilled}">

                                                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.NDBilled}" />

                                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />

                                                                        <Setter Property="HorizontalTextAlignment" Value="Center" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                        </Border>

                                                    </Grid>
                                                </Border>

                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>

                                </Grid>


                            </Grid>

                            <Grid
                                Margin="20,10,20,0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsSummaryViewEnabled}"
                                VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />

                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPlanSummaryReview}" />
                                    <BoxView
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Border
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Margin="0,16,0,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0">
                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="ic_reviewDetails"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />
                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <StackLayout Padding="15" Spacing="8">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding CurrentFrequency}" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding NewFrequency}" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding EffectiveDatePicked}" />
                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>
                                    </Border>

                                    <!--  Attachments Section  -->


                                    <Border
                                        Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        Margin="0,16,0,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">

                                        <StackLayout Padding="0">

                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="ic_attachment"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />

                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                            <listView:SfListView
                                                Grid.Row="0"
                                                HorizontalOptions="Center"
                                                IsScrollingEnabled="False"
                                                ItemsSource="{Binding YearsattachmentsListViewData}"
                                                ScrollBarVisibility="Never"
                                                SelectionBackground="Transparent"
                                                SelectionMode="None"
                                                VerticalOptions="Center">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label
                                                                Grid.Column="0"
                                                                Style="{StaticResource ValueLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsTwoYears}" />
                                                            <Label
                                                                Grid.Column="1"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Filename}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>

                                            <listView:SfListView
                                                Grid.Row="0"
                                                HorizontalOptions="Center"
                                                IsScrollingEnabled="False"
                                                ItemsSource="{Binding MonthsattachmentsListViewData}"
                                                ScrollBarVisibility="Never"
                                                SelectionBackground="Transparent"
                                                SelectionMode="None"
                                                VerticalOptions="Center">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label
                                                                Grid.Column="0"
                                                                Style="{StaticResource ValueLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsTwelveMonths}" />
                                                            <Label
                                                                Grid.Column="1"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Filename}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>

                                            <listView:SfListView
                                                Grid.Row="0"
                                                HorizontalOptions="Center"
                                                IsScrollingEnabled="False"
                                                ItemsSource="{Binding OtherAttachmentsListViewData}"
                                                ScrollBarVisibility="Never"
                                                SelectionBackground="Transparent"
                                                SelectionMode="None"
                                                VerticalOptions="Center">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label
                                                                Grid.Column="0"
                                                                Style="{StaticResource ValueLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsOtherDocuments}" />
                                                            <Label
                                                                Grid.Column="1"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Filename}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>

                                        </StackLayout>
                                    </Border>

                                    <!--  Installment Agreement Section  -->

                                    <Border
                                        Grid.Row="5"
                                        Grid.ColumnSpan="2"
                                        Margin="0,16,0,10"
                                        Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0">
                                            <Grid Padding="15" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Start"
                                                        Source="declaration"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />

                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclaration}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>

                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <StackLayout Padding="15" Spacing="8">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VFCIDType}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding IDType}" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VFCIDNumber}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding IDNumber}" />
                                                </Grid>

                                                <Grid IsVisible="{Binding IsDobVisible}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.VFCDateofBirth}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding PickedDate, StringFormat='{0:dd MMM yyyy}'}" />
                                                </Grid>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Column="0"
                                                        Style="{StaticResource ValueLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.CRContactPersonName}" />
                                                    <Label
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding ContactPersonName}" />
                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>

                                    </Border>

                                    <StackLayout
                                        Grid.Row="6"
                                        Grid.ColumnSpan="2"
                                        Padding="0">

                                        <buttons:SfButton
                                            Grid.ColumnSpan="2"
                                            Margin="10,20,10,20"
                                            Command="{Binding DownloadAcknowledgementCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Text="{x:Static ResourceManager:AppResources.CRDownloadConfirmation}"
                                            VerticalOptions="End"/>
                                    </StackLayout>
                                </Grid>

                            </Grid>

                        </StackLayout>
                    </ScrollView>

                </Grid>
            </Border>
            <!--#endregion Body-->

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>
