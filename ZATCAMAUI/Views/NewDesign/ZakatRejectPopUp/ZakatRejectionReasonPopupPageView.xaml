<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatRejectPopUp.ZakatRejectionReasonPopupPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    Title="ZakatRejectionReasonPopupPageView"
    BackgroundColor="#88000000"
    FlowDirection="{Binding AppDirection}">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <Border
        x:Name="MainPanCakeView1"
        Padding="15"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">
        <Grid HeightRequest="171">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />

            </Grid.ColumnDefinitions>
            <Label
                Grid.Row="0"
                Grid.ColumnSpan="3"
                HorizontalOptions="StartAndExpand"
                Style="{StaticResource ValueLabelBlack}"
                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetReject}" />

            <Border
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Padding="10"
                Style="{StaticResource GreyBorderFrame}">
                <custom:GAZTBorderlessEntry
                    x:Name="Reason"
                    FontFamily="{StaticResource SSTArRoman}"
                    FontSize="15"
                    HorizontalOptions="FillAndExpand"
                    Text="{Binding RejectReasonText}"
                    TextColor="{StaticResource NeutralBlack}" />
            </Border>

            <buttons:SfButton
                x:Name="btnprimary"
                Grid.Row="2"
                Grid.Column="0"
                Margin="10,0,10,0"
                Clicked="RejectButtonClicked"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetReject}" />
            <buttons:SfButton
                x:Name="btnprimary1"
                Grid.Row="2"
                Grid.Column="1"
                Margin="10,0,10,0"
                Clicked="CancelButtonClicked"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetClose}" />
        </Grid>
    </Border>

</Mopups:PopupPage>