<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentSignUP.EstablishmentSignUPPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Content>
        <Grid>
            <Border Padding="0" Style="{StaticResource CommonTopCurves}">

                <Grid Padding="015" RowDefinitions="auto,auto,*,auto">
                    <!--#region Header  -->
                    <StackLayout Orientation="Horizontal">
                        <Image
                            x:Name="backArrow"
                            HorizontalOptions="Start"
                            Rotation="0"
                            Source="arrowLeft.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            HeightRequest="40"
                            HorizontalOptions="CenterAndExpand"
                            Source="ic_logo_gazt.png"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="34" />
                    </StackLayout>
                    <!--#endregion Header  -->

                    <!--#region Title  -->
                    <StackLayout
                        Grid.Row="1"
                        Spacing="10">
                        <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZTERNewAccount}" />

                        <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZSelectthetypeofEntity}" />

                        <BoxView Style="{StaticResource SeparatorStyle}" />
                    </StackLayout>
                    <!--#endregion Title  -->

                    <!--#region Action Icons  -->
                    <Grid
                        x:Name="ParentView"
                        Grid.Row="2"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        HorizontalOptions="FillAndExpand"
                        RowDefinitions="auto,auto">


                        <Grid>

                            <Image
                                Aspect="Fill"
                                HorizontalOptions="FillAndExpand"
                                Source="{Binding IndividualBackImg}"
                                VerticalOptions="FillAndExpand" />

                            <StackLayout Padding="15,0,16,16" VerticalOptions="End">

                                <Image HorizontalOptions="Start" Source="individual_32White.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IndividualBackImg}"
                                            TargetType="Image"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="individual_32.png" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <Label Style="{StaticResource ValueLabelWhiteMedium}" Text="{x:Static ResourceManager:AppResources.NDIndividuals}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IndividualBackImg}"
                                            TargetType="Label"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                            </StackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIndividualTapped" />
                            </Grid.GestureRecognizers>

                        </Grid>

                        <Grid Grid.Column="1">

                            <Image
                                Aspect="Fill"
                                HorizontalOptions="FillAndExpand"
                                Source="{Binding EstablishmentBackImg}"
                                VerticalOptions="FillAndExpand" />

                            <StackLayout Padding="15,0,16,16" VerticalOptions="End">

                                <Image HorizontalOptions="Start" Source="establishments_White.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding EstablishmentBackImg}"
                                            TargetType="Image"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="establishments_BigGreen.png" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <Label Style="{StaticResource ValueLabelWhiteMedium}" Text="{x:Static ResourceManager:AppResources.NDEstablishments}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding EstablishmentBackImg}"
                                            TargetType="Label"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                            </StackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEstablishmentTapped" />
                            </Grid.GestureRecognizers>

                        </Grid>

                    </Grid>
                    <!--#endregion Action Icons  -->
                </Grid>

            </Border>

            <!--  Loader Starts  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>