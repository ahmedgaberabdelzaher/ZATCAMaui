<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentSignUP.EstablishmentSignUPPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>-->
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView Padding="24,16,24,24"
                               Style="{StaticResource CommonTopCurves}">

                <Grid Padding="15"
                      RowDefinitions="auto,auto,*,auto">

                    <Grid
                        x:Name="ParentView"
                        Grid.Row="2"
                        RowDefinitions="auto,auto"
                        ColumnDefinitions="auto,auto"
                        ColumnSpacing="10"
                        HorizontalOptions="FillAndExpand">


                        <Grid>

                            <Image
                                Aspect="Fill"
                                HorizontalOptions="FillAndExpand"
                                Source="{Binding IndividualBackImg}"
                                VerticalOptions="FillAndExpand" />

                            <StackLayout Padding="15,0,16,16"
                                         VerticalOptions="End">

                                <Image HorizontalOptions="Start" Source="individual_32White.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IndividualBackImg}"
                                            TargetType="Image"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="individual_32.png" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <custom:CustomLabel Style="{StaticResource ValueLabelWhiteMedium}" Text="{x:Static ResourceManager:AppResources.NDIndividuals}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IndividualBackImg}"
                                            TargetType="custom:CustomLabel"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>

                            </StackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIndividualTapped" />
                            </Grid.GestureRecognizers>

                        </Grid>

                        <Grid Grid.Column="1">

                            <Image
                                Aspect="Fill"
                                HorizontalOptions="FillAndExpand"
                                Source="{Binding EstablishmentBackImg}"
                                VerticalOptions="FillAndExpand" />

                            <StackLayout Padding="15,0,16,16" VerticalOptions="End">

                                <Image HorizontalOptions="Start" Source="establishments_White.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding EstablishmentBackImg}"
                                            TargetType="Image"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="establishments_BigGreen.png" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <custom:CustomLabel Style="{StaticResource ValueLabelWhiteMedium}" Text="{x:Static ResourceManager:AppResources.NDEstablishments}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger
                                            Binding="{Binding EstablishmentBackImg}"
                                            TargetType="custom:CustomLabel"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>

                            </StackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEstablishmentTapped" />
                            </Grid.GestureRecognizers>

                        </Grid>

                    </Grid>


                    <StackLayout Grid.Row="1"
                                 Margin="0,0,0,10"
                                 Spacing="10"
                                 Padding="0,48,0,0">
                        <custom:CustomLabel Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZTERNewAccount}" />

                        <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZSelectthetypeofEntity}" />

                        <BoxView Style="{StaticResource SeparatorStyle}" />
                    </StackLayout>

                    <!-- Header-->
                    <StackLayout Orientation="Horizontal">
                       
                       <Image
                            x:Name="backArrow"
                            HorizontalOptions="Start"
                            Rotation="0"
                            Source="arrowLeft.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                            </Image.GestureRecognizers>
                     </Image>

                    <Image
                        HeightRequest="40"
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="CenterAndExpand"
                         Source="ic_logo_gazt.png"
                        WidthRequest="34" />
                    </StackLayout>

                    <!--  Loader Starts  -->
                </Grid>
            </yummy:PancakeView>


            <Grid
                Grid.Row="0"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="Cupertino"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            IndicatorColor="{StaticResource Secondary}"
                            IsRunning="True"
                            SizeFactor="0.6"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>