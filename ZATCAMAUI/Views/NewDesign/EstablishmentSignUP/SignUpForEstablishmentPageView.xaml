<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentSignUP.SignUpForEstablishmentPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ZATCAMAUI.Core.Enums"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    ios:Page.UseSafeArea="true"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:EstablishmentSignUPTabEnumToVisibilityConverters x:Key="enumToVisibilityConverter" />

            <Style x:Key="circleFrame" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 25,25,25,25" />
                <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                <Setter Property="HeightRequest" Value="25" />
                <Setter Property="WidthRequest" Value="25" />
            </Style>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--  Header  -->
            <Grid Padding="20,5" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="arrowRight.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <Image
                    Grid.Column="1"
                    HeightRequest="40"
                    Source="ic_logo_gazt.png"
                    WidthRequest="34" />

                <StackLayout Grid.Column="2" VerticalOptions="CenterAndExpand">
                    <Image
                        HorizontalOptions="End"
                        Source="close.png"
                        Style="{StaticResource SmallIcon}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Closed_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

            </Grid>

            <Border
                Grid.Row="1"
                Padding="20,10,20,0"
                Style="{StaticResource CommonTopCurves}">

                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <!--  Bullets  -->
                    <commonView:PageIndicatorView
                        Completed="{Binding MarkComplete}"
                        DotSize="12"
                        HorizontalOptions="End"
                        MaxNum="{Binding MaxIndex}"
                        MinNum="{Binding CurrentIndex}"
                        VerticalOptions="Start" />

                    <Label
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource PageTitleBlack}"
                        Text="{Binding PageTitle}"
                        VerticalOptions="Start" />

                    <Label
                        Style="{StaticResource BodyLabelGrey}"
                        Text="{Binding BodyText}"
                        VerticalOptions="Start" />

                    <BoxView
                        BackgroundColor="{StaticResource NeutralLightGrey}"
                        HeightRequest="1"
                        Style="{StaticResource SeparatorStyle}"
                        VerticalOptions="Start" />

                    <!--  step 1  -->
                    <WebView
                        x:Name="TCWebView"
                        HeightRequest="550"
                        IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.TermsAndConditions}}" />

                    <ScrollView
                        Margin="0,10"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">

                        <StackLayout>


                            <!--  Start step 2  -->
                            <StackLayout IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.IndividualInformation}}">

                                <Label HorizontalOptions="StartAndExpand" Style="{StaticResource CaptionLabelGrey}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZAlreadyhaveTIN}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!--  Yes/No View  -->
                                <Grid
                                    Margin="0,10"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="20">

                                    <!--  Yes View  -->
                                    <Grid>

                                        <Image Aspect="AspectFill" Source="{Binding ImgBackgroundYes}" />


                                        <Label
                                            Margin="16,0,16,0"
                                            Padding="16,8,16,8"
                                            Style="{StaticResource ButtonLabelBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZYesText}"
                                            VerticalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundYes}"
                                                    TargetType="Label"
                                                    Value="re_Tile_Background">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnYesTapped" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <!--  No View  -->
                                    <Grid Grid.Column="1">

                                        <Image
                                            x:Name="NoBackGroungImg"
                                            Aspect="AspectFill"
                                            Source="{Binding ImgBackgroundNo}" />

                                        <Label
                                            Margin="16,0,16,0"
                                            Padding="16,8,16,8"
                                            Style="{StaticResource ButtonLabelBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZNoText}"
                                            VerticalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundNo}"
                                                    TargetType="Label"
                                                    Value="re_Tile_Background">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNoTapped" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                </Grid>

                                <!--  TIN Number  -->
                                <StackLayout IsVisible="False">

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZTIN}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmTIN"
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="{x:Static ResourceManager:AppResources.TIN}"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10"
                                        Stroke="{StaticResource NeutralGreay}">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="EntryTIN"
                                            Focused="EntryTIN_focused"
                                            FontFamily="{StaticResource SomarLight}"
                                            FontSize="Small"
                                            IsSpellCheckEnabled="False"
                                            Keyboard="Numeric"
                                            MaxLength="10"
                                            Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtTIN}"
                                            TextChanged="EntryTIN_TextChanged"
                                            Unfocused="EntryTIN_Unfocused"
                                            VerticalTextAlignment="Center">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>

                                    </inputLayout:SfTextInputLayout>

                                    <StackLayout.Triggers>
                                        <DataTrigger
                                            Binding="{Binding ImgBackgroundYes}"
                                            TargetType="StackLayout"
                                            Value="re_Tile_Background">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </StackLayout.Triggers>

                                </StackLayout>

                                <!--  ID Type  -->
                                <StackLayout>

                                    <Label HorizontalOptions="StartAndExpand" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <inputLayout:SfTextInputLayout
                                        x:Name="txtEntryName"
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="{x:Static ResourceManager:AppResources.ZZIDType}"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10">

                                        <custom:GAZTBorderlessEntry
                                            BackgroundColor="Transparent"
                                            IsReadOnly="True"
                                            InputTransparent="True"
                                            Placeholder="{x:Static ResourceManager:AppResources.ZZIDType}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtIDType}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalTextAlignment="Center" />

                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png" Style="{StaticResource SmallIcon}" />
                                        </inputLayout:SfTextInputLayout.TrailingView>

                                        <inputLayout:SfTextInputLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnIDTypeClicked" />
                                        </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    </inputLayout:SfTextInputLayout>

                                    <syncfusion:SfPicker
                                        x:Name="IDTypePicker"
                                        Margin="0"
                                        Background="Transparent"
                                        ItemHeight="46"
                                        Mode="Dialog"
                                        OkButtonClicked="DDlIDType_OkayButtonClicked"
                                        SelectionChanged="IDTypePicker_SelectionChanged">

                                        <syncfusion:SfPicker.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.TextStyle>

                                        <syncfusion:SfPicker.Columns>
                                            <syncfusion:PickerColumn
                                                Width="300"
                                                DisplayMemberPath="SUType"
                                                ItemsSource="{Binding SignUpUsingList}"
                                                SelectedIndex="{Binding IDTypeIndex}" />
                                        </syncfusion:SfPicker.Columns>

                                        <syncfusion:SfPicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="{StaticResource NeutralBlack}" />
                                        </syncfusion:SfPicker.SelectedTextStyle>

                                        <syncfusion:SfPicker.SelectionView>
                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                        </syncfusion:SfPicker.SelectionView>

                                        <syncfusion:SfPicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="55"
                                                Background="{StaticResource Primary}"
                                                Text="{x:Static ResourceManager:AppResources.ZZIDType}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </syncfusion:SfPicker.HeaderView>

                                        <syncfusion:SfPicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </syncfusion:SfPicker.FooterView>

                                    </syncfusion:SfPicker>

                                </StackLayout>

                                <!--  ID Number  -->
                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.NDIDNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmIDNumber"
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="{x:Static ResourceManager:AppResources.NDIDNumber}"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10">
                                        <custom:GAZTBorderlessEntry
                                            x:Name="EntryIDNumber"
                                            IsSpellCheckEnabled="False"
                                            Keyboard="Numeric"
                                            MaxLength="{Binding MaxLengthID}"
                                            Placeholder="{x:Static ResourceManager:AppResources.NDIDNumber}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtIDNumber}"
                                            TextChanged="GAZTBorderlessEntry_TextChanged"
                                            Unfocused="EntryIDNumber_Unfocused"
                                            VerticalTextAlignment="Center">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>
                                    </inputLayout:SfTextInputLayout>

                                </StackLayout>

                                <!--  DOB  -->
                                <StackLayout>
                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <busyindicator:SfChipGroup
                                        x:Name="ChipGroup_statusFilter"
                                        Margin="0,10"
                                        ChipBackground="Transparent"
                                        ChipStroke="{StaticResource NeutralLightGrey}"
                                        ChipStrokeThickness="1"
                                        ChipType="Choice"
                                        HorizontalOptions="Start"
                                        ItemsSource="{Binding ChipDataFilterlist}"
                                        SelectedChipBackground="{StaticResource PartialBg}"
                                        SelectionChanged="ChipGroup_statusFilter_SelectionChanged"
                                        VerticalOptions="Center">
                                        <busyindicator:SfChipGroup.ItemTemplate>
                                            <DataTemplate>
                                                <StackLayout WidthRequest="80">
                                                    <Label
                                                        HorizontalOptions="FillAndExpand"
                                                        HorizontalTextAlignment="Center"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        StyleId="OnBoardText"
                                                        Text="{Binding Text}" />
                                                </StackLayout>
                                            </DataTemplate>
                                        </busyindicator:SfChipGroup.ItemTemplate>
                                    </busyindicator:SfChipGroup>

                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmDBO"
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="dd/MM/yyyy"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10"
                                        Stroke="{StaticResource NeutralGreay}">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="DateEntry"
                                            FontFamily="{StaticResource SomarLight}"
                                            FontSize="Small"
                                            InputTransparent="True"
                                            IsReadOnly="True"
                                            Keyboard="Text"
                                            Placeholder="dd/MM/yyyy"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding PickerDobToDisplay}"
                                            TextChanged="DateEntry_TextChanged"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalTextAlignment="Center" />

                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image
                                                HorizontalOptions="EndAndExpand"
                                                Source="calendar.png"
                                                Style="{StaticResource SmallIcon}" />
                                        </inputLayout:SfTextInputLayout.TrailingView>

                                        <inputLayout:SfTextInputLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDOBClicked" />
                                        </inputLayout:SfTextInputLayout.GestureRecognizers>

                                    </inputLayout:SfTextInputLayout>

                                    <!--  DatePicker  -->
                                    <custom:CustomDatePicker
                                        x:Name="DpDbo"
                                        Background="White"
                                        CancelButtonClicked="DpDbo_CancelButtonClicked"
                                        Closed="DpDbo_Closed"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="46"
                                        Mode="Dialog"
                                        SelectedItem="{Binding TodayDate}">

                                        <custom:CustomDatePicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                                        </custom:CustomDatePicker.ColumnHeaderView>

                                        <custom:CustomDatePicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </custom:CustomDatePicker.SelectedTextStyle>

                                        <custom:CustomDatePicker.SelectionView>
                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                        </custom:CustomDatePicker.SelectionView>

                                        <custom:CustomDatePicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="46"
                                                Background="White"
                                                Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}">
                                                <syncfusion:PickerHeaderView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                                </syncfusion:PickerHeaderView.TextStyle>
                                            </syncfusion:PickerHeaderView>

                                        </custom:CustomDatePicker.HeaderView>

                                        <custom:CustomDatePicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="{StaticResource Secondary}">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </custom:CustomDatePicker.FooterView>

                                    </custom:CustomDatePicker>

                                    <!--  HijriDatePicker  -->
                                    <custom:CustomHijriDatePicker
                                        x:Name="DpDboHijri"
                                        Background="White"
                                        CancelButtonClicked="DpDbo_CancelButtonClicked"
                                        Closed="DpDbo_Closed"
                                        HorizontalOptions="FillAndExpand"
                                        ItemHeight="46"
                                        Mode="Dialog"
                                        SelectedItem="{Binding TodayDateinHijri}">

                                        <custom:CustomHijriDatePicker.ColumnHeaderView>
                                            <syncfusion:PickerColumnHeaderView Height="46" Background="White" />
                                        </custom:CustomHijriDatePicker.ColumnHeaderView>

                                        <custom:CustomHijriDatePicker.SelectionView>
                                            <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                        </custom:CustomHijriDatePicker.SelectionView>

                                        <custom:CustomHijriDatePicker.HeaderView>

                                            <syncfusion:PickerHeaderView
                                                Height="46"
                                                Background="White"
                                                Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />

                                        </custom:CustomHijriDatePicker.HeaderView>

                                        <custom:CustomHijriDatePicker.SelectedTextStyle>
                                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralBlack}" />
                                        </custom:CustomHijriDatePicker.SelectedTextStyle>

                                        <custom:CustomHijriDatePicker.FooterView>

                                            <syncfusion:PickerFooterView Height="46" Background="{StaticResource Secondary}">

                                                <syncfusion:PickerFooterView.TextStyle>
                                                    <syncfusion:PickerTextStyle TextColor="White" />
                                                </syncfusion:PickerFooterView.TextStyle>

                                            </syncfusion:PickerFooterView>

                                        </custom:CustomHijriDatePicker.FooterView>

                                    </custom:CustomHijriDatePicker>



                                </StackLayout>

                                <!--  Name  -->
                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}">

                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmName"
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="{x:Static ResourceManager:AppResources.ZZName}"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10"
                                        Stroke="{StaticResource NeutralGreay}">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="EntryName"
                                            FontSize="Small"
                                            IsSpellCheckEnabled="False"
                                            Placeholder="{x:Static ResourceManager:AppResources.ZZName}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtName}"
                                            Unfocused="EntryName_Unfocused">

                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:AlphabetandArabicCharacters />
                                            </custom:GAZTBorderlessEntry.Behaviors>

                                        </custom:GAZTBorderlessEntry>
                                    </inputLayout:SfTextInputLayout>

                                </StackLayout>

                            </StackLayout>

                            <!--  Start step 3  -->
                            <StackLayout IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.BusinessInformation}}">

                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZSelectatleastoneofthefieldsCommercialRegistrationNumberorLicencebelow}" />

                                <!--  CRNumber/LicenseNumber View  -->
                                <Grid
                                    Margin="0,10,0,15"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="20">

                                    <!--  CRNumber View  -->
                                    <Grid>

                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="100"
                                            Source="{Binding ImgBackgroundCRNubmer}"
                                            WidthRequest="160" />

                                        <Label
                                            Margin="16,0,16,0"
                                            Padding="16,8,16,8"
                                            Style="{StaticResource ButtonLabelBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZCRNumber}"
                                            VerticalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundCRNubmer}"
                                                    TargetType="Label"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCRNumberTapped" />
                                        </Grid.GestureRecognizers>

                                    </Grid>

                                    <!--  LicenseNumber View  -->
                                    <Grid Grid.Column="1">

                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="100"
                                            Source="{Binding ImgBackgroundLicenseNubmer}"
                                            WidthRequest="160" />

                                        <Label
                                            Margin="16,0"
                                            Padding="16,8"
                                            Style="{StaticResource ButtonLabelBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}"
                                            VerticalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                    TargetType="Label"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnLicenseNumberTapped" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                </Grid>

                                <!--  CR Number  -->
                                <StackLayout IsVisible="{Binding CROptionsVisible}">

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZCRNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmCR"
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="{x:Static ResourceManager:AppResources.ZZCRNumber}"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="EntryCRNumber"
                                            Keyboard="Numeric"
                                            MaxLength="10"
                                            Placeholder="{x:Static ResourceManager:AppResources.ZZCRNumber}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtCRNumber}"
                                            TextChanged="EntryCRNumber_TextChanged"
                                            Unfocused="EntryCRNumber_Unfocused"
                                            VerticalTextAlignment="Center">

                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:OnlyNumericValuesBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>

                                    </inputLayout:SfTextInputLayout>

                                </StackLayout>

                                <!--  License Number  -->
                                <StackLayout IsVisible="{Binding LicenseOptionsVisible}">

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
