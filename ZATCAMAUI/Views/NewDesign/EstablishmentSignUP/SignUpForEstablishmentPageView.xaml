                                        </StackLayout>

                                        <buttons:SfButton
                                            Margin="0,50,0,0"
                                            Background="Transparent"
                                            Command="{Binding OnResendOTPClicked}"
                                            FontFamily="{StaticResource SomarBold}"
                                            IsEnabled="{Binding IsResendOTPEnabled}"
                                            Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                            TextColor="{Binding ButtonDisableTextColor}"
                                            VerticalOptions="EndAndExpand">
                                            <buttons:SfButton.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsResendOTPEnabled}"
                                                    TargetType="buttons:SfButton"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsResendOTPEnabled}"
                                                    TargetType="buttons:SfButton"
                                                    Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource NeutralGreay}" />
                                                </DataTrigger>
                                            </buttons:SfButton.Triggers>
                                        </buttons:SfButton>

                                    </StackLayout>

                                </StackLayout>

                                <!--  Password  -->
                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.NDNewPassword}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <inputLayout:SfTextInputLayout
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="{x:Static ResourceManager:AppResources.NDNewPassword}"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="EntryPass"
                                            IsPassword="{Binding IsPasswordEncripted}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtPassword}"
                                            TextChanged="EntryPass_TextChanged"
                                            TextColor="{StaticResource NeutralBlack}">
                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:PasswordTextBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>

                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image
                                                x:Name="imageNewPassword"
                                                Source="showPassword.png"
                                                Style="{StaticResource SmallIcon}">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ImageSeeNewPassword_Tapped" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>

                                <StackLayout>

                                    <Label HorizontalOptions="Start" Style="{StaticResource CaptionLabelGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <inputLayout:SfTextInputLayout
                                        ContainerBackground="White"
                                        ContainerType="Outlined"
                                        Hint="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="10">

                                        <custom:GAZTBorderlessEntry
                                            x:Name="EntryCfrmPass"
                                            IsPassword="{Binding IsConfirmPasswordEncripted}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtConfirmPassword}"
                                            TextColor="{StaticResource NeutralBlack}">

                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                <behaviors:PasswordTextBehaviour />
                                            </custom:GAZTBorderlessEntry.Behaviors>
                                        </custom:GAZTBorderlessEntry>

                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image
                                                x:Name="imageConfirmPassword"
                                                Source="showPassword.png"
                                                Style="{StaticResource SmallIcon}">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ImageSeeConfirmPassword_Tapped" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>

                                <StackLayout x:Name="PasswordChecks" Margin="0,20">

                                    <StackLayout Orientation="Horizontal" Spacing="16">

                                        <Image Source="{Binding MinEight}" Style="{StaticResource SmallIcon}" />

                                        <Label
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.NDAtleast8character}" />

                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="16">
                                        <Image Source="{Binding CapsSmall}" Style="{StaticResource SmallIcon}" />
                                        <Label
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.NDEnglishcapitalandsmallletters}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="16">
                                        <Image Source="{Binding MaxSixteen}" Style="{StaticResource SmallIcon}" />
                                        <Label
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="16">
                                        <Image Source="{Binding NumSymbol}" Style="{StaticResource SmallIcon}" />
                                        <Label
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.NDNumbersAndSymbols}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                </StackLayout>

                            </StackLayout>

                            <!--  Start step 6  -->
                            <StackLayout IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.MobileVerification}}">

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0,10,0,10">
                                        <Grid Padding="10,0,10,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">

                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="vat_user"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    Style="{StaticResource SectionTitleBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZIndividualInformation}"
                                                    VerticalTextAlignment="Center" />
                                            </StackLayout>


                                            <buttons:SfButton
                                                x:Name="Btn_Edit_indiviadualInfo"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Clicked="Btn_Edit_indiviadualInfo_Clicked"
                                                HorizontalOptions="End"
                                                Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                        </Grid>



                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />



                                        <StackLayout Padding="10" Spacing="10">

                                            <StackLayout IsVisible="False" Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZTIN}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtTIN}" />

                                                <StackLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding ImgBackgroundYes}"
                                                        TargetType="StackLayout"
                                                        Value="re_Tile_Background">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </StackLayout.Triggers>
                                            </StackLayout>


                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtIDType}" />
                                            </StackLayout>



                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDIDNumber}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtIDNumber}" />
                                            </StackLayout>



                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding PickerDobToDisplay}" />
                                            </StackLayout>



                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtName}" />
                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0,10,0,10">
                                        <Grid Padding="10,0,10,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">

                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="ic_company"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    Style="{StaticResource SectionTitleBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZBusinessInformation}"
                                                    VerticalTextAlignment="Center" />
                                            </StackLayout>

                                            <buttons:SfButton
                                                x:Name="Btn_Edit_BusinessInfo"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Clicked="Btn_Edit_BusinessInfo_Clicked"
                                                HorizontalOptions="End"
                                                Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                        </Grid>



                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />


                                        <StackLayout Padding="10" Spacing="10">


                                            <StackLayout IsVisible="false" Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZCRNumber}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtCRNumber}" />
                                                <StackLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding ImgBackgroundCRNubmer}"
                                                        TargetType="StackLayout"
                                                        Value="FP_selected_tile">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </StackLayout.Triggers>
                                            </StackLayout>


                                            <StackLayout IsVisible="false" Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtLicenseNumber}" />
                                                <StackLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                        TargetType="StackLayout"
                                                        Value="FP_selected_tile">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </StackLayout.Triggers>
                                            </StackLayout>


                                            <StackLayout IsVisible="false" Orientation="Horizontal">
                                                <Label
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZLicenseNumberIssuedBy}"
                                                    WidthRequest="200" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtLOrCIssuedBy}"
                                                    WidthRequest="200" />
                                                <StackLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                        TargetType="StackLayout"
                                                        Value="FP_selected_tile">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </StackLayout.Triggers>
                                            </StackLayout>


                                            <StackLayout IsVisible="false" Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZIssuingCity}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtLOrCIssuedByCity}" />
                                                <StackLayout.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                        TargetType="StackLayout"
                                                        Value="FP_selected_tile">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </StackLayout.Triggers>
                                            </StackLayout>


                                        </StackLayout>
                                    </StackLayout>
                                </Border>

                                <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="10,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">

                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="phone_Green"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    Style="{StaticResource SectionTitleBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.ZZZContactInformation}"
                                                    VerticalTextAlignment="Center" />
                                            </StackLayout>



                                            <buttons:SfButton
                                                x:Name="Btn_Edit_ContactInfo"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Clicked="Btn_Edit_ContactInfo_Clicked"
                                                HorizontalOptions="End"
                                                Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                                Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                        </Grid>



                                        <BoxView
                                            BackgroundColor="LightGray"
                                            HeightRequest="1"
                                            HorizontalOptions="FillAndExpand" />



                                        <StackLayout Padding="10" Spacing="10">
                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZEmailAddress}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtEmailAddress}" />
                                            </StackLayout>



                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZMobileNumber}" />
                                                <Label
                                                    FlowDirection="LeftToRight"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TxtCountryCode}" />
                                                            <Span Text="{Binding TxtMobileNumber}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                            </StackLayout>



                                            <StackLayout Orientation="Horizontal">
                                                <Label Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZPhoneNumber}" />
                                                <Label
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TxtPhoneNumber}" />
                                            </StackLayout>
                                        </StackLayout>
                                    </StackLayout>
                                </Border>
                            </StackLayout>

                            <!--  terms and condition  CheckBox  -->
                            <StackLayout
                                Margin="0,0"
                                IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.TermsAndConditions}}"
                                Orientation="Horizontal">

                                <!--  terms and condition  CheckBox  -->
                                <custom:CheckboxCustom
                                    x:Name="chkDeclaration"
                                    IsChecked="{Binding IsDeclarationCheckedForInstruction}"
                                    Style="{StaticResource CheckboxHeightWidth32}"
                                    VerticalOptions="CenterAndExpand" />

                                <Label
                                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZIAgreeTheseTermsCond}" />

                            </StackLayout>

                            <!--  Summary end  -->
                            <buttons:SfButton
                                x:Name="btnprimary"
                                Clicked="btnSubmitNext_Clicked"
                                IsEnabled="{Binding IsNextButtonEnable}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{Binding NextBTN}"
                                VerticalOptions="EndAndExpand">
                                <buttons:SfButton.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsNextButtonEnable}"
                                        TargetType="buttons:SfButton"
                                        Value="True">
                                        <Setter Property="Background" Value="{StaticResource Secondary}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsNextButtonEnable}"
                                        TargetType="buttons:SfButton"
                                        Value="False">
                                        <Setter Property="Background" Value="{StaticResource NeutralGreay}" />
                                    </DataTrigger>
                                </buttons:SfButton.Triggers>
                            </buttons:SfButton>

                        </StackLayout>



                    </ScrollView>



                </StackLayout>

            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />



        </Grid>
    </ContentPage.Content>
</ContentPage>