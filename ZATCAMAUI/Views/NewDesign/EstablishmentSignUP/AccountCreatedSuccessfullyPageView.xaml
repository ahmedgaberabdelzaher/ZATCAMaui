<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.EstablishmentSignUP.AccountCreatedSuccessfullyPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Content>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout
                Grid.Row="0"
                Padding="24,0,24,16"
                VerticalOptions="CenterAndExpand">
                <Image Margin="0,75,0,0" Source="Forget_ic_success.png" />
                <Label
                    Margin="0,25,0,0"
                    HorizontalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    StyleId="OnBoardText"
                    Text="{x:Static ResourceManager:AppResources.ZZAccountCreatedSuccessfully}" />

            </StackLayout>
            <Border
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="20"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 20,20,0,0"
                VerticalOptions="EndAndExpand">
                <StackLayout>
                    <Frame
                        Margin="0,20,0,0"
                        Padding="0"
                        BorderColor="LightGray"
                        CornerRadius="8"
                        HasShadow="False">
                        <StackLayout Padding="10" Orientation="Horizontal">
                            <Label
                                FontFamily="{StaticResource SomarSemiBold}"
                                FontSize="11"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.TINS}"
                                TextColor="{StaticResource DarkGrayTextColor}"
                                VerticalOptions="Center" />
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                <Label
                                    x:Name="Label_Tin"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="15"
                                    Text="{Binding TINnumber}"
                                    TextColor="#010101" />
                                <Image x:Name="Image_Copy">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.ContentPaste}"
                                            Size="25"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Image_Copy_Tapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                        </StackLayout>

                    </Frame>

                    <buttons:SfButton
                        x:Name="btnprimary"
                        Margin="0,20,0,0"
                        Clicked="OnGoToLoginClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.Clickhereforlogin}" />
                </StackLayout>
            </Border>
        </Grid>

    </ContentPage.Content>
</ContentPage>