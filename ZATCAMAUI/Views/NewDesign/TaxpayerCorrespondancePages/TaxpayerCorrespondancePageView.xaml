<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerCorrespondancePages.TaxpayerCorrespondancePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    x:Name="page"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZCorrespondence}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <Border Grid.Row="1" Style="{StaticResource CommonTopCurves}">

                <StackLayout>

                    <StackLayout Padding="0">

                        <!--  Picker  -->
                        <Grid>

                            <StackLayout
                                HorizontalOptions="Start"
                                Orientation="Horizontal"
                                Spacing="0">

                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="28"
                                    HorizontalOptions="StartAndExpand"
                                    HorizontalTextAlignment="Start"
                                    Text="{Binding FilterTaxTypeLabelText}"
                                    TextColor="{StaticResource NeutralBlack}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btn_TaxTypeClicked" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Image
                                    HorizontalOptions="Start"
                                    Source="arrowDropdown"
                                    VerticalOptions="Center">
                                    <Image.Margin>
                                        <OnPlatform x:TypeArguments="Thickness">
                                            <On Platform="iOS" Value="5,8,5,0" />
                                            <On Platform="Android" Value="5,10,5,0" />
                                        </OnPlatform>
                                    </Image.Margin>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="btn_TaxTypeClicked" />
                                    </Image.GestureRecognizers>
                                </Image>

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_TaxTypeClicked" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>

                            <custom:CustomSfPicker
                                x:Name="TaxTypeDownPicker"
                                Margin="10,0"
                                Background="Transparent"
                                ItemHeight="40"
                                Mode="Dialog"
                                SelectionChanged="TaxTypeDownPicker_SelectionChanged">

                                <custom:CustomSfPicker.SelectionView>
                                    <syncfusion:PickerSelectionView Background="{StaticResource Secondary}" />
                                </custom:CustomSfPicker.SelectionView>

                                <custom:CustomSfPicker.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralGreay}" />
                                </custom:CustomSfPicker.TextStyle>

                                <custom:CustomSfPicker.SelectedTextStyle>
                                    <syncfusion:PickerTextStyle
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{StaticResource NeutralBlack}" />
                                </custom:CustomSfPicker.SelectedTextStyle>

                                <custom:CustomSfPicker.Columns>
                                    <syncfusion:PickerColumn
                                        Width="300"
                                        DisplayMemberPath="TaxType"
                                        ItemsSource="{Binding TaxTypeListForDropDown}" />
                                </custom:CustomSfPicker.Columns>

                                <custom:CustomSfPicker.HeaderView>

                                    <syncfusion:PickerHeaderView Height="55" Text="{Binding FilterTaxTypeLabelText}"
                                                                 Background="{StaticResource Primary}">
                                        <syncfusion:PickerHeaderView.TextStyle>
                                            <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                        </syncfusion:PickerHeaderView.TextStyle>
                                    </syncfusion:PickerHeaderView>

                                </custom:CustomSfPicker.HeaderView>

                                <custom:CustomSfPicker.FooterView>

                                    <syncfusion:PickerFooterView Height="46" Background="{StaticResource Primary}">

                                        <syncfusion:PickerFooterView.TextStyle>
                                            <syncfusion:PickerTextStyle TextColor="White" />
                                        </syncfusion:PickerFooterView.TextStyle>

                                    </syncfusion:PickerFooterView>

                                </custom:CustomSfPicker.FooterView>

                            </custom:CustomSfPicker>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_TaxTypeClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!--  Counter  -->
                        <Label
                            Margin="5,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource TPCorrCaptionLabelGrey}"
                            Text="{Binding CountLabel}">
                            <Label.FormattedText>

                                <FormattedString>

                                    <Span Style="{StaticResource TPCorrCaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDCount}" />

                                    <Span Style="{StaticResource TPCorrCaptionLabelGrey}" Text=" : " />

                                    <Span Style="{StaticResource TPCorrCaptionLabelGrey}" Text="{Binding Count}" />

                                </FormattedString>

                            </Label.FormattedText>

                        </Label>

                        <!--  Favourite Chip  -->
                        <ScrollView
                            HorizontalOptions="Start"
                            HorizontalScrollBarVisibility="Never"
                            IsVisible="{Binding IsVisibleFavourite}"
                            Orientation="Horizontal">

                            <buttons:SfChipGroup
                                x:Name="ChipGroup_statusFilter"
                                Margin="0,10,0,0"
                                ChipBackground="Transparent"
                                ChipStroke="{StaticResource SecondaryNew}"
                                ChipStrokeThickness="1"
                                ChipType="Filter"
                                HorizontalOptions="Start"
                                ItemsSource="{Binding ChipDataFilterlist}"
                                SelectedChipBackground="{StaticResource PartialBg}"
                                SelectedChipTextColor="{StaticResource Partial}"
                                SelectionChanging="ChipGroup_statusFilter_SelectionChanged"
                                VerticalOptions="Center">
                                <buttons:SfChipGroup.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout
                                            FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                            Margin="0"
                                            Padding="5"
                                            HorizontalOptions="StartAndExpand"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <Image
                                                HeightRequest="25"
                                                HorizontalOptions="Center"
                                                Source="{Binding ImageSource}" />
                                            <Label
                                                HorizontalOptions="Center"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding Text}"
                                                TextColor="{StaticResource SecondaryNew}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                    </DataTemplate>
                                </buttons:SfChipGroup.ItemTemplate>
                            </buttons:SfChipGroup>

                        </ScrollView>

                    </StackLayout>

                    <!--  Data List  -->
                    <StackLayout Padding="15,0,15,15">

                        <listView:SfListView
                            AutoFitMode="DynamicHeight"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsListVisible}"
                            ItemTapped="ListView_Correspondance_ItemTapped"
                            ItemsSource="{Binding ListToDisplay}"
                            ScrollBarVisibility="Never"
                            SelectionBackground="Transparent"
                            SelectionMode="SingleDeselect"
                            VerticalOptions="FillAndExpand">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,15,0,0"
                                        FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                        Padding="10"
                                        StrokeShape="RoundRectangle 15,15,15,15"
                                        Style="{StaticResource GreyBorderFrameWithShadow}"
                                        VerticalOptions="FillAndExpand">

                                        <Grid
                                            ColumnDefinitions="*,30"
                                            RowDefinitions="auto"
                                            VerticalOptions="FillAndExpand">

                                            <Grid RowDefinitions="auto,auto" VerticalOptions="FillAndExpand">

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Margin="0,0,5,5"
                                                    HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand">

                                                    <Label
                                                        Margin="0"
                                                        Padding="0"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}"
                                                        Text="{Binding Title}"
                                                        VerticalOptions="FillAndExpand" />
                                                </StackLayout>


                                                <StackLayout
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,5,5"
                                                    Spacing="10"
                                                    Orientation="Horizontal"
                                                    VerticalOptions="FillAndExpand">
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding DateToDisplay}" />
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding TimeToDisplay}" />

                                                </StackLayout>
                                            </Grid>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,0,5,5"
                                                HorizontalOptions="End"
                                                VerticalOptions="CenterAndExpand">
                                                <Image
                                                     x:Name="ImageBackArrow"
                                                     HeightRequest="30"
                                                     Source="{Binding FavImg}"
                                                     Style="{DynamicResource BackButtonArrow}"
                                                     WidthRequest="30" >
                                                    </Image>

                                            </StackLayout>
                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>


                        <!--  IsNoDataLableVisible  -->
                        <Label
                            Margin="0,20,0,0"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsNoDataLableVisible}"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.Nodataavailable}"
                            VerticalOptions="Center" />

                    </StackLayout>

                </StackLayout>

            </Border>

            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>