<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TaxpayerCorrespondancePages.TaxpayerCorrespondancePageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behavior="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ZZCorrespondence}" />

                        <Image
                            x:Name="Image_BacKIcon"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <yummy:PancakeView
                        Padding="0"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout
                Grid.Row="0"
                Padding="15,15,15,0"
                Spacing="-5">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Start"
                        Orientation="Horizontal"
                        Spacing="0">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="28"
                            HorizontalOptions="StartAndExpand"
                            HorizontalTextAlignment="Start"
                            Text="{Binding FilterTaxTypeLabelText}"
                            TextColor="{StaticResource NeutralBlack}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_TaxTypeClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Image
                            HorizontalOptions="Start"
                            Source="arrowDropdown"
                            VerticalOptions="Center">
                            <Image.Margin>
                                <OnPlatform x:TypeArguments="Thickness">
                                    <On Platform="iOS" Value="5,8,5,0" />
                                    <On Platform="Android" Value="5,10,5,0" />
                                </OnPlatform>
                            </Image.Margin>
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_TaxTypeClicked" />
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                    <syncfusion:SfPicker
                        x:Name="TaxTypeDownPicker"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        Background="White"
                        FlowDirection="RightToLeft"
                        ItemHeight="40"
                        Mode="Dialog"
                        SelectionChanged="TaxTypeDownPicker_SelectionChanged">

                        <syncfusion:SfPicker.ColumnHeaderView>
                            <syncfusion:PickerColumnHeaderView Height="46" />
                        </syncfusion:SfPicker.ColumnHeaderView>

                        <syncfusion:SfPicker.TextStyle>
                            <syncfusion:PickerTextStyle TextColor="{StaticResource NeutralGreay}" />
                        </syncfusion:SfPicker.TextStyle>

                        <syncfusion:SfPicker.SelectedTextStyle>
                            <syncfusion:PickerTextStyle
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="{StaticResource NeutralBlack}" />
                        </syncfusion:SfPicker.SelectedTextStyle>

                        <syncfusion:SfPicker.Columns>
                            <syncfusion:PickerColumn
                                Width="300"
                                DisplayMemberPath="TaxType"
                                ItemsSource="{Binding TaxTypeListForDropDown}" />
                        </syncfusion:SfPicker.Columns>

                        <syncfusion:SfPicker.HeaderView>

                            <syncfusion:PickerHeaderView Height="55" Background="{StaticResource Primary}">
                                <syncfusion:PickerHeaderView.TextStyle>
                                    <syncfusion:PickerTextStyle FontSize="13" TextColor="White" />
                                </syncfusion:PickerHeaderView.TextStyle>
                            </syncfusion:PickerHeaderView>

                        </syncfusion:SfPicker.HeaderView>

                        <syncfusion:SfPicker.FooterView>

                            <syncfusion:PickerFooterView Height="46" Background="#EAF7CC">

                                <syncfusion:PickerFooterView.TextStyle>
                                    <syncfusion:PickerTextStyle TextColor="{StaticResource Primary}" />
                                </syncfusion:PickerFooterView.TextStyle>

                            </syncfusion:PickerFooterView>

                        </syncfusion:SfPicker.FooterView>

                        <syncfusion:SfPicker.Behaviors>
                            <behavior:SfPickerBehavior />
                        </syncfusion:SfPicker.Behaviors>
                    </syncfusion:SfPicker>
                </Grid>

                <custom:CustomLabel
                    Margin="5,0,5,0"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource TPCorrCaptionLabelGrey}"
                    Text="{Binding CountLabel}">
                    <custom:CustomLabel.FormattedText>
                        <FormattedString>
                            <Span Style="{StaticResource TPCorrCaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDCount}" />
                            <Span Style="{StaticResource TPCorrCaptionLabelGrey}" Text=" : " />
                            <Span Style="{StaticResource TPCorrCaptionLabelGrey}" Text="{Binding Count}" />
                        </FormattedString>
                    </custom:CustomLabel.FormattedText>
                </custom:CustomLabel>
                <ScrollView
                    HorizontalScrollBarVisibility="Never"
                    IsVisible="{Binding IsVisibleFavourite}"
                    Orientation="Horizontal">
                    <buttons:SfChipGroup
                        x:Name="ChipGroup_statusFilter"
                        Margin="0,10,0,0"
                        ChipBackground="Transparent"
                        ChipStroke="{StaticResource SecondaryNew}"
                        ChipStrokeThickness="1"
                        ChipType="Filter"
                        HorizontalOptions="Start"
                        ItemsSource="{Binding ChipDataFilterlist}"
                        SelectedChipBackground="{StaticResource PartialBg}"
                        SelectedChipTextColor="{StaticResource Partial}"
                        SelectionChanging="ChipGroup_statusFilter_SelectionChanged"
                        VerticalOptions="Center">
                        <buttons:SfChipGroup.ItemTemplate>
                            <DataTemplate>
                                <StackLayout
                                    Margin="0"
                                    Padding="5,-2,5,-2"
                                    HorizontalOptions="StartAndExpand"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Image
                                        HeightRequest="25"
                                        HorizontalOptions="Center"
                                        Source="{Binding ImageSource}" />
                                    <custom:CustomLabel
                                        HorizontalOptions="Center"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{Binding Text}"
                                        TextColor="{StaticResource SecondaryNew}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfChipGroup.ItemTemplate>
                    </buttons:SfChipGroup>
                </ScrollView>

            </StackLayout>
            <StackLayout Grid.Row="1" Padding="15,0,15,15">


                <listView:SfListView
                    AutoFitMode="DynamicHeight"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsListVisible}"
                    ItemTapped="ListView_Correspondance_ItemTapped"
                    ItemsSource="{Binding ListToDisplay}"
                    ScrollBarVisibility="Never"
                    SelectionBackground="Transparent"
                    SelectionMode="SingleDeselect"
                    VerticalOptions="FillAndExpand">
                    <listView:SfListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Grid.Column="0"
                                Margin="0,15,0,0"
                                Padding="10"
                                StrokeShape="RoundRectangle 15,15,15,15"
                                Style="{StaticResource GreyBorderFrameWithShadow}"
                                VerticalOptions="FillAndExpand">

                                <Grid VerticalOptions="FillAndExpand">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <Grid VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <StackLayout
                                            Grid.Row="0"
                                            Margin="0,0,5,5"
                                            HorizontalOptions="StartAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                Margin="0"
                                                Padding="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{Binding Title}"
                                                VerticalOptions="FillAndExpand" />
                                        </StackLayout>


                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,5,5"
                                            Orientation="Horizontal"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding DateToDisplay}" />
                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding TimeToDisplay}" />

                                        </StackLayout>
                                    </Grid>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,5,5"
                                        HorizontalOptions="End"
                                        VerticalOptions="CenterAndExpand">
                                        <Image
                                            x:Name="ImageBackArrow"
                                            HeightRequest="30"
                                            Source="{Binding FavImg}"
                                            Style="{DynamicResource BackButtonArrow}"
                                            WidthRequest="30" />

                                    </StackLayout>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </listView:SfListView.ItemTemplate>
                </listView:SfListView>

                <custom:CustomLabel
                    Margin="0,20,0,0"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsNoDataLableVisible}"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{x:Static ResourceManager:AppResources.Nodataavailable}"
                    VerticalOptions="Center" />
            </StackLayout>
            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>