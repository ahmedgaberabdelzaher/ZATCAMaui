<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeRegistration.VATDeregistrationSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout>
                <StackLayout
                    Padding="40"
                    BackgroundColor="Transparent"
                    VerticalOptions="CenterAndExpand">
                    <Image Aspect="AspectFit" Source="Forget_ic_success.png" />
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.VATDeregistration}"
                        TextColor="White" />
                    <Label
                        FontFamily="{StaticResource SomarSemiBold}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.VatDeregistrationSubmitSuccessful}"
                        TextColor="White" />
                </StackLayout>
                <Border
                    Margin="0,20,0,0"
                    Padding="20"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 22,22,0,0"
                    VerticalOptions="Fill">
                    <StackLayout Padding="0,0,0,40">

                        <Border Margin="0,8,0,8" Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATRSName}" />
                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                    <Label
                                        x:Name="Label_Name"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelBlack}" />

                                </StackLayout>

                            </StackLayout>

                        </Border>

                        <Border Margin="0,0,0,8" Style="{StaticResource GreyBorderFrame}">

                            <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATRSAppNumber}" />
                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                    <Label
                                        x:Name="Label_ApplicationNumber"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelBlack}" />
                                    <Image>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Image_Copy_Tapped" />
                                        </Image.GestureRecognizers>
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>


                                </StackLayout>

                            </StackLayout>

                        </Border>

                        <Border Margin="0,0,0,8" Style="{StaticResource GreyBorderFrame}">

                            <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                <Label
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.Date}" />
                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                    <Label
                                        x:Name="Label_Date"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelBlack}" />

                                </StackLayout>

                            </StackLayout>
                        </Border>
                        <buttons:SfButton
                            Grid.ColumnSpan="2"
                            Margin="10,20,10,20"
                            Background="{StaticResource Secondary}"
                            Clicked="SfButton_Clicked"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="46"
                            Text="{x:Static ResourceManager:AppResources.VatInstalmentDownload}"
                            TextColor="White"
                            VerticalOptions="End" />

                        <buttons:SfButton
                            x:Name="btnDash"
                            Grid.ColumnSpan="2"
                            Margin="10,0,10,0"
                            Background="Transparent"
                            Clicked="btnDash_Clicked"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="15"
                            HeightRequest="46"
                            Style="{StaticResource SfButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="End" />
                    </StackLayout>
                </Border>
            </StackLayout>

        </ScrollView>
    </ContentPage.Content>
</ContentPage>
