<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeRegistration.VATDeregistrationInstructionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <Border
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        HorizontalOptions="End"
        IsVisible="true"
        VerticalOptions="End">
        <StackLayout
            Margin="24,8,24,0"
            BackgroundColor="Transparent"
            HorizontalOptions="End"
            VerticalOptions="End">
            <BoxView
                HorizontalOptions="Center"
                Style="{StaticResource NeutralGrayBoxViewDrag}"
                VerticalOptions="Start" />
            <Label
                Margin="0,0,0,16"
                HorizontalOptions="StartAndExpand"
                Style="{StaticResource SectionTitleBlackBold}"
                Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" />
            <Border
                Margin="0,0,0,10"
                Stroke="#B1B1B1"
                StrokeThickness="1"
                Style="{StaticResource GreyBorderFrame}">
                <StackLayout Margin="8">
                    <StackLayout Orientation="Horizontal" Spacing="0">
                        <Image
                            HeightRequest="24"
                            HorizontalOptions="Start"
                            Source="ic_vat_info.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <Label
                            Margin="10,0,10,5"
                            HorizontalOptions="End"
                            Style="{StaticResource ValueLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.Information}" />
                    </StackLayout>
                    <StackLayout Orientation="Vertical" Spacing="0">

                        <Label
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructions}" />
                        <Label
                            Margin="0"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VATDeregInstructionsAndConditionsFirst}" />
                        <Label
                            Margin="0"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VATDeregInstructionsAndConditionsSecond}" />
                    </StackLayout>
                </StackLayout>
            </Border>
            <StackLayout
                HorizontalOptions="FillAndExpand"
                Orientation="Horizontal"
                VerticalOptions="End">
                <custom:CheckboxCustom
                    Grid.Row="0"
                    Grid.Column="0"
                    IsChecked="{Binding IsInstructionChecked}"
                    IsEnabled="{Binding isInstructionCheckedEnable}"
                    Style="{StaticResource CheckboxHeightWidth32}" />

                <Label Margin="5,10,0,15" Style="{DynamicResource IsInstructionCheckedStyle}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsInstructionChecked}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsInstructionChecked}"
                            TargetType="Label"
                            Value="False">
                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </StackLayout>
            <buttons:SfButton
                x:Name="btnVATDeregistration"
                Grid.ColumnSpan="2"
                Margin="0,24,0,24"
                Background="{Binding ContinueButtonnBackroundColor}"
                Command="{Binding VATDeregistrationClicked}"
                IsEnabled="{Binding IsContinueButtonEnable}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.VATDeregistration}" />
        </StackLayout>
    </Border>

</pages:PopupPage>

