<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeRegistration.VATDeregistrationInstructionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    NavigationPage.HasNavigationBar="False">

    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->

    <yummy:PancakeView
        BackgroundColor="White"
        CornerRadius="15,15,0,0"
        HorizontalOptions="End"
        IsVisible="true"
        VerticalOptions="End">
        <StackLayout
            Margin="24,8,24,0"
            BackgroundColor="Transparent"
            HorizontalOptions="End"
            VerticalOptions="End">
            <BoxView
                HorizontalOptions="Center"
                Style="{StaticResource NeutralGrayBoxViewDrag}"
                VerticalOptions="Start" />
            <custom:CustomLabel
                Margin="0,0,0,16"
                HorizontalOptions="StartAndExpand"
                Style="{StaticResource SectionTitleBlackBold}"
                Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" />
            <Border
                Margin="0,0,0,10"
                Stroke="#B1B1B1"
                StrokeThickness="1"
                Style="{StaticResource GreyBorderFrame}">
                <StackLayout Margin="8">
                    <StackLayout Orientation="Horizontal" Spacing="0">
                        <Image
                            HeightRequest="24"
                            HorizontalOptions="Start"
                            Source="ic_vat_info.png"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <custom:CustomLabel
                            Margin="10,0,10,5"
                            HorizontalOptions="End"
                            Style="{StaticResource ValueLabelBlack}"
                            Text="{x:Static ResourceManager:AppResources.Information}" />
                    </StackLayout>
                    <StackLayout Orientation="Vertical" Spacing="0">

                        <Label
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructions}" />
                        <Label
                            Margin="0"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VATDeregInstructionsAndConditionsFirst}" />
                        <Label
                            Margin="0"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.VATDeregInstructionsAndConditionsSecond}" />
                    </StackLayout>
                </StackLayout>
            </Border>
            <StackLayout
                HorizontalOptions="FillAndExpand"
                Orientation="Horizontal"
                VerticalOptions="End">
                <custom:CheckboxCustom
                    Grid.Row="0"
                    Grid.Column="0"
                    IsChecked="{Binding IsInstructionChecked}"
                    IsEnabled="{Binding isInstructionCheckedEnable}"
                    Style="{StaticResource CheckboxHeightWidth32}" />

                <custom:CustomLabel Margin="5,10,0,15" Style="{DynamicResource IsInstructionCheckedStyle}">
                    <custom:CustomLabel.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}" />
                        </FormattedString>
                    </custom:CustomLabel.FormattedText>
                    <custom:CustomLabel.Triggers>
                        <DataTrigger
                            Binding="{Binding IsInstructionChecked}"
                            TargetType="custom:CustomLabel"
                            Value="True">
                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding IsInstructionChecked}"
                            TargetType="custom:CustomLabel"
                            Value="False">
                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                        </DataTrigger>
                    </custom:CustomLabel.Triggers>
                </custom:CustomLabel>
            </StackLayout>
            <buttons:SfButton
                x:Name="btnVATDeregistration"
                Grid.ColumnSpan="2"
                Margin="0,24,0,24"
                BackgroundColor="{Binding ContinueButtonnBackroundColor}"
                Command="{Binding VATDeregistrationClicked}"
                IsEnabled="{Binding IsContinueButtonEnable}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.VATDeregistration}" />
        </StackLayout>
    </yummy:PancakeView>

</pages:PopupPage>

