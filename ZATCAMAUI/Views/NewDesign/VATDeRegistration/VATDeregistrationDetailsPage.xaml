<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeRegistration.VATDeregistrationDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0,0,0,0"
                        BackgroundColor="White"
                        CornerRadius="15,15,0,0">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                x:Name="VATRMainGrid"
                                Grid.Row="1"
                                Margin="0"
                                Padding="0,15,0,0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                RowSpacing="0"
                                VerticalOptions="FillAndExpand">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100*" />
                                </Grid.RowDefinitions>

                                <ContentPresenter
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand" />
                            </Grid>

                            <StackLayout
                                Grid.Row="0"
                                BackgroundColor="White"
                                Orientation="Horizontal"
                                VerticalOptions="CenterAndExpand">
                                <Image
                                    Margin="0,35,0,0"
                                    HorizontalOptions="Start"
                                    Source="arrowLeft.png"
                                    Style="{DynamicResource BackButtonArrow}"
                                    VerticalOptions="CenterAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{TemplateBinding BindingContext.BackButtonTapped}" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <commonView:PageIndicatorView
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,35,0,0"
                                    Completed="{TemplateBinding BindingContext.MarkComplete}"
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{TemplateBinding BindingContext.MaxIndex}"
                                    MinNum="{TemplateBinding BindingContext.CurrentIndex}"
                                    VerticalOptions="CenterAndExpand" />


                            </StackLayout>

                        </Grid>
                    </yummy:PancakeView>
                    <Grid
                        Grid.Row="0"
                        Margin="8,0"
                        Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.DBSMVATDeregistration}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalOptions="EndAndExpand"
                            IsVisible="{TemplateBinding BindingContext.VoidIsVisible}"
                            Source="close"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="voidTapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid>
            <Grid>
                <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid>

                        <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsReasonViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>


                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}" />

                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationSubtitle}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                            </Grid>

                            <custom:CustomLabel
                                Grid.Row="1"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.VatDeregRequestType}" />
                            <listView:SfListView
                                x:Name="outletDecisionOptionsListView"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                AutoFitMode="Height"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding IsRequestTypeEnabled}"
                                IsScrollingEnabled="False"
                                ItemSpacing="5"
                                ItemsSource="{Binding OutletDecisionOptions}"
                                ScrollBarVisibility="Never"
                                SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                SelectionBackground="Transparent"
                                SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="Center">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <cards:SfCardView
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            ClipToBounds="True"
                                            CornerRadius="20"
                                            HeightRequest="100">
                                            <Grid
                                                ColumnSpacing="20"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="10"
                                                VerticalOptions="FillAndExpand">
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="{Binding ImgSource}"
                                                    VerticalOptions="FillAndExpand" />
                                                <Label
                                                    Margin="20,0,20,20"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding ActiveOutletDecisionOptions}"
                                                    TextColor="{Binding TextCol}"
                                                    VerticalOptions="EndAndExpand" />
                                            </Grid>
                                        </cards:SfCardView>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>

                                <listView:SfListView.ItemsLayout>
                                    <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                </listView:SfListView.ItemsLayout>
                            </listView:SfListView>
                            <Grid
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsEnabled="{Binding IsRequestTypeEnabled}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="{Binding IsDeregReasonVisible}">


                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                                    <Border
                                        Margin="10,0,10,0"
                                        Stroke="#B1B1B1"
                                        StrokeThickness="1"
                                        Style="{StaticResource GreyBorderFrame}">

                                        <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlackMedium}"
                                                Text="{Binding ReasonTitle}" />
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    HeightRequest="15"
                                                    HorizontalOptions="Start"
                                                    Source="arrowDropdown"
                                                    VerticalOptions="Center"
                                                    WidthRequest="15" />

                                            </StackLayout>
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnVatRegistrationReasonTapped}" />
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </Border>
                                    <StackLayout Spacing="2">
                                        <inputLayout:SfTextInputLayout
                                            Margin="10,0,10,0"
                                            ContainerType="Outlined"
                                            HelperText="{Binding TextCount}"
                                            IsVisible="{Binding IsOthersEditorVisible}"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="15"
                                            Stroke="{StaticResource Primary}"
                                            TrailingViewPosition="Inside">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <Entry
                                                HeightRequest="100"
                                                MaxLength="1000"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding OtherField}"
                                                TextChanged="Others_Entry_TextChanged" />

                                        </inputLayout:SfTextInputLayout>
                                        <!--<Label Text="no of characters remaining"/>-->
                                    </StackLayout>
                                </StackLayout>


                            </Grid>

                            <StackLayout
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="{Binding IsRequestTypeEnabled}"
                                IsVisible="{Binding IsSuspReasonVisible}"
                                Orientation="Vertical">
                                <StackLayout>
                                    <StackLayout>
                                        <StackLayout>

                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                                            <Border
                                                Margin="10,0,10,0"
                                                Stroke="#B1B1B1"
                                                StrokeThickness="1"
                                                Style="{StaticResource GreyBorderFrame}">

                                                <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                                    <Label
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                                        Text="{Binding ReasonTitle}" />
                                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Margin="5,0"
                                                            HeightRequest="15"
                                                            HorizontalOptions="Start"
                                                            Source="arrowDropdown"
                                                            VerticalOptions="Center"
                                                            WidthRequest="15" />

                                                    </StackLayout>
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding OnVatRegistrationReasonTapped}" />
                                                    </StackLayout.GestureRecognizers>
                                                </StackLayout>
                                            </Border>
                                            <StackLayout Spacing="2">
                                                <inputLayout:SfTextInputLayout
                                                    x:Name="OthersTxt"
                                                    Margin="10,0,10,0"
                                                    ContainerType="Outlined"
                                                    HelperText="{Binding TextCount}"
                                                    IsVisible="{Binding IsOthersEditorVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="15"
                                                    Stroke="{StaticResource Primary}"
                                                    TrailingViewPosition="Inside">
                                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <Entry
                                                        HeightRequest="100"
                                                        MaxLength="1000"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding OtherField}"
                                                        TextChanged="Others_Entry_TextChanged" />

                                                </inputLayout:SfTextInputLayout>
                                                <!--<Label Text="no of characters remaining"/>-->
                                            </StackLayout>
                                        </StackLayout>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedStartDate}" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedEndDate}" />
                                        </Grid>
                                        <Border
                                            Margin="10,0,10,0"
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">
                                                <StackLayout HorizontalOptions="Start" Orientation="Horizontal">
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                                        Text="{Binding FromDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                        <Image Margin="5,0" HorizontalOptions="Center">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.GreaterThan}"
                                                                    Size="20"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                            </Image.Source>
                                                        </Image>

                                                    </StackLayout>
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer x:Name="StartDate" Tapped="VATDeregStartDateClicked" />
                                                    </StackLayout.GestureRecognizers>

                                                </StackLayout>

                                                <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                                        Text="{Binding ToDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                    <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                                        <Image Margin="5,0">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                    Size="20"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                            </Image.Source>
                                                        </Image>

                                                    </StackLayout>

                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer x:Name="EndDate" Tapped="VATDeregEndDateClicked" />
                                                    </StackLayout.GestureRecognizers>

                                                </StackLayout>
                                            </StackLayout>
                                        </Border>
                                    </StackLayout>
                                    <StackLayout Orientation="Vertical">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedFilingPeriod}" />
                                        <Border
                                            Margin="10,0,10,0"
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Center"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding SuspendedStartDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.GreaterThan}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding SuspendedEndDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>

                                            </StackLayout>
                                        </Border>
                                    </StackLayout>
                                    <StackLayout Orientation="Vertical">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregNextFilingPeriod}" />
                                        <Border
                                            Margin="10,0,10,0"
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding NextFilingStartDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0" HorizontalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.GreaterThan}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding NextFilingEndDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                        </Border>
                                    </StackLayout>
                                    <StackLayout Orientation="Vertical">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregNextFilingDueDate}" />
                                        <Border
                                            Margin="10,0,10,0"
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding NextFilingDueDate, StringFormat='{0:yyyy/MM/dd}'}" />

                                            </StackLayout>
                                        </Border>
                                    </StackLayout>
                                </StackLayout>

                            </StackLayout>

                            <buttons:SfButton
                                x:Name="btnReasonContinue"
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,60,0,60"
                                Command="{Binding ReasonContinueBtnTapped}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                VerticalOptions="End" />
                        </Grid>


                        <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsAttachmentsViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}" />

                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregDocumentselectionTitle}" />

                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                <listView:SfListView
                                    x:Name="outletDocumentOptionsListView"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding AttachmentTypes}"
                                    ScrollBarVisibility="Never"
                                    SelectedItem="{Binding SelectedDocumentOption, Mode=TwoWay}"
                                    SelectionBackground="Transparent"
                                    SelectionChanged="outletDocumentOptionsListView_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <cards:SfCardView
                                                BackgroundColor="Transparent"
                                                CornerRadius="20"
                                                HeightRequest="100">
                                                <Grid
                                                    ColumnSpacing="20"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowSpacing="10"
                                                    VerticalOptions="FillAndExpand">
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="{Binding ImgSource}"
                                                        VerticalOptions="FillAndExpand" />
                                                    <Label
                                                        Margin="20,0,20,20"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding Txt50}"
                                                        TextColor="{Binding TextCol}"
                                                        VerticalOptions="EndAndExpand" />
                                                </Grid>
                                            </cards:SfCardView>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>

                                    <listView:SfListView.ItemsLayout>
                                        <listView:GridLayout x:Name="GridLayout1" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                    </listView:SfListView.ItemsLayout>
                                </listView:SfListView>
                            </Grid>

                            <StackLayout
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Spacing="2">
                                <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentInputTitle2}" />
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmAttachmentOptional"
                                    Margin="10,-6,0,-6"
                                    ContainerType="Outlined"
                                    HasError="False"
                                    HorizontalOptions="FillAndExpand"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Stroke="{StaticResource Primary}">
                                    <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                        <inputLayout:LabelStyle TextColor="#B00020" />
                                    </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <!--  Attachments  -->
                                    <Entry
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="False"
                                        Placeholder="{x:Static ResourceManager:AppResources.VatDeregAttachmentInputPlaceholder}"
                                        Style="{StaticResource DefaultEntry}"
                                        VerticalOptions="Center" />

                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image
                                            HorizontalOptions="CenterAndExpand"
                                            Source="ic_attachment.png"
                                            VerticalOptions="CenterAndExpand">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                BindableLayout.ItemsSource="{Binding FilterVatAttachmentsList}"
                                HorizontalOptions="Center">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="10,0,0,10"
                                            Padding="10"
                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="5,0"
                                                    HeightRequest="25"
                                                    HorizontalOptions="Start"
                                                    Source="Generic_attachment_icon.png"
                                                    VerticalOptions="Center"
                                                    WidthRequest="25" />
                                                <custom:CustomLabel
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    LineSpacing="1"
                                                    Text="{Binding Filename}"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>

                            <buttons:SfButton
                                x:Name="btnAttachmentsContinue"
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="10,10,0,36"
                                Command="{Binding AttachmentsContinueBtnTapped}"
                                HeightRequest="48"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />


                        </Grid>
                        <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsDeclarationViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                            </Grid>
                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <StackLayout>
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">

                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregIDType}" />
                                        <Border
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding IDType}" />
                                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                    <Image
                                                        Margin="10,0,10,0"
                                                        HeightRequest="15"
                                                        HorizontalOptions="Start"
                                                        Source="arrowDropdown"
                                                        VerticalOptions="Center"
                                                        WidthRequest="15" />
                                                </StackLayout>

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="VatDeregIdClicked" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </Border>

                                    </StackLayout>
                                    <StackLayout
                                        x:Name="IDNumberField"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalOptions="StartAndExpand"
                                        Orientation="Vertical">
                                        <StackLayout>
                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                            <inputLayout:SfTextInputLayout
                                                x:Name="FrmIDNumber"
                                                Margin="0,0,0,0"
                                                ContainerType="Outlined"
                                                OutlineCornerRadius="13"
                                                Stroke="{StaticResource Primary}">
                                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                    <inputLayout:LabelStyle TextColor="#B00020" />
                                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <Entry
                                                    x:Name="EntryIDNumber"
                                                    FontSize="Micro"
                                                    HorizontalOptions="FillAndExpand"
                                                    Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding TxtIDNumber}"
                                                    TextChanged="IDNumberEntry_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="EntryIDNo_Unfocused">
                                                    <Entry.Behaviors>
                                                        <behaviors:OnlyNumericValuesBehaviour />
                                                    </Entry.Behaviors>
                                                </Entry>
                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>
                                        <StackLayout
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsDOBEditorVisible}">
                                            <custom:CustomLabel
                                                Margin="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                            <Border
                                                Grid.ColumnSpan="2"
                                                Margin="0,0,0,0"
                                                Stroke="#B1B1B1"
                                                StrokeThickness="1"
                                                Style="{StaticResource GreyBorderFrame}">

                                                <StackLayout
                                                    Grid.ColumnSpan="2"
                                                    Padding="5,15,5,15"
                                                    Orientation="Horizontal">

                                                    <Label
                                                        x:Name="DpDbo"
                                                        FontSize="Micro"
                                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                                        Text="{Binding DOB}" />
                                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                        <Image Margin="5,0">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                    Size="20"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </StackLayout>

                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="VATDeregDOBClicked" />
                                                    </StackLayout.GestureRecognizers>

                                                </StackLayout>
                                            </Border>
                                        </StackLayout>
                                    </StackLayout>
                                    <StackLayout>
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            IsEnabled="{Binding IsContactPersonEnabled}"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregContactPerson}" />
                                        <inputLayout:SfTextInputLayout
                                            Margin="0,-6,0,-6"
                                            ContainerType="Outlined"
                                            HasError="False"
                                            HorizontalOptions="StartAndExpand"
                                            OutlineCornerRadius="13"
                                            Stroke="{StaticResource Primary}">
                                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                                <inputLayout:LabelStyle TextColor="#B00020" />
                                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                            <custom:GAZTBorderlessEntry
                                                x:Name="ContactName"
                                                FontSize="Micro"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Placeholder="{x:Static ResourceManager:AppResources.VatDeregContactPerson}"
                                                Text="{Binding ContactPersonName}"
                                                TextColor="#bbbbbb"
                                                VerticalTextAlignment="Start">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <behaviors:AlphabetandArabicCharacters />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <CheckBox
                                            x:Name="chkDeclaration"
                                            IsChecked="{Binding IsDeclarationChecked}"
                                            VerticalOptions="CenterAndExpand">
                                            <CheckBox.Triggers>
                                                <DataTrigger TargetType="CheckBox" Value="false">
                                                    <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                                </DataTrigger>
                                            </CheckBox.Triggers>
                                        </CheckBox>
                                        <custom:CustomLabel Margin="5,10,0,15" Style="{StaticResource GAZTMicroMediumGrayLabel}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.VATDeregistrationDeclarationCheckBoxText}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                    <Border
                                        Margin="0,20,0,10"
                                        Stroke="#B1B1B1"
                                        StrokeThickness="1"
                                        Style="{StaticResource GreyBorderFrame}">
                                        <StackLayout Margin="8">
                                            <StackLayout Orientation="Horizontal" Spacing="0">
                                                <Image
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="ic_vat_info.png"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />
                                                <custom:CustomLabel
                                                    Margin="10,0,10,5"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.Information}" />
                                            </StackLayout>
                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationDeclarationAgreement}" />

                                        </StackLayout>
                                    </Border>

                                    <buttons:SfButton
                                        x:Name="btnDeclarationContinue"
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,36"
                                        BackgroundColor="{Binding DeclarationContinueButtonnBackroundColor}"
                                        Command="{Binding DeclarationContinueBtnTapped}"
                                        IsEnabled="{Binding IsDeclarationContinueButtonEnabled}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />
                                </StackLayout>
                            </Grid>
                        </Grid>
                        <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsSummaryViewEnabled}"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <Border
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                <Image
                                                    HorizontalOptions="Start"
                                                    Source="details"
                                                    VerticalOptions="Center" />

                                                <Label
                                                    Padding="8,0"
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                BackgroundColor="Transparent"
                                                Clicked="Button_Clicked_1"
                                                FontFamily="SSTBold"
                                                HorizontalOptions="End"
                                                IsVisible="False"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                        <Grid Padding="0" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-5">
                                                <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregRequestType}" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Spacing="-5">
                                                <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding DeregRequestType}" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Spacing="-5">
                                                <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregReasonTitle}" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Spacing="-5">
                                                <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding DeregReason}" />
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </Border>
                                <Border
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="ic_attachment"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                BackgroundColor="Transparent"
                                                Clicked="Button_Clicked_2"
                                                FontFamily="SSTBold"
                                                HorizontalOptions="End"
                                                IsVisible="False"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="Center" />

                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                        <listView:SfListView
                                            x:Name="summaryAttachmentsListView"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding AttachmentsListViewData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="SingleDeselect"
                                            VerticalOptions="Center">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Padding="0"
                                                        ColumnSpacing="0"
                                                        RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                                            <Label
                                                                FontSize="Small"
                                                                HorizontalOptions="StartAndExpand"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource BodyLabelGrey}"
                                                                Text="{Binding FieldTitle}" />
                                                        </StackLayout>
                                                        <StackLayout
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="0">
                                                            <Image
                                                                Margin="5,0,5,0"
                                                                HorizontalOptions="Center"
                                                                IsVisible="{Binding IsAttachmentAttached, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                                                Source="Generic_attachment_icon.png"
                                                                VerticalOptions="Center" />
                                                            <custom:CustomLabel
                                                                FontSize="Small"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding AttachmentName}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </StackLayout>
                                </Border>
                                <Border
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="declaration"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                BackgroundColor="Transparent"
                                                Clicked="Button_Clicked_3"
                                                FontFamily="SSTBold"
                                                HorizontalOptions="End"
                                                IsVisible="False"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="Center" />

                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                        <listView:SfListView
                                            x:Name="summaryDeclarationListView"
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="SingleDeselect"
                                            VerticalOptions="Center">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0" RowSpacing="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                                            <Label
                                                                FontSize="Small"
                                                                Style="{StaticResource BodyLabelGrey}"
                                                                Text="{Binding SummaryTitle}" />
                                                        </StackLayout>
                                                        <StackLayout Grid.Row="0" Grid.Column="1">
                                                            <Label
                                                                FontSize="Small"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding SummaryData}" />
                                                        </StackLayout>
                                                    </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </StackLayout>
                                </Border>
                            </Grid>
                            <buttons:SfButton
                                x:Name="btnContinueSummary"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="8,10,0,36"
                                Command="{Binding SummaryContinueBtnTapped}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.Confirm}" />
                        </Grid>

                    </Grid>

                </ScrollView>


            </Grid>

            <Grid
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            SizeFactor="0.7"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                    </StackLayout>
                </StackLayout>
            </Grid>

        </Grid>

    </ContentPage.Content>
</ContentPage>
