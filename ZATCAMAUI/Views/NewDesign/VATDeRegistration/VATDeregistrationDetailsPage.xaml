<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.VATDeRegistration.VATDeregistrationDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    x:Name="page"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

      <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,3*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}"
                    VerticalOptions="Center" />

            </Grid>

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid>

                    <ScrollView HorizontalOptions="FillAndExpand"
                                VerticalScrollBarVisibility="Never"
                                VerticalOptions="FillAndExpand">
                        <Grid>

                            <Grid
                                BackgroundColor="Transparent"
                                ColumnDefinitions="50*,50*"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding IsReasonViewEnabled}"
                                RowDefinitions="auto,auto,auto,auto,auto,auto"
                                VerticalOptions="FillAndExpand">

                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    RowDefinitions="auto,auto,1">

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationSubtitle}" />

                                    <BoxView
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                </Grid>

                                <Label
                                    Grid.Row="1"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregRequestType}" />

                                <listView:SfListView
                                x:Name="outletDecisionOptionsListView"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                AutoFitMode="Height"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding IsRequestTypeEnabled}"
                                IsScrollingEnabled="False"
                                ItemSpacing="5"
                                ItemsSource="{Binding OutletDecisionOptions}"
                                ScrollBarVisibility="Never"
                                SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                SelectionBackground="Transparent"
                                SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                                SelectionMode="Single"
                                VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <cards:SfCardView
                                                FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                ClipToBounds="True"
                                                CornerRadius="20"
                                                HeightRequest="100">

                                                <Grid
                                                    ColumnSpacing="20"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowSpacing="10"
                                                    VerticalOptions="FillAndExpand">

                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="{Binding ImgSource}"
                                                        VerticalOptions="FillAndExpand" />

                                                    <Label
                                                        Margin="20,0,20,20"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding ActiveOutletDecisionOptions}"
                                                        TextColor="{Binding TextCol}"
                                                        VerticalOptions="EndAndExpand" />

                                                </Grid>
                                            </cards:SfCardView>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>

                                    <listView:SfListView.ItemsLayout>
                                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                    </listView:SfListView.ItemsLayout>

                                </listView:SfListView>

                                <Grid
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                IsEnabled="{Binding IsRequestTypeEnabled}"
                                RowDefinitions="auto,auto,1">
                                    <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="{Binding IsDeregReasonVisible}">


                                        <Label
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />

                                        <StackLayout>
                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                        Placeholder="{x:Static ResourceManager:AppResources.TinDeregistrationReason}"
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Text="{Binding ReasonTitle}"
                                                        TextColor="{StaticResource NeutralBlack}"
                                                        Style="{StaticResource DefaultEntry}"/>
                                                </custom:CustomSfTextInputView.TextInputView>

                                                <custom:CustomSfTextInputView.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnVatRegistrationReasonTapped}" />
                                                </custom:CustomSfTextInputView.GestureRecognizers>

                                                <custom:CustomSfTextInputView.TrailingView>
                                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                                </custom:CustomSfTextInputView.TrailingView>

                                            </custom:CustomSfTextInputView>

                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnVatRegistrationReasonTapped}" />
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>

                                        <StackLayout Spacing="2" Margin="10" IsVisible="{Binding IsOthersEditorVisible}">

                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                    HeightRequest="100"
                                                    MaxLength="1000"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding OtherField}"
                                                    TextChanged="Others_Entry_TextChanged" />

                                                </custom:CustomSfTextInputView.TextInputView>

                                            </custom:CustomSfTextInputView>

                                            <Label
                                            Margin="0,10,0,10"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{Binding TextCount}" />

                                        </StackLayout>
                                    </StackLayout>


                                </Grid>

                                <StackLayout
                                Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="{Binding IsRequestTypeEnabled}"
                                IsVisible="{Binding IsSuspReasonVisible}">
                                    <StackLayout>

                                        <StackLayout>

                                            <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />

                                            <StackLayout>
                                                <custom:CustomSfTextInputView ContainerBackground="White"
                                                    Stroke="{StaticResource Primary}">
                                                    <custom:CustomSfTextInputView.TextInputView>
                                                        <custom:GAZTBorderlessEntry
                                                        Placeholder="{x:Static ResourceManager:AppResources.TinDeregistrationReason}"
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Text="{Binding ReasonTitle}"
                                                        TextColor="{StaticResource NeutralBlack}"
                                                        Style="{StaticResource DefaultEntry}"/>

                                                    </custom:CustomSfTextInputView.TextInputView>

                                                    <custom:CustomSfTextInputView.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding OnVatRegistrationReasonTapped}" />
                                                    </custom:CustomSfTextInputView.GestureRecognizers>

                                                    <custom:CustomSfTextInputView.TrailingView>
                                                        <Image Aspect="AspectFit" Source="greyDropDown" />
                                                    </custom:CustomSfTextInputView.TrailingView>

                                                </custom:CustomSfTextInputView>

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnVatRegistrationReasonTapped}" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>

                                            <StackLayout Spacing="2">
                                                <custom:CustomSfTextInputView x:Name="OthersTxt" IsVisible="{Binding IsOthersEditorVisible}">
                                                    <custom:CustomSfTextInputView.TextInputView>
                                                        <custom:GAZTBorderlessEntry
                                                            HeightRequest="100"
                                                            MaxLength="1000"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding OtherField}"
                                                            TextChanged="Others_Entry_TextChanged" />
                                                    </custom:CustomSfTextInputView.TextInputView>
                                                </custom:CustomSfTextInputView>

                                                <Label
                                                    Margin="0,10,0,10"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{Binding TextCount}" />
                                            </StackLayout>
                                        </StackLayout>

                                        <Grid ColumnDefinitions="*,*">

                                            <Label
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedStartDate}" />

                                            <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedEndDate}" />

                                        </Grid>

                                        <Border
                                                Margin="10,0,10,0"
                                                Stroke="#B1B1B1"
                                                StrokeThickness="1"
                                                Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">
                                                <StackLayout HorizontalOptions="Start" Orientation="Horizontal">
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                                        Text="{Binding FromDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                        <Image Margin="5,0" HorizontalOptions="Center">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.GreaterThan}"
                                                                    Size="20"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                            </Image.Source>
                                                        </Image>

                                                    </StackLayout>
                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer x:Name="StartDate" Tapped="VATDeregStartDateClicked" />
                                                    </StackLayout.GestureRecognizers>

                                                </StackLayout>

                                                <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                                    <Label
                                                        HorizontalOptions="Start"
                                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                                        Text="{Binding ToDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                    <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                                        <Image Margin="5,0">
                                                            <Image.Source>
                                                                <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                    Size="20"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </StackLayout>

                                                    <StackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer x:Name="EndDate" Tapped="VATDeregEndDateClicked" />
                                                    </StackLayout.GestureRecognizers>

                                                </StackLayout>
                                            </StackLayout>
                                        </Border>

                                    </StackLayout>

                                    <StackLayout>
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedFilingPeriod}" />
                                        <Border
                                            Margin="10,0,10,0"
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Center"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding SuspendedStartDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.GreaterThan}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding SuspendedEndDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>

                                            </StackLayout>
                                        </Border>
                                    </StackLayout>

                                    <StackLayout>
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregNextFilingPeriod}" />
                                        <Border
                                            Margin="10,0,10,0"
                                            Stroke="#B1B1B1"
                                            StrokeThickness="1"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <StackLayout Padding="5,15,5,15" Orientation="Horizontal">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding NextFilingStartDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0" HorizontalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.GreaterThan}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                                <Label
                                                    HorizontalOptions="End"
                                                    Style="{StaticResource GAZTSmallBlackLabel}"
                                                    Text="{Binding NextFilingEndDate, StringFormat='{0:yyyy/MM/dd}'}" />
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                            Size="20"
                                                            Color="{StaticResource SecondaryNew}" />
                                                    </Image.Source>
                                                </Image>
                                            </StackLayout>
                                        </Border>
                                    </StackLayout>

                                    <StackLayout>
                                        <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregNextFilingDueDate}" />

                                        <custom:CustomSfTextInputView
                                                Margin="10,0,10,0">
                                            <custom:CustomSfTextInputView.TextInputView>
                                                <custom:GAZTBorderlessEntry
                                                        Text="{Binding NextFilingDueDate, StringFormat='{0:yyyy/MM/dd}'}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Placeholder="{x:Static ResourceManager:AppResources.VatDeregNextFilingDueDate}"
                                                        />
                                            </custom:CustomSfTextInputView.TextInputView>
                                        </custom:CustomSfTextInputView>
                                    </StackLayout>

                                </StackLayout>

                                <buttons:SfButton
                                x:Name="btnReasonContinue"
                                Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,60,0,60"
                                Command="{Binding ReasonContinueBtnTapped}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                VerticalOptions="End" />

                            </Grid>

                            <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            RowDefinitions="auto,auto,auto,auto"
                            ColumnDefinitions="50*,50*"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsAttachmentsViewEnabled}"
                            VerticalOptions="FillAndExpand">
                                <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                 RowDefinitions="auto,auto,auto,*"
                                Grid.ColumnSpan="2">
                                    <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}" />

                                    <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregDocumentselectionTitle}" />

                                    <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <listView:SfListView
                                    x:Name="outletDocumentOptionsListView"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding AttachmentTypes}"
                                    ScrollBarVisibility="Never"
                                    SelectedItem="{Binding SelectedDocumentOption, Mode=TwoWay}"
                                    SelectionBackground="Transparent"
                                    SelectionChanged="outletDocumentOptionsListView_SelectionChanged"
                                    SelectionMode="Single"
                                    VerticalOptions="Center">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <cards:SfCardView
                                                     FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                                BackgroundColor="Transparent"
                                                CornerRadius="20"
                                                HeightRequest="100">
                                                    <Grid
                                                    ColumnSpacing="20"
                                                    HorizontalOptions="FillAndExpand"
                                                    RowSpacing="10"
                                                    VerticalOptions="FillAndExpand">
                                                        <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="{Binding ImgSource}"
                                                        VerticalOptions="FillAndExpand" />
                                                        <Label
                                                        Margin="20,0,20,20"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding Txt50}"
                                                        TextColor="{Binding TextCol}"
                                                        VerticalOptions="EndAndExpand" />
                                                    </Grid>
                                                </cards:SfCardView>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>

                                        <listView:SfListView.ItemsLayout>
                                            <listView:GridLayout x:Name="GridLayout1" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                        </listView:SfListView.ItemsLayout>
                                    </listView:SfListView>
                                </Grid>

                                <StackLayout
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Spacing="2">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentInputTitle2}" />
                                    <custom:CustomSfTextInputView x:Name="FrmAttachmentOptional">
                                        <custom:CustomSfTextInputView.TextInputView>

                                            <!--  Attachments  -->
                                            <custom:GAZTBorderlessEntry
                                                HorizontalTextAlignment="Start"
                                                InputTransparent="True"
                                                IsReadOnly="True"
                                                Placeholder="{x:Static ResourceManager:AppResources.VatDeregAttachmentInputPlaceholder}"
                                                Style="{StaticResource DefaultEntry}"
                                                VerticalOptions="Center" />
                                        </custom:CustomSfTextInputView.TextInputView>

                                        <custom:CustomSfTextInputView.TrailingView>
                                            <Image
                                            HorizontalOptions="CenterAndExpand"
                                            Source="ic_attachment.png"
                                            VerticalOptions="CenterAndExpand">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </custom:CustomSfTextInputView.TrailingView>

                                        <custom:CustomSfTextInputView.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                        </custom:CustomSfTextInputView.GestureRecognizers>

                                    </custom:CustomSfTextInputView>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                                <StackLayout
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                BindableLayout.ItemsSource="{Binding FilterVatAttachmentsList}"
                                HorizontalOptions="FillAndExpand">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                            Margin="10,0,0,10"
                                            Padding="10"
                                            Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid RowDefinitions="auto,auto"
                                                      ColumnDefinitions="auto,*">
                                                    <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="5,0"
                                                    HeightRequest="25"
                                                    HorizontalOptions="Start"
                                                    Source="Generic_attachment_icon.png"
                                                    VerticalOptions="Center"
                                                    WidthRequest="25" />
                                                    <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    LineHeight="1"
                                                    Text="{Binding Filename}"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>

                                <buttons:SfButton
                                x:Name="btnAttachmentsContinue"
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="10,10,0,36"
                                Command="{Binding AttachmentsContinueBtnTapped}"
                                HeightRequest="48"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />


                            </Grid>

                            <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                             RowDefinitions="auto,auto,auto,auto,auto,*"
                             ColumnDefinitions="50*,50*"
                            IsVisible="{Binding IsDeclarationViewEnabled}"
                            VerticalOptions="FillAndExpand">
                                <Grid
                                    RowDefinitions="auto,auto,1"
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                    <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}" />
                                    <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                                    <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                </Grid>
                                <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                RowDefinitions="auto,auto,1"
                                Grid.ColumnSpan="2">
                                    <StackLayout>
                                        <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2">

                                            <Label
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregIDType}" />

                                            <StackLayout>
                                                <custom:CustomSfTextInputView>
                                                    <custom:CustomSfTextInputView.TextInputView>
                                                        <custom:GAZTBorderlessEntry
                                                        Placeholder="{x:Static ResourceManager:AppResources.VatDeregIDType}"
                                                        IsReadOnly="True"
                                                        InputTransparent="True"
                                                        Text="{Binding IDType}"
                                                        TextColor="{StaticResource NeutralBlack}"
                                                        Style="{StaticResource DefaultEntry}"/>

                                                    </custom:CustomSfTextInputView.TextInputView>

                                                    <custom:CustomSfTextInputView.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="VatDeregIdClicked" />
                                                    </custom:CustomSfTextInputView.GestureRecognizers>

                                                    <custom:CustomSfTextInputView.TrailingView>
                                                        <Image Aspect="AspectFit" Source="greyDropDown" />
                                                    </custom:CustomSfTextInputView.TrailingView>

                                                </custom:CustomSfTextInputView>

                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="VatDeregIdClicked" />
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>

                                        </StackLayout>
                                        <StackLayout
                                        x:Name="IDNumberField"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalOptions="StartAndExpand">
                                            <StackLayout>
                                                <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.IDNumber}" />
                                                <custom:CustomSfTextInputView
                                                x:Name="FrmIDNumber">
                                                    <custom:CustomSfTextInputView.TextInputView>
                                                        <custom:GAZTBorderlessEntry
                                                        x:Name="EntryIDNumber"
                                                        FontSize="Micro"
                                                        HorizontalOptions="FillAndExpand"
                                                        Placeholder="{x:Static ResourceManager:AppResources.IDNumber}"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{Binding TxtIDNumber}"
                                                        TextChanged="IDNumberEntry_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        Unfocused="EntryIDNo_Unfocused">
                                                            <custom:GAZTBorderlessEntry.Behaviors>
                                                                <behaviors:OnlyNumericValuesBehaviour />
                                                            </custom:GAZTBorderlessEntry.Behaviors>
                                                        </custom:GAZTBorderlessEntry>

                                                    </custom:CustomSfTextInputView.TextInputView>

                                                </custom:CustomSfTextInputView>
                                            </StackLayout>
                                            <StackLayout
                                            Grid.ColumnSpan="2"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsDOBEditorVisible}">
                                                <Label
                                                Margin="0,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                <Border
                                                Grid.ColumnSpan="2"
                                                Margin="0,0,0,0"
                                                Stroke="#B1B1B1"
                                                StrokeThickness="1"
                                                Style="{StaticResource GreyBorderFrame}">

                                                    <StackLayout
                                                    Grid.ColumnSpan="2"
                                                    Padding="5,15,5,15"
                                                    Orientation="Horizontal">

                                                        <Label
                                                        x:Name="DpDbo"
                                                        FontSize="Micro"
                                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                                        Text="{Binding DOB}" />
                                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                            <Image Margin="5,0">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                    FontFamily="UserIconFont"
                                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                                    Size="20"
                                                                    Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                            </Image>
                                                        </StackLayout>

                                                        <StackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="VATDeregDOBClicked" />
                                                        </StackLayout.GestureRecognizers>

                                                    </StackLayout>
                                                </Border>
                                            </StackLayout>
                                        </StackLayout>
                                        <StackLayout>
                                            <Label
                                            HorizontalOptions="StartAndExpand"
                                            IsEnabled="{Binding IsContactPersonEnabled}"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregContactPerson}" />
                                            <custom:CustomSfTextInputView>
                                                <custom:CustomSfTextInputView.TextInputView>
                                                    <custom:GAZTBorderlessEntry
                                                x:Name="ContactName"
                                                FontSize="Micro"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Placeholder="{x:Static ResourceManager:AppResources.VatDeregContactPerson}"
                                                Text="{Binding ContactPersonName}"
                                                IsEnabled="{Binding ContactNameIsEnabled}"
                                                TextColor="#bbbbbb"
                                                VerticalTextAlignment="Start">
                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <behaviors:AlphabetandArabicCharacters />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>
                                                </custom:CustomSfTextInputView.TextInputView>
                                            </custom:CustomSfTextInputView>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <CheckBox
                                            x:Name="chkDeclaration"
                                            IsChecked="{Binding IsDeclarationChecked}"
                                            VerticalOptions="CenterAndExpand">
                                                <CheckBox.Triggers>
                                                    <DataTrigger TargetType="CheckBox" Value="false">
                                                        <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                                    </DataTrigger>
                                                </CheckBox.Triggers>
                                            </CheckBox>
                                            <Label
                                            Margin="5,10,0,15"
                                            Style="{StaticResource GAZTMicroMediumGrayLabel}"
                                            Text="{x:Static ResourceManager:AppResources.VATDeregistrationDeclarationCheckBoxText}" LineBreakMode="WordWrap" />
                                        </StackLayout>
                                        <Border
                                        Margin="0,20,0,10"
                                        Stroke="#B1B1B1"
                                        StrokeThickness="1"
                                        Style="{StaticResource GreyBorderFrame}">
                                            <StackLayout Margin="8">
                                                <StackLayout Orientation="Horizontal" Spacing="0">
                                                    <Image
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="ic_vat_info.png"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />
                                                    <Label
                                                    Margin="10,0,10,5"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{x:Static ResourceManager:AppResources.Information}" />
                                                </StackLayout>
                                                <Label
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationDeclarationAgreement}" />

                                            </StackLayout>
                                        </Border>

                                        <buttons:SfButton
                                        x:Name="btnDeclarationContinue"
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,36"
                                        BackgroundColor="{Binding DeclarationContinueButtonnBackroundColor}"
                                        Command="{Binding DeclarationContinueBtnTapped}"
                                        IsEnabled="{Binding IsDeclarationContinueButtonEnabled}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />
                                    </StackLayout>
                                </Grid>
                            </Grid>

                            <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            ColumnDefinitions="50*,50*"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsDeclarationViewEnabledNew}"
                            RowDefinitions="auto,auto,auto,auto,auto,*"
                            VerticalOptions="FillAndExpand">

                                <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                RowDefinitions="auto,auto,1">

                                    <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}" />

                                    <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />

                                    <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                </Grid>
                                <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                RowDefinitions="auto,auto,1">
                                    <StackLayout Grid.Row="0">

                                        <StackLayout Orientation="Horizontal">

                                            <custom:CheckboxCustom
                                            IsChecked="{Binding IsDeclarationChecked}"
                                            MinimumHeightRequest="32"
                                            MinimumWidthRequest="32"
                                            VerticalOptions="Start" />

                                            <Label
                                            HeightRequest="350"
                                            HorizontalOptions="FillAndExpand"
                                            HorizontalTextAlignment="{Binding TermsAlignment}"
                                            Style="{StaticResource CheckboxUnselectedFontStyle}"
                                            Text="{Binding Zterms}"
                                            TextType="Html"
                                            VerticalOptions="FillAndExpand" />

                                        </StackLayout>


                                        <buttons:SfButton
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,36"
                                        BackgroundColor="{Binding DeclarationContinueButtonnBackroundColor}"
                                        Command="{Binding DeclarationContinueBtnTapped}"
                                        IsEnabled="{Binding IsDeclarationContinueButtonEnabled}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" />

                                    </StackLayout>

                                </Grid>
                            </Grid>

                            <Grid
                            Margin="20,10,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsSummaryViewEnabled}"
                            VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" />
                                    <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                                    <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Border
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0">
                                            <Grid
                                            Padding="15"
                                            ColumnDefinitions="auto,auto"
                                            RowDefinitions="auto,auto"
                                            RowSpacing="0">

                                                <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                    <Image
                                                    HorizontalOptions="Start"
                                                    Source="details"
                                                    VerticalOptions="Center" />

                                                    <Label
                                                    Padding="8,0"
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <buttons:SfButton
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Background="Transparent"
                                                Clicked="Button_Clicked_1"
                                                FontFamily="SSTBold"
                                                HorizontalOptions="End"
                                                IsVisible="False"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="Center" />
                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                            <Grid
                                            Padding="0"
                                            ColumnDefinitions="*,*"
                                            RowDefinitions="auto,auto"
                                            RowSpacing="0">
                                                <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="-5">
                                                    <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregRequestType}" />
                                                </StackLayout>
                                                <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Spacing="-5">
                                                    <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding DeregRequestType}" />
                                                </StackLayout>
                                                <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Spacing="-5">
                                                    <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregReasonTitle}" />
                                                </StackLayout>
                                                <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Spacing="-5">
                                                    <Label
                                                    FontSize="Small"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding DeregReason}" />
                                                </StackLayout>
                                            </Grid>
                                        </StackLayout>
                                    </Border>
                                    <Border
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0">
                                            <Grid
                                            Padding="15"
                                            ColumnDefinitions="auto,auto"
                                            RowDefinitions="auto,auto"
                                            RowSpacing="0">

                                                <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                    <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="ic_attachment"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                    <Label
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <buttons:SfButton
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Background="Transparent"
                                                Clicked="Button_Clicked_2"
                                                FontFamily="SSTBold"
                                                HorizontalOptions="End"
                                                IsVisible="False"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="Center" />

                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                            <listView:SfListView
                                            x:Name="summaryAttachmentsListView"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding AttachmentsListViewData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="SingleDeselect"
                                            VerticalOptions="Center">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                        Padding="0"
                                                        FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                                        ColumnDefinitions="*,*"
                                                        ColumnSpacing="0"
                                                        RowDefinitions="auto,auto"
                                                        RowSpacing="0">

                                                            <StackLayout Grid.Row="0" Grid.Column="0">
                                                                <Label
                                                                FontSize="Small"
                                                                HorizontalOptions="StartAndExpand"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource BodyLabelGrey}"
                                                                Text="{Binding FieldTitle}" />
                                                            </StackLayout>
                                                            <StackLayout
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="0">
                                                                <Image
                                                                Margin="5,0,5,0"
                                                                HorizontalOptions="Center"
                                                                IsVisible="{Binding IsAttachmentAttached, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                                                Source="Generic_attachment_icon.png"
                                                                VerticalOptions="Center" />
                                                                <Label
                                                                FontSize="Small"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding AttachmentName}" />
                                                            </StackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>
                                        </StackLayout>
                                    </Border>
                                    <Border
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    IsVisible="{Binding IsDeclarationViewEnabled}"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0">
                                            <Grid
                                            Padding="15"
                                            ColumnDefinitions="auto,auto"
                                            RowDefinitions="auto,auto"
                                            RowSpacing="0">

                                                <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                Orientation="Horizontal">
                                                    <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="declaration"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                    <Label
                                                    Padding="8,0"
                                                    FontSize="Medium"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}"
                                                    VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <buttons:SfButton
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Background="Transparent"
                                                Clicked="Button_Clicked_3"
                                                FontFamily="SSTBold"
                                                HorizontalOptions="End"
                                                IsVisible="False"
                                                Text="{x:Static ResourceManager:AppResources.VATDeregistrationEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="Center" />

                                            </Grid>

                                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                            <listView:SfListView
                                            x:Name="summaryDeclarationListView"
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="SingleDeselect"
                                            VerticalOptions="Center">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}"
                                                        Padding="0"
                                                        ColumnDefinitions="*,*"
                                                        RowDefinitions="auto,auto"
                                                        RowSpacing="0">

                                                            <StackLayout Grid.Row="0" Grid.Column="0">
                                                                <Label
                                                                FontSize="Small"
                                                                Style="{StaticResource BodyLabelGrey}"
                                                                Text="{Binding SummaryTitle}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="0" Grid.Column="1">
                                                                <Label
                                                                FontSize="Small"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding SummaryData}" />
                                                            </StackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>
                                        </StackLayout>
                                    </Border>
                                </Grid>
                                <buttons:SfButton
                                x:Name="btnContinueSummary"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="8,10,0,36"
                                Command="{Binding SummaryContinueBtnTapped}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.Confirm}" />
                            </Grid>

                        </Grid>

                    </ScrollView>

                </Grid>

            </Border>

            <custom:Loader Grid.Row="1" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>
