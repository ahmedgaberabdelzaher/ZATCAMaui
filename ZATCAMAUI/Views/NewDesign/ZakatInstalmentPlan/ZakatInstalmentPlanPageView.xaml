<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatInstalmentPlan.ZakatInstalmentPlanPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">



    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>



        </ResourceDictionary>



    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="Large"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="CenterAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>



    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                    <!--  Display Instalments  -->


                    <!--  Data Entry/calculations screen  -->

                    <Grid
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding InstalmentPlanAgreementsVisible}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0"
                            Grid.ColumnSpan="3"
                            HorizontalOptions="End">
                            <commonView:PageIndicatorView
                                Margin="20,25,0,0"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.CRReleaseDetails}" />
                            <custom:CustomLabel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,-10,0,15"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid
                            Grid.Row="2"
                            Margin="0,10,0,10"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <cards:SfCardView
                                Padding="10"
                                CornerRadius="20"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,10"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZakatYearOne}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                    <!--  ZakatYear  -->
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="EndAndExpand">
                                        <Border
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}"
                                                PlaceholderColor="Gray"
                                                Text="{Binding Year1}"
                                                TextChanged="Year1Change_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>

                                    <!--  ZakatCashBank  -->
                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatCashBank}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding CashBankY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>



                                    <!--  ZakatShortTermInvestment  -->

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding StiY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>


                                    <!--  ZakatDebitors  -->

                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatDebitors}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding DebitorsY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>

                                    </StackLayout>

                                    <!--  ZakatInventory  -->
                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInventory}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding InventoryY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>
                                    <!--  ZakatInstalmentTotalCurrentAssets  -->
                                    <StackLayout
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentAssets}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding TcAssetsY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>

                                    <!--  ZakatInstalmentZakatAndTax  -->

                                    <StackLayout
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentZakatAndTax}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding ZakatY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>

                                    <!--  ZakatInstalmentTotalCurrentLiabilities  -->

                                    <StackLayout
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentLiabilities}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding TcLiabltyY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>

                                    <!--  ZakatRevenue  -->

                                    <StackLayout
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatRevenue}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding RevenueY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>

                                    <!--  ZakatInstalmentNetIncome  -->

                                    <StackLayout
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            Grid.Row="10"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetIncome}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding NetIncomeY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>

                                    <!--  ZakatInstalmentNetCashFlowFromOperation  -->

                                    <StackLayout
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetCashFlowFromOperation}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding NcFlowY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentProfitabilityRatio}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:CustomLabel
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Text="{Binding ProfitRatioY1}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </StackLayout>

                                    <StackLayout
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentCashRatio}"
                                            VerticalOptions="FillAndExpand" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:CustomLabel
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Text="{Binding CashRatioY1}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand" />
                                        </Border>
                                    </StackLayout>
                                </Grid>
                            </cards:SfCardView>
                        </Grid>

                        <Grid
                            Grid.Row="3"
                            Margin="0,10,0,10"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <cards:SfCardView
                                Padding="10"
                                CornerRadius="20"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,10"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZakatYearTwo}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                    <!--  ZakatYear  -->
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical">

                                        <Border
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}"
                                                PlaceholderColor="Gray"
                                                Text="{Binding Year2}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </StackLayout>

                                    <!--  ZakatCashBank  -->
                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatCashBank}"
                                            VerticalOptions="Center" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding CashBankY2}"
                                                TextChanged="calculation2_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </StackLayout>



                                    <!--  ZakatShortTermInvestment  -->

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}"
                                            VerticalOptions="Center" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding StiY2}"
                                                TextChanged="calculation2_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </StackLayout>


                                    <!--  ZakatDebitors  -->

                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatDebitors}"
                                            VerticalOptions="Center" />

                                        <Border
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
