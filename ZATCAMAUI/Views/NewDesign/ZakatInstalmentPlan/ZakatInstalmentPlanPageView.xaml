<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatInstalmentPlan.ZakatInstalmentPlanPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                    VerticalOptions="Center" />

                <StackLayout Grid.Row="0" Grid.Column="2">
                    <StackLayout
                        HorizontalOptions="CenterAndExpand"
                        Orientation="Horizontal"
                        Rotation="90"
                        Spacing="3"
                        VerticalOptions="CenterAndExpand">
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                        <BoxView
                            BackgroundColor="{StaticResource SecondaryNew}"
                            CornerRadius="3"
                            HeightRequest="5"
                            WidthRequest="5" />
                    </StackLayout>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding onMoreOptionClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="10,0"
                Style="{StaticResource CommonTopCurves}">

                <Grid>

                    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                            <!--  Display Instalments  -->


                            <!--  Data Entry/calculations screen  -->

                            <Grid
                                Margin="20,10,20,0"
                                BackgroundColor="Transparent"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding InstalmentPlanAgreementsVisible}"
                                VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                    HorizontalOptions="End">
                                    <commonView:PageIndicatorView
                                        Margin="20,25,0,0"
                                        Completed="{Binding MarkComplete}"
                                        DotSize="12"
                                        HorizontalOptions="End"
                                        MaxNum="{Binding MaxIndex}"
                                        MinNum="{Binding CurrentIndex}"
                                        VerticalOptions="CenterAndExpand" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,5,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CRReleaseDetails}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,-10,0,15"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" />
                                    <BoxView
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                </Grid>

                                <Grid
                                    Grid.Row="2"
                                    Margin="0,10,0,10"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">
                                    <cards:SfCardView
                                        Padding="10"
                                        CornerRadius="20"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="FillAndExpand">

                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*" />
                                                <ColumnDefinition Width="50*" />
                                            </Grid.ColumnDefinitions>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,0,10"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZakatYearOne}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!--  ZakatYear  -->
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="EndAndExpand">
                                                <Border
                                                    Padding="10"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding Year1}"
                                                        TextChanged="Year1Change_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>

                                            <!--  ZakatCashBank  -->
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatCashBank}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding CashBankY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>



                                            <!--  ZakatShortTermInvestment  -->

                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding StiY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>


                                            <!--  ZakatDebitors  -->

                                            <StackLayout
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatDebitors}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding DebitorsY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>

                                            </StackLayout>

                                            <!--  ZakatInventory  -->
                                            <StackLayout
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInventory}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding InventoryY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>
                                            <!--  ZakatInstalmentTotalCurrentAssets  -->
                                            <StackLayout
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentAssets}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding TcAssetsY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>

                                            <!--  ZakatInstalmentZakatAndTax  -->

                                            <StackLayout
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentZakatAndTax}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding ZakatY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>

                                            <!--  ZakatInstalmentTotalCurrentLiabilities  -->

                                            <StackLayout
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentLiabilities}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding TcLiabltyY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>

                                            <!--  ZakatRevenue  -->

                                            <StackLayout
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatRevenue}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding RevenueY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>

                                            <!--  ZakatInstalmentNetIncome  -->

                                            <StackLayout
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    Grid.Row="10"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetIncome}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding NetIncomeY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>

                                            <!--  ZakatInstalmentNetCashFlowFromOperation  -->

                                            <StackLayout
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetCashFlowFromOperation}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding NcFlowY1}"
                                                        TextChanged="calculation_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentProfitabilityRatio}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}"
                                                    VerticalOptions="FillAndExpand">

                                                    <Label
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Text="{Binding ProfitRatioY1}"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </StackLayout>

                                            <StackLayout
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand"
                                                VerticalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentCashRatio}"
                                                    VerticalOptions="FillAndExpand" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <Label
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Text="{Binding CashRatioY1}"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="FillAndExpand" />
                                                </Border>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView>
                                </Grid>

                                <Grid
                                    Grid.Row="3"
                                    Margin="0,10,0,10"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">
                                    <cards:SfCardView
                                        Padding="10"
                                        CornerRadius="20"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="FillAndExpand">

                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*" />
                                                <ColumnDefinition Width="50*" />
                                            </Grid.ColumnDefinitions>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,0,10"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZakatYearTwo}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!--  ZakatYear  -->
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand">

                                                <Border
                                                    Padding="10"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding Year2}"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </StackLayout>

                                            <!--  ZakatCashBank  -->
                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatCashBank}"
                                                    VerticalOptions="Center" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding CashBankY2}"
                                                        TextChanged="calculation2_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </StackLayout>



                                            <!--  ZakatShortTermInvestment  -->

                                            <StackLayout
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}"
                                                    VerticalOptions="Center" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding StiY2}"
                                                        TextChanged="calculation2_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </StackLayout>


                                            <!--  ZakatDebitors  -->

                                            <StackLayout
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatDebitors}"
                                                    VerticalOptions="Center" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding DebitorsY2}"
                                                        TextChanged="calculation2_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="Center" />
                                                </Border>

                                            </StackLayout>

                                            <!--  ZakatInventory  -->
                                            <StackLayout
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                HorizontalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInventory}"
                                                    VerticalOptions="Center" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
                                                        PlaceholderColor="Gray"
                                                        Text="{Binding InventoryY2}"
                                                        TextChanged="calculation2_TextChanged"
                                                        TextColor="{StaticResource PrimaryColor}"
                                                        VerticalOptions="Center" />
                                                </Border>
                                            </StackLayout>
                                            <!--  ZakatInstalmentTotalCurrentAssets  -->
                                            <StackLayout
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                HorizontalOptions="FillAndExpand">
                                                <Label
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentAssets}"
                                                    VerticalOptions="Center" />

                                                <Border
                                                    Padding="5"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource GreyBorderFrame}">

                                                    <custom:GAZTBorderlessEditor
                                                        FontSize="Small"
                                                        HorizontalOptions="FillAndExpand"
                                                        Keyboard="Numeric"
