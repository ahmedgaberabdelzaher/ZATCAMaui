                            <Border
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,16,0,10"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="establishments"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <Label
                                                Padding="8,0"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAgrement}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="8,0"
                                            HorizontalOptions="End">
                                            <Label
                                                FontSize="Medium"
                                                Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoBackToAggrement}" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Grid
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Padding="8">
                                        <custom:CustomLabel
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" />
                                        <custom:CustomLabel
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding NoOfInstalments}" />
                                    </Grid>
                                    <Grid
                                        Grid.Row="4"
                                        Grid.ColumnSpan="2"
                                        Padding="8">
                                        <custom:CustomLabel
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetFrequency}" />
                                        <custom:CustomLabel
                                            Grid.Column="1"
                                            HorizontalOptions="EndAndExpand"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding SelectedFrequencyName}" />
                                    </Grid>

                                </StackLayout>
                            </Border>

                            <!--  Summary Attachments  -->

                            <Border
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,16,0,10"
                                Style="{StaticResource GreyBorderFrameWithShadow}">

                                <Grid Padding="0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />

                                    </Grid.RowDefinitions>
                                    <Grid
                                        Grid.Row="0"
                                        Padding="15"
                                        RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Image
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_attachment"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <Label
                                                Padding="8,0"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="8,0"
                                            HorizontalOptions="End">
                                            <Label
                                                FontSize="Medium"
                                                Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoBackToAttachments}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </StackLayout>
                                    </Grid>

                                    <BoxView
                                        Grid.Row="1"
                                        HeightRequest="1"
                                        Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <listView:SfListView
                                        x:Name="SummaryAttachmentsListView"
                                        Grid.Row="2"
                                        Padding="3,0,3,0"
                                        HorizontalOptions="Center"
                                        IsScrollingEnabled="False"
                                        ItemsSource="{Binding AttachmentsListViewData}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent"
                                        SelectionMode="None"
                                        VerticalOptions="StartAndExpand">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0" RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>


                                                    <Grid Grid.Row="0" Grid.Column="0">
                                                        <Image
                                                            HeightRequest="25"
                                                            HorizontalOptions="Start"
                                                            Source="Generic_attachment_icon"
                                                            VerticalOptions="Center"
                                                            WidthRequest="25" />

                                                    </Grid>

                                                    <Grid Grid.Row="0" Grid.Column="1">
                                                        <Label
                                                            HorizontalOptions="End"
                                                            Style="{StaticResource BodyLabelBlack}"
                                                            Text="{Binding Filename}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>

                                </Grid>
                            </Border>



                        </Grid>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0">

                                <Frame
                                    Padding="0"
                                    CornerRadius="10"
                                    HasShadow="False"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">
                                    <StackLayout Padding="10" Orientation="Horizontal">

                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}"
                                            VerticalTextAlignment="Center" />

                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding PeriodicInstalment, StringFormat='{0:N} SAR'}"
                                            VerticalTextAlignment="Center" />

                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Orientation="Vertical">

                                <Frame
                                    Padding="0"
                                    CornerRadius="10"
                                    HasShadow="False"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">
                                    <StackLayout Padding="10" Orientation="Horizontal">


                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetTotalAmount}"
                                            VerticalOptions="Center" />

                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding VATBillDueAmount, Converter={StaticResource commaSeparatorConverter}}"
                                            VerticalOptions="Center" />



                                    </StackLayout>
                                </Frame>



                                <Frame
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    CornerRadius="10"
                                    HasShadow="False"
                                    IsVisible="{Binding IsPenaltyVisible}"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">

                                    <StackLayout Padding="10" Orientation="Horizontal">



                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstallmentAgreementPenalty}"
                                            VerticalOptions="Center" />



                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding VATPenalityAmount, Converter={StaticResource commaSeparatorConverter}}"
                                            VerticalOptions="Center" />



                                    </StackLayout>
                                </Frame>
                            </StackLayout>

                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,10">

                                <StackLayout>

                                    <buttons:SfButton
                                        x:Name="SummarybtnContinue"
                                        Margin="0,16,0,16"
                                        Command="{Binding SummaryContinueBtnTapped}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}" />

                                </StackLayout>
                            </Grid>
                        </Grid>
                    </Grid>


                </Grid>
            </ScrollView>
            <Grid
                BackgroundColor="Transparent"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            AnimationType="Cupertino"
                            SizeFactor="0.6"
                            WidthRequest="70"
                            HeightRequest="70"
                            IndicatorColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand" />
                        <!--  Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"  -->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
