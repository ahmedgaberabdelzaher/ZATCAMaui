<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatInstalmentPlan.OldZakatInstalmentPlanPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:commonView="clr-namespace:ZATCAMAUI.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templateSelector="clr-namespace:ZATCAMAUI.Views.NewDesign.TemplateSelector"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">



    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />

        </ResourceDictionary>

    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackClick}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                    VerticalOptions="Center" />

                <StackLayout
                    Grid.Column="2"
                    HorizontalOptions="EndAndExpand"
                    Orientation="Horizontal"
                    Rotation="90"
                    Spacing="3"
                    VerticalOptions="CenterAndExpand">
                    <BoxView
                        BackgroundColor="{StaticResource SecondaryNew}"
                        CornerRadius="3"
                        HeightRequest="5"
                        WidthRequest="5" />
                    <BoxView
                        BackgroundColor="{StaticResource SecondaryNew}"
                        CornerRadius="3"
                        HeightRequest="5"
                        WidthRequest="5" />
                    <BoxView
                        BackgroundColor="{StaticResource SecondaryNew}"
                        CornerRadius="3"
                        HeightRequest="5"
                        WidthRequest="5" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding onMoreOptionClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>


            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="15,5"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    VerticalScrollBarVisibility="Never">

                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                        <!--#region Data Entry/calculations screen-->
                        <Grid
                            Margin="5,10"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding InstalmentPlanAgreementsVisible}"
                            RowDefinitions="auto,auto,auto,auto,auto,auto,*"
                            RowSpacing="10"
                            VerticalOptions="FillAndExpand">

                            <IndicatorView
                                Count="{Binding MaxIndex}"
                                HorizontalOptions="End"
                                IndicatorColor="LightGray"
                                IndicatorSize="16"
                                InputTransparent="True"
                                MaximumVisible="{Binding MaxIndex}"
                                Position="{Binding CurrentIndex}"
                                SelectedIndicatorColor="{StaticResource PrimaryColor}"
                                VerticalOptions="CenterAndExpand" />

                            <Grid
                                Grid.Row="1"
                                RowDefinitions="auto,auto,auto"
                                RowSpacing="10">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource PageTitleBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatOldFinancialDetails}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    HeightRequest="1"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            </Grid>

                            <Grid
                                Grid.Row="2"
                                RowDefinitions="auto,auto"
                                RowSpacing="10">

                                <Label
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTaxpayerHoldingFinancialStatement}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Border
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding PickedFinancialStatement}" />


                                        <Image HorizontalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                    Size="28"
                                                    Color="{StaticResource Secondary}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowFinancialStatementPicker}" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </StackLayout>

                                </Border>

                            </Grid>

                            <Grid
                                Grid.Row="3"
                                Margin="0,10,0,0"
                                HorizontalOptions="FillAndExpand"
                                IsEnabled="{Binding IsFinsancialStatementsEditable}"
                                RowDefinitions="auto"
                                VerticalOptions="FillAndExpand">

                                <cards:SfCardView
                                    Padding="10"
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">

                                    <Grid
                                        ColumnDefinitions="50*,50*"
                                        ColumnSpacing="10"
                                        HorizontalOptions="FillAndExpand"
                                        RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto"
                                        RowSpacing="10"
                                        VerticalOptions="FillAndExpand">

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZakatYearOne}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!--  ZakatYear  -->
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="EndAndExpand">
                                            <Border
                                                Padding="10"
                                                BackgroundColor="White"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}">

                                                <custom:GAZTBorderlessEntry
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    MaxLength="4"
                                                    Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding Year1}"
                                                    TextChanged="Year1Change_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatCashBank  -->
                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="2. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatCashBank}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="CashBankText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding CashBankY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatShortTermInvestment  -->
                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="3. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="ShortTermInvestmentText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding StiY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatDebitors  -->
                                        <StackLayout
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="4. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatDebitors}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="DebitorsText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding DebitorsY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>

                                        </StackLayout>

                                        <!--  ZakatInventory  -->
                                        <StackLayout
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="5. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatInventory}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="InventoryText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding InventoryY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatInstalmentTotalCurrentAssets  -->
                                        <StackLayout
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="6. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentAssets}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="TcAssetsText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding TcAssetsY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatInstalmentZakatAndTax  -->
                                        <StackLayout
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="7. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentZakatAndTax}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="ZakatText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding ZakatY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatInstalmentTotalCurrentLiabilities  -->
                                        <StackLayout
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="8. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentLiabilities}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="TcLiabilityText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding TcLiabilityY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatRevenue  -->

                                        <StackLayout
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="9. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatRevenue}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="RevenueText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding RevenueY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatInstalmentNetIncome  -->
                                        <StackLayout
                                            Grid.Row="5"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                Grid.Row="10"
                                                Grid.Column="0"
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="10. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetIncome}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="NetIncomeText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding NetIncomeY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <!--  ZakatInstalmentNetCashFlowFromOperation  -->
                                        <StackLayout
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="11. " />
                                                        <Span Style="{StaticResource MicroGrayLabelStyle}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetCashFlowFromOperation}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Border
                                                Padding="5"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource GreyBorderFrame}"
                                                VerticalOptions="FillAndExpand">

                                                <custom:GAZTBorderlessEntry
                                                    x:Name="NcFlowText"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="Small"
                                                    HorizontalOptions="FillAndExpand"
                                                    Keyboard="Numeric"
                                                    PlaceholderColor="Gray"
                                                    Text="{Binding NcFlowY1}"
                                                    TextChanged="calculation_TextChanged"
                                                    TextColor="{StaticResource PrimaryColor}"
                                                    Unfocused="CashBankText_Unfocused"
                                                    VerticalOptions="FillAndExpand">
                                                    <custom:GAZTBorderlessEntry.Behaviors>
                                                        <behaviors:AmountValidator />
                                                    </custom:GAZTBorderlessEntry.Behaviors>
                                                </custom:GAZTBorderlessEntry>
                                            </Border>
                                        </StackLayout>

                                        <StackLayout
                                            Grid.Row="6"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}"
                                                VerticalOptions="FillAndExpand">
                                                <Label.FormattedText>
