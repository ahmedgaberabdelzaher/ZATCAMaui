                                                <StackLayout>

                                                    <Border
                                                        Margin="0,10,0,0"
                                                        Padding="0"
                                                        IsVisible="{Binding IsPenaltyVisible}"
                                                        StrokeShape="RoundRectangle 10,10,10,10"
                                                        Style="{StaticResource SfStyleForZakatPlanGreen}">

                                                        <StackLayout Padding="10" Orientation="Horizontal">

                                                            <Label
                                                                HorizontalOptions="Start"
                                                                Style="{StaticResource BodyLabelBlack}"
                                                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentAgreementPenalty}"
                                                                VerticalOptions="Center" />

                                                            <Label
                                                                HorizontalOptions="EndAndExpand"
                                                                Style="{StaticResource SectionTitleBlackBold}"
                                                                Text="{Binding VATPenalityAmount, Converter={StaticResource commaSeparatorConverter}}"
                                                                VerticalOptions="Center" />

                                                        </StackLayout>
                                                    </Border>

                                                    <buttons:SfButton
                                                        Grid.Row="2"
                                                        Margin="10,10"
                                                        Command="{Binding DisplayDetailsButtonTapped}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.CRContinue}"
                                                        VerticalOptions="EndAndExpand" />
                                                </StackLayout>
                                            </ViewCell.View>
                                        </ViewCell>
                                    </DataTemplate>
                                </listView:SfListView.FooterTemplate>

                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <Grid Padding="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="1" />
                                                    <RowDefinition Height="*" />

                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>


                                                <Grid
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="2"
                                                    Padding="15">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="1" />

                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*" />
                                                        <ColumnDefinition Width="50*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Spacing="-10">
                                                        <Label
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSrNo}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Label Style="{StaticResource CaptionLabelGrey}" Text="{Binding LineNo}" />
                                                    </StackLayout>

                                                    <Border
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="10,5,10,5"
                                                        HorizontalOptions="End"
                                                        Style="{StaticResource GreyBorderFrameWithShadow}"
                                                        VerticalOptions="CenterAndExpand">

                                                        <Label
                                                            HorizontalOptions="CenterAndExpand"
                                                            Style="{StaticResource CaptionLabelBlack}"
                                                            Text="{Binding InsStatusTxt}"
                                                            VerticalOptions="CenterAndExpand">
                                                            <Label.Triggers>

                                                                <DataTrigger
                                                                    Binding="{Binding InsStatusTxt}"
                                                                    TargetType="Label"
                                                                    Value="{x:Static ResourceManager:AppResources.UnPaid}">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.UnPaid}" />
                                                                    <Setter Property="TextColor" Value="red" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                </Grid>

                                                <BoxView
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    BackgroundColor="LightGray"
                                                    HorizontalOptions="FillAndExpand" />

                                                <Grid
                                                    Grid.Row="2"
                                                    Grid.ColumnSpan="2"
                                                    Padding="15"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*" />
                                                        <ColumnDefinition Width="50*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackLayout
                                                        Grid.Column="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentPeriodicInstalmentAmount}"
                                                            VerticalOptions="FillAndExpand" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding InsAmt, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}"
                                                            VerticalOptions="FillAndExpand" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Column="1"
                                                        HorizontalOptions="FillAndExpand"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}"
                                                            VerticalOptions="FillAndExpand" />
                                                        <Label
                                                            HorizontalOptions="FillAndExpand"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding DueDt}"
                                                            VerticalOptions="FillAndExpand" />
                                                    </StackLayout>

                                                </Grid>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                        </Grid>
                        <!--#endregion-->

                        <!--#region Summary View-->
                        <Grid
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsSummaryViewEnabled}"
                            RowDefinitions="auto,auto,auto"
                            VerticalOptions="FillAndExpand">

                            <Grid Grid.Row="0" HorizontalOptions="End">
                                <IndicatorView
                                    Count="{Binding MaxIndex}"
                                    HorizontalOptions="End"
                                    IndicatorColor="LightGray"
                                    IndicatorSize="16"
                                    InputTransparent="True"
                                    MaximumVisible="{Binding MaxIndex}"
                                    Position="{Binding CurrentIndex}"
                                    SelectedIndicatorColor="{StaticResource PrimaryColor}"
                                    VerticalOptions="CenterAndExpand" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.ZSummary}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="false"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <Border
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="establishments"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.Bills}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="8,0"
                                                HorizontalOptions="End">
                                                <Label
                                                    FontSize="Medium"
                                                    Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                    TextColor="{StaticResource Secondary}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding GoBackToBills}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                        <listView:SfListView
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding SummarySelectedBillsList}"
                                            ScrollBarVisibility="Never"
                                            SelectionBackground="Transparent"
                                            SelectionMode="SingleDeselect"
                                            VerticalOptions="Center">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Margin="10,5,10,0"
                                                        Padding="0"
                                                        RowSpacing="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50*" />
                                                            <ColumnDefinition Width="50*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                                                            <Label
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource SectionTitleBlackBold}"
                                                                Text="{Binding billNumber}" />
                                                        </StackLayout>

                                                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                                            <Label
                                                                Grid.Column="0"
                                                                HorizontalOptions="StartAndExpand"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource BodyLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryBillType}" />
                                                            <Label
                                                                Grid.Column="1"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding billType}" />
                                                        </Grid>
                                                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                                            <Label
                                                                Grid.Column="0"
                                                                HorizontalOptions="StartAndExpand"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource BodyLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentInvoiceNumber}" />
                                                            <Label
                                                                Grid.Column="1"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding saadNumber}" />
                                                        </Grid>
                                                        <Grid Grid.Row="3" Grid.ColumnSpan="2">
                                                            <Label
                                                                Grid.Column="0"
                                                                HorizontalOptions="StartAndExpand"
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource BodyLabelGrey}"
                                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}" />
                                                            <Label
                                                                Grid.Column="1"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding taxPeriod}" />
                                                        </Grid>


                                                    </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                                    </StackLayout>
                                </Border>

                                <!--  Installment Agreement Section  -->


                                <Border
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    Source="establishments"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAgrement}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="8,0"
                                                HorizontalOptions="End">
                                                <Label
                                                    FontSize="Medium"
                                                    Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                    TextColor="{StaticResource Secondary}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding GoBackToAggrement}" />
                                                    </Label.GestureRecognizers>
                                                </Label>

                                            </StackLayout>
                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                        <StackLayout Padding="15,15,15,0">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding NoOfInstalments}" />
                                            </Grid>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetFrequency}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding SelectedFrequencyName}" />
                                            </Grid>

                                        </StackLayout>

                                    </StackLayout>
                                </Border>

                                <!--  Summary Attachments  -->

                                <Border
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,16,0,10"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout
                                        Padding="0"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="FillAndExpand">
                                        <Grid Padding="0">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="*" />

                                            </Grid.RowDefinitions>
                                            <Grid
                                                Grid.Row="0"
                                                Padding="15"
                                                RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="8,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Aspect="AspectFit"
                                                        HeightRequest="24"
                                                        HorizontalOptions="Center"
                                                        Source="ic_attachment"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />

                                                    <Label
                                                        Padding="8,0"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="8,0"
                                                    HorizontalOptions="End">
                                                    <Label
                                                        FontSize="Medium"
                                                        Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                        TextColor="{StaticResource Secondary}"
                                                        VerticalOptions="CenterAndExpand">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding GoBackToAttachments}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </StackLayout>
                                            </Grid>

                                            <BoxView
                                                Grid.Row="1"
                                                HeightRequest="1"
                                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <listView:SfListView
                                                x:Name="SummaryAttachmentsListView"
                                                Grid.Row="2"
                                                Padding="3,0,3,0"
                                                AutoFitMode="Height"
                                                HorizontalOptions="Center"
                                                IsScrollingEnabled="False"
                                                ItemSpacing="5"
                                                ItemsSource="{Binding AttachmentsListViewData}"
                                                ScrollBarVisibility="Never"
                                                SelectionBackground="Transparent"
                                                SelectionMode="None"
                                                VerticalOptions="StartAndExpand">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            Margin="10,5,10,0"
                                                            Padding="0"
                                                            RowSpacing="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>


                                                            <StackLayout Grid.Row="0" Grid.Column="0">
                                                                <Image
                                                                    HeightRequest="25"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Source="documents_Green"
                                                                    VerticalOptions="CenterAndExpand"
                                                                    WidthRequest="25" />
                                                            </StackLayout>

                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Margin="10,0,10,0">

                                                                <Label
                                                                    HorizontalOptions="End"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding Filename}"
                                                                    VerticalOptions="FillAndExpand" />
                                                            </StackLayout>


                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>

                                        </Grid>
                                    </StackLayout>

                                </Border>



                            </Grid>

                            <Grid Grid.Row="2" RowDefinitions="auto,*">


                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,10,0,0">

                                    <Border
                                        Padding="0"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}">
                                        <StackLayout Padding="10" Orientation="Horizontal">


                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetTotalAmount}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />

                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding VATBillDueAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                        <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>





                                        </StackLayout>
                                    </Border>

                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        IsVisible="False"
                                        StrokeShape="RoundRectangle 10,10,10,10"
                                        Style="{StaticResource SfStyleForZakatPlanGreen}">

                                        <StackLayout Padding="10" Orientation="Horizontal">



                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource BodyLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentAgreementPenalty}"
                                                VerticalOptions="Center" />


                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{Binding VATPenalityAmount, Converter={StaticResource commaSeparatorConverter}}"
                                                VerticalOptions="Center" />



                                        </StackLayout>
                                    </Border>

                                </StackLayout>

                                <buttons:SfButton
                                    x:Name="SummarybtnContinue"
                                    Grid.Row="1"
                                    Margin="0,16"
                                    Command="{Binding SummaryContinueBtnTapped}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Submit}" />
                            </Grid>
                        </Grid>
                        <!--#endregion-->


                    </Grid>

                </ScrollView>

            </Border>

            <!--  Loader  -->
            <custom:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>
