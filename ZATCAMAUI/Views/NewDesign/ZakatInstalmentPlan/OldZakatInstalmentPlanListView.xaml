                                            Style="{StaticResource GreyBorderFrameWithShadow}"
                                            VerticalOptions="FillAndExpand">
                                            <Grid
                                                Margin="0"
                                                Padding="0"
                                                ColumnDefinitions="50*,50*"
                                                HorizontalOptions="FillAndExpand"
                                                RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto"
                                                RowSpacing="0"
                                                VerticalOptions="FillAndExpand">

                                                <Label
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="2"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSADADBillNo}" />
                                                <Label
                                                    Grid.Row="1"
