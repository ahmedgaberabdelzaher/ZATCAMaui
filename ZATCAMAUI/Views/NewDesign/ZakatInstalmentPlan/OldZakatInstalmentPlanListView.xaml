                                                    HorizontalTextAlignment="Center"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZaaktInstalmentReturnDueDate}" />
                                                <Label
                                                    Grid.Row="6"
                                                    Grid.Column="1"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Faedn}" />


                                            </Grid>
                                        </Border>
