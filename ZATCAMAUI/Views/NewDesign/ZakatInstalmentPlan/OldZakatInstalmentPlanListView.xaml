                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Vtre2}" />

                                                <BoxView
                                                    Grid.Row="2"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,5,0,5"
                                                    HeightRequest="1"
                                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                                <Label
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentBillNumber}" />
                                                <Label
                                                    Grid.Row="4"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Opbel}" />

                                                <Label
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentReturnFBN}" />
                                                <Label
                                                    Grid.Row="4"
                                                    Grid.Column="1"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding RetFbn}" />

                                                <Label
                                                    Grid.Row="5"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentBillStartDate}" />
                                                <Label
                                                    Grid.Row="6"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Abrzu}" />

                                                <Label
                                                    Grid.Row="5"
                                                    Grid.Column="1"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentBillDueDate}" />
                                                <Label
                                                    Grid.Row="6"
                                                    Grid.Column="1"
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Abrzo}" />

                                                <Label
                                                    Grid.Row="7"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentBillAmount}" />
                                                <Label
                                                    Grid.Row="8"
