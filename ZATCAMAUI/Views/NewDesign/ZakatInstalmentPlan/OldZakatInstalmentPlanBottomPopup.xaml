<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatInstalmentPlan.OldZakatInstalmentPlanBottomPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    FlowDirection="{Binding AppDirection}"
    mc:Ignorable="d">
    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </pages:PopupPage.Resources>-->

    <Border
        Padding="15"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 15,15,0,0"
        VerticalOptions="EndAndExpand">
        <StackLayout Spacing="15">
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource SectionTitleBlack}"
                Text="Instructions and Conditions" />
            <ScrollView Grid.Row="1">
                <StackLayout Padding="5" Spacing="15">
                    <Frame
                        Padding="15"
                        BorderColor="LightGray"
                        CornerRadius="12"
                        HasShadow="False">
                        <StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <Image Source="ic_vat_info" />
                                <Label
                                    CharacterSpacing="0"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="Information"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                            <Label Style="{StaticResource BodyLabelBlack}" Text="The adjustment amount entered is more than 10% larger than the amount of domestic standard-rated sales. please verify the amount entered in the return or continue if the amount entered is correct." />
                        </StackLayout>
                    </Frame>
                    <StackLayout Margin="10" Orientation="Horizontal">

                        <buttons:SfCheckBox IsChecked="{Binding IsVatTermsChecked}" />
                        <Label
                            CharacterSpacing="0"
                            Style="{StaticResource BodyLabelBlack}"
                            Text="I agree with these instructions and conditions."
                            VerticalOptions="CenterAndExpand" />

                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <buttons:SfButton
                x:Name="btnVATInstalement"
                Grid.ColumnSpan="2"
                Margin="0,24,0,24"
                Command="{Binding VATInstalationClicked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="VAT Instalment" />
        </StackLayout>
    </Border>
</pages:PopupPage>