<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatInstalmentPlan.ZakatInstalmentPlanSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    BackgroundImageSource="partials_background"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>-->
    <ContentPage.Content>

        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">

                <Image
                    Aspect="AspectFit"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    Source="Forget_ic_success"
                    VerticalOptions="Center"
                    WidthRequest="120" />

                <Label
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="Large"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                    TextColor="White" />
                <Label
                    FontFamily="{StaticResource SomarSemiBold}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{Binding SuccessMessage}"
                    TextColor="White" />
            </StackLayout>
            <ScrollView>
                <Grid>

                    <yummy:PancakeView
                        Padding="20"
                        BackgroundColor="White"
                        CornerRadius="20,20,0,0"
                        VerticalOptions="EndAndExpand">
                        <StackLayout>

                            <Frame
                                Margin="10,5,10,5"
                                Padding="0"
                                BorderColor="LightGray"
                                CornerRadius="8"
                                HasShadow="False">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="11"
                                        HorizontalOptions="Start"
                                        Text="{x:Static ResourceManager:AppResources.NDReferenceNumber}"
                                        TextColor="{StaticResource DarkGrayTextColor}"
                                        VerticalOptions="Center" />



                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="15"
                                        HorizontalOptions="End"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding ZakatReferanceNumber}"
                                        VerticalOptions="Center" />



                                    <Image Grid.Row="0" Grid.Column="2">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Instalment_copy_Tapped" />
                                        </Image.GestureRecognizers>
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>

                                </Grid>
                            </Frame>

                            <buttons:SfButton
                                Grid.ColumnSpan="2"
                                Margin="10,20,10,20"
                                Background="{StaticResource Secondary}"
                                Clicked="Download_Acknowledgement"
                                Command="{Binding DownloadConfirmationTapped}"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="46"
                                Text="{x:Static ResourceManager:AppResources.VatInstalmentDownload}"
                                TextColor="White"
                                VerticalOptions="End" />



                            <custom:CustomLabel
                                Margin="10,0,10,15"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{x:Static ResourceManager:AppResources.VatInstalmentPlan}"
                                TextColor="{StaticResource Primary}">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Instalment_plan_Tapped" />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>
                        </StackLayout>
                    </yummy:PancakeView>

                    <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="Black"
                            Opacity="0.4"
                            Orientation="Vertical"
                            VerticalOptions="FillAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="15,15"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Opacity="0.8"
                            Orientation="Vertical"
                            VerticalOptions="Center">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <busyindicator:SfBusyIndicator
                                    x:Name="busyindicatorForLanding"
                                    HorizontalOptions="CenterAndExpand"
                                    IsRunning="True"
                                    AnimationType="Cupertino"
                                    SizeFactor="0.6"
                                    WidthRequest="70"
                                    HeightRequest="70"
                                    IndicatorColor="{StaticResource Secondary}"
                                    TitlePlacement="Bottom"
                                    VerticalOptions="CenterAndExpand" />
                                <!--  Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"  -->
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </Grid>
            </ScrollView>
        </StackLayout>

    </ContentPage.Content>
</ContentPage>
