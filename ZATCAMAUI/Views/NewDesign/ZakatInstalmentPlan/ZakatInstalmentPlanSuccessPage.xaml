<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.ZakatInstalmentPlan.ZakatInstalmentPlanSuccessPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:ZATCAMAUI.Core.Helper"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Content>

        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">

                <Image
                    Aspect="AspectFit"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    Source="Forget_ic_success"
                    VerticalOptions="Center"
                    WidthRequest="120" />

                <Label
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="Large"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                    TextColor="White" />
                <Label
                    FontFamily="{StaticResource SomarSemiBold}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{Binding SuccessMessage}"
                    TextColor="White" />
            </StackLayout>
            <ScrollView>
                <Grid>

                    <Border
                        Padding="20"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 20,20,0,0"
                        VerticalOptions="EndAndExpand">
                        <StackLayout>

                            <Border
                                Margin="10,5,10,5"
                                Padding="0"
                                Stroke="LightGray"
                                StrokeShape="RoundRectangle 8,8,8,8">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="11"
                                        HorizontalOptions="Start"
                                        Text="{x:Static ResourceManager:AppResources.NDReferenceNumber}"
                                        TextColor="{StaticResource DarkGrayTextColor}"
                                        VerticalOptions="Center" />



                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="15"
                                        HorizontalOptions="End"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding ZakatReferanceNumber}"
                                        VerticalOptions="Center" />



                                    <Image Grid.Row="0" Grid.Column="2">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="Instalment_copy_Tapped" />
                                        </Image.GestureRecognizers>
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>

                                </Grid>
                            </Border>

                            <buttons:SfButton
                                Grid.ColumnSpan="2"
                                Margin="10,20,10,20"
                                Background="{StaticResource Secondary}"
                                Clicked="Download_Acknowledgement"
                                Command="{Binding DownloadConfirmationTapped}"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="46"
                                Text="{x:Static ResourceManager:AppResources.VatInstalmentDownload}"
                                TextColor="White"
                                VerticalOptions="End" />



                            <Label
                                Margin="10,0,10,15"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{x:Static ResourceManager:AppResources.VatInstalmentPlan}"
                                TextColor="{StaticResource Primary}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Instalment_plan_Tapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </StackLayout>
                    </Border>
                    <custom:Loader IsVisible="{Binding IsLoading}" />

                </Grid>
            </ScrollView>
        </StackLayout>

    </ContentPage.Content>
</ContentPage>
