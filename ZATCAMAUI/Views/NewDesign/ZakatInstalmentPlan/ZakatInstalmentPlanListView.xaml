<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class=" ZATCAMAUI.Views.NewDesign.ZakatInstalmentPlan.ZakatInstalmentPlanListPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:busyindicator="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:cards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
    xmlns:converters="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{DynamicResource StyleReverseBack}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource IconLabelStyle}"
                            Text="{StaticResource Close}"
                            TextColor="White"
                            VerticalOptions="CenterAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <!--  Landing Page  -->
                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsZakatLandingPageVisible}"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="28"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}"
                            Text="{Binding SelectionType}" />

                        <custom:CustomLabel
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentPlanSubTitle}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    </Grid>

                    <Grid
                        Grid.Row="1"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <listView:SfListView
                            x:Name="outletDecisionOptionsListView"
                            AutoFitMode="Height"
                            HorizontalOptions="FillAndExpand"
                            ItemSpacing="5"
                            ItemsSource="{Binding OutletDecisionOptions}"
                            SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                            SelectionBackground="Transparent"
                            SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                            SelectionMode="Single"
                            VerticalOptions="StartAndExpand">

                            <listView:SfListView.ItemTemplate>

                                <DataTemplate>
                                    <cards:SfCardView
                                        BackgroundColor="Transparent"
                                        CornerRadius="20"
                                        HeightRequest="120">
                                        <Grid
                                            ColumnSpacing="20"
                                            HorizontalOptions="FillAndExpand"
                                            RowSpacing="10"
                                            VerticalOptions="FillAndExpand">
                                            <Image
                                                Aspect="Fill"
                                                HorizontalOptions="FillAndExpand"
                                                Source="vat_tile_listofsignup_W"
                                                VerticalOptions="FillAndExpand" />
                                            <custom:CustomLabel
                                                Margin="20,0,20,20"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding ActiveOutletDecisionOptions}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="EndAndExpand" />
                                        </Grid>
                                    </cards:SfCardView>

                                </DataTemplate>

                            </listView:SfListView.ItemTemplate>

                            <listView:SfListView.SelectedItemTemplate>

                                <DataTemplate>
                                    <cards:SfCardView
                                        BackgroundColor="Transparent"
                                        CornerRadius="20"
                                        HeightRequest="120">
                                        <Grid
                                            ColumnSpacing="20"
                                            HorizontalOptions="FillAndExpand"
                                            RowSpacing="10"
                                            VerticalOptions="FillAndExpand">
                                            <Image
                                                Aspect="Fill"
                                                HorizontalOptions="FillAndExpand"
                                                Source="vat_tile_listofsignup"
                                                VerticalOptions="FillAndExpand" />
                                            <custom:CustomLabel
                                                Margin="20,0,20,20"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding ActiveOutletDecisionOptions}"
                                                TextColor="White"
                                                VerticalOptions="EndAndExpand" />
                                        </Grid>
                                    </cards:SfCardView>

                                </DataTemplate>

                            </listView:SfListView.SelectedItemTemplate>

                            <listView:SfListView.ItemsLayout>

                                <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />

                            </listView:SfListView.ItemsLayout>

                        </listView:SfListView>

                    </Grid>
                </Grid>

                <StackLayout Margin="20" IsVisible="{Binding CreateZakatInstalmentBtnVisible}">


                    <!--  Display Submitted list  -->

                    <listView:SfListView
                        x:Name="VATInstalmentPlanListViewPage"
                        Grid.Row="2"
                        Margin="0"
                        Padding="0"
                        AutoFitMode="Height"
                        HorizontalOptions="CenterAndExpand"
                        ItemSpacing="0"
                        ItemTapped="SummaryattachmentsListView_ItemTapped"
                        ItemsSource="{Binding ZakatListData}"
                        SelectionBackground="Transparent"
                        SelectionMode="Single"
                        VerticalOptions="StartAndExpand">
                        <listView:SfListView.HeaderTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <ViewCell.View>
                                        <Grid Grid.Row="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="1" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontSize="28"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodMyRequests}" />
                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding NumberOfInstalmentPlans}" />
                                            <BoxView
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                            <cards:SfCardView
                                                Grid.Row="3"
                                                Margin="0,10,0,10"
                                                Padding="12"
                                                BorderColor="Gray"
                                                BorderWidth="0.2"
                                                CornerRadius="15">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        HeightRequest="30"
                                                        HorizontalOptions="Start"
                                                        Source="add"
                                                        WidthRequest="30" />
                                                    <custom:CustomLabel
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmentCreateNewRequest}" />
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ReqInstalmentBtnTapped}" />
                                                    </Grid.GestureRecognizers>
                                                </Grid>

                                            </cards:SfCardView>
                                        </Grid>
                                    </ViewCell.View>
                                </ViewCell>
                            </DataTemplate>
                        </listView:SfListView.HeaderTemplate>

                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Grid.Column="0"
                                    Margin="0,15,0,0"
                                    Padding="10"
                                    StrokeShape="RoundRectangle 15,15,15,15"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <Grid
                                        Margin="0"
                                        Padding="0"
                                        RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50*" />
                                            <ColumnDefinition Width="50*" />
                                        </Grid.ColumnDefinitions>

                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Margin="0"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}"
                                            Text="{Binding Fbtyp}" />

                                        <custom:CustomLabel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{Binding referanceNumber}"
                                            VerticalOptions="CenterAndExpand" />

                                        <StackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            VerticalOptions="FillAndExpand">

                                            <yummy:PancakeView
                                                Padding="8,3,8,3"
                                                BackgroundColor="{StaticResource PartialBg}"
                                                CornerRadius="14"
                                                HorizontalOptions="Center"
                                                VerticalOptions="CenterAndExpand">

                                                <yummy:PancakeView.Border>
                                                    <yummy:Border Thickness="1" />
                                                </yummy:PancakeView.Border>

                                                <Label
                                                    HorizontalOptions="CenterAndExpand"
                                                    HorizontalTextAlignment="Center"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{Binding status}"
                                                    TextColor="{StaticResource Partial}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding status}"
                                                            TargetType="Label"
                                                            Value="{x:Static ResourceManager:AppResources.NDBilled}">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.NDBilled}" />
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                            <Setter Property="HorizontalTextAlignment" Value="Center" />
                                                        </DataTrigger>

                                                    </Label.Triggers>
                                                </Label>
                                            </yummy:PancakeView>
                                        </StackLayout>

                                        <BoxView
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Margin="0,5,0,5"
                                            HeightRequest="1"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                        <StackLayout
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Spacing="-5">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatDueAmount}" />
                                            <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding dueamount, Converter={StaticResource commaSeparatorConverter}}" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Spacing="-5">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentInstalmentAmount}" />
                                            <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding instalmentAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                        </StackLayout>

                                        <StackLayout
                                            Grid.Row="4"
                                            Grid.Column="0"
                                            Spacing="-5">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNumberOfInstalments}" />
                                            <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding noOfInstalments}" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            Spacing="-5"
                                            VerticalOptions="FillAndExpand">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDownPaymentAmount}" />
                                            <Label
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding downpayment, Converter={StaticResource commaSeparatorConverter}}"
                                                VerticalOptions="FillAndExpand" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="5"
                                            Grid.ColumnSpan="2"
                                            Spacing="-5">
                                            <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSubmissionDate}" />
                                            <Label Style="{StaticResource ValueLabelBlack}" Text="{Binding dateOfSubmission}" />
                                        </StackLayout>


                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>

                    </listView:SfListView>




                </StackLayout>
                <!--  Summary View  -->

                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsZakatSummaryVisible}"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <StackLayout Orientation="Vertical">
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="28"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource SectionTitleBlackBold}"
                                Text="{x:Static ResourceManager:AppResources.ZVatSummary}" />
                            <custom:CustomLabel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </StackLayout>
                        <Border
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="establishments"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.Bills}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />


                                <listView:SfListView
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding SummarySelectedBillsList}"
                                    ScrollBarVisibility="Never"
                                    SelectionBackground="Transparent"
                                    SelectionMode="SingleDeselect"
                                    VerticalOptions="Center">


                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="10,0,10,0"
                                                Padding="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="0"
                                                VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>

                                                <custom:CustomLabel
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{Binding billNumber}" />

                                                <custom:CustomLabel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    HorizontalOptions="FillAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding billType}"
                                                    VerticalOptions="FillAndExpand" />
                                                <custom:CustomLabel
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryBillType}" />

                                                <custom:CustomLabel
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentInvoiceNumber}"
                                                    VerticalOptions="FillAndExpand" />
                                                <custom:CustomLabel
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    HorizontalOptions="FillAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding saadNumber}"
                                                    VerticalOptions="FillAndExpand" />

                                                <custom:CustomLabel
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDueDate}"
                                                    VerticalOptions="FillAndExpand" />
                                                <custom:CustomLabel
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    HorizontalOptions="FillAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding taxPeriod}"
                                                    VerticalOptions="FillAndExpand" />

                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </StackLayout>
                        </Border>

                        <!--  Installment Agreement Section  -->


                        <Border
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="establishments"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAgrement}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <Grid
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Padding="8">
                                    <custom:CustomLabel
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" />
                                    <custom:CustomLabel
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding NoOfInstalments}" />
                                </Grid>
                                <Grid
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Padding="8">
                                    <custom:CustomLabel
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        HorizontalTextAlignment="Start"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetFrequency}" />
                                    <custom:CustomLabel
                                        Grid.Column="1"
                                        HorizontalOptions="EndAndExpand"
                                        HorizontalTextAlignment="End"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding SelectedFrequencyName}" />
                                </Grid>

                            </StackLayout>
                        </Border>

                        <!--  Summary Attachments  -->


                        <Border
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
