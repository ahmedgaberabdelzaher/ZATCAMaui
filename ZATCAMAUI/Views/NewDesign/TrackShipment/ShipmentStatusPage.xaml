<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TrackShipment.ShipmentStatusPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">


    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <Label
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ShipmentStatus}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <Border
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="20">

                        <!--  Title  -->
                        <StackLayout Margin="0,30,0,0" Orientation="Horizontal">

                            <!--  Select Shipment Type Label  -->
                            <Label
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="24"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.ShipmentStatus}"
                                TextColor="{StaticResource Primary}" />

                            <!--  Shipment icon  -->
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="30"
                                HorizontalOptions="EndAndExpand"
                                Source="{Binding DrawShipmentTrack.ShipmentCardImage}"
                                WidthRequest="40" />

                        </StackLayout>

                        <StackLayout
                            BindableLayout.EmptyView="{x:Static ResourceManager:AppResources.DeclarationDisclaimer}"
                            BindableLayout.ItemsSource="{Binding ShipmentStatusList}"
                            Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>

                                    <Grid
                                        ColumnDefinitions="Auto,Auto"
                                        ColumnSpacing="15"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="0">

                                        <!--  Circle button 1  -->
                                        <Image
                                            Aspect="AspectFit"
                                            HorizontalOptions="Start"
                                            InputTransparent="True"
                                            Source="{Binding StatusImage}"
                                            VerticalOptions="Start" />

                                        <!--  Vertical Line  -->
                                        <BoxView
                                            Grid.Row="1"
                                            BackgroundColor="#0996D4"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding HasVerticalLine}"
                                            VerticalOptions="Fill"
                                            WidthRequest="1" />

                                        <!--  Date Label  -->
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="14"
                                            HorizontalOptions="Start"
                                            Text="{Binding ShipmentStatusDateString}"
                                            TextColor="#565655"
                                            VerticalOptions="Start" />

                                        <!--  Status Label  -->
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="16"
                                            HorizontalOptions="Start"
                                            LineBreakMode="WordWrap"
                                            Text="{Binding ShipmentStatusValue}"
                                            TextColor="#002447"
                                            VerticalOptions="Start" />

                                    </Grid>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>

                        <!--#region Frame Declaration Values-->
                        <Border
                            Padding="15"
                            Stroke="#EBEBEB"
                            StrokeShape="RoundRectangle 14,14,14,14"
                            Style="{StaticResource CommonTopCurves}">

                            <!--  Frame Content  -->
                            <StackLayout HorizontalOptions="FillAndExpand">

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal" Spacing="0">

                                    <!--  Declaration/Bill Label  -->
                                    <Label
                                        Padding="10"
                                        FontSize="20"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{Binding StatusTitle}"
                                        TextColor="#002447"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    Margin="0,0,0,10"
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="1"
                                    HorizontalOptions="FillAndExpand" />

                               <!--#region Declaration/Bill Number Values -->
                               <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                        RowSpacing="10"
                                        ColumnDefinitions="2*,*">

                                    <!-- DeclarationNumber Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="0"
                                        LineBreakMode="WordWrap"
                                        IsVisible="{Binding IsExpressShipment}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.DeclarationNumber}"
                                        VerticalOptions="Start" />

                                    <!--  DeclarationNumber value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Row="0"
                                        IsVisible="{Binding IsExpressShipment}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding TrackShipmentResponse.declarationNumber}"
                                        VerticalOptions="Start" />

                                    <!-- DeclarationDate Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="1"
                                        LineBreakMode="WordWrap"
                                        IsVisible="{Binding IsExpressShipment}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.DeclarationDate}"
                                        VerticalOptions="Start" />

                                    <!--  DeclarationDate value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Row="1"
                                        IsVisible="{Binding IsExpressShipment}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding TrackShipmentResponse.declarationDate}"
                                        VerticalOptions="Start" />

                                     <!-- CarrierCompany Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="2"
                                        LineBreakMode="WordWrap"
                                        IsVisible="{Binding IsExpressShipment}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.CarrierCompany}"
                                        VerticalOptions="Start" />

                                    <!--  CarrierCompany value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Row="2"
                                        IsVisible="{Binding IsExpressShipment}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding TrackShipmentResponse.carrierName}"
                                        VerticalOptions="Start" />

                                    <!--  CIF Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="3"
                                        Text="{x:Static ResourceManager:AppResources.CIFValue}"
                                        VerticalOptions="Start" >

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                    <!--  CIF value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="3"
                                        Text="{Binding TrackShipmentResponse.CIF,StringFormat='{0:n}'}"
                                        VerticalOptions="Start" >

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                     <!--  Custom Fees Label  -->
                                    <StackLayout Grid.Row="4"
                                                 Orientation="Horizontal"
                                                 Spacing="5">

                                        <Label
                                            HorizontalOptions="Start"
                                            FontSize="14"
                                            LineBreakMode="WordWrap"
                                            TextColor="#999999"
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            Text="{x:Static ResourceManager:AppResources.CustomsFees}"
                                            VerticalOptions="Start" />



                                        <Image Source="info"
                                               Aspect="AspectFit"
                                               ToolTipProperties.Text="{x:Static ResourceManager:AppResources.CustomFeesDisclaimer}"/>

                                        <StackLayout.Triggers>
                                            <DataTrigger TargetType="StackLayout"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </StackLayout.Triggers>

                                    </StackLayout>

                                    <!--  CustomsFees value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Text="{Binding TrackShipmentResponse.customs,StringFormat='{0:n}'}"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="4"
                                        VerticalOptions="Start">

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                    <!--  VAT Label  -->
                                    <StackLayout Orientation="Horizontal"
                                                 Spacing="5"
                                                 Grid.Row="5">

                                        <Label
                                            HorizontalOptions="Start"
                                            FontSize="14"
                                            LineBreakMode="WordWrap"
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            TextColor="#999999" 
                                            Text="{x:Static ResourceManager:AppResources.VATCertificates}"
                                            VerticalOptions="Start" />


                                        <Image Source="info"
                                           Aspect="AspectFit"
                                           ToolTipProperties.Text="{x:Static ResourceManager:AppResources.TrackVATDisclaimer}"/>

                                        <StackLayout.Triggers>
                                            <DataTrigger TargetType="StackLayout"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </StackLayout.Triggers>

                                    </StackLayout>
                                    
                                    <!--  VAT value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Grid.Row="5"
                                        Text="{Binding TrackShipmentResponse.VAT,StringFormat='{0:n}'}"
                                        VerticalOptions="Start" >
                                        
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="true"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                     <!--  VATDisclaimer Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="6"
                                        IsVisible="false"
                                        LineHeight="1"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.VATDisclaimer}"
                                        VerticalOptions="Start" >

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="true"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="true"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                    <!--  Other Fees Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="6"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999"
                                        Text="{x:Static ResourceManager:AppResources.OtherFees}"
                                        VerticalOptions="Start" >
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                    <!--  Other Fees Value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Grid.Row="6"
                                        Text="{Binding TrackShipmentResponse.others,StringFormat='{0:n}'}"
                                        VerticalOptions="Start" >

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                    <!--  excisetax Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="7"
                                        IsVisible="{Binding HasExciseTax}"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999"
                                        Text="{x:Static ResourceManager:AppResources.ExciseTax2}"
                                        VerticalOptions="Start" >

                                         <Label.Triggers>

                                            <DataTrigger TargetType="Label"
                                                            Value="True"
                                                            Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                         </Label.Triggers>

                                    </Label>

                                    <!--  excisetax Value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        IsVisible="{Binding HasExciseTax}"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Grid.Row="7"
                                        Text="{Binding TrackShipmentResponse.excisetax,StringFormat='{0:n}'}"
                                        VerticalOptions="Start" >

                                         <Label.Triggers>

                                            <DataTrigger TargetType="Label"
                                                            Value="True"
                                                            Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                         </Label.Triggers>

                                    </Label>

                                    <!-- TotalFees Label  -->
                                    <StackLayout Grid.Row="8"
                                                 Orientation="Horizontal"
                                                 Spacing="5">

                                        <Label
                                            HorizontalOptions="Start"
                                            FontSize="14"
                                            LineBreakMode="WordWrap"
                                            FontFamily="{StaticResource SomarSemiBold}"
                                            TextColor="#999999" 
                                            Text="{x:Static ResourceManager:AppResources.TotalFees}"
                                            VerticalOptions="Start"/>



                                        <Image Source="info"
                                               Aspect="AspectFit"
                                               ToolTipProperties.Text="{x:Static ResourceManager:AppResources.TrackTotalDisclaimer}"/>

                                        <StackLayout.Triggers>
                                            <DataTrigger TargetType="StackLayout"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </StackLayout.Triggers>
                                    </StackLayout>

                                    <!--  TotalFees value Label  -->
                                    <Label
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Row="8"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding TrackShipmentResponse.totalFees,StringFormat='{0:n}'}"
                                        VerticalOptions="Start" >

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Value="True"
                                                         Binding="{Binding TrackShipmentResponse.isCombined}">

                                                <Setter Property="IsVisible" Value="false"/>
                                            </DataTrigger>

                                        </Label.Triggers>

                                    </Label>

                                </Grid>
                                <!--#endregion Declaration/Bill Number Values-->

                            </StackLayout>

                        </Border>
                        <!--#endregion Frame Declaration Values-->

                        <!--  Back To home Button  -->
                        <buttons:SfButton
                            Margin="0,15"
                            Command="{Binding BackToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.BackToHome}"
                            VerticalOptions="EndAndExpand" />

                    </StackLayout>

                </ScrollView>

            </Border>
            <!--#endregion Body-->

        </Grid>



    </ContentPage.Content>
</ContentPage>

