<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ZATCAMAUI.Views.NewDesign.TrackShipment.ShipmentTrackingTypesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>-->

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ShipmentTracking}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="30">

                        <!--  Select Shipment Type Label  -->
                        <Label
                            Margin="0,30,0,0"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.SelectShipmentType}"
                            TextColor="{StaticResource Primary}" />


                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="20"
                            RowDefinitions="*,*,*"
                            RowSpacing="20">

                            <!--  Express Card  -->
                            <Grid
                                Padding="0"
                                HeightRequest="110"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background image selected  -->
                                <Image Aspect="Fill" Source="UnselectedCard.png" />

                                <StackLayout
                                    Margin="15,10"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="15"
                                    VerticalOptions="EndAndExpand">

                                    <!--  Express icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        HorizontalOptions="StartAndExpand"
                                        Source="expressBlue.png"
                                        WidthRequest="40" />

                                    <!--  Express Label  -->
                                    <custom:CustomLabel
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.ExpressShipping}"
                                        TextColor="#002447" />

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}" CommandParameter="5" />
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--  Air Card  -->
                            <Grid
                                Grid.Column="1"
                                Padding="0"
                                HeightRequest="110"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background image selected  -->
                                <Image Aspect="Fill" Source="UnselectedCard.png" />

                                <StackLayout
                                    Margin="15,10"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="15"
                                    VerticalOptions="EndAndExpand">

                                    <!--  Air Freight icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        HorizontalOptions="StartAndExpand"
                                        Source="airBlue.png"
                                        WidthRequest="40" />

                                    <!--  Air Freight Label  -->
                                    <custom:CustomLabel
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.AirFreight}"
                                        TextColor="#002447" />

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}" CommandParameter="4" />
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--  Sea Card  -->
                            <Grid
                                Grid.Row="1"
                                Padding="0"
                                HeightRequest="110"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background image selected  -->
                                <Image Aspect="Fill" Source="UnselectedCard.png" />

                                <StackLayout
                                    Margin="15,10"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="15"
                                    VerticalOptions="EndAndExpand">

                                    <!--  Sea Freight icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        HorizontalOptions="StartAndExpand"
                                        Source="seaBlue.png"
                                        WidthRequest="40" />

                                    <!--  Sea Freight Label  -->
                                    <custom:CustomLabel
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.SeaFreight}"
                                        TextColor="#002447" />

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}" CommandParameter="1" />
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--  Land Card  -->
                            <Grid
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="0"
                                HeightRequest="110"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background image selected  -->
                                <Image Aspect="Fill" Source="UnselectedCard.png" />

                                <StackLayout
                                    Margin="15,10"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="15"
                                    VerticalOptions="EndAndExpand">

                                    <!--  Sea Freight icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        HorizontalOptions="StartAndExpand"
                                        Source="landBlue.png"
                                        WidthRequest="40" />

                                    <!--  Sea Freight Label  -->
                                    <custom:CustomLabel
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.LandFreight}"
                                        TextColor="#002447" />

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}" CommandParameter="3" />
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--  Train Card  -->
                            <Grid
                                Grid.Row="2"
                                Padding="0"
                                HeightRequest="110"
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="StartAndExpand"
                                WidthRequest="171">

                                <!--  Background image selected  -->
                                <Image Aspect="Fill" Source="UnselectedCard.png" />

                                <StackLayout
                                    Margin="15,10"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="15"
                                    VerticalOptions="EndAndExpand">

                                    <!--  Train Freight icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="30"
                                        HorizontalOptions="StartAndExpand"
                                        Source="trainBlue.png"
                                        WidthRequest="40" />

                                    <!--  Train Freight Label  -->
                                    <custom:CustomLabel
                                        FontSize="16"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.TrainFreight}"
                                        TextColor="#002447" />

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}" CommandParameter="2" />
                                </Grid.GestureRecognizers>

                            </Grid>

                        </Grid>

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

        </Grid>

    </ContentPage.Content>
</ContentPage>

