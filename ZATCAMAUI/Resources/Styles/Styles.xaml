            HorizontalOptions="End"
            Orientation="Horizontal"
            Spacing="8"
            VerticalOptions="Center">
            <!--  Filter Button  -->
            <buttons:SfButton
                Margin="0"
                Padding="0"
                Command="{Binding FilterCommand}"
                CornerRadius="4"
                HeightRequest="32"
                Style="{StaticResource SfButtonStyle}">
                <!--<buttons:SfButton.Content>
                    <StackLayout
                        Padding="8,5,8,6"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalOptions="Center">
                        <Label
                            FontFamily="{StaticResource FontIcons}"
                            FontSize="14"
                            Style="{StaticResource OptionButtonLabelStyle}"
                            Text="{StaticResource Filter}"
                            VerticalTextAlignment="End" />
                        <Label
                            FontFamily="{StaticResource GE_SS_Two-SemiBold}"
                            Style="{StaticResource OptionButtonLabelStyle}"
                            Text="Filter"
                            VerticalTextAlignment="Center" />
                    </StackLayout>
                </buttons:SfButton.Content>-->
            </buttons:SfButton>
            <!--  Sort Button  -->
            <buttons:SfButton
                Command="{Binding SortCommand}"
                CornerRadius="4"
                Style="{StaticResource SfButtonStyle}">
                <!--<buttons:SfButton.Content>
                    <StackLayout
                        Padding="8,5,8,6"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Label
                            FontFamily="{StaticResource FontIcons}"
                            FontSize="18"
                            Style="{StaticResource OptionButtonLabelStyle}"
                            Text="{StaticResource Sort}"
                            VerticalTextAlignment="End" />
                        <Label
                            FontFamily="{StaticResource GE_SS_Two-SemiBold}"
                            Style="{StaticResource OptionButtonLabelStyle}"
                            Text="Sorting" />
                    </StackLayout>
                </buttons:SfButton.Content>-->
            </buttons:SfButton>
        </StackLayout>
    </DataTemplate>
    <!--  Common style for SfButtons  -->
    <Style x:Key="SfButtonStyle2" TargetType="buttons:SfButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Gray-700}" />
        <Setter Property="FontFamily" Value="{StaticResource GAZT_FONT_REGULAR}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <!--  Common style for option labels  -->
    <Style
        x:Key="OptionButtonLabelStyle"
        BasedOn="{StaticResource LabelStyle}"
        TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
