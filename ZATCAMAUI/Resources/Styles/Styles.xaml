    <!--  Common style for various Lables  -->
    <Style x:Key="GAZT_Font_Small_Bold_Label_CenterAligned_Style" TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="LineHeight" Value="{OnPlatform Android=1.25, Default=-1}" />
        <Setter Property="FontSize" Value="Small" />
        <Setter Property="FontFamily" Value="{DynamicResource GAZT_FONT_BOLD}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="GAZT_Font_Medium_Bold_Label_CenterAligned_Style" TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="LineHeight" Value="{OnPlatform Android=1.25, Default=-1}" />
