        <Setter Property="LineHeight" Value="{OnPlatform Android=1.25, Default=-1}" />
        <Setter Property="FontSize" Value="Micro" />
        <Setter Property="FontFamily" Value="{DynamicResource GAZT_FONT_REGULAR}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <!--  Common style for rounded buttons  -->
    <Style
        x:Key="RoundButtonStyle"
        BasedOn="{StaticResource SfButtonStyle}"
        TargetType="buttons:SfButton">
        <Setter Property="Stroke" Value="{DynamicResource Gray-300}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush>
                    <GradientStop Offset="0" Color="{DynamicResource PrimaryColor}" />
                    <GradientStop Offset="1" Color="{DynamicResource PrimaryGradient}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LabelStyleCardView" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource GAZT_FONT_BOLD}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource Gray-900}" />
        <Setter Property="LineHeight" Value="{OnPlatform Default=1.25, iOS=-1}" />
    </Style>

    <Style x:Key="CommonTopCurves" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 15,15,0,0" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Padding" Value="20,20,20,20" />
    </Style>


    <Style x:Key="LabelStyle1" TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
