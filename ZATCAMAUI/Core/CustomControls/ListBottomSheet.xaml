<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.ListBottomSheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:converter="clr-namespace:ZATCAMAUI.Core.Converters"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    x:Name="page"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ContentView.Resources>

        <converter:RemoveLastLineConverter x:Key="RemoveLastLineConverter" />

    </ContentView.Resources>
    <ContentView.Content>

        <!--  List of names inside frame  -->
        <Border Padding="20" Style="{StaticResource CommonTopCurves}">

            <Grid Padding="10" RowDefinitions="auto,*">

                <!--  Search Entry  -->
                <custom:CustomSfTextInputView>
                    <custom:CustomSfTextInputView.TextInputView>
                        <custom:GAZTBorderlessEntry
                            x:Name="searchEntry"
                            Keyboard="Text"
                            Placeholder="{x:Static ResourceManager:AppResources.ZSearch}"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding SearchText}"
                            TextColor="#002447">

                            <custom:GAZTBorderlessEntry.Behaviors>
                                <xct:EventToCommandBehavior
                                    Command="{Binding SearchEntryCommand}"
                                    CommandParameter="{Binding Source={x:Reference searchEntry}}"
                                    EventName="TextChanged" />
                            </custom:GAZTBorderlessEntry.Behaviors>

                        </custom:GAZTBorderlessEntry>

                    </custom:CustomSfTextInputView.TextInputView>

                    <inputLayout:SfTextInputLayout.LeadingView>
                        <Image Aspect="AspectFit" Source="reportSearchBar.png" />
                    </inputLayout:SfTextInputLayout.LeadingView>

                </custom:CustomSfTextInputView>

                <Grid
                    x:Name="itemList"
                    Grid.Row="1"
                    ColumnDefinitions="*"
                    RowDefinitions="*">

                    <CollectionView CollectionView.ItemsSource="{Binding BottomSheetList}" VerticalScrollBarVisibility="Never">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout VerticalItemSpacing="10" Orientation="Vertical"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <StackLayout x:Name="selectedItem"
                                             FlowDirection="{Binding Source={x:Reference page}, Path=FlowDirection}">
                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="18"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Name}"
                                        TextColor="#002447">

                                        <!--  Name  -->
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference itemList}, Path=BindingContext}"
                                                Command="{Binding SelectedBottomItemCommand}"
                                                CommandParameter="{Binding Source={x:Reference selectedItem}, Path=BindingContext}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!--  Horizontal Line  -->
                                    <BoxView
                                        Margin="0,10,0,0"
                                        BackgroundColor="{StaticResource NeutralLightGrey}"
                                        HeightRequest="1"
                                        IsVisible="{Binding HasLine, Converter={StaticResource RemoveLastLineConverter}, ConverterParameter={x:Reference itemList}}"
                                        VerticalOptions="Center"
                                        WidthRequest="350" />

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            BindingContext="{Binding Source={x:Reference itemList}, Path=BindingContext}"
                                            Command="{Binding SelectedBottomItemCommand}"
                                            CommandParameter="{Binding Source={x:Reference selectedItem}, Path=BindingContext}" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>
            </Grid>


        </Border>

    </ContentView.Content>
</ContentView>