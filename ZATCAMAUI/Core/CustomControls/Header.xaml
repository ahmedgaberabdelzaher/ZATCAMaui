<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.Header"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid Padding="15,15" ColumnDefinitions="10*,80*,10*">
        <StackLayout Grid.Column="0">
            <Image
                x:Name="backbutton"
                HorizontalOptions="Start"
                Rotation="180"
                Source="arrowLeftwhite.png"
                VerticalOptions="CenterAndExpand">
                <Image.Triggers>
                    <DataTrigger
                        Binding="{Binding AppDirection}"
                        TargetType="Image"
                        Value="LeftToRight">
                        <Setter Property="Rotation" Value="0" />
                    </DataTrigger>
                </Image.Triggers>
            </Image>
            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BackCommand}" />
            </StackLayout.GestureRecognizers>
        </StackLayout>
        <Label
            x:Name="titleTxt"
            Grid.Column="1"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            LineHeight="0.9"
            Style="{StaticResource SectionTitleWhiteBold}"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
