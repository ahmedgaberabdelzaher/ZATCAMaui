<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class=" ZATCAMAUI.Core.CustomControls.ServiceMenuControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <Style TargetType="Frame">
                    <Setter Property="CornerRadius" Value="15" />
                    <Setter Property="BorderColor" Value="#DDDDDD" />
                    <Setter Property="Padding" Value="15" />
                </Style>
                <Style TargetType="Image">
                    <Setter Property="HeightRequest" Value="41" />
                    <Setter Property="WidthRequest" Value="32" />
                    <Setter Property="HorizontalOptions" Value="CenterAndExpand" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid RowDefinitions="auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <Label
                    Grid.Column="0"
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="20"
                    HorizontalOptions="StartAndExpand"
                    Text="{x:Static ResourceManager:AppResources.Viewservices}"
                    TextColor="{StaticResource Primary}" />
                <StackLayout
                    Grid.Column="1"
                    Spacing="10"
                    HorizontalOptions="EndAndExpand"
                    Orientation="Horizontal">
                    <Image
                        HeightRequest="20"
                        Source="LstViewIcon"
                        WidthRequest="20">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding ItemCountPerRow}"
                                TargetType="Image"
                                Value="1">
                                <Setter Property="Source" Value="LstViewIconSelected" />
                            </DataTrigger>
                        </Image.Triggers>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="1" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        HeightRequest="20"
                        Source="GridViewIcon"
                        WidthRequest="20">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding ItemCountPerRow}"
                                TargetType="Image"
                                Value="1">
                                <Setter Property="Source" Value="GridViewIconNotSelected" />
                            </DataTrigger>
                        </Image.Triggers>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="2" />
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

            </Grid>

            <CollectionView
                x:Name="menu"
                Grid.Row="1"
                Margin="0,18,0,0"
                ItemSizingStrategy="MeasureFirstItem"
                ItemsSource="{Binding CustomeMenuLst}">

                <CollectionView.ItemsLayout>
                   <GridItemsLayout Orientation="Vertical"
                                    Span="2"
                                    VerticalItemSpacing="10"
                                    HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.Triggers>
                    <DataTrigger
                        Binding="{Binding ItemCountPerRow}"
                        TargetType="CollectionView"
                        Value="1">
                        <Setter Property="ItemsLayout" >

                            <GridItemsLayout Orientation="Vertical"
                                              VerticalItemSpacing="10"/>
                        </Setter>
                    </DataTrigger>
                </CollectionView.Triggers>


                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame
                            x:Name="Item"
                            HasShadow="False"
                            Grid.Row="{Binding Row}"
                            Grid.Column="{Binding ColumnNo}"
                            Margin="0,0,10,10"
                            Padding="10,0">
                            <Frame.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsVerticalView}"
                                    TargetType="Frame"
                                    Value="False">
                                    <Setter Property="Padding" Value="10,20,10,10" />
                                </DataTrigger>
                            </Frame.Triggers>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    BindingContext="{Binding Source={x:Reference menu}, Path=BindingContext}"
                                    Command="{Binding NavigateToServiceCommand}"
                                    CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                            </Frame.GestureRecognizers>
                            <StackLayout Margin="5"
                                         Spacing="0">
                                <StackLayout.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsVerticalView}"
                                        TargetType="StackLayout"
                                        Value="true">
                                        <Setter Property="Orientation" Value="Horizontal" />
                                        <Setter Property="Spacing" Value="5" />
                                    </DataTrigger>
                                </StackLayout.Triggers>
                                <Image
                                    Margin="0,5,0,0"
                                    HeightRequest="37"
                                    HorizontalOptions="Center"
                                    Source="{Binding ImageSource}"
                                    VerticalOptions="Start"
                                    WidthRequest="29" />
                                <StackLayout>
                                    <Label
                                        Margin="0,5,0,5"
                                        HorizontalOptions="Center"
                                        Text="{Binding Name}"
                                        
                                        VerticalOptions="Start">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsVerticalView}"
                                                TargetType="Label"
                                                Value="true">
                                                <Setter Property="HorizontalOptions" Value="StartAndExpand" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="10"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding ServiceDesc}">

                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsVerticalView}"
                                                TargetType="Label"
                                                Value="true">
                                                <Setter Property="HorizontalOptions" Value="StartAndExpand" />
                                                <Setter Property="VerticalOptions" Value="FillAndExpand" />
                                            </DataTrigger>
                                        </Label.Triggers>

                                    </Label>
                                </StackLayout>
                            </StackLayout>
                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentView>
