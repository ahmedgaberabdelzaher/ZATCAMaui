<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class=" ZATCAMAUI.Core.CustomControls.ServiceMenuControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <Style TargetType="Border">
                    <Setter Property="StrokeShape" Value="RoundRectangle 15,15,15,15" />
                    <Setter Property="Stroke" Value="#DDDDDD" />
                    <Setter Property="Padding" Value="15" />
                </Style>
                <Style TargetType="Image">
                    <Setter Property="HeightRequest" Value="41" />
                    <Setter Property="WidthRequest" Value="32" />
                    <Setter Property="HorizontalOptions" Value="CenterAndExpand" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid RowDefinitions="auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <Label
                    Grid.Column="0"
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="20"
                    HorizontalOptions="StartAndExpand"
                    Text="{x:Static ResourceManager:AppResources.Viewservices}"
                    TextColor="{StaticResource Primary}" />
                <StackLayout
                    Grid.Column="1"
                    HorizontalOptions="EndAndExpand"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        HeightRequest="20"
                        Source="LstViewIcon"
                        WidthRequest="20">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding ItemCountPerRow}"
                                TargetType="Image"
                                Value="1">
                                <Setter Property="Source" Value="LstViewIconSelected" />
                            </DataTrigger>
                        </Image.Triggers>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="1" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        HeightRequest="20"
                        Source="GridViewIcon"
                        WidthRequest="20">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding ItemCountPerRow}"
                                TargetType="Image"
                                Value="1">
                                <Setter Property="Source" Value="GridViewIconNotSelected" />
                            </DataTrigger>
                        </Image.Triggers>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeViewCommand}" CommandParameter="2" />
                        </Image.GestureRecognizers>
                    </Image>
                </StackLayout>

            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <Grid
                        x:Name="menu"
                        Margin="0,18,0,0"
                        BindableLayout.ItemsSource="{Binding CustomeMenuLst}"
                        ColumnDefinitions="*,*"
                        RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto">

                        <Grid.Triggers>
                            <DataTrigger
                                Binding="{Binding ItemCountPerRow}"
                                TargetType="Grid"
                                Value="1">
                                <Setter Property="ColumnDefinitions" Value="*" />
                            </DataTrigger>
                        </Grid.Triggers>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    x:Name="Item"
                                    Grid.Row="{Binding Row}"
                                    Grid.Column="{Binding ColumnNo}"
                                    Margin="10,10,10,10"
                                    Padding="10,0"
                                    Stroke="{StaticResource NeutralGreay}"
                                    StrokeShape="RoundRectangle 10,10,10,10">

                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsVerticalView}"
                                            TargetType="Border"
                                            Value="False">
                                            <Setter Property="Padding" Value="0,20,0,20" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            BindingContext="{Binding Source={x:Reference menu}, Path=BindingContext}"
                                            Command="{Binding NavigateToServiceCommand}"
                                            CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                    </Border.GestureRecognizers>

                                    <Grid
                                        Margin="5"
                                        ColumnDefinitions="auto,*"
                                        ColumnSpacing="10"
                                        RowDefinitions="auto,auto"
                                        RowSpacing="10">

                                        <Grid.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsVerticalView}"
                                                TargetType="Grid"
                                                Value="False">
                                                <Setter Property="ColumnDefinitions" Value="*" />
                                                <Setter Property="RowDefinitions" Value="*,*" />
                                                <Setter Property="RowSpacing" Value="30" />
                                                <Setter Property="ColumnSpacing" Value="20" />
                                            </DataTrigger>

                                        </Grid.Triggers>

                                        <Image
                                            Grid.RowSpan="2"
                                            Margin="0,10,0,0"
                                            HeightRequest="40"
                                            HorizontalOptions="Center"
                                            Source="{Binding ImageSource}"
                                            VerticalOptions="Start"
                                            WidthRequest="40" />




                                        <StackLayout Grid.Column="1">

                                            <StackLayout.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsVerticalView}"
                                                    TargetType="StackLayout"
                                                    Value="False">
                                                    <Setter Property="Grid.Row" Value="1" />
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="VerticalOptions" Value="EndAndExpand" />
                                                </DataTrigger>

                                            </StackLayout.Triggers>

                                            <Label
                                                Margin="0,5,0,5"
                                                HorizontalOptions="Center"
                                                Text="{Binding Name}"
                                                VerticalOptions="Start">

                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsVerticalView}"
                                                        TargetType="Label"
                                                        Value="true">
                                                        <Setter Property="HorizontalOptions" Value="StartAndExpand" />
                                                    </DataTrigger>
                                                </Label.Triggers>

                                            </Label>

                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="10"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding ServiceDesc}" />

                                        </StackLayout>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </Grid>

                </ScrollView>

            </Grid>



        </Grid>
    </Grid>
</ContentView>
