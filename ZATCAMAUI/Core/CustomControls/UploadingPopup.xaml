<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Controls.UploadingPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls">


    <Mopups:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <Border
            Padding="0"
            BackgroundColor="White"
            HeightRequest="200"
            StrokeShape="RoundRectangle 15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <!--  Image Border  -->
                <Border
                    Stroke="#BCBCBB"
                    StrokeShape="RoundRectangle 25,25,25,25"
                    Style="{StaticResource CommonTopCurves}">

                    <StackLayout Spacing="10">

                        <!--  Image Icon  -->
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            Source="imageFile.png"
                            VerticalOptions="Start"
                            WidthRequest="30" />

                        <!--  UploadImage Label  -->
                        <Label
                            FontSize="25"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.UploadImage}"
                            VerticalOptions="Center" />




                    </StackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectedUploadLabelCommand}" CommandParameter="image" />

                    </Border.GestureRecognizers>
                </Border>


                <!--  File Border  -->
                <Border
                    Grid.Column="1"
                    Stroke="#BCBCBB"
                    StrokeShape="RoundRectangle 25,25,25,25"
                    Style="{StaticResource CommonTopCurves}">

                    <StackLayout Spacing="10">

                        <!--  File Icon  -->
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            Source="fileUpload.png"
                            VerticalOptions="Start"
                            WidthRequest="30" />

                        <!--  UploadFile Label  -->
                        <Label
                            FontSize="25"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.UploadFile}"
                            VerticalOptions="Start" />

                    </StackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectedUploadLabelCommand}" CommandParameter="file" />

                    </Border.GestureRecognizers>
                </Border>

            </Grid>

        </Border>

    </Grid>
</Mopups:PopupPage>

