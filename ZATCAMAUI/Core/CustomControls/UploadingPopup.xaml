<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="ZATCAMAUI.Controls.UploadingPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:animations="clr-namespace:RGPopup.Maui.Animations;assembly=RGPopup.Maui"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:pages="clr-namespace:RGPopup.Maui.Pages;assembly=RGPopup.Maui"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat">

    <!--<pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>-->

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="200"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <!--  Image Frame  -->
                <Frame
                    BorderColor="#BCBCBB"
                    CornerRadius="25"
                    Style="{StaticResource CommonTopCurves}">

                    <StackLayout Spacing="10">

                        <!--  Image Icon  -->
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            Source="imageFile.png"
                            VerticalOptions="Start"
                            WidthRequest="30" />

                        <!--  UploadImage Label  -->
                        <custom:CustomLabel
                            FontSize="25"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.UploadImage}"
                            VerticalOptions="Center" />




                    </StackLayout>

                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectedUploadLabelCommand}" CommandParameter="image" />

                    </Frame.GestureRecognizers>
                </Frame>


                <!--  File Frame  -->
                <Frame
                    Grid.Column="1"
                    BorderColor="#BCBCBB"
                    CornerRadius="25"
                    Style="{StaticResource CommonTopCurves}">

                    <StackLayout Spacing="10">

                        <!--  File Icon  -->
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            Source="fileUpload.png"
                            VerticalOptions="Start"
                            WidthRequest="30" />

                        <!--  UploadFile Label  -->
                        <custom:CustomLabel
                            FontSize="25"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.UploadFile}"
                            VerticalOptions="Start" />

                    </StackLayout>

                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectedUploadLabelCommand}" CommandParameter="file" />

                    </Frame.GestureRecognizers>
                </Frame>

            </Grid>

        </yummy:PancakeView>

    </Grid>
</pages:PopupPage>

