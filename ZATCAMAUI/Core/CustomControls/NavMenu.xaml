<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.NavMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:yummy="clr-namespace:PancakeViewCompat;assembly=PancakeViewCompat">
    <!--<ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentView.Resources>-->
    <ContentView.Content>
        <yummy:PancakeView
            BackgroundColor="#002447"
            CornerRadius="15,15,0,0"
            VerticalOptions="EndAndExpand">
            <yummy:PancakeView.Resources>
                <ResourceDictionary>
                    <Style TargetType="Label">
                        <Setter Property="HorizontalOptions" Value="CenterAndExpand" />
                        <Setter Property="TextColor" Value="#FFFFFF" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                    <Style TargetType="Image">
                        <Setter Property="HeightRequest" Value="23" />
                        <Setter Property="HorizontalOptions" Value="CenterAndExpand" />
                        <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                    </Style>
                </ResourceDictionary>
            </yummy:PancakeView.Resources>
            <Grid
                x:Name="menu"
                Padding="10,0,10,0"
                BindableLayout.ItemsSource="{Binding AfterLoginMenuLst}"
                ColumnDefinitions="*"
                RowDefinitions="65">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>

                        <Grid
                            x:Name="Item"
                            Grid.Column="{Binding ColumnNo}"
                            RowDefinitions="auto,23,*">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    BindingContext="{Binding Source={x:Reference menu}, Path=BindingContext}"
                                    Command="{Binding MenuNavigationCommand}"
                                    CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                            </Grid.GestureRecognizers>
                            <Image
                                Grid.Row="0"
                                HeightRequest="5"
                                VerticalOptions="StartAndExpand">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Image"
                                        Value="true">
                                        <Setter Property="Source" Value="Rectangle" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Image
                                Grid.Row="1"
                                Source="{Binding ImageSource}"
                                WidthRequest="25">
                                <Image.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Image"
                                        Value="true">
                                        <Setter Property="Source" Value="{Binding SelectedImageSource}" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Label
                                Grid.Row="2"
                                HorizontalOptions="CenterAndExpand"
                                Text="{Binding Name}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Label"
                                        Value="true">
                                        <Setter Property="TextColor" Value="{StaticResource SelectedMenuColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>
        </yummy:PancakeView>
    </ContentView.Content>
</ContentView>

