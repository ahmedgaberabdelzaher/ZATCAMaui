<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.MsgView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:yummy="clr-namespace:Maui.PancakeView;assembly=PancakeViewCompat">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid
        Grid.Row="0"
        Margin="0,0,0,0"
        VerticalOptions="FillAndExpand">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}" />
        </Grid.GestureRecognizers>

        <StackLayout
            BackgroundColor="Black"
            Opacity="0.4"
            VerticalOptions="FillAndExpand" />

        <yummy:PancakeView
            Padding="20,20,20,10"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <StackLayout Margin="0" VerticalOptions="Center">

                <Label
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{Binding MessageTxt}" />

                <buttons:SfButton
                    Margin="0,0,0,10"
                    Command="{Binding CloseMsgViewCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                    VerticalOptions="CenterAndExpand" />

            </StackLayout>

        </yummy:PancakeView>

    </Grid>
</ContentView>

