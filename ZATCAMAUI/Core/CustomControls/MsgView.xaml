<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.MsgView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    BackgroundColor="#88000000"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid
        Grid.RowSpan="2"
        Margin="0"
        VerticalOptions="FillAndExpand">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}" />
        </Grid.GestureRecognizers>

        <StackLayout
            BackgroundColor="Transparent"
            Opacity="0.4"
            VerticalOptions="FillAndExpand" />

        <Border
            Margin="0"
            Padding="0"
            Background="White"
            HorizontalOptions="Fill"
            Stroke="#EBEBEB"
            StrokeShape="RoundRectangle 15,15,0,0"
            StrokeThickness="1.5"
            VerticalOptions="EndAndExpand">

            <StackLayout
                Padding="20,10"
                HorizontalOptions="FillAndExpand"
                Spacing="15"
                VerticalOptions="FillAndExpand">

                <Label
                    HorizontalOptions="Fill"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{Binding MessageTxt}" />

                <buttons:SfButton
                    Command="{Binding CloseMsgViewCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                    VerticalOptions="EndAndExpand" />

            </StackLayout>

        </Border>

    </Grid>

</ContentView>

