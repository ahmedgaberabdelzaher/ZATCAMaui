<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.MsgView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\Views\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

     <Grid
        Grid.RowSpan="2"
        Margin="0"
        VerticalOptions="FillAndExpand">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}" />
        </Grid.GestureRecognizers>

        <StackLayout
            BackgroundColor="Black"
            Opacity="0.4"
            VerticalOptions="FillAndExpand" />

        <Border
            Padding="0"
            Margin="0"
            Stroke="White"
            Background="White"
            HorizontalOptions="Fill"
            StrokeShape="RoundRectangle 15,15,0,0"
            VerticalOptions="EndAndExpand">

            <StackLayout Padding="20,10"
                         Spacing="15"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="FillAndExpand">

                <Label
                    HorizontalOptions="StartAndExpand"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource BodyLabelBlack}"
                   Text="{Binding MessageTxt}"  />

                <buttons:SfButton
                    Command="{Binding CloseMsgViewCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                    VerticalOptions="EndAndExpand" />

            </StackLayout>

        </Border>

    </Grid>

</ContentView>

