<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.OTP6Digit"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:behaviour="clr-namespace:ZATCAMAUI.Core.Behaviors"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SomarBold}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid
        Grid.Row="0"
        Margin="28,18,32,39"
        IsVisible="{Binding IsOTPView}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <StackLayout>
                <Label Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.VerificationCode}" />
                <Label
                    Padding="0,0,0,16"
                    Style="{StaticResource BodyLabelGrey}"
                    Text="{x:Static ResourceManager:AppResources.EnterVerificationCodeSentToMobile}" />
                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />

                <StackLayout Padding="0,15,0,0">
                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyLabelGrey}"
                        Text="{Binding OTPSentOnThisMobileNumber}" />

                    <Grid Margin="0,-10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Row="0"
                            Padding="30,20,30,20"
                            ColumnSpacing="20"
                            FlowDirection="LeftToRight">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <Style TargetType="custom:GAZTBorderlessEntry">
                                        <Setter Property="Keyboard" Value="Numeric" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                        <Setter Property="FontSize" Value="Small" />
                                        <Setter Property="WidthRequest" Value="8" />
                                        <Setter Property="HorizontalTextAlignment" Value="Center" />
                                        <Setter Property="ReturnType" Value="Next" />
                                        <Setter Property="MaxLength" Value="1" />
                                        <Setter Property="TextColor" Value="#bbbbbb" />
                                        <Setter Property="HorizontalOptions" Value="CenterAndExpand" />
                                        <Setter Property="IsPassword" Value="True" />

                                    </Style>
                                    <Style TargetType="inputLayout:SfTextInputLayout">
                                        <Setter Property="ContainerType" Value="Outlined" />
                                        <Setter Property="OutlineCornerRadius" Value="8" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        <!--<Setter Property="Padding" Value="0" />-->
                                        <Setter Property="Margin" Value="0" />


                                    </Style>
                                </ResourceDictionary>
                            </Grid.Resources>

                            <!--  First OTP Digit Start  -->
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Gray"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    Grid.Column="0"
                                    VerticalOptions="Start">

                                <custom:GAZTBorderlessEntry x:Name="OTPFirstEntry"
                                                          MaxLength="1"
                                                          Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                                          WidthRequest="100"
                                                          Text="{Binding OTPFirstDigit}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviour:OnlyNumericValuesBehaviour />
                                            <behaviour:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                            <xct:EventToCommandBehavior
                                                Command="{Binding GoToNextEntryCommand}"
                                                CommandParameter="{Binding Source={x:Reference OTPSecondEntry}}"
                                                EventName="TextChanged" />
                                        </custom:GAZTBorderlessEntry.Behaviors>

                                </custom:GAZTBorderlessEntry>
    
                            </Border>
                            <!--  First OTP Digit End  -->

                            <!--  Second OTP Digit Start  -->
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Gray"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    Grid.Column="1"
                                    VerticalOptions="Start">

                                <custom:GAZTBorderlessEntry
                                        x:Name="OTPSecondEntry"
                                        ClassId="2"
                                        MaxLength="1"
                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                        WidthRequest="100"
                                        Text="{Binding OTPSecondDigit}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviour:OnlyNumericValuesBehaviour />
                                            <behaviour:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                            <xct:EventToCommandBehavior
                                                Command="{Binding GoToNextEntryCommand}"
                                                CommandParameter="{Binding Source={x:Reference OTPThirdEntry}}"
                                                EventName="TextChanged" />

                                        </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
    
                            </Border>
                            <!--  Second OTP Digit End  -->

                            <!--  Third OTP Digit Start  -->
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Gray"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    Grid.Column="2"
                                    VerticalOptions="Start">

                                <custom:GAZTBorderlessEntry
                                        x:Name="OTPThirdEntry"
                                        ClassId="3"
                                        MaxLength="1"
                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                        WidthRequest="100"
                                        Text="{Binding OTPThirdDigit}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviour:OnlyNumericValuesBehaviour />
                                            <behaviour:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                            <xct:EventToCommandBehavior
                                                Command="{Binding GoToNextEntryCommand}"
                                                CommandParameter="{Binding Source={x:Reference OTPFourthEntry}}"
                                                EventName="TextChanged" />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
    
                            </Border>
                            <!--  Third OTP Digit End  -->


                            <!--  Fourth OTP Digit Start  -->
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Gray"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    Grid.Column="3"
                                    VerticalOptions="Start">

                                <custom:GAZTBorderlessEntry
                                        x:Name="OTPFourthEntry"
                                        ClassId="4"
                                        MaxLength="1"
                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                        WidthRequest="100"
                                        Text="{Binding OTPFourthDigit}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviour:OnlyNumericValuesBehaviour />
                                            <behaviour:EntryFocusBehaviour NextFocusElementName="OTPFifthEntry" />
                                            <xct:EventToCommandBehavior
                                                Command="{Binding GoToNextEntryCommand}"
                                                CommandParameter="{Binding Source={x:Reference OTPFifthEntry}}"
                                                EventName="TextChanged" />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
    
                            </Border>
                            <!--  Fourth OTP Digit End  -->


                            <!--  Fifth OTP Digit End  -->
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Gray"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    Grid.Column="4"
                                    VerticalOptions="Start">

                                <custom:GAZTBorderlessEntry
                                        x:Name="OTPFifthEntry"
                                        ClassId="5"
                                        MaxLength="1"
                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                        WidthRequest="100"
                                        Text="{Binding OTPFithDigit}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviour:OnlyNumericValuesBehaviour />
                                            <behaviour:EntryFocusBehaviour NextFocusElementName="OTPSixEntry" />
                                            <xct:EventToCommandBehavior
                                                Command="{Binding GoToNextEntryCommand}"
                                                CommandParameter="{Binding Source={x:Reference OTPSixEntry}}"
                                                EventName="TextChanged" />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
    
                            </Border>
                            <!--  Fifth OTP Digit End  -->

                            <!-- Sixth OTP Digit Start  -->
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Gray"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    Grid.Column="5"
                                    VerticalOptions="Start">

                                <custom:GAZTBorderlessEntry
                                        x:Name="OTPSixEntry"
                                        MaxLength="1"
                                        Keyboard="{OnPlatform Android=Numeric, iOS=Default}"
                                        WidthRequest="100"
                                        ClassId="6"
                                        Text="{Binding OTPSixDigit}">
                                        <custom:GAZTBorderlessEntry.Behaviors>
                                            <behaviour:OnlyNumericValuesBehaviour />
                                            <xct:EventToCommandBehavior Command="{Binding VerifyOTPCommand}" EventName="Completed" />
                                        </custom:GAZTBorderlessEntry.Behaviors>
                                </custom:GAZTBorderlessEntry>
    
                            </Border>
                            <!--  Sixth OTP Digit End  -->

                        </Grid>

                    </Grid>


                    <StackLayout
                        Margin="0,-15,0,0"
                        HorizontalOptions="Center"
                        Orientation="Horizontal">
                        <Image Source="clock" />
                        <Label
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{Binding LblCountDownTimer}"
                            VerticalOptions="Center" />
                    </StackLayout>
                    <buttons:SfButton
                        Margin="0,16,0,0"
                        Background="Transparent"
                        Command="{Binding ResendOtpCommand}"
                        IsVisible="{Binding IsResendCodeEnabled}"
                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                        TextColor="{Binding ResendOTPTextColor}"
                        VerticalOptions="EndAndExpand" />
                </StackLayout>



            </StackLayout>
        </ScrollView>

        <Grid
            Grid.Row="0"
            Padding="0,0,0,8"
            BackgroundColor="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                BackgroundColor="White">
                <Image
                    HorizontalOptions="Start"
                    Source="arrowLeft.png">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackFromOtpCommand}" NumberOfTapsRequired="1" />
                    </Image.GestureRecognizers>
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding IsArabicLang}"
                            TargetType="Image"
                            Value="True">
                            <Setter Property="Rotation" Value="180" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
            </StackLayout>
            <StackLayout
                Grid.Row="0"
                Grid.Column="1"
                BackgroundColor="White">
                <Image
                    HeightRequest="47"
                    Source="ic_logo_gazt.png"
                    WidthRequest="41" />
            </StackLayout>
            <StackLayout
                Grid.Row="0"
                Grid.Column="2"
                BackgroundColor="White">
                <Image HorizontalOptions="End" Source="close.png">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackFromOtpCommand}" NumberOfTapsRequired="1" />
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>
        </Grid>

        <buttons:SfButton
            x:Name="btn"
            Grid.Row="2"
            Command="{Binding VerifyOTPCommand}"
            Style="{StaticResource PrimaryButtonStyle}"
            Text="{x:Static ResourceManager:AppResources.Verify}" />
    </Grid>

</ContentView>

