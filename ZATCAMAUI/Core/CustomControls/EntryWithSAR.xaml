<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.EntryWithSAR"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    xmlns:custom="clr-namespace:ZATCAMAUI.Core.CustomControls"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:behaviors="clr-namespace:ZATCAMAUI.Core.Behaviors"
    x:Name="CustomEntryWithSAR">

    <StackLayout Margin="0,9,0,0" Style="{StaticResource SFTaxPayerProfile}">
        <Label x:Name="Title" Style="{StaticResource CaptionLabelGrey}" />
        <inputLayout:SfTextInputLayout
            ContainerType="Outlined"
            InputViewPadding="16,0,16,0"
            LeadingViewPosition="Inside"
            OutlineCornerRadius="15"
            ContainerBackground="White"
            Stroke="#999999"
            Hint="{Binding Source={x:Reference CustomEntryWithSAR}, Path=Placeholder}">

            <custom:GAZTBorderlessEntry
                x:Name="TextValue"
                Keyboard="Numeric"
                MaxLength="21"
                HorizontalOptions="Fill"
                BackgroundColor="Red"
                Placeholder="{Binding Source={x:Reference CustomEntryWithSAR}, Path=Placeholder}"
                Style="{StaticResource DefaultEntry}"
                Text="{Binding Source={x:Reference CustomEntryWithSAR}, Path=ValueText}"
                VerticalTextAlignment="Center" >
                <custom:GAZTBorderlessEntry.Behaviors>
                    <behaviors:NumericValidationBehavior />
                </custom:GAZTBorderlessEntry.Behaviors>

            </custom:GAZTBorderlessEntry>

            <inputLayout:SfTextInputLayout.TrailingView>
               <Label
                    HorizontalOptions="End"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{x:Static ResourceManager:AppResources.ZSAR}"
                    FontSize="15"/>
            </inputLayout:SfTextInputLayout.TrailingView>
        </inputLayout:SfTextInputLayout>
    </StackLayout>

</ContentView>
