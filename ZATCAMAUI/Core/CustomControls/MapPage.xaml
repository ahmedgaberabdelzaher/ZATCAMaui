<?xml version="1.0" encoding="UTF-8" ?>
<Mopups:PopupPage
    x:Class="ZATCAMAUI.Controls.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    BackgroundColor="#88000000"
    xmlns:gmaps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps">

    <Mopups:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </Mopups:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <Border
            Padding="0"
            BackgroundColor="White"
            HeightRequest="400"
            Stroke="{StaticResource NeutralLightGrey}"
            StrokeShape="RoundRectangle 15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <gmaps:Map
                x:Name="map"
                IsIndoorEnabled="True"
                MapClicked="map_MapClicked"
                MapLongClicked="map_MapLongClicked"
                MapType="Street"
                MyLocationEnabled="True" />

        </Border>

        <Image
            Margin="10"
            Aspect="AspectFit"
            HeightRequest="25"
            HorizontalOptions="StartAndExpand"
            Source="CloseIcon"
            VerticalOptions="StartAndExpand"
            WidthRequest="25">

            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMapCommand}" />
            </Image.GestureRecognizers>

        </Image>

    </Grid>
</Mopups:PopupPage>



