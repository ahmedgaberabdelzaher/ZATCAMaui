<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="ZATCAMAUI.Core.CustomControls.BottomMenu"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:ZATCAMAUI"
    x:Name="CustomEntryWithSAR">

    <Grid RowDefinitions="*">
    <Border
        BackgroundColor="#002447"
        Stroke="#002447"
        StrokeShape="RoundRectangle 15,15,0,0"
        HorizontalOptions="Fill"
        VerticalOptions="EndAndExpand">
        <Border.Resources>
             <ResourceDictionary>
                <Style TargetType="Label">
                    <Setter Property="HorizontalOptions" Value="Center" />
                    <Setter Property="TextColor" Value="#FFFFFF" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
                <Style TargetType="Image">
                    <Setter Property="HeightRequest" Value="23" />
                    <Setter Property="HorizontalOptions" Value="Center" />
                    <Setter Property="VerticalOptions" Value="Center" />
                </Style>
                 <Style TargetType="StackLayout">
                    <Setter Property="Spacing" Value="4" />
                </Style>
            </ResourceDictionary>
        </Border.Resources>

        <Grid
            ColumnDefinitions="*,*,*,*"
            RowDefinitions="65">
            <StackLayout Grid.Column="0">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeCurrentTabCommand}" CommandParameter="0" />
                </StackLayout.GestureRecognizers>
                <Image HeightRequest="5">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="0">
                            <Setter Property="Source" Value="Rectangle" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Image Source="HomeNotSelected">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="0">
                            <Setter Property="Source" Value="HomeSelected" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Label Text="{x:Static ResourceManager:AppResources.Home}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Label"
                            Value="0">
                            <Setter Property="TextColor" Value="{StaticResource SelectedMenuColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </StackLayout>
            <StackLayout Grid.Column="1">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeCurrentTabCommand}" CommandParameter="1" />
                </StackLayout.GestureRecognizers>
                <Image HeightRequest="5">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="1">
                            <Setter Property="Source" Value="Rectangle" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Image Source="Account">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="1">
                            <Setter Property="Source" Value="AccountSelected" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Label Text="{x:Static ResourceManager:AppResources.VATRAccount}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Label"
                            Value="1">
                            <Setter Property="TextColor" Value="{StaticResource SelectedMenuColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </StackLayout>
            <StackLayout Grid.Column="3">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeCurrentTabCommand}" CommandParameter="2" />
                </StackLayout.GestureRecognizers>
                <Image HeightRequest="5">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="2">
                            <Setter Property="Source" Value="Rectangle" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Image Source="Menu" WidthRequest="24">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="2">
                            <Setter Property="Source" Value="MenuSelected" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Label Text="{x:Static ResourceManager:AppResources.ZZZMenu}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Label"
                            Value="2">
                            <Setter Property="TextColor" Value="{StaticResource SelectedMenuColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </StackLayout>
            <StackLayout Grid.Column="2">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeCurrentTabCommand}" CommandParameter="3" />
                </StackLayout.GestureRecognizers>
                <Image HeightRequest="5">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="3">
                            <Setter Property="Source" Value="Rectangle" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Image Source="LiveVideonIcon" WidthRequest="24">
                    <Image.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Image"
                            Value="3">
                            <Setter Property="Source" Value="SelectedLiveVideonIcon" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
                <Label Text="{x:Static ResourceManager:AppResources.LiveVideoTitle}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding CurrentTab}"
                            TargetType="Label"
                            Value="3">
                            <Setter Property="TextColor" Value="{StaticResource SelectedMenuColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </StackLayout>
        </Grid>

    </Border>
    </Grid>
</ContentView>
