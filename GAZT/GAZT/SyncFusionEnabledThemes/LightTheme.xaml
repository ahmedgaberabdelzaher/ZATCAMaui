    <x:String x:Key="LargeLabelTest" />
    <Style x:Key="DummyStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource LargeLabelTest}" />
    </Style>
    <OnPlatform x:Key="FontIcons" x:TypeArguments="x:String">
        <OnPlatform.Platforms>
