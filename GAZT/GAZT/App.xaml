                    </Setter.Value>
                </Setter>
                <Setter Property="TextColor" Value="{DynamicResource MaroonLabelTextColor}" />
            </Style>
            <Style x:Key="FrameStyle" TargetType="Frame">
                <Setter Property="CornerRadius">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="14.5" Tablet="20" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BackgroundColor" Value="{DynamicResource WhiteTextColor}" />
                <Setter Property="BorderColor" Value="#B1B1B1" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
