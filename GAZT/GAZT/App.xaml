                    </Setter.Value>
                </Setter>
                <Setter Property="FontFamily" Value="{StaticResource SSTArLight}" />
                <Setter Property="TextColor" Value="{DynamicResource WhiteTextColor}" />
            </Style>
            <Style x:Key="SmallMiniWhiteLabelStyle" TargetType="Label">
