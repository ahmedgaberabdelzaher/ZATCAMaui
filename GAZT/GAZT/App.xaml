                 <Setter Property="FontFamily" Value="{StaticResource SSTArLight}" />
                <Setter Property="TextColor" Value="{DynamicResource GrayTextColor}" />
            </Style>
            <Style x:Key="MiniWhiteLabelStyle" TargetType="Label">
                <Setter Property="FontSize">
