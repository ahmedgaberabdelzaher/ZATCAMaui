                    </Setter.Value>
                </Setter>
                <Setter Property="TextColor" Value="{DynamicResource GrayTextColor}" />
            </Style>
            <Style x:Key="DashboardMiniGrayLabelStyle" TargetType="Label">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="7.5" Tablet="16" />
                    </Setter.Value>
                </Setter>
                <Setter Property="TextColor" Value="{DynamicResource DashboardGrayTextColor}" />
            </Style>
            <Style x:Key="MiniGreenLabelStyle" TargetType="Label">
                <Setter Property="FontSize">
