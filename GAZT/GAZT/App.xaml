<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="GAZT.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="WhiteTextColor">#FFFFFF</Color>
            <Color x:Key="GrayTextColor">#c7c7c7</Color>
            <Color x:Key="DashboardGrayTextColor">#717171</Color>
            <Color x:Key="DashboardChartStatusGrayTextColor">#292929</Color>
            <Color x:Key="GoldLabelTextColor">#c49b2d</Color>
            <Color x:Key="GreenLabelTextColor">#005e4b</Color>
            <Color x:Key="MaroonLabelTextColor">#A76d6d</Color>
            <Color x:Key="BlackLabelTextColor">#000000</Color>
            

             <!-- SST Arabic Bold.ttf -->
             <OnPlatform x:TypeArguments="x:String" x:Key="SSTArBold">
                <On Platform="Android" Value="SSTArabic-Bold.ttf#SSTArabic" />

                <On Platform="iOS" Value="SSTArabic-Bold" />
            </OnPlatform>

              <!-- SST Arabic Light.ttf -->
             <OnPlatform x:TypeArguments="x:String" x:Key="SSTArLight">
                <On Platform="Android" Value="SSTArabic-Light.ttf#SSTArabic" />

                <On Platform="iOS" Value="SSTArabic-Light" />
            </OnPlatform>

             <OnPlatform x:TypeArguments="x:String" x:Key="SSTArabicMedium">
                <On Platform="Android" Value="SSTArabic-Medium.ttf#SSTArabic" />

                <On Platform="iOS" Value="SSTArabic-Medium" />
            </OnPlatform>
           



            <Style x:Key="MiniGoldLabelStyle" TargetType="Label">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="12" Tablet="16" />
                    </Setter.Value>

                </Setter>
                <Setter Property="FontFamily" Value="{StaticResource SSTArabicMedium}" />

                <!--<Setter Property="FontFamily" Value="{StaticResource SSTArabicLight}" />-->

                <Setter Property="TextColor" Value="{DynamicResource GoldLabelTextColor}" />
            </Style>
            <Style x:Key="SmallMiniGoldLabelStyle" TargetType="Label">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="10" Tablet="14" />
                    </Setter.Value>
                </Setter>

                 <Setter Property="FontFamily" Value="{StaticResource SSTArabicMedium}" />
                <Setter Property="TextColor" Value="{DynamicResource GoldLabelTextColor}" />

            </Style>

            <Style x:Key="EntryStyle" TargetType="Entry">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="10" Tablet="14" />
                    </Setter.Value>
                </Setter>

                <Setter Property="FontFamily" Value="{StaticResource SSTArabicMedium}" />
                <Setter Property="TextColor" Value="{DynamicResource GrayTextColor}" />

            </Style>

            <Style x:Key="MicroGoldLabelStyle" TargetType="Label">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="12" Tablet="16" />
                    </Setter.Value>
                </Setter>
                <Setter Property="TextColor" Value="{DynamicResource GoldLabelTextColor}" />
            </Style>
            <Style x:Key="SmallGoldLabelStyle" TargetType="Label">
