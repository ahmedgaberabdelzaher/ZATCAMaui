            <Style x:Key="FrameStyle" TargetType="Frame">
                <Setter Property="CornerRadius">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="14.5" Tablet="14.5" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BackgroundColor" Value="{DynamicResource WhiteTextColor}" />
                <Setter Property="BorderColor" Value="#B1B1B1" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
            <Style x:Key="MiniBlackLabelStyle" TargetType="Label">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="10" Tablet="14" />
                    </Setter.Value>
                </Setter>
                 <Setter Property="FontFamily" Value="{StaticResource SSTArabicMedium}" />
                <Setter Property="TextColor" Value="{DynamicResource BlackLabelTextColor}" />
            </Style>

           
