<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAZT.App">
    <Application.Resources>
     <ResourceDictionary>
           

            <Color x:Key="WhiteTextColor">#FFFFFF</Color>
            <Color x:Key="GoldLabelTextColor">#c49b2d</Color> 
            
             <Style x:Key ="SmallGoldLabelStyle" TargetType="Label">
                 <Setter Property="FontSize">
                <Setter.Value>
                  <OnIdiom x:TypeArguments="x:Double" Phone="15" Tablet="20"/>
                </Setter.Value>
            </Setter>
                <Setter Property="TextColor" Value="{DynamicResource GoldLabelTextColor}" />
      </Style>
      
            
             <Style x:Key ="MediumGoldLabelStyle" TargetType="Label">
                 <Setter Property="FontSize">
                <Setter.Value>
                  <OnIdiom x:TypeArguments="x:Double" Phone="15" Tablet="20"/>
                </Setter.Value>
            </Setter>
                <Setter Property="TextColor" Value="{DynamicResource GoldLabelTextColor}" />
      </Style>
            
             <Style x:Key ="SmallWhiteLabelStyle" TargetType="Label">
                 <Setter Property="FontSize">
                <Setter.Value>
                  <OnIdiom x:TypeArguments="x:Double" Phone="15" Tablet="20"/>
                </Setter.Value>
            </Setter>
                <Setter Property="TextColor" Value="{DynamicResource WhiteTextColor}" />
      </Style>
            
              <Style x:Key ="MediumWhiteLabelStyle" TargetType="Label">
                 <Setter Property="FontSize">
                <Setter.Value>
                  <OnIdiom x:TypeArguments="x:Double" Phone="15" Tablet="20"/>
                </Setter.Value>
            </Setter>
                <Setter Property="TextColor" Value="{DynamicResource WhiteTextColor}" />
      </Style>
            
           
