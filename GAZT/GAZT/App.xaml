                        <OnIdiom x:TypeArguments="x:Double" Phone="10" Tablet="16" />
                    </Setter.Value>
                </Setter>

                <Setter Property="Margin">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" Phone="10" Tablet="16" />
                    </Setter.Value>
                </Setter>

 <Setter Property="FontFamily" Value="{StaticResource SSTArabicMedium}" />

                <Setter Property="TextColor" Value="{DynamicResource GoldLabelTextColor}" />
