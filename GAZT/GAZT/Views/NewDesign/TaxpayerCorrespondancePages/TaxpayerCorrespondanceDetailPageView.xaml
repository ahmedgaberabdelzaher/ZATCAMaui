<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.TaxpayerCorrespondancePages.TaxpayerCorrespondanceDetailPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:control="clr-namespace:GAZT"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:EGAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ZZCorrespondence}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <yummy:PancakeView
                        Padding="0"
                        BackgroundColor="White"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,-14,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--<ScrollView Grid.Row="1">-->
            <Grid Grid.Row="1" Padding="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>


                <control:CustomWebView
                    x:Name="CorWebView"
                    Grid.Row="0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand" />
                <border:SfBorder
                    Grid.Row="1"
                    Margin="0,10,0,10"
                    IsVisible="{Binding IsAttachmentEnabled}"
                    Style="{StaticResource GreyBorderFrameWithShadow}">
                    <Grid Padding="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="85*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Row="0" Grid.Column="1">
                            <control:CustomLabel
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.Attachment}"
                                VerticalOptions="CenterAndExpand" />
                            <!--<Label Text=" Date" Style="{StaticResource CaptionLabelGrey}" />-->
                        </StackLayout>
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="10,0,10,0"
                            Aspect="AspectFit"
                            HorizontalOptions="End"
                            Source="newui_ic_pdf.png"
                            VerticalOptions="CenterAndExpand" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                        </Grid.GestureRecognizers>

                    </Grid>
                </border:SfBorder>


            </Grid>

            <!--</ScrollView>-->
            <StackLayout
                Grid.Row="0"
                Padding="15,45,15,0"
                BackgroundColor="White"
                VerticalOptions="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.Row="0" Grid.Column="0">
                        <custom:CustomLabel
                            Padding="0,10,0,0"
                            Style="{StaticResource PageTitleBlack}"
                            Text="{Binding CorrespondenceTitle}" />
                        <StackLayout HorizontalOptions="StartAndExpand" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{Binding CorrespondenceDateTime}" />
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{Binding CorrespondenceTime}" />
                        </StackLayout>
                        <!--</StackLayout>-->

                    </StackLayout>
                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,-30,0,0"
                        IsVisible="{Binding IsFavoriteVisible}"
                        Source="{Binding FavIcon}"
                        VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnFavClicked}" />
                        </Image.GestureRecognizers>

                    </Image>

                </Grid>
                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1" />



            </StackLayout>
        </Grid>


    </ContentPage.Content>
</ContentPage>