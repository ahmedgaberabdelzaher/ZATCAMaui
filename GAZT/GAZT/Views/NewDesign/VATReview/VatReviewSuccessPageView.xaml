<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.VatReview.VatReviewSuccessPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <ContentPage.Content>

        <StackLayout>
            <StackLayout
                Padding="40"
                HorizontalOptions="Center"
                VerticalOptions="CenterAndExpand">

                <Image
                    Aspect="AspectFit"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    Source="Forget_ic_success"
                    VerticalOptions="Center"
                    WidthRequest="120" />

                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PageTitleWhite}"
                    Text="{x:Static ResourceManager:AppResources.VRVatReviewRequest}" />


                <Label
                    Margin="0,16,0,0"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BodyLabelWhite}"
                    Text="{x:Static ResourceManager:AppResources.VRYourVATReviewissubmittedsuccessfully}" />


            </StackLayout>
            <ScrollView>
                <Grid>
                    <yummy:PancakeView
                        Padding="20"
                        BackgroundColor="White"
                        CornerRadius="20,20,0,0"
                        VerticalOptions="EndAndExpand">
                        <StackLayout>


                            <Frame
                                Margin="10,5,10,5"
                                Padding="0"
                                BorderColor="LightGray"
                                CornerRadius="8"
                                HasShadow="False">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VRApplicationNumber}"
                                        VerticalOptions="Center" />

                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="15"
                                        HorizontalOptions="End"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding VATReferanceNumber}"
                                        VerticalOptions="Center" />

                                    <Image Grid.Row="0" Grid.Column="2">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ContentCopy}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Instalment_copy_Tapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Frame>



                            <buttons:SfButton
                                Grid.ColumnSpan="2"
                                Margin="10,20,10,20"
                                BackgroundColor="{StaticResource Secondary}"
                                Clicked="Download_Acknowledgement"
                                CornerRadius="10"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="15"
                                HeightRequest="48"
                                Text="{x:Static ResourceManager:AppResources.CRDownloadConfirmation}"
                                TextColor="White"
                                VerticalOptions="End"
                                WidthRequest="366" />

                            <custom:CustomLabel
                                Margin="10,0,10,15"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource BodyLabelSecondary}"
                                Text="{x:Static ResourceManager:AppResources.VatReview}">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="VatReview_Tapped" />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>
                        </StackLayout>
                    </yummy:PancakeView>
                    <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="Black"
                            Opacity="0.4"
                            Orientation="Vertical"
                            VerticalOptions="FillAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="15,15"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Opacity="0.8"
                            Orientation="Vertical"
                            VerticalOptions="Center">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <busyindicator:SfBusyIndicator
                                    AnimationType="SingleCircle"
                                    EnableAnimation="True"
                                    HorizontalOptions="CenterAndExpand"
                                    IsBusy="True"
                                    TextColor="{StaticResource Secondary}"
                                    TitlePlacement="Bottom"
                                    VerticalOptions="CenterAndExpand"
                                    ViewBoxHeight="70"
                                    ViewBoxWidth="70" />
                                <!--  Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"  -->
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </Grid>
            </ScrollView>
        </StackLayout>

    </ContentPage.Content>
</ContentPage>