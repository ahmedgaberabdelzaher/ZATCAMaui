<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.VATReview.VRVatRegViewPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VatReview}" />


                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="24"
                            HorizontalOptions="EndAndExpand"
                            Source="close"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <Grid x:Name="VATRDMainGrid" Padding="15,15,15,0">
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid
                    x:Name="SummeryView"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="0,0,0,0"
                    IsVisible="{Binding IsSummaryVisible}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource GAZTMediumBlackLabel}"
                            Text="{x:Static custom2:AppResources.VATRegistrationDetailsTitle}" />
                    </StackLayout>
                    <StackLayout Grid.Row="1">


                        <Frame
                            Margin="0,10,0,0"
                            Padding="0"
                            BorderColor="LightGray"
                            CornerRadius="8"
                            HasShadow="False">
                            <StackLayout>

                                <Grid Padding="5" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start"
                                                               VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True"
                                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                                        HasShadow="False">
                                                        </Frame>-->

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="details"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static custom2:AppResources.ZZTaxPayerDetails}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource lineSeperator}" />
                                <Grid Padding="10,5,10,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VATRVATEligibleStartDate}" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.VatEligibleStartDate}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VATRImportExport}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding ImportExportText}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.Attachment}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding AttachmentName}" />




                                    <!--<Label Grid.Row="1" Grid.Column="0" Text="Import or Export" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>
                                                    <Label Grid.Row="1" Grid.Column="1" Text="Import" TextColor="{StaticResource PrimaryColor}" FontFamily="{StaticResource GAZT_FONT_MEDIUM}"/>-->

                                </Grid>
                            </StackLayout>
                        </Frame>
                        <!--  Bank Details Summery  -->
                        <Frame
                            Margin="0,10,0,0"
                            Padding="0"
                            BorderColor="LightGray"
                            CornerRadius="8"
                            HasShadow="False">
                            <StackLayout>

                                <Grid Padding="5" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                                        HasShadow="False">
                                                        </Frame>-->

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="positive"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="Al Rajhi Bank"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>
                                <BoxView Style="{StaticResource lineSeperator}" />
                                <listView:SfListView
                                    Grid.Row="1"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollBarVisible="False"
                                    IsScrollingEnabled="False"
                                    ItemSpacing="5"
                                    ItemsSource="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.IbanList}"
                                    SelectionBackgroundColor="Transparent"
                                    SelectionMode="SingleDeselect"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Spacing="-5">
                                                    <Label
                                                        FontSize="Small"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="IBAN" />
                                                </StackLayout>
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Spacing="-5">
                                                    <Label
                                                        FontSize="Small"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding Iban}" />
                                                </StackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>


                            </StackLayout>
                        </Frame>
                        <!--  Sales Details Summery  -->
                        <Frame
                            Margin="0,10,0,0"
                            Padding="0"
                            BorderColor="LightGray"
                            CornerRadius="8"
                            HasShadow="False">
                            <StackLayout>
                                <Grid Padding="5" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                                        HasShadow="False">
                                                        </Frame>-->

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="finances"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static custom2:AppResources.FORM5FinancialInfo}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource lineSeperator}" />
                                <Grid Padding="10,5,10,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  SliderLable1  -->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VATRSummeryOfSalesDetailsComming12months}" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion1answerSelected}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VATRSummeryOfSalesDetailsLast12months}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion2answerSelected}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VATRSummeryofExpenseDetailsComming12Months}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion3answerSelected}" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VATRSummeryOfExpenseDetailsLast12Months}" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.quesTion4answerSelected}" />
                                </Grid>
                            </StackLayout>
                        </Frame>

                        <Frame
                            Margin="0,10,0,0"
                            Padding="0"
                            BorderColor="LightGray"
                            CornerRadius="8"
                            HasShadow="False">
                            <StackLayout>
                                <Grid Padding="5" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                                        HasShadow="False">
                                                        </Frame>-->

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="vat_user"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static custom2:AppResources.ZZZZVATRFinancialRepresentative}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource lineSeperator}" />
                                <Grid Padding="10,5,10,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.TIN}" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTGrayLabelStyleForSmallFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.GpartFR}" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.ZZIDType}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.TxtIDTypeFR}" />

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.IDNumber}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.IdnumberFR}" />

                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.ZZZVATRFirstName}" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.FirstnmFR}" />

                                    <Label
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.ZZZVATRSurName}" />
                                    <Label
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.LastnmFR}" />

                                    <Label
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.MobileNumber}" />

                                    <Label
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.MobNumberFR}" />

                                    <Label
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.Email}" />
                                    <Label
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding Source={x:Reference Name=VATRDMainGrid}, Path=BindingContext.SmtpAddrFR}" />
                                </Grid>
                            </StackLayout>
                        </Frame>
                        <Frame
                            Margin="0,10,0,0"
                            Padding="0"
                            BorderColor="LightGray"
                            CornerRadius="8"
                            HasShadow="False">
                            <StackLayout Padding="0">
                                <Grid Padding="5" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame>-->

                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="declaration"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static custom2:AppResources.VatDeregDeclarationTitle}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource lineSeperator}" />

                                <Grid Padding="10,5,10,10" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.ZZIDType}" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding IDType}" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.IDNumber}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding IDNumber}" />

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VatDeregDOBTitle}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding DOB}" />

                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource GAZTSmallBlackLblMediumFont}"
                                        Text="{x:Static custom2:AppResources.VATRContactPersonName}" />
                                    <Label
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"
                                        Text="{Binding ContactPersonName}" />

                                </Grid>

                            </StackLayout>
                        </Frame>
                    </StackLayout>
                </Grid>

            </ScrollView>
        </Grid>

    </ContentPage.Content>
</ContentPage>