<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png"
             x:Class="EGAZT.Views.NewDesign.VATReview.VRInputTDViewAppPageViewApp">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>


                         <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.VatReview}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                       
                         <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                         <Image  Grid.Row="0" Grid.Column="2"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"
                               Source="close"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                      
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <StackLayout Margin="15,0,15,0">
                <Grid Margin="0,5,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                        Text="{x:Static ResourceManager:AppResources.VRViewApplication}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}" />
                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                        Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}" />
                    <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                </Grid>

                <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1" Margin="0,0,0,10"
                                 Style="{StaticResource GreyBorderFrame}" VerticalOptions="FillAndExpand">

                    <Grid Margin="8" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Row="0" Grid.Column="0 ">
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont"
                                                 Color="{StaticResource SecondaryNew}" Size="24"
                                                 Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                            </Image.Source>
                        </Image>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.Information}"
                                            Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" VerticalOptions="FillAndExpand"/>

                        <StackLayout Grid.Row="1" Grid.ColumnSpan="2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRTIDInstruction1}" 
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}" VerticalOptions="FillAndExpand"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRTIDInstruction2}" 
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}" VerticalOptions="FillAndExpand"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRTIDInstruction3}" 
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}" VerticalOptions="FillAndExpand"/>
                        </StackLayout>
                      
                    </Grid>
                </border:SfBorder>
                
                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>

                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                               
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                   CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                   Opacity=".2" IsClippedToBounds="True"
                                   BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                   HasShadow="False" />-->
                           
                            <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0"
                                         Padding="8,0" Orientation="Horizontal">

                                 <Image  HeightRequest="24" WidthRequest="24"
                                   HorizontalOptions="Start" VerticalOptions="Center" Aspect="AspectFit"
                                   Source="vat_user" />
                                <Label Text="{x:Static ResourceManager:AppResources.VRRequestDetails}"
                                       VerticalOptions="CenterAndExpand"
                                       Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                            </StackLayout>

                        </Grid>
                        <BoxView HorizontalOptions="FillAndExpand" HeightRequest="1" BackgroundColor="LightGray" />

                        <StackLayout Padding="10" Spacing="10">

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VREffectiveDateforinputtaxdeductionmethod}" 
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRTIDEffectiveDateFrom}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding VRTIDEffectiveDateFrom,StringFormat='{0:dd MMM yyyy}'}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End" />
                            </Grid>
                        
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRTIDEffectiveDateTo}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Text="{Binding VRTIDEffectiveDateTo,StringFormat='{0:dd MMM yyyy}'}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand" />
                            </StackLayout>
                            
                            <BoxView HorizontalOptions="FillAndExpand" HeightRequest="1" BackgroundColor="LightGray" />
                            
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRCurrentinputtaxdeductionmethod}" 
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />
                            
                            <Grid >
                                <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                    Text="{x:Static ResourceManager:AppResources.VRTIDProxyforTaxablePurchases}"
                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding CIPFTxablePurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand" />
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRTIDProxyforExemptPurchases}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding CIPFExemptPurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRTIDTaxablePurchases}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding CITxablePurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" />
                            </Grid>


                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRTIDExemptPurchases}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding CIExemptPurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" />
                            </Grid>
                        </StackLayout>

                        <BoxView HorizontalOptions="FillAndExpand" HeightRequest="1" BackgroundColor="LightGray" />
                        
                        <StackLayout Padding="10" Spacing="10">

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRProposedinputtaxdeductionmethod}" 
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />
                            
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel
                                    Text="{x:Static ResourceManager:AppResources.VRTIDProxyforTaxablePurchases}"
                                    Style="{StaticResource ValueLabelGrey}" Grid.Column="0" Grid.Row="0" />
                                <custom:CustomLabel Text="{Binding PIPFTxablePurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand" Grid.Column="1" Grid.Row="0" />
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRTIDProxyforExemptPurchases}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding PIPFExemptPurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRTIDTaxablePurchases}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding PITxablePurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRTIDExemptPurchases}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding PIExemptPurchases}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" />
                            </Grid>

                        </StackLayout>
                        <BoxView HorizontalOptions="FillAndExpand" HeightRequest="1" BackgroundColor="LightGray" />
                        <StackLayout Padding="10" Spacing="10">
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRReportDetails}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding VITDReportDetails}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End" />
                            </Grid>

                            <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                 IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                 VerticalOptions="Center" AutoFitMode="Height"
                                                 ItemsSource="{Binding VITDAttachmentsListViewData}"
                                                 SelectionMode="None"
                                                 ItemTapped="VRITDAttachItemTapped"
                                                 SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRAttachment}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                            <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                            <Image Grid.Column="2" Source="Generic_attachment_icon"
                                                           Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                           HorizontalOptions="Start" VerticalOptions="Center" />
                                        </Grid>

                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </StackLayout>
                    </StackLayout>

                </border:SfBorder>

                <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                 Style="{StaticResource GreyBorderFrameWithShadow}">

                    <StackLayout Orientation="Vertical">

                        <Grid Padding="15" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                               
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                   CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                   Opacity=".2" IsClippedToBounds="True"
                                   BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                   HasShadow="False" />-->
                           
                            <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0"
                                         Padding="8,0" Orientation="Horizontal">
                                 <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                   HorizontalOptions="Start" VerticalOptions="Center" Aspect="AspectFit"
                                   Source="establishments" />
                                <Label Text="{x:Static ResourceManager:AppResources.VRDeclaration}"
                                       VerticalOptions="CenterAndExpand"
                                       Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                            </StackLayout>

                        </Grid>

                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <StackLayout Padding="15,15,15,0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRIDType}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding VITDIDType}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRIDNumber}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding VITDIDNumber}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End" />
                            </Grid>

                            <Grid IsVisible="{Binding IsVITDDOBVisible}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRDateOfBirth}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1"
                                                    Text="{Binding VITDDateOfBirth,StringFormat='{0:dd MMM yyyy}'}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End" />
                            </Grid>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRContactPersonName}"
                                                    Style="{StaticResource ValueLabelGrey}" />
                                <custom:CustomLabel Grid.Column="1" Text="{Binding VITDContactPersonName}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End" />
                            </Grid>

                        </StackLayout>
                    </StackLayout>
                </border:SfBorder>

            </StackLayout>

        </ScrollView>
    </ContentPage.Content>
</ContentPage>