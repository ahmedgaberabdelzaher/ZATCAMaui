<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="EGAZT.Views.NewDesign.VATReview.VRVatDeRegViewAppPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VatReview}" />


                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="24"
                            HorizontalOptions="EndAndExpand"
                            Source="close"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsSummaryViewEnabled}"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" />
                        <custom:CustomLabel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,8"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <border:SfBorder
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            HasShadow="False"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame>-->
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="Start"
                                            Source="details"
                                            VerticalOptions="Center" />

                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                <!--<listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding VATDeregistrationSummaryReasonData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
					                        <Grid Padding="0" RowSpacing="0">
                                                <Grid.RowDefinitions >
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                                    <Label Text="{Binding SummaryTitle}" Style="{StaticResource BodyLabelGrey}" FontSize="Micro"  HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                                    <Label Text="{Binding SummaryData}" Style="{StaticResource ValueLabelBlack}" FontSize="Micro" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                            </Grid>
			                        </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                              </listView:SfListView>-->
                                <listView:SfListView
                                    Grid.Row="0"
                                    Margin="8"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollBarVisible="False"
                                    IsScrollingEnabled="False"
                                    ItemsSource="{Binding VATDeregistrationSummaryReasonData}"
                                    SelectionBackgroundColor="Transparent"
                                    SelectionMode="None"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{Binding SummaryTitle}" />
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding SummaryData}" />
                                            </Grid>

                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </StackLayout>
                        </border:SfBorder>
                        <border:SfBorder
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            HasShadow="False"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame>-->
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="ic_attachment"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                <!--<listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="summaryAttachmentsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding AttachmentsListViewData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
					                        <Grid Padding="0" RowSpacing="0">
                                                <Grid.RowDefinitions >
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label Text="{Binding FieldTitle}" Style="{StaticResource BodyLabelGrey}" FontSize="Micro" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label Text="{Binding AttachmentName}" Style="{StaticResource ValueLabelBlack}" FontSize="Micro" HorizontalTextAlignment="End" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                            </Grid>
			                        </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                              </listView:SfListView>-->
                                <listView:SfListView
                                    Grid.Row="0"
                                    Margin="8"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollBarVisible="False"
                                    IsScrollingEnabled="False"
                                    ItemTapped="VRVatDeRegAttachTapped"
                                    ItemsSource="{Binding VatDeRegAttachmentsList}"
                                    SelectionBackgroundColor="Transparent"
                                    SelectionMode="None"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.Attachment}" />
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding Filename}" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    Margin="5,0"
                                                    HeightRequest="25"
                                                    HorizontalOptions="Start"
                                                    Source="Generic_attachment_icon"
                                                    VerticalOptions="Center"
                                                    WidthRequest="25" />
                                            </Grid>

                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </StackLayout>
                        </border:SfBorder>
                        <border:SfBorder
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,16,0,10"
                            HasShadow="False"
                            Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame>-->
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8,0"
                                        Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            HorizontalOptions="Start"
                                            Source="declaration"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />

                                        <Label
                                            Padding="8,0"
                                            FontSize="Medium"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                <!--<listView:SfListView  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="summaryDeclarationListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
					                        <Grid Padding="0" RowSpacing="0">
                                                <Grid.RowDefinitions >
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label Text="{Binding SummaryTitle}" Style="{StaticResource BodyLabelGrey}" FontSize="Micro" LineBreakMode="NoWrap" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label Text="{Binding SummaryData}" Style="{StaticResource ValueLabelBlack}" FontSize="Micro" HorizontalTextAlignment="End" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                            </Grid>
			                        </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                              </listView:SfListView>-->
                                <listView:SfListView
                                    Grid.Row="0"
                                    Margin="8"
                                    AutoFitMode="Height"
                                    HorizontalOptions="Center"
                                    IsScrollBarVisible="False"
                                    IsScrollingEnabled="False"
                                    ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}"
                                    SelectionBackgroundColor="Transparent"
                                    SelectionMode="None"
                                    VerticalOptions="Center">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel
                                                    Grid.Column="0"
                                                    Style="{StaticResource ValueLabelGrey}"
                                                    Text="{Binding SummaryTitle}" />
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding SummaryData}" />
                                            </Grid>

                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </StackLayout>
                        </border:SfBorder>
                    </Grid>

                </Grid>

            </ScrollView>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>