<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png"
             x:Class="EGAZT.Views.NewDesign.VATReview.VRVatDeRegViewAppPageView">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    
       <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"
                               Text="{x:Static ResourceManager:AppResources.VatReview}"
                               TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"
                               FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}"
                               Text="{DynamicResource StyleReverseBack}" TextColor="White"
                               IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource IconLabelStyle}" TextColor="White"
                               Text="{StaticResource Close}" VerticalOptions="CenterAndExpand"
                               HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    
    <ContentPage.Content>
        
                <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        
                <Grid IsVisible="{Binding IsSummaryViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="1"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" Margin="0,0,0,8" />
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        <border:SfBorder Margin="0,16,0,10" Grid.Row="3" Grid.Column="0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0">
                            <Grid Padding="15" RowSpacing="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame> 
                                <Image Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center"   Source="details"/>
                                <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                    
                                    <Label Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}" FontSize="Medium" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                </StackLayout>
                               
                            </Grid>

                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                             <!--<listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding VATDeregistrationSummaryReasonData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
					                        <Grid Padding="0" RowSpacing="0">
                                                <Grid.RowDefinitions >
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                                    <Label Text="{Binding SummaryTitle}" Style="{StaticResource BodyLabelGrey}" FontSize="Micro"  HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                                    <Label Text="{Binding SummaryData}" Style="{StaticResource ValueLabelBlack}" FontSize="Micro" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                            </Grid>
			                        </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                              </listView:SfListView>-->
                            <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                             VerticalOptions="Center" AutoFitMode="Height"
                                                             ItemsSource="{Binding VATDeregistrationSummaryReasonData}"
                                                             SelectionMode="None" Margin="8"
                                                             SelectionBackgroundColor="Transparent">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel Grid.Column="0"
                                                                            Text="{Binding SummaryTitle}"
                                                                            Style="{StaticResource ValueLabelGrey}" />
                                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SummaryData}"
                                                                            Style="{StaticResource ValueLabelBlack}"
                                                                            HorizontalOptions="EndAndExpand"
                                                                            HorizontalTextAlignment="End" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                        </StackLayout>
                    </border:SfBorder >
                     <border:SfBorder Margin="0,16,0,10" Grid.Row="4" Grid.Column="0"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0">
                            <Grid Padding="15" RowSpacing="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame> 
                                <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="ic_attachment"/>
                                <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                    <Label Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}" FontSize="Medium" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                </StackLayout>
                                
                            </Grid>

                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                             <!--<listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="summaryAttachmentsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding AttachmentsListViewData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
					                        <Grid Padding="0" RowSpacing="0">
                                                <Grid.RowDefinitions >
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label Text="{Binding FieldTitle}" Style="{StaticResource BodyLabelGrey}" FontSize="Micro" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label Text="{Binding AttachmentName}" Style="{StaticResource ValueLabelBlack}" FontSize="Micro" HorizontalTextAlignment="End" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                            </Grid>
			                        </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                              </listView:SfListView>-->
                            <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                             VerticalOptions="Center" AutoFitMode="Height"
                                                             ItemsSource="{Binding VatDeRegAttachmentsList}"
                                                             ItemTapped="VRVatDeRegAttachTapped"
                                                             SelectionMode="None" Margin="8"
                                                             SelectionBackgroundColor="Transparent">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel Grid.Column="0"
                                                                            Text="{x:Static ResourceManager:AppResources.Attachment}"
                                                                            Style="{StaticResource ValueLabelGrey}" />
                                                        <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                            Style="{StaticResource ValueLabelBlack}"
                                                                            HorizontalOptions="EndAndExpand"
                                                                            HorizontalTextAlignment="End" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                        </StackLayout>
                    </border:SfBorder >
                                          <border:SfBorder Margin="0,16,0,10" Grid.Row="5" Grid.Column="0"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0">
                            <Grid Padding="15" RowSpacing="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame> 
                                <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="declaration"/>
                                <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                    <Label Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationTitle}" FontSize="Medium" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                </StackLayout>

                            </Grid>

                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                             <!--<listView:SfListView  Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="summaryDeclarationListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
					                        <Grid Padding="0" RowSpacing="0">
                                                <Grid.RowDefinitions >
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label Text="{Binding SummaryTitle}" Style="{StaticResource BodyLabelGrey}" FontSize="Micro" LineBreakMode="NoWrap" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label Text="{Binding SummaryData}" Style="{StaticResource ValueLabelBlack}" FontSize="Micro" HorizontalTextAlignment="End" HorizontalOptions="StartAndExpand"/>
                                                </StackLayout>
                                            </Grid>
			                        </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                              </listView:SfListView>-->
                            <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                             VerticalOptions="Center" AutoFitMode="Height"
                                                             ItemsSource="{Binding VATDeregistrationSummaryDeclarationData}"
                                                             SelectionMode="None" Margin="8"
                                                             SelectionBackgroundColor="Transparent">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel Grid.Column="0"
                                                                            Text="{Binding SummaryTitle}"
                                                                            Style="{StaticResource ValueLabelGrey}" />
                                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SummaryData}"
                                                                            Style="{StaticResource ValueLabelBlack}"
                                                                            HorizontalOptions="EndAndExpand"
                                                                            HorizontalTextAlignment="End" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>
                        </StackLayout>
                    </border:SfBorder >
                    </Grid>
                 
               </Grid>
            
            </ScrollView>
            
             <Grid Grid.Row="0" Grid.Column="0"  IsVisible="{Binding IsLoading}" Margin="0,-20,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#D99A29"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>