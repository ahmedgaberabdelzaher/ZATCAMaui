<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png"
             x:Class="EGAZT.Views.NewDesign.VATReview.VRVatGroupPageView">
    
     <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                       
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.VatReview}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                       
                         <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                         <Image  Grid.Row="0" Grid.Column="2"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"
                               Source="close"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    
    <ContentPage.Content>
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <StackLayout Margin="15,0,15,0">
                <Grid Margin="0,5,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                        Text="{x:Static ResourceManager:AppResources.VRViewApplication}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource PageTitleBlack}" />
                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                        Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}" />
                    <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                </Grid>
                
                 <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="ic_vat_bill" />
                                        <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VRVGMemberDetails}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                        </StackLayout>
                                    
                                    </Grid>
                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                                     <StackLayout Padding="15,15,15,10">

                                        <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                             VerticalOptions="Center"
                                                             ItemsSource="{Binding VRVGTinsListViewData}"
                                                             SelectionMode="None"
                                                             AutoFitMode="Height"
                                                             SelectionBackgroundColor="Transparent">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel Grid.Column="0"
                                                                            Text="{x:Static ResourceManager:AppResources.VRVGTINNumber}"
                                                                            Style="{StaticResource ValueLabelGrey}" />
                                                        <custom:CustomLabel Grid.Column="1" Text="{Binding Gpart}"
                                                                            Style="{StaticResource ValueLabelBlack}"
                                                                            HorizontalOptions="EndAndExpand"
                                                                            HorizontalTextAlignment="End" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>

                                    </StackLayout>
                                   
                                </StackLayout>
                            </border:SfBorder>
                
                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="ic_vat_bill" />
                                        <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VRVGAggregatedgrouplevelfinancialdetails}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                        </StackLayout>
                                    
                                    </Grid>
                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                                    <StackLayout Padding="10" Spacing="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRVGGroupVATeligiblesupplies}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding VRVGVATeligiblesupplies}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" MaxLines="1"/>
                                        </Grid>
                                       
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRVGGroupVATeligiblepurchases}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding VRVGVATeligiblepurchases}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" MaxLines="1"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRVGGroupeffectivedate}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding VRVGEffectivedate}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" MaxLines="1"/>
                                        </Grid>
                                        
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                
                <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                             Style="{StaticResource GreyBorderFrameWithShadow}">

                                <StackLayout Orientation="Vertical">

                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="establishments" />
                                        <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VRVGAttachments}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <StackLayout Padding="15,15,15,10">

                                        <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                             VerticalOptions="Center"
                                                             ItemTapped="VRVGAttachTapped"
                                                             ItemsSource="{Binding VRVGAttachmentsListViewData}"
                                                             SelectionMode="None"
                                                             AutoFitMode="Height"
                                                             SelectionBackgroundColor="Transparent">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />

                                                            <ColumnDefinition Width="*" />

                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel Grid.Column="0"
                                                                            Text="{x:Static ResourceManager:AppResources.VRAttachment}"
                                                                            Style="{StaticResource ValueLabelGrey}" />
                                                         <Image Grid.Row="0" Grid.Column="1" Source="Generic_attachment_icon"
                                                           Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                           HorizontalOptions="Start" VerticalOptions="Center" />
                                                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding Filename}"
                                                                            Style="{StaticResource ValueLabelBlack}"
                                                                            HorizontalOptions="EndAndExpand"
                                                                            HorizontalTextAlignment="End" />
                                                    </Grid>

                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>

                                    </StackLayout>
                                </StackLayout>

                            </border:SfBorder>
                
                <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                             Style="{StaticResource GreyBorderFrameWithShadow}">

                                <StackLayout Orientation="Vertical">

                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="establishments" />
                                        <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                            <Label Text="{x:Static ResourceManager:AppResources.VRDeclaration}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <StackLayout Padding="15,15,15,5">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRIDType}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                            <custom:CustomLabel Grid.Column="1" Text="{Binding VRVGIDType}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                        </Grid>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRIDNumber}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                            <custom:CustomLabel Grid.Column="1" Text="{Binding VRVGIDNumber}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                        </Grid>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRContactPersonName}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                            <custom:CustomLabel Grid.Column="1" Text="{Binding VRVGContactPersonName}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                        </Grid>

                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                

            </StackLayout>

        </ScrollView>
    </ContentPage.Content>
</ContentPage>