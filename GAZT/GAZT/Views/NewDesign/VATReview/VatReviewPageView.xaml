<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.VatReview.VatReviewPageView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"
                               Text="{x:Static ResourceManager:AppResources.VatReview}"
                               TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"
                               FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}"
                               Text="{DynamicResource StyleReverseBack}" TextColor="White"
                               IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource IconLabelStyle}" TextColor="White"
                               Text="{StaticResource Close}" VerticalOptions="CenterAndExpand"
                               HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand"/>
                </Grid>



                <Grid Grid.Row="1">



                <!--Review Reason-->

                <Grid IsVisible="{Binding ReviewReasonVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,5,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                            Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    </Grid>

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                    Text="{Binding ReviewReason}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />


                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ReviewReasonCommand}"/>
                                    </Image.GestureRecognizers>
                                </Image>

                            </Grid>
                        </border:SfBorder>

                    </Grid>
                    <Grid Grid.Row="2" Margin="0,10,0,10">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRReviewSubReason}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SubReviewReason}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />


                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SubReviewReasonCommand}"/>
                                    </Image.GestureRecognizers>
                                </Image>

                            </Grid>
                        </border:SfBorder>

                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRApplicationReferenceNumber}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding ApplicationRefNumber}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />


                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ApplicationNumRefCommand}"/>
                                    </Image.GestureRecognizers>
                                </Image>

                            </Grid>
                        </border:SfBorder>

                    </Grid>
                    <Grid Grid.Row="4" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRDecisionDate}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding RequestDate,StringFormat='{0:dd MMM yyyy}'}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                                
                            </Grid>
                        </border:SfBorder>

                    </Grid>

                    <buttons:SfButton Grid.Row="5" Margin="0,16,0,16" BackgroundColor="{Binding ReviewReasonButtonBackGroundColor}"
                                      Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                      Style="{StaticResource PrimaryButtonStyle}"
                                      Command="{Binding ReviewReasonConBtnTapped}" />

                    <custom:CustomLabel Grid.Row="6" Margin="10,0,10,15"
                                        Text="{Binding ViewApplicationTypeText}"
                                        TextColor="#d49504" HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center">
                        <custom:CustomLabel.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewApplicationTapped}"/>
                        </custom:CustomLabel.GestureRecognizers>
                    </custom:CustomLabel>

                </Grid>



                                <StackLayout IsVisible="{Binding ReviewDetailsVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                             <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.VRReviewDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                            Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    </Grid>

                    <Grid HorizontalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0"
                                            Text="{x:Static ResourceManager:AppResources.VRReportDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                           
                            <custom:GAZTBorderlessEditor x:Name="Report_Details_Tx" MaxLength="1000" Unfocused="Report_Details_UnFocused"
                                                         PlaceholderColor="Gray" FontSize="Small"
                                                         MinimumHeightRequest="100" HorizontalOptions="FillAndExpand" Style="{StaticResource BodyLabelBlack}" />

                        </border:SfBorder>


                        <custom:CustomLabel Grid.Row="2"
                                            Text="{x:Static ResourceManager:AppResources.VRHelperText}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                    </Grid>

                    <Grid IsVisible="{Binding AtachmentsVisible}" HorizontalOptions="FillAndExpand">

                        <listView:SfListView HorizontalOptions="Center" 
                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding AttachmentsListViewData}"
                                             TapCommand="{Binding NewAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">

                          
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>

                                        <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                   <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Row="0" Grid.Column="0" Source="newui_ic_pdf" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>


                                                <custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                    Text="{Binding Filename}"
                                                                    FontSize="Small" TextColor="Black"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    VerticalOptions="Center"/>
                                                <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </border:SfBorder>
                                        <custom:CustomLabel Grid.Row="1"
                                                            Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MicroGrayLabelStyle}" />

                                    </Grid>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                    </Grid>
                    
                    <Grid HorizontalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0"
                                            Text="{x:Static ResourceManager:AppResources.VRNewAttachment}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />
                        <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                    FontSize="Small" TextColor="Black"
                                                    HorizontalOptions="FillAndExpand" />
                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                       Rotation="90">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                         Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </border:SfBorder>
                        <custom:CustomLabel Grid.Row="2"
                                            Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                        </Grid.GestureRecognizers>

                    </Grid>
                    
                   

                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRTaxPeriodofCase}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry IsEnabled="False"
                                                    Text="{Binding TaxPeriodOfCase}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                        </border:SfBorder>
                        
                    </Grid>
                    
                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRPeriodFrom}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry IsEnabled="False"
                                                    Text="{Binding TaxPeriodFrom,StringFormat='{0:dd MMM yyyy}'}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                        </border:SfBorder>
                        
                    </Grid>
                    
                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRPeriodTo}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry IsEnabled="False"
                                                    Text="{Binding TaxPeriodTo,StringFormat='{0:dd MMM yyyy}'}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                        </border:SfBorder>
                        
                    </Grid>
                    
                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.VRPenality_amount_in_question}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry IsEnabled="False"
                                                    Text="{Binding PenalityAmountInQuestion}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                        </border:SfBorder>
                        
                    </Grid>
                    
                    <buttons:SfButton Grid.Row="8" Margin="0,16,0,16"  VerticalOptions="End"
                                      Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                      Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="{Binding ReviewDetailsButtonBackGroundColor}"
                                      Command="{Binding ReviewDetailsConBtnTapped}" />

                </StackLayout>

                <StackLayout IsVisible="{Binding SecurityPaymentVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    
                    <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.VRSecurityPayment}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                        
                        <BoxView Grid.Row="1" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    </Grid>
                    
                    <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                        
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.VRSecurityType}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}" />

                    </Grid>

                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <listView:SfListView HorizontalOptions="FillAndExpand" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="StartAndExpand" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding SecurityPaymentOptions}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"  SelectionMode="Single"
                                      SelectionBackgroundColor="Transparent" ItemTapped="Security_Type_ListView_ItemTapped">

                            <listView:SfListView.ItemTemplate>

                                <DataTemplate>
                                    <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="120">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                            <Image Source="vat_tile_listofsignup_W" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            <custom:CustomLabel Text="{Binding SelectionTitle}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                    Margin="20,0,20,20"  HorizontalTextAlignment="Start" LineHeight="0.8">
                                            </custom:CustomLabel>
                                        </Grid>
                                    </cards:SfCardView>

                                </DataTemplate>

                            </listView:SfListView.ItemTemplate>

                            <listView:SfListView.SelectedItemTemplate>

                                <DataTemplate>
                                    <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="120">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                            <Image Source="vat_tile_listofsignup" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            <custom:CustomLabel Text="{Binding SelectionTitle}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                    Margin="20,0,20,20" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                            </custom:CustomLabel>
                                        </Grid>
                                    </cards:SfCardView>

                                </DataTemplate>

                            </listView:SfListView.SelectedItemTemplate>

                            <listView:SfListView.LayoutManager>

                                <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />

                            </listView:SfListView.LayoutManager>

                        </listView:SfListView>

                    </Grid>

                     <Grid HorizontalOptions="FillAndExpand">

                         <Frame HorizontalOptions="FillAndExpand"
                                Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12"
                                Margin="0,20,0,0" Padding="10,3,10,3">
                         <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRSecurityNote1}"
                                             HorizontalOptions="StartAndExpand" 
                                             Style="{StaticResource BodyLabelBlack}" />

                         </Frame>
                     </Grid>

                     <Grid HorizontalOptions="FillAndExpand">

                         <Frame HorizontalOptions="FillAndExpand"
                                Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12"
                                Margin="0,20,0,0" Padding="10,3,10,3">
                         <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRSecurityNote2}"
                                             HorizontalOptions="StartAndExpand" 
                                             Style="{StaticResource BodyLabelBlack}" />
                         </Frame>
                     </Grid>
                    
                    <StackLayout Orientation="Vertical" IsVisible="{Binding IsBankGurantSecuritySelected}">

                        <listView:SfListView HorizontalOptions="Center" 
                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding BankGuranteeAttachmentsListViewData}"
                                             TapCommand="{Binding NewBankGuranteeAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">

                          
                            <listView:SfListView.ItemTemplate>
