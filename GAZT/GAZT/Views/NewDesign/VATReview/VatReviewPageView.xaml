<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.VatReview.VatReviewPageView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
                                      xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"

             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>
                                <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                  <ResourceDictionary>
                <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                    <Setter Property="Rotation" Value="180" />
                </Style>
                <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                    <Setter Property="Rotation" Value="0" />
                </Style>
            </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                      

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VatReview}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                      
                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout  Grid.Row="0" Grid.Column="2">
                            <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked }"/>
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}"
                                                  MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}"
                                                  VerticalOptions="CenterAndExpand" DotSize="16"/>
                </Grid>


                <Grid Grid.Row="1">


                    <!--Review Reason-->

                    <Grid IsVisible="{Binding ReviewReasonVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                          HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />

                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="1"  WidthRequest="171">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" >
                                 <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.VRReviewReason}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                              </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  
                                             Style="{StaticResource GreyBorderFrame}" MinimumHeightRequest="50" VerticalOptions="FillAndExpand">
                                <Grid VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                        Text="{Binding ReviewReason}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" Padding="10" VerticalOptions="FillAndExpand"/>


                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                             Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ReviewReasonCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                </Grid>
                            </border:SfBorder>

                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,10"  WidthRequest="171">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" >
                                 <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.VRReviewSubReason}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                              </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"
                                             Style="{StaticResource GreyBorderFrame}" MinimumHeightRequest="50" VerticalOptions="FillAndExpand">
                                <Grid VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SubReviewReason}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" Padding="10" VerticalOptions="FillAndExpand"/>


                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                             Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SubReviewReasonCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                </Grid>
                            </border:SfBorder>

                        </Grid>

                        <Grid Grid.Row="3" Margin="0,10,0,10" WidthRequest="171">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" >
                                <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.VRApplicationReferenceNumber}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                              </custom:CustomLabel>

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" 
                                             Style="{StaticResource GreyBorderFrame}" MinimumHeightRequest="50" VerticalOptions="FillAndExpand">
                                <Grid VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                        Text="{Binding ApplicationRefNumber}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" Padding="10" VerticalOptions="FillAndExpand"/>


                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                             Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ApplicationNumRefCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                </Grid>
                            </border:SfBorder>

                        </Grid>
                        <Grid Grid.Row="4" Margin="0,10,0,10"  WidthRequest="171">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRDecisionDate}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" 
                                             Style="{StaticResource GreyBorderFrame}" MinimumHeightRequest="50" VerticalOptions="FillAndExpand">
                                <Grid VerticalOptions="FillAndExpand">
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                        Text="{Binding FormattedRequestDate}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" Padding="10" VerticalOptions="FillAndExpand"/>

                                </Grid>
                            </border:SfBorder>

                        </Grid>
                        <buttons:SfButton Grid.Row="5" Margin="0,16,0,16"
                                          BackgroundColor="{Binding ReviewReasonButtonBackGroundColor}"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding ReviewReasonConBtnTapped}" />

                        <custom:CustomLabel Grid.Row="6" Margin="10,0,10,15"
                                            IsVisible="{Binding IsApplicationVisible}"
                                            Text="{Binding ViewApplicationTypeText}"
                                            TextColor="#d49504" HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center">
                            <custom:CustomLabel.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewApplicationTapped}" />
                            </custom:CustomLabel.GestureRecognizers>
                        </custom:CustomLabel>

                    </Grid>

                    <StackLayout IsVisible="{Binding ReportDetailsVisible}" BackgroundColor="Transparent"
                                 Margin="20,10,20,0"
                                 HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.VRReportDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>
                        
                        <Grid Grid.Row="5" Margin="0,10,0,0" HorizontalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" >
                                 <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.VRReportDetails}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                              </custom:CustomLabel>

                           <border:SfBorder Grid.Row="1" Margin="0,0,0,3" Padding="10,5,10,10"
                                             MinimumHeightRequest="100"
                                             Style="{StaticResource GreyBorderFrame}" VerticalOptions="FillAndExpand">

 

                                <StackLayout Orientation="Vertical">

 
                                    <custom:GAZTBorderlessEditor x:Name="Report_Details_Tx"
                                                             Unfocused="Report_Details_UnFocused"
                                                             PlaceholderColor="Gray" FontSize="Small"
                                                             MinimumHeightRequest="100"
                                                             Text="{Binding ReportDetails}"
                                                                 TextChanged="Report_Details_Tx_TextChanged"
                                                             AutoSize="TextChanges"
                                                              MaxLength="1000"
                                                                 Margin="0,5,0,0"
                                                             VerticalOptions="FillAndExpand"
                                                             IsEnabled="{Binding IsReportDetailsEditable}"
                                                             HorizontalOptions="FillAndExpand"
                                                             Style="{StaticResource BodyLabelBlack}" />
                                </StackLayout>

 

                            </border:SfBorder>

                            <custom:CustomLabel Grid.Row="2"
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" >
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span  Text="{Binding charCountReportDetails}" Style="{StaticResource MicroGrayLabelStyle}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                           </custom:CustomLabel>
                            <custom:CustomLabel Grid.Row="3" Text="{x:Static ResourceManager:AppResources.VRHelperText}"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource BodyLabelBlack}" />

                        </Grid>
                        
                   <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">

                            <listView:SfListView HorizontalOptions="Center"
                                                 IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                 VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                                 ItemsSource="{Binding AttachmentsListViewData}"
                                                 TapCommand="{Binding NewAttachmentTapped}"
                                                 IsEnabled="{Binding IsDraft}"
                                                 SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">


                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                             Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon"
                                                           Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                           HorizontalOptions="Start" VerticalOptions="Center" />

                                                    <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               LineHeight="0.8"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="FillAndExpand"/>
                                                    <!--<custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                        Text="{Binding Filename}"
                                                                        FontSize="Small" TextColor="Black"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        VerticalOptions="Center" />-->
                                                    <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           Rotation="90">
                                                        <Image.Source>
                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray"
                                                                             Size="24"
                                                                             Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </border:SfBorder>
                                           

                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </Grid>

                        <Grid Margin="0,10,0,10" HorizontalOptions="FillAndExpand" IsEnabled="{Binding IsDraft}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0"
                                                Text="{x:Static ResourceManager:AppResources.VRNewAttachment}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />
                            <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                        Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                        FontSize="Small" TextColor="Black"
                                                        HorizontalOptions="FillAndExpand" />
                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                             Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </border:SfBorder>
                           
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                            </Grid.GestureRecognizers>

                        </Grid>
                        
                        <buttons:SfButton Grid.Row="8" Margin="0,16,0,16" VerticalOptions="EndAndExpand"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          BackgroundColor="{Binding ReportDetailsButtonBackGroundColor}"
                                          Command="{Binding ReportDetailsConBtnTapped}" />

                    </StackLayout>
                    
                    <StackLayout IsVisible="{Binding ReviewDetailsVisible}" BackgroundColor="Transparent"
                                 Margin="20,10,20,0"
                                 HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.VRReviewDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.VRCompleteTheBelowDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                       


                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRTaxPeriodofCase}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:BorderlessEntry IsEnabled="False"
                                                        Text="{Binding TaxPeriodOfCase}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </border:SfBorder>

                        </Grid>

                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRPeriodFrom}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:BorderlessEntry IsEnabled="False"
                                                        Text="{Binding FormattedTaxperdioFromDate}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </border:SfBorder>

                        </Grid>

                        <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRPeriodTo}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:BorderlessEntry IsEnabled="False"
                                                        Text="{Binding FormattedTaxperdioToDate}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </border:SfBorder>

                        </Grid>

                        <Grid IsVisible="{Binding IsPenlaityAmountVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                                Text="{x:Static ResourceManager:AppResources.VRPenality_amount_in_question}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10"
                                             Style="{StaticResource GreyBorderFrame}">
                                <custom:BorderlessEntry IsEnabled="False"
                                                        Text="{Binding PenalityAmountInQuestion,Converter={StaticResource commaSeparatorConverter}}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}" />
                            </border:SfBorder>

                        </Grid>

                        <Grid IsVisible="{Binding IsAssessPayOptionVisible}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
