                         <border:SfBorder IsVisible="{Binding IsSecurityPaymentsTabVisible}" Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="ic_attachment" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRSecurityPayment}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label TextColor="ForestGreen"
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackSecurityPayment}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15,15,15,0">
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRSECURITYAMOUNT}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SecurityAmount}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRSecurityType}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SecurityType}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                    <Grid IsVisible="{Binding IsSadadSecuritySelected}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRSADADNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SADADNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>
                        
                        <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRDeclaration}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label TextColor="ForestGreen"
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToDeclaration}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15,15,15,0">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRIDType}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding IDType}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRIDNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding IDNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                    <Grid IsVisible="{Binding IsDOBVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRDateOfBirth}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding PickedDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRContactPersonName}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ContactPersonName}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                        <buttons:SfButton Margin="0,16,0,16"
                                          Text="{x:Static ResourceManager:AppResources.Submit}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding SummaryConBtnTapped}" />

                    </StackLayout>
                </Grid>
                
                <!-- Loadig Indiacatr -->
                <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                 Opacity="0.4" VerticalOptions="FillAndExpand" />
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                 Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                           EnableAnimation="True"
                                                           AnimationType="SingleCircle"
                                                           HorizontalOptions="CenterAndExpand"
                                                           VerticalOptions="CenterAndExpand"
                                                           IsBusy="True"
                                                           ViewBoxWidth="70"
                                                           TitlePlacement="Bottom"
                                                           ViewBoxHeight="70"
                                                           TextColor="#D99A29" />
                            <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
                </Grid>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>