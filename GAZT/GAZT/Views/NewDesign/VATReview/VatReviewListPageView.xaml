<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png"
                         xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"

             x:Class="EGAZT.Views.NewDesign.VatReview.VatReviewListPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>


                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.VatReview}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>


                        <Image Grid.Row="0" Grid.Column="0" 
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <!--<Image  Grid.Row="0" Grid.Column="2"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"
                               Source="close"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}"/>
                            </Image.GestureRecognizers>
                        </Image>-->

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <Grid>

                <StackLayout IsVisible="{Binding IsVatListVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <Grid Grid.Row="0" Margin="10,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0"
                                            Text="{x:Static ResourceManager:AppResources.VatReview}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />

                        <custom:CustomLabel Grid.Row="1" Text="{Binding NumberOfObjAndReviews}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}" Margin="0,-10,0,15"/>
                    </Grid>

                    <Grid BackgroundColor="Transparent" HorizontalOptions="FillAndExpand"
                          VerticalOptions="Start">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <border:SfBorder Grid.Row="0" CornerRadius="15" Margin="0,20,0,0"
                                         HorizontalOptions="FillAndExpand" Padding="12" HasShadow="true"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0" Grid.Column="0" Source="add" WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Start" />
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                    Text="{x:Static ResourceManager:AppResources.VRVatReviewRequest}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource GAZTSmallGreenLabelStyle}" FontSize="16"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NewRequestBtnTapped}" />
                                    <!-- <TapGestureRecognizer Tapped="NewObjection" /> -->
                                </Grid.GestureRecognizers>
                            </Grid>
                        </border:SfBorder>

                        <Grid Grid.Row="1" Margin="0,10,0,0" BackgroundColor="Transparent"
                              HorizontalOptions="FillAndExpand" VerticalOptions="Start">

                            <listView:SfListView Grid.Row="0" HorizontalOptions="CenterAndExpand"
                                                 IsScrollBarVisible="False" Margin="0" Padding="0"
                                                 IsScrollingEnabled="False" VerticalOptions="Start"
                                                 AutoFitMode="Height" ItemSpacing="0"
                                                 ItemTapped="Reviews_ItemTapped"
                                                 ItemsSource="{Binding VATobjListViewData}" SelectionMode="Single"
                                                 SelectionBackgroundColor="Transparent">

                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <border:SfBorder Padding="10" Grid.Column="0" CornerRadius="15"
                                                         Margin="0,15,0,0" HasShadow="True"
                                                         Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <Grid Padding="0" RowSpacing="0" Margin="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>

                                                <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
                                                    <custom:CustomLabel
                                                        Text="{x:Static ResourceManager:AppResources.VRVatReviewRequest}"
                                                        HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource SectionTitleBlack}" Margin="0,0,0,10" />


                                                </StackLayout>

                                                <StackLayout Grid.Row="1" Grid.Column="0" Orientation="Vertical">

                                                    <Label Text="{Binding Fbnum}"
                                                           Style="{StaticResource ValueLabelGrey}" LineHeight="0.7"
                                                           HorizontalTextAlignment="Start"
                                                           HorizontalOptions="StartAndExpand"
                                                           VerticalOptions="CenterAndExpand" />

                                                </StackLayout>



                                                <yummy:PancakeView Grid.Row="1" Grid.Column="1" CornerRadius="14"
                                                                       BorderThickness="1" BackgroundColor="#E5EFED"
                                                                       VerticalOptions="CenterAndExpand"
                                                                       HorizontalOptions="EndAndExpand">

                                                    <Label Style="{StaticResource CaptionLabelBlack}"
                                                               Padding="8,3,8,3"
                                                               TextColor="DarkGoldenrod" Text="{Binding FbustTxt}"
                                                               HorizontalTextAlignment="Center"
                                                               HorizontalOptions="CenterAndExpand"
                                                               VerticalOptions="CenterAndExpand">
                                                        <Label.Triggers>

                                                            <DataTrigger TargetType="Label"
                                                                             Binding="{Binding FbustTxt}"
                                                                             Value="{x:Static ResourceManager:AppResources.NDBilled}">
                                                                <Setter Property="Text"
                                                                            Value="{x:Static ResourceManager:AppResources.NDBilled}" />
                                                                <Setter Property="TextColor"
                                                                            Value="{StaticResource Primary}" />
                                                                <Setter Property="HorizontalTextAlignment"
                                                                            Value="Center" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </yummy:PancakeView>
                                            </Grid>
                                        </border:SfBorder>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                        </Grid>
                    </Grid>

                </StackLayout>

                <Grid IsVisible="{Binding SummaryVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                          HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <StackLayout Orientation="Vertical">

                        <Grid Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.CRSummary}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                    Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0"
                                         Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                             Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ReviewReason}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRReviewSubReason}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SubReviewReason}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRApplicationReferenceNumber}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ApplicationRefNumber}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRRequestDate}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding RequestDate}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                </StackLayout>
                            </StackLayout>

                        </border:SfBorder>

                        <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                             Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRReportDetails}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRReportDetails}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ReportDetails}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                             VerticalOptions="Center" AutoFitMode="Height"
                                                             ItemsSource="{Binding AttachmentsListViewData}"
                                                             ItemTapped="Attachments_ItemTapped"
                                                             SelectionMode="None"
                                                             SelectionBackgroundColor="Transparent">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>

                                                <Grid VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Column="0"
                                                                            Text="{x:Static ResourceManager:AppResources.VRAttachment}"
                                                                            Style="{StaticResource ValueLabelGrey}" />
                                                    <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                            Style="{StaticResource ValueLabelBlack}"
                                                                            HorizontalOptions="EndAndExpand"
                                                                            HorizontalTextAlignment="End"
                                                                            VerticalOptions="FillAndExpand"/>
                                                </Grid>

                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>

                                </StackLayout>
                            </StackLayout>

                        </border:SfBorder>

                        <border:SfBorder IsVisible="{Binding IsSecurityPaymentsTabVisible}" Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                             Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="ic_attachment" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRReviewDetails}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15">

                                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRTaxPeriodofCase}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding TaxPeriodOfCase}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRPeriodFrom}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding TaxPeriodFrom,StringFormat='{0:dd MMM yyyy}'}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid IsVisible="{Binding IsSecurityPaymentsTabVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRPeriodTo}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding TaxPeriodTo,StringFormat='{0:dd MMM yyyy}'}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid IsVisible="{Binding IsPenlaityAmountVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRPenality_amount_in_question}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding PenalityAmountInQuestion,Converter={StaticResource commaSeparatorConverter}}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <!--<Grid IsVisible="{Binding IsAssessPayOptionVisible}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRRequesttoReviewtheAmount}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                            <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding VRRequesttoReviewtheAmountValue}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                        </Grid>-->
                                    <Grid IsVisible="{Binding IsAssessPayOptionVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRPleasespecifytheparticularamount}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding RequestedReviewAmount,Converter={StaticResource commaSeparatorConverter}}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Grid IsVisible="False">
                                        <!--<Grid IsVisible="{Binding IsAssessPayOptionVisible}">-->
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRDisputeDetails}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding DisputeDetailsDesc}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                        <border:SfBorder IsVisible="{Binding IsSecurityPaymentsTabVisible}" Margin="0,16,0,10"
                                             Padding="0,0,0,16" HasShadow="False"
                                             Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="ic_attachment" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRSecurityPayment}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRSECURITYAMOUNT}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SecurityAmount,Converter={StaticResource commaSeparatorConverter}}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid IsVisible="{Binding IsSecurityAmountMorethanZero}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRSecurityType}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SecurityType}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid IsVisible="{Binding IsSadadSecuritySelected}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRSADADNumber}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SADADNumber}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <listView:SfListView IsVisible="{Binding IsBankGurantSecuritySelected}" HorizontalOptions="Center"
                                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                             VerticalOptions="Center" AutoFitMode="Height"
                                                             ItemsSource="{Binding BankGuranteeAttachmentsListViewData}"
                                                              ItemTapped="BankGuranAttachTapped"
                                                             SelectionMode="None"
                                                             SelectionBackgroundColor="Transparent">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Column="0"
                                                                            Text="{x:Static ResourceManager:AppResources.VRAttachment}"
                                                                            Style="{StaticResource ValueLabelGrey}" />
                                                    <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                            Style="{StaticResource ValueLabelBlack}"
                                                                            HorizontalOptions="EndAndExpand"
                                                                            HorizontalTextAlignment="End" />
                                                </Grid>

                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                        <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                             Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                               Opacity=".2" IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                               HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                               Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                     Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRDeclaration}"
                                                   VerticalOptions="CenterAndExpand"
                                                   Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRIDType}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding IDType}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRIDNumber}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding IDNumber}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid IsVisible="False">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRDateOfBirth}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1"
                                                                Text="{Binding PickedDate,StringFormat='{0:dd MMM yyyy}'}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0"
                                                                Text="{x:Static ResourceManager:AppResources.VRContactPersonName}"
                                                                Style="{StaticResource ValueLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ContactPersonName}"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                HorizontalOptions="EndAndExpand"
                                                                HorizontalTextAlignment="End" />
                                    </Grid>

                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                    </StackLayout>
                </Grid>

                <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                 Opacity="0.4" VerticalOptions="FillAndExpand" />
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                 Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                           EnableAnimation="True"
                                                           AnimationType="SingleCircle"
                                                           HorizontalOptions="CenterAndExpand"
                                                           VerticalOptions="CenterAndExpand"
                                                           IsBusy="True"
                                                           ViewBoxWidth="70"
                                                           TitlePlacement="Bottom"
                                                           ViewBoxHeight="70"
                                                           TextColor="#D99A29" />
                            <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>

        </ScrollView>

    </ContentPage.Content>
</ContentPage>