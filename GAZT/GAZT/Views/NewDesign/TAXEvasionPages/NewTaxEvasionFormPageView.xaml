<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.NewTaxEvasionFormPageView">
    <ContentPage.Padding>
            <OnPlatform x:TypeArguments="Thickness">
                <On Platform="Android, UWP">0</On>
                <On Platform="iOS">0,20,0,0</On>
            </OnPlatform>
    </ContentPage.Padding>
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Entry" x:Key="EntryHeight48">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="FontFamily" Value="{StaticResource SSTArRoman}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="HeightRequest" Value="24" />
                <Setter Property="PlaceholderColor" Value="{StaticResource NeutralGreay}" />
            </Style>

            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="LightGreen"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>
            <converters:NewTaxEvasionTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" Padding="24,32,24,32"  Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!--Start Of Reporter Information-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.ReporterInfo}}">
                        <StackLayout >
                            <custom:CustomLabel Text="Reporter Name" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="Zaed" Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="Mobile Number" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" LeadingViewPosition="Inside">
                                
                                    <StackLayout Orientation="Horizontal" Margin="16,0,0,0" >
                                        <custom:BorderlessEntry  Placeholder="+966" Style="{StaticResource EntryHeight48}" />
                                        <BoxView Style="{StaticResource lineSeperator}"  WidthRequest="1" HeightRequest="20" Margin="5"/>


                                    <custom:BorderlessEntry  Text="551 234 567" Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>
                                </StackLayout>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="Reporter Location" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="Search Your location" Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>

                                <inputLayout:SfTextInputLayout.TrailingView >
                                    <Image Source="ic_location_Outline.png"/>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>



                            
                        </StackLayout>
                    </ScrollView>
                    <!--End Of Reporter Information-->
                    
                    <!--Facility Information Starts-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.FacilityInfo}}">
                        <StackLayout>
                            <custom:CustomLabel Text="Facility Name" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="Zeyad Corporation"     Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="TIN" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="111233348878999"     Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="VAT Number" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="00008878933"     Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="Region" Style="{StaticResource CaptionLabelGrey}"/>
                            <Grid>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="Riyadh Province"     Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView >
                                    <Image Source="arrowDropdown.png">
                                        
                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <custom:CustomButton   Clicked="RegionBtnClicked" BackgroundColor="Transparent"  />

                                <syncfusion:SfPicker x:Name="RegionPicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>

                            <custom:CustomLabel Text="City" Style="{StaticResource CaptionLabelGrey}"/>
                            <Grid>
                                <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                    <custom:BorderlessEntry  Text="Riyadh "     Style="{StaticResource EntryHeight48}" >
                                    </custom:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image Source="arrowDropdown.png">

                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomButton   Clicked="RegionBtnClicked" BackgroundColor="Transparent"  />

                                <syncfusion:SfPicker x:Name="CityPicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>

                            <custom:CustomLabel Text="District" Style="{StaticResource CaptionLabelGrey}"/>
                            <Grid>
                                <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                    <custom:BorderlessEntry  Text="Al-Shifa"     Style="{StaticResource EntryHeight48}" >
                                    </custom:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image Source="arrowDropdown.png">

                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomButton   Clicked="RegionBtnClicked" BackgroundColor="Transparent"  />

                                <syncfusion:SfPicker x:Name="DistrictPicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>

                            <custom:CustomLabel Text="Street" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="Olaya St, Al Wurud, Riyadh 12253" Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>

                                <inputLayout:SfTextInputLayout.TrailingView >
                                    <Image Source="ic_location_Outline.png"/>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                    </ScrollView>
                    <!--Facility Information Ends-->

                    <!--Start Of Report Details-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.ReportDetails}}">
                        <StackLayout>
                            <custom:CustomLabel Text="Report Type" Style="{StaticResource CaptionLabelGrey}"/>
                            <Grid>
                                <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                    <custom:BorderlessEntry  Text="An invoice that does not meet the......."     Style="{StaticResource EntryHeight48}" >
                                    </custom:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image Source="arrowDropdown.png">

                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomButton   Clicked="RegionBtnClicked" BackgroundColor="Transparent"  />

                                <syncfusion:SfPicker x:Name="ReportTypePicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>

                            <custom:CustomLabel Text="Report Details" Style="{StaticResource CaptionLabelGrey}"/>

                            <custom:CustomLabel Text="Attachments" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" LeadingViewPosition="Inside">
                                <inputLayout:SfTextInputLayout.LeadingView>
                                    <Image Source="newui_ic_pdf"/>
                                </inputLayout:SfTextInputLayout.LeadingView>
                                <custom:BorderlessEntry  Text="File1.pdf" Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>

                                <inputLayout:SfTextInputLayout.TrailingView >
                                    <Image Source="closeGrey.png"/>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="20MB" Margin="0,-20,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                        </StackLayout>
                    </ScrollView>
                    <!--End Of Reporter Details-->

                    <!--Start Of Summary-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.Summary}}">
                        <StackLayout>
                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout>
                                <StackLayout Orientation="Horizontal" Padding="16">
                                    <Frame Style="{StaticResource circleFrame}">
                                        <Image Source="vat_user" HeightRequest="30">
                                        
                                    </Image>
                                    </Frame>
                                    <custom:CustomLabel Text="Reporter Information" Style="{StaticResource SectionTitleBlackBold}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/>
                                        <custom:CustomLabel Text="Edit" Style="{StaticResource ValueLabelBlackBold}" TextColor="{StaticResource Primary}" WidthRequest="34" VerticalTextAlignment="Center" HorizontalOptions="EndAndExpand"/>
                                </StackLayout>

                                <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                <StackLayout Padding="15" Spacing="10">
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Reporter Name" Style="{StaticResource BodyLabelGrey}"/>
                                        <custom:CustomLabel Text="Zaed" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Mobile Number" Style="{StaticResource BodyLabelGrey}"/>
                                        <custom:CustomLabel Text="+966 551 234 567" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Reporter Location" Style="{StaticResource BodyLabelGrey}"/>
                                        <custom:CustomLabel Text="Abi Ad Darda, Ar Rawd" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Padding="16">
                                        <Frame Style="{StaticResource circleFrame}">
                                            <Image Source="ic_company.png">

                                            </Image>
                                        </Frame>
                                        <custom:CustomLabel Text="Facility Information" Style="{StaticResource SectionTitleBlackBold}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/>
                                        <custom:CustomLabel Text="Edit" Style="{StaticResource ValueLabelBlackBold}" TextColor="{StaticResource Primary}" WidthRequest="34" VerticalTextAlignment="Center" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>

                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                    <StackLayout Padding="16" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="Facility Name" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="Zayad Corporation" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="TIN" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="111233348878999" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="VAT Number" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="000008878933" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="Region" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="Riyadh Province" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="City" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="Riyadh" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="District" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="Al-Shifa" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal" Spacing="10">
                                            <custom:CustomLabel Text="Street" Style="{StaticResource BodyLabelGrey}" WidthRequest="50"/>
                                            <custom:CustomLabel Text="Olaya St, Al Wurud, Riyadh 12253" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Padding="16">
                                        <Frame Style="{StaticResource circleFrame}">
                                            <Image Source="zakat_details">

                                            </Image>
                                        </Frame>
                                        <custom:CustomLabel Text="Report Details" Style="{StaticResource SectionTitleBlackBold}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/>
                                        <custom:CustomLabel Text="Edit" Style="{StaticResource ValueLabelBlackBold}" TextColor="{StaticResource Primary}" WidthRequest="34" VerticalTextAlignment="Center"  HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>

                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                    <StackLayout Padding="15" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="Reporter Type" Style="{StaticResource BodyLabelGrey}" WidthRequest="200"/>
                                            <custom:CustomLabel Text="An Invoice that does not meet the tax specification" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="Report Details" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="Lorem ipsum" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="Attachment" Style="{StaticResource BodyLabelGrey}"/>
                                            <custom:CustomLabel Text="File1.pdf" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                            <Image Source="newui_ic_pdf.png"/>
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                        </StackLayout>
                    </ScrollView>
                    <!--End Of Summary-->

                    <StackLayout Grid.Row="0" BackgroundColor="White" Padding="0,0,0,25">
                        <commonView:PageIndicatorView Grid.Row="1" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" />

                        <custom:CustomLabel Text="{Binding PageTitle}" Style="{StaticResource PageTitleBlack}"/>
                        <custom:CustomLabel Text="{Binding BodyTitle}" Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Style="{StaticResource lineSeperator}"/>
                    </StackLayout>


                    <StackLayout Grid.Row="2">
                        <buttons:SfButton Text="Continue" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OnContinueClicked}"/>
                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

            <Grid Padding="15,10,15,10" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="20*"/>
                </Grid.ColumnDefinitions>
                <custom:CustomLabel Grid.Column="1" Text="Tax Evasion" TextColor="White" Style="{StaticResource SectionTitleBlack}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" />
                <StackLayout Grid.Column="0">
                    <Image Source="arrowLeftwhite.png"  VerticalOptions="CenterAndExpand" HorizontalOptions="Start">

                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackStepClicked}"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Grid.Column="2">
                    <Image Source="close.png" VerticalOptions="CenterAndExpand" HorizontalOptions="End">

                    </Image>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>