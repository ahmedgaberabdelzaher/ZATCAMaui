<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:gmaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.NewTaxEvasionFormPageView">
    <ContentPage.Padding>
            <OnPlatform x:TypeArguments="Thickness">
                <On Platform="Android, UWP">0</On>
                <On Platform="iOS">0,20,0,0</On>
            </OnPlatform>
    </ContentPage.Padding>
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
                
            <Style TargetType="Entry" x:Key="EntryHeight48">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="FontFamily" Value="{StaticResource SSTArRoman}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                
                <Setter Property="PlaceholderColor" Value="{StaticResource NeutralGreay}" />
            </Style>

            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="#E5EFED"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>
            <converters:NewTaxEvasionTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" Padding="24,32,24,32"  Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!--Start Of Reporter Information-->
                        <ScrollView Grid.Row="1" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.ReporterInfo}}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                        <StackLayout >
                                <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterName}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterName}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0" HasError="{Binding IsTnameHasError}"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-6,0,-6">
                                    <custom:BorderlessEntry  Text="{Binding TName}" TextChanged="TNameEntry_TextChanged" IsEnabled="False" Style="{StaticResource DefaultEntry}" >
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionMobileNumber}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionMobileNumber}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <!--<inputLayout:SfTextInputLayout FlowDirection="LeftToRight" x:Name="FrmNumber" HasError="{Binding IsTmobileHasError}" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                
                                    <StackLayout Orientation="Horizontal" Margin="16,0,0,0" >
                                        <custom:BorderlessEntry FlowDirection="LeftToRight" Placeholder="+966" IsReadOnly="True" Style="{StaticResource EntryHeight48}" />
                                        <BoxView Style="{StaticResource lineSeperator}"  WidthRequest="1" HeightRequest="20" Margin="5"/>


                                    <Entry x:Name="TMobNumber" FlowDirection="LeftToRight" TextChanged="TMobNumber_TextChanged" Text="{Binding TMobNumber}" Style="{StaticResource EntryHeight48}" IsReadOnly="True"  HorizontalOptions="FillAndExpand" MaxLength="15" >
                                </Entry>
                                </StackLayout>
                            </inputLayout:SfTextInputLayout>-->

                            <inputLayout:SfTextInputLayout FlowDirection="LeftToRight" HorizontalOptions="FillAndExpand"
                                                        ContainerType="Outlined"
                                                        x:Name="FrmNumber"
                                                        LeadingViewPosition="Inside"
                                                        UnfocusedColor="#B1B1B1"
                                                        OutlineCornerRadius="8"
                                                        FocusedColor="#005e4b"
                                                        ErrorColor="#B00020">
                        <inputLayout:SfTextInputLayout.LeadingView>

                            <Label FlowDirection="LeftToRight"
                                        Margin="0"
                                        x:Name="mobileNumberPrefix"
                                        Text="+966  |"
                                        WidthRequest="80"
                                        TextColor="Gray"
                                        FontSize="Medium"
                                        VerticalTextAlignment="Center"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"></Label>

                        </inputLayout:SfTextInputLayout.LeadingView>
                        <Entry x:Name="TMobNumber" FlowDirection="LeftToRight"
                                                        Text="{Binding TMobNumber}"
                                                        FontSize="Medium" 
                                                        HorizontalOptions="FillAndExpand"
                                                        TextColor="Black"
                                                        PlaceholderColor="Gray"
                                                        Keyboard="Telephone"
                                                        IsReadOnly="True"
                                                        >
                                                        
                        </Entry>
                    </inputLayout:SfTextInputLayout>

                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterLocation}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span  Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterLocation}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0"   Margin="0,-10,0,0">
                                <Editor  Text="{Binding RLocation}" AutoSize="TextChanges"  IsReadOnly="True" >
                                </Editor>

                                <inputLayout:SfTextInputLayout.TrailingView >
                                    <Image Source="ic_location_Outline.png"/>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <Frame  Grid.Row="4" BackgroundColor="White"   Grid.Column="0" Grid.ColumnSpan="2"  Style="{StaticResource GAZTFrameStyleForEntry}" x:Name="FrmReportLocation">
                            <gmaps:Map Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"  Margin="-12"  MapType="Street" x:Name="mapView" MapClicked="mapView_MapClicked" HeightRequest="200" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" />
                        </Frame>

                            
                        </StackLayout>
                    </ScrollView>
                    <!--End Of Reporter Information-->
                    
                    <!--Facility Information Starts-->
                        <ScrollView Grid.Row="1" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.FacilityInfo}}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                        <StackLayout>
                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionFacilityName}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionFacilityName}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <inputLayout:SfTextInputLayout x:Name="FrmFName" HasError="{Binding IsFacilityNameHasError}" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="{Binding TFaciName}" x:Name="TFaciName" Unfocused="TFaciName_Unfocused" IsSpellCheckEnabled="False" FontSize="Small" Style="{StaticResource EntryHeight48}" >
                                    <Entry.Behaviors>
                                        <customcontrol:AlphabetandArabicCharacters/>
                                    </Entry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionTIN}" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout x:Name="FrmTIN" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="{Binding TxtTIN}" x:Name="TxtTIN" Unfocused="TxtTIN_Unfocused" Style="{StaticResource EntryHeight48}" MaxLength="10" IsSpellCheckEnabled="False" Keyboard="Numeric" >
                                    <custom:BorderlessEntry.Behaviors>
                                            <customcontrol:OnlyNumericValuesBehaviour/>
                                        </custom:BorderlessEntry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionVATNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout x:Name="FrmVAT" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry  Text="{Binding TVatNumber}"  x:Name="TVatNumber" Unfocused="TVatNumber_Unfocused"  Style="{StaticResource EntryHeight48}" MaxLength="15" Keyboard="Numeric">
                                    <custom:BorderlessEntry.Behaviors>
                                            <customcontrol:OnlyNumericValuesBehaviour/>
                                        </custom:BorderlessEntry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" HasError="{Binding IsRegionHasError}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry x:Name="Region_entry" Text="{Binding TxtReportDetailRegion}" TextChanged="Region_entry_TextChanged"  Style="{StaticResource EntryHeight48}" >
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView >
                                    <Image Source="arrowDropdown.png">
                                        
                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <custom:CustomButton   Clicked="RegionBtnClicked" BackgroundColor="Transparent"  />

                                <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="RegionPicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" ItemsSource="{Binding RList}" DisplayMemberPath="Name" SelectionChanged="RegionPicker_SelectionChanged" >
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>

                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionCity}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionCity}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" HasError="{Binding IsCityHasError}" Margin="0,-10,0,0">
                                    <custom:BorderlessEntry x:Name="City_entry" TextChanged="City_entry_TextChanged" Text="{Binding TxtReportDetailCity}" Style="{StaticResource EntryHeight48}" >
                                    </custom:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image Source="arrowDropdown.png">

                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomButton Clicked="CityPickerButton_Clicked" BackgroundColor="Transparent"  />

                                <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="CityPicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" ItemsSource="{Binding CList}" DisplayMemberPath="Name" SelectionChanged="CityPicker_SelectionChanged">
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>

                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionDistrict}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionDistrict}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <!--<Grid>-->
                                <inputLayout:SfTextInputLayout x:Name="FrmFDAddress" Style="{StaticResource InputTableTextInputLayoutStyle}" HasError="{Binding IsFDHasError}" Margin="0,-10,0,0">
                                    <custom:BorderlessEntry Text="{Binding TFDAdress}" x:Name="TFDAdress" Unfocused="TFDAdress_Unfocused" Style="{StaticResource EntryHeight48}" IsSpellCheckEnabled="False"  MaxLength="100">
                                    </custom:BorderlessEntry>
                                    <!--<inputLayout:SfTextInputLayout.TrailingView >
                                        <Image Source="arrowDropdown.png">

                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>-->
                                </inputLayout:SfTextInputLayout>
                                <!--<custom:CustomButton Clicked="DistrictPickerButton_Clicked" BackgroundColor="Transparent"  />-->

                                <!--<syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="DistrictPicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>-->
                            <!--</Grid>-->

                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout  Grid.Row="2" Grid.Column="0"  HasError="{Binding IsFSHasError}" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <custom:BorderlessEntry x:Name="TFSAddress" Text="{Binding TFSAddress}" TextChanged="TFSAddress_TextChanged"  Style="{StaticResource EntryHeight48}" IsSpellCheckEnabled="False"  MaxLength="100">
                                </custom:BorderlessEntry>

                                <!--<inputLayout:SfTextInputLayout.TrailingView >
                                    <Image Source="ic_location_Outline.png"/>
                                </inputLayout:SfTextInputLayout.TrailingView>-->
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                    </ScrollView>
                    <!--Facility Information Ends-->

                    <!--Start Of Report Details-->
                        <ScrollView Grid.Row="1" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:NewTaxEvasionTabEnum.ReportDetails}}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                        <StackLayout>
                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportType}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportType}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                            <Grid>
                                <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}"  Margin="0,-10,0,0">
                                    <custom:BorderlessEntry  Text="{Binding TxtReporttype}" IsSpellCheckEnabled="False"   Style="{StaticResource EntryHeight48}" >
                                    </custom:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image Source="arrowDropdown.png">

                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomButton Clicked="ReportTypeButton_Clicked" BackgroundColor="Transparent"  />

                                <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="ReportTypePicker" HeaderHeight="55" HeaderText="" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" ItemsSource="{Binding ReportTypes}" DisplayMemberPath="Title" SelectionChanged="ReportTypePicker_SelectionChanged">
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>

                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportDetails}" Style="{StaticResource CaptionLabelGrey}"/>-->
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportDetails}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout x:Name="FrmReportDetail" HasError="{Binding IsReportDetailHasError}" Margin="0,-6,0,-6"
                                    ContainerType="Outlined" UnfocusedColor="#B1B1B1" 
                                    OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" >
                                    <StackLayout Orientation="Vertical" Margin="0,16,0,0">
                                         <Editor  MaxLength="999"
                                                IsSpellCheckEnabled="False"
                                                Text="{Binding TReportDetail}"
                                                FontSize= "Small"
                                                x:Name="TReportDetail"
                                                HorizontalOptions="FillAndExpand"
                                                AutoSize="TextChanges"
                                                Unfocused="TReportDetail_Unfocused"></Editor>
                                        
                                            <custom:CustomLabel  Text="{Binding
                                                    Source={x:Reference TReportDetail},
                                                    Path=Text.Length, StringFormat='{0}/999'}"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    HorizontalOptions="EndAndExpand" VerticalOptions="Start" VerticalTextAlignment="Start" FontSize="Micro"/>
                                    </StackLayout>
                                      
                                        
                            </inputLayout:SfTextInputLayout>


                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionAttachments}" x:Name="Attachment_Label" Style="{StaticResource CaptionLabelGrey}"/>
                            <Grid>
                                <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" LeadingViewPosition="Inside">
                                    <inputLayout:SfTextInputLayout.LeadingView>
                                        <Image Source="ic_attachment" x:Name="Attachment_Tmg"/>
                                    </inputLayout:SfTextInputLayout.LeadingView>
                                    <custom:BorderlessEntry  Text="" x:Name="Attachment_Frm"  Style="{StaticResource EntryHeight48}" IsReadOnly="True" >
                                    </custom:BorderlessEntry>

                                   <!-- <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image Source="closeGrey.png"/>
                                    </inputLayout:SfTextInputLayout.TrailingView> -->
                                </inputLayout:SfTextInputLayout>
                                <custom:CustomButton Command="{Binding OnAttachmentClick}" BackgroundColor="Transparent"  />
                            </Grid>

                            <!--Attachment List-->
                            <listView:SfListView  AutoFitMode="DynamicHeight" 
                                                  ItemsSource="{Binding UploadedDocumentsListObj}" SelectionBackgroundColor="White"
                                                  HorizontalOptions="FillAndExpand"
                                                  HeightRequest="300"
                                                  VerticalOptions="Start"
                                                  BackgroundColor="White"
                                                  >
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout>
                                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,0,0,0" LeadingViewPosition="Inside">
                                                <inputLayout:SfTextInputLayout.LeadingView>
                                                        <Image Source="{Binding CorrespondingImageAccoringtoext}" x:Name="Attachment_Tmg"/>
                                                </inputLayout:SfTextInputLayout.LeadingView>
                                                <custom:BorderlessEntry  Text="{Binding FileNameWithExtension}" x:Name="Attachment_Frm"  Style="{StaticResource EntryHeight48}" IsReadOnly="True">
                                                </custom:BorderlessEntry>

                                                <inputLayout:SfTextInputLayout.TrailingView >
                                                    <Image Source="closeGrey.png">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked"/>
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </inputLayout:SfTextInputLayout.TrailingView>
                                            </inputLayout:SfTextInputLayout>
