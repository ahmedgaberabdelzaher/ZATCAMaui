<?xml version="1.0" encoding="utf-8" ?>
    <ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:control="clr-namespace:GAZT"
                 NavigationPage.HasNavigationBar="False"
                 BackgroundImageSource="partials_background.png"
                 FlowDirection="LeftToRight"
                 xmlns:custom="clr-namespace:GAZT"
                 xmlns:local="clr-namespace:EGAZT.CustomControl"
                 xmlns:FontImage="clr-namespace:MVP.FontIcons"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
                  xmlns:custom1="clr-namespace:GAZT.CustomControl"  xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.TaxEvasionVerifyMobileNumberPage">
        <ContentPage.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                    <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </ContentPage.Resources>
        <ContentPage.Padding>
            <OnPlatform x:TypeArguments="Thickness">
                <On Platform="Android, UWP">0</On>
                <On Platform="iOS">0,20,0,0</On>
            </OnPlatform>
        </ContentPage.Padding>
         <ContentPage.ControlTemplate>
            <ControlTemplate>
                <ScrollView>
                    <Grid>

                    <StackLayout>
                        <Grid Padding="10,5,10,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15*"/>
                                <ColumnDefinition Width="70*"/>
                                <ColumnDefinition Width="15*"/>
                            </Grid.ColumnDefinitions>

                            <custom:CustomLabel Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}"
                                   Style="{StaticResource SectionTitleWhiteBold}"
                                   HorizontalOptions="Center"/>
                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                        <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                            <Grid HorizontalOptions="FillAndExpand"
                                  VerticalOptions="FillAndExpand"
                                  Margin="0" 
                                  Padding="0,0,0,0"
                                  BackgroundColor="White"
                                  x:Name="VATRMainGrid">

                                <Grid.RowDefinitions>
                                    <!--<RowDefinition Height="10*" />-->
                                    <RowDefinition Height="100*" />

                                </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                                  HorizontalOptions="FillAndExpand"
                                                  Grid.Column="0"
                                                  Grid.Row="0"
                                                  BackgroundColor="White"/>
                        </Grid>
                        </yummy:PancakeView>
                    </StackLayout>

                </Grid>
                    </ScrollView>
            </ControlTemplate>
        </ContentPage.ControlTemplate>
        <ContentPage.Content>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackLayout Grid.Row="0" Margin="10,0,10,0" Padding="10">
                    <Grid 
                        Margin="0,15,0,0"
                                  BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="1"
                                       Source="ic_logo_gazt.png"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       />



                        <Image Grid.Column="2" IsVisible="false">
                            <Image.Source>
                                <FontImageSource Color="White"
                                                         FontFamily="UserIconFont"
                                                         Glyph="{x:Static FontImage:IconFonts.Close}"/>
                            </Image.Source>
                        </Image>
                    </Grid>
                    <control:CustomLabel Text="{Binding PageTitle}"
                                             Style="{StaticResource SectionTitleBlack}" />
                    <control:CustomLabel Text="{Binding PageTitleTag}"
                                             Style="{StaticResource BodyLabelGrey}"/>
                    <BoxView BackgroundColor="{StaticResource NeutralGreay}"
                                     HeightRequest="1"/>
                </StackLayout>

                <!--Input For Mobile Number-->
                <StackLayout Grid.Row="1" Padding="10" Margin="10,0,10,0" IsVisible="{Binding IsShowMobileInput}">
        
                    <control:CustomLabel   Style="{StaticResource CaptionLabelGrey}" Grid.Row="0"   Padding="0,0,0,0">

                        <control:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.MobileNumber}"/>
                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                            </FormattedString>
                        </control:CustomLabel.FormattedText>
                    </control:CustomLabel>

                    <inputLayout:SfTextInputLayout FlowDirection="LeftToRight" HorizontalOptions="FillAndExpand"
                                                        ContainerType="Outlined"
                                                        x:Name="frmMobile"
                                                        LeadingViewPosition="Inside"
                                                        UnfocusedColor="#B1B1B1"
                                                        OutlineCornerRadius="8"
                                                        FocusedColor="#005e4b"
                                                        ErrorColor="#B00020">
                        <inputLayout:SfTextInputLayout.LeadingView>

                            <Label FlowDirection="LeftToRight"
                                        Margin="0"
                                        x:Name="mobileNumberPrefix"
                                        Text="+966  |"
                                        WidthRequest="80"
                                        TextColor="Gray"
                                        FontSize="Medium"
                                        VerticalTextAlignment="Center"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"></Label>

                        </inputLayout:SfTextInputLayout.LeadingView>
                        <Entry x:Name="Mobile_Entry" FlowDirection="LeftToRight"
                                                        Text="{Binding MobileNumber}"
                                                        Unfocused="Mobile_Entry_Unfocused"
                                                        FontSize="Medium"
                                                        HorizontalOptions="FillAndExpand"
                                                        TextColor="Black"
                                                        PlaceholderColor="Gray"
                                                        Keyboard="Telephone"
                                                        MaxLength="9">
                            <Entry.Behaviors>
                                <custom1:OnlyNumericValuesBehaviour/>
                            </Entry.Behaviors>
                        </Entry>
                    </inputLayout:SfTextInputLayout>

                </StackLayout>

                <!--Input for OTP Verification-->
                <StackLayout Grid.Row="1" Padding="0,15,0,0" Margin="10,0,10,0" IsVisible="{Binding IsShowOTPInput}">
                    <custom:CustomLabel Text="{Binding OTPSentOnThisMobileNumber}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Center"  HorizontalTextAlignment="Center"/>
                    <custom:CustomLabel FlowDirection="LeftToRight" Text="{Binding EncriptedMobileNumber}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Center"  HorizontalTextAlignment="Center"/>

                    <Grid ColumnSpacing="20" Padding="30,20,30,20" FlowDirection="LeftToRight">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!--First OTP Digit Start-->
                        <inputLayout:SfTextInputLayout
                                            Grid.Column="0"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                            <custom:BorderlessEntry
                                                x:Name="OTPFirstEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPFirstDigit}"
                                                TextChanged="OtpFirstEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                <custom:BorderlessEntry.Behaviors>
                                    <local:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry"/>
                                </custom:BorderlessEntry.Behaviors>
                            </custom:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <!--First OTP Digit End-->

                        <!--Second OTP Digit Start-->
                        <inputLayout:SfTextInputLayout
                                            Grid.Column="1"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                            <custom:BorderlessEntry
                                                x:Name="OTPSecondEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPSecondDigit}"
                                                TextChanged="OtpSecondEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                <custom:BorderlessEntry.Behaviors>
                                    <local:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry"/>
                                </custom:BorderlessEntry.Behaviors>
                            </custom:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <!--Second OTP Digit End-->

                        <!--Third OTP Digit Start-->
                        <inputLayout:SfTextInputLayout
                                            Grid.Column="2"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                            <custom:BorderlessEntry
                                                x:Name="OTPThirdEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPThirdDigit}"
                                                TextChanged="OtpThirdEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                <custom:BorderlessEntry.Behaviors>
                                    <local:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry"/>
                                </custom:BorderlessEntry.Behaviors>
                            </custom:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <!--Third OTP Digit End-->

                        <!--Fourth OTP Digit Start-->
                        <inputLayout:SfTextInputLayout
                                            Grid.Column="3"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                            <custom:BorderlessEntry
                                                x:Name="OTPFourthEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPFourthDigit}"
                                                TextChanged="OtpFourthEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand"
                                                Unfocused="OtpFourthEntry_Unfocused">
                            </custom:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <!--Fourth OTP Digit End-->

                    </Grid>

                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                        <Image Source="clock">
                        </Image>
                        <custom:CustomLabel  Text="{Binding LblCountDownTimer}"
                                                     Style="{StaticResource CaptionLabelGrey}"
                                                     VerticalOptions="Center" />
                    </StackLayout>
                    <buttons:SfButton  Command="{Binding ResendOTPCommand}"
                                               IsEnabled="{Binding IsResendOTPEnabled}"
                                               Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                               VerticalOptions="StartAndExpand"
                                               Margin="0,50,0,0" FontFamily="{StaticResource SSTArRoman}"
                                               BackgroundColor="Transparent"
                                               TextColor="{Binding ResendOtpButtonColor}"/>
                </StackLayout>

                <!--Continue button-->
                <buttons:SfButton  Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"      Clicked="btn_Continue_ClickedAsync"
                                      
                                      Grid.Row="2"
                                      HorizontalOptions="FillAndExpand"
                                      IsVisible="{Binding IsShowMobileInput}"
                                      Margin="20,5,20,20"
                                      Style="{StaticResource PrimaryButtonStyle}"/>

            </Grid>
            <Grid Grid.Row="0" Grid.Column="0"  IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" EnableAnimation="True" AnimationType="SingleCircle" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" IsBusy="True" ViewBoxWidth = "70" TitlePlacement="Bottom" ViewBoxHeight="70" TextColor="{StaticResource Secondary}"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
          
        </ContentPage.Content>
    </ContentPage>
