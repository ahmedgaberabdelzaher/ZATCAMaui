<?xml version="1.0" encoding="utf-8" ?>
    <ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:control="clr-namespace:GAZT"
                 NavigationPage.HasNavigationBar="False"
                 BackgroundImageSource="partials_background.png"
                 FlowDirection="LeftToRight"
                 
                 xmlns:custom="clr-namespace:GAZT"
                 xmlns:local="clr-namespace:EGAZT.CustomControl"
                 xmlns:FontImage="clr-namespace:MVP.FontIcons"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
                 xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
                 x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.TaxEvasionVerifyMobileNumberPage">
        <ContentPage.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                    <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </ContentPage.Resources>
        <ContentPage.Padding>
            <OnPlatform x:TypeArguments="Thickness">
                <On Platform="Android, UWP">0</On>
                <On Platform="iOS">0,20,0,0</On>
            </OnPlatform>
        </ContentPage.Padding>
         <ContentPage.ControlTemplate>
            <ControlTemplate>
                <Grid>

                    <StackLayout>
                        <Grid Padding="0,5,0,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="60*"/>
                                <ColumnDefinition Width="20*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{x:Static ResourceManager:AppResources.ZTEReportReportScreenTitle}"
                                   Style="{StaticResource SectionTitleWhiteBold}"
                                   HorizontalOptions="Center"/>
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   IsVisible="{Binding IsBackStepButtonVisible}"
                                   Style="{StaticResource IconLabelStyle}"
                                   Text="{DynamicResource StyleReverseBack}"
                                   TextColor="White"
                                   VerticalOptions="CenterAndExpand"
                                   HorizontalOptions="StartAndExpand">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" ></TapGestureRecognizer>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                            <Grid HorizontalOptions="FillAndExpand"
                                  VerticalOptions="FillAndExpand"
                                  Margin="0" 
                                  Padding="0,15,0,0"
                                  BackgroundColor="White"
                                  x:Name="VATRMainGrid">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10*" />
                                    <RowDefinition Height="90*" />

                                </Grid.RowDefinitions>
                                <ContentPresenter VerticalOptions="FillAndExpand"
                                                  HorizontalOptions="FillAndExpand"
                                                  Grid.Column="0"
                                                  Grid.Row="1"
                                                  BackgroundColor="White"/>
                            <Grid Grid.Row="0"
                                  BackgroundColor="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="1"
                                       Source="ic_logo_gazt.png"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       />

                                <!--<Label Grid.Column="0"
                                       x:Name="Image_backArrow"
                                       Grid.Row="0"
                                       Margin="10,0,10,0"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center"
                                       Style="{StaticResource IconLabelStyle}"
                                       Text="{StaticResource Back}"
                                       Rotation="270">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" ></TapGestureRecognizer>
                                    </Label.GestureRecognizers>
                                </Label>-->

                                <Image Grid.Column="2" IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource Color="White"
                                                         FontFamily="UserIconFont"
                                                         Glyph="{x:Static FontImage:IconFonts.Close}"/>
                                    </Image.Source>
                                </Image>
                            </Grid>
                            </Grid>
                        </yummy:PancakeView>
                    </StackLayout>

                </Grid>
            </ControlTemplate>
        </ContentPage.ControlTemplate>
        <ContentPage.Content>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                    <!--Mobile Number Input View-->
                    <ScrollView Grid.Row="0" IsVisible="False">
                        <StackLayout Padding="10">
                            <!--View  Title Header-->
                            <control:CustomLabel Text="{x:Static ResourceManager:AppResources.ZTEReportReportScreenTitle}"
                                                 Style="{StaticResource SectionTitleBlack}" />
                            <control:CustomLabel Text="{x:Static ResourceManager:AppResources.EnterNewMobileNumber}"
                                                 Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}"
                                     HeightRequest="1"/>

                            <!--Input For Mobile Number-->
                            <control:CustomLabel  Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}"
                                                                  Padding="0,0,0,0"
                                                                  Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout x:Name="frmMobileNumner"
                                                            Margin="0,-6,0,-6" 
										                    ContainerType="Outlined"
                                                            UnfocusedColor="#B1B1B1"
										                    OutlineCornerRadius="8"
                                                            FocusedColor="#005e4b"
                                                            ErrorColor="#B00020"
                                                            HasError="False">
                                <control:BorderlessEntry Text="{Binding MobileNumber}"
                                                            MaxLength="{Binding MaxDigids}"
                                                            IsReadOnly="{Binding IsNameVisible}"
                                                            x:Name="entryNumber"
                                                            Placeholder="{x:Static ResourceManager:AppResources.NDTypeyourIDNumber}"
                                                            TextColor="#bbbbbb" >
                                </control:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView >
                                    <Label HorizontalOptions="End"
                                            IsEnabled="{Binding IsTooltipEnableVisible}"
                                            IsVisible="{Binding IsTooltipEnableVisible}"
                                            Margin="0,0,0,4"
                                            FontSize="Title"
                                            VerticalOptions="Center"
                                            Style="{StaticResource IconLabelStyle}"
                                            TextColor="#005e4b"
                                            Text="{StaticResource Help}"  >
                                        <!--<Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                        </Label.GestureRecognizers>-->
                                    </Label>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>
                    </ScrollView>
                <!--Verification Code View-->
                <ScrollView Grid.Row="0" IsVisible="true">
                    <StackLayout Padding="10">
                        <!--View  Title Header-->
                            <control:CustomLabel Text="{x:Static ResourceManager:AppResources.VerificationCode}"
                                                 Style="{StaticResource SectionTitleBlack}" />
                            <control:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}"
                                                 Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView BackgroundColor="{StaticResource NeutralGreay}"
                                     HeightRequest="1"/>

                        <!--Input for OTP Verification--> 
                        <StackLayout Padding="0,15,0,0" >
                            <custom:CustomLabel Text="{Binding OTPSentOnThisMobileNumber}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Center"  HorizontalTextAlignment="Center"/>

                            <StackLayout Padding="0,0,0,0" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,20,30,20" FlowDirection="LeftToRight">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <!--First OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                            Grid.Column="0"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                x:Name="OTPFirstEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPFirstDigit}"
                                                TextChanged="OtpFirstEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
                                                    <local:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry"/>
                                                </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--First OTP Digit End-->

                                        <!--Second OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                            Grid.Column="1"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                x:Name="OTPSecondEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPSecondDigit}"
                                                TextChanged="OtpSecondEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
                                                    <local:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry"/>
                                                </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--Second OTP Digit End-->

                                        <!--Third OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                            Grid.Column="2"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                x:Name="OTPThirdEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPThirdDigit}"
                                                TextChanged="OtpThirdEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
                                                    <local:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry"/>
                                                </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--Third OTP Digit End-->

                                        <!--Fourth OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                            Grid.Column="3"
                                            ContainerType="Outlined"
                                            UnfocusedColor="#B1B1B1"
                                            OutlineCornerRadius="8"
                                            FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                x:Name="OTPFourthEntry"
                                                FontAttributes="Bold"
                                                FontSize="Small"
                                                WidthRequest="8"
                                                HorizontalTextAlignment="Center"
                                                IsEnabled="{Binding IsOTPEntryEnable}"
                                                Text="{Binding OTPFourthDigit}"
                                                TextChanged="OtpFourthEntry_TextChanged"
                                                ReturnType="Next"
                                                Keyboard="Numeric"
                                                MaxLength="1"
                                                TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand"
                                                Unfocused="OtpFourthEntry_Unfocused">
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--Fourth OTP Digit End-->

                                    </Grid>
                                           

                                </Grid>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                                <Image Source="clock">
                                </Image>
                                <custom:CustomLabel  Text="{Binding LblCountDownTimer}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                            </StackLayout>
                            <buttons:SfButton  Command="{Binding OnResendOTPClicked}" IsEnabled="{Binding IsResendOTPEnabled}" Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}" VerticalOptions="EndAndExpand" Margin="0,50,0,0" BackgroundColor="Transparent" TextColor="{StaticResource NewDarkBlueGreenColor}"/>
                        </StackLayout>

                    </StackLayout>
                </ScrollView>
                <!--Continue button-->
                <StackLayout Grid.Row="1"
                             HorizontalOptions="Center"
                             Padding="10,5,10,20" >
                    <buttons:SfButton Text="{Binding ZZZZContinue}"
                                      Clicked="btn_Continue_Clicked"
                                      Style="{StaticResource PrimaryButtonStyle}"/>
                </StackLayout>
            

            </Grid>
        </ContentPage.Content>
    </ContentPage>
