<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.TaxEvasionPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1">
                        <StackLayout>
                            <border:SfBorder Margin="0,0,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="15,10,15,10"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image Source="ic_add_plus.png" />
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelPrimary}"
                                        Text="Tax Evasion Report" />
                                </StackLayout>
                            </border:SfBorder>
                            <!--  CARD One Start  -->
                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0" Spacing="0">
                                    <StackLayout Padding="17,16,17,16" Orientation="Horizontal">
                                        <StackLayout Spacing="-10">
                                            <custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}" Text="Zayad Corporation" />
                                            <custom:CustomLabel
                                                FontSize="Small"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="00894790088"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                            <buttons:SfButton
                                                Padding="12,0,12,0"
                                                BackgroundColor="{StaticResource LightGreenColor}"
                                                CornerRadius="15"
                                                HeightRequest="32"
                                                Text="Open"
                                                TextColor="{StaticResource Primary}" />
                                        </StackLayout>
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout Padding="17,16,17,16" Spacing="0">
                                        <custom:CustomLabel
                                            FontSize="Small"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="Report Date"
                                            VerticalOptions="CenterAndExpand" />
                                        <custom:CustomLabel
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="06th May 2020"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                            <!--  CARD One End  -->

                            <!--  CARD Two Starts  -->
                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0" Spacing="0">
                                    <StackLayout Padding="17,16,17,16" Orientation="Horizontal">
                                        <StackLayout Spacing="-10">
                                            <custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}" Text="Zayad Corporation" />
                                            <custom:CustomLabel
                                                FontSize="Small"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="00894790088"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                            <buttons:SfButton
                                                Padding="12,0,12,0"
                                                BackgroundColor="Maroon"
                                                CornerRadius="15"
                                                HeightRequest="32"
                                                Text="Closed"
                                                TextColor="{StaticResource Secondary}" />
                                        </StackLayout>
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout Padding="17,16,17,16" Spacing="0">
                                        <custom:CustomLabel
                                            FontSize="Small"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="Report Date"
                                            VerticalOptions="CenterAndExpand" />
                                        <custom:CustomLabel
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="06th May 2020"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                            <!--  CARD Two Ends  -->
                        </StackLayout>
                    </ScrollView>

                    <StackLayout
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        BackgroundColor="White">
                        <custom:CustomLabel Style="{StaticResource PageTitleBlack}" Text="My Reports" />
                        <StackLayout Orientation="Horizontal" Spacing="24">
                            <buttons:SfButton
                                Padding="12,0,12,0"
                                BackgroundColor="White"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="15"
                                HeightRequest="32"
                                Style="{StaticResource CaptionButtonBlack}"
                                Text="Open" />
                            <buttons:SfButton
                                Padding="12,0,12,0"
                                BackgroundColor="White"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="15"
                                HeightRequest="32"
                                Style="{StaticResource CaptionButtonBlack}"
                                Text="Closed" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

            <Grid Grid.Row="0" Padding="15,10,15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="20*" />
                </Grid.ColumnDefinitions>
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="Tax Evasion"
                    TextColor="White"
                    VerticalOptions="Center" />
                <StackLayout Grid.Column="0">
                    <Image
                        HorizontalOptions="Start"
                        Source="arrowLeftwhite"
                        VerticalOptions="CenterAndExpand" />
                </StackLayout>

                <StackLayout Grid.Column="2">
                    <Image
                        HorizontalOptions="End"
                        Source="search"
                        VerticalOptions="CenterAndExpand" />
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>