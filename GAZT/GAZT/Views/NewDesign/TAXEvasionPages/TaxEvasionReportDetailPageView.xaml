<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
              xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
               xmlns:gmaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps"
             x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.TaxEvasionReportDetailPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Entry" x:Key="EntryHeight48">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="HeightRequest" Value="24" />
                <Setter Property="PlaceholderColor" Value="{StaticResource NeutralGreay}" />
            </Style>

            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundGray}"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>
            <converters:NewTaxEvasionTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.NDTaxEvasion}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <ScrollView Grid.Row="1" >
            <StackLayout Padding="15">
                <Grid BindingContext="{Binding SelectedTaxEvasionListItem}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <custom:CustomLabel HorizontalOptions="StartAndExpand" Text="{Binding CompanyName}" Style="{StaticResource PageTitleBlack}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/>
                    <yummy:PancakeView  Padding="10,10,10,10" CornerRadius="14" Grid.Row="0" Grid.Column="1"  HeightRequest="24" BorderThickness="1" BackgroundColor="{Binding FrameColorHighlight}"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                        <custom:CustomLabel Text="{Binding Status}" Style="{StaticResource CaptionLabelGrey}" TextColor="{Binding TextColorHighlight}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                            <custom:CustomLabel.Triggers>
                                <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.ZTEReportReportOpen}">
                                    <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Status}"  Value="{x:Static ResourceManager:AppResources.ZTEReportStatusCompleted}">
                                    <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                                </DataTrigger>
                            </custom:CustomLabel.Triggers>
                        </custom:CustomLabel>
                        <yummy:PancakeView.Triggers>
                            <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.ZTEReportReportOpen}">
                                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundGray}" />
                            </DataTrigger>
                            <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}"  Value="{x:Static ResourceManager:AppResources.ZTEReportStatusCompleted}">
                                <Setter Property="BackgroundColor" Value="#F5F5F5"/>
                            </DataTrigger>
                        </yummy:PancakeView.Triggers>
                    </yummy:PancakeView>
                </Grid>
                
                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>
                        <StackLayout Orientation="Horizontal" Padding="16">
                            <Image Source="vat_user" HeightRequest="30"/>
                            <!--<Frame Style="{StaticResource circleFrame}" BackgroundColor="{StaticResource BackgroundGray}">
                                


                            </Frame>-->
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDReporterInformation}" Style="{StaticResource SectionTitleBlackBold}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/>
                        </StackLayout> 

                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                        <StackLayout Padding="15" Spacing="10">
                            <StackLayout Orientation="Horizontal" BindingContext="{Binding SelectedTaxEvasionListItem}" >
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterName}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding Username}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                            </StackLayout> 
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionMobileNumber}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.PhoneNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                            </StackLayout> 
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReporterLocation}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text=" " Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout>
                            <Frame   BackgroundColor="White"     Style="{StaticResource GAZTFrameStyleForEntry}" x:Name="FrmReportLocation">
                                <gmaps:Map Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"  Margin="-12"  MapType="Street" IsEnabled="False" x:Name="mapView" HeightRequest="200" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" />
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                </border:SfBorder>

                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>
                        <StackLayout Orientation="Horizontal" Padding="16">
                            <Image Source="ic_company.png"/>
                            <!--<Frame Style="{StaticResource circleFrame}" BackgroundColor="{StaticResource BackgroundGray}">
                                


                            </Frame>-->
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDFacilityInformation}" Style="{StaticResource SectionTitleBlackBold}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/> 
                        </StackLayout>

                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                        <StackLayout Padding="16" Spacing="10">
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionFacilityName}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.CompanyName}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                            </StackLayout> 
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionTIN}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.Tin}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                            </StackLayout> 
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionVATNumber}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.VatNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.RegionNameAr}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout> 
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionCity}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.City}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionDistrict}" Style="{StaticResource BodyLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.District}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout> 
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}" Style="{StaticResource BodyLabelGrey}" WidthRequest="50"/>
                                <custom:CustomLabel Text="{Binding SelectedTaxEvasionListItem.Street}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </border:SfBorder>

                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>
                        <StackLayout Orientation="Horizontal" Padding="16">
                             <Image Source="zakat_details"/>
                            <!--<Frame Style="{StaticResource circleFrame}" BackgroundColor="{StaticResource BackgroundGray}">
                               


                            </Frame>-->
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportDetails}" Style="{StaticResource SectionTitleBlackBold}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center"/>
                        </StackLayout>

                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                        <StackLayout Padding="15" Spacing="10">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportType}" Style="{StaticResource BodyLabelGrey}" WidthRequest="200"/>
                                <Label Grid.Row="0" Grid.Column="2" Text="{Binding SelectedTaxEvasionListItem.Category}"  Style="{StaticResource BodyLabelGrey}" TextColor="{StaticResource BlackLabelTextColor}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </Grid>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReportDetails}" Style="{StaticResource BodyLabelGrey}"/>
                                <Label Text="{Binding SelectedTaxEvasionListItem.Content}" Style="{StaticResource BodyLabelGrey}" TextColor="{StaticResource BlackLabelTextColor}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </border:SfBorder>
            </StackLayout>
        </ScrollView>

    </ContentPage.Content>
</ContentPage>