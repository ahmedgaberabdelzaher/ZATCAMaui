<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"             
            xmlns:local="clr-namespace:EGAZT" 
            x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.NewTaxEvasionFormSuccessPaveView"
             BackgroundImageSource="partials_background">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <ContentPage.Content>
        <!--<ScrollView>-->
            <StackLayout Padding="0,0,0,10" VerticalOptions="FillAndExpand">
                <StackLayout Padding="40" VerticalOptions="CenterAndExpand" BackgroundColor="Transparent">
                    <Image Source="Forget_ic_success.png"   Aspect="AspectFit"/>
                    <Label  Text="{x:Static local:AppResources.NDTaxEvasionReport}" FontFamily="{StaticResource SomarBold}"  FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                    <Label  Text="{Binding SuccessResponse}"  FontFamily="{StaticResource SomarSemiBold}"
                       TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </StackLayout>
                
                <buttons:SfButton x:Name="btnDashboard" FontFamily="{StaticResource SomarSemiBold}" Text="{x:Static local:AppResources.NDTaxEvasion}"  CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      Clicked="btnDashboard_Clicked"  Margin="10,10,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource PrimaryButtonStyle}"  />
            <buttons:SfButton x:Name="btnReportList"  Text="{x:Static local:AppResources.NDTaxEvasion}" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="46" Clicked="OnGotoReportPageClicked"  FontFamily="{StaticResource SomarSemiBold}"  Margin="10,0,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource PrimaryButtonStyle}"  BackgroundColor="Transparent" TextColor="White"  />
                <!--TextColor="{StaticResource Green}"-->
            </StackLayout>
        <!--</ScrollView>-->
    </ContentPage.Content>
</ContentPage>






















