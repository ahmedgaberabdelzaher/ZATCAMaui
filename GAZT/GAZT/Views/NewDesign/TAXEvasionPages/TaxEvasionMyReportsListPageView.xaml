<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EGAZT.Views.NewDesign.TAXEvasionPages.TaxEvasionMyReportsListPageView"  xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                xmlns:FontImage="clr-namespace:MVP.FontIcons"
             NavigationPage.HasBackButton="False" 
             NavigationPage.HasNavigationBar="False"
             xmlns:custom="clr-namespace:GAZT" 
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="70*"/>
                            <ColumnDefinition Width="15*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.NDTaxEvasion}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,0,0,0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid Margin="10,15,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackLayout Margin="0,0,0,0" Grid.Row="1">
                    <ListView  x:Name="ListView_TaxEvasionReportList"  
           ItemsSource="{Binding ListToDisplay,Mode=TwoWay}"
                                           IsVisible="{Binding IsReportListVisible}"
                                  VerticalScrollBarVisibility="Never"    
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                 BackgroundColor="White"     SelectedItem="{Binding SelectedTaxEvasionListItem}" ItemTapped="ListView_TaxEvasionReportList_ItemTapped"
            SeparatorVisibility="None" >
                        <x:Arguments>
                            <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                        </x:Arguments>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="0" Spacing="0">
                                            <StackLayout Orientation="Horizontal" Padding="17,16,17,16">
                                                <StackLayout Spacing="-10">
                                                    <custom:CustomLabel Text="{Binding CompanyName}" Style="{StaticResource SectionTitleBlackBold}"/>
                                                    <custom:CustomLabel Text="{Binding TicketId}" Style="{StaticResource CaptionLabelGrey}"  VerticalOptions="CenterAndExpand"  FontSize="Small" />
                                                </StackLayout>
                                                <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                                    <buttons:SfButton FontFamily="{StaticResource SSTArRoman}" Text="{Binding Status}" HeightRequest="32"  Padding="12,0,12,0" CornerRadius="15">
                                                        <!--BackgroundColor="{StaticResource LightGreenColor}"
                                                        TextColor="{StaticResource Primary}"-->
                                                        <buttons:SfButton.Triggers>
                                                            <DataTrigger TargetType="buttons:SfButton" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.ZTEReportReportOpen}">
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                                <Setter Property="BackgroundColor" Value="#E5EFED" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="buttons:SfButton" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.ZTEReportStatusCompleted}">
                                                                <Setter Property="TextColor" Value="#aa0c19" />
                                                                <Setter Property="BackgroundColor" Value="#F6E6E8" />
                                                            </DataTrigger>
                                                        </buttons:SfButton.Triggers>
                                                    </buttons:SfButton>
                                                </StackLayout>
                                            </StackLayout>

                                            <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                            <StackLayout Padding="17,16,17,16" Spacing="0">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZTEReportReportDate}" Style="{StaticResource CaptionLabelGrey}"  VerticalOptions="CenterAndExpand"  FontSize="Small" />
                                                <StackLayout HorizontalOptions="Start">
                                                    <custom:CustomLabel  FlowDirection="LeftToRight" Text="{Binding CreatedAt}" Style="{StaticResource ValueLabelBlack}"  VerticalOptions="CenterAndExpand"  />
                                                </StackLayout>
                                                
                                            </StackLayout>
                                        </StackLayout>
                                    </border:SfBorder>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <custom:CustomLabel Margin="0,20,0,0"  Text="{x:Static ResourceManager:AppResources.NoReportsAvailable}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsNoReportLabelVisible}"/>
                </StackLayout>
                <!--<ScrollView Grid.Row="1">
                <StackLayout>
                    <border:SfBorder Margin="0,0,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Orientation="Horizontal" Spacing="10" Padding="15,10,15,10">
                            <Image Source="ic_add_plus.png">

                            </Image>
                            <custom:CustomLabel Text="Tax Evasion Report" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                        </StackLayout>
                    </border:SfBorder>
                    -->
                <!--CARD One Start-->
                <!--
                    <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0" Spacing="0">
                            <StackLayout Orientation="Horizontal" Padding="17,16,17,16">
                                <StackLayout Spacing="-10">
                                    <custom:CustomLabel Text="Zayad Corporation" Style="{StaticResource SectionTitleBlackBold}"/>
                                    <custom:CustomLabel Text="00894790088" Style="{StaticResource CaptionLabelGrey}"  VerticalOptions="CenterAndExpand"  FontSize="Small" />
                                </StackLayout>
                                <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                    <buttons:SfButton  Text="Open" HeightRequest="32" TextColor="{StaticResource Primary}" Padding="12,0,12,0" CornerRadius="15" BackgroundColor="{StaticResource LightGreenColor}"/>
                                </StackLayout>
                            </StackLayout>

                            <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                            <StackLayout Padding="17,16,17,16" Spacing="0">
                                <custom:CustomLabel Text="Report Date" Style="{StaticResource CaptionLabelGrey}"  VerticalOptions="CenterAndExpand"  FontSize="Small" />
                                <custom:CustomLabel Text="06th May 2020" Style="{StaticResource ValueLabelBlack}"  VerticalOptions="CenterAndExpand"  />
                            </StackLayout>
                        </StackLayout>
                    </border:SfBorder>
                    -->
                <!--CARD One End-->

                <!--CARD Two Starts-->
                <!--
                    <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0" Spacing="0">
                            <StackLayout Orientation="Horizontal" Padding="17,16,17,16">
                                <StackLayout Spacing="-10">
                                    <custom:CustomLabel Text="Zayad Corporation" Style="{StaticResource SectionTitleBlackBold}"/>
                                    <custom:CustomLabel Text="00894790088" Style="{StaticResource CaptionLabelGrey}"  VerticalOptions="CenterAndExpand"  FontSize="Small" />
                                </StackLayout>
                                <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                    <buttons:SfButton  Text="Closed" HeightRequest="32" TextColor="#d99a29" Padding="12,0,12,0" CornerRadius="15" BackgroundColor="Maroon"/>
                                </StackLayout>
                            </StackLayout>

                            <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                            <StackLayout Padding="17,16,17,16" Spacing="0">
                                <custom:CustomLabel Text="Report Date" Style="{StaticResource CaptionLabelGrey}"  VerticalOptions="CenterAndExpand"  FontSize="Small" />
                                <custom:CustomLabel Text="06th May 2020" Style="{StaticResource ValueLabelBlack}"  VerticalOptions="CenterAndExpand"  />
                            </StackLayout>
                        </StackLayout>
                    </border:SfBorder>
                    -->
                <!--CARD Two Ends-->
                <!--
                </StackLayout>
            </ScrollView>--> 

                <StackLayout Grid.Row="0" BackgroundColor="White" Padding="0,0,0,0">
                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.NDMyReports}" Style="{StaticResource PageTitleBlack}"/>
                    <!--<StackLayout Orientation="Horizontal" Spacing="24">
                    <buttons:SfButton Text="Open" Style="{StaticResource CaptionButtonBlack}" BackgroundColor="White" BorderColor="{StaticResource NeutralLightGrey}" BorderWidth="1" CornerRadius="15" HeightRequest="32" Padding="12,0,12,0" />
                    <buttons:SfButton Text="Closed" Style="{StaticResource CaptionButtonBlack}" BackgroundColor="White" BorderColor="{StaticResource NeutralLightGrey}" BorderWidth="1" CornerRadius="15" HeightRequest="32" Padding="12,0,12,0"/>
                </StackLayout>-->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <buttons:SfChipGroup x:Name="ChipGroup_statusFilter" Type="Filter"  Margin="0,10,0,0" HorizontalOptions="Start"  ChipBackgroundColor="Transparent"                                         ItemsSource="{Binding ChipDataFilterlist}" SelectedChipBackgroundColor="#F9F0DF"  ChipBorderColor="{StaticResource NeutralLightGrey}"  SelectionChanging="ChipGroup_statusFilter_SelectionChanging" ChipBorderWidth="1" VerticalOptions="Center"  SelectedChipTextColor="{StaticResource Secondary}">
                            <buttons:SfChipGroup.ItemTemplate>
                                <DataTemplate >
                                    <StackLayout Margin="0" Orientation="Horizontal" HorizontalOptions="StartAndExpand" Spacing="2" Padding="5,-2,5,-2"  >
                                        <!--SelectionChanging="ChipGroup_statusFilter_SelectionChanged" <Image Source="{Binding ImageSource}" HorizontalOptions="Center" HeightRequest="25"  ></Image>-->
                                        <custom:CustomLabel Text="{Binding Text}" HorizontalOptions="Center" Style="{StaticResource CaptionLabelBlack}"/>
                                    </StackLayout>
                                </DataTemplate>
                            </buttons:SfChipGroup.ItemTemplate>
                        </buttons:SfChipGroup>
                    </ScrollView>
                    <StackLayout>
                        <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Orientation="Horizontal" Spacing="10" Padding="15,10,15,10">
                                <Image Source="ic_add_plus.png"/>
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                            </StackLayout>
                        </border:SfBorder>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AddReport_Tapped"/>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>

                </StackLayout>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" EnableAnimation="True" AnimationType="SingleCircle" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" IsBusy="True" ViewBoxWidth = "70" TitlePlacement="Bottom" ViewBoxHeight="70" TextColor="#D99A29"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
       
    </ContentPage.Content>
</ContentPage>
