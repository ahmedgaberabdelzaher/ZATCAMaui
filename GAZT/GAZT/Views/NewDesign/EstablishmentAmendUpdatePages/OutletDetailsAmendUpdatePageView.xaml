<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png"
             xmlns:models="clr-namespace:EGAZT.Models"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:customOne="clr-namespace:GAZT"
             xmlns:GAZTBehaviors="clr-namespace:EGAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncEffectsView="clr-namespace:Syncfusion.XForms.EffectsView;assembly=Syncfusion.Core.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.EstablishmentAmendUpdatePages.OutletDetailsAmendUpdatePageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:EstablishmentRegistrationOutletTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <yummy:PancakeView BackgroundColor="White" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Margin="0" CornerRadius="{OnPlatform Android='15,15,0,0', iOS='15'}" Padding="0">
                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0" Spacing="0">
                    <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"  BackgroundColor="White"/>
                </StackLayout>
            </yummy:PancakeView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0" Padding="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"
                  ColumnSpacing="0" RowSpacing="0" Padding="20,10,20,0">
 <ScrollView  HorizontalOptions="FillAndExpand" Orientation="Vertical" VerticalOptions="FillAndExpand"
             VerticalScrollBarVisibility="Never" IsVisible="{Binding currentTab,
     Converter={StaticResource enumToVisibilityConverter},
     ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}">
                <StackLayout Orientation="Vertical" Spacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.OutletDetail}}">
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TinDeregistrationOutletNumber}" TextColor="{StaticResource NeutralGreay}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,-10,0,0"/>
                    <custom:CustomLabel Text="{Binding OutletActNumber}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArabicMedium}" FontSize="16" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,-5,0,0"/>
                    <custom:CustomLabel TextColor="{StaticResource NeutralGreay}" FontFamily="{StaticResource SSTArRoman}"
                                        FontSize="12" HorizontalOptions="StartAndExpand" VerticalOptions="Center"
                                        Margin="0,10,0,0">
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.OutletTypeField}"/>
                                <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>
                    <syncfusion:SfButton ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" 
                                         Text="{Binding SelectedOutletType}"
                                         Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                         TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" Padding="5" Margin="0,5,0,0"
                                         IsEnabled="{Binding OutletDetails.OutletType}"
                                         Clicked="OutletType_Clicked">
                    </syncfusion:SfButton>
                    <custom:CustomLabel TextColor="{StaticResource NeutralGreay}" FontFamily="{StaticResource SSTArRoman}" FontSize="12" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ESTOutletCommercialName}"/>
                                <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>
                    <inputLayout:SfTextInputLayout Margin="0,-6,0,-6"
                                                   HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"

                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0"
                                                   IsEnabled="{Binding OutletDetails.OutletName}">
                        <Entry Placeholder="{x:Static ResourceManager:AppResources.ESTName}" IsSpellCheckEnabled="false" Text="{Binding OutletName}" Style="{StaticResource DefaultEntry}" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
     </ScrollView>
                <ScrollView  Orientation="Vertical" VerticalOptions="Fill" VerticalScrollBarVisibility="Never" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.ActivityDetails}}">
                    <StackLayout Orientation="Vertical" Spacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                        <syncEffectsView:SfEffectsView CornerRadius="10" TouchDownCommand="{Binding OnActivityItemButtonClick}" TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}">
                            <border:SfBorder BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" Padding="15" CornerRadius="10">
                                <Grid HorizontalOptions="Fill" VerticalOptions="Center" ColumnSpacing="0" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="deregistration.png" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistration}" Margin="10,0,0,0" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" />
                                    <Image Grid.Column="2" Source="arrowRight.png" HorizontalOptions="Center" VerticalOptions="Center" Style="{DynamicResource BackButtonArrow}" />
                                </Grid>
                            </border:SfBorder>
                        </syncEffectsView:SfEffectsView>
                        <syncEffectsView:SfEffectsView CornerRadius="10" Margin="0,20" TouchDownCommand="{Binding OnActivityItemButtonClick}" TouchDownCommandParameter="{x:Static models:EstablishmentOutletActivitiesTabsEnum.LicenseDetails}">
                            <border:SfBorder BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" Padding="15" CornerRadius="10">
                                <Grid HorizontalOptions="Fill" VerticalOptions="Center" ColumnSpacing="0" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="deregistration.png" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ESTLicenseDetails}" Margin="10,0,0,0" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" />
                                    <Image Grid.Column="2" Source="arrowRight.png" HorizontalOptions="Center" VerticalOptions="Center" Style="{DynamicResource BackButtonArrow}" />
                                </Grid>
                            </border:SfBorder>
                        </syncEffectsView:SfEffectsView>
                        <border:SfBorder BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" Padding="15" CornerRadius="10">
                            <Grid HorizontalOptions="Fill" VerticalOptions="Center" ColumnSpacing="0" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Image Grid.Column="0" Grid.Row="0" Source="ic_vat_info.png" HorizontalOptions="Center" VerticalOptions="Center" />
                                <custom:CustomLabel Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.Information}" Margin="10,0,0,0" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" />
                                <custom:CustomLabel Grid.Row="1" Grid.ColumnSpan="2"  Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfo}"
                                               Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" VerticalTextAlignment="Start" />
                            </Grid>
                        </border:SfBorder>
                        <border:SfBorder BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" Padding="15" CornerRadius="10" Margin="0,20,0,10">
                            <Grid HorizontalOptions="Fill" VerticalOptions="Center" ColumnSpacing="0" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Image Grid.Column="0" Grid.Row="0" Source="ic_vat_info.png" HorizontalOptions="Center" VerticalOptions="Center" />
                                <custom:CustomLabel Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.Information}" Margin="10,0,0,0" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" />
                                <custom:CustomLabel Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.ESTCommercialRegistrationNumberInfoTwo}"
                                               Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" VerticalTextAlignment="Start" />
                            </Grid>
                        </border:SfBorder>
                    </StackLayout>
                </ScrollView>
                <ScrollView  Orientation="Vertical" VerticalOptions="Fill" VerticalScrollBarVisibility="Never" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationOutletTabsEnum.AddressDetails}}">
                    <StackLayout Orientation="Vertical" Spacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="StartAndExpand">
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTPhycicalAddress}" Margin="0,10,0,0" Style="{StaticResource ValueLabelBlackBold}" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand" BackgroundColor="AliceBlue" HorizontalTextAlignment="Start" />
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" ColumnSpacing="20" RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Column="0" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0" Text="{x:Static ResourceManager:AppResources.ESTHouseNumber}" />
                            <custom:CustomLabel Grid.Column="1" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}"/>
                                        <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <inputLayout:SfTextInputLayout Grid.Column="0" Grid.Row="1"  Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                           Margin="0" InputViewPadding="10,0,10,0"
                                                           IsEnabled="{Binding AddressDetails.HouseNo}">
                                <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false" Text="{Binding HouseNumber}" MaxLength="10" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                            </inputLayout:SfTextInputLayout>
                            <inputLayout:SfTextInputLayout Grid.Column="1" Grid.Row="1"  Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                           Margin="0" InputViewPadding="10,0,10,0"
                                                           IsEnabled="{Binding AddressDetails.BuildinNo}">
                                <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false" Text="{Binding BuildingNumber}" MaxLength="20" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                            </inputLayout:SfTextInputLayout>
                        </Grid>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTFloorNumber}"/>
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" 
                                                        InputViewPadding="10,0,10,0" IsEnabled="{Binding AddressDetails.Floor}">
                            <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false" Text="{Binding FloorNumber}" MaxLength="10" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.NDTaxEvasionStreet}"/>
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" 
                                                        InputViewPadding="10,0,10,0" IsEnabled="{Binding AddressDetails.Street}">
                            <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false" MaxLength="60" Text="{Binding Street}" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTQuarter}"/>
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" 
                                                        InputViewPadding="10,0,10,0" IsEnabled="{Binding AddressDetails.Quarter}">
                            <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false" MaxLength="40" Text="{Binding Quarter}" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ZZZZPostalCode}"/>
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" 
                                                        InputViewPadding="10,0,10,0" IsEnabled="{Binding AddressDetails.PostelCode}">
                            <custom:GAZTBorderlessEntry VerticalTextAlignment="Center" IsSpellCheckEnabled="false"  Text="{Binding PostalCode}" MaxLength="6" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" Keyboard="Numeric">
                                <customOne:GAZTBorderlessEntry.Behaviors>
                                    <customOne:NumericValidationBehavior />
                                </customOne:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0" Text="{x:Static ResourceManager:AppResources.ESTAddNumber}"/>
                        <inputLayout:SfTextInputLayout  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" 
                                                        InputViewPadding="10,0,10,0" IsEnabled="{Binding AddressDetails.AddNo}">
                            <custom:GAZTBorderlessEntry  VerticalTextAlignment="Center" IsSpellCheckEnabled="false" MaxLength="10" Text="{Binding AddNumber}" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16">
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span  Text="{x:Static ResourceManager:AppResources.CountryText}"/>
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" Text="{Binding Country}"  Command="{Binding OnCountrySelectButtonClick}"
                                                       Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                                       TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" Padding="5" Margin="0,5,0,0" 
                                                       IsEnabled="{Binding AddressDetails.Country}"/>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTProvinance}"/>
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" Text="{Binding Provinance}" Command="{Binding OnProvinanceSelectButtonClick}"
                                                       Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                                       TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" 
                                                       Padding="5" Margin="0,5,0,0" IsEnabled="{Binding AddressDetails.Province}"/>
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTOutletCity}"/>
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" Text="{Binding City}" Command="{Binding OnCitySelectButtonClick}"
                                                       Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                                       TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" Padding="5" 
                                                       Margin="0,5,0,0" IsEnabled="{Binding AddressDetails.City}"/>
                        <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.ESTPostalAddress}" Margin="0,10,0,0" Style="{StaticResource ValueLabelBlackBold}" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand" HorizontalTextAlignment="Start" />
                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="EndAndExpand" 
                                     Padding="10,0" IsEnabled="{Binding AddressDetails.CBSameAsPhysical}">
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTSameAsPhycical}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0" BackgroundColor="AliceBlue" />
                            <syncfusion:SfSwitch VisualType="Material" IsOn="{Binding PostalAsPhysical}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </StackLayout>
                        <StackLayout x:Name="PostalAddressFields" Orientation="Vertical" HorizontalOptions="FillAndExpand" VerticalOptions="StartAndExpand" IsEnabled="{Binding PostalAsPhysical,Converter={StaticResource boolToVisibilityConverter},ConverterParameter='invert'}" >
                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" ColumnSpacing="20" RowSpacing="0" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Column="0" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0" Text="{x:Static ResourceManager:AppResources.ESTHouseNumber}" />
                                <custom:CustomLabel Grid.Column="1" Grid.Row="0" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span  Text="{x:Static ResourceManager:AppResources.ZZZZBuildingNumber}"/>
                                            <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout Grid.Column="0" Grid.Row="1"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" InputViewPadding="10,0,10,0">
                                    <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false"  Text="{Binding HouseNumberSame}" MaxLength="10" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                                </inputLayout:SfTextInputLayout>
                                <inputLayout:SfTextInputLayout Grid.Column="1" Grid.Row="1"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" InputViewPadding="10,0,10,0">
                                    <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false"  Text="{Binding BuildingNumberSame}" MaxLength="20" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                                </inputLayout:SfTextInputLayout>
                            </Grid>
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ESTFloorNumber}"/>
                                        <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <inputLayout:SfTextInputLayout  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" InputViewPadding="10,0,10,0">
                                <Entry VerticalTextAlignment="Center" IsSpellCheckEnabled="false" MaxLength="10" Text="{Binding FloorNumberSame}" HorizontalTextAlignment="Start" Margin="10" HorizontalOptions="FillAndExpand" VerticalOptions="Center" HeightRequest="48" PlaceholderColor="{StaticResource NeutralGreay}" TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="16" />
                            </inputLayout:SfTextInputLayout>
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
