<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstablishmentAmendUpdatePages.EstablishmentAmendUpdateSuccessfulPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid
            Padding="0"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout
                Grid.Row="0"
                Margin="0,45,0,0"
                Padding="20"
                HorizontalOptions="Center"
                VerticalOptions="FillAndExpand">
                <Image Source="Forget_ic_success" />
                <custom:CustomLabel
                    Margin="0,20,0,10"
                    HorizontalOptions="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZVatAcknowledgment}" />
                <custom:CustomLabel
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource BodyLabelBlack}"
                    StyleId="OnBoardText"
                    Text="{x:Static ResourceManager:AppResources.ESTGAZTAcknowledgesTheReceiptRegApplication}"
                    TextColor="White" />
            </StackLayout>
            <yummy:PancakeView
                Grid.Row="1"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">
                <Grid
                    HorizontalOptions="Fill"
                    RowSpacing="15"
                    VerticalOptions="Fill">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical"
                        VerticalOptions="Start"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Spacing="15" VerticalOptions="StartAndExpand">
                            <border:SfBorder
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="10">
                                <StackLayout
                                    Padding="10"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTName}" />
                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding Name}" />
                                </StackLayout>
                            </border:SfBorder>
                            <border:SfBorder
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="10">
                                <StackLayout
                                    Padding="10"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTReferenceNumber}" />
                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding Fbnumx}" />
                                </StackLayout>
                            </border:SfBorder>
                            <border:SfBorder
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="10">
                                <StackLayout
                                    Padding="10"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.Date}" />
                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding DateText}" />
                                </StackLayout>
                            </border:SfBorder>
                            <border:SfBorder
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="10">
                                <custom:CustomLabel
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ESTFutureRefernceAndCommunicationFinalMsg}" />
                            </border:SfBorder>
                        </StackLayout>
                    </ScrollView>
                    <buttons:SfButton
                        Grid.Row="1"
                        BackgroundColor="White"
                        Clicked="GoToDashBoardButtonClick"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.TinDeregistrationRegistrationDetails}"
                        TextColor="{StaticResource Primary}" />
                </Grid>
            </yummy:PancakeView>
        </Grid>
    </ContentPage.Content>
</ContentPage>