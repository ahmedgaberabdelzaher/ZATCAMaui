<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:models="clr-namespace:EGAZT.Models"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             ios:Page.UseSafeArea="true"
             xmlns:customOne="clr-namespace:GAZT"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png"
             xmlns:FontImage="clr-namespace:MVP.FontIcons" 
             xmlns:GAZTBehaviors1="clr-namespace:GAZT.CustomControl"
             x:Class="EGAZT.Views.NewDesign.EstablishmentAmendUpdatePages.EstablishmentAmendUpdatePageView"
             xmlns:converter="clr-namespace:EGAZT.Helper"
             Title="{Binding PageTitle}"
             x:Name="ESTAmendReactivationPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:EstablishmentTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:EstablishmentFinanicalMethodsToVisibilityConverter x:Key="methodToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <converters:ESTOutletDeleteActionVisibilityConverter x:Key="deleteActionVisibilityConverter" />
            <converters:ESTresidentialStatusConverter x:Key="residentialStatusConverter" />
            <!--<converter:InverseBoolConverter x:Key="BoolConverter"/>-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <yummy:PancakeView BackgroundColor="White" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Margin="0" CornerRadius="{OnPlatform Android='15,15,0,0', iOS='15'}" Padding="0">
                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0" Spacing="0">
                    <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"  BackgroundColor="White"/>
                </StackLayout>
            </yummy:PancakeView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0" Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="10,10,10,0">
                <StackLayout x:Name="RegistrationTabMainGrid" VerticalOptions="StartAndExpand" Orientation="Vertical" Spacing="3" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}">
                    <ScrollView   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                        <Grid x:Name="RegistrationTab"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="24">
                            <!--IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}">-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <StackLayout Orientation="Vertical" Grid.Row="0" >
                                <custom:CustomLabel  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTEntityTypeQuestionLabel}"  FontFamily="{StaticResource Somar-Regular}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <custom:CustomLabel Text="{Binding SelectedEntityType}" HorizontalOptions="Start" Style="{StaticResource ValueLabelBlack}" Padding="0,10,0,0"/>
                            </StackLayout>
                            <StackLayout Orientation="Vertical" Grid.Row="1" >
                                <custom:CustomLabel  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDWhatisYourNationality}" FontFamily="{StaticResource Somar-Regular}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <custom:CustomLabel Text="{Binding SelectedRegNationalityType}"  HorizontalOptions="Start" Style="{StaticResource ValueLabelBlack}" Padding="0,10,0,0"/>
                            </StackLayout>
                            <Grid  Grid.Row="2"  IsVisible="{Binding IsSaudi,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel  Style="{StaticResource forLightLabel}"  Grid.Row="0" Grid.Column="0" HorizontalOptions="StartAndExpand"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusQuestionLabel}"  FontFamily="{StaticResource Somar-Regular}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                    
                                </custom:CustomLabel>
                                <buttons:SfButton ImageWidth="25" VerticalOptions="CenterAndExpand"  Grid.Row="0"  Grid.Column="1" IsVisible="{Binding IsClickedStayMoreThanKSAOption}" TextColor="{StaticResource Primary}" ImageSource="Paid_check.png"  ShowIcon="True" Text="{x:Static ResourceManager:AppResources.ESTResidentOptionValue}"  BorderWidth="1" BackgroundColor="#cee0dd"  CornerRadius="20"  HorizontalOptions="EndAndExpand"/>

                            </Grid>
                            <StackLayout x:Name="NationalityStatusOptionmain" Orientation="Vertical"  Grid.Row="3" IsVisible="{Binding IsSaudi,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"  >
                                <Grid RowSpacing="24" ColumnSpacing="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="104"/>
                                        <RowDefinition Height="104"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="StayMoreKsagrid" Grid.Row="0" Grid.Column="0" IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}"  >
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusStayMoreThanKSAClick}"/>
                                        </Grid.GestureRecognizers>
                                        <cards:SfCardView HasShadow="False" Grid.Row="0" Grid.Column="0"  CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                          IsVisible="{Binding IsClickedStayMoreThanKSAOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}" >
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}" Style="{DynamicResource CardLabelBlack}"   />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                        <cards:SfCardView HasShadow="False" Grid.Row="0" Grid.Column="0"  CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                          IsVisible="{Binding IsClickedStayMoreThanKSAOption}">
                                            <Grid  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="selected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}" Style="{DynamicResource CardLabelWhite}"   />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                    </Grid>
                                    <Grid x:Name="OwnhouseGrid" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusRentOwnHouseClick}"/>
                                        </Grid.GestureRecognizers>
                                        <cards:SfCardView Grid.Row="0" Grid.Column="0" HasShadow="False" CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                          IsVisible="{Binding IsClickedOwnRentOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image  Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}" Style="{DynamicResource CardLabelBlack}"   />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                        <cards:SfCardView x:Name="OwnhouseCard" Grid.Row="0" Grid.Column="0" HasShadow="False" CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                          IsVisible="{Binding IsClickedOwnRentOption}">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image  Source="selected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}" Style="{DynamicResource CardLabelWhite}"   />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                    </Grid>
                                    <Grid  x:Name="NoneOfTheAboveGrid"  Grid.Row="1" Grid.Column="0" IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusNoneOfTheAboveClick}"/>
                                        </Grid.GestureRecognizers>
                                        <cards:SfCardView x:Name="NoneOfTheAboveCard" HasShadow="False" CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                          IsVisible="{Binding IsClickedNoneOfTheAboveOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}" >
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image  Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}" Style="{DynamicResource CardLabelBlack}"   />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                        <cards:SfCardView HasShadow="False" CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                          IsVisible="{Binding IsClickedNoneOfTheAboveOption}">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image  Source="selected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}" Style="{DynamicResource CardLabelWhite}"   />
                                                </StackLayout>
                                            </Grid>
                                        </cards:SfCardView>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                            <!-- Attachment layout start-->
                            <StackLayout x:Name="RentAttachmentsMainLayout"  IsVisible="{Binding IsClickedOwnRentOption}" Orientation="Vertical" Grid.Row="4" Spacing="24">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatAttachments}"  Style="{StaticResource ButtonLabelBlackBold}"/>
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" >
                                        <custom:CustomLabel HorizontalOptions="Start" Style="{StaticResource forLightLabel}" >
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.ESTProvideAttachmentCopyofRentLabel}" FontFamily="{StaticResource Somar-Regular}" />
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                        <Image Source="ic_vat_info.png"  WidthRequest="20" HeightRequest="20" HorizontalOptions="EndAndExpand">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}"></TapGestureRecognizer>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </StackLayout>
                                    <StackLayout>
                                        <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"    Style="{StaticResource GreyBorderFrame}">
                                            <StackLayout Orientation="Horizontal"  Padding="5,15,5,15" IsEnabled="True">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Attachments}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                                    <Image Grid.Row="0" Grid.Column="1" Source="ic_attachment" Margin="5,0" WidthRequest="20" HeightRequest="20"
                                               HorizontalOptions="Start" VerticalOptions="Center"></Image>
                                                </StackLayout>
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OnEstablishmentRegistrationAttachmentTapped}" ></TapGestureRecognizer>
                                                </StackLayout.GestureRecognizers>
                                            </StackLayout>
                                        </border:SfBorder >
                                    </StackLayout>
                                </StackLayout>
                                <StackLayout  IsVisible="{Binding IsVisbleRentAttachmentmentList}">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyofRentLabel}"  HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" />
                                    <StackLayout VerticalOptions="FillAndExpand" Orientation="Vertical" Spacing="5" Margin="0,5,0,0"
                                                 BindableLayout.ItemsSource="{Binding UploadedRentDocumentsList,Mode=TwoWay}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <border:SfBorder BorderWidth="1"    Style="{StaticResource GreyBorderFrame}" BorderColor="{StaticResource NeutralGreay}"
                                                                Padding="10" CornerRadius="10">
                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Center"  ColumnSpacing="0" RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="Generic_attachment_icon.png" HorizontalOptions="Center" VerticalOptions="Center" />
                                                        <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}" Margin="10,0,0,0"
                                                                            Style="{StaticResource BodyLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"
                                                                            HorizontalTextAlignment="Start" />
                                                        <Image Grid.Column="2" Source="close.png"  HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer CommandParameter="Rentcommand" Tapped="TapRentDeleteGestureRecognizer_Tapped"/>
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout x:Name="NoneOfTheAboveOptionsLayout" IsVisible="{Binding IsClickedNoneOfTheAboveOption}" Orientation="Vertical" Grid.Row="5" >
                                <custom:CustomLabel  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTChooseLegalEntityBelowTitleLabel}"  FontFamily="{StaticResource Somar-Regular}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <StackLayout Orientation="Vertical"  >
                                    <Grid ColumnSpacing="24" RowSpacing="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="PermanentEstablishmentGrid" Grid.Row="0" Grid.Column="0" RowSpacing="24" ColumnSpacing="24">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PermanentEstablishmentLegalEntityClick}"/>
                                            </Grid.GestureRecognizers>
                                            <cards:SfCardView HasShadow="False" CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                              IsVisible="{Binding IsClickedPermanentLegalEntity,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" Style="{DynamicResource CardLabelBlack}"   />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                            <cards:SfCardView HasShadow="False"  CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                              IsVisible="{Binding IsClickedPermanentLegalEntity}">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="selected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" Style="{DynamicResource CardLabelWhite}"   />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                        </Grid>
                                        <Grid x:Name="OtherTaxableIncomeGrid" Grid.Row="0" Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OtherTaxableIncomeLegalEntityClick}"/>
                                            </Grid.GestureRecognizers>
                                            <cards:SfCardView HasShadow="False" Grid.Row="0" Grid.Column="0"  CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                              IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTOtherTaxableIncomeFromSourcesWithinTheKSA}" Style="{DynamicResource CardLabelBlack}"   />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                            <cards:SfCardView HasShadow="False" Grid.Row="0" Grid.Column="0"  CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                              IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity}">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="selected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTOtherTaxableIncomeFromSourcesWithinTheKSA}" Style="{DynamicResource CardLabelWhite}"   />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                        </Grid>
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout x:Name="PermanentEstablishmentsOptionsLayout" IsVisible="{Binding IsClickedPermanentLegalEntity}"  Orientation="Vertical" Grid.Row="6" >
                                <custom:CustomLabel  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" FontFamily="{StaticResource Somar-Regular}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <StackLayout Orientation="Vertical"   >
                                    <Grid RowDefinitions="104,104,104,104,104" RowSpacing="24">
                                        <Grid x:Name="ABranchNonResidentCompanyGrid"  Grid.Row="0" Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ABranchOfNonResidentCompanyPEClick}"/>
                                            </Grid.GestureRecognizers>
                                            <cards:SfCardView HasShadow="False" CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                              IsVisible="{Binding IsClickedABranchOfNonResidentCompanyPE,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTABranchOfNonResidentCompanyLabel}" Style="{DynamicResource CardLabelBlack}"   />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                            <cards:SfCardView HasShadow="False" CornerRadius="20" HeightRequest="104" WidthRequest="171"
                                                              IsVisible="{Binding IsClickedABranchOfNonResidentCompanyPE}">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104"/>
                                                    </Grid.RowDefinitions>
