<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             xmlns:syncfusion="clr-namespace:Syncfusion.XForms.Pickers;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:models="clr-namespace:EGAZT.Models"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             ios:Page.UseSafeArea="true"
             xmlns:GAZTBehaviors="clr-namespace:EGAZT"
             xmlns:customOne="clr-namespace:GAZT"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png"
             xmlns:FontImage="clr-namespace:MVP.FontIcons" 
             xmlns:GAZTBehaviors1="clr-namespace:GAZT.CustomControl"
             x:Class="EGAZT.Views.NewDesign.EstablishmentAmendUpdatePages.EstablishmentAmendUpdatePageView"
             Title="{Binding PageTitle}"
             x:Name="ESTAmendReactivationPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:EstablishmentTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:EstablishmentFinanicalMethodsToVisibilityConverter x:Key="methodToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <converters:ESTOutletDeleteActionVisibilityConverter x:Key="deleteActionVisibilityConverter" />
            <converters:ESTresidentialStatusConverter x:Key="residentialStatusConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <yummy:PancakeView BackgroundColor="White" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Margin="0" CornerRadius="{OnPlatform Android='15,15,0,0', iOS='15'}" Padding="0">
                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0" Spacing="0">
                    <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"  BackgroundColor="White"/>
                </StackLayout>
            </yummy:PancakeView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0" Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="10,10,10,0">
                <StackLayout x:Name="RegistrationTabMainGrid" VerticalOptions="StartAndExpand" Orientation="Vertical" Spacing="3" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}">
                    <ScrollView   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                        <Grid x:Name="RegistrationTab"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <!--IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}">-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <StackLayout Orientation="Vertical" Grid.Row="0" Margin="0,0,0,10">
                                <Label  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTReportBranchQuestionLabel}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout  IsEnabled="{Binding RegTaxPayerTypeAvailability.ReportingBranch}">
                                    <buttons:SfButton  ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" Text="{Binding SelectedReportingBranch}" Command="{Binding OnReportingBranchSelectButtonClick}"
                                                       Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                                       TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" Padding="5" 
                                                      />
                                    <!--IsEnabled="{Binding BindingContext.RegTaxPayerTypeAvailability.ReportingBranch,Source={x:Reference ESTAmendReactivationPage}}"-->
                                </StackLayout>
                            </StackLayout>
                            <StackLayout Orientation="Vertical" Grid.Row="1" Margin="0,0,0,10">
                                <Label  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTEntityTypeQuestionLabel}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomLabel Text="{Binding SelectedEntityType}" HorizontalOptions="Start"  Padding="0,-10,0,0" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>
                            <StackLayout Orientation="Vertical" Grid.Row="2" Margin="0,0,0,10">
                                <Label  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTaxpayerTypeQuestionLabel}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomLabel Text="{Binding SelectedTaxPayerType}"  HorizontalOptions="Start"  Padding="0,-10,0,0" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>
                            <StackLayout Orientation="Vertical" Grid.Row="3" Margin="0,0,0,10">
                                <Label  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDWhatisYourNationality}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomLabel Text="{Binding SelectedRegNationalityType}"  HorizontalOptions="Start"  Padding="0,-10,0,0" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>
                            <Grid  Grid.Row="4" Margin="0,0,0,10" IsVisible="{Binding IsSaudi,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}">
                                <!--<Grid.IsVisible>
                                    <MultiBinding>
                                        <Binding Path="IsSaudi,Converter={StaticResource xBoolToVisibilityConverter}" ConverterParameter='invert'/>
                                        <Binding Path="RegTaxPayerTypeAvailability.IsNationalityStatusVisible"/>
                                    </MultiBinding>
                                </Grid.IsVisible>-->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label  Style="{StaticResource forLightLabel}"  Grid.Row="0" Grid.Column="0" HorizontalOptions="StartAndExpand"  >
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusQuestionLabel}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <buttons:SfButton ImageWidth="25" VerticalOptions="CenterAndExpand"  Grid.Row="0"  Grid.Column="1" IsVisible="{Binding IsClickedStayMoreThanKSAOption}" TextColor=" DarkGreen" ImageSource="Paid_check.png"  ShowIcon="True" Text="{x:Static ResourceManager:AppResources.ESTResidentOptionValue}"  BorderWidth="1" BackgroundColor="#cee0dd"  CornerRadius="20"  HorizontalOptions="EndAndExpand"/>

                            </Grid>
                            <StackLayout x:Name="NationalityStatusOptionmain" Orientation="Vertical"  Grid.Row="5"  Margin="0,0,0,10" IsVisible="{Binding IsSaudi,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}">
                                <Grid  Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="120"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="StayMoreKsagrid" Grid.Row="0" Grid.Column="0" IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}"  >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusStayMoreThanKSAClick}"/>
                                        </Grid.GestureRecognizers>
                                        <Image Grid.Row="0" Source="vat_tile_listofsignup_W.png"  IsVisible="{Binding IsClickedStayMoreThanKSAOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}" 
                                               HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                        <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}" Style="{StaticResource ValueLabelBlackMedium}"
                                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                                            HorizontalOptions="CenterAndExpand"  Margin="10" 
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="Gray" />
                                        <Image Grid.Row="0" Source="vat_tile_listofsignup.png" 
                                               IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                               HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                        <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}"  Style="{StaticResource ValueLabelBlackMedium}"
                                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption}" 
                                                            HorizontalOptions="CenterAndExpand"  Margin="10" 
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="White" />
                                    </Grid>
                                    <Grid x:Name="OwnhouseGrid" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusRentOwnHouseClick}"/>
                                        </Grid.GestureRecognizers>
                                        <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup_W.png" IsVisible="{Binding IsClickedOwnRentOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                        <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}"  Padding="10" 
                                                            IsVisible="{Binding IsClickedOwnRentOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                                            HorizontalOptions="CenterAndExpand"
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="Gray" 
                                                            Style="{StaticResource ValueLabelBlackMedium}"/>
                                        <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup.png"   IsVisible="{Binding IsClickedOwnRentOption}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}"
                                                            Padding="10" 
                                                            IsVisible="{Binding IsClickedOwnRentOption}"
                                                            HorizontalOptions="CenterAndExpand"
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="White" 
                                                            Style="{StaticResource ValueLabelBlackMedium}"/>
                                    </Grid>
                                    <Grid  x:Name="NoneOfTheAboveGrid"  Grid.Row="1" Grid.Column="0"  WidthRequest="250" IsEnabled="{Binding RegTaxPayerTypeAvailability.ResidencyStatus}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusNoneOfTheAboveClick}"/>
                                        </Grid.GestureRecognizers>
                                        <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup_W.png" IsVisible="{Binding IsClickedNoneOfTheAboveOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}" 
                                               HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}"  IsVisible="{Binding IsClickedNoneOfTheAboveOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                                             HorizontalOptions="CenterAndExpand"  Padding="10" 
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="Gray" 
                                                            Style="{StaticResource ValueLabelBlackMedium}"/>
                                        <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup.png"   IsVisible="{Binding IsClickedNoneOfTheAboveOption}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}"    IsVisible="{Binding IsClickedNoneOfTheAboveOption}"
                                                             HorizontalOptions="CenterAndExpand"  Padding="10" 
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="White" 
                                                            Style="{StaticResource ValueLabelBlackMedium}"/>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                            <!-- Attachment layout start-->
                            <StackLayout x:Name="RentAttachmentsMainLayout"  IsVisible="{Binding IsClickedOwnRentOption}" Orientation="Vertical" Grid.Row="6" Margin="0,0,0,10">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatAttachments}"  Style="{StaticResource ButtonLabelBlackBold}"/>
                                <StackLayout Orientation="Horizontal" >
                                    <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}" >
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ESTProvideAttachmentCopyofRentLabel}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Image Source="information.png"  WidthRequest="20" HeightRequest="20" HorizontalOptions="EndAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}"></TapGestureRecognizer>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                                <StackLayout>
                                    <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">
                                        <StackLayout Orientation="Horizontal"  Padding="5,15,5,15" IsEnabled="True">
                                            <Label Text="{x:Static ResourceManager:AppResources.Attachments}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                                <Image Grid.Row="0" Grid.Column="1" Source="ic_attachment" Margin="5,0" WidthRequest="20" HeightRequest="20"
                                               HorizontalOptions="Start" VerticalOptions="Center"></Image>
                                            </StackLayout>
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnEstablishmentRegistrationAttachmentTapped}" ></TapGestureRecognizer>
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </border:SfBorder >
                                </StackLayout>
                                <StackLayout  IsVisible="{Binding IsVisbleRentAttachmentmentList}" >
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyofRentLabel}"  HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" />
                                    <StackLayout VerticalOptions="FillAndExpand" Orientation="Vertical" Spacing="5" Margin="0,5,0,0"
                                                 BindableLayout.ItemsSource="{Binding UploadedRentDocumentsList,Mode=TwoWay}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <border:SfBorder BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}" BorderColor="{StaticResource NeutralGreay}"
                                                                Padding="10" CornerRadius="10">
                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Center"  ColumnSpacing="0" RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="Generic_attachment_icon.png" HorizontalOptions="Center" VerticalOptions="Center" />
                                                        <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}" Margin="10,0,0,0"
                                                                            Style="{StaticResource BodyLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"
                                                                            HorizontalTextAlignment="Start" />
                                                        <Image Grid.Column="2" Source="closeGrey.png"  HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <!--<ClickGestureRecognizer Clicked="removeRentAttachmentClicked"/>-->
                                                                <TapGestureRecognizer CommandParameter="Rentcommand" Tapped="TapRentDeleteGestureRecognizer_Tapped"/>
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout x:Name="NoneOfTheAboveOptionsLayout" IsVisible="{Binding IsClickedNoneOfTheAboveOption}" Orientation="Vertical" Grid.Row="7" Margin="0,0,0,10">
                                <Label  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTChooseLegalEntityBelowTitleLabel}"  FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout Orientation="Vertical"  Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="PermanentEstablishmentGrid" Grid.Row="0" Grid.Column="0" >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PermanentEstablishmentLegalEntityClick}"/>
                                            </Grid.GestureRecognizers>
                                            <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup_W.png"  IsVisible="{Binding IsClickedPermanentLegalEntity,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"  Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" 
                                                                IsVisible="{Binding IsClickedPermanentLegalEntity,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                                                HorizontalOptions="CenterAndExpand"  Padding="10" 
                                                                VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                                LineSpacing="1" VerticalTextAlignment="Center" TextColor="Gray"
                                                                Style="{StaticResource ValueLabelBlackMedium}"/>
                                            <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup.png"   IsVisible="{Binding IsClickedPermanentLegalEntity}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" 
                                                                IsVisible="{Binding IsClickedPermanentLegalEntity}" 
                                                                HorizontalOptions="CenterAndExpand"  Padding="10" 
                                                                VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                                LineSpacing="1" VerticalTextAlignment="Center" TextColor="White"
                                                                Style="{StaticResource ValueLabelBlackMedium}"/>
                                        </Grid>
                                        <Grid x:Name="OtherTaxableIncomeGrid" Grid.Row="0" Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OtherTaxableIncomeLegalEntityClick}"/>
                                            </Grid.GestureRecognizers>
                                            <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup_W.png"  IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ESTOtherTaxableIncomeFromSourcesWithinTheKSA}" 
                                                                IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                                                HorizontalOptions="CenterAndExpand"  Margin="10" 
                                                                VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                                LineSpacing="1" VerticalTextAlignment="Center" TextColor="Gray"
                                                                Style="{StaticResource ValueLabelBlackMedium}"/>
                                            <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup.png"   IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ESTOtherTaxableIncomeFromSourcesWithinTheKSA}"  
                                                                IsVisible="{Binding IsClickedOtherTaxableIncomeLegalEntity}"
                                                                HorizontalOptions="CenterAndExpand"  Margin="10" 
                                                                VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                                LineSpacing="1" VerticalTextAlignment="Center" TextColor="White" 
                                                                Style="{StaticResource ValueLabelBlackMedium}"/>
                                        </Grid>
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout x:Name="PermanentEstablishmentsOptionsLayout" IsVisible="{Binding IsClickedPermanentLegalEntity}"  Orientation="Vertical" Grid.Row="8" Margin="0,0,0,10">
                                <Label  Style="{StaticResource forLightLabel}" HorizontalOptions="Start">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" FontFamily="{StaticResource GAZT_FONT_REGULAR}" />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout Orientation="Vertical"   Margin="0,0,0,10">
                                    <Grid  Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!--<Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>-->
                                        <Grid x:Name="ABranchNonResidentCompanyGrid"  Grid.Row="0" Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ABranchOfNonResidentCompanyPEClick}"/>
                                            </Grid.GestureRecognizers>
                                            <Image Grid.Row="0" Grid.Column="0" Source="vat_tile_listofsignup_W.png" IsVisible="{Binding IsClickedABranchOfNonResidentCompanyPE,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
