                                                <custom:CustomLabel Grid.Column="0" Grid.Row="1" Text="{x:Static ResourceManager:AppResources.ESTOutletName}"  HorizontalOptions="Start" Style="{StaticResource BodyLabelGrey}" />
                                                <custom:CustomLabel Grid.Column="1" Grid.Row="1" Text="{Binding Actnm}" HorizontalOptions="End" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                                <custom:CustomLabel Grid.Column="0" Grid.Row="2" Text="{x:Static ResourceManager:AppResources.ESTOutletCity}"  HorizontalOptions="Start" Style="{StaticResource BodyLabelGrey}" />
                                                <custom:CustomLabel Grid.Column="1" Grid.Row="2" Text="{Binding City1}" HorizontalOptions="End" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                                <custom:CustomLabel Grid.Column="0" Grid.Row="3" Text="{x:Static ResourceManager:AppResources.ESTCRlicense}"  HorizontalOptions="Start" Style="{StaticResource BodyLabelGrey}" />
                                                <custom:CustomLabel Grid.Column="1" Grid.Row="3" Text="{Binding Crlicenceno}" HorizontalOptions="End" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>
                            </StackLayout>
                        </cards:SfCardView>
                        <cards:SfCardView x:Name="FinancialDetailSummaryView" HasShadow="False" BackgroundColor="Transparent" BorderColor="{StaticResource NeutralLightGrey}" BorderWidth="1" Padding="0">
                            <StackLayout Orientation="Vertical" Spacing="0">
                                <Grid HorizontalOptions="Fill" VerticalOptions="Center" ColumnSpacing="0" RowSpacing="0" Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <border:SfBorder CornerRadius="24" BorderColor="Transparent" ShadowColor="White" HasShadow="False" BackgroundColor="{StaticResource BackgroundGray}" HeightRequest="48" WidthRequest="48">
                                        <Image Grid.Column="0" Source="amount.png" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="24" WidthRequest="24"/>
                                        <border:SfBorder.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnExpendGridViewClick}" CommandParameter="{x:Static models:EstablishmentRegistrationTabsEnum.FinancialDetail}" NumberOfTapsRequired="1" />
                                        </border:SfBorder.GestureRecognizers>
                                    </border:SfBorder>
                                    <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZZZZVATREFinancialDetails}" Style="{StaticResource SectionTitleBlack}" HorizontalOptions="Start" VerticalOptions="Center" Padding="10,0" >
                                        <custom:CustomLabel.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnExpendGridViewClick}" CommandParameter="{x:Static models:EstablishmentRegistrationTabsEnum.FinancialDetail}" NumberOfTapsRequired="1" />
                                        </custom:CustomLabel.GestureRecognizers>
                                    </custom:CustomLabel>
                                    <custom:CustomLabel Grid.Column="2" Text="{x:Static ResourceManager:AppResources.ESTEdit}" Style="{StaticResource ValueLabelPrimary}" VerticalOptions="Center">
                                        <custom:CustomLabel.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnEditPageViewClick}" CommandParameter="{x:Static models:EstablishmentRegistrationTabsEnum.FinancialDetail}" NumberOfTapsRequired="1" />
                                        </custom:CustomLabel.GestureRecognizers>
                                    </custom:CustomLabel>
                                </Grid>
                                <StackLayout Orientation="Vertical" IsVisible="{Binding SummaryExpendedCard, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.FinancialDetail}}">
                                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource NeutralLightGrey}" Margin="0,0,0,16" />
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Center" ColumnSpacing="0" RowSpacing="0" Padding="16,0,16,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ESTMethodOfFinancialRecordMaintained}"  LineBreakMode="WordWrap" HorizontalOptions="Start" Style="{StaticResource BodyLabelGrey}"  />
                                        <custom:CustomLabel Grid.Column="1" Grid.Row="0" Text="{Binding SelectedMethod}" HorizontalOptions="End" VerticalOptions="Center" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="1" Text="{x:Static ResourceManager:AppResources.FORM5CalendarType}"  Style="{StaticResource BodyLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Grid.Row="1" Text="{Binding CalendarType}" HorizontalOptions="End" VerticalOptions="Center" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="2" Text="{x:Static ResourceManager:AppResources.ESTEndOfFiscalMonth}" Style="{StaticResource BodyLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Grid.Row="2"  Text="{Binding FiscalMonth}" HorizontalOptions="End"  VerticalOptions="Center" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="3" Text="{x:Static ResourceManager:AppResources.ESTEndOfFiscalDay}"  Style="{StaticResource BodyLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Grid.Row="3" Text="{Binding FiscalDay}" HorizontalOptions="End"  VerticalOptions="Center" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="4" Text="{x:Static ResourceManager:AppResources.ESTBusinessCommencementDate}" Style="{StaticResource BodyLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Grid.Row="4" Text="{Binding CommDate}" HorizontalOptions="End"  VerticalOptions="Center" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                        <custom:CustomLabel Grid.Column="0" Grid.Row="5" Text="{x:Static ResourceManager:AppResources.ESTTaxableDate}" Style="{StaticResource BodyLabelGrey}" />
                                        <custom:CustomLabel Grid.Column="1" Grid.Row="5" Text="{Binding TaxDate}" HorizontalOptions="End" VerticalOptions="Center" Style="{StaticResource SectionTitleSmallMediumBlack}" />
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                        </cards:SfCardView>
                        <Grid ColumnDefinitions="1*,4*,4*,1*" >
                            <custom1:CheckboxCustom x:Name="CBAcknowledment" Grid.Row="0" Grid.Column="0" VerticalOptions="CenterAndExpand"  IsChecked="{Binding ESTLedge}" Style="{StaticResource CheckboxHeightWidth32}"/>
                            <custom:CustomLabel Margin="5,0,0,0" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" VerticalOptions="CenterAndExpand" 
                                                VerticalTextAlignment="Start" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" 
                                                Style="{DynamicResource IsInstrunctionCheckedStyle}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span     Text="{x:Static ResourceManager:AppResources.ESTPledgeLabel}"/>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                        </Grid>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <StackLayout Grid.Row="0" Spacing="0" Padding="20,15" Orientation="Vertical" VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="White">
                <Grid ColumnSpacing="0" RowSpacing="0" Padding="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Grid.Row="0" HorizontalOptions="Start" VerticalOptions="Center" Source="arrowLeft.png" Style="{DynamicResource BackButtonArrow}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Grid.Column="1" Grid.Row="0" Source="ic_logo_gazt.png" HeightRequest="40" WidthRequest="34" />

                    <StackLayout Grid.Column="2" Grid.Row="0">
                        <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource SecondaryNew}"/>
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnVoidOrSaveDraftClick}" NumberOfTapsRequired="1" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </Grid>
                <commonView:PageIndicatorView MarkSize="24" DotSize="12" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" HorizontalOptions="End"/>
                <custom:CustomLabel Text="{Binding SelectedTabText}" Margin="0,10,0,0" HorizontalOptions="Start" VerticalOptions="Center"  Style="{StaticResource PageTitleBlack}" FontFamily="{StaticResource SomarBold}" />
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" HorizontalOptions="StartAndExpand" Style="{StaticResource BodyLabelGrey}" FontFamily="{StaticResource SomarRegular}" FontSize="15"/>
                <BoxView Style="{StaticResource lineSeperator}" Margin="0,15" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" x:Name="TabScrollView">
                    <!--<buttons:SfChipGroup Type="Choice" x:Name="TabSfChipGroup" SelectedItem="{Binding SelectedTabText}" ItemsSource="{x:Binding TabList}" SelectionChanged="SfChipGroup_SelectionChanged" SelectionChanging="SfChipGroup_SelectionChanging" ChipBackgroundColor="Transparent" HorizontalOptions="Start"  SelectedChipBackgroundColor="{StaticResource BackgroundGray}" ChipBorderColor="{StaticResource NeutralLightGrey}" SelectedChipTextColor="{StaticResource Primary}" ChipBorderWidth="1" >
                    </buttons:SfChipGroup>-->

                    <buttons:SfChipGroup Margin="0,10,0,0" x:Name="TabSfChipGroup" Type="Choice" HorizontalOptions="Start"   ChipBackgroundColor="Transparent" SelectedItem="{Binding SelectedTabText}" 
                                         ItemsSource="{Binding TabList}" SelectedChipBackgroundColor="{StaticResource PartialBg}"  ChipBorderColor="{StaticResource NeutralLightGrey}"
                                         ChipBorderWidth="1" VerticalOptions="Center" SelectionChanged="SfChipGroup_SelectionChanged" SelectionChanging="SfChipGroup_SelectionChanging">
                                    <buttons:SfChipGroup.ItemTemplate>
                                        <DataTemplate >
                                            <StackLayout Margin="0" Orientation="Horizontal" Spacing="2" Padding="5,-2,5,-2"  >
                                                <custom:CustomLabel Text="{Binding }" HorizontalOptions="CenterAndExpand" Style="{StaticResource CaptionLabelBlack}"/>
                                            </StackLayout>
                                        </DataTemplate>
                                    </buttons:SfChipGroup.ItemTemplate>
                                </buttons:SfChipGroup>

                </ScrollView>
            </StackLayout>
            <Grid Grid.Row="2" Padding="20,15" BackgroundColor="White" >
                  <Grid.Margin>
                    <OnPlatform x:TypeArguments="Thickness" >
                        <On Platform="iOS" Value="0,0,0,20"/>
                        <On Platform="Android" Value="0"/>
                    </OnPlatform>
                </Grid.Margin>
                <buttons:SfButton Style="{StaticResource PrimaryButtonStyle}" Text="{Binding NxtButtonLabel}" Command="{Binding OnNextButtonClick}" />
            </Grid>
            <Grid Grid.Row="0" Grid.RowSpan="3"  IsVisible="{Binding IsLoading}" Margin="0,-20,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70"
                                        
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70"
                                       TextColor="{StaticResource Secondary}"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
 
        </Grid>
    </ContentPage.Content>
</ContentPage>
