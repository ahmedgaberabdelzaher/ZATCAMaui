                                </Grid.RowDefinitions>

                                <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                            Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                            FontSize="Small" TextColor="Black"
                                                            HorizontalOptions="FillAndExpand" />
                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Rotation="90">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </border:SfBorder>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding WithdrawAttachmentTapped}" />
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--Second Attachment-->

                         

                            <listView:SfListView HorizontalOptions="Center"
                                                     VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                                     ItemsSource="{Binding WithdrawAttachmentsListViewDataTwo}"
                                                     TapCommand="{Binding WithdrawAttachmentTappedTwo}"
                                                     HeightRequest="100"
                                                     SelectionMode="SingleDeselect"
                                                     SelectionBackgroundColor="Transparent">


                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon"
                                                               Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                               HorizontalOptions="Start" VerticalOptions="Center" />

                                                     <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               LineHeight="0.8"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="Center"/>
                                                    <!--<custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                            Text="{Binding Filename}"
                                                                            FontSize="Small" TextColor="Black"
                                                                            HorizontalOptions="FillAndExpand"
                                                                            VerticalOptions="Center" />-->
                                                    <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               Rotation="90">
                                                        <Image.Source>
                                                            <FontImageSource FontFamily="UserIconFont"
                                                                                 Color="DarkGray"
                                                                                 Size="24"
                                                                                 Glyph="{x:Static
                                                                FontImage:IconFonts.Close}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </border:SfBorder>
                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>

                               <custom:CustomLabel Grid.Row="0"
                                            Text="{x:Static ResourceManager:AppResources.ZOWithdrawGeneralAttachmentTwo}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                            Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                            FontSize="Small" TextColor="Black"
                                                            HorizontalOptions="FillAndExpand" />
                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Rotation="90">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </border:SfBorder>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding WithdrawAttachmentTappedTwo}" />
                                </Grid.GestureRecognizers>

                            </Grid>

                        </StackLayout>


                        <custom:CustomLabel Margin="0,10,0,0" Text="{x:Static ResourceManager:AppResources.CRRemarks}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />
                        <border:SfBorder Margin="0,5,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">

                            <custom:GAZTBorderlessEditor PlaceholderColor="Gray" FontSize="Small"
                            HorizontalOptions="FillAndExpand" Text="{Binding RemarkNote}" Style="{StaticResource BodyLabelBlack}" />

                        </border:SfBorder>

                        <custom:CustomLabel Margin="0,10,0,0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlDetailDescription}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}" />
                        <border:SfBorder Margin="0,5,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">

                            <custom:GAZTBorderlessEditor MaxLength="1000" Text="{Binding DetailDescriptionNote}"
                                                         PlaceholderColor="Gray" FontSize="Small"
                                                         MinimumHeightRequest="150" HorizontalOptions="FillAndExpand" Style="{StaticResource BodyLabelBlack}" />

                        </border:SfBorder>

                        <buttons:SfButton  Margin="0,10,0,25" VerticalOptions="End"
                                      Text="{x:Static ResourceManager:AppResources.Submit}"
                                      Style="{StaticResource PrimaryButtonStyle}" Command="{Binding  WithdrAttachmentsContinueTapped}"/>
                    </StackLayout>

                    <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                     Opacity="0.4" VerticalOptions="CenterAndExpand" />
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                     Opacity="0.8" VerticalOptions="CenterAndExpand" HorizontalOptions="Center" Padding="15,15">
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                               EnableAnimation="True"
                                                               AnimationType="SingleCircle"
                                                               HorizontalOptions="CenterAndExpand"
                                                               VerticalOptions="CenterAndExpand"
                                                               IsBusy="True"
                                                               ViewBoxWidth="70"
                                                               TitlePlacement="Bottom"
                                                               ViewBoxHeight="70"
                                                               TextColor="#D99A29" />
                                <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </Grid>

            </Grid>
        </ScrollView>

    </ContentPage.Content>
</ContentPage>