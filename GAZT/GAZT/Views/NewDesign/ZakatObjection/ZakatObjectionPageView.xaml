<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:local1="clr-namespace:EGAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"

             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             mc:Ignorable="d" FlowDirection="RightToLeft"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png"
             x:Class="EGAZT.Views.NewDesign.ZakatObjection.ZakatObjectionPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
         <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                    <Setter Property="Rotation" Value="180" />
                </Style>
                <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                    <Setter Property="Rotation" Value="0" />
                </Style>
            </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>


    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                         <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ZakatObjection}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                       
                         <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                         <!--<Image  Grid.Row="0" Grid.Column="2"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"
                               Source="close"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}"/>
                            </Image.GestureRecognizers>
                        </Image>-->
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}"
                                                  MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}"
                                                  VerticalOptions="CenterAndExpand" DotSize="16"/>
                </Grid>

                <Grid Grid.Row="1">


                    <StackLayout IsVisible="{Binding IsVATBillsViewEnabled}" BackgroundColor="Transparent"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="20,10,20,0">

                        <Grid>
                            <listView:SfListView HorizontalOptions="Center"
                                                 x:Name="ObjectionsList"
                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding ReturnBills}" SelectionMode="Multiple"
                                             SelectionBackgroundColor="Transparent" >

                                <listView:SfListView.HeaderTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <ViewCell.View>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="1"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>

                                                    <custom:CustomLabel Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Static ResourceManager:AppResources.ZOSelectReturn}" HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource SectionTitleBlack}" />
                                                    <custom:CustomLabel Grid.Row="2" Grid.ColumnSpan="3" Text="{x:Static ResourceManager:AppResources.ZOChooseOneReturn}" HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource BodyLabelGrey}"/>
                                                    <BoxView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource NeutralGrayOpacity90BoxView}" HeightRequest="1"/>

                                                    <Frame Grid.Row="4" Padding="0" Grid.ColumnSpan="3" HasShadow="False"  CornerRadius="12" BorderColor="Gray"  Margin="0,10,0,20">
                                                        <SearchBar Text="{Binding InputData}" Margin="0" 
                                                               Placeholder="{x:Static ResourceManager:AppResources.ZOSearchReturnReferenceNumber}"
                                                               PlaceholderColor="Gray" FontSize="Small" TextColor="Black" HorizontalTextAlignment="Center"
                                                               TextChanged="SearchItem_PropertyChanged"
                                                               HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsEnabled="True"/>
                                                    </Frame>

                                                </Grid>

                                            </ViewCell.View>
                                        </ViewCell>
                                    </DataTemplate>
                                </listView:SfListView.HeaderTemplate>
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="10"  >
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                                                <Image Source="re_Tile_Background_S"  Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="1"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*"/>
                                                        <ColumnDefinition Width="50*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Row="0" TextColor="White" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.ZZZAKAT}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource SectionTitleBlack}" />
                                                    <custom:CustomLabel Grid.Row="1" TextColor="White" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding FinancialPeriod}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniNewGrayLabelStyle}"/>
                                                    <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                  
                                                     <custom:CustomLabel  Grid.Row="3" TextColor="White" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="StartAndExpand" VerticalOptions="Center" VerticalTextAlignment="Center">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding AssessmentAmountGAZT,StringFormat='{0:N}',Converter={StaticResource commaSeparatorConverter}}" TextColor="White" Style="{StaticResource SectionTitleBlack}" ></Span>
                                                                    <Span Text="&#160;" Style="{StaticResource SectionTitleBlack}" TextColor="White" ></Span>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" TextColor="White" Style="{StaticResource SectionTitleBlack}" ></Span>
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>


                                                    <custom:CustomLabel Grid.Row="4" TextColor="White" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRReferenceNumber}" Style="{StaticResource MiniNewGrayLabelStyle}"></custom:CustomLabel>
                                                    <custom:CustomLabel Grid.Row="5" TextColor="White" Grid.Column="0" Text="{Binding ReferenceNum}" Style="{StaticResource ValueLabelBlack}"></custom:CustomLabel>
                                                    <custom:CustomLabel Grid.Row="4" TextColor="White" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZakatYear}" Style="{StaticResource MiniNewGrayLabelStyle}"></custom:CustomLabel>
                                                    <custom:CustomLabel Grid.Row="5" TextColor="White" Grid.Column="1" Text="{Binding FiscalYear,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource ValueLabelBlack}"></custom:CustomLabel>
                                                </Grid>
                                            </Grid>
                                        </cards:SfCardView>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </Grid>
                        <Grid VerticalOptions="EndAndExpand">

                            <buttons:SfButton Margin="0,16,0,16"  x:Name="btnVATBillsContinue" Command="{Binding BillContinueBtnTapped}" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}"
                                                     Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>


                    </StackLayout>

                    <StackLayout IsVisible="{Binding IsObjectionDetailsEnabled}" Orientation="Vertical" BackgroundColor="Transparent"
                                 Margin="20,10,20,0" HorizontalOptions="FillAndExpand" >

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOObjectionDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOCompletebelowdetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="5" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="3,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                               VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"
                                               Style="{StaticResource SectionTitleBlack}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="End" Grid.Row="0" Grid.Column="2" Padding="3,0" IsVisible="False">
                                        <Label Text="{x:Static ResourceManager:AppResources.ZOViewReturn}"
                                               VerticalOptions="CenterAndExpand" HorizontalOptions="End"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15,15,15,0">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOFiscalYear}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding FiscalYear}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOFinancialPeriod}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding FinancialPeriod}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOReturnReferenceNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ReferenceNum}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOTaxType}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding TaxType}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOAssessmentAmountGAZT}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding AssessmentAmountGAZT,StringFormat='{0:N} SAR',Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZORevisedAmount}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding RevisedAmount,StringFormat='{0:N} SAR',Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZODisputeAmount}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding DisputeAmount,StringFormat='{0:N} SAR',Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </StackLayout>

                        </border:SfBorder>

                        <custom:CustomLabel 
                                            Text="{x:Static ResourceManager:AppResources.ZOWritteyourObjectionReason}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />

                        <border:SfBorder Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">

                            <custom:GAZTBorderlessEditor MaxLength="1000" IsEnabled="False" Text="{Binding ObjectionReasons}"
                                                         PlaceholderColor="Gray" FontSize="Small"
                                                         MinimumHeightRequest="150" HorizontalOptions="FillAndExpand" Style="{StaticResource BodyLabelBlack}" />

                        </border:SfBorder>

                        <buttons:SfButton Margin="0,16,0,16" VerticalOptions="EndAndExpand"
                                          Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding IsObjectionDetailsTapped}" />

                    </StackLayout>


                    <StackLayout IsVisible="{Binding IsAttachmentsViewEnabled}" BackgroundColor="Transparent"
                                 Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOAttachments}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOCompletebelowdetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>


                        <Grid HorizontalOptions="FillAndExpand">

                            <listView:SfListView HorizontalOptions="Center"
                                                     IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                     VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                                     ItemsSource="{Binding AttachmentsListViewData}"
                                                     TapCommand="{Binding NewAttachmentTapped}"
                                                     SelectionMode="SingleDeselect"
                                                     SelectionBackgroundColor="Transparent">


                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon"
                                                               Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                               HorizontalOptions="Start" VerticalOptions="Center" />

                                                    <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               LineHeight="0.8"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="Center"/>

                                                    <!--<custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                            Text="{Binding Filename}"
                                                                            FontSize="Small" TextColor="Black"
                                                                            HorizontalOptions="FillAndExpand"
                                                                            VerticalOptions="Center" />-->
                                                    <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               Rotation="90">
                                                        <Image.Source>
                                                            <FontImageSource FontFamily="UserIconFont"
                                                                                 Color="DarkGray"
                                                                                 Size="24"
                                                                                 Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </border:SfBorder>
                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </Grid>

                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRNewAttachment}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}" />
                            <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                            Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                            FontSize="Small" TextColor="Black"
                                                            HorizontalOptions="FillAndExpand" />
                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </border:SfBorder>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                            </Grid.GestureRecognizers>

                        </Grid>

                        <buttons:SfButton  Margin="0,16,0,16" VerticalOptions="End"
                                      Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                      Style="{StaticResource PrimaryButtonStyle}" Command="{Binding  AttachmentsContinueTapped}"/>


                    </StackLayout>

                    <StackLayout IsVisible="{Binding IsSecurityPaymentsVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.VRSecurityPayment}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />

                            <BoxView Grid.Row="1" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Margin="0,5,0,10" HorizontalOptions="FillAndExpand">

                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.VRSecurityType}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}" />

                        </Grid>

                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                            <listView:SfListView HorizontalOptions="FillAndExpand" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="StartAndExpand" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding SecurityPaymentOptions}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"  SelectionMode="Single" IsEnabled="False"
                                      SelectionBackgroundColor="Transparent">

                                <listView:SfListView.ItemTemplate>

                                    <DataTemplate>
                                        <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="120">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                                <Image IsVisible="{Binding IsSelected}" Source="vat_tile_listofsignup" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>

                                                <Image IsVisible="{Binding IsNotSelected}" Source="vat_tile_listofsignup_W" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
