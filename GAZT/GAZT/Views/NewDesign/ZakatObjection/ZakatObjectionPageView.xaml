<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:local1="clr-namespace:EGAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             mc:Ignorable="d" FlowDirection="RightToLeft"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png"
             x:Class="EGAZT.Views.NewDesign.ZakatObjection.ZakatObjectionPageView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>


    </ContentPage.Resources>
    
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"
                               Text="{x:Static ResourceManager:AppResources.ZakatObjection}" TextColor="White"
                               HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}"
                               TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource IconLabelStyle}" TextColor="White"
                               Text="{StaticResource Close}" VerticalOptions="CenterAndExpand"
                               HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}"
                                                  MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}"
                                                  VerticalOptions="CenterAndExpand" />
                </Grid>

                <Grid Grid.Row="1">

                    
                <Grid IsVisible="{Binding IsObjectionDetailsEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*"></ColumnDefinition>
                            <ColumnDefinition Width="50*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlObjectionDetails}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />

                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlObjectionNo}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{Binding ObjectionRefNumber}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>

                        <BoxView Grid.ColumnSpan="2" Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                    </Grid>



                    <border:SfBorder Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2" Margin="0,10,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>

                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlRefNumberOfAssessmen}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding RefNumberOfAssessmen}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlAssessmentYear}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{Binding AssessmentYear}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="2" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlPeriodFrom}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="1" Text="{Binding PeriodFrom}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="3" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlPeriodTo}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="3" Grid.Column="1" Text="{Binding PeriodTo}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="4" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlTaxType}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="4" Grid.Column="1" Text="{Binding TaxType}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="5" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlCurrency}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="5" Grid.Column="1" Text="{Binding Currency}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="6" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlAssessmentAmount}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="6" Grid.Column="1" Text="{Binding AssessmentAmount}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="7" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlRevisedAmount}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="7" Grid.Column="1" Text="{Binding RevisedAmount}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                            <custom:CustomLabel Grid.Row="8" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlDisputeAmount}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                            <custom:CustomLabel Grid.Row="8" Grid.Column="1" Text="{Binding DisputeAmount}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>
                        </Grid>
                    </border:SfBorder>

                    <buttons:SfButton Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0" VerticalOptions="End"
                                      Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDetails}"
                                      Style="{StaticResource PrimaryButtonStyle}" Command="{Binding  ObjectionDetailsContinueTapped}"/>
                </Grid>


                <Grid IsVisible="{Binding IsObjectionAttachmentsEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ZVatAttachments}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />

                        <custom:CustomLabel Grid.Row="1"  Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>

                        <BoxView Grid.Row="2" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                    </Grid>

                    <Grid Grid.Row="1">

                        <listView:SfListView  HorizontalOptions="Center" IsScrollBarVisible="False"
                                              IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                              ItemsSource="{Binding ZakatObjectionAttachmentsDataList}"
                                              SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent"
                                              TapCommand="{Binding ZakatObjectionAttachmentsTapped}">

                            <listView:SfListView.FooterTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ViewCell.View>
                                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <custom:CustomLabel Grid.Row="0"
                                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAttachmentBankSettlement}"
                                                                    HorizontalOptions="StartAndExpand" Style="{StaticResource MicroGrayLabelStyle}" />
                                                <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                                                 Style="{StaticResource SfStyleGreyBorderFrame}">

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                                            FontSize="Small" TextColor="Black"
                                                                            HorizontalOptions="FillAndExpand" />
                                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                                               Rotation="90">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                                 Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                                <custom:CustomLabel Grid.Row="2"
                                                                    Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                                                    HorizontalOptions="StartAndExpand" Style="{StaticResource MicroGrayLabelStyle}" />

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ZakatObjectionAttachmentsTapped}"/>
                                                </Grid.GestureRecognizers>

                                            </Grid>
                                        </ViewCell.View>
                                    </ViewCell>
                                </DataTemplate>
                            </listView:SfListView.FooterTemplate>
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>

                                        <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Row="0" Grid.Column="0" Source="newui_ic_pdf" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>


                                                <custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                    Text="{Binding Filename}"
                                                                    FontSize="Small" TextColor="Black"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    VerticalOptions="Center"/>
                                                <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </border:SfBorder>
                                        <custom:CustomLabel Grid.Row="1"
                                                            Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MicroGrayLabelStyle}" />

                                    </Grid>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>

                    </Grid>

                    <StackLayout Grid.Row="2" Orientation="Vertical" VerticalOptions="End">

                        <cards:SfCardView Padding="10,0,10,0" Margin="0,10,0,5" HorizontalOptions="FillAndExpand" HasShadow="False" BorderColor="Gray" BorderWidth="0.2" CornerRadius="15">
                            <custom:BorderlessEntry Text="{Binding RemarksText}" HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}" Placeholder="{x:Static ResourceManager:AppResources.ZOWithdrawlRemarks}"/>
                        </cards:SfCardView>

                        <cards:SfCardView Padding="10,0,10,0" Margin="0,5,0,10" HorizontalOptions="FillAndExpand" HasShadow="False" BorderColor="Gray" BorderWidth="0.2" CornerRadius="15">
                            <custom:BorderlessEntry Text="{Binding DetailDescriptionText}" HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}"  Placeholder="{x:Static ResourceManager:AppResources.ZOWithdrawlDetailDescription}"/>
                        </cards:SfCardView>

                        <buttons:SfButton  Margin="0,16,0,0"
                                      Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDetails}"
                                      Style="{StaticResource PrimaryButtonStyle}" Command="{Binding  ObjectionAttachmentsContinueTapped}"/>
                    </StackLayout>

                   

                </Grid>
                    
                    <StackLayout IsVisible="{Binding IsAttachmentsViewEnabled}" BackgroundColor="Transparent"
                                 Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOAttachments}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOCompletebelowdetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>
                        
                        <StackLayout Orientation="Vertical">
                            
                            <Grid HorizontalOptions="FillAndExpand">

                                <listView:SfListView HorizontalOptions="Center"
                                                     IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                     VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                                     ItemsSource="{Binding OtherAttachmentsListViewData}"
                                                     TapCommand="{Binding NewAttachmentTapped}"
                                                     SelectionMode="SingleDeselect"
                                                     SelectionBackgroundColor="Transparent">


                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Source="newui_ic_pdf"
                                                               Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                               HorizontalOptions="Start" VerticalOptions="Center" />


                                                        <custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                            Text="{Binding Filename}"
                                                                            FontSize="Small" TextColor="Black"
                                                                            HorizontalOptions="FillAndExpand"
                                                                            VerticalOptions="Center" />
                                                        <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               Rotation="90">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont"
                                                                                 Color="DarkGray"
                                                                                 Size="24"
                                                                                 Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                                <custom:CustomLabel Grid.Row="1"
                                                                    Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                                                    HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource MicroGrayLabelStyle}" />

                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>

                            <Grid HorizontalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRNewAttachment}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}" />
                                <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                                 Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                            Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                            FontSize="Small" TextColor="Black"
                                                            HorizontalOptions="FillAndExpand" />
                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Rotation="90">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </border:SfBorder>
                                <custom:CustomLabel Grid.Row="2"
                                                    Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MicroGrayLabelStyle}" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </StackLayout>
                        
                    </StackLayout>
                    
                    <StackLayout IsVisible="{Binding IsObjectionDetailsEnabled}" Orientation="Vertical" BackgroundColor="Transparent"
                                 Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOObjectionDetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZOCompletebelowdetails}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>
                        
                        <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VRReviewReason}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label 
                                               Text="{x:Static ResourceManager:AppResources.ZOViewReturn}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15,15,15,0">
                                   
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
