<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
            xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:local1="clr-namespace:EGAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             mc:Ignorable="d" FlowDirection="RightToLeft"
            xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"

              xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.ZAKATObjectionPages.ZakatObjectionsListPageView"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png"
             >

    <ContentPage.Resources>
        <ResourceDictionary>
        <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>


    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ZakatIncomeTaxObjection}" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="0" Grid.Column="2"  Style="{StaticResource IconLabelStyle}" TextColor="White" Text="{StaticResource Close}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <StackLayout IsVisible="{Binding CreateZakatInstalmentBtnVisible}">
                    <Grid  BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatObjection}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{Binding ObjectionsCount}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                        </Grid>


                        <cards:SfCardView Grid.Row="1" Margin="0,20,0,0" Padding="12" HasShadow="False" BorderColor="Gray" BorderWidth="0.2" CornerRadius="15" IsVisible="false">

                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0" Grid.Column="0" Source="add" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start"></Image>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZakatObjection}" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" />
                                <Grid.GestureRecognizers>
                                    <!--<TapGestureRecognizer Command="{Binding ReqInstalmentBtnTapped}"></TapGestureRecognizer>-->
                                </Grid.GestureRecognizers>
                            </Grid>

                        </cards:SfCardView>

                        <!-- Display Submitted list-->


                        <listView:SfListView  Grid.Row="2" x:Name="VATInstalmentPlanListViewPage" HorizontalOptions="CenterAndExpand" IsScrollBarVisible="False" Margin="0" Padding="0"
                                                  IsScrollingEnabled="False" VerticalOptions="StartAndExpand" AutoFitMode="Height"  ItemSpacing="0" 
                                      ItemsSource="{Binding ObjectionsList}" ItemTapped="Objection_ItemTapped" SelectionMode="Single" SelectionBackgroundColor="Transparent">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <border:SfBorder Padding="10"  Grid.Column="0" CornerRadius="15" Margin="0,15,0,0" HasShadow="True" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <Grid Padding="0" RowSpacing="5" Margin="0">
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="1"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*"/>
                                                <ColumnDefinition Width="50*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
                                                <custom:CustomLabel    Text="{x:Static ResourceManager:AppResources.NDZakatObjection}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource SectionTitleBlack}" Margin="0" />

 

                                                <Label  Text="{Binding Fbnum}" Style="{StaticResource ValueLabelGrey}" LineHeight="0.7" HorizontalTextAlignment="Start" 
                                               HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"/>
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand">

 

                                                <yummy:PancakeView Padding="8,3,8,3" CornerRadius="14" BorderThickness="1" BackgroundColor="#E5EFED"  VerticalOptions="CenterAndExpand" HorizontalOptions="Center" >

 

                                                    <Label Style="{StaticResource CaptionLabelBlack}" TextColor="DarkGoldenrod" Text="{Binding StatText}" HorizontalTextAlignment="Center" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                        <Label.Triggers>

 

                                                            <DataTrigger TargetType="Label" Binding="{Binding StatText}" Value="{x:Static ResourceManager:AppResources.Submitted}">
                                                                <Setter Property="Text" Value="Submitted" />
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                                                            </DataTrigger>

 

                                                        </Label.Triggers>
                                                    </Label>
                                                </yummy:PancakeView>
                                            </StackLayout>
                                            
                                            <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                                            <StackLayout Grid.Row="2" Grid.Column="0">
                                                <Label Text="{x:Static ResourceManager:AppResources.ZOObjectionType}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="{Binding FbtText}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Label Text="{x:Static ResourceManager:AppResources.OZObjectionDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="{Binding Erfdate}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            </StackLayout>

 

                                        </Grid>
                                    </border:SfBorder>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>

 

                        </listView:SfListView>
                    </Grid>

                </StackLayout>
                
                <Grid IsVisible="{Binding IsSummaryEnable}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <StackLayout Orientation="Vertical">

                        <Grid Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRSummary}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="5" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="3,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.ZOObjectionDetails}"
                                               VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="End" Grid.Row="0" Grid.Column="2" Padding="3,0" IsVisible="False">
                                        <Label  Text="{x:Static ResourceManager:AppResources.ZOViewReturn}"
                                               VerticalOptions="CenterAndExpand" HorizontalOptions="End"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="5">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZORefNumberOfAssessmen}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding ReferenceNumberOfAssessment}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>

                                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOAssessmentYear}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{Binding AssessmentYear}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>


                                        <custom:CustomLabel Grid.Row="2" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOPeriodFrom}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="2" Grid.Column="1" Text="{Binding PeriodFrom}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>


                                        <custom:CustomLabel Grid.Row="3" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOPeriodTo}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="3" Grid.Column="1" Text="{Binding PeriodTo}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>


                                        <custom:CustomLabel Grid.Row="4" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOTaxType}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="4" Grid.Column="1" Text="{Binding DisplaTaxType}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>

                                        <custom:CustomLabel Grid.Row="5" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOCurrency}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="5" Grid.Column="1" Text="{Binding Currency}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>

                                        <custom:CustomLabel Grid.Row="6" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOAssessmentAmount}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="6" Grid.Column="1" Text="{Binding AssessmentAmount,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>

                                        <custom:CustomLabel Grid.Row="7" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZORevisedAmount}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="7" Grid.Column="1" Text="{Binding DisplayRevisedAmount,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>


                                        <custom:CustomLabel Grid.Row="8" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZODisputeAmount}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Row="8" Grid.Column="1" Text="{Binding DisplayDisputeAmount,Converter={StaticResource commaSeparatorConverter}}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>

                                </StackLayout>
                            </StackLayout>

                        </border:SfBorder>

                       

                        <border:SfBorder IsVisible="{Binding IsAttachmentsVisible}" Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.Attachments}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToDeclaration}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15,15,15,0">

                                    <listView:SfListView  Grid.Row="0" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center"
                                                          ItemsSource="{Binding AttachmentsListViewData}" SelectionMode="None" SelectionBackgroundColor="Transparent">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VRAttachment}" Style="{StaticResource ValueLabelGrey}"/>
                                                    <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                                </Grid>

                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>

                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                        <border:SfBorder Margin="0,16,0,10" Padding="10" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"></ColumnDefinition>
                                    <ColumnDefinition Width="50*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlRemarks}" Style="{StaticResource ValueLabelGrey}"/>
                               
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding DisplayRemarks}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Center" HorizontalTextAlignment="End"/>

                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZOWithdrawlDetailDescription}" Style="{StaticResource ValueLabelGrey}"/>

                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{Binding DisplayDetailDescription}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Center" HorizontalTextAlignment="End"/>
                            </Grid>


                        </border:SfBorder>

    
                        <buttons:SfButton  Margin="0,16,0,16"
                                          Text="{x:Static ResourceManager:AppResources.DownloadAcknowlwdgement}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding Download_Acknowledgement}" />


                        <buttons:SfButton  Margin="0,16,0,16"
                                          Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding ZDownloadForm}" />
 





                    </StackLayout>
                </Grid>

                    <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                     Opacity="0.4" VerticalOptions="FillAndExpand" />
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                     Opacity="0.8" VerticalOptions="EndAndExpand" HorizontalOptions="Center" Padding="15,15">
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                               EnableAnimation="True"
                                                               AnimationType="SingleCircle"
                                                               HorizontalOptions="CenterAndExpand"
                                                               VerticalOptions="EndAndExpand"
                                                               IsBusy="True"
                                                               ViewBoxWidth="70"
                                                               TitlePlacement="Bottom"
                                                               ViewBoxHeight="70"
                                                               TextColor="#D99A29" />
                                <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                            </StackLayout>
                        </StackLayout>
                    </Grid>
               
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>