<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.TrackShipment.ShipmentTrackingTypesPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

         <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}" 
                    Text="{x:Static ResourceManager:AppResources.ShipmentTracking}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="30">

                        <!--  Select Shipment Type Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            Margin="0,30,0,0"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.SelectShipmentType}"
                            TextColor="{StaticResource Primary}" />


                        <Grid RowDefinitions="*,*,*"
                              ColumnSpacing="20"
                              RowSpacing="20"
                              ColumnDefinitions="*,*">

                            <!--Express Card-->
                            <Grid
                                WidthRequest="171"
                                Padding="0"
                                VerticalOptions="StartAndExpand"
                                HorizontalOptions="StartAndExpand"
                                HeightRequest="110">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                       Source="UnselectedCard.png"/>

                                <StackLayout VerticalOptions="EndAndExpand"
                                             HorizontalOptions="StartAndExpand"
                                             Margin="15,10"
                                             Spacing="15">

                                    <!--Express icon-->
                                    <Image Aspect="AspectFit"
                                            WidthRequest="40"
                                            HeightRequest="30"
                                            HorizontalOptions="StartAndExpand"
                                            Source="expressBlue.png"/>

                                    <!--  Express Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="16"
                                        TextColor="#002447"
                                        Text="{x:Static ResourceManager:AppResources.ExpressShipping}"/>

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}"
                                                          CommandParameter="5"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                             <!--Air Card-->
                            <Grid
                                WidthRequest="171"
                                Padding="0"
                                Grid.Column="1"
                                VerticalOptions="StartAndExpand"
                                HorizontalOptions="StartAndExpand"
                                HeightRequest="110">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                        Source="UnselectedCard.png"/>

                                <StackLayout VerticalOptions="EndAndExpand"
                                             HorizontalOptions="StartAndExpand"
                                             Margin="15,10"
                                             Spacing="15">

                                    <!--Air Freight icon-->
                                    <Image Aspect="AspectFit"
                                            WidthRequest="40"
                                            HeightRequest="30"
                                            HorizontalOptions="StartAndExpand"
                                            Source="airBlue.png"/>

                                    <!--  Air Freight Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="16"
                                        TextColor="#002447"
                                        Text="{x:Static ResourceManager:AppResources.AirFreight}"/>

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}"
                                                          CommandParameter="4"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                             <!--Sea Card-->
                            <Grid
                                WidthRequest="171"
                                Padding="0"
                                Grid.Row="1"
                                VerticalOptions="StartAndExpand"
                                HorizontalOptions="StartAndExpand"
                                HeightRequest="110">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                        Source="UnselectedCard.png"/>

                                <StackLayout VerticalOptions="EndAndExpand"
                                             HorizontalOptions="StartAndExpand"
                                             Margin="15,10"
                                             Spacing="15">

                                    <!--Sea Freight icon-->
                                    <Image Aspect="AspectFit"
                                            WidthRequest="40"
                                            HeightRequest="30"
                                            HorizontalOptions="StartAndExpand"
                                            Source="seaBlue.png"/>

                                    <!--  Sea Freight Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="16"
                                        TextColor="#002447"
                                        Text="{x:Static ResourceManager:AppResources.SeaFreight}"/>

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}"
                                                          CommandParameter="1"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--Land Card-->
                            <Grid
                                WidthRequest="171"
                                Padding="0"
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalOptions="StartAndExpand"
                                HorizontalOptions="StartAndExpand"
                                HeightRequest="110">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                        Source="UnselectedCard.png"/>

                                <StackLayout VerticalOptions="EndAndExpand"
                                             HorizontalOptions="StartAndExpand"
                                             Margin="15,10"
                                             Spacing="15">

                                    <!--Sea Freight icon-->
                                    <Image Aspect="AspectFit"
                                            WidthRequest="40"
                                            HeightRequest="30"
                                            HorizontalOptions="StartAndExpand"
                                            Source="landBlue.png"/>

                                    <!--  Sea Freight Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="16"
                                        TextColor="#002447"
                                        Text="{x:Static ResourceManager:AppResources.LandFreight}"/>

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}"
                                                          CommandParameter="3"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--Train Card-->
                            <Grid
                                WidthRequest="171"
                                Padding="0"
                                Grid.Row="2"
                                VerticalOptions="StartAndExpand"
                                HorizontalOptions="StartAndExpand"
                                HeightRequest="110">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                        Source="UnselectedCard.png"/>

                                <StackLayout VerticalOptions="EndAndExpand"
                                             HorizontalOptions="StartAndExpand"
                                             Margin="15,10"
                                             Spacing="15">

                                    <!--Train Freight icon-->
                                    <Image Aspect="AspectFit"
                                            WidthRequest="40"
                                            HeightRequest="30"
                                            HorizontalOptions="StartAndExpand"
                                            Source="trainBlue.png"/>

                                    <!--  Train Freight Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="16"
                                        TextColor="#002447"
                                        Text="{x:Static ResourceManager:AppResources.TrainFreight}"/>

                                </StackLayout>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CardSelectionCommand}"
                                                          CommandParameter="2"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                        </Grid>
                        
                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

        </Grid>

    </ContentPage.Content>
</ContentPage>

