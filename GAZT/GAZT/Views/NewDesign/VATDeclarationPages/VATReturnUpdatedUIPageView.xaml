<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
             x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.GAZTNewDesignVATReturnUpdatedUIPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView" x:Key="boxIndicator">
                <Setter Property="BackgroundColor" Value="{StaticResource NeutralLightGrey}"/>
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>

            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="AliceBlue"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="HasShadow" Value="False"/>
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="{StaticResource Primary}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <yummy:PancakeView Grid.Row="1" BackgroundColor="White" CornerRadius="15,15,0,0" Padding="18,0,18,0">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" RowSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>

                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>

                        <StackLayout Orientation="Horizontal" BackgroundColor="White" Grid.Row="0" >
                            
                            <Label Padding="0,15,0,0" Margin="0" HorizontalOptions="Start" Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackStepClicked}" />
                                </Label.GestureRecognizers>
                            </Label>
                            
                            <StackLayout Orientation="Horizontal" VerticalOptions="CenterAndExpand">
                                <Grid BackgroundColor="White" Margin="0,15,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="10"/>
                                    </Grid.RowDefinitions>                                    
                                    <Frame Grid.Row="0"  Padding="0" CornerRadius="15" BackgroundColor="{TemplateBinding BindingContext.OuterFrame}">
                                        <StackLayout Orientation="Horizontal" Padding="0">
                                            <Frame Padding="0" CornerRadius="15" BackgroundColor="{TemplateBinding BindingContext.secOuterFrame}">
                                                <StackLayout Orientation="Horizontal" Padding="0">
                                                    <Frame Padding="0" CornerRadius="15" BackgroundColor="{TemplateBinding BindingContext.innerFrame}">
                                                        <StackLayout Orientation="Horizontal" Padding="0">
                                                            <BoxView Style="{StaticResource boxIndicator}" BackgroundColor="{StaticResource Primary}"/>
                                                            <BoxView Style="{StaticResource boxIndicator}" BackgroundColor="{TemplateBinding BindingContext.secBox}"/>
                                                        </StackLayout>
                                                    </Frame>
                                                    <BoxView Style="{StaticResource boxIndicator}" BackgroundColor="{TemplateBinding BindingContext.thirdBox}"/>
                                                </StackLayout>
                                            </Frame>
                                            <BoxView Style="{StaticResource boxIndicator}" BackgroundColor="{TemplateBinding BindingContext.fourthBox}"/>
                                        </StackLayout>
                                    </Frame>
                                </Grid>
                                
                                <Image Margin="0,6,0,0" IsVisible="{TemplateBinding BindingContext.isCheckVisible}" Source="ic_vat_check"/>
                            
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>
                <Grid Padding="15,10,15,10" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="60*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="1" Grid.Row="0"   Text="VAT Return" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />

                    <StackLayout Grid.Row="0" Grid.Column="0">
                        <Image IsVisible="{Binding IsBackBtnVisible}" Source="arrowLeftwhite" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <!--                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                                </Image.GestureRecognizers>-->
                        </Image>
                    </StackLayout>

                    <StackLayout  Grid.Row="0" Grid.Column="2">
                        <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}"/>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    <!--<Label Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>-->
                    <!--                        <Label Grid.Row="0" Grid.Column="2"  Style="{StaticResource IconLabelStyle}" TextColor="White" Text="{StaticResource Close}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer  Tapped="onMoreOptionClicked"></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>-->
                </Grid>


            </Grid>

        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid Padding="0,0,0,0" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

 <Grid Grid.Row="0" IsVisible="{Binding IsInstrunctionView}"  x:Name="InstrunctionSection">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackLayout  HorizontalOptions="FillAndExpand" Grid.Row="1" BackgroundColor="White" Margin="0,16,0,0">
                    <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">

                        <StackLayout BackgroundColor="White">
                            <custom:CustomLabel HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="1."/>
                                        <Span Text="{x:Static custom2:AppResources.ZZPleasefilltherequestedinformationforeachstep}"  />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="2."/>
                                        <Span Text="{x:Static custom2:AppResources.ZVatSubmittedInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel  VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="3."/>
                                        <Span  Text="{x:Static custom2:AppResources.ZVatDateInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="4."/>
                                        <Span Text="{x:Static custom2:AppResources.ZVatFaqSectionInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <custom:CustomLabel  Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}" TextColor="{StaticResource NewDullOrangeColor}">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>


                            <StackLayout Orientation="Horizontal">
                                <CheckBox x:Name="chkDeclaration"  VerticalOptions="CenterAndExpand" IsChecked="{Binding IsInstrunctionChecked}">
                                    <CheckBox.Triggers>
                                        <DataTrigger TargetType="CheckBox"  Value="false">
                                            <Setter Property="Color" Value="#ff0000" />
                                        </DataTrigger>
                                    </CheckBox.Triggers>
                                </CheckBox>
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelBlack}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static custom2:AppResources.ZVatDeclarationInstructions}"  />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                            </StackLayout>

                        </StackLayout>
                    </ScrollView>
                </StackLayout>


                <StackLayout Grid.Row="0" BackgroundColor="White" Margin="0,-17,0,0" Spacing="0">

                    <Label Text="{x:Static custom2:AppResources.ZInstructions}"  Style="{StaticResource PageTitleBlack}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                    <Label Text="{x:Static custom2:AppResources.ZVatReadInstructions}" BackgroundColor="White" Style="{StaticResource CaptionLabelGrey}"/>
                    <BoxView Style="{StaticResource lineSeperator}"/>
                </StackLayout>
            </Grid>

            <Grid Grid.Row="0" Margin="0,-15,0,0" IsVisible="{Binding IsTaxpayerView}" RowSpacing="0"  x:Name="TaxpayerDetails">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollView Grid.Row="1">
                    <StackLayout>
                        <custom:CustomLabel Text="Tax Return Details" Style="{StaticResource ValueLabelBlack}" />

                        <custom:CustomLabel Text="Return Type" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="Value Added Tax - Quarterly"     Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="VAT Return" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="New"     Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="Return Reference No."     Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="TAX Period" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="Quarter 2 - 2020" Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="Period From" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="01-April-2020" Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="Period To" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="30-June-2020" Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>



                        <custom:CustomLabel Text="Taxpayer Inforamtion" Style="{StaticResource ValueLabelBlack}" />

                        <custom:CustomLabel Text="TIN" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="3100108091" Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="VAT Account Number" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="3100108091000003" Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="Identification Number" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="1007293549" Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="Taxpayer Name" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry  IsReadOnly="True" Text="Zaed" Style="{StaticResource DefaultEntry}">
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="Address" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <custom:GAZTBorderlessEditor  HeightRequest="100" IsReadOnly="True" Text="Address line1 Address line 2"   Style="{StaticResource DefaultEntry}"   Margin="0" BackgroundColor="White"  >
                            </custom:GAZTBorderlessEditor>
                        </inputLayout:SfTextInputLayout>

                        <StackLayout Orientation="Horizontal">
                            <CheckBox VerticalOptions="CenterAndExpand" IsChecked="{Binding IsInstrunctionChecked}">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox"  Value="false">
                                        <Setter Property="Color" Value="#ff0000" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                            <custom:CustomLabel   Style="{StaticResource CaptionLabelBlack}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static custom2:AppResources.ZVatConfirmMessage}"  />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>


                <StackLayout Grid.Row="0" BackgroundColor="White">
                    <custom:CustomLabel Text="Taxpayer Details"  Style="{StaticResource PageTitleBlack}" />
                    <custom:CustomLabel Text="Complete the below details"  BackgroundColor="White" Style="{StaticResource CaptionLabelGrey}" />
                    <BoxView Style="{StaticResource lineSeperator}"/>
                </StackLayout>
            </Grid>

            <Grid Grid.Row="0" Margin="0,-15,0,0" IsVisible="{Binding IsVATReturnsView}" x:Name="VATReturnsSection" BackgroundColor="White" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollView Grid.Row="1">
                    <StackLayout BackgroundColor="White">
                        <custom:CustomLabel Text="Do you have sales or purchases subject to 15% VAT as per the transitional provisions or Sales, purchases, imports and adjustments subject to 5% VAT that you would like to declare in this period?*" Style="{StaticResource CaptionLabelBlack}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
