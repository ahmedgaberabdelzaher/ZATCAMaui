                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*"/>
                                                <ColumnDefinition Width="50*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Text="Standard Rated Sales" Style="{StaticResource ValueLabelBlack}" Margin="10,0,10,0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"></custom:CustomLabel>
                                            <Image Source="ic_vat_info" Style="{StaticResource ImageStyleForInputTable}" Grid.Row="0" Grid.Column="1">

                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnStandardRatedTapped"/>
                                                </Image.GestureRecognizers>
                                            </Image>

                                            <custom:CustomLabel Text="Amount" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,-8" Grid.Row="1" Grid.Column="0"></custom:CustomLabel>
                                            <custom:CustomLabel Text="Adjustment" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,-8" Grid.Row="1" Grid.Column="1"></custom:CustomLabel>


                                            <inputLayout:SfTextInputLayout   Grid.Row="2" Grid.Column="0"  Style="{StaticResource InputTableTextInputLayoutStyle}">
                                                <custom:GAZTBorderlessEntry  Text="500"     Style="{StaticResource DefaultEntry}">
                                                </custom:GAZTBorderlessEntry>

                                            </inputLayout:SfTextInputLayout>
                                            <inputLayout:SfTextInputLayout   Grid.Row="2" Grid.Column="1"  Style="{StaticResource InputTableTextInputLayoutStyle}" Padding="0">
                                                <custom:GAZTBorderlessEntry  Text="500"     Style="{StaticResource DefaultEntry}">
                                                </custom:GAZTBorderlessEntry>


                                            </inputLayout:SfTextInputLayout>

                                            <!---->
                                            <custom:CustomLabel Text="Standard Rated Sales(15%)" Style="{StaticResource ValueLabelBlack}" Margin="10,0,10,0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"></custom:CustomLabel>
                                            <Image Source="ic_vat_info" Style="{StaticResource ImageStyleForInputTable}" Grid.Row="3" Grid.Column="1">

                                            </Image>


                                            <custom:CustomLabel Text="Amount" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,-8" Grid.Row="4" Grid.Column="0"></custom:CustomLabel>
                                            <custom:CustomLabel Text="Adjustment" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,-8" Grid.Row="4" Grid.Column="1"></custom:CustomLabel>

                                            <inputLayout:SfTextInputLayout   Grid.Row="5" Grid.Column="0"  Style="{StaticResource InputTableTextInputLayoutStyle}">
                                                <custom:GAZTBorderlessEntry  Text="500"     Style="{StaticResource DefaultEntry}">
                                                </custom:GAZTBorderlessEntry>

                                            </inputLayout:SfTextInputLayout>

                                            <inputLayout:SfTextInputLayout   Grid.Row="5" Grid.Column="1"  Style="{StaticResource InputTableTextInputLayoutStyle}">
                                                <custom:GAZTBorderlessEntry  Text="500"     Style="{StaticResource DefaultEntry}">
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--One Added as of now-->
                                            <custom:CustomLabel Text="Sales Subject to VAT at (5%)" Style="{StaticResource ValueLabelBlack}" Margin="10,0,10,0" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"></custom:CustomLabel>
                                            <Image Source="ic_vat_info" Style="{StaticResource ImageStyleForInputTable}" Grid.Row="6" Grid.Column="1"></Image>

                                            <custom:CustomLabel Text="Amount" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,-8" Grid.Row="7" Grid.Column="0"></custom:CustomLabel>
