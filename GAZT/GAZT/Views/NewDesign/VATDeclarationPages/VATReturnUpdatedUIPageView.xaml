                                                <custom:GAZTBorderlessEntry  Text="500"     Style="{StaticResource DefaultEntry}">
                                                </custom:GAZTBorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <inputLayout:SfTextInputLayout   Grid.Row="11" Grid.Column="1"  Style="{StaticResource InputTableTextInputLayoutStyle}">
                                                <custom:GAZTBorderlessEntry  Text="500"     Style="{StaticResource DefaultEntry}">
