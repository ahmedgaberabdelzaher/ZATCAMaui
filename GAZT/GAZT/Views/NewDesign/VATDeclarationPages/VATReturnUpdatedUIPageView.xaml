                                            <custom:CustomLabel Text="Private HealthCare/Private Education" Style="{StaticResource ValueLabelBlack}" Margin="10,0,10,0" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"></custom:CustomLabel>
