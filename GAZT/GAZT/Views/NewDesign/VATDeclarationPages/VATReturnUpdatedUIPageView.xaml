                            </Grid>
                            <Grid Grid.Column="1">
                                <Image Source="re_Property_Tile_Background_White"  />
                                <custom:CustomLabel Text="No" Style="{StaticResource ValueLabelBlack}" VerticalOptions="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Grid>
