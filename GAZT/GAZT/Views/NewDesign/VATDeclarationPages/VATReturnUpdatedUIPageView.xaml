                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type Expander}}, Path=IsExpanded}" Value="true">
                                                    <Setter Property="Rotation" Value="180"/>
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </StackLayout>
                                </Expander.Header>
                                <StackLayout Spacing="0">
                                    <BoxView Style="{StaticResource lineSeperator}"/>
                                    
