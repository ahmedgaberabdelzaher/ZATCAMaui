                        <!--Tax Return Details Starts-->
                        <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout>
                                <StackLayout Orientation="Horizontal" Padding="10">
                                    <Frame Style="{StaticResource circleFrame}">
                                        <Image Source="ic_vat_return">

                                        </Image>
                                    </Frame>
                                    <custom:CustomLabel Text="Tax Return Details" Style="{StaticResource SectionTitleBlack}"/>
                                </StackLayout>

                                <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                <StackLayout Padding="10" Spacing="10">
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Return Type" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="VAT Return" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Return Reference Num" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="123456789" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Tax Period" Style="{StaticResource ValueLabelGrey}"/>
                                        <StackLayout Spacing="0" HorizontalOptions="EndAndExpand">
                                            <custom:CustomLabel Text="01st Jan 2019" Style="{StaticResource ValueLabelBlack}" />
                                            <custom:CustomLabel Text="-31st Dec 2019" Style="{StaticResource ValueLabelBlack}" />
                                        </StackLayout>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="VAT Account Number" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="123456789" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                        <!--Taxpayer Details Ends-->
                        <!--VAT on Sales Start-->
                        <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout>
                                <StackLayout Orientation="Horizontal" Padding="10">
                                    <Frame Style="{StaticResource circleFrame}">
                                        <Image Source="ic_vat_bill">

                                        </Image>
                                    </Frame>
                                    <custom:CustomLabel Text="VAT on Sales" Style="{StaticResource SectionTitleBlack}" VerticalTextAlignment="Center"/>
                                    <custom:CustomLabel Text="Edit" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" VerticalTextAlignment="Center" TextColor="{StaticResource GreenLabelTextColor}"/>
                                </StackLayout>

                                <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                <StackLayout Padding="10" Spacing="10">
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Amount" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Adjustments" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="VAT on Sales" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>
                        <!--VAT On Sales End-->

                        <!--VAT on Purchases Start-->
                        <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout>
                                <StackLayout Orientation="Horizontal" Padding="10">
                                    <Frame Style="{StaticResource circleFrame}">
                                        <Image Source="ic_vat_bill">

                                        </Image>
                                    </Frame>
                                    <custom:CustomLabel Text="VAT on Purchases" Style="{StaticResource SectionTitleBlack}" VerticalTextAlignment="Center"/>
                                    <custom:CustomLabel Text="Edit" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand" VerticalTextAlignment="Center" TextColor="{StaticResource GreenLabelTextColor}"/>
                                </StackLayout>

                                <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                <StackLayout Padding="10" Spacing="10">
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Amount" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Adjustments" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="VAT on Purchases" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>
                        <!--VAT On Purchases End-->
                        <!--VAT on Total VAT Start-->
                        <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout>
                                <StackLayout Orientation="Horizontal" Padding="10">
                                    <Frame Style="{StaticResource circleFrame}">
                                        <Image Source="ic_vat_amount">

                                        </Image>
                                    </Frame>
                                    <custom:CustomLabel Text="Total VAT" Style="{StaticResource SectionTitleBlack}" VerticalTextAlignment="Center"/>
                                </StackLayout>

                                <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                <StackLayout Padding="10" Spacing="10">
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="VAT Due" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="From Previous Periods" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="Corrections" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"/>
                                    </StackLayout>
                                </StackLayout>
                                <StackLayout BackgroundColor="LightBlue" Orientation="Horizontal" Padding="10">
                                    <custom:CustomLabel Text="Net VAT" Style="{StaticResource ValueLabelBlack}"/>
                                    <custom:CustomLabel Text="500 SAR" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"/>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>
                        <!--VAT On Total End-->

                        <custom:CustomLabel Text="{x:Static custom2:AppResources.ZVatTermsAndConditions}" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"  Style="{StaticResource BodyLabelBlack}" />

                        <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="1."/>
                                    <Span Text="{x:Static custom2:AppResources.ZVatTandCone}"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="2."/>
                                    <Span Text="{x:Static custom2:AppResources.ZVatTandCtwo}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="3."/>
                                    <Span Text="{x:Static custom2:AppResources.ZVatTandCthree}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="4."/>
                                    <Span Text="{x:Static custom2:AppResources.ZVatTandCfour}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <StackLayout Orientation="Horizontal">
                            <CheckBox VerticalOptions="CenterAndExpand" IsChecked="{Binding IsInstrunctionChecked}">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox"  Value="false">
                                        <Setter Property="Color" Value="#ff0000" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                            <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static custom2:AppResources.ZVatCertifyInformation}"  />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>


                <StackLayout Grid.Row="0" BackgroundColor="White" Margin="0,-17,0,0" Spacing="0">

                    <custom:CustomLabel Text="Summary"  Style="{StaticResource SectionTitleBlack}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                    <custom:CustomLabel Text="Review the below information"  BackgroundColor="White" Style="{StaticResource CaptionLabelGrey}" />
                    <BoxView Style="{StaticResource lineSeperator}" Margin="0,15,0,30"/>
                </StackLayout>
            </Grid>





            <StackLayout BackgroundColor="White" Grid.Row="1" Margin="0,0,0,0"  VerticalOptions="FillAndExpand" Padding="0,0,0,10">

                <buttons:SfButton x:Name="btnprimary"  VerticalOptions="CenterAndExpand" Margin="10,8,10,0"  Text="{Binding ContinueText}" Command="{Binding onCountinueClicked}" Style="{StaticResource PrimaryButtonStyle}"/>

                <buttons:SfButton Text="{Binding CreditDetailsText}" TextColor="{StaticResource NewDullOrangeColor}" IsVisible="{Binding isBtnVisible}" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="Transparent" Margin="0,-10,0,0"/>
            </StackLayout>

        </Grid>
    </ContentPage.Content>
</ContentPage>