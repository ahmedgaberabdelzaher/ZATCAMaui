<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:models="clr-namespace:EGAZT.Models"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
             FlowDirection="RightToLeft"
             x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.GAZTNewDesignVATReturnUpdatedUIPageView"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="BoxView" x:Key="boxIndicator">
                <Setter Property="BackgroundColor" Value="{StaticResource NeutralLightGrey}"/>
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>

            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}"/>
                <Setter Property="CornerRadius" Value="25"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="HeightRequest" Value="25"/>
                <Setter Property="WidthRequest" Value="25"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>

            <Style TargetType="Entry" x:Key="EntryHeight48">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="FontFamily" Value="{StaticResource SSTArRoman}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="PlaceholderColor" Value="{StaticResource NeutralGreay}" />
            </Style>

            <converters:VATReturnUpdatedUITabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid >
                

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <yummy:PancakeView Grid.Row="1" BackgroundColor="White" CornerRadius="15,15,0,0" Padding="0,0,0,0">
                    <Grid RowSpacing="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" RowSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>

                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>

                        <StackLayout Orientation="Horizontal" Padding="15,0,15,0" BackgroundColor="White" Grid.Row="0" VerticalOptions="CenterAndExpand"  >

                            <custom:CustomLabel Padding="0,15,0,0" Margin="0" HorizontalOptions="Start" Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackButtonClicked"  />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>


                            <commonView:PageIndicatorView DotSize="12" Margin="0,15,0,0" Grid.Row="0" Grid.Column="0" MaxNum="{TemplateBinding BindingContext.MaxIndex}" MinNum="{TemplateBinding BindingContext.CurrentIndex}" Completed="{TemplateBinding BindingContext.MarkComplete}" VerticalOptions="CenterAndExpand"/>

                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>
                <Grid Padding="15,10,15,10" Grid.Row="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>

                    <custom:CustomLabel Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.VATDeclaration}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"  />

                    <StackLayout Grid.Row="0" Grid.Column="0">
               
                        <custom:CustomLabel Margin="0" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}">
                            <custom:CustomLabel.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}"  />
                            </custom:CustomLabel.GestureRecognizers>
                        </custom:CustomLabel>
                    </StackLayout>



                    <StackLayout  Grid.Row="0" Grid.Column="2">
                        <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}"/>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                  
                </Grid>

                <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" IsVisible="{TemplateBinding BindingContext.IsNewLoading}">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForReturn" EnableAnimation="True" AnimationType="SingleCircle" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" IsBusy="True" ViewBoxWidth = "70" TitlePlacement="Bottom" ViewBoxHeight="70" TextColor="#D99A29"/>
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>

        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid Padding="0,0,0,0" RowSpacing="0" x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.Instrunction}}"  x:Name="InstrunctionSection">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackLayout  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1" Margin="15,16,15,0">
                    <ScrollView  VerticalScrollBarVisibility="Never" VerticalOptions="FillAndExpand" BackgroundColor="White">
                        <StackLayout BackgroundColor="White" VerticalOptions="StartAndExpand">
                            <Label Text="{x:Static custom2:AppResources.ZVatReadInstructions}" BackgroundColor="White" Style="{StaticResource CaptionLabelGrey}"/>

                            <custom:CustomLabel HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="1."/>
                                        <Span Text="{x:Static custom2:AppResources.ZZPleasefilltherequestedinformationforeachstep}"  />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="2."/>
                                        <Span Text="{x:Static custom2:AppResources.ZVatSubmittedInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel  VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="3."/>
                                        <Span  Text="{x:Static custom2:AppResources.ZVatDateInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel  Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="4."/>
                                        <Span Text="{x:Static custom2:AppResources.ZVatFaqSectionInstructions}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <custom:CustomLabel  Text="{x:Static custom2:AppResources.ZVatClickFaqInstructions}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource CaptionLabelGrey}" TextColor="{StaticResource NewDullOrangeColor}">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClickedFAQ"/>
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>

                            <StackLayout Orientation="Horizontal">

                                <custom1:CheckboxCustom  x:Name="chkDeclaration"  VerticalOptions="CenterAndExpand" IsEnabled="{Binding IsDeclarationCheckEnabled}" IsChecked="{Binding IsDeclarationCheckedForInstruction}">
                                  
                                </custom1:CheckboxCustom >

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="CenterAndExpand">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static custom2:AppResources.ZVatDeclarationInstructions}"  />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                            </StackLayout>
                             <StackLayout BackgroundColor="White" Grid.Row="1"  VerticalOptions="EndAndExpand" HorizontalOptions="Center"  Padding="0,0,0,40">

                                <buttons:SfButton  VerticalOptions="CenterAndExpand" Margin="15,8,15,0"  Clicked="OnAmendButtonClicked" Text="{x:Static ResourceManager:AppResources.ZZAmend}" IsVisible="{Binding IsVisibleAmendButton}"  Style="{StaticResource PrimaryButtonStyle}"/>

                                <buttons:SfButton  VerticalOptions="CenterAndExpand" Margin="15,8,15,0"  Clicked="OnContinueButtonClicked" Text="{Binding ContinueText}" IsVisible="{Binding IsMainButtonVisible}"  Style="{StaticResource PrimaryButtonStyle}"/>

                                <buttons:SfButton  Text="{Binding RefundButtonText}" PressedBackgroundColor="White" IsEnabled="{Binding IsRefundButtonEnabled}" Command="{Binding onRefundClicked}" TextColor="{StaticResource NewDullOrangeColor}" IsVisible="{Binding IsRefundButtonVisible}" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="Transparent" Margin="15,-10,15,0"/>

                                <buttons:SfButton  Text="{Binding CreditDetailsText}" PressedBackgroundColor="White" IsEnabled="{Binding IsGetSadadNumberEnabled}" Command="{Binding onSecondButtonClicked}" TextColor="{StaticResource NewDullOrangeColor}" IsVisible="{Binding isBtnVisible}" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="Transparent" Margin="15,-10,15,0"/>

                                <buttons:SfButton  Text="{x:Static ResourceManager:AppResources.ZZZZCarriedCreditDetails}" PressedBackgroundColor="White"  Command="{Binding onCreditForwardClicked}" TextColor="{StaticResource NewDullOrangeColor}"  Style="{StaticResource PrimaryButtonStyle}" IsVisible="{Binding IsCreditForwardBtnVisible}" BackgroundColor="Transparent" Margin="15,-10,15,0"/>

                            </StackLayout>
                          
                        </StackLayout>

                    </ScrollView>

                </StackLayout>


                <StackLayout Grid.Row="0" BackgroundColor="White" Margin="0,-17,0,0" Spacing="0">
                    <StackLayout Margin="15,0,15,0">
                        <custom:CustomLabel Text="{x:Static custom2:AppResources.ZInstructions}"  Style="{StaticResource PageTitleBlack}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />

                        <BoxView Style="{StaticResource lineSeperator}"/>
                    </StackLayout>
                </StackLayout>
            </Grid>

        
            <Grid Grid.Row="0" Margin="0,-15,0,0" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.VATReturns}}" x:Name="VATReturnsSection" BackgroundColor="White" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollView Grid.Row="1">
                    <StackLayout  BackgroundColor="White">
                        <StackLayout Margin="15,0,15,0">
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZDoyouhavesalesorpurchasessubjectto5VAT}" Style="{StaticResource CaptionLabelBlack}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" IsEnabled="{Binding IsYesBoxEnabled}">
                                    <Image x:Name="YesImg" Source="{Binding YesBackgroundImage}" />
                                    <custom:CustomLabel x:Name="YesLbl"  Text="{x:Static ResourceManager:AppResources.ZZZYesText}" TextColor="{Binding YesLabelColor}" Style="{StaticResource ValueLabelBlack}" VerticalOptions="Center" Margin="10,0,0,0"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnYesTapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                                <Grid Grid.Column="1" IsEnabled="{Binding IsNoBoxEnabled}">
                                    <Image x:Name="NoImg"  Source="{Binding NoBackgroundImage}"  />
                                    <custom:CustomLabel x:Name="NoLbl" Text="{x:Static ResourceManager:AppResources.ZZZNoText}" Style="{StaticResource ValueLabelBlack}" TextColor="{Binding NoLabelColor}" VerticalOptions="Center" Margin="10,0,0,0"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNoTapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Grid>
                            <!--VAT On Sales Starts-->
                          
                            <!--Total VAT Ends-->
                        </StackLayout>
                         <StackLayout BackgroundColor="White" Grid.Row="1"  VerticalOptions="End" HorizontalOptions="Center"  Padding="0,0,0,40">

                            <buttons:SfButton  VerticalOptions="CenterAndExpand" Margin="15,8,15,0"  Clicked="OnAmendButtonClicked" Text="{x:Static ResourceManager:AppResources.ZZAmend}" IsVisible="{Binding IsVisibleAmendButton}"  Style="{StaticResource PrimaryButtonStyle}"/>

                            <buttons:SfButton  VerticalOptions="CenterAndExpand" Margin="15,8,15,0"  Clicked="OnContinueButtonClicked" Text="{Binding ContinueText}" IsVisible="{Binding IsMainButtonVisible}"  Style="{StaticResource PrimaryButtonStyle}"/>

                            <buttons:SfButton  Text="{Binding RefundButtonText}" PressedBackgroundColor="White" IsEnabled="{Binding IsRefundButtonEnabled}" Command="{Binding onRefundClicked}" TextColor="{StaticResource NewDullOrangeColor}" IsVisible="{Binding IsRefundButtonVisible}" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="Transparent" Margin="15,-10,15,0"/>

                            <buttons:SfButton  Text="{Binding CreditDetailsText}" PressedBackgroundColor="White" IsEnabled="{Binding IsGetSadadNumberEnabled}" Command="{Binding onSecondButtonClicked}" TextColor="{StaticResource NewDullOrangeColor}" IsVisible="{Binding isBtnVisible}" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="Transparent" Margin="15,-10,15,0"/>

                            <buttons:SfButton  Text="{x:Static ResourceManager:AppResources.ZZZZCarriedCreditDetails}" PressedBackgroundColor="White"  Command="{Binding onCreditForwardClicked}" TextColor="{StaticResource NewDullOrangeColor}"  Style="{StaticResource PrimaryButtonStyle}" IsVisible="{Binding IsCreditForwardBtnVisible}" BackgroundColor="Transparent" Margin="15,-10,15,0"/>

                        </StackLayout>

                    </StackLayout>
                </ScrollView>
                <StackLayout Grid.Row="0" BackgroundColor="White" Margin="0,0,0,8">
                    <StackLayout Margin="15,0,15,0">
                        <custom:CustomLabel Text="{x:Static custom2:AppResources.ZZVATReturnForm}"  Style="{StaticResource PageTitleBlack}" />
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" Margin="0,-8,0,0"  BackgroundColor="White" Style="{StaticResource CaptionLabelGrey}" />
                        <BoxView Style="{StaticResource lineSeperator}"/>
                    </StackLayout>
                </StackLayout>
                <!--View On Hold-->





                <!--Views On Hold-->
            </Grid>


            <Grid Grid.Row="0" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:VATReturnUpdatedUITabEnum.Sales}}" RowSpacing="0"  x:Name="SalesSection">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackLayout  Grid.Row="1" BackgroundColor="White">
                    <ScrollView  VerticalScrollBarVisibility="Never" BackgroundColor="White">
                        <StackLayout BackgroundColor="White">
                            <StackLayout Margin="15,0,15,0" >
                                <Frame Style="{StaticResource InputTableFrameStyle}" Margin="0,10,0,0">
                                    <Grid  Style="{StaticResource InputTableGridStyle}"  BindingContext="{Binding ResponseVATDeclarationD}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                           
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50*"/>
                                            <ColumnDefinition Width="50*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsPrevReturn}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80*"/>
                                                <ColumnDefinition Width="20*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatStandardRatedSales}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsPrevReturn}" Style="{StaticResource ValueLabelBlack}" Margin="10,0,10,0" Grid.Row="0" Grid.Column="0"></custom:CustomLabel>
                                            <Image Source="ic_vat_info" Style="{StaticResource ImageStyleForInputTable}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsPrevReturn}" Grid.Row="0" Grid.Column="1">

                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnNewStandardRatedSalesAmountClicked"/>
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>

                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatAmountWithSAR}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsPrevReturn}" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,-8" Grid.Row="1" Grid.Column="0"></custom:CustomLabel>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatAdjustmentWithSAR}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsPrevReturn}" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,-8" Grid.Row="1" Grid.Column="1"></custom:CustomLabel>


                                        <inputLayout:SfTextInputLayout  HorizontalOptions="FillAndExpand" Margin="10,0,10,0"
                                                            LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" x:Name="EntryVatAmountFrame" UnfocusedColor="#B1B1B1" ErrorColor="#B00020" HasError="False"  IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsPrevReturn}" Grid.Row="2" Grid.Column="0"  Style="{StaticResource TextInputLayout}">
                                            <custom:GAZTBorderlessEntry   x:Name="EntryVatAmount" PropertyChanged="EntryVatAmount_PropertyChanged"   Focused="EntryVatAmountFocused"  Unfocused="EntryVatAmount_Unfocused" IsReadOnly="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsControlEnabledForEntry}" Keyboard="Numeric" TextChanged="ClickGestureRecognizer_ClickedForVatAmount"   Style="{StaticResource DefaultEntry}" Text="{Binding StdsalesAmt}" Margin="10,0,10,0">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom2:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="19" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="12"/>
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                            <inputLayout:SfTextInputLayout.Triggers>
                                                <DataTrigger TargetType="inputLayout:SfTextInputLayout" Binding="{Binding Source={x:Reference EntryVatAmount}, Path=Text.Length}" Value="0">
                                                    <Setter Property="HasError" Value="True" />
                                                </DataTrigger>
                                            </inputLayout:SfTextInputLayout.Triggers>
                                        </inputLayout:SfTextInputLayout>
                                        <inputLayout:SfTextInputLayout HorizontalOptions="FillAndExpand" Margin="10,0,10,0"
                                                            LeadingViewPosition="Inside"  ContainerType="Outlined" OutlineCornerRadius="8"  x:Name="EntryVatAdjustmentWithSARFrame"  InputViewPadding="16,0,16,0" UnfocusedColor="#B1B1B1" ErrorColor="#B00020" HasError="False" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsPrevReturn}"  Grid.Row="2" Grid.Column="1"  Style="{StaticResource TextInputLayout}" Padding="0">
                                            <custom:GAZTBorderlessEntry   x:Name="EntryVatAdjustmentWithSAR" PropertyChanged="EntryVatAdjustmentWithSAR_PropertyChanged"  Focused="EntryVatAdjustmentFocused" Unfocused="EntryVatAdjustmentWithSAR_Unfocused" Keyboard="Numeric" IsReadOnly="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsControlEnabledForEntry}" TextChanged="ClickGestureRecognizer_ClickedForVatAmount"   Text="{Binding StdsalesAdj}"   Style="{StaticResource DefaultEntry}" Margin="10,0,10,0">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom2:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="19" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="12"/>
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>

                                            <inputLayout:SfTextInputLayout.Triggers>
                                                <DataTrigger TargetType="inputLayout:SfTextInputLayout" Binding="{Binding Source={x:Reference EntryVatAdjustmentWithSAR}, Path=Text.Length}" Value="0">
                                                    <Setter Property="HasError" Value="True" />
                                                </DataTrigger>
                                            </inputLayout:SfTextInputLayout.Triggers>
                                        </inputLayout:SfTextInputLayout>
                                         
                                        <inputLayout:SfTextInputLayout HorizontalOptions="FillAndExpand" Margin="10,0,10,0"
                                                            LeadingViewPosition="Inside" UnfocusedColor="#B1B1B1" ContainerType="Outlined" OutlineCornerRadius="8"   IsVisible="False"   ErrorColor="#B00020" HasError="False"   Grid.Row="2" Grid.Column="1"  Style="{StaticResource TextInputLayout}" Padding="0">
                                            <custom:GAZTBorderlessEntry   x:Name="EntryStdsalesVat" Keyboard="Numeric" IsReadOnly="True" TextColor="#7D858D" Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.StdsalesVat , StringFormat='{0:D2}'}"  Style="{StaticResource InputTableEntryLayoutStyle}" Margin="10,0,10,0">

                                            </custom:GAZTBorderlessEntry>

                                            <inputLayout:SfTextInputLayout.Triggers>
                                                <DataTrigger TargetType="inputLayout:SfTextInputLayout" Binding="{Binding Source={x:Reference EntryVatAdjustmentWithSAR}, Path=Text.Length}" Value="0">
                                                    <Setter Property="HasError" Value="True" />
                                                </DataTrigger>
                                            </inputLayout:SfTextInputLayout.Triggers>
                                        </inputLayout:SfTextInputLayout>

                                 
                                        <Grid Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsFifteenPersenctVisible}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80*"/>
                                                <ColumnDefinition Width="20*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZVatStandardRatedSales15}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsFifteenPersenctVisible}" Style="{StaticResource ValueLabelBlack}" Margin="10,0,10,0" Grid.Row="0" Grid.Column="0" ></custom:CustomLabel>
                                            <Image Source="ic_vat_info" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsFifteenPersenctVisible}" Style="{StaticResource ImageStyleForInputTable}" Grid.Row="0" Grid.Column="1">
                                                <Image.GestureRecognizers>
