<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             mc:Ignorable="d"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False"
             x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.VATReturnSuccessfullPageView"
            >
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <!--<Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>-->
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0" Padding="15,5,15,0">
                <Image  Source="close" Style="{DynamicResource BackButtonArrow}" VerticalOptions="CenterAndExpand" HorizontalOptions="End">

                </Image>
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnBackButtonClicked}"/>
                </StackLayout.GestureRecognizers>
            </StackLayout>

            <ScrollView Grid.Row="1" Margin="0,8,0,0" VerticalOptions="Start" HorizontalOptions="CenterAndExpand">
            <StackLayout VerticalOptions="Start" HorizontalOptions="CenterAndExpand">

                <Image Source="Forget_ic_success"/>
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatReturn}" Margin="0,20,0,0" TextColor="White" Style="{StaticResource SectionTitleBlack}" HorizontalTextAlignment="Center" StyleId="OnBoardText"/>
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZVATReturnsubmitted}" IsVisible="{Binding IsCreditCarriedTextVisible}" TextColor="White"  HorizontalTextAlignment="Center" Style="{StaticResource CaptionLabelBlack}" StyleId="OnBoardText">
                    </custom:CustomLabel>
                    <custom:CustomLabel  TextColor="White" IsVisible="{Binding IsSadadNumberVisible}" HorizontalTextAlignment="Center" Style="{StaticResource CaptionLabelBlack}" StyleId="OnBoardText" >
                    <custom:CustomLabel.FormattedText>
                        <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZZZVatReturnSubmittedNew}" />
                            <Span Text="&#160;&#160;"/>
                                <Span Text="{Binding AmountPayable,Converter={StaticResource commaSeparatorConverter}}" TextColor="White" />
                            <Span Text="&#160;"/>
                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" TextColor="White" />
                        </FormattedString>
                    </custom:CustomLabel.FormattedText>
                </custom:CustomLabel>
                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.ZZZZRemembertocompletepayment}" IsVisible="{Binding IsSadadNumberVisible}" HorizontalTextAlignment="Center" TextColor="White" Style="{StaticResource CaptionLabelBlack}" StyleId="OnBoardText" Margin="0,8,0,0"/>

            </StackLayout>
            </ScrollView>

            <yummy:PancakeView Grid.Row="2" Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand" Padding="0,10,0,40">

                <Grid HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand" Padding="20,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0">
                        
                    <ScrollView  Orientation="Vertical">
                        <StackLayout Spacing="0">
                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Orientation="Horizontal"  Padding="15,5,15,5">

                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <custom:CustomLabel Text="{Binding ReturnReferenceNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>                                       

                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder >

                            <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Orientation="Horizontal"  Padding="15,5,15,5">

                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <custom:CustomLabel Text="{Binding TaxablePeriod}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder >

                            <!--<border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}" IsVisible="{Binding IsSadadNumberVisible}">
                                <StackLayout Orientation="Horizontal"  Padding="15,5,15,5" IsVisible="{Binding IsSadadNumberVisible}">

                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZSadadNumber}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <custom:CustomLabel Text="{Binding SadadNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                                        <Image Source="zakat_copy.png">
                                            
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopySadadNumberButtonClicked"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>-->
                          </StackLayout>
                    </ScrollView>
                    </StackLayout>
                    <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical" Spacing="4" BackgroundColor="White" Padding="0,2,0,0">
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZVatRefresh}" IsVisible="{Binding IsRefreshButtonVisible}" Margin="0,0,0,1" Clicked="OnVATRefreshButtonClicked" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}" IsVisible="{Binding IsSadadNumberVisible}" Margin="0,0,0,1" Clicked="OnVATPayNowClicked" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.DownloadAcknowlwdgement}" TextColor="{StaticResource NewDullOrangeColor}"  BackgroundColor="Transparent" IsVisible="{Binding IsAcknowledgementButtonVisible}" Margin="0,0,0,1" Command="{Binding OnAcknowlwdgementClicked}" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZDownloadForm}" TextColor="{StaticResource NewDullOrangeColor}" BackgroundColor="Transparent" IsVisible="{Binding IsButtonVisible}" Margin="0,0,0,-10" Command="{Binding OnDownloadFormClicked}" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>
                        <!--<buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}"  Margin="0,0,0,2" Clicked="GotodashboardClicked" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>-->
                        <!-- <buttons:SfButton Text="{x:Static ResourceManager:AppResources.NDReturns}"  Clicked="GotoreturnClicked" TextColor="{StaticResource NewDullOrangeColor}"  Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="Transparent" Margin="0,0,0,1"/> -->
                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

        </Grid>


        <!--<Grid Padding="15,0,15,0" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="20*"/>
            </Grid.ColumnDefinitions>

            --><!--<custom:CustomLabel Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />--><!--

            <StackLayout Grid.Row="0" Grid.Column="0">
                <Image  Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">

                </Image>
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnBackButtonClicked}"/>
                </StackLayout.GestureRecognizers>
            </StackLayout>-->

            <!--<StackLayout Grid.Row="0" Grid.Column="2" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}">
                <Image IsVisible="{Binding IsBackBtnVisible}" Source="{Binding RefreshIconImageSource}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">

                </Image>
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRefreshButtonClicked"/>
                </StackLayout.GestureRecognizers>
            </StackLayout>-->

        <!--</Grid>-->

        <!--<StackLayout Spacing="20">
            <StackLayout Margin="0,80,0,0" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                <Image Source="Forget_ic_success"/>
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatReturn}" Margin="0,20,0,0" TextColor="White" Style="{StaticResource SectionTitleBlack}" HorizontalTextAlignment="Center"/>
                <custom:CustomLabel  TextColor="White" IsVisible="{Binding IsSadadNumberVisible}" HorizontalTextAlignment="Center" Style="{StaticResource CaptionLabelBlack}">
                    <custom:CustomLabel.FormattedText>
                        <FormattedString>
                            <Span Text="Your VAT Return is submitted successfully and SADAD Bill generated" />
                            <Span Text="{Binding AmountPayable}" TextColor="White" />
                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" TextColor="White" />
                        </FormattedString>
                    </custom:CustomLabel.FormattedText>
                </custom:CustomLabel>
                <custom:CustomLabel Text="Please remember to complete the payment" IsVisible="{Binding IsSadadNumberVisible}" HorizontalTextAlignment="Center" TextColor="White" Style="{StaticResource CaptionLabelBlack}" Margin="0,20,0,0"/>
            </StackLayout>
            <yummy:PancakeView CornerRadius="15,15,0,0" VerticalOptions="EndAndExpand" Padding="20,20,20,10" HasShadow="False" BackgroundColor="White">
                <ScrollView VerticalScrollBarVisibility="Never">
                <StackLayout Spacing="0">
                    <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                        <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                    <custom:CustomLabel Text="{Binding ReturnReferenceNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                                <Image>
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                    </Image.Source>
                                </Image>

                            </StackLayout>
                        </StackLayout>
                    </border:SfBorder >

                    <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                        <StackLayout Orientation="Horizontal"  Padding="15,10,15,10">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                    <custom:CustomLabel Text="{Binding TaxablePeriod}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                            </StackLayout>
                        </StackLayout>
                    </border:SfBorder >

                        <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}" IsVisible="{Binding IsSadadNumberVisible}">
                            <StackLayout Orientation="Horizontal"  Padding="15,10,15,10" IsVisible="{Binding IsSadadNumberVisible}">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZSadadNumber}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                    <custom:CustomLabel Text="{Binding SadadNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                            </StackLayout>
                        </StackLayout>
                    </border:SfBorder>
                    --><!--<buttons:SfButton Text="View Bill" Style="{StaticResource PrimaryButtonStyle}" Clicked="SfButton_Clicked"/>--><!--
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZVatRefresh}" IsVisible="{Binding IsRefreshButtonVisible}" Margin="0,0,0,2" Clicked="OnVATRefreshButtonClicked" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.DownloadAcknowlwdgement}"  IsVisible="{Binding IsAcknowledgementButtonVisible}" Margin="0,0,0,2" Command="{Binding OnAcknowlwdgementClicked}" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZDownloadForm}" IsVisible="{Binding IsButtonVisible}" Margin="0,0,0,2" Command="{Binding OnDownloadFormClicked}" Style="{StaticResource PrimaryButtonStyle}"></buttons:SfButton>

                        --><!--<custom:CustomLabel Text="Go To Dashboard" TextColor="{StaticResource NewDullOrangeColor}" HorizontalTextAlignment="Center" Style="{StaticResource ValueLabelBlack}"/>--><!--
                </StackLayout>
                </ScrollView>
            </yummy:PancakeView>
        </StackLayout>-->
        <!--</Grid>-->
    </ContentPage.Content>
</ContentPage>