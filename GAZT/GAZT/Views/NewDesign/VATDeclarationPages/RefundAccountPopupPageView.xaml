<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
                 xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
                 xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
                 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
            xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
            xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
            xmlns:custom="clr-namespace:GAZT"
                 xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
            xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
            x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.RefundAccountPopupPageView">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView VerticalOptions="EndAndExpand" Style="{StaticResource CommonTopCurves}">
        <StackLayout>
            <custom:CustomLabel Text="Refund Account" Style="{StaticResource PageTitleBlack}"/>

            <Grid ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Column="0">
                    <custom:CustomLabel Text="Some thing" Style="{StaticResource CaptionLabelGrey}"/>
                    <Grid>
                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                        <control:BorderlessEntry      Style="{StaticResource DefaultEntry}" Placeholder="Text" VerticalTextAlignment="End"  HeightRequest="51" Keyboard="Numeric" MaxLength="4">

                        </control:BorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image Source="arrowDropdown.png"/>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>
                        <custom:CustomButton BackgroundColor="Transparent" Clicked="SfButton_Clicked"/>
                        <syncfusion:SfPicker x:Name="Picker1" HeaderHeight="55" HeaderText="Picker1" HeaderTextColor="Black"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                    </Grid>
                    
                </StackLayout>


                <StackLayout Grid.Column="1">
                    <custom:CustomLabel Text="Some thing" Style="{StaticResource CaptionLabelGrey}"/>
                    <Grid>
                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                        <control:BorderlessEntry      Style="{StaticResource DefaultEntry}" Placeholder="Text" VerticalTextAlignment="End"  HeightRequest="51" Keyboard="Numeric" MaxLength="4">

                        </control:BorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image Source="arrowDropdown.png"/>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>

                        <buttons:SfButton BackgroundColor="Transparent" Clicked="SfButton_Clicked1"/>

                        <syncfusion:SfPicker x:Name="Picker2" HeaderHeight="55" HeaderText="Picker2" HeaderTextColor="White" 
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>

                    </Grid>
                </StackLayout>
                
            </Grid>
            
            
            
            <border:SfBorder Margin="0,0,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                <StackLayout Orientation="Horizontal" Spacing="10" Padding="15,10,15,10">
                    <Image Source="ic_add_plus.png">

                    </Image>
                    <custom:CustomLabel Text="Add Account" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                </StackLayout>
                <border:SfBorder.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                </border:SfBorder.GestureRecognizers>
            </border:SfBorder>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <border:SfBorder Grid.Column="0" Style="{StaticResource GreyBorderFrameWithShadow}" Padding="10">
<!--                    <Image Source="re_Tile_Background_White" HeightRequest="136" WidthRequest="171"/>-->
                    <StackLayout Margin="16,16,8,16" VerticalOptions="EndAndExpand">
                        <Image Source="positive.png" HorizontalOptions="EndAndExpand"/>
                        <custom:CustomLabel Text="...1234" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Start"/>
                        <custom:CustomLabel Margin="0,-10,0,0" Text="Al Rajhi Bank" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                    </StackLayout>
                </border:SfBorder>
                <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" BackgroundColor="{StaticResource Primary}" Grid.Column="1">
<!--                        <Image Source="vat_tile_IbanCard_background"/>-->
                    <StackLayout Margin="16,16,8,16" VerticalOptions="EndAndExpand">
                            <Image Source="negative.png" HorizontalOptions="EndAndExpand"/>
                            <custom:CustomLabel Text="...1235" Style="{StaticResource CaptionLabelWhite}" HorizontalOptions="Start"/>
                            <custom:CustomLabel Margin="0,-10,0,0" Text="Al Rajhi Bank" Style="{StaticResource ValueLabelWhiteMedium}" HorizontalOptions="Start"/>
                        </StackLayout>
                    </border:SfBorder>
            </Grid>

            <buttons:SfButton Text="Confirm Refund" Margin="0,8,0,0" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>