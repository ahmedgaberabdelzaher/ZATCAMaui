<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
                 xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
                 xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
                 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
            xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
            xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
            xmlns:custom="clr-namespace:GAZT"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
            xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
                 x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.RefundAccountPopupPageView">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView VerticalOptions="EndAndExpand"  Style="{StaticResource CommonTopCurves}" BackgroundColor="White">
        <StackLayout BackgroundColor="White">
         

            <Grid  BackgroundColor="White" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BackgroundColor="White">
                    <custom:CustomLabel Text="ID Type"  Style="{StaticResource PageTitleBlack}"/>
                </StackLayout>

                <!--<StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="White">
                    
                </StackLayout>-->
                <StackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="White" >
                    <custom:CustomLabel Text="IBAN Type" Style="{StaticResource CaptionLabelGrey}" BackgroundColor="White"/>
                    <Grid>
                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" BackgroundColor="White">
                            <control:BorderlessEntry   Text="{Binding TxtSelectedIBANType}"   Style="{StaticResource DefaultEntry}" Placeholder="Text" VerticalTextAlignment="End"  HeightRequest="51" Keyboard="Numeric" >

                        </control:BorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image Source="arrowDropdown.png"/>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>
                        <custom:CustomButton BackgroundColor="Transparent" Clicked="SfButton_Clicked"/>
                        <syncfusion:SfPicker x:Name="IDTypeDropdown"  HeaderHeight="55" HeaderText="Picker1" HeaderTextColor="Black"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="Text"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" ItemsSource="{Binding IBANTypesList}"  SelectionChanged="IDType_SelectionChanged"
                                              OkButtonClicked="IDTypeDropdown_OkButtonClicked"
                                                                     CancelButtonClicked="IDTypeDropdown_CancelButtonClicked"
                                             SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                    </Grid>
                    
                </StackLayout>


                <StackLayout Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
                    <custom:CustomLabel Text="ID Number" Style="{StaticResource CaptionLabelGrey}" BackgroundColor="White"/>
                    <Grid>
                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" BackgroundColor="White">
                            <control:BorderlessEntry   Text="{Binding TxtSelectedIBANIDNumber}"  BackgroundColor="White"  Style="{StaticResource DefaultEntry}" Placeholder="Text" VerticalTextAlignment="End"  HeightRequest="51" >

                        </control:BorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image Source="arrowDropdown.png"/>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>

                        <buttons:SfButton BackgroundColor="Transparent" Clicked="SfButton_Clicked1"/>

                        <syncfusion:SfPicker x:Name="IDNumberDropdown" HeaderHeight="55" HeaderText="Picker2" HeaderTextColor="White" 
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="Idnumber"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectionChanged="IDNumber_SelectionChanged"  OkButtonClicked="IDNumberDropdown_OkButtonClicked"
                                                                     CancelButtonClicked="IDNumberDropdown_CancelButtonClicked"
                                             ItemsSource="{Binding IBANIDNumberList}" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" >
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>

                    </Grid>
                </StackLayout>

                <StackLayout Grid.Row="3" Grid.Column="0" IsVisible="{Binding IsNewAccountButtonVisible}" Grid.ColumnSpan="2" BackgroundColor="White">
                <border:SfBorder Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}" >
                    <StackLayout Orientation="Horizontal" Spacing="10" Padding="15,10,15,10">
                        <Image Source="ic_add_plus.png">

                        </Image>
                        <custom:CustomLabel Text="{Binding NewAccountText}" Style="{StaticResource ValueLabelPrimary}" HorizontalOptions="Start"/>
                    </StackLayout>
                    <border:SfBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                    </border:SfBorder.GestureRecognizers>
                </border:SfBorder>
                </StackLayout>

                <StackLayout Grid.Row="4" Spacing="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="White">
                <CollectionView  HeightRequest="100"     SelectionChanged="OnPageSelectedForIban"   SelectedItem="{Binding SelectedIban}" SelectionMode="Single"  ItemsSource="{Binding IBANList}"   x:Name="Ibanset"  ItemsLayout="HorizontalList" Margin="0"   BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>



                            <Grid Padding="5,0,5,0" BackgroundColor="White">
                                <cards:SfCardView  HasShadow="True"   ShadowColor="#5d6770" 
                                                          BackgroundColor="DarkGreen" CornerRadius="3" HorizontalOptions="FillAndExpand">
                                    <Grid>
                                        <Image Margin="0" Source="vat_tile_IbanCard_background.png" Aspect="AspectFill"  Grid.Row="0">
                                        </Image>
                                        <Grid  Padding="10" Grid.Row="0" VerticalOptions="End">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <StackLayout Grid.Row="1" Spacing="0">

                                                <Label Text="{Binding Iban}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"  TextColor="White"/>
                                                <Label Text="{x:Static ResourceManager:AppResources.VATRInmaBank}"  FontFamily="{StaticResource GAZT_FONT_MEDIUM}"  TextColor="White"/>
                                            </StackLayout>
                                        </Grid>
                                    </Grid>
                                </cards:SfCardView>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </StackLayout>
                <StackLayout Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="White">
                <buttons:SfButton Text="Confirm Refund" Clicked="Confirm_RefundClicked"  Margin="0,8,0,0" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackLayout>
            </Grid>
            
            
            
           

           

            <!--<Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <border:SfBorder Grid.Column="0" Style="{StaticResource GreyBorderFrameWithShadow}" Padding="10">
--><!--                    <Image Source="re_Tile_Background_White" HeightRequest="136" WidthRequest="171"/>--><!--
                    <StackLayout Margin="16,16,8,16" VerticalOptions="EndAndExpand">
                        <Image Source="positive.png" HorizontalOptions="EndAndExpand"/>
                        <custom:CustomLabel Text="...1234" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="Start"/>
                        <custom:CustomLabel Margin="0,-10,0,0" Text="Al Rajhi Bank" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                    </StackLayout>
                </border:SfBorder>
                <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" BackgroundColor="{StaticResource Primary}" Grid.Column="1">
--><!--                        <Image Source="vat_tile_IbanCard_background"/>--><!--
                    <StackLayout Margin="16,16,8,16" VerticalOptions="EndAndExpand">
                            <Image Source="negative.png" HorizontalOptions="EndAndExpand"/>
                            <custom:CustomLabel Text="...1235" Style="{StaticResource CaptionLabelWhite}" HorizontalOptions="Start"/>
                            <custom:CustomLabel Margin="0,-10,0,0" Text="Al Rajhi Bank" Style="{StaticResource ValueLabelWhiteMedium}" HorizontalOptions="Start"/>
                        </StackLayout>
                    </border:SfBorder>
            </Grid>-->

            
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>