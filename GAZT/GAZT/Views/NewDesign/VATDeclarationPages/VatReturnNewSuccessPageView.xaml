<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.VatReturnNewSuccessPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <!--<Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!--<StackLayout Grid.Row="0" Padding="15,5,15,0">
                <Image  Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start">

                </Image>
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OnBackButtonClicked}"/>
                </StackLayout.GestureRecognizers>
            </StackLayout>-->

            <ScrollView
                Grid.Row="0"
                Margin="0,8,0,0"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="Center">
                <StackLayout HorizontalOptions="CenterAndExpand" VerticalOptions="Start">

                    <Image Source="Forget_ic_success" />
                    <custom:CustomLabel
                        Margin="0,20,0,0"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleBlack}"
                        StyleId="OnBoardText"
                        Text="{x:Static ResourceManager:AppResources.ZVatReturn}"
                        TextColor="White" />

                    <Label
                        Margin="10,-10,10,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyLabelBlack}"
                        Text="{x:Static ResourceManager:AppResources.NDVAtReturnSubmittedSuccessMessage}"
                        TextColor="White"
                        VerticalOptions="CenterAndExpand" />

                </StackLayout>
            </ScrollView>

            <yummy:PancakeView
                Grid.Row="1"
                Padding="0,10,0,40"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="EndAndExpand">

                <Grid
                    Padding="20,0,20,0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0">

                        <ScrollView Orientation="Vertical">
                            <StackLayout Spacing="0">
                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,5,15,5" Orientation="Horizontal">

                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <custom:CustomLabel
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding ReferenceNumber}" />


                                        </StackLayout>
                                        <Image Source="zakat_copy.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopyReferenceNumberButtonClicked" />
                                            </Image.GestureRecognizers>

                                        </Image>
                                    </StackLayout>
                                </border:SfBorder>

                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="15,5,15,5" Orientation="Horizontal">

                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <custom:CustomLabel
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TaxablePeriod}" />
                                        </StackLayout>
                                    </StackLayout>
                                </border:SfBorder>


                            </StackLayout>
                        </ScrollView>
                    </StackLayout>
                    <StackLayout
                        Grid.Row="1"
                        Padding="0,2,0,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        Orientation="Vertical"
                        Spacing="4"
                        VerticalOptions="FillAndExpand">
                        <buttons:SfButton
                            Margin="0,0,0,2"
                            Clicked="GotodashboardClicked"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}" />

                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

        </Grid>
    </ContentPage.Content>
</ContentPage>