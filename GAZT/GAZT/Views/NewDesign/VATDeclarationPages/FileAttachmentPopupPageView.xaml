<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.FileAttachmentPopupPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    mc:Ignorable="d">
    <yummy:PancakeView
        BackgroundColor="White"
        CornerRadius="22,22,0,0"
        VerticalOptions="End">
        <Grid>
            <StackLayout Margin="10,0,10,0" Padding="0,0,0,0">

                <!--<Label Margin="10,0,10,0" HorizontalOptions="End" VerticalOptions="Center" Style="{StaticResource IconLabelStyle}" Text="{StaticResource Close}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoButtonClick}"/>
                </Label.GestureRecognizers>
            </Label>-->
                <Image Margin="15,15,15,1" HorizontalOptions="EndAndExpand">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="UserIconFont"
                            Glyph="{x:Static FontImage:IconFonts.Close}"
                            Size="25"
                            Color="{StaticResource SecondaryNew}" />
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClosedTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <Grid HorizontalOptions="CenterAndExpand" IsVisible="{Binding IsImpoterAndExporter}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*" />
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="35*" />
                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                        Text="{x:Static custom2:AppResources.VATRUploadingDocumentsFor}"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="EndAndExpand"
                        HorizontalTextAlignment="End"
                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                        Text="{x:Static custom2:AppResources.FAPImporter}"
                        VerticalOptions="Center" />

                    <Switch
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalOptions="CenterAndExpand"
                        IsToggled="{Binding IsSwitchToggled}"
                        VerticalOptions="CenterAndExpand" />

                    <custom:CustomButton
                        x:Name="btnForNewChange"
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        FontSize="13"
                        HeightRequest="15"
                        WidthRequest="15" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalOptions="StartAndExpand"
                        HorizontalTextAlignment="Start"
                        Style="{StaticResource GAZTSmallGreenLabelStyle}"
                        Text="{x:Static custom2:AppResources.FAPExporter}"
                        VerticalOptions="Center" />
                </Grid>

                <Label
                    Margin="0,0,0,0"
                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote1}"
                    TextColor="{StaticResource Primary}" />
                <Label
                    Margin="0,0,0,0"
                    FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote2}"
                    TextColor="{StaticResource Primary}" />
                <BoxView Margin="0,0,0,10" Style="{StaticResource lineSeperator}" />

                <ListView
                    x:Name="List"
                    HasUnevenRows="True"
                    HeightRequest="300"
                    HorizontalOptions="FillAndExpand"
                    ItemsSource="{Binding AttachmentList}"
                    SeparatorVisibility="None"
                    VerticalOptions="FillAndExpand">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ContentView>
                                    <cards1:SfCardView
                                        Margin="10"
                                        BackgroundColor="White"
                                        BorderColor="{StaticResource EntryTextColor}"
                                        BorderWidth=".05"
                                        CornerRadius="8"
                                        HasShadow="False"
                                        IndicatorColor="{StaticResource Primary}"
                                        IndicatorPosition="Left"
                                        IndicatorThickness="5"
                                        Opacity=".9"
                                        ShadowColor="{StaticResource EntryTextColor}">
                                        <StackLayout
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal"
                                            VerticalOptions="CenterAndExpand">
                                            <Grid
                                                BackgroundColor="White"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="2"
                                                Style="{DynamicResource GridStyle}"
                                                VerticalOptions="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70*" />
                                                    <ColumnDefinition Width="15*" />
                                                    <ColumnDefinition Width="15*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="30" />
                                                </Grid.RowDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    LineBreakMode="TailTruncation"
                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                    Text="{Binding Filename}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <!--<Image Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>-->
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="2"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Source="ic_delete.png"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="3,0,3,-5"
                                                    FlowDirection="LeftToRight"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MiniGrayLabelStyle}"
                                                    Text="{Binding Erfdt}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </Grid>
                                        </StackLayout>
                                    </cards1:SfCardView>
                                </ContentView>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <buttons:SfButton
                    x:Name="btnAddAttachment"
                    Margin="0,0,0,20"
                    BackgroundColor="{StaticResource Secondary}"
                    BorderWidth="0"
                    Command="{Binding OnAttachmentClick}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="{StaticResource SomarSemiBold}"
                    FontSize="15"
                    HeightRequest="56"
                    Text="{x:Static custom2:AppResources.FAPAddAttachment}"
                    TextColor="{DynamicResource Gray-White}"
                    VerticalOptions="End" />
            </StackLayout>

            <!--<Grid Grid.Row="0"    Grid.Column="0"  IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70"

                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70"
                                       TextColor="{StaticResource Primary}"/>
                    </StackLayout>

                </StackLayout>
            </Grid>-->
        </Grid>

    </yummy:PancakeView>
</pages:PopupPage>