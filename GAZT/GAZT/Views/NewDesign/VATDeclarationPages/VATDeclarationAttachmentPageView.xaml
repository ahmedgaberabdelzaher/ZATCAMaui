<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.VATDeclarationAttachmentPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    Title="Attachments">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <yummy:PancakeView
        Grid.Row="0"
        Padding="0"
        HeightRequest="400"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <Grid>
            <StackLayout Grid.Row="0">
                <ScrollView>
                    <Grid Padding="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0" Spacing="0">
                            <!--<Image HorizontalOptions="End">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped"/>
                    </Image.GestureRecognizers>
                </Image>-->


                            <StackLayout Spacing="0">
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="CenterAndExpand"
                                    Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachments}"
                                    VerticalOptions="Center" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachmentSizeNotfication}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachmentTypeNotfication}"
                                    VerticalOptions="EndAndExpand" />
                                <custom:CustomLabel
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="0"
                                    FontFamily="{StaticResource SomarBold}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachmentMaxSizeNotfication}"
                                    VerticalOptions="CenterAndExpand" />
                                <!--<Frame Grid.Row="4" IsVisible="{Binding AttachmentSizeVisibility}" CornerRadius="8" Margin="20,0,20,0" Style="{StaticResource GAZTFrameStyleForEntry}"  Grid.Column="0" Grid.ColumnSpan="2">
                        </Frame>-->
                                <!--<custom:CustomLabel  IsVisible="{Binding AttachmentSizeVisibility}" FontFamily="{StaticResource SomarBold}"   Grid.Row="4" Grid.Column="0" Padding="0" VerticalOptions="CenterAndExpand" Grid.ColumnSpan="2" Margin="10,0,10,0"   Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" HorizontalOptions="Start" HorizontalTextAlignment="Start">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding TotalAttachmentSize}"  />
                                    <Span Text="     "/>
                                    <Span Text="{x:Static ResourceManager:AppResources.OfText}"/>
                                    <Span Text="     "/>
                                    <Span Text="300 MB"/>
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>-->
                                <custom:CustomLabel
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource GAZTSmallGreenLabelStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZVatAttachments}" />
                                <border:SfBorder
                                    Margin="0"
                                    BorderColor="{StaticResource DarkGrayTextColor}"
                                    BorderWidth="1"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{Binding AttachmentName}" />

                                        <Image HorizontalOptions="EndAndExpand" Rotation="90">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                    Size="25"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OnAttachmentClick}" />
                                        </StackLayout.GestureRecognizers>
                                    </StackLayout>
                                </border:SfBorder>

                                <StackLayout
                                    Padding="0,10,0,10"
                                    HeightRequest="300"
                                    Orientation="Horizontal">
                                    <ListView
                                        x:Name="List"
                                        BackgroundColor="White"
                                        HasUnevenRows="True"
                                        HorizontalOptions="FillAndExpand"
                                        ItemTapped="Attachmentlist_ItemTapped"
                                        ItemsSource="{Binding AttachmentList}"
                                        SeparatorVisibility="None"
                                        VerticalOptions="FillAndExpand"
                                        VerticalScrollBarVisibility="Never">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <ViewCell>
                                                    <StackLayout Padding="0,5,0,5" HorizontalOptions="FillAndExpand">

                                                        <border:SfBorder
                                                            Margin="0"
                                                            BorderColor="{StaticResource DarkGrayTextColor}"
                                                            BorderWidth="1"
                                                            Style="{StaticResource GreyBorderFrameWithShadow}">

                                                            <StackLayout Padding="0,10,0,10" Orientation="Horizontal">
                                                                <Image
                                                                    Margin="5"
                                                                    HeightRequest="25"
                                                                    Source="Generic_attachment_icon.png"
                                                                    WidthRequest="25" />

                                                                <Label
                                                                    HorizontalOptions="Start"
                                                                    LineBreakMode="TailTruncation"
                                                                    Style="{StaticResource ValueLabelBlack}"
                                                                    Text="{Binding Filename}" />

                                                                <Image Margin="5" HorizontalOptions="EndAndExpand">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                            Size="25"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                                    </Image.GestureRecognizers>
                                                                </Image>


                                                            </StackLayout>

                                                        </border:SfBorder>
                                                    </StackLayout>
                                                </ViewCell>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                </StackLayout>
                                <!--<custom:CustomLabel Margin="0,-5,0,0" Text="50MB max" Style="{StaticResource CaptionLabelGrey}"/>-->


                            </StackLayout>



                        </StackLayout>




                    </Grid>
                </ScrollView>
                <StackLayout Padding="10" BackgroundColor="White">
                    <!--<buttons:SfButton Text="{x:Static ResourceManager:AppResources.Save}" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnCloseTapped" />-->
                    <buttons:SfButton
                        Clicked="OnCloseTapped"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZDone}" />

                </StackLayout>
            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="-20"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Primary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>

        </Grid>

    </yummy:PancakeView>


</pages:PopupPage>
