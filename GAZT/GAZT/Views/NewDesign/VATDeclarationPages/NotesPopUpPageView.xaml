<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.VATDeclarationPages.NotesPopUpPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    mc:Ignorable="d">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView Style="{StaticResource CommonTopCurves}" VerticalOptions="End">
        <StackLayout>
            <Image HorizontalOptions="EndAndExpand" Source="close.png">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseTapped" />
                </Image.GestureRecognizers>
            </Image>

            <custom:CustomLabel Style="{StaticResource SectionTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZVatNotes}" />


            <inputLayout:SfTextInputLayout
                Margin="0,-6,0,-6"
                ContainerType="Outlined"
                ErrorColor="#B00020"
                FocusedColor="#{StaticResource Primary}"
                HasError="{Binding IsReportDetailHasError}"
                OutlineCornerRadius="8"
                UnfocusedColor="#B1B1B1">
                <StackLayout Margin="0,16,0,0" Orientation="Vertical">
                    <Editor
                        x:Name="NoteDetail"
                        AutoSize="TextChanges"
                        FontSize="Small"
                        HeightRequest="200"
                        HorizontalOptions="FillAndExpand"
                        IsSpellCheckEnabled="False"
                        MaxLength="999"
                        Text="{Binding NoteText}"
                        Unfocused="NoteDetail_Unfocused" />

                    <custom:CustomLabel
                        FontSize="Micro"
                        HorizontalOptions="EndAndExpand"
                        Style="{StaticResource CaptionLabelGrey}"
                        Text="{Binding Source={x:Reference NoteDetail}, Path=Text.Length, StringFormat='{0}/999'}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                </StackLayout>


            </inputLayout:SfTextInputLayout>


            <buttons:SfButton
                Margin="0,8,0,0"
                Command="{Binding OnAddButtonClicked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZVatNotesSaveandClose}"
                VerticalOptions="CenterAndExpand" />
            <buttons:SfButton
                Margin="0,8,0,0"
                Command="{Binding OnClearButtonClicked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZVatNotesClearandClose}"
                VerticalOptions="CenterAndExpand" />
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>