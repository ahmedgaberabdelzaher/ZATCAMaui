<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
             Title= "{x:Static ResourceManager:AppResources.NDInvoiceDetail}"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             BackgroundImageSource="partials_background"
             x:Class="EGAZT.Views.NewDesign.EstimatedZAKATReturnsPages.ZakatReturnNewSuccessPageView">

    <ContentPage.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <Style TargetType="yummy:PancakeView" x:Key="MainPage">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Padding" Value="20,20,20,10"/>
                <Setter Property="CornerRadius" Value="15,15,0,0"/>
            </Style>
            <Style TargetType="Label" x:Key="HorizontalEnd" >
                <Setter Property="HorizontalOptions" Value="EndAndExpand"/>
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SSTArabicMedium}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="Label" x:Key="SectionTitleBlackTopNegative10" >
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SSTArabicMedium}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="0,-10,0,0"/>
            </Style>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38*"/>
                    <RowDefinition Height="62*"/>
                </Grid.RowDefinitions>

                <StackLayout Grid.Row="0" Margin="0,8,0,10" Spacing="0" VerticalOptions="StartAndExpand" HorizontalOptions="CenterAndExpand">
                    <Image Source="Forget_ic_success"/>
                    <Label Text="{x:Static ResourceManager:AppResources.NDZakatReturn}" Margin="0,0,0,0" TextColor="White" Style="{StaticResource SectionTitleBlack}" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" />
                    <Label Text="{x:Static ResourceManager:AppResources.NDZakatReturnSubmittedSuccessMessage}"  TextColor="White" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Style="{StaticResource BodyLabelBlack}" Margin="0,-10,0,0" IsVisible="{Binding SetSuccessMessageVisibility}"/>
                </StackLayout>

                <yummy:PancakeView  Grid.Row="1" CornerRadius="15,15,0,0" VerticalOptions="EndAndExpand" Padding="20,20,20,10" HasShadow="True" BackgroundColor="White">
                    <Grid HorizontalOptions="FillAndExpand" x:Name="MainGrid" Padding="0,0,0,0" VerticalOptions="FillAndExpand" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <ScrollView VerticalScrollBarVisibility="Never" Grid.Row="0">
                            <StackLayout Spacing="0" >
                                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                                    <Grid Padding="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                            Text="{x:Static ResourceManager:AppResources.NDReferenceNumber}"
                                                            VerticalOptions="Center" Style="{StaticResource ValueLabelGrey}"
                                                            HorizontalOptions="Start" />

 

                                        <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding ReferenceNumber}"
                                                            VerticalOptions="Center" HorizontalOptions="End" Style="{StaticResource ValueLabelBlack}" />

 

                                        <Image Grid.Row="0" Grid.Column="2" Source="zakat_copy.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Tapped="OnCopyReferenceNumberButtonClicked"/>
                                            </Image.GestureRecognizers>
                                            
                                        </Image>

                                    </Grid>
                                    <!--<StackLayout Orientation="Horizontal"  Padding="5,10,5,10">
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDReferenceNumber}" Style="{StaticResource CaptionLabelGrey}" VerticalTextAlignment="Center" HorizontalOptions="Start" VerticalOptions="Center"/>
                                        <custom:CustomLabel WidthRequest="180" Text="{Binding ReferenceNumber}" Style="{StaticResource ValueLabelBlack}" FontSize="12" VerticalTextAlignment="Center" HorizontalOptions="Start" VerticalOptions="Center"/>
                                       
                                    </StackLayout>-->
                                </border:SfBorder >

                                <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Orientation="Horizontal"  Padding="5,10,5,10">
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}" Style="{StaticResource CaptionLabelGrey}" VerticalTextAlignment="Center" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <custom:CustomLabel Text="{Binding TaxablePeriod}" Style="{StaticResource ValueLabelBlack}" FontSize="12" VerticalTextAlignment="Center"  HorizontalOptions="Start"/>
                                        </StackLayout>
                                    </StackLayout>
                                </border:SfBorder >

                         
                            </StackLayout>
                        </ScrollView>
                        <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical" Spacing="8" BackgroundColor="White" Padding="0,8,0,0">

                            <Label Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}" TextColor="{StaticResource NewDullOrangeColor}" HorizontalTextAlignment="Center" Style="{StaticResource ValueLabelBlack}" >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="GoToDashboardClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </StackLayout>
                    </Grid>

                </yummy:PancakeView>


            </Grid>


        
        </Grid>


    </ContentPage.Content>
</ContentPage>