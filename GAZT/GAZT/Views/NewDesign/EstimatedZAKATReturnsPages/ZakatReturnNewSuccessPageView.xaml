<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstimatedZAKATReturnsPages.ZakatReturnNewSuccessPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    Title="{x:Static ResourceManager:AppResources.NDInvoiceDetail}"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <Style x:Key="MainPage" TargetType="yummy:PancakeView">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="20,20,20,10" />
                <Setter Property="CornerRadius" Value="15,15,0,0" />
            </Style>
            <Style x:Key="HorizontalEnd" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="EndAndExpand" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="SectionTitleBlackTopNegative10" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="0,-10,0,0" />
            </Style>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38*" />
                    <RowDefinition Height="62*" />
                </Grid.RowDefinitions>

                <StackLayout
                    Grid.Row="0"
                    Margin="0,8,0,10"
                    HorizontalOptions="CenterAndExpand"
                    Spacing="0"
                    VerticalOptions="StartAndExpand">
                    <Image Source="Forget_ic_success" />
                    <Label
                        Margin="0,0,0,0"
                        HorizontalOptions="FillAndExpand"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleBlack}"
                        Text="{x:Static ResourceManager:AppResources.NDZakatReturn}"
                        TextColor="White" />
                    <Label
                        Margin="0,-10,0,0"
                        HorizontalOptions="FillAndExpand"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding SetSuccessMessageVisibility}"
                        Style="{StaticResource BodyLabelBlack}"
                        Text="{x:Static ResourceManager:AppResources.NDZakatReturnSubmittedSuccessMessage}"
                        TextColor="White" />
                </StackLayout>

                <yummy:PancakeView
                    Grid.Row="1"
                    Padding="20,20,20,10"
                    BackgroundColor="White"
                    CornerRadius="15,15,0,0"
                    VerticalOptions="EndAndExpand">
                    <Grid
                        x:Name="MainGrid"
                        Padding="0,0,0,0"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                            <StackLayout Spacing="0">
                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <Grid Padding="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.NDReferenceNumber}"
                                            VerticalOptions="Center" />



                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding ReferenceNumber}"
                                            VerticalOptions="Center" />



                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Source="zakat_copy.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCopyReferenceNumberButtonClicked" />
                                            </Image.GestureRecognizers>

                                        </Image>

                                    </Grid>
                                    <!--<StackLayout Orientation="Horizontal"  Padding="5,10,5,10">
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDReferenceNumber}" Style="{StaticResource CaptionLabelGrey}" VerticalTextAlignment="Center" HorizontalOptions="Start" VerticalOptions="Center"/>
                                        <custom:CustomLabel WidthRequest="180" Text="{Binding ReferenceNumber}" Style="{StaticResource ValueLabelBlack}" FontSize="11" VerticalTextAlignment="Center" HorizontalOptions="Start" VerticalOptions="Center"/>

                                    </StackLayout>-->
                                </border:SfBorder>

                                <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrame}">
                                    <StackLayout Padding="5,10,5,10" Orientation="Horizontal">
                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZVatTaxablePeriod}"
                                            VerticalTextAlignment="Center" />
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <custom:CustomLabel
                                                FontSize="11"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TaxablePeriod}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>
                                    </StackLayout>
                                </border:SfBorder>


                            </StackLayout>
                        </ScrollView>
                        <StackLayout
                            Grid.Row="1"
                            Padding="0,8,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Vertical"
                            Spacing="8"
                            VerticalOptions="FillAndExpand">

                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource ValueLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZGotoDashboard}"
                                TextColor="{StaticResource NewDullOrangeColor}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="GoToDashboardClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </StackLayout>
                    </Grid>

                </yummy:PancakeView>


            </Grid>



        </Grid>


    </ContentPage.Content>
</ContentPage>