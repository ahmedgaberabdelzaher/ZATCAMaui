                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding ReleaseOrBillDetailsButtonText}" />
                                <buttons:SfButton
                                    x:Name="btnprimary"
                                    Margin="0,10,0,0"
                                    Command="{Binding OnSubmitClicked}"
                                    IsVisible="{Binding SetSubmitButtonVisibility}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Submit}" />
                                <buttons:SfButton
                                    Margin="0,10,0,0"
                                    Clicked="OnConfirmClicked"
                                    IsVisible="{Binding SetConfirmButtonVisibility}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Confirm}" />
                                <buttons:SfButton
                                    Margin="0,10,0,0"
                                    Clicked="OnBillsDetailsClicked"
                                    IsVisible="{Binding SetAmendButtonVisibility}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.BillDetails}" />
                                <buttons:SfButton
                                    Margin="0,10,0,0"
                                    Clicked="OnAmendClick"
                                    IsVisible="{Binding SetAmendButtonVisibility}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZZAmend}" />


                                <Label
                                    HorizontalOptions="FillAndExpand"
                                    HorizontalTextAlignment="Center"
                                    IsVisible="{Binding ChangeFromEstimateTAccountringBasisButtonVisibility}"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.ChangeFromEstimateToAccountingBasis}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OnChangeFromEstimateToAccountingBasisButtonClicked}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <!--<Label Margin="0,10,0,0" Text="{x:Static ResourceManager:AppResources.NDConfirmAndGenerateSADADBill}"   Style="{StaticResource ValueLabelBlack}" TextColor="{StaticResource Green}" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" IsVisible="{Binding ConfirmAndGenerateSADADBillLabelVisibility}">

                        </Label>-->

                            </StackLayout>
                        </StackLayout>
                    </ScrollView>


                </Grid>
            </yummy:PancakeView>


            <Grid Grid.Row="0" Padding="15,10,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="40" />

                </Grid.ColumnDefinitions>

                <custom:CustomLabel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding ZAKATReturnsPagName}"
                    VerticalOptions="Center" />

                <StackLayout Grid.Row="0" Grid.Column="0">
                    <Image
                        HorizontalOptions="StartAndExpand"
                        IsVisible="{Binding IsBackBtnVisible}"
                        Source="arrowLeftwhite"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClicked}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <!--<StackLayout Grid.Row="0" Grid.Column="2" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}">
                    <Image IsVisible="{Binding IsBackBtnVisible}" Source="close" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">

                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClicked}"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>-->

            </Grid>


            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Primary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                        <!--  Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"  -->
                    </StackLayout>
                </StackLayout>
            </Grid>

        </Grid>
    </ContentPage.Content>
</ContentPage>
