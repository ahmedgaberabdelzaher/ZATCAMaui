                                            <StackLayout Spacing="0" Grid.Row="1" Grid.Column="0">
                                                <Label Text="{x:Static local:AppResources.ZInformationfromrelatedparties}" Style="{StaticResource CaptionLabelGrey}"></Label>

                                                <inputLayout:SfTextInputLayout IsVisible="{Binding isEditVisible}" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0">
                                                    <custom:GAZTBorderlessEntry  Text="{Binding Cpamt}"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                                    </custom:GAZTBorderlessEntry>

                                                    <inputLayout:SfTextInputLayout.TrailingView>
                                                        <Label Text="SAR"  Style="{StaticResource InputTableLableStyleForSAR}"></Label>
                                                    </inputLayout:SfTextInputLayout.TrailingView>

                                                </inputLayout:SfTextInputLayout>

                                                <custom:CustomLabel Text="{Binding Cpamt}" IsVisible="{Binding isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}"/>

                                            </StackLayout>
                                            <StackLayout Spacing="0" Margin="10,0,0,0" Grid.Row="1" Grid.Column="1">
                                                <Label Text="{x:Static local:AppResources.ZEstimatedSales}" Style="{StaticResource CaptionLabelGrey}"></Label>
                                                <inputLayout:SfTextInputLayout IsVisible="{Binding isEditVisible}" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0">
                                                    <custom:GAZTBorderlessEntry  Text="{Binding Cpamt}"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                                    </custom:GAZTBorderlessEntry>

                                                    <inputLayout:SfTextInputLayout.TrailingView>
                                                        <Label Text="SAR"  Style="{StaticResource InputTableLableStyleForSAR}"></Label>
                                                    </inputLayout:SfTextInputLayout.TrailingView>

                                                </inputLayout:SfTextInputLayout>
                                                <custom:CustomLabel Text="{Binding Cpamt}" IsVisible="{Binding isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}"/>
                                            </StackLayout>
                                        </Grid>


                                        <!---->
                                </StackLayout>
                                    <StackLayout BackgroundColor="AliceBlue" Padding="10">
                                        <custom:CustomLabel Text="Estimated Sales for the Fiscal Year" Style="{StaticResource BodyLabelBlack}"/>
                                        <custom:CustomLabel Text="500.00 SAR" Style="{StaticResource SectionTitleBlack}"/>                                        
                                    </StackLayout>                                
                                
                            </StackLayout>
                        </border:SfBorder>

                    </StackLayout>
                </ScrollView>

                    <StackLayout Grid.Row="1" BackgroundColor="White">
                        <buttons:SfButton x:Name="btnprimary" Text="Submit" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OnSubmitClicked}"/>
                        <custom:CustomLabel Margin="0,10,0,0" Text="Change to Account Basis" Style="{StaticResource ValueLabelBlack}" TextColor="#d49504" HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Grid>
            </yummy:PancakeView>
            
            
            <Grid Padding="15,10,15,10" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="20*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="1" Grid.Row="0"   Text="Return Details" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />

                <StackLayout Grid.Row="0" Grid.Column="0">
                    <Image IsVisible="{Binding IsBackBtnVisible}" Source="arrowLeftwhite" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">

                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClicked}"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Grid.Row="0" Grid.Column="2" IsVisible="{Binding isLabelVisible}">
                    <Image IsVisible="{Binding IsBackBtnVisible}" Source="close" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">

                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClicked}"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
