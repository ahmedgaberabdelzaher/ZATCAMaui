<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstimatedZAKATReturnsPages.ZAKATReturnDetailsView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:GAZTBehaviors="clr-namespace:EGAZT"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:local="clr-namespace:EGAZT;assembly=GAZT"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    Title="{Binding ZAKATReturnsPagName}"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>

            <Style x:Key="MainPage" TargetType="yummy:PancakeView">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="20,20,20,10" />
                <Setter Property="CornerRadius" Value="15,15,0,0" />
            </Style>
            <Style x:Key="HorizontalEnd" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="EndAndExpand" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="SectionTitleBlackTopNegative10" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,-10,0,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <yummy:PancakeView Grid.Row="1" Style="{StaticResource MainPage}">
                <Grid x:Name="MainGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollView
                        x:Name="scrollView"
                        Grid.Row="0"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZZZAKAT}" />
                                <StackLayout HorizontalOptions="EndAndExpand" VerticalOptions="Center">
                                    <buttons:SfButton
                                        BackgroundColor="{Binding ICRStatusBG}"
                                        CornerRadius="20"
                                        HorizontalTextAlignment="Start"
                                        ImageSource="{Binding ICRStatusImage}"
                                        ShowIcon="True"
                                        Style="{StaticResource CaptionButtonBlack}"
                                        Text="{Binding ICRStatus}"
                                        TextColor="{Binding ICRStatusTextColor}"
                                        VerticalTextAlignment="Center" />
                                </StackLayout>
                            </StackLayout>
                            <!--  Start of Return Details  -->
                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout
                                        Padding="10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Image Margin="0" Source="return_vatRefunds.png" />
                                        <!--<Frame   HeightRequest="25" WidthRequest="25" CornerRadius="50"  VerticalOptions="CenterAndExpand" BackgroundColor="{StaticResource OpacityPrimary}"
                                                HasShadow="False" Padding="10">


                                        </Frame>-->

                                        <custom:CustomLabel
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}"
                                            VerticalOptions="Center" />
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout
                                        Padding="10"
                                        BindingContext="{Binding ZakatReturnDetail}"
                                        Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static local:AppResources.FiscalYear}" />
                                            <custom:CustomLabel
                                                Style="{StaticResource HorizontalEnd}"
                                                StyleId="ValueLabel"
                                                Text="{Binding Persl}" />
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel
                                                HorizontalOptions="End"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static local:AppResources.FinancialPeriodFrom}" />
                                            <StackLayout
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Vertical"
                                                Spacing="0"
                                                StyleId="ValueLabel"
                                                WidthRequest="160">
                                                <custom:CustomLabel Style="{StaticResource HorizontalEnd}" Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.FromDate}">

                                                    <!--<Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.FromDate}"  />
                                            <Span Text="&#10;"/>
                                            <Span Text="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.ToDate}"  />
                                             </FormattedString>
                                    </Label.FormattedText>-->
                                                </custom:CustomLabel>
                                                <custom:CustomLabel
                                                    Margin="5"
                                                    Style="{StaticResource HorizontalEnd}"
                                                    StyleId="ValueLabel"
                                                    Text="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.ToDate}" />

                                            </StackLayout>
                                        </StackLayout>
                                        <StackLayout
                                            HeightRequest="60"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static local:AppResources.ZReturnReferenceNumber}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource HorizontalEnd}"
                                                StyleId="ValueLabel"
                                                Text="{Binding Fbnum}"
                                                WidthRequest="120" />
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                            <!--  End of Return Details  -->

                            <!--  Start of Zakat Calculation  -->
                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout
                                        Padding="10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Image Source="zakat_manageTax" />
                                        <!--<Frame   HeightRequest="25" WidthRequest="25" CornerRadius="50"  VerticalOptions="CenterAndExpand" BackgroundColor="{StaticResource OpacityPrimary}"
                                                HasShadow="False" Padding="10">

                                        </Frame>-->



                                        <custom:CustomLabel
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.NDZakatCalculation}"
                                            VerticalOptions="Center" />
                                    </StackLayout>

                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />

                                    <StackLayout
                                        Padding="10"
                                        BindingContext="{Binding ZakatReturnDetail}"
                                        Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*" />
                                                <ColumnDefinition Width="45*" />
                                                <ColumnDefinition Width="15*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static local:AppResources.ZZEstimatedSalesForFiscalYear}" />
                                            <custom:CustomLabel Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Estsl}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static local:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>

                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="EndAndExpand"
                                                Source="ic_vat_info"
                                                VerticalOptions="Start">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEstimatedSalesForTheFiscalYearInfoClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>


                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*" />
                                                <ColumnDefinition Width="45*" />
                                                <ColumnDefinition Width="15*" />
                                            </Grid.ColumnDefinitions>

                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static local:AppResources.Capital}" />
                                            <custom:CustomLabel Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Cpamt}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static local:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>

                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="EndAndExpand"
                                                Source="ic_vat_info">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCapitalAmountInformationClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </Grid>
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*" />
                                                <ColumnDefinition Width="45*" />
                                                <ColumnDefinition Width="15*" />
                                            </Grid.ColumnDefinitions>

                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static local:AppResources.ZakatBase}" />
                                            <custom:CustomLabel Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Zbamt}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static local:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>

                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="EndAndExpand"
                                                Source="ic_vat_info"
                                                VerticalOptions="Start">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnZAKATBaseAmountInfoClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </Grid>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                            <!--  End of Zakat Calculation  -->

                            <Frame
                                Margin="0,20,0,0"
                                Padding="0"
                                CornerRadius="12"
                                HasShadow="False"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource SfStyleForZakatPlanGreen}">
                                <StackLayout
                                    Padding="12"
                                    BindingContext="{Binding ZakatReturnDetail}"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <custom:CustomLabel
                                        FontSize="15"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static local:AppResources.ZakatAmount}"
                                        VerticalOptions="Center" />
                                    <custom:CustomLabel
                                        FontSize="15"
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource SectionTitleBlack}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Zkamt}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static local:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </custom:CustomLabel>
                                    <Image
                                        Grid.Column="2"
                                        HorizontalOptions="EndAndExpand"
                                        Source="ic_vat_info">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnZAKATAmountInfoClicked" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                </StackLayout>
                            </Frame>


                            <yummy:PancakeView Style="{StaticResource GreyBorderFrameWithShadow1}">
                                <yummy:PancakeView.Border>
                                    <yummy:Border Thickness="1" Color="{StaticResource NeutralLightGrey}" />
                                </yummy:PancakeView.Border>
                                <StackLayout>
                                    <StackLayout
                                        Padding="10"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Image Source="zakat_details" />
                                        <!--<Frame   HeightRequest="25" WidthRequest="25" CornerRadius="50"  VerticalOptions="CenterAndExpand" BackgroundColor="{StaticResource OpacityPrimary}"
                                                HasShadow="False" Padding="10">

                                        </Frame>-->


                                        <custom:CustomLabel
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZSalesDetails}"
                                            VerticalOptions="Center" />
                                        <!--  { Binding IsEditTextVisible}  -->

                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            IsVisible="{Binding IsEditTextVisible}"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static local:AppResources.VATDeregistrationEdit}">
                                            <custom:CustomLabel.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEditClicked" />
                                            </custom:CustomLabel.GestureRecognizers>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                    <BoxView Style="{StaticResource lineSeperator}" />

                                    <StackLayout
                                        Padding="10,10,10,0"
                                        BindingContext="{Binding ZakatReturnDetail}"
                                        Spacing="0">
                                        <Grid RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal">
                                                <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZTotalVATSales}" />
                                                <Image HorizontalOptions="EndAndExpand" Source="ic_vat_info">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTotalVATSalesInfoClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>
                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static local:AppResources.ZInformationfromrelatedparties}" />

                                            <StackLayout
                                                x:Name="TVSA"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="TotalVATSalesNew"
                                                        IsReadOnly="True"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslI}">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                                Max="18"
                                                                isNegativeEnable="False"
                                                                numberOfDigitAfterDecimal="2"
                                                                numberOfDigitBeforDecimal="11" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>

                                                <custom:CustomLabel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                    Style="{StaticResource SectionTitleBlackTopNegative10}"
                                                    Text="{Binding TvtslI}" />

                                            </StackLayout>

                                            <StackLayout
                                                x:Name="TVSNA"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        IsReadOnly="True"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslI}" />

                                                </inputLayout:SfTextInputLayout>
                                                <custom:CustomLabel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                    Style="{StaticResource SectionTitleBlackTopNegative10}"
                                                    Text="{Binding TvtslI}" />

                                            </StackLayout>


                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="10,0,10,0"
                                                HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static local:AppResources.ZEstimatedSales}" />

                                            <StackLayout
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="0,0,10,0"
                                                HorizontalOptions="EndAndExpand"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    InputViewPadding="16,0,16,0"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext. isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}">
                                                    <custom:GAZTBorderlessEntry
                                                        IsReadOnly="True"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslE}" />



                                                </inputLayout:SfTextInputLayout>
                                                <custom:CustomLabel
                                                    Margin="10,-10,0,0"
                                                    HorizontalOptions="EndAndExpand"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                    Style="{StaticResource SectionTitleBlackTopNegative10}"
                                                    Text="{Binding TvtslE}" />
                                            </StackLayout>

                                            <custom:CustomLabel
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext. isEditVisible}"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static local:AppResources.InformationFromRelatedPartiesNewValue}" />

                                            <StackLayout
                                                x:Name="TotalVATSalesApplicableLayout"
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    x:Name="TotalVATSalesInputLayout"
                                                    Margin="0"
                                                    ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        x:Name="TotalVATSales"
                                                        IsReadOnly="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.SetReadOnlyToTotalVATSales}"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TvtslI}">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                                Max="18"
                                                                isNegativeEnable="False"
                                                                numberOfDigitAfterDecimal="2"
                                                                numberOfDigitBeforDecimal="11" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>


                                            </StackLayout>


                                            <StackLayout
                                                x:Name="TotalVATSalesNotApplicableLayout"
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Spacing="0">
                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    Focused="TotalVATSalesInputFocused"
                                                    InputViewPadding="16,0,16,0"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isEditVisible}"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource TextInputLayout}"
                                                    Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry
                                                        IsReadOnly="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.SetReadOnlyToTotalVATSales}"
                                                        Keyboard="Numeric"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="0.00">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue
                                                                Max="18"
                                                                isNegativeEnable="False"
                                                                numberOfDigitAfterDecimal="2"
                                                                numberOfDigitBeforDecimal="11" />
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>


                                            </StackLayout>


                                            <Image
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Margin="0,0,0,10"
                                                HorizontalOptions="EndAndExpand"
                                                Source="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.TotalVATSalesEditImageSource}">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTotalVATSaleEditImageClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                            <BoxView
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="-10,5,-10,15"
                                                IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext.isLabelVisible}"
                                                Style="{StaticResource lineSeperator}" />

                                        </Grid>
                                        <!--    -->
                                        <Grid RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal">
                                                <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZZAveragenumberoflabour}" />

                                                <Image HorizontalOptions="EndAndExpand" Source="ic_vat_info">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnAverageNumberOfLabourInfoClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>

                                            <custom:CustomLabel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource CaptionLabelGrey}"
                                                Text="{x:Static local:AppResources.ZInformationfromrelatedparties}" />

                                            <StackLayout
                                                x:Name="ANOLA"
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Spacing="0">

                                                <inputLayout:SfTextInputLayout
                                                    Margin="0"
                                                    ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}"
                                                    ContainerType="Outlined"
                                                    InputViewPadding="16,0,16,0"
                                                    IsVisible="{Binding Source={x:Reference Name=MainGrid}, Path=BindingContext. isEditVisible}"
                                                    LeadingViewPosition="Inside"
