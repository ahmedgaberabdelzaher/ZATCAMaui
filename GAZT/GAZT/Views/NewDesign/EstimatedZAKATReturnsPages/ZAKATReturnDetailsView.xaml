                                </StackLayout>
                            </StackLayout>
                            <!--Start of Return Details-->
                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" Padding="10">
                                       
                                            <Image Source="ic_vat_return">
                                            </Image>
                                       

                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}" Style="{StaticResource SectionTitleBlack}"/>
                        </StackLayout>

                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                        <StackLayout Padding="10" Spacing="10" BindingContext="{Binding ZakatReturnDetail}">
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static local:AppResources.FiscalYear}" Style="{StaticResource ValueLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding Persl}" Style="{StaticResource HorizontalEnd}" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static local:AppResources.FinancialPeriodFrom}" Style="{StaticResource ValueLabelGrey}"/>
                                <custom:CustomLabel x:Name="date"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static local:AppResources.ZReturnReferenceNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                <custom:CustomLabel Text="{Binding Fbnum}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </border:SfBorder>

                <!--End of Return Details-->

                <!--Start of Zakat Calculation-->
                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" Padding="10">
                                        <Image Source="zakat_manageTax">
                            </Image>
                            <custom:CustomLabel Text="Zakat Calculation" Style="{StaticResource SectionTitleBlack}"/>
                        </StackLayout>

                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                        <StackLayout Padding="10" Spacing="10" BindingContext="{Binding ZakatReturnDetail}">
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static local:AppResources.ZZEstimatedSalesForFiscalYear}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Style="{StaticResource HorizontalEnd}">
                                             <Label.FormattedText>
                                    <FormattedString>
                                      <Span Text="{Binding Estsl}"/>
                                          <Span Text=" "/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                                        </custom:CustomLabel>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static local:AppResources.Capital}" Style="{StaticResource ValueLabelGrey}"/>
                                <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">
                                     <Label.FormattedText>
                                    <FormattedString>
                                      <Span Text="{Binding Cpamt}" />
                                          <Span Text=" "/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                                </custom:CustomLabel>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static local:AppResources.ZakatBase}" Style="{StaticResource ValueLabelGrey}"/>
