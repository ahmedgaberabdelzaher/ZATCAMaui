                                    <Label.FormattedText>
                                    <FormattedString>
                                      <Span Text="{Binding Zbamt}"/>
                                          <Span Text=" "/>
                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                                </custom:CustomLabel>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </border:SfBorder>
                <!--End of Zakat Calculation-->

                        <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}" BackgroundColor="AliceBlue" HasShadow="False" Padding="10">
