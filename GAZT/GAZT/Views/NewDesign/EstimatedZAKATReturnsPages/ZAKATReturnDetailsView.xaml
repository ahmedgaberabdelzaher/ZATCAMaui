<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:GAZTBehaviors="clr-namespace:EGAZT"
             xmlns:local="clr-namespace:EGAZT;assembly=GAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             BackgroundImageSource="partials_background"
             x:Class="EGAZT.Views.NewDesign.EstimatedZAKATReturnsPages.ZAKATReturnDetailsView"
             Title= "{Binding ZAKATReturnsPagName}"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>

            <Style TargetType="yummy:PancakeView" x:Key="MainPage">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Padding" Value="20,20,20,10"/>
                <Setter Property="CornerRadius" Value="15,15,0,0"/>
            </Style>
            <Style TargetType="Label" x:Key="HorizontalEnd" >
                <Setter Property="HorizontalOptions" Value="EndAndExpand"/>
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style TargetType="Label" x:Key="SectionTitleBlackTopNegative10" >
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,-10,0,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <yummy:PancakeView Grid.Row="1"  Style="{StaticResource MainPage}">
                <Grid x:Name="MainGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollView x:Name="scrollView" Grid.Row="0" VerticalScrollBarVisibility="Never">
                        <StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZAKAT}" Style="{StaticResource PageTitleBlack}" />
                                <StackLayout VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                                    <buttons:SfButton  HorizontalTextAlignment="Start"  Style="{StaticResource CaptionButtonBlack}" ImageSource="{Binding ICRStatusImage}"  ShowIcon="True" Text="{Binding ICRStatus}" BackgroundColor="{Binding ICRStatusBG}" CornerRadius="20" TextColor="{Binding ICRStatusTextColor}" VerticalTextAlignment="Center" />
                                </StackLayout>
                            </StackLayout>
                            <!--Start of Return Details-->
                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}" >
                                <StackLayout >
                                    <StackLayout Orientation="Horizontal" Spacing="10" Padding="10">
                                        <Image Margin="0" Source="return_vatRefunds.png"/>
                                        <!--<Frame   HeightRequest="25" WidthRequest="25" CornerRadius="50"  VerticalOptions="CenterAndExpand" BackgroundColor="{StaticResource OpacityPrimary}"
                                                HasShadow="False" Padding="10">

                                           
                                        </Frame>-->

                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}" Style="{StaticResource SectionTitleBlackBold}" VerticalOptions="Center"/>
                                    </StackLayout>

                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                    <StackLayout Padding="10" Spacing="10" BindingContext="{Binding ZakatReturnDetail}">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static local:AppResources.FiscalYear}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding Persl}" Style="{StaticResource HorizontalEnd}" StyleId="ValueLabel"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static local:AppResources.FinancialPeriodFrom}" HorizontalOptions="End" HorizontalTextAlignment="End" Style="{StaticResource ValueLabelGrey}"/>
                                            <StackLayout Spacing="0" Orientation="Vertical" HorizontalOptions="FillAndExpand" WidthRequest="160" StyleId="ValueLabel">
                                                <custom:CustomLabel Text="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.FromDate}"  Style="{StaticResource HorizontalEnd}" >

                                                    <!--<Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.FromDate}"  />
                                            <Span Text="&#10;"/>
                                            <Span Text="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.ToDate}"  />
                                             </FormattedString>
                                    </Label.FormattedText>-->
                                                </custom:CustomLabel>
                                                <custom:CustomLabel Margin="5" Text="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.ToDate}"  Style="{StaticResource HorizontalEnd}" StyleId="ValueLabel" >
                                                </custom:CustomLabel>

                                            </StackLayout>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" HeightRequest="60">
                                            <custom:CustomLabel Text="{x:Static local:AppResources.ZReturnReferenceNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding Fbnum}" Style="{StaticResource HorizontalEnd}"  HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End" WidthRequest="120" StyleId="ValueLabel"/>
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                            <!--End of Return Details-->

                            <!--Start of Zakat Calculation-->
                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" Padding="10">
                                        <Image  Source="zakat_manageTax"></Image>
                                        <!--<Frame   HeightRequest="25" WidthRequest="25" CornerRadius="50"  VerticalOptions="CenterAndExpand" BackgroundColor="{StaticResource OpacityPrimary}"
                                                HasShadow="False" Padding="10">
                                            
                                        </Frame>-->



                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDZakatCalculation}" Style="{StaticResource SectionTitleBlackBold}" VerticalOptions="Center"/>
                                    </StackLayout>

                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                    <StackLayout Padding="10" Spacing="10" BindingContext="{Binding ZakatReturnDetail}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="15*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static local:AppResources.ZZEstimatedSalesForFiscalYear}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Estsl}" />
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>

                                            <Image Grid.Column="2" Source="ic_vat_info" HorizontalOptions="EndAndExpand" VerticalOptions="Start">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEstimatedSalesForTheFiscalYearInfoClicked"/>
                                                </Image.GestureRecognizers>
                                            </Image>


                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="15*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>

                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static local:AppResources.Capital}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Cpamt}" />
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>

                                            <Image Grid.Column="2" Source="ic_vat_info" HorizontalOptions="EndAndExpand">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnCapitalAmountInformationClicked"/>
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </Grid>
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"></ColumnDefinition>
                                                <ColumnDefinition Width="45*"></ColumnDefinition>
                                                <ColumnDefinition Width="15*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>

                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static local:AppResources.ZakatBase}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Column="1" Style="{StaticResource HorizontalEnd}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Zbamt}" />
                                                        <Span Text=" "/>
                                                        <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </custom:CustomLabel>

                                            <Image Grid.Column="2" Source="ic_vat_info" HorizontalOptions="EndAndExpand" VerticalOptions="Start">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnZAKATBaseAmountInfoClicked"/>
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </Grid>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                            <!--End of Zakat Calculation-->

                            <Frame  HorizontalOptions="FillAndExpand" Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12" Margin="0,20,0,0" Padding="0">
                                <StackLayout Orientation="Horizontal" BindingContext="{Binding ZakatReturnDetail}" HorizontalOptions="FillAndExpand" Padding="12">
                                    <custom:CustomLabel Text="{x:Static local:AppResources.ZakatAmount}" Style="{StaticResource ValueLabelBlack}" VerticalOptions="Center" FontSize="15"/>
                                    <custom:CustomLabel  Style="{StaticResource SectionTitleBlack}" HorizontalOptions="EndAndExpand" VerticalOptions="Center" FontSize="15">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Zkamt}"/>
                                                <Span Text=" "/>
                                                <Span Text="{x:Static local:AppResources.ZSAR}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </custom:CustomLabel>
                                    <Image Grid.Column="2" Source="ic_vat_info" HorizontalOptions="EndAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnZAKATAmountInfoClicked"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                </StackLayout>
                            </Frame>


                            <yummy:PancakeView Style="{StaticResource GreyBorderFrameWithShadow1}">
                                <yummy:PancakeView.Border>
                                    <yummy:Border Color="{StaticResource NeutralLightGrey}" Thickness="1"/>
                                </yummy:PancakeView.Border>
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10" Padding="10">
                                         <Image Source="zakat_details"  ></Image>
                                        <!--<Frame   HeightRequest="25" WidthRequest="25" CornerRadius="50"  VerticalOptions="CenterAndExpand" BackgroundColor="{StaticResource OpacityPrimary}"
                                                HasShadow="False" Padding="10">
                                           
                                        </Frame>-->


                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZSalesDetails}" Style="{StaticResource SectionTitleBlackBold}" VerticalOptions="Center"/>
                                        <!--{ Binding IsEditTextVisible}-->

                                        <custom:CustomLabel IsVisible="{Binding IsEditTextVisible}" HorizontalOptions="EndAndExpand" Text="{x:Static local:AppResources.VATDeregistrationEdit}" Style="{StaticResource ValueLabelBlack}">
                                            <custom:CustomLabel.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEditClicked"/>
                                            </custom:CustomLabel.GestureRecognizers>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                    <BoxView Style="{StaticResource lineSeperator}"/>

                                    <StackLayout Spacing="0" Padding="10,10,10,0"  BindingContext="{Binding ZakatReturnDetail}">
                                        <Grid RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>

                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZTotalVATSales}" Style="{StaticResource ValueLabelBlack}"/>
                                                <Image Source="ic_vat_info" HorizontalOptions="EndAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTotalVATSalesInfoClicked"/>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>
                                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static local:AppResources.ZInformationfromrelatedparties}" Style="{StaticResource CaptionLabelGrey}"></custom:CustomLabel>

                                            <StackLayout x:Name="TVSA" Spacing="0" Grid.Row="2" Grid.Column="0">
                                                <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isEditVisible}"  Style="{StaticResource TextInputLayout}" Margin="0"  Focused="TotalVATSalesInputFocused"  Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry x:Name="TotalVATSalesNew" Text="{Binding TvtslI}" Keyboard="Numeric" IsReadOnly="True"   Style="{StaticResource DefaultEntry}">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="18" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="11" isNegativeEnable="False"/>
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>

                                                <custom:CustomLabel Text="{Binding TvtslI}" Grid.Row="1" Grid.Column="1"  IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}" />

                                            </StackLayout>

                                            <StackLayout x:Name="TVSNA" Spacing="0" Grid.Row="2" Grid.Column="0" >
                                                <inputLayout:SfTextInputLayout  LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isEditVisible}"  Style="{StaticResource TextInputLayout}" Margin="0"  Focused="TotalVATSalesInputFocused"  Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry  Text="{Binding TvtslI}" Keyboard="Numeric" IsReadOnly="True"   Style="{StaticResource DefaultEntry}">

                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>
                                                <custom:CustomLabel Text="{Binding TvtslI}" Grid.Row="1" Grid.Column="1"  IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}" />

                                            </StackLayout>


                                            <custom:CustomLabel Text="{x:Static local:AppResources.ZEstimatedSales}" Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionLabelGrey}" Margin="10,0,10,0" HorizontalOptions="EndAndExpand"></custom:CustomLabel>

                                            <StackLayout Spacing="0" Margin="0,0,10,0" Grid.Row="2" Grid.Column="1" HorizontalOptions="EndAndExpand">
                                                <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext. isEditVisible}" Style="{StaticResource TextInputLayout}" Margin="0">
                                                    <custom:GAZTBorderlessEntry  Text="{Binding TvtslE}"   IsReadOnly="True"  Style="{StaticResource DefaultEntry}">
                                                    </custom:GAZTBorderlessEntry>

                                                 

                                                </inputLayout:SfTextInputLayout>
                                                <custom:CustomLabel  Text="{Binding TvtslE}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}" Margin="10,-10,0,0" HorizontalOptions="EndAndExpand"/>
                                            </StackLayout>

                                            <custom:CustomLabel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext. isEditVisible}" Text="{x:Static local:AppResources.InformationFromRelatedPartiesNewValue}" Style="{StaticResource CaptionLabelGrey}"></custom:CustomLabel>

                                            <StackLayout x:Name="TotalVATSalesApplicableLayout" Spacing="0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                                                <inputLayout:SfTextInputLayout Margin="0" LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" x:Name="TotalVATSalesInputLayout" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isEditVisible}"  Style="{StaticResource TextInputLayout}"   Focused="TotalVATSalesInputFocused"  Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry x:Name="TotalVATSales" Text="{Binding TvtslI}" Keyboard="Numeric" IsReadOnly="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.SetReadOnlyToTotalVATSales}"   Style="{StaticResource DefaultEntry}">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="18" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="11" isNegativeEnable="False"/>
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>


                                            </StackLayout>


                                            <StackLayout x:Name="TotalVATSalesNotApplicableLayout"  Spacing="0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                                                <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isEditVisible}"  Style="{StaticResource TextInputLayout}" Margin="0"  Focused="TotalVATSalesInputFocused"  Unfocused="TotalVATSalesInputUnFocused">

                                                    <custom:GAZTBorderlessEntry  Text="0.00" Keyboard="Numeric" IsReadOnly="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.SetReadOnlyToTotalVATSales}"   Style="{StaticResource DefaultEntry}">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="18" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="11" isNegativeEnable="False"/>
                                                        </custom:GAZTBorderlessEntry.Behaviors>
                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>


                                            </StackLayout>


                                            <Image Grid.Row="5" Grid.Column="1"  Source="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.TotalVATSalesEditImageSource}"  HorizontalOptions="EndAndExpand" Margin="0,0,0,10">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTotalVATSaleEditImageClicked"/>
                                                </Image.GestureRecognizers>
                                            </Image>

                                            <BoxView Style="{StaticResource lineSeperator}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="-10,5,-10,15"/>

                                        </Grid>
                                        <!---->
                                        <Grid RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" >
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZAveragenumberoflabour}" Style="{StaticResource ValueLabelBlack}"/>

                                                <Image Source="ic_vat_info" HorizontalOptions="EndAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnAverageNumberOfLabourInfoClicked"/>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>

                                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static local:AppResources.ZInformationfromrelatedparties}" Style="{StaticResource CaptionLabelGrey}"></custom:CustomLabel>

                                            <StackLayout x:Name="ANOLA" Spacing="0" Grid.Row="2" Grid.Column="0">

                                                <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext. isEditVisible}" Style="{StaticResource TextInputLayout}" Margin="0">
                                                    <custom:GAZTBorderlessEntry x:Name="AverageNumberOfLabourNew" Keyboard="Numeric" Text="{Binding LabnoI}" IsReadOnly="True"    Style="{StaticResource DefaultEntry}"  Focused="AverageNumberOfLabourInputFocused"  Unfocused="AverageNumberOfLabourInputUnFocused">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="14" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="11" isNegativeEnable="False"/>
                                                        </custom:GAZTBorderlessEntry.Behaviors>

                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>

                                                <custom:CustomLabel Text="{Binding LabnoI}"     IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}"/>

                                            </StackLayout>

                                            <StackLayout x:Name="ANOLNA" Spacing="0" Grid.Row="2" Grid.Column="0">

                                                <inputLayout:SfTextInputLayout LeadingViewPosition="Inside" ContainerType="Outlined" OutlineCornerRadius="8"  InputViewPadding="16,0,16,0" ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext. isEditVisible}" Style="{StaticResource TextInputLayout}" Margin="0">
                                                    <custom:GAZTBorderlessEntry  Keyboard="Numeric" Text="{x:Static local:AppResources.ZNA}" IsReadOnly="True"    Style="{StaticResource DefaultEntry}"  Focused="AverageNumberOfLabourInputFocused"  Unfocused="AverageNumberOfLabourInputUnFocused">

                                                        <custom:GAZTBorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:ElevenDotTwoDecimalPlacesAndNoNegativeValue Max="14" numberOfDigitAfterDecimal="2" numberOfDigitBeforDecimal="11" isNegativeEnable="False"/>
                                                        </custom:GAZTBorderlessEntry.Behaviors>

                                                    </custom:GAZTBorderlessEntry>

                                                </inputLayout:SfTextInputLayout>

                                                <custom:CustomLabel Text="{x:Static local:AppResources.ZNA}"     IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}"/>

                                            </StackLayout>

                                            <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{x:Static local:AppResources.ZEstimatedSales}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="EndAndExpand"></custom:CustomLabel>

                                            <StackLayout Spacing="0" Margin="0,0,0,0" Grid.Row="2" Grid.Column="1">
                                                <inputLayout:SfTextInputLayout InputViewPadding="16,0,16,0"  ContainerBackgroundColor="{StaticResource ContainerBackgroundColor}" OutlineCornerRadius="8" ContainerType="Outlined" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext. isEditVisible}" Style="{StaticResource TextInputLayout}" Margin="0">
                                                    <custom:GAZTBorderlessEntry  Text="{Binding LabnoE}" HeightRequest="48"  IsReadOnly="True"  Style="{StaticResource InputTableEntryLayoutStyle}">

                                                    </custom:GAZTBorderlessEntry>

                                                  

                                                </inputLayout:SfTextInputLayout>
                                                <custom:CustomLabel  Text="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.LabnoE}" IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.isLabelVisible}" Style="{StaticResource SectionTitleBlackTopNegative10}" Margin="10,-10,0,0" HorizontalOptions="EndAndExpand"/>
                                                <!--<custom:CustomLabel  Text="{x:Static local:AppResources.ZNA}"  IsVisible="{Binding Source={x:Reference Name=MainGrid},Path=BindingContext.IsLabelVisibleWithNA}" Style="{StaticResource SectionTitleBlackTopNegative10}"/>-->

