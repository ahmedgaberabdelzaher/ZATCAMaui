<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.EstimatedZAKATReturnsPages.AttachmentPopUp"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    mc:Ignorable="d">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>

        <yummy:PancakeView
            Grid.Row="0"
            Padding="0"
            HeightRequest="400"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">
            <StackLayout>
                <ScrollView>
                    <StackLayout
                        Grid.Row="0"
                        Padding="15"
                        Spacing="0">
                        <!--<Image HorizontalOptions="End">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped"/>
                    </Image.GestureRecognizers>
                </Image>-->

                        <!--  Start Of Objection Reason  -->
                        <StackLayout>
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDWriteYourObjectionReason}" />
                            <inputLayout:SfTextInputLayout
                                Margin="0"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <custom:GAZTBorderlessEntry
                                    x:Name="ObjectionReason"
                                    Focused="OnObjectionReasonFocused"
                                    Style="{StaticResource InputTableEntryLayoutStyle}"
                                    Text="{Binding ObjectionReason}"
                                    Unfocused="OnObjectionReasonUnFocused" />
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                        <!--  End Of Objection Reason  -->

                        <!--  Start of Attachment Visible  -->
                        <StackLayout Spacing="0">
                            <custom:CustomLabel
                                Margin="0,20,0,0"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZTERReportDetailAttachment}" />

                            <!--<custom:CustomLabel Margin="0,-5,0,0" Text="20MB max" Style="{StaticResource CaptionLabelGrey}"/>-->
                            <!--<custom:CustomLabel Text="{x:Static local:AppResources.ZNote}" />-->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZFilesizeshouldnotbemorethan5MB}" />
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZChooseonlyfilewithextensionForZAKAT}" />
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZMaximumnoof5attachmentscanbeuploaded}" />

                            <border:SfBorder
                                Margin="0"
                                BorderColor="{StaticResource DarkGrayTextColor}"
                                BorderWidth="1"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                                    <Label
                                        HorizontalOptions="Start"
                                        Style="{StaticResource ValueLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentInputPlaceholder}" />

                                    <Image HorizontalOptions="EndAndExpand" Rotation="90">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                Size="25"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAttachmentClicked" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAttachmentClicked" />
                                    </StackLayout.GestureRecognizers>
                                </StackLayout>
                            </border:SfBorder>

                            <StackLayout Padding="0,10,0,10" Orientation="Horizontal">
                                <ListView
                                    x:Name="Attachmentlist"
                                    BackgroundColor="White"
                                    HasUnevenRows="True"
                                    HeightRequest="300"
                                    HorizontalOptions="FillAndExpand"
                                    ItemTapped="Attachmentlist_ItemTapped"
                                    ItemsSource="{Binding ZakatReturnAttachmentsList}"
                                    SeparatorVisibility="None"
                                    VerticalOptions="FillAndExpand"
                                    VerticalScrollBarVisibility="Never">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <StackLayout Padding="0,5,0,5" HorizontalOptions="FillAndExpand">

                                                    <border:SfBorder
                                                        Margin="0"
                                                        BorderColor="{StaticResource DarkGrayTextColor}"
                                                        BorderWidth="1"
                                                        Style="{StaticResource GreyBorderFrameWithShadow}">

                                                        <StackLayout Padding="0,10,0,10" Orientation="Horizontal">
                                                            <Image
                                                                Margin="5"
                                                                HeightRequest="25"
                                                                Source="{Binding FileImage}"
                                                                WidthRequest="25" />

                                                            <Label
                                                                HorizontalOptions="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Filename}" />

                                                            <Image HorizontalOptions="EndAndExpand">
                                                                <Image.Source>
                                                                    <FontImageSource
                                                                        FontFamily="UserIconFont"
                                                                        Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                        Size="25"
                                                                        Color="{StaticResource SecondaryNew}" />
                                                                </Image.Source>
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnDeleteAttachmentClickedTapped" />
                                                                </Image.GestureRecognizers>
                                                            </Image>


                                                        </StackLayout>

                                                    </border:SfBorder>
                                                </StackLayout>

                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </StackLayout>
                            <!--<custom:CustomLabel Margin="0,-5,0,0" Text="50MB max" Style="{StaticResource CaptionLabelGrey}"/>-->

                        </StackLayout>

                        <!--  End of Attachment Visible  -->


                    </StackLayout>



                </ScrollView>
                <!--  Footer Section Starts  -->
                <StackLayout
                    Grid.Row="2"
                    Padding="10"
                    BackgroundColor="White">
                    <!--<buttons:SfButton Text="{x:Static ResourceManager:AppResources.Save}" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />-->
                    <buttons:SfButton
                        Clicked="OnSaveClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ZDone}" />

                </StackLayout>
                <!--  Footer Section Ends  -->

            </StackLayout>

        </yummy:PancakeView>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            IsVisible="{Binding IsLoading}">
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                Margin="-30"
                BackgroundColor="Black"
                Opacity="0.5"
                Orientation="Vertical"
                VerticalOptions="FillAndExpand" />
            <StackLayout
                Grid.Row="0"
                Grid.Column="0"
                Padding="15,15"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"
                Opacity="0.8"
                Orientation="Vertical"
                VerticalOptions="Center">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <busyindicator:SfBusyIndicator
                        x:Name="busyindicatorForLanding"
                        AnimationType="SingleCircle"
                        EnableAnimation="True"
                        HorizontalOptions="CenterAndExpand"
                        IsBusy="True"
                        TextColor="{StaticResource Primary}"
                        TitlePlacement="Bottom"
                        VerticalOptions="CenterAndExpand"
                        ViewBoxHeight="70"
                        ViewBoxWidth="70" />
                </StackLayout>
            </StackLayout>
        </Grid>

    </Grid>
</pages:PopupPage>