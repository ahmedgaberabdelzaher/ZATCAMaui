<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"

             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.EstimatedZAKATReturnsPages.AttachmentPopUp"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" 
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
                  xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
>
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
      <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>

    <yummy:PancakeView Padding="0" Grid.Row="0" Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand" HeightRequest="400">
        <StackLayout>
            <ScrollView >
          <StackLayout Spacing="0" Grid.Row="0" Padding="15">
                <!--<Image HorizontalOptions="End">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped"/>
                    </Image.GestureRecognizers>
                </Image>-->

                <!--Start Of Objection Reason-->
                <StackLayout>
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDWriteYourObjectionReason}" Style="{StaticResource CaptionLabelGrey}"/>
                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0" HorizontalOptions="FillAndExpand">
                        <custom:GAZTBorderlessEntry x:Name="ObjectionReason" Text="{Binding ObjectionReason}"  Style="{StaticResource InputTableEntryLayoutStyle}" Focused="OnObjectionReasonFocused"  Unfocused="OnObjectionReasonUnFocused">
                        </custom:GAZTBorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
                <!--End Of Objection Reason-->

                <!--Start of Attachment Visible-->
                <StackLayout Spacing="0">
                    <custom:CustomLabel Margin="0,0,0,0" Text="{x:Static ResourceManager:AppResources.ZTERReportDetailAttachment}" Style="{StaticResource CaptionLabelGrey}"/>

                    <!--<custom:CustomLabel Margin="0,-5,0,0" Text="20MB max" Style="{StaticResource CaptionLabelGrey}"/>-->
                      <!--<custom:CustomLabel Text="{x:Static local:AppResources.ZNote}" />-->
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZFilesizeshouldnotbemorethan5MB}" Style="{StaticResource CaptionLabelGrey}"/>
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZChooseonlyfilewithextensionForZAKAT}" Style="{StaticResource CaptionLabelGrey}"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZMaximumnoof5attachmentscanbeuploaded}"  Style="{StaticResource CaptionLabelGrey}"/>
                          
                    <border:SfBorder   Margin="0"  Style="{StaticResource GreyBorderFrameWithShadow}" BorderWidth="1" BorderColor="{StaticResource DarkGrayTextColor}">
                        <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                            <Label Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentInputPlaceholder}" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>

                            <Image HorizontalOptions="EndAndExpand" Rotation="90">
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.Attachment}"/>
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAttachmentClicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAttachmentClicked"/>
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </border:SfBorder>

                    <StackLayout Orientation="Horizontal" Padding="0,10,0,10">
                        <ListView  x:Name="Attachmentlist" HeightRequest="300"
           ItemsSource="{Binding ZakatReturnAttachmentsList}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
            VerticalScrollBarVisibility="Never"
                      ItemTapped="Attachmentlist_ItemTapped"
                BackgroundColor="White"
            SeparatorVisibility="None"
            >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                                                                    <StackLayout  Padding="0,5,0,5" HorizontalOptions="FillAndExpand">

                                        <border:SfBorder  Margin="0"  Style="{StaticResource GreyBorderFrameWithShadow}" BorderWidth="1" BorderColor="{StaticResource DarkGrayTextColor}" >

                                            <StackLayout Orientation="Horizontal" Padding="0,10,0,10">
                                                <Image Source="{Binding FileImage}"  HeightRequest="25" WidthRequest="25" Margin="5">
                                                  
                                                </Image>

                                                <Label Text="{Binding Filename}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>

                                                <Image HorizontalOptions="EndAndExpand">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.Close}"/>
                                                    </Image.Source>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClickedTapped"/>
                                                    </Image.GestureRecognizers>
                                                </Image>


                                            </StackLayout>

                                        </border:SfBorder>
                                                                                                                                    </StackLayout>

                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </StackLayout>
                    <!--<custom:CustomLabel Margin="0,-5,0,0" Text="50MB max" Style="{StaticResource CaptionLabelGrey}"/>-->

                     </StackLayout>

                <!--End of Attachment Visible-->


            </StackLayout>

          

       </ScrollView>
             <!--Footer Section Starts-->
                    <StackLayout Grid.Row="2" BackgroundColor="White" Padding="10">
                        <!--<buttons:SfButton Text="{x:Static ResourceManager:AppResources.Save}" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />-->
                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZDone}" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />

                    </StackLayout>
                    <!--Footer Section Ends-->
              
</StackLayout>

    </yummy:PancakeView>

          <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.5" VerticalOptions="FillAndExpand" Margin="-30">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                        TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
            </Grid>

           </Grid>
</pages:PopupPage>