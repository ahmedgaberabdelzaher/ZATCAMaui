<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
 xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
 xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
         xmlns:ResourceManager="clr-namespace:EGAZT"
         TitleText="{x:Static ResourceManager:AppResources.Zakaty}"
    x:Class="EGAZT.Views.NewDesign.Zakaty.AboutZakatyView">
   <newdesign:BaseContentPage.PancakeView> 
        <ScrollView VerticalScrollBarVisibility="Never">
            <!--Body-->
            <StackLayout Margin="24">
                <!--#region ZAKAty Logo-->
                <Image Source="ZAKATyLogo" HeightRequest="50" WidthRequest="96" HorizontalOptions="CenterAndExpand" Margin="10,41,10,16"></Image>
                <!--#endregion-->
                       <!--#region About ZAKAty Title Label-->
                <Label Text="{x:Static ResourceManager:AppResources.About_Zakaty}" FontFamily="{StaticResource SomarRegular}" TextColor="#002447" FontSize="18"></Label>
                <!--#endregion-->
                   <!--#region About ZAKAty Description Label-->
               <Label  Text="{x:Static ResourceManager:AppResources.ZAKATYDesc}" TextColor="#002447" FontSize="16" FontFamily="{StaticResource SomarRegular}"></Label>
                <!--#endregion-->
                     <!--#region Move To Zakaty Portal View-->
                <Frame Padding="12" Margin="0,24,0,24" BackgroundColor="#0996D4" CornerRadius="14">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToZakatyPortalCommand}"></TapGestureRecognizer>
                    </Frame.GestureRecognizers>
                    <Label Text="{x:Static ResourceManager:AppResources.GoToZakatyPortal}"  FontSize="16" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"></Label>
                </Frame>
                <!--#endregion-->
                     <!--#region Store Links View -->
               <Label  Text="{x:Static ResourceManager:AppResources.DownloadApp}" TextColor="#002447" FontSize="16" FontFamily="{StaticResource SomarRegular}"></Label>
                <StackLayout Orientation="Horizontal">
                    <Image Source="AppleStore" HeightRequest="36">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToZakatyAppstoreCommand}"></TapGestureRecognizer>

                        </Image.GestureRecognizers>

                    </Image>
                    <Image Source="GooglePlay" HeightRequest="36">
                           <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToZakatyPlayStoreCommand}"></TapGestureRecognizer>

                        </Image.GestureRecognizers>

                    </Image>
                </StackLayout>
                <!--#endregion-->
            </StackLayout>

        </ScrollView>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

