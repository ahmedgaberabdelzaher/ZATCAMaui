<?xml version="1.0" encoding="utf-8"?>

<pages:PopupPage
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    x:Class="EGAZT.Views.NewDesign.ContractReleasePages.ContractReleaseInfoPopup">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

     <yummy:PancakeView BackgroundColor="White" CornerRadius="15,15,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="End"
                       IsVisible="true">
        <Grid BackgroundColor="Transparent" VerticalOptions="End" HorizontalOptions="FillAndExpand" Margin="24,8,24,0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <BoxView Grid.Row="0" Style="{StaticResource NeutralGrayBoxViewDrag}" HorizontalOptions="Center" VerticalOptions="Start" />
            
            <custom:CustomLabel Grid.Row="1" Text="{Binding InfoTitle}"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource SectionTitleBlackBold}" Margin="0,0,0,16" />
            
            <border:SfBorder Grid.Row="2" BorderColor="#B1B1B1" BorderWidth="1" Margin="0,0,0,10"
                             Style="{StaticResource GreyBorderFrame}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" Source="ic_vat_info.png" HorizontalOptions="Start"
                               VerticalOptions="Center" />
                        <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding InfoTitle,StringFormat='{0}'}"
                                            Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />
                    
                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding InfoDesc}"
                                                                                                                                                                                                                                                                                                                                                                                        HorizontalOptions="StartAndExpand"
                                                                                                                                                                                                                                                                                                                                                                                        Style="{StaticResource CaptionLabelGrey}" />

                </Grid>
            </border:SfBorder>
            
            <buttons:SfButton Grid.Row="3" Margin="0,24,0,24"
                              Command="{Binding ContractInstructionsClicked}"
                              Text="{x:Static ResourceManager:AppResources.CRDone}"
                              Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </yummy:PancakeView>

</pages:PopupPage>