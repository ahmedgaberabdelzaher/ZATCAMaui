<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             x:Class="EGAZT.Views.NewDesign.ContractReleasePages.ContractReleasePageView"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                       
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ContractRelease}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}"
                               Text="{DynamicResource StyleReverseBack}" TextColor="White"
                               IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource IconLabelStyle}" TextColor="White"
                               Text="{StaticResource Close}" VerticalOptions="CenterAndExpand"
                               HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

                <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
           
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand"/>
                </Grid>

            <Grid Grid.Row="1">
                <!--Release Contract 1-->

                <Grid IsVisible="{Binding IsReleaseDetailsVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,5,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.CRReleaseDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                            Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.CRNameOnContract}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry x:Name="ContractNameText" Unfocused="ContractNameUnfocused"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                        </border:SfBorder>
                        
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.CRContractNumber}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry x:Name="ContractNumberText"
                                                    Unfocused="ContractNumberUnfocused"
                                                    HorizontalOptions="FillAndExpand" Keyboard="Numeric"
                                                    Style="{StaticResource BodyLabelBlack}" />
                        </border:SfBorder>

                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.CRContractType}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding PickedContract}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                            

                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowPicker}"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            
                            </Grid>
                        </border:SfBorder>

                    </Grid>
                    <Grid Grid.Row="4" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.CRContractStartDate}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding FromDate,StringFormat='{0:dd MMM yyyy}'}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                            
                            <Image Grid.Row="0" Margin="5,0,5,0" Grid.Column="1" HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                     Glyph="{x:Static FontImage:IconFonts.Calendar}" />
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowStartDatePicker}"/>
                                </Image.GestureRecognizers>
                            </Image>

                            </Grid>
                        </border:SfBorder>

                    </Grid>
                    <Grid Grid.Row="5" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.CRContractEndDate}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                  
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding ToDate,StringFormat='{0:dd MMM yyyy}'}"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />
                            
                            <Image Grid.Row="0" Margin="5,0,5,0" Grid.Column="1" HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                     Glyph="{x:Static FontImage:IconFonts.Calendar}" />
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowEndDatePicker}"/>
                                </Image.GestureRecognizers>
                            </Image>

                            </Grid>
                        </border:SfBorder>

                    </Grid>
                    <Grid Grid.Row="6" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.CRTotalAmountOfContract}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry x:Name="ContractTotalAmountText" Text="{Binding ContractTotalAmount,StringFormat='{0:0}'}"
                                                     HorizontalOptions="FillAndExpand" Unfocused="TotalAmountUnFocused" 
                                                     Style="{StaticResource BodyLabelBlack}" Keyboard="Numeric" />
                        </border:SfBorder>

                    </Grid>
                    <Grid Grid.Row="7" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            Text="{x:Static ResourceManager:AppResources.CRAmountRequiredToRelease}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <custom:BorderlessEntry x:Name="AmountoReleaseTxt" Text="{Binding AmountToRelease,StringFormat='{0:0}'}"
                                                    HorizontalOptions="FillAndExpand" Unfocused="AmountToReleaseUnfocused"
                                                    Style="{StaticResource BodyLabelBlack}" Keyboard="Numeric" />
                        </border:SfBorder>

                    </Grid>

                    <cards:SfCardView Grid.Row="8" Margin="0,10,0,10" HasShadow="True" Padding="10" CornerRadius="20">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" 
                                                Text="{x:Static ResourceManager:AppResources.CRContractprofitEstimatedRate}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="0,0,0,10"
                                                Style="{StaticResource ValueLabelBlack}" />
                            
                            <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                     Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                </Image.Source>
                                
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ContractProfitPercentCommand}"/>
                                </Image.GestureRecognizers>

                            </Image>
                            
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRPercentage}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                Text="{Binding PickedContractPercent,StringFormat='{0} %'}"
                                                Margin="0,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                        </Grid>

                    </cards:SfCardView>
                    
                    <cards:SfCardView Grid.Row="9" Margin="0,10,0,10" HasShadow="True" Padding="10" CornerRadius="20">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" 
                                                Text="{x:Static ResourceManager:AppResources.CRProfitEstimatedForContract}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="0,0,0,10"
                                                Style="{StaticResource ValueLabelBlack}" />

                            <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                     Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ProfitEstimatedContractCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                            
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRAmount}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                Text="{Binding ProfitEstimatedContract,StringFormat='{0:N} SAR'}"
                                                Margin="0,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                        </Grid>

                    </cards:SfCardView>

                    <cards:SfCardView Grid.Row="10" Margin="0,10,0,10" HasShadow="True" Padding="10" CornerRadius="20">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" 
                                                    Text="{x:Static ResourceManager:AppResources.CREstimatedProfitforZakat}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Margin="0,0,0,10"
                                                    Style="{StaticResource ValueLabelBlack}" />

                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                         Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding EstimatedProfitZakatCommand}"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                            
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRAmount}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="1" Grid.Column="1"
                                                Text="{x:Static ResourceManager:AppResources.CRPercentage}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                Text="{Binding EstimatedProfitForZakatAmount,StringFormat='{0:N} SAR'}"
                                                Margin="0,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="1"
                                                Text="{Binding EstimatedProfitForZakatPercent,StringFormat='{0} %'}"
                                                Margin="0,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                        </Grid>

                    </cards:SfCardView>

                    <cards:SfCardView Grid.Row="11" Margin="0,10,0,10" HasShadow="True" Padding="10" CornerRadius="20">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" 
                                                    Text="{x:Static ResourceManager:AppResources.CREstimatedProfitforTax}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Margin="0,0,0,10"
                                                    Style="{StaticResource ValueLabelBlack}" />

                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                         Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding EstimatedProfitTaxCommand}"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRAmount}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="1" Grid.Column="1"
                                                Text="{x:Static ResourceManager:AppResources.CRPercentage}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                Text="{Binding EstimatedProfitForTaxAmount,StringFormat='{0:N} SAR'}"
                                                Margin="0,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="1"
                                                Text="{Binding EstimatedProfitForTaxPercent,StringFormat='{0} %'}"
                                                Margin="0,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                        </Grid>

                    </cards:SfCardView>

                    <cards:SfCardView Grid.Row="12" Margin="0,10,0,10" HasShadow="True" Padding="10" CornerRadius="20">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRTheValueofZakatdues}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="0,0,0,10"
                                                Style="{StaticResource ValueLabelBlack}" />

                            <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                     Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ValueofZakatDuesCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                            
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRAmount}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                Text="{Binding ZakatDues,StringFormat='{0:N} SAR'}"
                                                Margin="0,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                        </Grid>

                    </cards:SfCardView>
                    
                    <cards:SfCardView Grid.Row="13" Margin="0,10,0,10" HasShadow="True" Padding="10" CornerRadius="20">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRTheValueTaxDues}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="0,0,0,10"
                                                Style="{StaticResource ValueLabelBlack}" />

                            <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                     Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                </Image.Source>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ValueofTaxDuesCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                            
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRAmount}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />

                            <custom:CustomLabel Grid.Row="2" Grid.Column="0"
