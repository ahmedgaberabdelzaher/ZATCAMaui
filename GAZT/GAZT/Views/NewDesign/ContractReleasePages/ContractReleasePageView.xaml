                                        <custom:CustomLabel Grid.Column="1" Text="{Binding PickedContract}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRContractPeriod}" Style="{StaticResource ValueLabelGrey}"/>
                                        <Label Grid.Column="1" FontSize="14" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <FormattedString.Spans>
                                                        <Span Text="{Binding FromDate,StringFormat='{0:MMM yyyy}'}"  />
                                                        <Span Text=" - "  />
                                                        <Span Text="{Binding ToDate,StringFormat='{0:MMM yyyy}'}"  />
                                                    </FormattedString.Spans>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTotalAmountOfContract}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ContractTotalAmount,StringFormat='{0:N} SAR'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRAmountRequiredToRelease}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding AmountToRelease,StringFormat='{0:N} SAR'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>

                                </StackLayout>
                            </StackLayout>

                        </border:SfBorder>

                        <Frame CornerRadius="10" BackgroundColor="#E6EFED" HasShadow="False">
                            <StackLayout Orientation="Horizontal">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CRTotalDues}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}"
                                                    VerticalTextAlignment="Center" />

                                <custom:CustomLabel Text="{Binding TotalDues,StringFormat='{0:N} SAR'}" HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    VerticalTextAlignment="Center" />

                            </StackLayout>
                        </Frame>

                        <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="ic_attachment" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRAttachments}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label 
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToAttachments}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15,15,15,0">
                                    
                                    <listView:SfListView  Grid.Row="0" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" 
                                                          ItemsSource="{Binding ContractCopyAttachmentsListViewData}" SelectionMode="None" SelectionBackgroundColor="Transparent">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                               
                                                    <StackLayout Orientation="Horizontal">
                                                        <Label Text="{x:Static ResourceManager:AppResources.CRAttachContract}"
                                                               HorizontalOptions="StartAndExpand"
                                                               Style="{StaticResource BodyLabelGrey}" />
                                                        
                                                        <Label Text="{Binding Filename}"
                                                               HorizontalOptions="End"
                                                               Style="{StaticResource BodyLabelBlack}" />
                                                    </StackLayout>
                                              
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                    
                                    <listView:SfListView  Grid.Row="1" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center"
                                      ItemsSource="{Binding InvoiceAttachmentsListViewData}" SelectionMode="None" SelectionBackgroundColor="Transparent">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                    <StackLayout Orientation="Horizontal">
                                                        <Label Text="{x:Static ResourceManager:AppResources.CRAttachInvoiceCopy}"
                                                               HorizontalOptions="StartAndExpand"
                                                               Style="{StaticResource BodyLabelGrey}" />
                                                   
                                                        <Label Text="{Binding Filename}"
                                                               HorizontalOptions="End"
                                                               Style="{StaticResource BodyLabelBlack}" />
                                                    </StackLayout>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>

                                    <StackLayout Grid.Row="2" Orientation="Horizontal">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRRemarks}"
                                               HorizontalOptions="StartAndExpand"
                                               Style="{StaticResource BodyLabelGrey}" />

                                    
                                        <Label Text="{Binding Remarks}"
                                               HorizontalOptions="End"
                                               Margin="5,0,0,0"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </StackLayout>

                                    <StackLayout Grid.Row="3" Orientation="Horizontal">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRDetailDescription}"
                                               HorizontalOptions="StartAndExpand"
                                               Style="{StaticResource BodyLabelGrey}" />
                                        
                                        <Label Text="{Binding DetailDescription}"
                                               HorizontalOptions="End"
                                               Margin="5,0,0,0"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </StackLayout>

                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                        <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRDeclaration}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label 
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToDeclaration}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15,15,15,0">
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRContactPersonName}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ContactPersonName}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRDesignation}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding Designation}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                        <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">
                            
                            <StackLayout Padding="15,15,15,0">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0">
                                        <Image >
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                            </Image.Source>

                                        </Image>
                                    </Grid>

                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRInformation}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </Grid>
                                </Grid>

                                <Label Text="{x:Static ResourceManager:AppResources.CRIherebycertify}"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Start"
                                       Style="{StaticResource BodyLabelGrey}" />

                            </StackLayout>

                        </border:SfBorder>

                        <buttons:SfButton Margin="0,16,0,16"
                                          Text="{x:Static ResourceManager:AppResources.Confirm}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding SummaryConBtnTapped}" />

                    </StackLayout>
                </Grid>

                <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                 Opacity="0.4" VerticalOptions="FillAndExpand" />
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                 Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                           EnableAnimation="True"
                                                           AnimationType="SingleCircle"
                                                           HorizontalOptions="CenterAndExpand"
                                                           VerticalOptions="CenterAndExpand"
                                                           IsBusy="True"
                                                           ViewBoxWidth="70"
                                                           TitlePlacement="Bottom"
                                                           ViewBoxHeight="70"
                                                           TextColor="#D99A29" />
                            <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
                </Grid>
        </ScrollView>

    </ContentPage.Content>

</ContentPage>