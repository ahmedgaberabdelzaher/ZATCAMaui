<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
           xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             x:Class="EGAZT.Views.NewDesign.ContractReleasePages.ContractReleasePageView"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ContractRelease}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <Image  Grid.Row="0" Grid.Column="2"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"
                               Source="close"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}"/>
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <commonView:PageIndicatorView Margin="20,32,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand" DotSize="16"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid IsVisible="{Binding IsReleaseDetailsVisible}" BackgroundColor="Transparent" Margin="20,0,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" RowSpacing="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="128" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="56" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.CRRequestDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                            Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />
                                <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            </Grid>

                            <Grid Grid.Row="1" WidthRequest="171">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>


                                <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractonName}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry x:Name="ContractNameText" Unfocused="ContractNameFiledUnfocused"
                                                    HorizontalOptions="FillAndExpand" 
                                                            TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="15"/>
                                </border:SfBorder>

                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractNumber}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry x:Name="ContractNumberText"
                                                    Unfocused="ContractNumberUnfocused"
                                                    TextChanged="OnTextChanged"
                                                    HorizontalOptions="FillAndExpand" Keyboard="Numeric"
                                                    TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="15"/>
                                </border:SfBorder>

                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractType}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding PickedContract}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />


                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowPicker}"/>
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Grid>
                                </border:SfBorder>

                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical"  >

                                    <buttons:SfChipGroup x:Name="ChipGroup_statusFilter"  Type="Choice"  HorizontalOptions="Start"  ChipBackgroundColor="Transparent"                                         ItemsSource="{Binding ChipDataFilterlist}" SelectedChipBackgroundColor="#F9F0DF"  ChipBorderColor="{StaticResource NeutralLightGrey}"  ChipBorderWidth="1" SelectionChanged="ChipGroup_statusFilter_SelectionChanged" VerticalOptions="Center" >
                                        <buttons:SfChipGroup.ItemTemplate>
                                            <DataTemplate >
                                                <StackLayout WidthRequest="80" >
                                                    <custom:CustomLabel Text="{Binding Text}" StyleId="OnBoardText" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Style="{StaticResource CaptionLabelBlack}"/>
                                                </StackLayout>
                                            </DataTemplate>
                                        </buttons:SfChipGroup.ItemTemplate>
                                    </buttons:SfChipGroup>

                                    <custom:CustomLabel 
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.CRContractStartDate}"  />
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                </StackLayout>


                                <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding FromDate}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />

                                        <Image Grid.Row="0" Margin="5,0,5,0" Grid.Column="1" HorizontalOptions="Center" HeightRequest="24" WidthRequest="24">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                     Glyph="{x:Static FontImage:IconFonts.Calendar}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="NormalCalendar_Tapped" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Grid>
                                </border:SfBorder>

                                <custom1:CustomDatePicker 
                                    FlowDirection="LeftToRight"                
                                    Style="{StaticResource PickerStyle}" 
                                    Margin="2" 
                                    HeaderBackgroundColor="Aqua"
                                    x:Name="NormalCalendar"
                                    SelectedItemFontSize="15"
                                    SelectionChanged="NormalCalendar_SelectionChanged"      
                                    ItemHeight="36"                                                    
                                    PickerMode="Dialog"
                                    ColumnHeaderHeight="46"
                                    ShowFooter="False"
                                    BorderColor="Black"
                                    ShowHeader="False"
                                    BackgroundColor="White"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    ColumnHeaderBackgroundColor="White"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    OKButtonTextColor="#006450"    
                                    CancelButtonTextColor="#006450"
                                    HeaderText="{x:Static 
                                    ResourceManager:AppResources.CRContractStartDate}"
                                    Closed="NormalCalendar_Closed"
                                    SelectedItem="{Binding TodayDateStart}"
                                    OkButtonClicked="NormalCalendar_OkButtonClicked"       
                                    CancelButtonClicked="NormalCalendar_CancelButtonClicked"
                                    HorizontalOptions="FillAndExpand"
                                    ShowColumnHeader="True">
                                    <custom1:CustomDatePicker.Behaviors>
                                        <custom1:SfPickerBehavior />
                                    </custom1:CustomDatePicker.Behaviors>
                                </custom1:CustomDatePicker>

                                <!--HijriDatePicker-->

                                <custom1:CustomHijriDatePicker 
                                    FlowDirection="LeftToRight" 
                                    Style="{StaticResource PickerStyle}" 
                                    Margin="2" 
                                    HeaderBackgroundColor="Aqua"
                                    x:Name="HijriCalendar"
                                    SelectedItemFontSize="15"
                                    SelectionChanged="NormalCalendar_SelectionChanged"
                                    ItemHeight="36"
                                    PickerMode="Dialog"
                                    ColumnHeaderHeight="46"
                                    ShowFooter="False"
                                    BorderColor="Black"
                                    ShowHeader="False"
                                    BackgroundColor="White"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    ColumnHeaderBackgroundColor="White"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    OKButtonTextColor="#006450"    
                                    CancelButtonTextColor="#006450"
                                    HeaderText="{x:Static 
                                    ResourceManager:AppResources.CRContractStartDate}"
                                    Closed="NormalCalendar_Closed"
                                    SelectedItem="{Binding TodayDateinHijriStart}"
                                    OkButtonClicked="NormalCalendar_OkButtonClicked"       
                                    CancelButtonClicked="NormalCalendar_CancelButtonClicked"
                                    HorizontalOptions="FillAndExpand"
                                    ShowColumnHeader="True">
                                </custom1:CustomHijriDatePicker>
                            </Grid>
                            <Grid Grid.Row="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractEndDate}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding ToDate}"
                                                HorizontalOptions="FillAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />

                                        <Image Grid.Row="0" Margin="5,0,5,0" Grid.Column="1" HorizontalOptions="Center" HeightRequest="24" WidthRequest="24">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                     Glyph="{x:Static FontImage:IconFonts.Calendar}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="EndNormalCalendar_Tapped" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Grid>
                                </border:SfBorder>
                                <custom1:CustomDatePicker 
                                    FlowDirection="LeftToRight" 
                                    Style="{StaticResource PickerStyle}" 
                                    Margin="2" 
                                    HeaderBackgroundColor="Aqua"
                                    x:Name="EndDateNormalCalendar"
                                    SelectedItemFontSize="15"
                                    SelectionChanged="EndDateNormalCalendar_SelectionChanged"
                                    ItemHeight="36"
                                    PickerMode="Dialog"
                                    ColumnHeaderHeight="46"
                                    ShowFooter="False"
                                    BorderColor="Black"
                                    ShowHeader="False"
                                    BackgroundColor="White"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    ColumnHeaderBackgroundColor="White"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    OKButtonTextColor="#006450"    
                                    CancelButtonTextColor="#006450"
                                    HeaderText="{x:Static 
                                    ResourceManager:AppResources.CRContractStartDate}"
                                    Closed="EndDateNormalCalendar_Closed"
                                    SelectedItem="{Binding TodayDateEnd}"
                                    OkButtonClicked="EndDateNormalCalendar_OkButtonClicked"       
                                    CancelButtonClicked="EndDateNormalCalendar_CancelButtonClicked"
                                    HorizontalOptions="FillAndExpand"
                                    ShowColumnHeader="True">

                                    <custom1:CustomDatePicker.Behaviors>
                                        <custom1:SfPickerBehavior />
                                    </custom1:CustomDatePicker.Behaviors>
                                </custom1:CustomDatePicker>

                                <!--HijriDatePicker-->

                                <custom1:CustomHijriDatePicker 
                                    
                                    FlowDirection="LeftToRight" 
                                    Style="{StaticResource PickerStyle}" 
                                    Margin="2" 
                                    HeaderBackgroundColor="Aqua"
                                    x:Name="EndDateHijriCalendar"
                                    SelectedItemFontSize="15"
                                    SelectionChanged="EndDateNormalCalendar_SelectionChanged"
                                    ItemHeight="36"
                                    PickerMode="Dialog"
                                    ColumnHeaderHeight="46"
                                    ShowFooter="False"
                                    BorderColor="Black"
                                    ShowHeader="False" 
                                    BackgroundColor="White"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    ColumnHeaderBackgroundColor="White"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    OKButtonTextColor="#006450"    
                                    CancelButtonTextColor="#006450"
                                    HeaderText="{x:Static 
                                    ResourceManager:AppResources.CRContractStartDate}"
                                    Closed="EndDateNormalCalendar_Closed"
                                    SelectedItem="{Binding TodayDateinHijriEnd}"
                                    OkButtonClicked="EndDateNormalCalendar_OkButtonClicked"       
                                    CancelButtonClicked="EndDateNormalCalendar_CancelButtonClicked"
                                    HorizontalOptions="FillAndExpand"
                                    ShowColumnHeader="True">

                                </custom1:CustomHijriDatePicker>
                            </Grid>
                            <Grid Grid.Row="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRTotalAmountOfContract}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry x:Name="ContractTotalAmountText"
                                                     HorizontalOptions="FillAndExpand" Unfocused="TotalAmountUnFocused" 
                                                     TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="15"
                                                            Keyboard="Numeric" />
                                </border:SfBorder>

                            </Grid>
                            <Grid Grid.Row="7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRAmountRequiredToRelease}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2"  Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry x:Name="AmountoReleaseTxt" 
                                                    HorizontalOptions="FillAndExpand" Unfocused="AmountToReleaseUnfocused"
                                                    TextColor="{StaticResource NeutralBlack}" FontFamily="{StaticResource SSTArRoman}" FontSize="15"
                                                            Keyboard="Numeric" />
                                </border:SfBorder>

                            </Grid>

                            <cards:SfCardView Grid.Row="8"  HasShadow="True" Padding="10" CornerRadius="20">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" 
                                                Text="{x:Static ResourceManager:AppResources.CRContractprofitEstimatedRate}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource BodyLabelBlackMedium}" />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                     Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                        </Image.Source>

                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ContractProfitPercentCommand}"/>
                                        </Image.GestureRecognizers>

                                    </Image>

                                    <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRPercentage}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}" />

                                    <custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                Text="{Binding PickedContractPercent,StringFormat='{0} %'}"
                                                Margin="10,-10,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}" />

                                </Grid>

                            </cards:SfCardView>

                            <cards:SfCardView Grid.Row="9"  HasShadow="True" Padding="10" CornerRadius="20">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" 
                                                Text="{x:Static ResourceManager:AppResources.CRProfitEstimatedForContract}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource BodyLabelBlackMedium}"
                                                />

                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                     Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ProfitEstimatedContractCommand}"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRAmount}"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource CaptionLabelGrey}" />
                                    <custom:CustomLabel  HorizontalOptions="StartAndExpand" Grid.Row="2" Grid.Column="0" Margin="10,-10,0,0" Style="{StaticResource SectionTitleBlackBold}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding ProfitEstimatedContract,Converter={StaticResource commaSeparatorConverter}}"  ></Span>
                                                <Span Text="&#160;" ></Span>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"   ></Span>
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                </Grid>

                            </cards:SfCardView>

                            <cards:SfCardView Grid.Row="10"  HasShadow="True" Padding="10" CornerRadius="20">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />

                                    </Grid.RowDefinitions>


                                    <Grid Grid.Row="0">
