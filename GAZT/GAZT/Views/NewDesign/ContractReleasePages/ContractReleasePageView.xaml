                                                            </Grid.ColumnDefinitions>
                                                            <StackLayout Grid.Row="0" Grid.Column="0">
                                                                <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.CRAttachContract}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="0" Grid.Column="1">
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding Filename}" />
                                                            </StackLayout>
                                                        </Grid>

                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>

                                            <listView:SfListView
                                                Grid.Row="1"
                                                AutoFitMode="Height"
                                                HorizontalOptions="Center"
                                                IsScrollBarVisible="False"
                                                IsScrollingEnabled="False"
                                                ItemsSource="{Binding InvoiceAttachmentsListViewData}"
                                                SelectionBackgroundColor="Transparent"
                                                SelectionMode="None"
                                                VerticalOptions="Center">
                                                <listView:SfListView.ItemTemplate>
                                                    <DataTemplate>

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackLayout Grid.Row="0" Grid.Column="0">
                                                                <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.CRAttachInvoiceCopy}" />
                                                            </StackLayout>
                                                            <StackLayout Grid.Row="0" Grid.Column="1">
                                                                <custom:CustomLabel
                                                                    HorizontalOptions="EndAndExpand"
                                                                    HorizontalTextAlignment="End"
                                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                                    Text="{Binding Filename}" />
                                                            </StackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </listView:SfListView.ItemTemplate>
                                            </listView:SfListView>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel
                                                    Grid.Column="0"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.CRRemarks}" />
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding Remarks}" />
                                            </Grid>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel
                                                    Grid.Column="0"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.CRDetailDescription}" />
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding DetailDescription}" />
                                            </Grid>
                                        </StackLayout>
                                    </StackLayout>
                                </border:SfBorder>

                                <border:SfBorder
                                    Margin="0,16,0,10"
                                    Padding="0,0,0,16"
                                    HasShadow="False"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">

                                    <StackLayout Orientation="Vertical">

                                        <Grid Padding="15" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="Transparent"
                                           HasShadow="False" />-->

                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Center"
                                                    Source="declaration_blue"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />
                                                <Label
                                                    Padding="8,0"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.CRDeclaration}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="0,0"
                                                HorizontalOptions="End">
                                                <Label
                                                    FontSize="Medium"
                                                    Style="{StaticResource GAZTCaptioSecondarylStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.CREdit}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding GoBackToDeclaration}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>

                                        <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                        <StackLayout Padding="15,15,15,0">

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel
                                                    Grid.Column="0"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.CRContactPersonFullName}" />
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding ContactPersonName}" />
                                            </Grid>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel
                                                    Grid.Column="0"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    Text="{x:Static ResourceManager:AppResources.CRDesignation}" />
                                                <custom:CustomLabel
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    HorizontalTextAlignment="End"
                                                    Style="{StaticResource SectionTitleSmallMediumBlack}"
                                                    Text="{Binding Designation}" />
                                            </Grid>

                                        </StackLayout>
                                    </StackLayout>
                                </border:SfBorder>

                                <border:SfBorder
                                    Margin="0,16,0,10"
                                    Padding="0,0,0,16"
                                    HasShadow="False"
                                    Style="{StaticResource GreyBorderFrameWithShadow}">

                                    <StackLayout Padding="15,15,15,0" VerticalOptions="FillAndExpand">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                VerticalOptions="CenterAndExpand">
                                                <Image>
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="UserIconFont"
                                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                            Size="24"
                                                            Color="{StaticResource Primary}" />
                                                    </Image.Source>

                                                </Image>
                                            </Grid>

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                VerticalOptions="CenterAndExpand">
                                                <Label
                                                    HorizontalOptions="Start"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.CRInformation}" />
                                            </Grid>
                                        </Grid>

                                        <Label
                                            HorizontalOptions="Start"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.CRIherebycertify}"
                                            VerticalOptions="Start" />

                                    </StackLayout>

                                </border:SfBorder>

                                <buttons:SfButton
                                    Margin="0,16,0,16"
                                    Command="{Binding SummaryConBtnTapped}"
                                    HeightRequest="48"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.Confirm}"
                                    WidthRequest="366" />

                            </StackLayout>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollView>

            <Grid
                x:Name="Loadingbar"
                BackgroundColor="Transparent"
                IsVisible="{Binding IsLoading1}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>

    </ContentPage.Content>

</ContentPage>