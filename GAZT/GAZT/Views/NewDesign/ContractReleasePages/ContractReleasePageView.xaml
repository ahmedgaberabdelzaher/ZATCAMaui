                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding SummaryConBtnTapped}" />

                    </StackLayout>
                </Grid>

            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>