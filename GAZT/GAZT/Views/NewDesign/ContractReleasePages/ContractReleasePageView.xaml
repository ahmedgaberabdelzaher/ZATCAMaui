<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ContractReleasePages.ContractReleasePageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ContractRelease}" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Image
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="24"
                            HorizontalOptions="EndAndExpand"
                            Source="close"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <commonView:PageIndicatorView
                            Margin="20,32,20,0"
                            Completed="{Binding MarkComplete}"
                            DotSize="12"
                            HorizontalOptions="End"
                            MaxNum="{Binding MaxIndex}"
                            MinNum="{Binding CurrentIndex}"
                            VerticalOptions="CenterAndExpand" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid
                            Margin="20,0,20,0"
                            BackgroundColor="Transparent"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsReleaseDetailsVisible}"
                            RowSpacing="24"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="128" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource SectionTitleBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.CRRequestDetails}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,5,0,15"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" />
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                            </Grid>

                            <Grid Grid.Row="1" WidthRequest="171">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>


                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractonName}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry
                                        x:Name="ContractNameText"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HorizontalOptions="FillAndExpand"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="ContractNameFiledUnfocused" />
                                </border:SfBorder>

                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractNumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry
                                        x:Name="ContractNumberText"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HorizontalOptions="FillAndExpand"
                                        Keyboard="Numeric"
                                        TextChanged="OnTextChanged"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="ContractNumberUnfocused" />
                                </border:SfBorder>

                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractType}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding PickedContract}" />


                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="Center">
                                            <Image.Source>

                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                    Size="28"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowPicker}" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Grid>
                                </border:SfBorder>

                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <StackLayout
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Vertical">

                                    <buttons:SfChipGroup
                                        x:Name="ChipGroup_statusFilter"
                                        ChipBackgroundColor="Transparent"
                                        ChipBorderColor="{StaticResource NeutralLightGrey}"
                                        ChipBorderWidth="1"
                                        HorizontalOptions="Start"
                                        ItemsSource="{Binding ChipDataFilterlist}"
                                        SelectedChipBackgroundColor="{StaticResource PartialBg}"
                                        SelectionChanged="ChipGroup_statusFilter_SelectionChanged"
                                        Type="Choice"
                                        VerticalOptions="Center">
                                        <buttons:SfChipGroup.ItemTemplate>
                                            <DataTemplate>
                                                <StackLayout WidthRequest="80">
                                                    <custom:CustomLabel
                                                        HorizontalOptions="FillAndExpand"
                                                        HorizontalTextAlignment="Center"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        StyleId="OnBoardText"
                                                        Text="{Binding Text}" />
                                                </StackLayout>
                                            </DataTemplate>
                                        </buttons:SfChipGroup.ItemTemplate>
                                    </buttons:SfChipGroup>

                                    <custom:CustomLabel HorizontalOptions="StartAndExpand" Style="{StaticResource ValueLabelBlack}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.CRContractStartDate}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                </StackLayout>


                                <border:SfBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding FromDate}" />

                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0,5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            WidthRequest="24">
                                            <Image.Source>

                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Calendar}"
                                                    Size="28"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="NormalCalendar_Tapped" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Grid>
                                </border:SfBorder>

                                <custom1:CustomDatePicker
                                    x:Name="NormalCalendar"
                                    Margin="2"
                                    BackgroundColor="White"
                                    BorderColor="Black"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    CancelButtonClicked="NormalCalendar_CancelButtonClicked"
                                    CancelButtonTextColor="{StaticResource Primary}"
                                    Closed="NormalCalendar_Closed"
                                    ColumnHeaderBackgroundColor="White"
                                    ColumnHeaderHeight="46"
                                    FlowDirection="LeftToRight"
                                    HeaderBackgroundColor="Aqua"
                                    HeaderText="{x:Static ResourceManager:AppResources.CRContractStartDate}"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="36"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    OKButtonTextColor="{StaticResource Primary}"
                                    OkButtonClicked="NormalCalendar_OkButtonClicked"
                                    PickerMode="Dialog"
                                    SelectedItem="{Binding TodayDateStart}"
                                    SelectedItemFontSize="15"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    SelectionChanged="NormalCalendar_SelectionChanged"
                                    ShowColumnHeader="True"
                                    ShowFooter="False"
                                    ShowHeader="False"
                                    Style="{StaticResource PickerStyle}">
                                    <custom1:CustomDatePicker.Behaviors>
                                        <custom1:SfPickerBehavior />
                                    </custom1:CustomDatePicker.Behaviors>
                                </custom1:CustomDatePicker>

                                <!--  HijriDatePicker  -->

                                <custom1:CustomHijriDatePicker
                                    x:Name="HijriCalendar"
                                    Margin="2"
                                    BackgroundColor="White"
                                    BorderColor="Black"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    CancelButtonClicked="NormalCalendar_CancelButtonClicked"
                                    CancelButtonTextColor="{StaticResource Primary}"
                                    Closed="NormalCalendar_Closed"
                                    ColumnHeaderBackgroundColor="White"
                                    ColumnHeaderHeight="46"
                                    FlowDirection="LeftToRight"
                                    HeaderBackgroundColor="Aqua"
                                    HeaderText="{x:Static ResourceManager:AppResources.CRContractStartDate}"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="36"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    OKButtonTextColor="{StaticResource Primary}"
                                    OkButtonClicked="NormalCalendar_OkButtonClicked"
                                    PickerMode="Dialog"
                                    SelectedItem="{Binding TodayDateinHijriStart}"
                                    SelectedItemFontSize="15"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    SelectionChanged="NormalCalendar_SelectionChanged"
                                    ShowColumnHeader="True"
                                    ShowFooter="False"
                                    ShowHeader="False"
                                    Style="{StaticResource PickerStyle}" />
                            </Grid>
                            <Grid Grid.Row="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRContractEndDate}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding ToDate}" />

                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0,5,0"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            WidthRequest="24">
                                            <Image.Source>

                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.Calendar}"
                                                    Size="28"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="EndNormalCalendar_Tapped" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Grid>
                                </border:SfBorder>
                                <custom1:CustomDatePicker
                                    x:Name="EndDateNormalCalendar"
                                    Margin="2"
                                    BackgroundColor="White"
                                    BorderColor="Black"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    CancelButtonClicked="EndDateNormalCalendar_CancelButtonClicked"
                                    CancelButtonTextColor="{StaticResource Primary}"
                                    Closed="EndDateNormalCalendar_Closed"
                                    ColumnHeaderBackgroundColor="White"
                                    ColumnHeaderHeight="46"
                                    FlowDirection="LeftToRight"
                                    HeaderBackgroundColor="Aqua"
                                    HeaderText="{x:Static ResourceManager:AppResources.CRContractStartDate}"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="36"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    OKButtonTextColor="{StaticResource Primary}"
                                    OkButtonClicked="EndDateNormalCalendar_OkButtonClicked"
                                    PickerMode="Dialog"
                                    SelectedItem="{Binding TodayDateEnd}"
                                    SelectedItemFontSize="15"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    SelectionChanged="EndDateNormalCalendar_SelectionChanged"
                                    ShowColumnHeader="True"
                                    ShowFooter="False"
                                    ShowHeader="False"
                                    Style="{StaticResource PickerStyle}">

                                    <custom1:CustomDatePicker.Behaviors>
                                        <custom1:SfPickerBehavior />
                                    </custom1:CustomDatePicker.Behaviors>
                                </custom1:CustomDatePicker>

                                <!--  HijriDatePicker  -->

                                <custom1:CustomHijriDatePicker
                                    x:Name="EndDateHijriCalendar"
                                    Margin="2"
                                    BackgroundColor="White"
                                    BorderColor="Black"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    CancelButtonClicked="EndDateNormalCalendar_CancelButtonClicked"
                                    CancelButtonTextColor="{StaticResource Primary}"
                                    Closed="EndDateNormalCalendar_Closed"
                                    ColumnHeaderBackgroundColor="White"
                                    ColumnHeaderHeight="46"
                                    FlowDirection="LeftToRight"
                                    HeaderBackgroundColor="Aqua"
                                    HeaderText="{x:Static ResourceManager:AppResources.CRContractStartDate}"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="36"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    OKButtonTextColor="{StaticResource Primary}"
                                    OkButtonClicked="EndDateNormalCalendar_OkButtonClicked"
                                    PickerMode="Dialog"
                                    SelectedItem="{Binding TodayDateinHijriEnd}"
                                    SelectedItemFontSize="15"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    SelectionChanged="EndDateNormalCalendar_SelectionChanged"
                                    ShowColumnHeader="True"
                                    ShowFooter="False"
                                    ShowHeader="False"
                                    Style="{StaticResource PickerStyle}" />
                            </Grid>
                            <Grid Grid.Row="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRTotalAmountOfContract}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry
                                        x:Name="ContractTotalAmountText"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HorizontalOptions="FillAndExpand"
                                        Keyboard="Numeric"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="TotalAmountUnFocused" />
                                </border:SfBorder>

                            </Grid>
                            <Grid Grid.Row="7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource ValueLabelBlack}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CRAmountRequiredToRelease}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Padding="10"
                                    Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry
                                        x:Name="AmountoReleaseTxt"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="15"
                                        HorizontalOptions="FillAndExpand"
                                        Keyboard="Numeric"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="AmountToReleaseUnfocused" />
                                </border:SfBorder>

                            </Grid>

                            <cards:SfCardView
                                Grid.Row="8"
                                Padding="10"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="20"
                                HasShadow="False">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelBlackMedium}"
                                        Text="{x:Static ResourceManager:AppResources.CRContractprofitEstimatedRate}" />

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                Size="24"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>

                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ContractProfitPercentCommand}" />
                                        </Image.GestureRecognizers>

                                    </Image>

                                    <custom:CustomLabel
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.CRPercentage}" />

                                    <custom:CustomLabel
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="10,-10,0,0"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlackBold}"
                                        Text="{Binding PickedContractPercent, StringFormat='{0} %'}" />

                                </Grid>

                            </cards:SfCardView>

                            <cards:SfCardView
                                Grid.Row="9"
                                Padding="10"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="20"
                                HasShadow="False">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

