<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.ContractReleasePages.ContractReleaseListPageView"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <custom:CustomLabel Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.NDContractReleaseRequest}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource IconLabelStyle}"
                               Text="{DynamicResource StyleReverseBack}" TextColor="White"
                               IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource IconLabelStyle}" TextColor="White"
                               Text="{StaticResource Close}" VerticalOptions="CenterAndExpand"
                               HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
           
            <Grid>
            
              <Grid IsVisible="{Binding IsContractListsVisible}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ContractRelease}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <!--<custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{Binding NumberOfInstalmentPlans}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>-->

                    </Grid>

                    <Grid Grid.Row="1"   BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <border:SfBorder Grid.Row="0" CornerRadius="15" Margin="0,20,0,0" HorizontalOptions="FillAndExpand" Padding="12" HasShadow="true" Style="{StaticResource GreyBorderFrameWithShadow}" >
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0" Grid.Column="0" Source="add" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start"></Image>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.CRRequestContractRelease}" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RequestContractReleaseBtnTapped}"></TapGestureRecognizer>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </border:SfBorder>
                        
                        <Grid Grid.Row="1" Margin="0,10,0,0"  BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            
                        <listView:SfListView Grid.Row="0" HorizontalOptions="CenterAndExpand" IsScrollBarVisible="False" Margin="0" Padding="0"
                                                  IsScrollingEnabled="False" VerticalOptions="Start" AutoFitMode="Height"  ItemSpacing="0" ItemTapped="ContractsList_ItemTapped" 
                                      ItemsSource="{Binding ContractListViewData}" SelectionMode="Single" SelectionBackgroundColor="Transparent">
                            
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <border:SfBorder Padding="10"  Grid.Column="0" CornerRadius="15" Margin="0,15,0,0" HasShadow="True" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <Grid Padding="0" RowSpacing="0" Margin="0">
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*"/>
                                                <ColumnDefinition Width="50*"/>
                                            </Grid.ColumnDefinitions>

                                               <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Vertical">
                                                <custom:CustomLabel    Text="{x:Static ResourceManager:AppResources.CRContractReleaseApplicationForm}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource SectionTitleBlack}" Margin="0,0,0,10" />

                                       
                                            </StackLayout>

                                           <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical">

                                                <Label  Text="{Binding Fbnum}" Style="{StaticResource ValueLabelGrey}" LineHeight="0.7" HorizontalTextAlignment="Start" 
                                                       HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"/>
                                               
                                            </StackLayout>
                                           <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand">
                                               

                                                <yummy:PancakeView Padding="8,3,8,3" CornerRadius="14" BorderThickness="1" BackgroundColor="#E5EFED"  VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" >
                                                    
                                                    <Label Style="{StaticResource CaptionLabelBlack}" TextColor="DarkGoldenrod" Text="{Binding StatText}" HorizontalTextAlignment="Center" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                        <Label.Triggers>

                                                             <DataTrigger TargetType="Label" Binding="{Binding StatText}" Value="{x:Static ResourceManager:AppResources.NDBilled}">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.NDBilled}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </yummy:PancakeView>
                                            </StackLayout>
                                        </Grid>
                                    </border:SfBorder>
                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>
                            
                    </Grid>
                </Grid>
                        
                    </Grid>
                
                <Grid IsVisible="{Binding SummaryVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                    <StackLayout Orientation="Vertical">

                        <Grid Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.CRSummary}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                                Text="{x:Static ResourceManager:AppResources.CRReviewthebelowinformation}"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <border:SfBorder Margin="0,16,0,10" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="establishments" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRReleaseDetails}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <!--<StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label 
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToReleaseDetails}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>-->
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <Grid Padding="15,15,15,0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                    <StackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="{x:Static ResourceManager:AppResources.CRContractonName}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                </StackLayout>
                                <StackLayout Grid.Row="0" Grid.Column="1" >
                                    <Label Text="{Binding ContractName}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                </StackLayout>
                                    <StackLayout Grid.Row="1" Grid.Column="0">
                                    <Label Text="{x:Static ResourceManager:AppResources.CRContractNumber}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                </StackLayout>
                                <StackLayout Grid.Row="1" Grid.Column="1" >
                                    <Label Text="{Binding ContractNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                </StackLayout>
                                   <StackLayout Grid.Row="2" Grid.Column="0">
                                    <Label Text="{x:Static ResourceManager:AppResources.CRContractType}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                </StackLayout>
                                <StackLayout Grid.Row="2" Grid.Column="1" >
                                    <Label Text="{Binding PickedContract}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                    </StackLayout>
                                    <StackLayout Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <Label Text="{x:Static ResourceManager:AppResources.CRContractPeriod}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="Start"/>
                               
                                     <Label Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <FormattedString.Spans>
                                                        <Span Text="{Binding FromDate,StringFormat='{0:MMM yyyy}'}"  />
                                                        <Span Text=" - "  />
                                                        <Span Text="{Binding ToDate,StringFormat='{0:MMM yyyy}'}"  />
                                                    </FormattedString.Spans>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                </StackLayout>

                                      <StackLayout Grid.Row="4" Grid.Column="0">
                                    <Label Text="{x:Static ResourceManager:AppResources.CRTotalAmountOfContract}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                </StackLayout>
                                <StackLayout Grid.Row="4" Grid.Column="1" >

                                    <custom:CustomLabel  HorizontalOptions="EndAndExpand">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding ContractTotalAmount}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                     </custom:CustomLabel>
                                </StackLayout>

                                  <StackLayout Grid.Row="5" Grid.Column="0">
                                    <Label Text="{x:Static ResourceManager:AppResources.CRAmountRequiredToRelease}" Style="{StaticResource BodyLabelGrey}" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                </StackLayout>
                                <StackLayout Grid.Row="5" Grid.Column="1" >
                                     <custom:CustomLabel  HorizontalOptions="EndAndExpand">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding AmountToRelease}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                     </custom:CustomLabel>
                                </StackLayout>
                                </Grid>
                            </StackLayout>

                        </border:SfBorder>

                         <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12" Margin="0,10,0,0" Padding="0">
                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,3,10,2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"></RowDefinition>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel  Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTheValueofZakatdues}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"  />
                                                         <custom:CustomLabel  HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="1">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding ZakatDues}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                    <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                    </Grid>
                           </Frame>

                        <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12" Margin="0,10,0,0" Padding="0">
                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,3,10,2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"></RowDefinition>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel  Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTheValueTaxDues}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" />
                                                        <custom:CustomLabel  HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="1">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding TaxDues}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                    <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                    </Grid>
                           </Frame>

                           <Frame HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12" Margin="0,10,0,0" Padding="0">
                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,3,10,2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"></RowDefinition>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel  Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRTotalDues}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" />
                                                         <custom:CustomLabel  HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="1">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding TotalDues}" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                    <Span Text="&#160;" Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"  Style="{StaticResource ValueLabelBlack}" ></Span>
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                    </Grid>
                           </Frame>

                        <border:SfBorder Margin="0,16,0,10" Padding="0,0,0,16" HasShadow="False"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Orientation="Vertical">

                                <Grid Padding="15" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center"
                                           Opacity=".2" IsClippedToBounds="True"
                                           BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                           HasShadow="False" />
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                                           Source="ic_attachment" />
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1"
                                                 Padding="8,0">
                                        <Label Text="{x:Static ResourceManager:AppResources.CRAttachments}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource SectionTitleBlackBold}" />
                                    </StackLayout>
                                    <!--<StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                        <Label 
                                               Text="{x:Static ResourceManager:AppResources.CREdit}"
                                               VerticalOptions="CenterAndExpand"
                                               Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToAttachments}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </StackLayout>-->
                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                               <StackLayout Padding="15,15,15,0">
    
                               <listView:SfListView  Grid.Row="0" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" 
                                                      ItemsSource="{Binding ContractCopyAttachmentsListViewData}" SelectionMode="None" SelectionBackgroundColor="Transparent" ItemTapped="SummaryAttachments_ItemTapped">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout Grid.Row="0" Grid.Column="0">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CRAttachContract}" Style="{StaticResource ValueLabelGrey}"/>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="0" Grid.Column="1" >
                                                        <custom:CustomLabel Text="{Binding Filename}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                                    </StackLayout>
                                                </Grid>
                
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
    
                                <listView:SfListView  Grid.Row="1" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height"
                                  ItemsSource="{Binding InvoiceAttachmentsListViewData}" SelectionMode="None" SelectionBackgroundColor="Transparent" ItemTapped="SummaryAttachments_ItemTapped">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
               
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CRAttachInvoiceCopy}" Style="{StaticResource ValueLabelGrey}"/>
                                                </StackLayout>
                                                <StackLayout Grid.Row="0" Grid.Column="1" >
                                                    <custom:CustomLabel Text="{Binding Filename}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                                </StackLayout>
                                            </Grid>
                                            </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
    
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRRemarks}" Style="{StaticResource ValueLabelGrey}"/>
                                    <custom:CustomLabel Grid.Column="1" Text="{Binding Remarks}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                </Grid>
    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRDetailDescription}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding DetailDescription}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                              </StackLayout>
                            </StackLayout>
                        </border:SfBorder>

                         <buttons:SfButton 
                                Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                            Clicked="Download_AcknowledgementForm"
                                CornerRadius="10" VerticalOptions="End" FontAttributes="Bold"
                                HeightRequest="46" Margin="10,20,10,20" FontSize="15" Grid.ColumnSpan="2"
