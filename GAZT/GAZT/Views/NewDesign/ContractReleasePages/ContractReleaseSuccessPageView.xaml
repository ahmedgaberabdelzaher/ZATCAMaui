<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             FlowDirection="RightToLeft"
             mc:Ignorable="d"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.ContractReleasePages.ContractReleaseSuccessPageView"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">

                <Image HeightRequest="120" WidthRequest="120"
                       HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"
                       Source="Forget_ic_success" />

                <Label Text="{x:Static ResourceManager:AppResources.ContractRelease}" HorizontalTextAlignment="Center" Style="{StaticResource PageTitleWhite}"/>
                <Label Text= "{x:Static ResourceManager:AppResources.CRYourContractisreleasedsuccessfully}" 
                        HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       Margin="0,16,0,0"
                       Style="{StaticResource BodyLabelWhite}"/>
            </StackLayout>
            <ScrollView>
                <Grid>
                    <yummy:PancakeView BackgroundColor="White" CornerRadius="20,20,0,0" Padding="20" 
                                   VerticalOptions="EndAndExpand">
                        <StackLayout>

                            <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="10,5,10,5"
                               HasShadow="False">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.CRReferenceNumber}"
                                                    VerticalOptions="Center" Style="{StaticResource CaptionLabelGrey}"
                                                    HorizontalOptions="Start" />

                                    <custom:CustomLabel x:Name="ReferenceNumberTxt" Grid.Row="0" Grid.Column="1"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End"
                                                        Style="{StaticResource ValueLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="2">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}" Size="25"
                                                         Glyph="{x:Static FontImage:IconFonts.ContentCopy}" />
                                        </Image.Source>
                                    </Image>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ReferenceNumberCopyTapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Frame>
                            <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="10,5,10,5"
                               HasShadow="False">
                                <Grid Padding="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.CRContractingNumber}"
                                                    VerticalOptions="Center"  Style="{StaticResource CaptionLabelGrey}"
                                                    HorizontalOptions="StartAndExpand" />

                                    <custom:CustomLabel x:Name="ContractNumberTxt" Grid.Row="0" Grid.Column="1" FontSize="15"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End"
                                                        Style="{StaticResource ValueLabelBlack}" />

                                    <Image Grid.Row="0" Grid.Column="2">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}" Size="25"
                                                         Glyph="{x:Static FontImage:IconFonts.ContentCopy}" />
                                        </Image.Source>
                                    </Image>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ContractNumberCopyTapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </Frame>
                            <buttons:SfButton 
                                Text="{x:Static ResourceManager:AppResources.ZDownloadForm}"
                            Clicked="Download_AcknowledgementForm"
                                CornerRadius="10" VerticalOptions="End" 
                                HeightRequest="48"
                                WidthRequest="366"
                                FontFamily="{StaticResource SomarBold}"
                                Margin="10,20,10,24" FontSize="15" Grid.ColumnSpan="2"
                                 BackgroundColor="{StaticResource Secondary}" TextColor="White" />


                            <custom:CustomLabel Margin="10,0,10,15"
                                            Text="{x:Static ResourceManager:AppResources.ContractRelease}"
                                            Style="{StaticResource BodyLabelSecondary}"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Dashboard_Tapped" />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>
                        </StackLayout>
                    </yummy:PancakeView>
                    <Grid IsVisible="{Binding IsLoading1}" BackgroundColor="Transparent">
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                     Opacity="0.4" VerticalOptions="FillAndExpand" />
                        <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                     Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                               EnableAnimation="True"
                                                               AnimationType="SingleCircle"
                                                               HorizontalOptions="CenterAndExpand"
                                                               VerticalOptions="CenterAndExpand"
                                                               IsBusy="True"
                                                               ViewBoxWidth="70"
                                                               TitlePlacement="Bottom"
                                                               ViewBoxHeight="70"
                                                               TextColor="{StaticResource Secondary}" />
                            </StackLayout>
                        </StackLayout>
                    </Grid>
                </Grid>
            </ScrollView>
        </StackLayout>

    </ContentPage.Content>
</ContentPage>