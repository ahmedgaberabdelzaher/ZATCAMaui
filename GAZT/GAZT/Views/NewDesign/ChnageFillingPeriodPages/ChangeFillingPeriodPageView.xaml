<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
            xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:local1="clr-namespace:EGAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             mc:Ignorable="d" FlowDirection="RightToLeft"    
              xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             x:Class="EGAZT.Views.NewDesign.ChangeFillingPeriod.ChangeFillingPeriodPageView" 
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--<DataTemplate x:Key="BillStatusFilterTemplate">
                <StackLayout>
                    <buttons:SfChip HeightRequest="40" WidthRequest="120" Text="{Binding Text}" BackgroundColor="White" TextColor="{StaticResource NeutralBlack}" ShowIcon="True" ImageSource="{Binding ImageSource}"  ShowCloseButton="False" ShowSelectionIndicator="False" ImageAlignment="Left" />
                </StackLayout>
            </DataTemplate>
            <local1:ChipDataTemplateSelector x:Key="selector" 
                                          
                                            SadEmojiTemplate = "{StaticResource BillStatusFilterTemplate}"/>-->
        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodTitle}" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Row="0" Grid.Column="2"  Style="{StaticResource IconLabelStyle}" TextColor="White" Text="{StaticResource Close}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <!-- List of Change filing Requests -->

              

                <Grid IsVisible="{Binding IsMyRequestsViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodMyRequests}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="1 VAT Change Filling Period Request" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                    </Grid>


                    <cards:SfCardView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0" Padding="12" HasShadow="False" BorderColor="Gray" BorderWidth="0.2" CornerRadius="15">

                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Row="0" Grid.Column="0" Source="ic_add1" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start"></Image>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodButtonText}" HorizontalOptions="StartAndExpand" Style="{StaticResource GAZTSmallGreenLabelStyle}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding MyRequestsButtonTapped}"> </TapGestureRecognizer>
                            </Grid.GestureRecognizers>
                        </Grid>

                       
                    </cards:SfCardView>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2">

                        <listView:SfListView x:Name="MyRequestsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding MyRequestsListViewData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <cards:SfCardView  Margin="0,15,0,0" Padding="7" HasShadow="False" BorderColor="Gray" BorderWidth="0.2" CornerRadius="15">
                                    
                                        <Grid Padding="0" Margin="10,5,10,0" ColumnSpacing="0" RowSpacing="0">
                                        
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="0" Orientation="Vertical" HorizontalOptions="StartAndExpand">

                                                <custom:CustomLabel Text="{Binding Title}" Style="{StaticResource SectionTitleBlackBold}"  HorizontalOptions="StartAndExpand" Margin="0" Padding="0"/>
                                                <custom:CustomLabel Text="{Binding ReferenceNumber}" HorizontalOptions="StartAndExpand" Margin="0" Padding="0"
                                                            Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>

                                            </StackLayout>


                                            <StackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                                <cards:SfCardView  CornerRadius="15" HasShadow="False" BackgroundColor="{StaticResource NeturalInProgress}"
                                                              BorderColor="Gold" BorderWidth="0.5" HorizontalOptions="Center" Padding="5" VerticalOptions="Center">
                                                    <custom:CustomLabel Text="{Binding Status}" HorizontalOptions="Center"
                                                        Style="{StaticResource GAZTSmallGoldLabelStyle}" FontAttributes="Bold"/>
                                                </cards:SfCardView>
                                            </StackLayout>

                                            <BoxView Grid.Row="1" Margin="0,8,0,8" Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                                            <StackLayout Grid.Row="2" Spacing="0" Grid.Column="0" Orientation="Vertical">
                                                <custom:CustomLabel Text="Current Frequency" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>
                                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" VerticalOptions="Start" Text="{Binding CurrentFrequency}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource ValueLabelBlackBold}" />
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Spacing="0" Grid.Column="1" Orientation="Vertical">
                                                <custom:CustomLabel Text="New Frequency" HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>
                                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" VerticalOptions="Start" Text="{Binding NewFrequency}" HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource ValueLabelBlackBold}" />

                                            </StackLayout>

                                            <StackLayout Grid.Row="3" Spacing="0" Grid.Column="0" Orientation="Vertical" Margin="0,0,0,20">
                                                <custom:CustomLabel Text="Effective Date" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>
                                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" VerticalOptions="Start" Text="{Binding EffectiveDate}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource ValueLabelBlackBold}" />
                                            </StackLayout>

                                            <StackLayout Grid.Row="3" Spacing="0" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,20">
                                                <custom:CustomLabel Text="Request Date" HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource GAZTSmallGrayLblMediumFont}"/>
                                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" VerticalOptions="Start" Text="{Binding ReleaseDate}" HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource ValueLabelBlackBold}" />

                                            </StackLayout>

                                        </Grid>
                                    </cards:SfCardView>

                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>

                    </Grid>


                </Grid>

              

                <!--Frequency Details screen-->

           
              
                <Grid IsVisible="{Binding IsFrequencyViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetailsSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                         <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                        <Frame Grid.Row="0" HasShadow="False"  HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Margin="10" Padding="10,3,10,3" VerticalOptions="FillAndExpand">
                            <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="0,5,0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelGrey}" Margin="0" Padding="0"/>
                                <custom:CustomLabel Grid.Row="1" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetMonthly}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlackBold}" Margin="0" Padding="0" />
                            </Grid>
                        </Frame>

                          <Frame Grid.Row="0" Grid.Column="1" HasShadow="False" Margin="10" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3" VerticalOptions="FillAndExpand">
                            <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="0,5,0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" VerticalOptions="Start" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelGrey}"/>
                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" VerticalOptions="Start" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetQuarterly}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlackBold}" />
                            </Grid>
                        </Frame>
                    </Grid>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0"  >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageAmendment}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniNewGrayLabelStyle}"/>

                        <Frame Grid.Row="1" HasShadow="False" Margin="0,5,0,0"  HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3">
                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="10">
                                <custom:GAZTBorderlessEntry IsEnabled="False" Text="Quarter 4 - 2020" Placeholder="{x:Static ResourceManager:AppResources.ZakatSelectBillsPageViewPlaceholder}" 
                                                    PlaceholderColor="Gray" x:Name="SearchItemVAT" FontSize="Small" TextColor="Black" FontAttributes="Bold" HorizontalOptions="FillAndExpand" />
                                <Image Source="arrowDropdown.png" WidthRequest="20" HeightRequest="20" Margin="0,0,5,0"></Image>
                            </StackLayout>
                        </Frame>

                    </Grid>

                    <StackLayout Grid.Row="3" Margin="10,25,10,0" Orientation="Horizontal" Grid.ColumnSpan="2">

                        <buttons:SfCheckBox />
                        <custom:CustomLabel Text="I want to apply for an exception to file quarterly due to severe cash flow implications caused by monthly VAT collections." Style="{StaticResource MiniNewGrayLabelStyle}" CharacterSpacing="0" VerticalOptions="CenterAndExpand"/>
                    </StackLayout>

                    <Frame  Grid.Row="4" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False">

                        <buttons:SfButton x:Name="btnZakatContinue" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding FrequencyContinueBtnTapped}" />

                    </Frame>
                </Grid>

               

                <!--Attachments screen-->

             
                <Grid IsVisible="{Binding IsAttachmentsViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>


                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>

                        </Grid.RowDefinitions>


                        <StackLayout Grid.Row="0" Grid.Column="0">
                            <listView:SfListView x:Name="outletDecisionOptionsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding OutletDecisionOptions}" SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"  SelectionMode="Single"
                                      SelectionBackgroundColor="Transparent" SelectionChanged="outletDecisionOptionsListView_SelectionChanged">

                                <listView:SfListView.ItemTemplate>

                                    <DataTemplate>
                                        <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="130">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                                <Image Source="vat_tile_listofsignup_W" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <custom:CustomLabel Text="{Binding ActiveOutletDecisionOptions}" Style="{StaticResource ValueLabelBlackBold}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                    Margin="20,0,20,20" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </custom:CustomLabel>
                                            </Grid>
                                        </cards:SfCardView>

                                    </DataTemplate>

                                </listView:SfListView.ItemTemplate>

                                <listView:SfListView.SelectedItemTemplate>

                                    <DataTemplate>
                                        <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="130">
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                                <Image Source="vat_tile_listofsignup" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                <custom:CustomLabel Text="{Binding ActiveOutletDecisionOptions}" Style="{StaticResource ValueLabelWhiteBold}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                    Margin="20,0,20,20" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                </custom:CustomLabel>
                                            </Grid>
                                        </cards:SfCardView>

                                    </DataTemplate>

                                </listView:SfListView.SelectedItemTemplate>

                                <listView:SfListView.LayoutManager>

                                    <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />

                                </listView:SfListView.LayoutManager>

                            </listView:SfListView>


                        </StackLayout>

                    </Grid>
              
               
                    <Grid IsVisible="{Binding ShowAttachments}" Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0"  Style="{StaticResource CaptionLabelGrey}" Text="{Binding SelectedAttachmentText}"/>
                        <StackLayout Grid.Row="1" Orientation="Vertical">
                            <inputLayout:SfTextInputLayout  LeadingViewPosition="Inside" TrailingViewPosition="Inside"  Margin="0" 
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1" 
                                        OutlineCornerRadius="12" FocusedColor="#005e4b" ErrorColor="#B00020">

                                <Entry Style="{StaticResource EntryStyle}" IsEnabled="False" Text="File1.pdf" TextColor="Black" HorizontalTextAlignment="Start" />
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image HorizontalOptions="Center" VerticalOptions="Center" Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.Close}"/>
                                        </Image.Source>

                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                        <custom:CustomLabel Grid.Row="2" Padding="0" Margin="0" VerticalOptions="Start" Style="{StaticResource CaptionLabelGrey}" Text="20MB"/>
                    </Grid>

                    <Grid Grid.Row="3" IsVisible="{Binding ShowAttachments}" Margin="0,15,0,0" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0"  Style="{StaticResource CaptionLabelGrey}" Text="New Attachment"/>
                        <StackLayout Grid.Row="1" Orientation="Vertical" Margin="0" Padding="0">
                            <inputLayout:SfTextInputLayout  LeadingViewPosition="Inside" TrailingViewPosition="Inside"  Margin="0" 
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1" 
                                        OutlineCornerRadius="12" FocusedColor="#005e4b" ErrorColor="#B00020">

                                <Entry Style="{StaticResource EntryStyle}" IsEnabled="False" Placeholder="Upload your document" TextColor="Black" HorizontalTextAlignment="Start" />
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image HorizontalOptions="Center" VerticalOptions="Center" Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                                 Glyph="{x:Static FontImage:IconFonts.Attachment}"/>
                                        </Image.Source>

                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                        <custom:CustomLabel Grid.Row="2" Padding="0" Margin="0" VerticalOptions="Start" Style="{StaticResource CaptionLabelGrey}" Text="50MB max"/>
                    </Grid>

                    <Frame Grid.Row="4" Margin="0,10,0,0" Grid.ColumnSpan="2" CornerRadius="12" BorderColor="LightGray" Padding="15" HasShadow="False">
                        <StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <Image Source="ic_vat_info" HeightRequest="20" WidthRequest="20"/>
                                <custom:CustomLabel Text="Attachments" Style="{StaticResource CaptionLabelBlack}" CharacterSpacing="0" VerticalOptions="CenterAndExpand"/>
                            </StackLayout>
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="In Case you have revenue below SAR40 and want to request for quarterly filing kindly attach evidence that you have been filing for 2 years with a monthly Tax Period and your Revenurs during last 12 months. 
                                                &#10; 
                                                In Case you want to request for an exception for quarterly filing, Kindly provide your previous 12 months average Days sales Outstanding"  />
                        </StackLayout>
                    </Frame>

                    <Frame  Grid.Row="5" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False" HorizontalOptions="FillAndExpand">

                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AttachmentsContinueBtnTapped}" HorizontalOptions="FillAndExpand" />

                    </Frame>

                </Grid>
              

                <!--Declaration screen-->

            
                <Grid IsVisible="{Binding IsDeclarationViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclaration}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclarationSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0" Margin="0,25,0,0"  >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0" Padding="10" Text="ID Type" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniNewGrayLabelStyle}"/>

                        <Frame Grid.Row="1" HasShadow="False"   HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3">
                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="10">
                                <custom:GAZTBorderlessEntry IsEnabled="False" Text="National ID" 
                                       FontAttributes="Bold" FontSize="Small" TextColor="Black" HorizontalOptions="FillAndExpand" />
                                <Image Source="arrowDropdown.png" WidthRequest="20" HeightRequest="20" Margin="0,0,5,0"></Image>
                            </StackLayout>
                        </Frame>

                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="0"  Margin="10,25,0,0"  >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0" Padding="0,0,10,0" Text="Date of Birth" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniNewGrayLabelStyle}"/>

                        <Frame Grid.Row="1" HasShadow="False"  HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3">
                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="10">
                                <custom:GAZTBorderlessEntry IsEnabled="False" Text="7 June 1995" 
                                                   FontAttributes="Bold" FontSize="Small" TextColor="Black" HorizontalOptions="FillAndExpand" />
                                <Image Source="calendar.png" WidthRequest="20" HeightRequest="20" Margin="0,0,5,0"></Image>
                            </StackLayout>
                        </Frame>

                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="1"  Margin="0,25,10,0"  >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0" Padding="0,0,10,0" Text="ID Number" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniNewGrayLabelStyle}"/>

                        <Frame Grid.Row="1" HasShadow="False" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3">
                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="10">
                                <custom:GAZTBorderlessEntry IsEnabled="False" Text="Q1720187" 
                                                   FontAttributes="Bold" FontSize="Small" TextColor="Black" HorizontalOptions="FillAndExpand" />

                            </StackLayout>
                        </Frame>

                    </Grid>


                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0" Margin="0,25,0,0"  >

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <custom:CustomLabel Grid.Row="0" Padding="0,0,0,10" Text="Contact Person Name" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniNewGrayLabelStyle}"/>

                        <Frame Grid.Row="1" HasShadow="False" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3">
                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="10">
                                <custom:GAZTBorderlessEntry IsEnabled="False" Text="Zaid Hardy"
                                                   FontAttributes="Bold" FontSize="Small" TextColor="Black" HorizontalOptions="FillAndExpand" />
                            </StackLayout>
                        </Frame>

                    </Grid>

                    <Frame  Grid.Row="4" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False" HorizontalOptions="FillAndExpand">

                        <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DeclarationContinueBtnTapped}" HorizontalOptions="FillAndExpand" />

                    </Frame>
                </Grid>
              

                <!--Summary screens-->
                
                <Grid IsVisible="{Binding IsSummaryViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPlanSummaryReview}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
