<?xml version="1.0" encoding="UTF-8"?>
<pages:PopupPage  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 x:Class="EGAZT.Views.NewDesign.GenericPickers.NewPopupPageView"
                 xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
                 xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
                 xmlns:ResourceManager="clr-namespace:EGAZT">
   <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
   <ContentPage.Content>
    <AbsoluteLayout>
        <BoxView BackgroundColor="Transparent" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">

            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>
         <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0" BackgroundColor="White"
                             x:Name="picker"
                                 AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="1,1,1,.4">
             <StackLayout Orientation="Vertical" Margin="0,8,0,0" Padding="24,0">
                 <BoxView CornerRadius="2.5" BackgroundColor="{StaticResource NeutralLightGrey}" WidthRequest="36" HeightRequest="5"
                          HorizontalOptions="Center">
                       <BoxView.GestureRecognizers>
                        <SwipeGestureRecognizer Swiped="SwipeGestureRecognizer_Swiped" Direction="Down"/>
                      </BoxView.GestureRecognizers>
                     </BoxView>
                <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="TaxTypePicker"  HeaderHeight="55"
                                    HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" 
                                        HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46"
                                    PickerMode="Default" HeaderBackgroundColor="#006450" BorderColor="White"
                                        BackgroundColor="White" SelectedItemFontSize="16" ShowFooter="False"
                                     UnSelectedItemFontSize="16"
                                        SelectedItemFontAttribute="Bold"
                                     SelectionBackgroundColor="LightGray"
                                    IsOpen="True"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                    ItemHeight="56" DisplayMemberPath="TaxType"
                                    PickerWidth="300" ShowHeader="False" 
                                    CancelButtonTextColor="#006450" 
                                     HeaderFontFamily="{OnPlatform iOS=SSTArabic-Bold, Android=GAZT_FONT_BOLD}"
                                     ColumnHeaderFontFamily="{OnPlatform iOS=SSTArabic-Bold, Android=GAZT_FONT_BOLD}"
                                     SelectedItemFontFamily="{OnPlatform iOS=SSTArabic-Bold, Android=GAZT_FONT_BOLD}"
                                     UnSelectedItemFontFamily="{OnPlatform iOS=SSTArabic-Bold, Android=GAZT_FONT_BOLD}">

                   
                    <syncfusion:SfPicker.Behaviors>
                        <customcontrol:SfPickerBehavior />
                    </syncfusion:SfPicker.Behaviors>
                </syncfusion:SfPicker>

             </StackLayout>
               
             
                 </yummy:PancakeView>
    </AbsoluteLayout>
   </ContentPage.Content>
</pages:PopupPage>
