<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.GenericPickers.CalendarPickerPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:custom11="clr-namespace:EGAZT.CustomControl"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundClicked="PopupPage_BackgroundClicked">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HorizontalOptions="End"
            IsVisible="true"
            VerticalOptions="End">
            <StackLayout Orientation="Vertical">

                <border:SfBorder
                    Margin="0,0,0,5"
                    Padding="0"
                    HasShadow="False"
                    Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout Orientation="Vertical">
                        <BoxView
                            HorizontalOptions="Center"
                            Style="{StaticResource NeutralGrayBoxViewDrag}"
                            VerticalOptions="Start" />
                        <Button
                            x:Name="CalendarDoneButton"
                            Margin="10,0,10,0"
                            BackgroundColor="Transparent"
                            Clicked="PopupClose_Clicked"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="Medium"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.CRDone}"
                            TextColor="{StaticResource Primary}" />
                    </StackLayout>
                </border:SfBorder>

                <StackLayout
                    Margin="24,8,24,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    IsVisible="{Binding IsCurrentDatePickerVisible}"
                    VerticalOptions="End">
                    <Label
                        x:Name="CalendarTitle"
                        Margin="0,16,0,16"
                        HorizontalOptions="CenterAndExpand"
                        Style="{StaticResource SectionTitleBlackBold}"
                        Text="{Binding DatePickerTitle}" />

                    <custom11:GenericCustomDatePicker
                        x:Name="calendarPicker"
                        Margin="2"
                        FlowDirection="RightToLeft"
                        IsOpen="True"
                        ItemHeight="36"
                        SelectedItem="{Binding SelectedDate}"
                        SelectionChanged="genericPicker_SelectionChanged"
                        Style="{StaticResource CalendarPickerStyle}">
                        <custom11:GenericCustomDatePicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </custom11:GenericCustomDatePicker.Behaviors>
                    </custom11:GenericCustomDatePicker>
                </StackLayout>
                <StackLayout
                    Margin="24,8,24,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    IsVisible="{Binding IsFutureDatePickerVisible}"
                    VerticalOptions="End">

                    <Label
                        x:Name="FutureCalendarTitle"
                        Margin="0,16,0,16"
                        HorizontalOptions="CenterAndExpand"
                        Style="{StaticResource SectionTitleBlackBold}"
                        Text="{Binding DatePickerTitle}" />
                    <custom11:GenericCustomDatePicker
                        x:Name="futureCalendarPicker"
                        Margin="2"
                        FlowDirection="RightToLeft"
                        IsOpen="True"
                        ItemHeight="36"
                        SelectedItem="{Binding SelectedDate}"
                        SelectionChanged="genericPicker_SelectionChanged"
                        Style="{StaticResource CalendarPickerStyle}">
                        <custom11:GenericCustomDatePicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </custom11:GenericCustomDatePicker.Behaviors>
                    </custom11:GenericCustomDatePicker>
                </StackLayout>
            </StackLayout>
        </yummy:PancakeView>
    </ContentPage.Content>
</pages:PopupPage>
