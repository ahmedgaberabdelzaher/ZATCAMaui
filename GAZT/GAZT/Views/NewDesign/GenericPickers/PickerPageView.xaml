<?xml version="1.0" encoding="UTF-8"?>
<pages:PopupPage  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                  xmlns="http://xamarin.com/schemas/2014/forms"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                  xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
                  xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
                  x:Class="EGAZT.Views.NewDesign.GenericPickers.PickerPageView"
                  xmlns:ResourceManager="clr-namespace:EGAZT" 
                  xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
                  BackgroundClicked="PopupPage_BackgroundClicked">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView BackgroundColor="White" CornerRadius="15,15,0,0"  HorizontalOptions="End" VerticalOptions="End" IsVisible="true">
             <StackLayout BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="End" Spacing="0">
                <border:SfBorder Margin="0,0,0,5" HasShadow="False" Padding="0"
                                         Style="{StaticResource GreyBorderFrameWithShadow}">
                    <StackLayout Orientation="Horizontal">
                        <Button x:Name="PickerDoneButton" TextColor="{StaticResource Primary}" FontSize="Medium" FontAttributes="Bold" Text="{x:Static ResourceManager:AppResources.CRDone}" Clicked="PopupClose_Clicked" Margin="10,0,10,0"   BackgroundColor="Transparent" HorizontalOptions="StartAndExpand" VerticalOptions="Center">
                    </Button>
                         <Button x:Name="PickerCancelButton" TextColor="{StaticResource Primary}" FontSize="Medium" FontAttributes="Bold" Text="{x:Static ResourceManager:AppResources.ZZClose}" Clicked="PopupCancel_Clicked" Margin="10,0,10,0"   BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="Center">
                    </Button>
                    </StackLayout>
                </border:SfBorder>
                <StackLayout Margin="24,8,24,0" >

                   <Label x:Name="PickerTitle" Text="{Binding PickerTitle}" 
                                    HorizontalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"
                                Margin="0,16,0,0" BackgroundColor="Transparent" />

                    <syncfusion:SfPicker 
                        FlowDirection="RightToLeft"
                        IsOpen="True" 
                        Style="{StaticResource PickerStyle}" 
                        ItemsSource="{Binding PickerItemSource}"
						Margin="2" 
                        HeaderBackgroundColor="Aqua"
						x:Name="genericPicker" 
                         UnSelectedItemFontSize="15"
                        SelectedItemFontSize="15"
                        SelectionChanged="genericPicker_SelectionChanged"
						ItemHeight="36">
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior/>
                            </syncfusion:SfPicker.Behaviors>
                  </syncfusion:SfPicker>
                </StackLayout>
            </StackLayout>
          </yummy:PancakeView>
    </ContentPage.Content>
</pages:PopupPage>
