<?xml version="1.0" encoding="UTF-8"?>
<pages:PopupPage  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                  xmlns="http://xamarin.com/schemas/2014/forms"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                  xmlns:custom="clr-namespace:GAZT" xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
                  x:Class="EGAZT.Views.NewDesign.GenericPickers.PickerPageView" xmlns:ResourceManager="clr-namespace:EGAZT" BackgroundClicked="PopupPage_BackgroundClicked">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView BackgroundColor="White" CornerRadius="15,15,0,0"  HorizontalOptions="End" VerticalOptions="End" IsVisible="true">
             <StackLayout BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="End" Margin="24,8,24,0" Spacing="0">
                <BoxView Style="{StaticResource NeutralGrayBoxViewDrag}" HorizontalOptions="Center" VerticalOptions="Start"/>
                <Label Text="{Binding PickerTitle}" 
                                    HorizontalOptions="StartAndExpand" Style="{StaticResource SectionTitleBlackBold}"
                                Margin="0,16,0,0" BackgroundColor="Transparent" />
                 <syncfusion:SfPicker IsOpen="True" Style="{StaticResource PickerStyle}" ItemsSource="{Binding PickerItemSource}"
								Margin="2" HeaderBackgroundColor="Aqua"
								x:Name="genericPicker" SelectionChanged="genericPicker_SelectionChanged"
								ItemHeight="36">
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior/>
                            </syncfusion:SfPicker.Behaviors>
                  </syncfusion:SfPicker>
               </StackLayout>
          </yummy:PancakeView>
    </ContentPage.Content>
</pages:PopupPage>
