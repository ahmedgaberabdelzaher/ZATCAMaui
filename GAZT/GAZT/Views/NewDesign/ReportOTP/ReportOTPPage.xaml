<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ReportOTP.ReportOTPPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding StartTimerCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid
            HorizontalOptions="FillAndExpand"
            RowDefinitions="Auto,*"
            VerticalOptions="FillAndExpand">

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource CommonTopCurves}"
                VerticalOptions="FillAndExpand">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="30">

                        <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                            <!--  Logo Image  -->
                            <Image
                                Grid.Column="1"
                                HeightRequest="45"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                Style="{DynamicResource BackButtonArrow}"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="40" />


                            <StackLayout Grid.Column="2">

                                <!--  Close Image  -->
                                <Image
                                    HorizontalOptions="EndAndExpand"
                                    Rotation="0"
                                    Source="darkClose.png"
                                    Style="{DynamicResource BackButtonArrow}"
                                    VerticalOptions="CenterAndExpand" />

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                                </StackLayout.GestureRecognizers>

                            </StackLayout>

                        </Grid>

                        <!--  Header Label  -->
                        <custom:CustomLabel
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="28"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.ZZVerificationsCode}"
                            TextColor="#002447"
                            VerticalOptions="Start" />

                        <!--  OTP msg Label  -->
                        <custom:CustomLabel
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="{x:Static ResourceManager:AppResources.ReportOTPMSG}"
                            TextColor="#999999"
                            VerticalOptions="Start" />


                        <!--  Horizontal Line  -->
                        <BoxView
                            BackgroundColor="#EBEBEB"
                            HeightRequest="1"
                            VerticalOptions="Start" />


                        <!--  OTP msg Label  -->
                        <custom:CustomLabel
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="{Binding OTPSentOnThisMobileNumber}"
                            TextColor="#999999"
                            VerticalOptions="Start" />


                        <Grid
                            Padding="0"
                            ColumnDefinitions="50,50,50,50"
                            ColumnSpacing="20"
                            FlowDirection="LeftToRight"
                            HorizontalOptions="CenterAndExpand"
                            RowDefinitions="50"
                            VerticalOptions="Start">

                            <!--  First OTP  -->
                            <inputLayout:SfTextInputLayout
                                Margin="0,-8,0,0"
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    x:Name="firstEntry"
                                    ClassId="1"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Next"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPFirstDigit}"
                                    TextColor="#0996D4">

                                    <custom:BorderlessEntry.Behaviors>
                                        <xct:EventToCommandBehavior
                                            Command="{Binding GoToNextEntryCommand}"
                                            CommandParameter="{Binding Source={x:Reference secondEntry}}"
                                            EventName="TextChanged" />
                                    </custom:BorderlessEntry.Behaviors>

                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference firstEntry}}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                            <!--  Second OTP  -->
                            <inputLayout:SfTextInputLayout
                                Grid.Column="1"
                                Margin="0,-8,0,0"
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    x:Name="secondEntry"
                                    ClassId="2"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Next"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPSecondDigit}"
                                    TextColor="#0996D4">

                                    <custom:BorderlessEntry.Behaviors>
                                        <xct:EventToCommandBehavior
                                            Command="{Binding GoToNextEntryCommand}"
                                            CommandParameter="{Binding Source={x:Reference thirdEntry}}"
                                            EventName="TextChanged" />
                                    </custom:BorderlessEntry.Behaviors>

                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference secondEntry}}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                            <!--  Third OTP  -->
                            <inputLayout:SfTextInputLayout
                                Grid.Column="2"
                                Margin="0,-8,0,0"
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    x:Name="thirdEntry"
                                    ClassId="3"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Next"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPThirdDigit}"
                                    TextColor="#0996D4">

                                    <custom:BorderlessEntry.Behaviors>
                                        <xct:EventToCommandBehavior
                                            Command="{Binding GoToNextEntryCommand}"
                                            CommandParameter="{Binding Source={x:Reference fourthEntry}}"
                                            EventName="TextChanged" />
                                    </custom:BorderlessEntry.Behaviors>

                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference thirdEntry}}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                            <!--  Fourth OTP  -->
                            <inputLayout:SfTextInputLayout
                                Grid.Column="3"
                                Margin="0,-8,0,0"
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    x:Name="fourthEntry"
                                    ClassId="4"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="16"
                                    HorizontalTextAlignment="Center"
                                    IsPassword="True"
                                    Keyboard="Numeric"
                                    MaxLength="1"
                                    ReturnType="Go"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding OTPFourthDigit}"
                                    TextColor="#0996D4">

                                    <custom:BorderlessEntry.Behaviors>
                                        <xct:EventToCommandBehavior Command="{Binding VerifyOTPCommand}" EventName="Completed" />
                                    </custom:BorderlessEntry.Behaviors>

                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FocusEntryCommand}" CommandParameter="{Binding Source={x:Reference fourthEntry}}" />
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                        </Grid>

                        <StackLayout
                            HorizontalOptions="Center"
                            Orientation="Horizontal"
                            Spacing="20">

                            <custom:CustomLabel
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                HorizontalTextAlignment="Center"
                                Text="{Binding LblCountDownTimer}"
                                TextColor="#999999" />

                            <Image
                                HeightRequest="25"
                                Source="clock"
                                WidthRequest="25" />

                        </StackLayout>

                        <!--  Resend msg Label  -->
                        <custom:CustomLabel
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            IsEnabled="{Binding IsResendCodeEnabled}"
                            Opacity="{Binding Opacity}"
                            Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                            TextColor="#0996D4"
                            TextDecorations="Underline"
                            VerticalOptions="Start">

                            <custom:CustomLabel.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ResendOtpCommand}" />
                            </custom:CustomLabel.GestureRecognizers>
                        </custom:CustomLabel>

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->


            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>

