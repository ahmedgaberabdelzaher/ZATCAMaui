<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EDeclaration.QuestionsViews.ProductDeclarationPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:questionsviews="clr-namespace:EGAZT.Views.NewDesign.EDeclaration.QuestionsViews"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary>
                <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            </ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <!--  Back Button  -->
                <StackLayout>

                    <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PrevoiusCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    FontSize="15"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding HeaderTitle}"
                    VerticalOptions="Center" />

                <!--  Cart Image  -->
                <StackLayout
                    Grid.Column="2"
                    HorizontalOptions="End"
                    Spacing="0">

                    <!--  Count Label  -->
                    <custom:CustomLabel
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding CardData.Count}"
                        TextColor="#4FBBBD"
                        VerticalOptions="End" />

                    <!--  Cart Image  -->
                    <Image
                        HorizontalOptions="End"
                        Source="eCart.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>


            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand">

                        <!--  Circle view  -->
                        <Grid
                            Margin="0,30,0,10"
                            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                            ColumnSpacing="0"
                            HorizontalOptions="CenterAndExpand"
                            RowDefinitions="Auto"
                            VerticalOptions="Start">

                            <!--  Circle button 1  -->
                            <Button
                                BackgroundColor="Transparent"
                                BorderColor="#0996D4"
                                BorderWidth="1"
                                CornerRadius="15"
                                HeightRequest="30"
                                HorizontalOptions="EndAndExpand"
                                InputTransparent="True"
                                Text="1"
                                TextColor="#0996D4"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="30">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="1"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20" />

                            <!--  Circle button 2  -->
                            <Button
                                Grid.Column="2"
                                BackgroundColor="Transparent"
                                BorderColor="#B8BABA"
                                BorderWidth="1"
                                CornerRadius="15"
                                HeightRequest="30"
                                HorizontalOptions="StartAndExpand"
                                InputTransparent="True"
                                Text="2"
                                TextColor="#565655"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="30">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="3"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20" />

                            <!--  Circle button 3  -->
                            <Button
                                Grid.Column="4"
                                BackgroundColor="Transparent"
                                BorderColor="#B8BABA"
                                BorderWidth="1"
                                CornerRadius="15"
                                HeightRequest="30"
                                HorizontalOptions="StartAndExpand"
                                InputTransparent="True"
                                Text="3"
                                TextColor="#565655"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="30">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="5"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20" />

                            <!--  Circle button 4  -->
                            <Button
                                Grid.Column="6"
                                BackgroundColor="Transparent"
                                BorderColor="#B8BABA"
                                BorderWidth="1"
                                CornerRadius="15"
                                HeightRequest="30"
                                HorizontalOptions="StartAndExpand"
                                InputTransparent="True"
                                Text="4"
                                TextColor="#565655"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="30">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                        </Grid>


                        <!--  AddingItems Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            Text="{x:Static ResourceManager:AppResources.AddingItems}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Horizontal Line  -->
                        <BoxView
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2"
                            WidthRequest="20" />

                        <!--  Welcome Label for logged in only  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="20"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            MaxLines="1"
                            Text="{x:Static ResourceManager:AppResources.Hi}"
                            TextColor="#0996D4" />

                        <!--  User Label for logged in only  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="20"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            MaxLines="1"
                            Text="{Binding SubmitModel.travelerDeclaration.FullName}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Question Title Field Label  -->
                        <custom:CustomLabel
                            Margin="0,0,0,10"
                            FontSize="14"
                            LineSpacing="1"
                            Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Question}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <!--  Horizontal Line  -->
                        <BoxView
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            WidthRequest="20" />

                        <!--#region Questions View-->
                        <StackLayout>

                            <!--#region Hint view-->
                            <Frame
                                Padding="10"
                                BackgroundColor="White"
                                BorderColor="#E6E6E6"
                                CornerRadius="10"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="StartAndExpand">

                                <Frame.Triggers>
                                    <DataTrigger
                                        Binding="{Binding QFlow}"
                                        TargetType="Frame"
                                        Value="4">
                                        <Setter Property="IsVisible" Value="false" />

                                    </DataTrigger>

                                </Frame.Triggers>

                                <StackLayout
                                    HorizontalOptions="StartAndExpand"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalOptions="StartAndExpand">

                                    <!--  info icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="20"
                                        HorizontalOptions="CenterAndExpand"
                                        Source="information.png"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="20" />

                                    <!--  Question Hint Label  -->
                                    <custom:CustomLabel
                                        FontSize="12"
                                        HorizontalOptions="StartAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.ProductDeclarationDisclaimer}"
                                        TextColor="#999999">
                                        <custom:CustomLabel.Triggers>

                                            <DataTrigger
                                                Binding="{Binding QFlow}"
                                                TargetType="custom:CustomLabel"
                                                Value="2">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding QFlow}"
                                                TargetType="custom:CustomLabel"
                                                Value="3">
                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Q2Hint}" />
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding QFlow}"
                                                TargetType="custom:CustomLabel"
                                                Value="4">

                                                <Setter Property="IsVisible" Value="false" />
                                            </DataTrigger>

                                        </custom:CustomLabel.Triggers>

                                    </custom:CustomLabel>

                                    <!--  Hint With Two Line  -->
                                    <StackLayout IsVisible="false">

                                        <StackLayout.Triggers>

                                            <DataTrigger
                                                Binding="{Binding QFlow}"
                                                TargetType="StackLayout"
                                                Value="2">
                                                <Setter Property="IsVisible" Value="true" />
                                            </DataTrigger>

                                        </StackLayout.Triggers>

                                        <!--  Hint Label  -->
                                        <custom:CustomLabel
                                            FontSize="12"
                                            HorizontalOptions="StartAndExpand"
                                            LineSpacing="1"
                                            Text="{x:Static ResourceManager:AppResources.DeclerationSecondSecurityQuestionYesHint}"
                                            TextColor="#999999" />

                                        <!--  View List Label  -->
                                        <custom:CustomLabel
                                            FontSize="12"
                                            HorizontalOptions="StartAndExpand"
                                            LineSpacing="1"
                                            Text="{x:Static ResourceManager:AppResources.Viewlist}"
                                            TextColor="#002447"
                                            TextDecorations="Underline">

                                            <custom:CustomLabel.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoToProhibitedGoodsLstURlCommand}" />
                                            </custom:CustomLabel.GestureRecognizers>

                                        </custom:CustomLabel>

                                    </StackLayout>

                                </StackLayout>

                            </Frame>
                            <!--#endregion Hint view-->

                            <!--#region TobacoProduct-->
                            <questionsviews:TobacoView />
                            <!--#endregion TobacoProduct-->

                            <!--#region ProductView-->
                            <questionsviews:ProductView />
                            <!--#endregion ProductView-->

                            <!--#region CurrencyView-->
                            <questionsviews:CurrencyView />
                            <!--#endregion CurrencyView-->

                            <!--#region Security Restricted QuestionView-->
                            <questionsviews:RestrictedView />

                            <!--#endregion RestrictedView-->

                        </StackLayout>
                        <!--#endregion Questions View-->

                        <!--#region Submit and Card-->
                        <StackLayout>
                            <!--  Add Item Button  -->
                            <buttons:SfButton
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.AddItem}" />

                            <!--  Card Frame  -->
                            <Frame
                                Padding="10"
                                BackgroundColor="{StaticResource Primary}"
                                CornerRadius="10"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="StartAndExpand">

                                <StackLayout Orientation="Horizontal" Spacing="10">

                                    <Frame
                                        Padding="10"
                                        BackgroundColor="White"
                                        CornerRadius="10"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">

                                        <!--  Total Number Label  -->
                                        <custom:CustomLabel
                                            FontFamily="{StaticResource SomarRegular}"
                                            FontSize="14"
                                            Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FeesCalculatorResponse.totalPayment}" />
                                                    <Span Text="  " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </Frame>

                                    <!--  Total Fees Payable Label  -->
                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="14"
                                        HorizontalOptions="End"
                                        Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                        TextColor="White"
                                        VerticalOptions="CenterAndExpand" />

                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                        </StackLayout>
                        <!--#endregion Submit and Card-->

                        <!--  GoTo Second Product Declaration Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            Command="{Binding NextCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}"
                            VerticalOptions="EndAndExpand" />

                        <!--  Prevoius Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            Command="{Binding PrevoiusCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PerviousButton}"
                            TextColor="{StaticResource Secondary}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet Grid.Row="1" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

