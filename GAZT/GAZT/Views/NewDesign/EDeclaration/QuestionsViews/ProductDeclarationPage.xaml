<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.QuestionsViews.ProductDeclarationPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:questionsviews="clr-namespace:EGAZT.Views.NewDesign.EDeclaration.QuestionsViews"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
             <ResourceDictionary>
                    <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            </ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <!--  Back Button  -->
                <StackLayout>

                     <!--  Back Image  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PrevoiusCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    VerticalOptions="Center" />

                <!--  Cart Image -->
                <StackLayout Grid.Column="2"
                             Spacing="0"
                             HorizontalOptions="End">

                     <!--  Count Label  -->
                    <custom:CustomLabel
                        HorizontalOptions="Center"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="#4FBBBD"
                        Text="{Binding CardData.Count}"
                        VerticalOptions="End" />

                     <!--  Cart Image -->
                    <Image
                        HorizontalOptions="End"
                        Source="eCart.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>


            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand">

                        <!--Circle view-->
                        <Grid RowDefinitions="Auto"
                              Margin="0,30"
                              ColumnSpacing="0"
                              VerticalOptions="Start"
                              HorizontalOptions="CenterAndExpand"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                            <!--Circle button 1-->
                            <ImageButton
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    BorderWidth="1" Padding="5"
                                    InputTransparent="True"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="EndAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Source="reportCheckMark.png">


                            </ImageButton>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="1"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 2-->
                            <Button
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="2"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#0996D4"
                                    BackgroundColor="Transparent"
                                    TextColor="#0996D4"
                                    Text="2">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="3"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2" />

                            <!--Circle button 3-->
                            <Button
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="4"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#B8BABA"
                                    BackgroundColor="Transparent"
                                    TextColor="#565655"
                                    Text="3">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="5"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2" />

                            <!--Circle button 4-->
                            <Button
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="6"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#B8BABA"
                                    BackgroundColor="Transparent"
                                    TextColor="#565655"
                                    Text="4">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="7"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2" />

                            <!--Circle button 5-->
                            <Button
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="8"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#B8BABA"
                                    BackgroundColor="Transparent"
                                    TextColor="#565655"
                                    Text="5">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="9"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2" />

                            <!--Circle button 6-->
                            <Button
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="10"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#B8BABA"
                                    BackgroundColor="Transparent"
                                    TextColor="#565655"
                                    Text="6">
                                <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                        </Grid>

                        <!--  Product Declaration Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            Text="{x:Static ResourceManager:AppResources.ProductDeclaration}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Declaration Note Label  -->
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                             FontSize="16"
                                             Margin="0,0,0,5"
                                             LineSpacing="1"
                                             LineBreakMode="WordWrap">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.NewDeclarationNote}"
                                              TextColor="{StaticResource NeutralGreay}"/>
                                        <Span TextColor="{StaticResource Primary}"
                                              Text="{x:Static ResourceManager:AppResources.CustomDeclarationInformation}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>

                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCustomInformationLinkCommand}"/>
                                </custom:CustomLabel.GestureRecognizers>

                         </custom:CustomLabel>

                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />

                        <!--  Welcome Label for logged in only -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="20"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            Text="{x:Static ResourceManager:AppResources.Hi}"
                            TextColor="#0996D4" />

                        <!--  User Label for logged in only  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="20"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            Text="{Binding SubmitModel.travelerDeclaration.FullName}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Question Title Field Label  -->
                        <custom:CustomLabel
                            FontSize="14"
                            LineSpacing="1"
                            Margin="0,0,0,10"
                            Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Question}"/>
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            Margin="0,0,0,10"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />

                        <!--#region Questions View-->
                        <StackLayout >

                            <!--#region Hint view-->
                            <Frame Padding="10"
                               BackgroundColor="White"
                               BorderColor="#E6E6E6"
                               VerticalOptions="StartAndExpand"
                               HorizontalOptions="FillAndExpand"
                               CornerRadius="10">

                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                                                 Binding="{Binding QFlow}"
                                                 Value="4">
                                        <Setter Property="IsVisible"
                                                Value="false"/>

                                    </DataTrigger>

                                </Frame.Triggers>

                                <StackLayout
                                    Orientation="Horizontal"
                                    VerticalOptions="StartAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="10">

                                    <!--info icon-->
                                    <Image
                                        Aspect="AspectFit"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        HorizontalOptions="CenterAndExpand"
                                        Source="information.png"/>

                                    <!--  Question Hint Label  -->
                                    <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            FontSize="12"
                                            TextColor="#999999"
                                            Text="{x:Static ResourceManager:AppResources.ProductDeclarationDisclaimer}">
                                            <custom:CustomLabel.Triggers>

                                                <DataTrigger TargetType="custom:CustomLabel"
                                                             Binding="{Binding QFlow}"
                                                             Value="2">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>

                                                <DataTrigger TargetType="custom:CustomLabel"
                                                             Binding="{Binding QFlow}"
                                                             Value="3">
                                                    <Setter Property="Text"
                                                            Value="{x:Static ResourceManager:AppResources.Q2Hint}"/>
                                                </DataTrigger>

                                                <DataTrigger TargetType="custom:CustomLabel"
                                                             Binding="{Binding QFlow}"
                                                             Value="4">

                                                     <Setter Property="IsVisible"
                                                             Value="false"/>
                                                </DataTrigger>

                                            </custom:CustomLabel.Triggers>

                                    </custom:CustomLabel>

                                    <!-- Hint With Two Line -->
                                    <StackLayout IsVisible="false">

                                         <StackLayout.Triggers>

                                            <DataTrigger TargetType="StackLayout"
                                                         Binding="{Binding QFlow}" Value="2">
                                                        <Setter Property="IsVisible" Value="true"/>
                                            </DataTrigger>

                                         </StackLayout.Triggers>

                                        <!--Hint Label-->
                                         <custom:CustomLabel  
                                                HorizontalOptions="StartAndExpand"
                                                FontSize="12"
                                                LineSpacing="1"
                                                Text="{x:Static ResourceManager:AppResources.DeclerationSecondSecurityQuestionYesHint}"
                                                TextColor="#999999"/>

                                        <!-- View List Label -->
                                        <custom:CustomLabel 
                                            HorizontalOptions="StartAndExpand"
                                            TextDecorations="Underline"
                                            Text="{x:Static ResourceManager:AppResources.Viewlist}"
                                            FontSize="12"
                                            LineSpacing="1"
                                            TextColor="#002447">

                                            <custom:CustomLabel.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoToProhibitedGoodsLstURlCommand}"/>
                                            </custom:CustomLabel.GestureRecognizers>

                                        </custom:CustomLabel>

                                    </StackLayout>

                                </StackLayout>

                            </Frame>
                            <!--#endregion Hint view-->

                            <!--#region TobacoProduct-->
                            <questionsviews:TobacoView/>
                            <!--#endregion TobacoProduct-->

                            <!--#region ProductView-->
                            <questionsviews:ProductView/>
                            <!--#endregion ProductView-->

                            <!--#region CurrencyView-->
                            <questionsviews:CurrencyView/>
                            <!--#endregion CurrencyView-->

                            <!--#region Security Restricted QuestionView-->
                            <questionsviews:RestrictedView />
                    
                            <!--#endregion RestrictedView-->

                        </StackLayout> 
                         <!--#endregion Questions View-->
                        
                        <!--#region Submit and Card-->
                        <StackLayout >
                            <!--  Add Item Button  -->
                            <buttons:SfButton
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.AddItem}" />

                            <!--Card Frame -->
                            <Frame Padding="10"
                               BackgroundColor="{StaticResource Primary}"
                               VerticalOptions="StartAndExpand"
                               HorizontalOptions="FillAndExpand"
                               CornerRadius="10">

                                <StackLayout
                                Orientation="Horizontal"
                                Spacing="10">

                                    <Frame Padding="10"
                                      BackgroundColor="White"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Start"
                                      CornerRadius="10">

                                        <!--  Total Number Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" FontFamily="{StaticResource SomarRegular}"  FontSize="14">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FeesCalculatorResponse.totalPayment}"/>
                                                    <Span  Text="  " />
                                                    <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </Frame>

                                    <!--  Total Fees Payable Label  -->
                                    <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    HorizontalOptions="End" VerticalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                    TextColor="White" />

                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCartCommand}"></TapGestureRecognizer>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </StackLayout>
                        <!--#endregion Submit and Card-->

                        <!-- GoTo Second Product Declaration Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            VerticalOptions="EndAndExpand"
                            Command="{Binding NextCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                        <!--  Prevoius Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            TextColor="{StaticResource Secondary}"
                            Command="{Binding PrevoiusCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PerviousButton}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet Grid.Row="1" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />
        
        </Grid>
    </ContentPage.Content>
</ContentPage>

