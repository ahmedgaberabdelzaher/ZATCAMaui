<?xml version="1.0" encoding="UTF-8" ?>
<StackLayout
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.QuestionsViews.CurrencyView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:behaviour="clr-namespace:GAZT.CustomControl"
    xmlns:custom="clr-namespace:GAZT"
    IsVisible="false"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms">

     <StackLayout.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </StackLayout.Resources>

    <StackLayout.Triggers>
       <DataTrigger TargetType="StackLayout"
                     Binding="{Binding QFlow}"
                     Value="3">

           <Setter Property="IsVisible" Value="true"/>

       </DataTrigger>
    </StackLayout.Triggers>

     <!--#region MaterialType Entry-->
     <StackLayout Spacing="0">

        <!--  MaterialType Label  -->
        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.MaterialType}"/>
                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
        </custom:CustomLabel>

        <!--  MaterialType Entry  -->
        <inputLayout:SfTextInputLayout
                    ContainerBackgroundColor="White"
                    ContainerType="Outlined"
                    ErrorColor="#B00020"
                    FocusedColor="{StaticResource NeutralGreay}"
                    InputViewPadding="16,0,16,0"
                    LeadingViewPosition="Inside"
                    OutlineCornerRadius="15"
                    UnfocusedColor="{StaticResource NeutralGreay}">

            <custom:BorderlessEntry
                    InputTransparent="True"
                    IsReadOnly="True"
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding SelectedMaterialTypes.Name}"
                    TextColor="#58595B">

                <custom:BorderlessEntry.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenMaterialTypesCommand}" />
                </custom:BorderlessEntry.GestureRecognizers>

            </custom:BorderlessEntry>

            <inputLayout:SfTextInputLayout.TrailingView>
                <Image Aspect="AspectFit" Source="greyDropDown" />
            </inputLayout:SfTextInputLayout.TrailingView>

        </inputLayout:SfTextInputLayout>

        <StackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenMaterialTypesCommand}" />
        </StackLayout.GestureRecognizers>

     </StackLayout>
     <!--#endregion MaterialType Entry-->

     <!--#region Purpose View-->
     <StackLayout>
            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                <custom:CustomLabel.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static ResourceManager:AppResources.Purpose}"/>
                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                    </FormattedString>
                </custom:CustomLabel.FormattedText>
            </custom:CustomLabel>

          <inputLayout:SfTextInputLayout
                    ContainerBackgroundColor="White"
                    ContainerType="Outlined"
                    ErrorColor="#B00020"
                    FocusedColor="{StaticResource NeutralGreay}"
                    InputViewPadding="16,0,16,0"
                    LeadingViewPosition="Inside"
                    OutlineCornerRadius="15"
                    UnfocusedColor="{StaticResource NeutralGreay}">

                <custom:BorderlessEntry
                        InputTransparent="True"
                        IsReadOnly="True"
                        Keyboard="Text"
                        Placeholder="{x:Static ResourceManager:AppResources.Select}"
                        Style="{StaticResource DefaultEntry}"
                        Text="{Binding SelectedPurposes.Name}"
                        TextColor="#58595B">

                    <custom:BorderlessEntry.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPurposesCommand}" />
                    </custom:BorderlessEntry.GestureRecognizers>

                </custom:BorderlessEntry>

                <inputLayout:SfTextInputLayout.TrailingView>
                    <Image Aspect="AspectFit" Source="greyDropDown" />
                </inputLayout:SfTextInputLayout.TrailingView>

          </inputLayout:SfTextInputLayout>

          <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenPurposesCommand}" />
          </StackLayout.GestureRecognizers>

    </StackLayout>
     <!--#endregion Purpose View-->

     <!--#region Other Purpose Field -->
     <StackLayout IsVisible="false" Spacing="0">

        <StackLayout.Triggers>
            <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedPurposes.ID}" Value="8">
                <Setter Property="IsVisible" Value="true"></Setter>
            </DataTrigger>
        </StackLayout.Triggers>

        <!--  Other Purpose Label  -->
        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.OtherPurpose}"/>
                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
        </custom:CustomLabel>

        <!--  Other Purpose Entry  -->
        <inputLayout:SfTextInputLayout
                    ContainerBackgroundColor="White"
                    ContainerType="Outlined"
                    ErrorColor="#B00020"
                    FocusedColor="{StaticResource NeutralGreay}"
                    InputViewPadding="16,0,16,0"
                    LeadingViewPosition="Inside"
                    OutlineCornerRadius="15"
                    UnfocusedColor="{StaticResource NeutralGreay}">

            <custom:BorderlessEntry
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.OtherPurpose}"
                    Style="{StaticResource DefaultEntry}"
                    Text="{Binding OtherPurpose}"
                    TextColor="#58595B" />

        </inputLayout:SfTextInputLayout>

     </StackLayout>
     <!--#endregion Other Purpose Field-->

     <!--#region TotalValue Field  -->
     <StackLayout Spacing="0">

        <!--  Quantity Label  -->
        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static ResourceManager:AppResources.TotalPriceValue}"/>
                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
        </custom:CustomLabel>

        <!--  Total Value Entry  -->
        <inputLayout:SfTextInputLayout
                    ContainerBackgroundColor="White"
                    ContainerType="Outlined"
                    ErrorColor="#B00020"
                    FocusedColor="{StaticResource NeutralGreay}"
                    InputViewPadding="16,0,16,0"
                    HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                    LeadingViewPosition="Inside"
                    OutlineCornerRadius="15"
                    UnfocusedColor="{StaticResource NeutralGreay}">

                <custom:BorderlessEntry
                        Keyboard="Numeric"
                        Placeholder="{x:Static ResourceManager:AppResources.TotalPriceValue}"
                        Style="{StaticResource DefaultEntry}"
                        Text="{Binding TotalValue}"
                        TextColor="#58595B" >
                    <custom:BorderlessEntry.Behaviors>
                            <behaviour:OnlyNumericWithDecimalValuesBehaviour/>
                    </custom:BorderlessEntry.Behaviors>

                </custom:BorderlessEntry>

              <inputLayout:SfTextInputLayout.TrailingView>
                 <custom:CustomLabel
                        Text="{x:Static ResourceManager:AppResources.ZSAR}"
                        Style="{StaticResource CaptionLabelGrey}" />
              </inputLayout:SfTextInputLayout.TrailingView>
        </inputLayout:SfTextInputLayout>

     </StackLayout>
     <!--#endregion TotalValue Field-->

     <!--  Currency Label  -->
     <StackLayout>
            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                <custom:CustomLabel.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static ResourceManager:AppResources.Currency}"/>
                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                    </FormattedString>
                </custom:CustomLabel.FormattedText>
            </custom:CustomLabel>

            <inputLayout:SfTextInputLayout
                        ContainerBackgroundColor="White"
                        ContainerType="Outlined"
                        ErrorColor="#B00020"
                        FocusedColor="{StaticResource NeutralGreay}"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="15"
                        UnfocusedColor="{StaticResource NeutralGreay}">

                <custom:BorderlessEntry
                        InputTransparent="True"
                        IsReadOnly="True"
                        Keyboard="Text"
                        Placeholder="{x:Static ResourceManager:AppResources.Select}"
                        Style="{StaticResource DefaultEntry}"
                        Text="{Binding SelectedCurrencie.Name}"
                        TextColor="#58595B">
                    <custom:BorderlessEntry.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCurrenciesCommand}" />
                    </custom:BorderlessEntry.GestureRecognizers>
                </custom:BorderlessEntry>

                <inputLayout:SfTextInputLayout.TrailingView>
                    <Image Aspect="AspectFit" Source="greyDropDown" />
                </inputLayout:SfTextInputLayout.TrailingView>

            </inputLayout:SfTextInputLayout>

            <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCurrenciesCommand}" />
            </StackLayout.GestureRecognizers>

        </StackLayout>

     <!-- Permit Label -->
    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
            <custom:CustomLabel.FormattedText>
                <FormattedString>
                        <Span Text="{x:Static ResourceManager:AppResources.CurrencyPermitLabel}"/>
                        <Span Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                </FormattedString>
            </custom:CustomLabel.FormattedText>
    </custom:CustomLabel>

    <Grid HeightRequest="100"
          ColumnDefinitions="*,15,*">

        <!--#region Yes Option-->
        <Grid Grid.Column="0">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectIsCurrencyPermitCommand}"
                                      CommandParameter="1"/>
            </Grid.GestureRecognizers>

            <Image Source="QSelected"
                    HeightRequest="136"
                    WidthRequest="171">

                <Image.Triggers>
                    <DataTrigger
                            TargetType="Image"
                            Binding="{Binding IsCurrencyPermit}"
                            Value="false">
                            <Setter Property="Source"  Value="QUnselected"/>
                    </DataTrigger>
                </Image.Triggers>

            </Image>

            <Label Text="{x:Static  ResourceManager:AppResources.ZYes}"
                   FontSize="16"
                   TextColor="#FFFFFF"
                   Margin="25,10,25,15"
                   VerticalOptions="EndAndExpand">
                <Label.Triggers>

                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCurrencyPermit}"
                                 Value="false">
                            <Setter Property="TextColor"
                                    Value="{StaticResource Primary}"/>
                    </DataTrigger>

                </Label.Triggers>
            </Label>

        </Grid>
        <!--#endregion Yes Option-->

        <!--#region NO Option-->
        <Grid Grid.Column="2">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectIsCurrencyPermitCommand}"
                                      CommandParameter="0"/>
            </Grid.GestureRecognizers>

            <Image Source="QUnselected.png"
               VerticalOptions="FillAndExpand">

                <Image.Triggers>

                    <DataTrigger TargetType="Image"
                                 Binding="{Binding IsCurrencyPermit}"
                                 Value="false">
                            <Setter Property="Source"
                                    Value="QSelected"/>
                    </DataTrigger>

                </Image.Triggers>
            </Image>

            <Label Text="{x:Static ResourceManager:AppResources.ZNo}"
                   TextColor="{StaticResource Primary}"
                   FontSize="16"
                   Margin="25,10,25,15"
                   VerticalOptions="EndAndExpand">

                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsCurrencyPermit}"
                                     Value="false">
                                <Setter Property="TextColor"
                                        Value="#FFFFFF"/>
                        </DataTrigger>
                    </Label.Triggers>
            </Label>
        </Grid>
        <!--#endregion NO Option-->

    </Grid>
    <!--#endregion Permit Label-->
                                  
    <!--#region Upload File-->
    <StackLayout IsVisible="{Binding IsCurrencyPermit}">

        <!--  Uploaded file Field  -->
        <StackLayout Spacing="0">

            <!--  Uploaded files Label  -->
            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                <custom:CustomLabel.FormattedText>
                    <FormattedString>
                        <Span Text="{x:Static ResourceManager:AppResources.Attachments}"/>
                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                    </FormattedString>
                </custom:CustomLabel.FormattedText>
            </custom:CustomLabel>

            <!--  Uploaded files Entry  -->
            <inputLayout:SfTextInputLayout
                ContainerBackgroundColor="White"
                ContainerType="Outlined"
                ErrorColor="#B00020"
                FocusedColor="{StaticResource NeutralGreay}"
                HelperText="{x:Static ResourceManager:AppResources.PDFFileHintMB}"
                InputViewPadding="16,0,16,0"
                LeadingViewPosition="Inside"
                OutlineCornerRadius="15"
                UnfocusedColor="{StaticResource NeutralGreay}"
                VerticalOptions="StartAndExpand">

                <custom:BorderlessEntry
                    InputTransparent="True"
                    IsReadOnly="True"
                    Keyboard="Text"
                    Placeholder="{x:Static ResourceManager:AppResources.Addattachments}"
                    Style="{StaticResource DefaultEntry}"
                    TextColor="#58595B" />

                <inputLayout:SfTextInputLayout.TrailingView>
                    <Image Aspect="AspectFit" Source="newui_ic_pdf" />
                </inputLayout:SfTextInputLayout.TrailingView>

                <inputLayout:SfTextInputLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CurrencyUploadFileCommand}" />
                </inputLayout:SfTextInputLayout.GestureRecognizers>

            </inputLayout:SfTextInputLayout>

            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CurrencyUploadFileCommand}" />
            </StackLayout.GestureRecognizers>

        </StackLayout>

        <!--  PDfUploaded List  -->
        <StackLayout  Spacing="0">

            <!--  Files List  -->
            <StackLayout
                x:Name="filesLst"
                BindableLayout.ItemsSource="{Binding CurrencyUploadedFiles}"
                Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <StackLayout x:Name="Item">

                            <!--  PDfUploaded Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    InputTransparent="True"
                                    Keyboard="Text"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding fileFullName}"
                                    TextColor="#58595B" />
                                <inputLayout:SfTextInputLayout.LeadingView>
                                    <Image Aspect="AspectFit" Source="Generic_attachment_icon" />
                                </inputLayout:SfTextInputLayout.LeadingView>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="reportClose.png">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"
                                                Command="{Binding DeleteAttatchementCommand}"
                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>

                            </inputLayout:SfTextInputLayout>
                        </StackLayout>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

        </StackLayout>

    </StackLayout>
    <!--#endregion Upload File-->
    
</StackLayout>

