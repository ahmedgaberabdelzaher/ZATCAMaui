<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.PopUpPages.EDeclarationTermsPopupPage"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    FlowDirection="{Binding AppDirection}">

    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

         <yummy:PancakeView
            Padding="20"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="490"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">
            <ScrollView VerticalScrollBarVisibility="Never" >
                 <StackLayout>

                    <!--#region Frame Contains Image and Text-->
                    <Frame HasShadow="False"
                           Padding="25"
                           CornerRadius="15"
                           BorderColor="#EBEBEB">

                        <StackLayout>
                            <!-- Header 1 Label  -->
                            <custom:CustomLabel
                                HorizontalOptions="Start"
                                FontSize="16"
                                FontFamily="{StaticResource SomarBold}"
                                TextColor="#002447"
                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderOne}"
                                VerticalOptions="Start" />

                            <!--  Notes Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="14"
                                LineHeight="1"
                                LineBreakMode="WordWrap"
                                TextColor="#002447">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsTwo}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsThree}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFour}" />
                                    </FormattedString>
                                </Label.FormattedText>

                            </Label>

                             <!-- Header 2 Label  -->
                            <custom:CustomLabel
                                HorizontalOptions="Start"
                                FontSize="16"
                                FontFamily="{StaticResource SomarBold}"
                                TextColor="#002447"
                                Text="{x:Static ResourceManager:AppResources.EDeclarationTermsHeaderTwo}"
                                VerticalOptions="Start" />

                            <!--  Notes Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="14"
                                LineHeight="1"
                                LineBreakMode="WordWrap"
                                TextColor="#002447">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsOne}" />
                                        <Span Text="&#10;" />
                                        <Span Text="•  " />
                                        <Span Text="{x:Static ResourceManager:AppResources.EDeclarationTermsFive}" />
                                    </FormattedString>
                                </Label.FormattedText>

                            </Label>

                        </StackLayout>
                         


                    </Frame>

                     <!--  Next Button  -->
                    <buttons:SfButton
                        Margin="0,20"
                        Command="{Binding GoToProductDeclarationCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontFamily="{StaticResource SomarBold}"
                        Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                </StackLayout>

            </ScrollView>

        </yummy:PancakeView>

    </Grid>
</pages:PopupPage>

