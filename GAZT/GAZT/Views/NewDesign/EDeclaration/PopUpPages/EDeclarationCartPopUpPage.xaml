<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.PopUpPages.EDeclarationCartPopUpPage"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:effects="clr-namespace:Plugin.myToolTip;assembly=Plugin.myToolTip"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT" xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    FlowDirection="{Binding AppDirection}">

    <pages:PopupPage.Resources>
        <converter:RemoveLastLineConverter x:Key="RemoveLastLineConverter" />
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="20"
            HeightRequest="500"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <ScrollView VerticalScrollBarVisibility="Never">

                <StackLayout Spacing="0" >

                    <!--#region Header & close-->
                    <StackLayout Orientation="Horizontal">

                        <!--  Checkout Header Label  -->
                        <custom:CustomLabel
                            HorizontalOptions="StartAndExpand"
                            FontSize="28"
                            Margin="0,0,0,20"
                            TextColor="#232323" 
                            Text="{x:Static ResourceManager:AppResources.Checkout}"
                            VerticalOptions="Center" />


                        <!--Close Image-->
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="25"
                            HorizontalOptions="EndAndExpand"
                            Source="darkClose"
                            VerticalOptions="Start"
                            WidthRequest="25">

                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseCartCommand}" />
                            </Image.GestureRecognizers>

                        </Image>

                    </StackLayout>
                    <!--#endregion Header & close-->

                    <!--#region Frame Contains Product list-->
                    <yummy:PancakeView 
                           Padding="0"
                           CornerRadius="15,15,0,0"
                           Style="{StaticResource CommonTopCurves}"
                           Border="{yummy:BorderMarkup Color=#EBEBEB,
                                                            Thickness='1'}">

                        <!--Frame Content-->
                        <StackLayout>

                            <!--  Product Name Label  -->
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                FontSize="18"
                                Padding="15"
                                TextColor="#002447" 
                                Text="{x:Static ResourceManager:AppResources.ProductName}"
                                VerticalOptions="Start" />

                            <!--  Horizontal Line  -->
                            <BoxView
                                WidthRequest="20"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="#E6E6E6"
                                HeightRequest="2" />

                            <!--#region Item List-->
                            <StackLayout Padding="15"
                                         x:Name="productList"
                                         BindableLayout.ItemsSource="{Binding CardData}">

                                 <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="0"
                                                  RowSpacing="0"
                                                  x:Name="selectedProduct"
                                                  RowDefinitions="Auto,Auto,Auto,Auto">

                                                <!--Delete Icon-->
                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="30"
                                                    HorizontalOptions="Start"
                                                    Source="ic_delete"
                                                    VerticalOptions="Start"
                                                    WidthRequest="30">

                                                    <Image.GestureRecognizers>
                                                          <TapGestureRecognizer
                                                                BindingContext="{Binding Source={x:Reference productList}, Path=BindingContext}"
                                                                Command="{Binding RemoveItemFromCardCommand}"
                                                                CommandParameter="{Binding Source={x:Reference selectedProduct}, Path=BindingContext}" />
                                                    </Image.GestureRecognizers>

                                                </Image>

                                                <StackLayout Grid.RowSpan="2"
                                                             Grid.ColumnSpan="2">

                                                    <!--Product name-->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Center"
                                                        FontSize="12"
                                                        Margin="10,0"
                                                        Grid.ColumnSpan="2"
                                                        TextColor="#565655"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Start" />

                                                    <!--Product Desc.-->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Center"
                                                        FontSize="12"
                                                        Grid.ColumnSpan="2"
                                                        Grid.Row="1"
                                                        TextColor="#999999"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding desc}"
                                                        VerticalOptions="Start" />

                                                </StackLayout>
                                                
                                                <StackLayout Grid.Row="2"
                                                             Grid.ColumnSpan="2"
                                                             HorizontalOptions="Start"
                                                             VerticalOptions="Start"
                                                             Orientation="Horizontal">

                                                    <!--QTY Icon-->
                                                    <Image
                                                        Aspect="AspectFit"
                                                        HorizontalOptions="Start"
                                                        Source="quantity"
                                                        VerticalOptions="Start"/>

                                                    <!--QTY Value-->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#232323"
                                                        VerticalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static ResourceManager:AppResources.QTY}"/>
                                                                <Span Text=": " />
                                                                <Span Text="{Binding QTY}"/>
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>

                                                    </custom:CustomLabel>

                                                </StackLayout>

                                                
                                                <StackLayout Grid.Row="2"
                                                            Grid.Column="2"
                                                            HorizontalOptions="Start"
                                                             VerticalOptions="Start"
                                                            Orientation="Horizontal">
                                                        

                                                     <!--Product Icon-->
                                                    <Image
                                                        Aspect="AspectFit"
                                                        HorizontalOptions="Start"
                                                        Source="product"
                                                        VerticalOptions="Start"/>

                                                    <!--Product Value-->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#232323"
                                                        VerticalOptions="Start" >

                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static ResourceManager:AppResources.TotalPriceValue}"/>
                                                                <Span Text=": " />
                                                                <Span Text="{Binding Price}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>

                                                    </custom:CustomLabel>

                                                </StackLayout>
                                               

                                                <!--Horizontal Line-->  
                                                <BoxView
                                                    Grid.Row="3"
                                                    Margin="0,10,0,0"
                                                    Grid.ColumnSpan="3"
                                                    VerticalOptions="EndAndExpand"
                                                    HorizontalOptions="FillAndExpand"
                                                    WidthRequest="20"
                                                    BackgroundColor="#B8BABA"
                                                    HeightRequest="2" />

                                            </Grid>

                                        </DataTemplate>

                                 </BindableLayout.ItemTemplate>
                            
                            </StackLayout>
                            <!--#endregion Item List-->

                        </StackLayout>
                    
                    </yummy:PancakeView>
                    <!--#endregion Frame Contains Product list-->

                    <!--#region Fees Details-->  
                    <StackLayout Spacing="10">

                        <!--Total Label-->
                        <Grid>

                            <yummy:PancakeView 
                                    CornerRadius="0,0,15,15"
                                    Opacity="0.1"
                                    VerticalOptions="FillAndExpand"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#0996D4"
                                    Style="{StaticResource CommonTopCurves}"
                                    Border="{yummy:BorderMarkup Color=#EBEBEB,
                                                                    Thickness='1'}"/>

                            <!--Total-->
                            <StackLayout Spacing="0"
                                         Padding="10"
                                         VerticalOptions="FillAndExpand"
                                         HorizontalOptions="FillAndExpand">

                                <StackLayout Orientation="Horizontal">

                                    <!--Total Label-->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="18"
                                        TextColor="#002447"
                                        Text="{x:Static ResourceManager:AppResources.NDTotal}"
                                        VerticalOptions="Start" />

                                    <!--Total Disclaimer Image-->
                                    <Image Source="info"
                                            Aspect="AspectFit"
                                            effects:ToolTipEffect.BackgroundColor="#1D3761"
                                            effects:ToolTipEffect.TextColor="White"
                                            effects:ToolTipEffect.TextSize="12"
                                            effects:ToolTipEffect.IsVisible="True"
                                            effects:ToolTipEffect.Padding="5"
                                            effects:ToolTipEffect.Position="Bottom"
                                            effects:ToolTipEffect.Text="{x:Static ResourceManager:AppResources.NDTotalDisclaimer}"/>

                                    <!--Price Label-->
                                    <custom:CustomLabel
                                        HorizontalOptions="EndAndExpand"
                                        FontSize="18"
                                        TextColor="Black"
                                        VerticalOptions="Start" >
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FeesCalculatorResponse.totalPayment}"/>
                                                <Span  Text="  " />
                                                <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                </StackLayout>

                            </StackLayout>

                        </Grid>

                        <!--Customsdeclarationissuancefees-->
                        <StackLayout Orientation="Horizontal">

                            <Label Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.Customsdeclarationissuancefees}" />

                            <Label Style="{StaticResource BodyLabelBlack}"
                                    HorizontalOptions="EndAndExpand">

                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding FeesCalculatorResponse.extraFees}" />
                                            <Span Text=" " />
                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>

                            </Label>

                        </StackLayout>

                        <!--ExciseTax2 Label-->
                        <StackLayout Orientation="Horizontal">
                      
                            <Label Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.ExciseTax2}" />

                            <Label Style="{StaticResource BodyLabelBlack}"
                                    HorizontalOptions="EndAndExpand">
                                    <Label.FormattedText>
                                        <FormattedString>
                                        <Span Text="{Binding FeesCalculatorResponse.excise}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                            </Label>

                        </StackLayout>

                        <!--CustomsFees-->
                        <StackLayout Orientation="Horizontal">
                      
                            <Label Style="{StaticResource BodyLabelGrey}">

                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.CustomsFees}" />
                                            <Span Text=" " />
                                            <Span Text="5%" />
                                        </FormattedString>
                                </Label.FormattedText>

                            </Label>

                            <!--CustomsFeesDisclaimer Image-->
                            <Image Source="info"
                                   Aspect="AspectFit"
                                   effects:ToolTipEffect.BackgroundColor="#1D3761"
                                   effects:ToolTipEffect.TextColor="White"
                                   effects:ToolTipEffect.TextSize="12"
                                   effects:ToolTipEffect.IsVisible="True"
                                   effects:ToolTipEffect.Padding="5"
                                   effects:ToolTipEffect.Position="Bottom"
                                   effects:ToolTipEffect.Text="{x:Static ResourceManager:AppResources.CustomsdeclarationDisclaimer}"/>

                            <Label Style="{StaticResource BodyLabelBlack}"
                                    HorizontalOptions="EndAndExpand">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding FeesCalculatorResponse.totalDuty}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                        </StackLayout>

                        <!--VATCertificates-->
                        <StackLayout Orientation="Horizontal">

                            <Label Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATCertificates}" >

                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.VATCertificates}" />
                                            <Span Text=" " />
                                            <Span Text="15%" />
                                        </FormattedString>
                                </Label.FormattedText>

                            </Label>

                            <!--VATCertificates Image-->
                            <Image Source="info"
                                   Aspect="AspectFit"
                                   effects:ToolTipEffect.BackgroundColor="#1D3761"
                                   effects:ToolTipEffect.TextColor="White"
                                   effects:ToolTipEffect.TextSize="12"
                                   effects:ToolTipEffect.IsVisible="True"
                                   effects:ToolTipEffect.Padding="5"
                                   effects:ToolTipEffect.Position="Bottom"
                                   effects:ToolTipEffect.Text="{x:Static ResourceManager:AppResources.VATCertificatesDisclaimer}"/>

                            <Label HorizontalOptions="EndAndExpand"
                                    Style="{StaticResource BodyLabelBlack}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding FeesCalculatorResponse.vat}" />
                                        <Span Text=" " />
                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                        </StackLayout>

                    </StackLayout>
                    <!--#endregion Fees Details-->

                    <!--  Close Button  -->
                    <buttons:SfButton
                        Margin="0,20"
                        Command="{Binding CloseCartCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontFamily="{StaticResource SomarBold}"
                        Text="{x:Static ResourceManager:AppResources.ZClose}" />

                </StackLayout>

            </ScrollView>

        </yummy:PancakeView>

     </Grid>

</pages:PopupPage>

