<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.PopUpPages.EDeclarationCartPopUpPage"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    FlowDirection="{Binding AppDirection}">

    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

    <Grid VerticalOptions="EndAndExpand">

        <yummy:PancakeView
            Padding="20"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            HeightRequest="490"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <StackLayout Spacing="0" >

               <!--#region Header & close-->
               <StackLayout Orientation="Horizontal">

                    <!--  Checkout Header Label  -->
                    <custom:CustomLabel
                        HorizontalOptions="StartAndExpand"
                        FontSize="28"
                        Margin="0,0,0,20"
                        TextColor="#232323" 
                        Text="{x:Static ResourceManager:AppResources.Checkout}"
                        VerticalOptions="Center" />


                    <!--Close Image-->
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="25"
                        HorizontalOptions="EndAndExpand"
                        Source="darkClose"
                        VerticalOptions="Start"
                        WidthRequest="25">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseCartCommand}" />
                        </Image.GestureRecognizers>

                    </Image>

                </StackLayout>
               <!--#endregion Header & close-->

                <!--#region Frame Contains Product list-->
                <yummy:PancakeView 
                       Padding="0"
                       CornerRadius="15,15,0,0"
                       Style="{StaticResource CommonTopCurves}"
                       Border="{yummy:BorderMarkup Color=#EBEBEB,
                                                        Thickness='1'}">

                    <!--Frame Content-->
                    <StackLayout>

                        <!--  Product Name Label  -->
                        <custom:CustomLabel
                            HorizontalOptions="StartAndExpand"
                            FontSize="18"
                            Padding="15"
                            TextColor="#002447" 
                            Text="{x:Static ResourceManager:AppResources.ProductName}"
                            VerticalOptions="Start" />

                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            HorizontalOptions="FillAndExpand"
                            BackgroundColor="#E6E6E6"
                            HeightRequest="2" />

                        <!--#region Item List-->
                        <ScrollView HeightRequest="200"
                                    VerticalScrollBarVisibility="Never">

                            <StackLayout Padding="15"
                                     BindableLayout.ItemsSource="{Binding TestData}">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate>

                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="30"
                                            RowDefinitions="Auto,Auto,Auto">

                                            <!--Delete Icon-->
                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="35"
                                                HorizontalOptions="Start"
                                                Source="ic_delete"
                                                Grid.RowSpan="2"
                                                VerticalOptions="Start"
                                                WidthRequest="35"/>

                                            <!--Product name-->
                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                FontSize="14"
                                                Grid.Column="1"
                                                TextColor="#565655"
                                                LineBreakMode="WordWrap"
                                                Text="Batteries for electronic smoking devices and tools"
                                                VerticalOptions="Start" />

                                            <!--Product Desc.-->
                                            <custom:CustomLabel
                                                HorizontalOptions="StartAndExpand"
                                                FontSize="14"
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                TextColor="#999999"
                                                LineBreakMode="WordWrap"
                                                Text="TMBAK PSOIQATH AND HIS VEINS RAW OR NON-FACTORY (1KG)"
                                                VerticalOptions="Start" />

                                            <!--Price-->
                                            <custom:CustomLabel
                                                HorizontalOptions="Start"
                                                FontSize="16"
                                                Grid.Column="2"
                                                Grid.RowSpan="2"
                                                TextColor="#232323"
                                                Text="800"
                                                VerticalOptions="Start" />

                                            <!--Horizontal Line-->  
                                            <BoxView
                                                Grid.Row="2"
                                                Grid.ColumnSpan="3"
                                                VerticalOptions="EndAndExpand"
                                                HorizontalOptions="FillAndExpand"
                                                WidthRequest="20"
                                                BackgroundColor="#B8BABA"
                                                HeightRequest="2" />

                                    </Grid>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>
                            
                            </StackLayout>

                        </ScrollView>
                            
                        <!--#endregion Item List-->

                    </StackLayout>
                    
                </yummy:PancakeView>
                <!--#endregion Frame Contains Product list-->

                <!--#region Total Price-->
                <Grid>

                     <yummy:PancakeView 
                       CornerRadius="0,0,15,15"
                       Opacity="0.1"
                       BackgroundColor="#0996D4"
                       Style="{StaticResource CommonTopCurves}"
                       Border="{yummy:BorderMarkup Color=#EBEBEB,
                                                        Thickness='1'}"/>

                    <StackLayout Orientation="Horizontal"
                                 Padding="15"
                                 VerticalOptions="FillAndExpand"
                                HorizontalOptions="FillAndExpand">

                        <!--Product Desc.-->
                        <custom:CustomLabel
                            HorizontalOptions="StartAndExpand"
                            FontSize="18"
                            TextColor="#002447"
                            Text="Total"
                            VerticalOptions="Start" />

                        <!--Price-->
                        <custom:CustomLabel
                            HorizontalOptions="EndAndExpand"
                            FontSize="18"
                            TextColor="Black"
                            Text="800 SAR"
                            VerticalOptions="Start" />

                    </StackLayout>

                </Grid>
                <!--#endregion Total Price-->

                <!--  Next Button  -->
                <buttons:SfButton
                    Margin="0,20"
                    Command="{Binding CloseCartCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontFamily="{StaticResource SomarBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZNext}" />

            </StackLayout>

        </yummy:PancakeView>

     </Grid>

</pages:PopupPage>

