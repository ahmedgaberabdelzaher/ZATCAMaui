                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  PDfUploaded List  -->
                        <StackLayout  Spacing="0">
                            <!--  Files List  -->
                            <StackLayout
                                x:Name="filesLst"
                                BindableLayout.ItemsSource="{Binding UploadedFiles}"
                                Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout x:Name="Item">

                                            <!--  PDfUploaded Entry  -->
                                            <inputLayout:SfTextInputLayout
                                                ContainerBackgroundColor="White"
                                                ContainerType="Outlined"
                                                ErrorColor="#B00020"
                                                FocusedColor="{StaticResource NeutralGreay}"
                                                InputViewPadding="16,0,16,0"
                                                LeadingViewPosition="Inside"
                                                OutlineCornerRadius="15"
                                                UnfocusedColor="{StaticResource NeutralGreay}">
                                                <custom:BorderlessEntry
                                                    IsReadOnly="True"
                                                    Keyboard="Text"
                                                    Style="{StaticResource DefaultEntry}"
                                                    Text="{Binding fileFullName}"
                                                    TextColor="#58595B" />
                                                <inputLayout:SfTextInputLayout.LeadingView>
                                                    <Image Aspect="AspectFit" Source="Generic_attachment_icon" />
                                                </inputLayout:SfTextInputLayout.LeadingView>

                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image Aspect="AspectFit" Source="reportClose.png">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"
                                                                Command="{Binding DeleteAttatchementCommand}"
                                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </inputLayout:SfTextInputLayout.TrailingView>

                                            </inputLayout:SfTextInputLayout>
                                        </StackLayout>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>

                        </StackLayout>
 </StackLayout>
                                <!--#endregion-->

                            </StackLayout>
                    
                        <!--#endregion-->

                        </StackLayout> 
                         <!--#endregion-->   
                        <!--#region Submit and Card-->
                        <StackLayout IsVisible="{Binding IsYesSelected}">
                            <!--  Add Item Button  -->
                            <buttons:SfButton
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.AddItem}" />

                            <!--Card Frame -->
                            <Frame Padding="10"
                               BackgroundColor="{StaticResource Primary}"
                               VerticalOptions="StartAndExpand"
                               HorizontalOptions="FillAndExpand"
                               CornerRadius="10">

                                <StackLayout
                                Orientation="Horizontal"
                                Spacing="10">

                                    <Frame Padding="10"
                                      BackgroundColor="White"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Start"
                                      CornerRadius="10">

                                        <!--  Total Number Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" FontFamily="{StaticResource SomarRegular}"  FontSize="14">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FeesCalculatorResponse.totalPayment}"/>
                                                    <Span  Text="  " />
                                                    <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </Frame>

                                    <!--  Total Fees Payable Label  -->
                                    <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    HorizontalOptions="End" VerticalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                    TextColor="White" />

                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCartCommand}"></TapGestureRecognizer>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </StackLayout>
                        <!--#endregion-->
                        <!-- GoTo Second Product Declaration Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            VerticalOptions="EndAndExpand"
                            Command="{Binding NextCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                        <!--  Prevoius Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            TextColor="{StaticResource Secondary}"
                            Command="{Binding PrevoiusCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PerviousButton}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->
            <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet Grid.Row="1" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />
        
        </Grid>
    </ContentPage.Content>
</ContentPage>

