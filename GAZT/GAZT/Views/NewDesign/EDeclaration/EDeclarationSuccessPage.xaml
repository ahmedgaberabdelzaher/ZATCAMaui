<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.EDeclarationSuccessPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:controls="clr-namespace:EGAZT.Controls"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
     <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
         <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="Auto">

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="CenterAndExpand"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}" 
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    VerticalOptions="CenterAndExpand" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand">

                        <!--  Success icon  -->
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="150"
                            Source="darkSucces"
                            WidthRequest="150" />

                        <!--  Success Msg1 Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="28"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            Text="{x:Static ResourceManager:AppResources.CreatedSuccessfully}"
                            TextColor="#002447" />

                        <!--  Success Msg2 Label  -->
                        <Label
                            FontFamily="{StaticResource SomarSemiBold}"
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Text="{x:Static ResourceManager:AppResources.CreatedSuccessfullyMsg}"
                            TextColor="#002447" />

                        <!--#region Disclaimer-->
                        <Frame  Padding="5"
                                CornerRadius="8"
                                Margin="0,0,0,5"
                                BorderColor="#FCECCD"
                                BackgroundColor="#FCECCD"
                                Style="{StaticResource CommonTopCurves}">

                            <StackLayout Orientation="Horizontal"
                                         Spacing="8">

                                <!--Check Mark Image-->
                                 <Image Aspect="AspectFit"
                                       Source="OrangeCircle"/>

                                <!--Feedback Name Label-->
                                 <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding TravelerDeclarationResponse.FeedbackName}"
                                    TextColor="#F5BF58" />

                            </StackLayout>

                        </Frame>
                        <!--#endregion Disclaimer-->

                        <!--#region Frame Declaration Values-->
                        <Frame 
                            Padding="15"
                            Margin="0,0,0,10"
                            CornerRadius="15"
                            BorderColor="#EBEBEB"
                            Style="{StaticResource CommonTopCurves}">

                            <!--Frame Content-->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal"
                                                Spacing="0">

                                    <!--Doc Image-->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25"/>

                                    <!--  Declaration Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="20"
                                        Padding="10"
                                        TextColor="#002447" 
                                        Text="{x:Static ResourceManager:AppResources.FORM5Declaration}"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    WidthRequest="20"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2" />

                                <!--#region Declaration Values -->
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                        RowSpacing="15"
                                        ColumnDefinitions="2*,*">

                                    <!-- Reference number Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmentReferenceNumber}"
                                        VerticalOptions="Start" >

                                         <custom:CustomLabel.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CopyCommand}"/>
                                         </custom:CustomLabel.GestureRecognizers>

                                    </custom:CustomLabel>

                                    <!--  Reference number value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding TravelerDeclarationResponse.ReferenceID}"
                                        VerticalOptions="Start" >

                                        <custom:CustomLabel.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CopyCommand}"/>
                                        </custom:CustomLabel.GestureRecognizers>

                                    </custom:CustomLabel>

                                    <!--  Payment Status Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        IsVisible="{Binding TravelerDeclarationResponse.paymentIsRequired}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="1"
                                        Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentPaymentStatus}"
                                        VerticalOptions="Start" />

                                    <!--  Payment status value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        IsVisible="{Binding TravelerDeclarationResponse.paymentIsRequired}"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="1"
                                        VerticalOptions="Start" >

                                        <custom:CustomLabel.Triggers>
                                            <DataTrigger Binding="{Binding TravelerDeclarationResponse.IsNotPaid}"
                                                         TargetType="custom:CustomLabel"
                                                         Value="True">
                                                <Setter Property="Text"
                                                        Value="{x:Static ResourceManager:AppResources.NotPaidPaymentStatus}"/>

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding TravelerDeclarationResponse.IsNotPaid}"
                                                         TargetType="custom:CustomLabel"
                                                         Value="false">
                                                <Setter Property="Text"
                                                        Value="{x:Static ResourceManager:AppResources.PaidPaymentStatus}"/>

                                            </DataTrigger>

                                        </custom:CustomLabel.Triggers>

                                    </custom:CustomLabel>


                                    <!--  Name Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="2"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.ZZName}"
                                        VerticalOptions="Start" />

                                    <!--  Name value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Text="{Binding TravelerDeclarationResponse.fullName}"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="3"
                                        Text="{x:Static ResourceManager:AppResources.TravellerPassport}"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="3"
                                        Text="{Binding TravelerDeclarationResponse.travelID}"
                                        VerticalOptions="Start" />



                                    <!--  Coming/Going from/to Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="4"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999"
                                        Text="{x:Static ResourceManager:AppResources.ArrivingFromORDepartingTo}"
                                        VerticalOptions="Start" />

                                    <!--  Coming/Going from/to Value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Grid.Row="4"
                                        Text="{Binding TravelerDeclarationResponse.ArrivingName}"
                                        VerticalOptions="Start" />

                                    <!--  Port Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="5"
                                        Text="{x:Static ResourceManager:AppResources.Port}"
                                        VerticalOptions="Start" />

                                    <!--  Port value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="5"
                                        Text="{Binding TravelerDeclarationResponse.PortName}"
                                        VerticalOptions="Start" />



                                    <!--  Trip number Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999"
                                        Grid.Row="6"
                                        Text="{x:Static ResourceManager:AppResources.TripNumber}"
                                        VerticalOptions="Start" />

                                    <!--  Trip number value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding TravelerDeclarationResponse.flightNumber}"
                                        Grid.Row="6"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="7"
                                        Text="{x:Static ResourceManager:AppResources.TripDate}"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="7"
                                        Text="{Binding TravelerDeclarationResponse.TravelDateString}"
                                        VerticalOptions="Start" />

                                </Grid>
                                <!--#endregion Declaration Values-->

                            </StackLayout>
                    
                         </Frame>
                         <!--#endregion Frame Declaration Values-->

                        <!--#region Frame Contains Total Fees-->
                        <Frame 
                            Padding="15"
                            CornerRadius="15"
                            Margin="0,0,0,10"
                            BorderColor="#EBEBEB"
                            Style="{StaticResource CommonTopCurves}">

                            <!--Frame Content-->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal"
                                                Spacing="0">

                                    <!--Doc Image-->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25"/>

                                    <!--  Total fees Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="20"
                                        Padding="10"
                                        TextColor="#002447" 
                                        Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    WidthRequest="20"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2" />

                                <!--#region Total Product Fees Values -->
                                <StackLayout x:Name="totalFeesList"
                                            BindableLayout.ItemsSource="{Binding TotalFeesList}">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate>

                                               <!-- Items List-->
                                                <Grid RowDefinitions="Auto,Auto"
                                                        ColumnDefinitions="*,*">

                                                    <!--  Item Name Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#999999"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Start" />

                                                    <!--  Count value Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="End"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#002447"
                                                        Grid.Column="1"
                                                        Text="{Binding Id}"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        VerticalOptions="Start" />

                                                </Grid>
                                               
                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </StackLayout>
                                <!--#endregion Total Product Fees Values-->

                                 <Grid ColumnDefinitions="2*,*">

                                    <!--  Total amount Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Text="{x:Static ResourceManager:AppResources.TotalAmount}"
                                        VerticalOptions="Start" />

                                    <!--  Total amount value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="End"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        VerticalOptions="Start" >
                                         <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding TravelerDeclarationResponse.totalFees}"/>
                                                <Span  Text="  " />
                                                <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>

                                    </custom:CustomLabel>

                                 </Grid>
                              
                            </StackLayout>
                    
                        </Frame>
                        <!--#endregion Frame Contains Total Fees-->

                        <!--#region Frame Contains Details Fees-->
                        <Frame 
                            Padding="15"
                            CornerRadius="15"
                            Margin="0,0,0,15"
                            BorderColor="#EBEBEB"
                            Style="{StaticResource CommonTopCurves}">

                            <!--Frame Content-->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal"
                                                Spacing="0">

                                    <!--Doc Image-->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25"/>

                                    <!--  Details Total fees Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="20"
                                        Padding="10"
                                        TextColor="#002447" 
                                        Text="{x:Static ResourceManager:AppResources.DetailsTotalFeesPayable}"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    WidthRequest="20"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2" />

                                <!--#region Details Fees Values -->
                                <StackLayout BindableLayout.ItemsSource="{Binding DetailsTotalFeesList}">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate>

                                               <!-- Items List-->
                                                <Grid RowDefinitions="Auto,Auto"
                                                        ColumnDefinitions="*,*">

                                                    <!--  Item Name Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#999999"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Start" />

                                                    <!--   Value Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="End"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#002447"
                                                        Grid.Column="1"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        VerticalOptions="Start" >
                                                       <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Id}"/>
                                                                <Span  Text="  " />
                                                                <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>

                                                </custom:CustomLabel>

                                                </Grid>
                                               
                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </StackLayout>
                                 <!--#endregion Payment Values-->
                            </StackLayout>
                    
                        </Frame>
                        <!--#endregion Frame Contains Fees-->

                        <!--  Pay Now Button  -->
                        <buttons:SfButton
                            IsVisible="{Binding IsPaymentRequired}" 
                            BackgroundColor="#0996D4"
                            BorderColor="#0996D4"
                            BorderWidth="1"
                            Command="{Binding GoToPaymentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                            TextColor="White" />

                        <!--  DownLoad Pdf Button  -->
                        <buttons:SfButton
                            BackgroundColor="#0996D4"
                            BorderColor="#0996D4"
                            TextColor="White"
                            Command="{Binding DownlOadFileCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.DownloadEdecleraton}" />

                        <!--  Back to Home Button  -->
                        <buttons:SfButton
                            BackgroundColor="Transparent"
                            TextColor="#0996D4"
                            Command="{Binding BackToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.BackToHome}" />

                    </StackLayout>

                </ScrollView>


            </yummy:PancakeView>
            <!--#endregion Body-->
            <controls:Loader Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}"></controls:Loader>
        </Grid>
    </ContentPage.Content>
</ContentPage>

