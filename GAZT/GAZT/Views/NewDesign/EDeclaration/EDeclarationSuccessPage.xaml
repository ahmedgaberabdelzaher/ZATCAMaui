<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.EDeclarationSuccessPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
     <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
         <Grid RowDefinitions="3*,2*">

            <!--#region Header-->
            <StackLayout>

                <!--  Success Icon and Msg  -->
                <StackLayout
                    HorizontalOptions="Start"
                    Spacing="10"
                    VerticalOptions="CenterAndExpand">

                    <!--  Success icon  -->
                    <Image
                        Margin="0,0,0,30"
                        Aspect="AspectFit"
                        HeightRequest="150"
                        Source="Forget_ic_success"
                        WidthRequest="150" />

                    <!--  Success Msg1 Label  -->
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.CreatedSuccessfully}"
                        TextColor="White" />

                    <!--  Success Msg2 Label  -->
                    <Label
                        Margin="40,0"
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="18"
                        HorizontalOptions="CenterAndExpand"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{x:Static ResourceManager:AppResources.CreatedSuccessfullyMsg}"
                        TextColor="White" />

                </StackLayout>


            </StackLayout>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Spacing="40">

                        <!--  EDeclaration Frame  -->
                        <yummy:PancakeView
                            Border="{yummy:BorderMarkup Color=#EBEBEB,
                                                        Thickness='1'}"
                            CornerRadius="15"
                            Style="{StaticResource CommonTopCurves}"
                            VerticalOptions="Start">

                            <StackLayout Orientation="Horizontal" Spacing="10">

                                <!--  Refernce Number Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Referencenumber}"
                                    TextColor="{StaticResource NeutralGreay}" />

                                <!--  Refernce Number Result Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding TravelerDeclarationResponse.ReferenceID}"
                                    TextColor="#58595B" />

                                <!--  Report icon  -->
                                <Image
                                    HorizontalOptions="End"
                                    Source="zakat_copy"
                                    Style="{StaticResource SmallIcon}" />

                            </StackLayout>

                        </yummy:PancakeView>

                        <!--  Pay Now Button  -->
                        <buttons:SfButton IsVisible="{Binding IsPaymentRequired}" 
                            BackgroundColor="#0996D4"
                            BorderColor="#0996D4"
                            BorderWidth="1"
                            Command="{Binding GoToPaymentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                            TextColor="White" />

                        <!--  Back to Home Button  -->
                        <buttons:SfButton
                            BackgroundColor="Transparent"
                            TextColor="#0996D4"
                            Command="{Binding BackToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.BackToHome}" />

                    </StackLayout>

                </ScrollView>


            </yummy:PancakeView>
            <!--#endregion Body-->

        </Grid>
    </ContentPage.Content>
</ContentPage>

