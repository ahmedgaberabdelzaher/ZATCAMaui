<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.InfoPages.PassengerInformationPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
                <ResourceDictionary>
                    <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

     <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingInfoPagesCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,10" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}" 
                    Text="{Binding HeaderTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand">

                        <!--Circle view-->
                        <Grid RowDefinitions="Auto"
                              Margin="0,30"
                              ColumnSpacing="0"
                              VerticalOptions="Start"
                              HorizontalOptions="CenterAndExpand"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                            <!--Circle button 1-->
                            <ImageButton 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    BorderWidth="1"
                                    InputTransparent="True"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="EndAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Padding="5"
                                    Source="reportCheckMark.png"/>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="1"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 2-->
                             <ImageButton 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="2"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Padding="5"
                                    Source="reportCheckMark.png"/>



                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="3"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 3-->
                            <ImageButton 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="4"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Padding="5"
                                    Source="reportCheckMark.png"/>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="5"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 4-->
                             <Button 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="6"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#0996D4"
                                    BackgroundColor="Transparent"
                                    TextColor="#0996D4"
                                    Text="4">
                                 <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="7"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2" />

                            <!--Circle button 5-->
                            <Button 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="8"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#B8BABA"
                                    BackgroundColor="Transparent"
                                    TextColor="#565655"
                                    Text="5">
                                 <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                             </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="9"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2" />

                            <!--Circle button 6-->
                            <Button 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="10"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#B8BABA"
                                    BackgroundColor="Transparent"
                                    TextColor="#565655"
                                    Text="6">
                                 <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                        </Grid>

                        <!--  Passenger Information Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.PassengerInformation}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Passenger Note Label  -->
                         <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                             FontSize="16"
                                             LineSpacing="1"
                                             LineBreakMode="WordWrap"
                                             Margin="0,0,0,5">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.NewDeclarationNote}"
                                              TextColor="{StaticResource NeutralGreay}"/>

                                        <Span TextColor="{StaticResource Primary}"
                                              Text="{x:Static ResourceManager:AppResources.CustomDeclarationInformation}"/>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>

                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCustomInformationLinkCommand}"/>
                                </custom:CustomLabel.GestureRecognizers>

                         </custom:CustomLabel>


                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />

                        <!--#region Cards-->
                        <StackLayout HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
                                     Spacing="10"
                                     Padding="5"
                                     IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                     HeightRequest="100"
                                     Margin="0,0,0,5"
                                     Orientation="Horizontal">

                            <!--Passport Card-->
                            <Grid
                                WidthRequest="171"
                                HeightRequest="94"
                                VerticalOptions="StartAndExpand"
                                HorizontalOptions="StartAndExpand">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                       Source="QSelected.png">

                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsYesSelected}"
                                            TargetType="Image"
                                            Value="True">
                                            <Setter Property="Source" Value="QSelected.png"/>
                                        </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsYesSelected}"
                                                TargetType="Image"
                                                Value="False">
                                                <Setter Property="Source" Value="QUnselected.png"/>
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>

                                <!--  Passport Label  -->
                                <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="EndAndExpand"
                                        FontSize="16"
                                        Padding="15"
                                        TextColor="White"
                                        Text="{x:Static ResourceManager:AppResources.Passport}">

                                    <custom:CustomLabel.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsYesSelected}"
                                            TargetType="custom:CustomLabel"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsYesSelected}"
                                            TargetType="custom:CustomLabel"
                                            Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                        </DataTrigger>


                                    </custom:CustomLabel.Triggers>

                                    </custom:CustomLabel>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IDSelectionCommand}"
                                                          CommandParameter="4"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--National ID card-->
                            <Grid Padding="5"
                                  WidthRequest="171"
                                  HeightRequest="94">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                        Source="QUnselected.png">

                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsYesSelected}"
                                            TargetType="Image"
                                            Value="False">
                                                <Setter Property="Source" Value="QSelected.png"/>
                                        </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsYesSelected}"
                                                TargetType="Image"
                                                Value="True">
                                                <Setter Property="Source" Value="QUnselected.png"/>
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>

                               
                                 <!--National ID label-->
                                 <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="EndAndExpand"
                                        FontSize="16"
                                        Padding="15"
                                        TextColor="{StaticResource Primary}"
                                        Text="{x:Static ResourceManager:AppResources.GccNationalID}">

                                        <custom:CustomLabel.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsYesSelected}"
                                                TargetType="custom:CustomLabel"
                                                Value="False">
                                                    <Setter Property="TextColor" Value="White"/>
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsYesSelected}"
                                                TargetType="custom:CustomLabel"
                                                Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                            </DataTrigger>
                                        </custom:CustomLabel.Triggers>
                                    </custom:CustomLabel>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding IDSelectionCommand}"
                                                          CommandParameter="16"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                        </StackLayout>
                        <!--#endregion Cards-->

                        <!--  First Name Field  -->
                        <StackLayout Spacing="0">

                            <!--  First Name Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZZVATRFirstName}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  First Name Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ZZZVATRFirstName}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.firstName}"
                                    TextColor="#58595B" />
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                        <!--  Middle Name Field  -->
                        <StackLayout Spacing="0">

                            <!--  Middle Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.MiddleName}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Middle Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.MiddleName}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.middleName}"
                                    TextColor="#58595B" />
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                        <!--  Last Name Field  -->
                        <StackLayout Spacing="0">

                            <!--  Last Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ESTLastNameLabel}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Last Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ESTLastNameLabel}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.lastName}"
                                    TextColor="#58595B" />
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                        <!--  Nationality Field  -->
                        <StackLayout Spacing="0">

                            <!--  Nationality Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.PassengerNationality}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Nationality Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.PassengerNationality}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.NationalityName}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenNationalityCommand}" />
                                    </custom:BorderlessEntry.GestureRecognizers>
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenNationalityCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  ID Number Field  -->
                        <StackLayout Spacing="0">

                            <!--  ID Number Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding IDName}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  ID Number Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="{Binding IDNumberKeyboard}"
                                    Placeholder="{Binding IDNumberPlaceHolder}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.travelID}"
                                    TextColor="#58595B" />
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                        <!--  Gender Label  -->
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTGenderLabel}"/>
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <!--#region Gender Cards-->
                        <!--In case visitor-->
                        <StackLayout VerticalOptions="FillAndExpand"
                                     HorizontalOptions="FillAndExpand"
                                     IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                     Spacing="10"
                                     Padding="5"
                                     HeightRequest="100"
                                     Margin="0,0,0,5"
                                     Orientation="Horizontal">

                            <!--Male card-->
                            <Grid Padding="5"
                                  HeightRequest="94"
                                  WidthRequest="171">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                       Source="QSelected.png">

                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsMaleSelected}"
                                            TargetType="Image"
                                            Value="True">
                                            <Setter Property="Source" Value="QSelected.png"/>
                                        </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsMaleSelected}"
                                                TargetType="Image"
                                                Value="False">
                                                <Setter Property="Source" Value="QUnselected.png"/>
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>

                                <!--Male label-->

                                <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="EndAndExpand"
                                        FontSize="16"
                                        Padding="15"
                                        TextColor="White"
                                        Text="{x:Static ResourceManager:AppResources.ESTMaleLabel}">

                                    <custom:CustomLabel.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsMaleSelected}"
                                            TargetType="custom:CustomLabel"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding IsMaleSelected}"
                                            TargetType="custom:CustomLabel"
                                            Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                        </DataTrigger>


                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GenderSelectionCommand}"
                                                          CommandParameter="1"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                            <!--Female Card-->
                            <Grid
                                 HeightRequest="94"
                                 WidthRequest="171"
                                 VerticalOptions="StartAndExpand"
                                 HorizontalOptions="StartAndExpand">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                       Source="QUnselected.png">

                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsMaleSelected}"
                                            TargetType="Image"
                                            Value="False">
                                                <Setter Property="Source" Value="QSelected.png"/>
                                        </DataTrigger>

                                        <DataTrigger
                                                Binding="{Binding IsMaleSelected}"
                                                TargetType="Image"
                                                Value="True">
                                                <Setter Property="Source" Value="QUnselected.png"/>
                                        </DataTrigger>

                                    </Image.Triggers>

                                </Image>

                                <!--  Female Label  -->
                                <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="EndAndExpand"
                                        FontSize="16"
                                        Padding="15"
                                        TextColor="{StaticResource Primary}"
                                        Text="{x:Static ResourceManager:AppResources.ESTFemaleLabel}">

                                       <custom:CustomLabel.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsMaleSelected}"
                                                TargetType="custom:CustomLabel"
                                                Value="False">
                                                    <Setter Property="TextColor" Value="White"/>
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsMaleSelected}"
                                                TargetType="custom:CustomLabel"
                                                Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                            </DataTrigger>
                                        </custom:CustomLabel.Triggers>

                                </custom:CustomLabel>

                                <Grid.GestureRecognizers>
                                     <TapGestureRecognizer Command="{Binding GenderSelectionCommand}"
                                                           CommandParameter="2"/>
                                </Grid.GestureRecognizers>

                            </Grid>


                        </StackLayout>

                        <!--In case not visitor-->
                        <StackLayout Spacing="0"
                                    IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}">

                            <!--  Gender Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.ESTGenderLabel}"
                                    Style="{StaticResource DefaultEntry}"
                                    TextColor="#58595B" >
                                    <custom:BorderlessEntry.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SubmitModel.travelerDeclaration.gender}"
                                            TargetType="custom:BorderlessEntry"
                                            Value="1">
                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ESTMaleLabel}" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding SubmitModel.travelerDeclaration.gender}"
                                            TargetType="custom:BorderlessEntry"
                                            Value="2">
                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ESTFemaleLabel}" />
                                        </DataTrigger>

                                    </custom:BorderlessEntry.Triggers>

                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>
                        <!--#endregion Gender Cards-->

                        <!--  Its Source Field  -->
                        <StackLayout Spacing="0">

                            <!--  Its Source Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ItsSource}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Its Source Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Placeholder="{x:Static ResourceManager:AppResources.ItsSource}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.travelIssuerName}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenItsSourceCommand}" />
                                    </custom:BorderlessEntry.GestureRecognizers>
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenItsSourceCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                         <!--  Release Date Field  -->
                        <StackLayout Spacing="0">

                            <!--  Release Date Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ReleaseDate}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <!--  Release Date Label  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                InputViewPadding="16,0,16,0"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                UnfocusedColor="{StaticResource NeutralGreay}">

                                <Grid>

                                    <DatePicker Date="{Binding SubmitModel.travelerDeclaration.passIssuingDate}"
                                                Format="dd/MM/yyyy"
                                                x:Name="ReleaseDate"
                                                IsVisible="false"
                                                MaximumDate="{Binding MaximumDate}">

                                        <DatePicker.Behaviors>
                                            <xct:EventToCommandBehavior Command="{Binding SelectedDateCommand}"
                                                                        CommandParameter="{x:Reference releaseDateEntry}"
                                                                        EventName="DateSelected" />
                                        </DatePicker.Behaviors>

                                    </DatePicker>

                                    <custom:BorderlessEntry
                                            Keyboard="Text"
                                            IsReadOnly="True"
                                            InputTransparent="True"
                                            Placeholder="dd/MM/yyyy"
                                            x:Name="releaseDateEntry"
                                            ClassId="releasedateentry"
                                            Text="{Binding ReleaseDateString}"
                                            Style="{StaticResource DefaultEntry}"
                                            TextColor="#58595B" />
                                </Grid>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyCalender" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DateClickedCommand}"
                                                              CommandParameter="{x:Reference ReleaseDate}"/>
                                </inputLayout:SfTextInputLayout.GestureRecognizers>

                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                         <!--  End Date Field  -->
                        <StackLayout Spacing="0">

                            <!--  End Date Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ESTExpiryDateLabel}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <!--  End Date Label  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                FocusedColor="{StaticResource NeutralGreay}"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                InputViewPadding="16,0,16,0"
                                UnfocusedColor="{StaticResource NeutralGreay}">

                                 <Grid>

                                    <DatePicker Date="{Binding SubmitModel.travelerDeclaration.passExpiryDate}"
                                                Format="dd/MM/yyyy"
                                                x:Name="EndDate"
                                                IsVisible="false"
                                                MinimumDate="{Binding MinimumDate}">

                                        <DatePicker.Behaviors>
                                            <xct:EventToCommandBehavior Command="{Binding SelectedDateCommand}"
                                                                        CommandParameter="{x:Reference endDateEntry}"
                                                                        EventName="DateSelected" />
                                        </DatePicker.Behaviors>

                                    </DatePicker>

                                    <custom:BorderlessEntry
                                            Keyboard="Text"
                                            IsReadOnly="True"
                                            InputTransparent="True"
                                            Placeholder="dd/MM/yyyy"
                                            Style="{StaticResource DefaultEntry}"
                                            x:Name="endDateEntry"
                                            ClassId="enddateentry"
                                            Text="{Binding EndDateString}"
                                            TextColor="#58595B" />

                                </Grid>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyCalender" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                 <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DateClickedCommand}"
                                                              CommandParameter="{x:Reference EndDate}"/>
                                 </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                         <!--  Date of Birth Field  -->
                        <StackLayout Spacing="0">

                            <!--  Date of Birth Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <!--  Date of Birth Label  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                LeadingViewPosition="Inside"
                                InputViewPadding="16,0,16,0"
                                OutlineCornerRadius="15"
                                IsEnabled="{Binding SubmitModel.travelerDeclaration.Isvisitor}"
                                UnfocusedColor="{StaticResource NeutralGreay}">

                                <Grid>

                                    <DatePicker Date="{Binding SubmitModel.travelerDeclaration.birthDate}"
                                                MaximumDate="{Binding MaximumDate}"
                                                x:Name="DateBirth"
                                                IsVisible="false"
                                                Format="dd/MM/yyyy">

                                        <DatePicker.Behaviors>
                                            <xct:EventToCommandBehavior Command="{Binding SelectedDateCommand}"
                                                                        CommandParameter="{x:Reference birthDateEntry}"
                                                                        EventName="DateSelected" />
                                        </DatePicker.Behaviors>

                                    </DatePicker>

                                    <custom:BorderlessEntry
                                            Keyboard="Text"
                                            IsReadOnly="True"
                                            InputTransparent="True"
                                            Placeholder="dd/MM/yyyy"
                                            Style="{StaticResource DefaultEntry}"
                                            x:Name="birthDateEntry"
                                            ClassId="birthdateentry"
                                            Text="{Binding BirthDateString}"
                                            TextColor="#58595B" />

                                </Grid>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyCalender" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                 <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DateClickedCommand}"
                                                              CommandParameter="{x:Reference DateBirth}"/>
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                      

                        <!-- GoTo Trip Information Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            VerticalOptions="EndAndExpand"
                            Command="{Binding GoToTripInfoCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                        <!--  Pervious Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            TextColor="{StaticResource Secondary}"
                            Command="{Binding BackCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PerviousButton}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet Grid.Row="1" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

