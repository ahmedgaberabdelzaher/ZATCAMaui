<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.InfoPages.TripInformationPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:behaviour="clr-namespace:GAZT.CustomControl"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
                <ResourceDictionary>
                    <xct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

     <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingInfoPagesCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>

         <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}" 
                    Text="{Binding HeaderTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand">

                        <!--Circle view-->
                        <Grid RowDefinitions="Auto"
                              Margin="0,30"
                              ColumnSpacing="0"
                              VerticalOptions="Start"
                              HorizontalOptions="CenterAndExpand"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                            <!--Circle button 1-->
                            <ImageButton 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    BorderWidth="1"
                                    Padding="5"
                                    InputTransparent="True"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="EndAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Source="reportCheckMark.png"/>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="1"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 2-->
                             <ImageButton 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="2"
                                    Padding="5"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Source="reportCheckMark.png"/>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="3"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 3-->
                            <ImageButton 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="4"
                                    Padding="5"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Source="reportCheckMark.png"/>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="5"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 4-->
                             <ImageButton 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    Padding="5"
                                    BorderWidth="1"
                                    Grid.Column="6"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BackgroundColor="#0996D4"
                                    BorderColor="#0996D4"
                                    Source="reportCheckMark.png"/>


                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="7"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#0996D4"
                                HeightRequest="2" />

                            <!--Circle button 5-->
                            <Button 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="8"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#0996D4"
                                    BackgroundColor="Transparent"
                                    TextColor="#0996D4"
                                    Text="5">
                                 <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                             </Button>

                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="9"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="20"
                                BackgroundColor="#B8BABA"
                                HeightRequest="2" />

                            <!--Circle button 6-->
                            <Button 
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    CornerRadius="15"
                                    InputTransparent="True"
                                    BorderWidth="1"
                                    Grid.Column="10"
                                    VerticalOptions="CenterAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    BorderColor="#B8BABA"
                                    BackgroundColor="Transparent"
                                    TextColor="#565655"
                                    Text="6">
                                 <Button.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="Android">0</On>
                                    </OnPlatform>
                                </Button.Padding>

                            </Button>

                        </Grid>

                        <!--  Trip Information Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.TripInformation}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Trip Note Label  -->
                         <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                             FontSize="16"
                                             Margin="0,0,0,5"
                                             LineSpacing="1"
                                             LineBreakMode="WordWrap">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.NewDeclarationNote}"
                                              TextColor="{StaticResource NeutralGreay}"/>
                                        <Span TextColor="{StaticResource Primary}"
                                              Text="{x:Static ResourceManager:AppResources.CustomDeclarationInformation}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>

                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCustomInformationLinkCommand}"/>
                                </custom:CustomLabel.GestureRecognizers>

                         </custom:CustomLabel>


                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />

                        <!--  Welcome Label for logged in only -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="20"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            Text="{x:Static ResourceManager:AppResources.Hi}"
                            TextColor="#0996D4" />

                        <!--  User Label for logged in only  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="20"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            Text="{Binding SubmitModel.travelerDeclaration.FullName}"
                            TextColor="{StaticResource Primary}" />

                        <!--  Type Of Trip Label  -->
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.TypeOfTrip}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <!--#region Trip Cards-->
                        <StackLayout VerticalOptions="FillAndExpand"
                                     HorizontalOptions="FillAndExpand"
                                     Spacing="10"
                                     Padding="5"
                                     Margin="0,0,0,5"
                                     HeightRequest="100"
                                     Orientation="Horizontal">

                            <!--Air Card-->
                            <Grid
                                WidthRequest="171"
                                HeightRequest="94"
                                VerticalOptions="StartAndExpand"
                                HorizontalOptions="StartAndExpand">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                       Source="{Binding TripCard.AirImage}"/>

                                <!--  Air Label  -->
                                <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="EndAndExpand"
                                        FontSize="16"
                                        Padding="15"
                                        TextColor="{Binding TripCard.AirTextColor}"
                                        Text="{x:Static ResourceManager:AppResources.AirTrip}"/>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TripCardCommand}"
                                                          CommandParameter="1"/>
                                </Grid.GestureRecognizers>

                            </Grid>


                            <!--Land card-->
                            <Grid Padding="5"
                                  VerticalOptions="StartAndExpand"
                                  HorizontalOptions="StartAndExpand"
                                  WidthRequest="171"
                                  HeightRequest="94">

                                <!--Background image selected-->
                                <Image Aspect="Fill"
                                       Source="{Binding TripCard.LandImage}"/>

                                 <!--Land label-->
                                 <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="EndAndExpand"
                                        FontSize="16"
                                        Padding="15"
                                        TextColor="{Binding TripCard.LandTextColor}"
                                        Text="{x:Static ResourceManager:AppResources.LandTrip}"/>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TripCardCommand}"
                                                          CommandParameter="2"/>
                                </Grid.GestureRecognizers>

                            </Grid>

                        </StackLayout>

                        <!--Sea card-->
                        <Grid
                            WidthRequest="171"
                            Padding="5"
                            HorizontalOptions="StartAndExpand"
                            HeightRequest="94">

                            <!--Background image selected-->
                            <Image Aspect="Fill"
                                   Source="{Binding TripCard.SeaImage}"/>

                            <!--Sea label-->
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                VerticalOptions="EndAndExpand"
                                FontSize="16"
                                Padding="15"
                                TextColor="{Binding TripCard.SeaTextColor}"
                                Text="{x:Static ResourceManager:AppResources.SeaTrip}"/>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TripCardCommand}"
                                                      CommandParameter="3"/>
                            </Grid.GestureRecognizers>

                        </Grid>
                        <!--#endregion Trip Cards-->

                        <!--  Coming From/Going To Field  -->
                        <StackLayout Spacing="0">

                            <!--  Coming From/Going To Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                                IsVisible="{Binding IsArrivingPlaneSelected}">

                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ComingFrom}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>

                            </custom:CustomLabel>

                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                                IsVisible="{Binding IsArrivingPlaneSelected, Converter={StaticResource InvertedBoolConverter}}">

                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.GoingTo}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>

                            </custom:CustomLabel>

                            <!--  Coming From/Going To Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.arrivingFromDepartingToName}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenComingGoingCommand}" />
                                    </custom:BorderlessEntry.GestureRecognizers>
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenComingGoingCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  Entrance/Exit Port Field  -->
                        <StackLayout Spacing="0">

                            <!--  Entrance/Exit Port Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                                IsVisible="{Binding IsArrivingPlaneSelected}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.EntrancePort}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                                IsVisible="{Binding IsArrivingPlaneSelected, Converter={StaticResource InvertedBoolConverter}}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ExitPort}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Entrance/Exit Port Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.portName}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenEntranceExitPortCommand}" />
                                    </custom:BorderlessEntry.GestureRecognizers>
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenEntranceExitPortCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  Arrival/Departure Date Field  -->
                        <StackLayout Spacing="0">

                            <!--  Arrival/Departure Date Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                                IsVisible="{Binding IsArrivingPlaneSelected}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ArrivalDate}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                                IsVisible="{Binding IsArrivingPlaneSelected, Converter={StaticResource InvertedBoolConverter}}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.DepartureDate}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>


                            <!--  Arrival/Departure Date Label  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                InputViewPadding="16,0,16,0"
                                UnfocusedColor="{StaticResource NeutralGreay}">

                                <Grid>

                                    <DatePicker Date="{Binding SubmitModel.travelerDeclaration.travelDate}"
                                                Format="dd/MM/yyyy"
                                                x:Name="ArivalDate"
                                                IsVisible="false"
                                                MinimumDate="{Binding MinimumDate}">

                                        <DatePicker.Behaviors>
                                            <xct:EventToCommandBehavior Command="{Binding ArrivalSelectedDateCommand}"
                                                                        CommandParameter="{x:Reference ArivalDateEntry}"
                                                                        EventName="DateSelected" />
                                        </DatePicker.Behaviors>

                                    </DatePicker>

                                    <custom:BorderlessEntry
                                            Keyboard="Text"
                                            IsReadOnly="True"
                                            InputTransparent="True"
                                            Placeholder="dd/MM/yyyy"
                                            x:Name="ArivalDateEntry"
                                            Text="{Binding  ArrivalDepartureDateString}"
                                            Style="{StaticResource DefaultEntry}"
                                            TextColor="#58595B" />
                                </Grid>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyCalender" />
                                </inputLayout:SfTextInputLayout.TrailingView>

                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ArrivalDateClickedCommand}"
                                                              CommandParameter="{x:Reference ArivalDate}"/>
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                        <!--  Trip Number Field  -->
                        <StackLayout Spacing="0"
                                     IsVisible="{Binding TripCard.IsAirTripSelected}">

                            <!--  Trip Number Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.TripNumber}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Trip Number Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="SV0000"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.flightNumber}"
                                    TextColor="#58595B" />
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                        <!--  Travel Purpose Field  -->
                        <StackLayout Spacing="0"
                                     IsVisible="{Binding SubmitModel.travelerDeclaration.IsEDeclaration}">

                            <!--  Travel Purpose Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.TravelPurpose}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Travel Purpose Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Placeholder="{x:Static ResourceManager:AppResources.TravelPurpose}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.travelPurposeName}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenTravelPurposeCommand}" />
                                    </custom:BorderlessEntry.GestureRecognizers>
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenTravelPurposeCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                          <!--  Traveler Count Field  -->
                        <StackLayout Spacing="0"
                                     IsVisible="{Binding SubmitModel.travelerDeclaration.IsEDeclaration}">

                            <!--  Traveler Count Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.TravelerCount}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Traveler Count Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.TravelerCount}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SubmitModel.travelerDeclaration.travelersCount}"
                                    TextColor="#58595B" >
                                    <custom:BorderlessEntry.Behaviors>
                                        <behaviour:OnlyNumericValuesBehaviour/>
                                    </custom:BorderlessEntry.Behaviors>

                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>

                         <!--  Passenger Label for logged in only -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            Margin="0,20"
                            IsVisible="{Binding SubmitModel.travelerDeclaration.Isvisitor, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="StartAndExpand"
                            MaxLines="1"
                            TextColor="#0996D4" >
                             <Label.FormattedText>
                                    <FormattedString>
                                        <Span  Text="+ " />
                                        <Span Text="{x:Static ResourceManager:AppResources.PassengerInformation}"/>
                                     
                                    </FormattedString>
                            </Label.FormattedText>
                            <Label.GestureRecognizers>

                                <TapGestureRecognizer Command="{Binding GoToPersonalInfoCommand}"/>

                            </Label.GestureRecognizers>

                        </Label>

                        <!-- GoTo Contact Information Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            VerticalOptions="EndAndExpand"
                            Command="{Binding GoToContactCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZNext}" />

                        <!--  Cancel Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            TextColor="{StaticResource Secondary}"
                            Command="{Binding BackCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.PerviousButton}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet Grid.Row="1" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
        
    </ContentPage.Content>
</ContentPage>

