<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.InquireRequestPages.ReviewRequestPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

     <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Content>
         <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}" 
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout VerticalOptions="FillAndExpand">

                       
                        <!--  EDeclaration Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                            TextColor="{StaticResource Primary}" />

                        <!--  EDeclaration Note Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            Margin="0,0,0,5"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ElectronicDeclaration}"
                            TextColor="{StaticResource NeutralGreay}" />

                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />

                        <!--#region Disclaimer-->
                        <Frame  Padding="5"
                                CornerRadius="8"
                                HasShadow="False"
                                Margin="0,0,0,5"
                                BorderColor="#FCECCD"
                                BackgroundColor="#FCECCD"
                                Style="{StaticResource CommonTopCurves}">

                            <StackLayout Orientation="Horizontal"
                                         Spacing="8">

                                <!--Check Mark Image-->
                                 <Image Aspect="AspectFit"
                                       Source="OrangeCircle"/>

                                <!--Feedback Name Label-->
                                 <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="14"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Inquire.FeedbackName}"
                                    TextColor="#F5BF58" />

                            </StackLayout>

                        </Frame>
                        <!--#endregion Disclaimer-->

                        <!--#region Frame Declaration Values-->
                        <Frame 
                            Padding="15"
                            Margin="0,0,0,10"
                            CornerRadius="15"
                            HasShadow="False"
                            BorderColor="#EBEBEB"
                            Style="{StaticResource CommonTopCurves}">

                            <!--Frame Content-->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal"
                                                Spacing="0">

                                    <!--Doc Image-->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25"/>

                                    <!--  Declaration Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="20"
                                        Padding="10"
                                        TextColor="#002447" 
                                        Text="{x:Static ResourceManager:AppResources.FORM5Declaration}"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    WidthRequest="20"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2" />

                                <!--#region Declaration Values -->
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                        RowSpacing="15"
                                        ColumnDefinitions="2*,*">

                                    <!-- Reference number Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmentReferenceNumber}"
                                        VerticalOptions="Start" />

                                    <!--  Reference number value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding Inquire.ReferenceID}"
                                        VerticalOptions="Start" />

                                    <!--  Payment Status Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        IsVisible="{Binding Inquire.paymentIsRequired}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="1"
                                        Text="{x:Static ResourceManager:AppResources.VATInstalmentListInstalmentPaymentStatus}"
                                        VerticalOptions="Start" />

                                    <!--  Payment status value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        IsVisible="{Binding Inquire.paymentIsRequired}"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="1"
                                        VerticalOptions="Start" >

                                        <custom:CustomLabel.Triggers>
                                            <DataTrigger Binding="{Binding Inquire.IsNotPaid}"
                                                         TargetType="custom:CustomLabel"
                                                         Value="True">
                                                <Setter Property="Text"
                                                        Value="{x:Static ResourceManager:AppResources.NotPaidPaymentStatus}"/>

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Inquire.IsNotPaid}"
                                                         TargetType="custom:CustomLabel"
                                                         Value="false">
                                                <Setter Property="Text"
                                                        Value="{x:Static ResourceManager:AppResources.PaidPaymentStatus}"/>

                                            </DataTrigger>

                                        </custom:CustomLabel.Triggers>

                                    </custom:CustomLabel>


                                    <!--  Name Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="2"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.ZZName}"
                                        VerticalOptions="Start" />

                                    <!--  Name value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Text="{Binding Inquire.fullName}"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="3"
                                        Text="{x:Static ResourceManager:AppResources.TravellerPassport}"
                                        VerticalOptions="Start" />

                                    <!--  Traveller passport value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="3"
                                        Text="{Binding Inquire.travelID}"
                                        VerticalOptions="Start" />

                                    <!--  Coming/Going from/to Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        Grid.Row="4"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999" 
                                        Text="{x:Static ResourceManager:AppResources.ArrivingFromORDepartingTo}"
                                        VerticalOptions="Start" />

                                    <!--  Coming/Going from/to Value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Grid.Row="4"
                                        Text="{Binding Inquire.ArrivingName}"
                                        VerticalOptions="Start" />

                                    <!--  Port Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="5"
                                        Text="{x:Static ResourceManager:AppResources.Port}"
                                        VerticalOptions="Start" />

                                    <!--  Port value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="5"
                                        Text="{Binding Inquire.PortName}"
                                        VerticalOptions="Start" />



                                    <!--  Trip number Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        TextColor="#999999"
                                        Grid.Row="6"
                                        Text="{x:Static ResourceManager:AppResources.TripNumber}"
                                        VerticalOptions="Start" />

                                    <!--  Trip number value Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Column="1"
                                        Text="{Binding Inquire.flightNumber}"
                                        Grid.Row="6"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="7"
                                        Text="{x:Static ResourceManager:AppResources.TripDate}"
                                        VerticalOptions="Start" />

                                    <!--  Trip Date Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Grid.Row="7"
                                        Text="{Binding Inquire.TravelDateString}"
                                        VerticalOptions="Start" />

                                </Grid>
                                <!--#endregion Declaration Values-->

                            </StackLayout>
                    
                         </Frame>
                         <!--#endregion Frame Declaration Values-->

                        <!--#region Frame Contains Fees-->
                        <Frame 
                            Padding="15"
                            CornerRadius="15"
                            Margin="0,0,0,10"
                            HasShadow="False"
                            BorderColor="#EBEBEB"
                            Style="{StaticResource CommonTopCurves}">

                            <!--Frame Content-->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal"
                                                Spacing="0">

                                    <!--Doc Image-->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25"/>

                                    <!--  Total fees Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="20"
                                        Padding="10"
                                        TextColor="#002447" 
                                        Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    WidthRequest="20"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2" />

                                <!--#region Payment Values -->
                                <StackLayout x:Name="inquireList"
                                             BindableLayout.ItemsSource="{Binding InquireList}">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate>

                                               <!-- Items List-->
                                                <Grid RowDefinitions="Auto,Auto"
                                                        ColumnDefinitions="*,*">

                                                    <!--  Item Name Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#999999"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Start" />

                                                    <!--  Count value Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="End"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#002447"
                                                        Grid.Column="1"
                                                        Text="{Binding Id}"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        VerticalOptions="Start" />

                                                </Grid>
                                               
                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </StackLayout>
                                <!--#endregion Payment Values-->

                                 <Grid ColumnDefinitions="2*,*">

                                    <!--  Total amount Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="Start"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#999999"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        Text="{x:Static ResourceManager:AppResources.TotalAmount}"
                                        VerticalOptions="Start" />

                                    <!--  Total amount value in words Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="End"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#002447"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource SomarSemiBold}"
                                        VerticalOptions="Start" >
                                         <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Inquire.totalFees}"/>
                                                <Span  Text="  " />
                                                <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>

                                    </custom:CustomLabel>

                                 </Grid>
                              
                            </StackLayout>
                    
                        </Frame>
                        <!--#endregion Frame Contains Fees-->

                        <!--#region Frame Contains Details Fees-->
                        <Frame 
                            Padding="15"
                            CornerRadius="15"
                            Margin="0,0,0,15"
                            BorderColor="#EBEBEB"
                            Style="{StaticResource CommonTopCurves}">

                            <!--Frame Content-->
                            <StackLayout>

                                <!--#region Label and Icon-->
                                <StackLayout Orientation="Horizontal"
                                                Spacing="0">

                                    <!--Doc Image-->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="25"
                                        HorizontalOptions="Start"
                                        Source="DocBlue"
                                        VerticalOptions="Center"
                                        WidthRequest="25"/>

                                    <!--  Details Total fees Label  -->
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        FontSize="20"
                                        Padding="10"
                                        TextColor="#002447" 
                                        Text="{x:Static ResourceManager:AppResources.DetailsTotalFeesPayable}"
                                        VerticalOptions="Start" />

                                </StackLayout>
                                <!--#endregion Label and Icon-->

                                <!--  Horizontal Line  -->
                                <BoxView
                                    WidthRequest="20"
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="#E6E6E6"
                                    HeightRequest="2" />

                                <!--#region Details Fees Values -->
                                <StackLayout BindableLayout.ItemsSource="{Binding DetailsTotalFeesList}">

                                      <BindableLayout.ItemTemplate>

                                            <DataTemplate>

                                               <!-- Items List-->
                                                <Grid RowDefinitions="Auto,Auto"
                                                        ColumnDefinitions="*,*">

                                                    <!--  Item Name Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#999999"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Start" />

                                                    <!--   Value Label  -->
                                                    <custom:CustomLabel
                                                        HorizontalOptions="End"
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="#002447"
                                                        Grid.Column="1"
                                                        FontFamily="{StaticResource SomarSemiBold}"
                                                        VerticalOptions="Start" >
                                                       <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Id}"/>
                                                                <Span  Text="  " />
                                                                <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>

                                                </custom:CustomLabel>

                                                </Grid>
                                               
                                            </DataTemplate>

                                      </BindableLayout.ItemTemplate>

                                </StackLayout>
                                <!--#endregion Payment Values-->
                            </StackLayout>
                    
                        </Frame>
                        <!--#endregion Frame Contains Fees-->


                        <!-- Online Payment Button  -->
                        <buttons:SfButton
                            Margin="0,5"
                            VerticalOptions="EndAndExpand"
                            Command="{Binding GoToPaymentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsVisible="{Binding Inquire.IsNotPaid}"
                            Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}" />

                        <!--  Pervious Button  -->
                        <buttons:SfButton
                            Margin="0,0,0,25"
                            BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            TextColor="{StaticResource Secondary}"
                            Command="{Binding BackCommand}"
                            FontFamily="{StaticResource SomarLight}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZCancel}" />

                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

