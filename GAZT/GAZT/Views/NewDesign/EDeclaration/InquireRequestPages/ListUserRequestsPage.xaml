<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.InquireRequestPages.ListUserRequestsPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    x:Name="page"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

     <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding OnAppearingCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>
    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}" 
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout>

                        <!--  EDeclaration Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.PreviousRequestsName}"
                            TextColor="{StaticResource Primary}" />

                        <!--  EDeclaration Note Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            Margin="0,0,0,5"
                            HorizontalOptions="StartAndExpand"
                            Text="{Binding PreviousRequests}"
                            TextColor="{StaticResource NeutralGreay}" />

                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />


                         <!--  Search Entry  -->
                        <inputLayout:SfTextInputLayout
                            ContainerBackgroundColor="White"
                            ContainerType="Outlined"
                            ErrorColor="#B00020"
                            FocusedColor="{StaticResource NeutralGreay}"
                            InputViewPadding="0"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="10"
                            UnfocusedColor="#DCDCDC"
                            VerticalOptions="Start">

                            <custom:BorderlessEntry
                                Keyboard="Text"
                                Placeholder="{x:Static ResourceManager:AppResources.SearchRerfrenceID}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding SearchInput}"
                                TextColor="#002447">

                                <custom:BorderlessEntry.Behaviors>
                                    <xct:EventToCommandBehavior
                                        Command="{Binding SearchCommand}"
                                        EventName="TextChanged" />
                                </custom:BorderlessEntry.Behaviors>

                            </custom:BorderlessEntry>

                            <inputLayout:SfTextInputLayout.LeadingView>
                                <Image Aspect="AspectFit" Source="reportSearchBar.png" />
                            </inputLayout:SfTextInputLayout.LeadingView>

                        </inputLayout:SfTextInputLayout>

                        <StackLayout BindableLayout.ItemsSource="{Binding InquireListOfUser}"
                                     Spacing="20"
                                     Margin="0,0,0,10">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>

                                    <Frame Padding="10,15"
                                            BorderColor="#EBEBEB"
                                            HasShadow="False"
                                            CornerRadius="12">

                                        <Grid RowDefinitions="Auto,Auto,15,Auto,Auto"
                                              RowSpacing="5"
                                              ColumnDefinitions="*,*,*">

                                            <!--  User Name  -->
                                            <Label
                                                FontFamily="{StaticResource SomarBold}"
                                                FontSize="16"
                                                Grid.ColumnSpan="2"
                                                HorizontalOptions="StartAndExpand"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding fullName}"
                                                TextColor="{StaticResource Primary}" />

                                            <!--  Total Amount Label Not used now  -->
                                            <custom:CustomLabel
                                                    FontSize="12"
                                                    Grid.Row="1"
                                                    IsVisible="false"
                                                    HorizontalOptions="StartAndExpand"
                                                    TextColor="#575756">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZZTotalAmount}"/>
                                                            <Span  Text="  " />
                                                            <Span  Text="3" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>

                                            <!--  Total fees payable Label  -->
                                            <Label
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="12"
                                                Grid.Column="2"
                                                HorizontalOptions="CenterAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                                TextColor="#575756" />

                                            <!--Price value Frame & label-->
                                            <Grid Grid.Column="2"
                                                    Grid.Row="1">

                                                <Frame HasShadow="False"
                                                        BackgroundColor="#0996D4"
                                                        Opacity="0.15"
                                                        VerticalOptions="Start"
                                                        Padding="15"
                                                        CornerRadius="15"/>

                                                <!--Price Label-->
                                                <custom:CustomLabel
                                                    HorizontalOptions="CenterAndExpand"
                                                    FontSize="12"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    TextColor="#0996D4"
                                                    VerticalOptions="CenterAndExpand" >
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding totalFees}"/>
                                                            <Span  Text="  " />
                                                            <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                            </Grid>

                                            <!--  Date Value Label  -->
                                            <Label
                                                Grid.Row="3"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{Binding TravelDateString}"
                                                TextColor="#575756" />

                                            <!--  Date Label  -->
                                            <Label
                                                Grid.Row="4"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.Date}"
                                                TextColor="{StaticResource Primary}" />

                                            <!--  Coming/Going value Label  -->
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{Binding ArrivingName}"
                                                TextColor="#575756" />

                                            <!--  Coming/Going Label  -->
                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="12"
                                                LineBreakMode="WordWrap"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.ArrivingFromORDepartingTo}"
                                                TextColor="{StaticResource Primary}" />

                                            <!--  Reference No. Value Label  -->
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{Binding ReferenceID}"
                                                TextColor="#575756" />

                                            <!--  Reference No Label  -->
                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="2"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="12"
                                                HorizontalOptions="StartAndExpand"
                                                Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}"
                                                TextColor="{StaticResource Primary}" />
                                
                                        </Grid>

                                        <Frame.GestureRecognizers>
                                             <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.SelectedItemCommand, Source={x:Reference page}}"
                                                CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>

                                    </Frame>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </StackLayout>
                       
                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--Loader-->  
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>
        
    </ContentPage.Content>
</ContentPage>

