<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.EDeclaration.InquireRequestPages.ListUserRequestsPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    x:Name="page"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
               <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Header Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}" 
                    Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout>

                        <!--  EDeclaration Label  -->
                        <Label
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="24"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.eDeclaration}"
                            TextColor="{StaticResource Primary}" />

                        <!--  EDeclaration Note Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="16"
                            Margin="0,0,0,5"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ElectronicDeclaration}"
                            TextColor="{StaticResource NeutralGreay}" />

                        <!--  Horizontal Line  -->
                        <BoxView
                            WidthRequest="20"
                            Margin="0,0,0,10"
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="2" />


                        <Frame Padding="10,15"
                               BorderColor="#EBEBEB"
                               HasShadow="False"
                               CornerRadius="12">

                            <Grid RowDefinitions="Auto,Auto,15,Auto,Auto"
                                  RowSpacing="5"
                                  ColumnDefinitions="*,*,*">

                                <!--  User Name  -->
                                <Label
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="16"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineBreakMode="WordWrap"
                                    Text="Mohamed Abdullah Ahmed"
                                    TextColor="{StaticResource Primary}" />

                                <!--  Total Amount Label  -->
                                <custom:CustomLabel
                                        FontSize="12"
                                        Grid.Row="1"
                                        HorizontalOptions="StartAndExpand"
                                        TextColor="#575756">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZTotalAmount}"/>
                                                <Span  Text="  " />
                                                <Span  Text="3" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <!--  Total fees payable Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="12"
                                    Grid.Column="2"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.TotalFeesPayable}"
                                    TextColor="#575756" />

                                <!--Price value Frame & label-->
                                <Grid Grid.Column="2"
                                      Grid.Row="1">

                                    <Frame HasShadow="False"
                                           BackgroundColor="#0996D4"
                                           Opacity="0.15"
                                           VerticalOptions="Start"
                                           Padding="15"
                                           CornerRadius="15"/>

                                    <!--Price Label-->
                                    <custom:CustomLabel
                                        HorizontalOptions="CenterAndExpand"
                                        FontSize="12"
                                        FontFamily="{StaticResource SomarBold}"
                                        TextColor="#0996D4"
                                        VerticalOptions="CenterAndExpand" >
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="311.70"/>
                                                <Span  Text="  " />
                                                <Span  Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                </Grid>

                                <!--  Date Value Label  -->
                                <Label
                                    Grid.Row="3"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="15/08/2023"
                                    TextColor="#575756" />

                                <!--  Date Label  -->
                                <Label
                                    Grid.Row="4"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Date}"
                                    TextColor="{StaticResource Primary}" />

                                <!--  Coming/Going value Label  -->
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="CROATIA"
                                    TextColor="#575756" />

                                <!--  Coming/Going Label  -->
                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.ArrivingFromORDepartingTo}"
                                    TextColor="{StaticResource Primary}" />

                                <!--  Reference No. Value Label  -->
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="14440415-23-1381"
                                    TextColor="#575756" />

                                <!--  Reference No Label  -->
                                <Label
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.ZZReferenceNumber}"
                                    TextColor="{StaticResource Primary}" />
                                
                            </Grid>

                        </Frame>



                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

              <!--Loader  
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />-->

        </Grid>
        
    </ContentPage.Content>
</ContentPage>

