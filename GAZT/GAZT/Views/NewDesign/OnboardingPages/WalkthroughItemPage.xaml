<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EGAZT.Views.NewDesign.OnboardingPages.WalkthroughItemPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Syncfusion.XForms.Core;assembly=Syncfusion.Core.XForms"
    xmlns:custom="clr-namespace:GAZT"
    NavigationPage.HasNavigationBar="False">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <StackLayout
            BackgroundColor="Transparent"
            Spacing="0"
            VerticalOptions="Center">
            
            <!--  Image for display svg image  -->
            <Image
                HeightRequest="250"
                BackgroundColor="Transparent"
                Style="{StaticResource SFOnboardingCenterImage}"

             Aspect="AspectFit"
                Source="{Binding ImagePath}"
                VerticalOptions="Center"
                 />

            <!--  Label to display header  -->
  
            <custom:CustomLabel
               FontSize="18.6"
                HorizontalTextAlignment="Start"
                                 Style="{StaticResource PageTitleWhite}"
                                 HorizontalOptions="Center"  Margin="0,20,0,10"
                                 VerticalOptions="Center"
                StyleId="OnBoardText"
                Text="{Binding Header}"
               
                 />

            <!--  Label to display content  -->
            <Label 
                Margin="10,10,0,10"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
               
                Style="{StaticResource BodyLabelWhite}"
                  StyleId="OnBoardText"

                Text="{Binding Content}"
                LineBreakMode="CharacterWrap"
                LineHeight=".6"
                VerticalTextAlignment="Center" 
                />

        </StackLayout>
    </ContentView.Content>
</ContentView>