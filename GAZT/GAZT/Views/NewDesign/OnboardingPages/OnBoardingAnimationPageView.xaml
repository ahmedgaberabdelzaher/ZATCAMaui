<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.OnboardingPages.GAZTNewDesignOnBoardingAnimationPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
     xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:behavior="clr-namespace:GAZT.SyncFusionEnabledBehaviors.Behaviors"
    xmlns:rotator="clr-namespace:Syncfusion.SfRotator.XForms;assembly=Syncfusion.SfRotator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    ios:Page.UseSafeArea="False"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="5">
            <Grid.RowDefinitions>
                <!--  Skip Button  -->
                <RowDefinition Height="96" />
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>

            <Image Grid.RowSpan="5"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Aspect="AspectFill" BackgroundColor="Transparent"
                   Source="partials_background.png" />
            <StackLayout Grid.Row="0" Orientation="Horizontal">
                <!--  Skip button  -->

                <buttons:SfButton
                Margin="10"
                BackgroundColor="Transparent"
                Command="{Binding SkipCommand}"
                CornerRadius="20"                  
                FontFamily="{StaticResource SSTArBold}"
                HorizontalOptions="Start"
                IsVisible="{Binding IsSkipButtonVisible}"
                Text="{x:Static ResourceManager:AppResources.NDSkip}"
                TextColor="{x:StaticResource WhiteTextColor}"
                VerticalOptions="StartAndExpand"
                 />

                <buttons:SfButton
                Margin="10"
                BackgroundColor="Transparent"
                CornerRadius="20"
                FontFamily="{StaticResource SSTArBold}"
                HorizontalOptions="EndAndExpand"
                IsVisible="{Binding IsSkipButtonVisible}"
                Text="{Binding LanguageText}"
                TextColor="{x:StaticResource WhiteTextColor}"
                VerticalOptions="EndAndExpand"
                Clicked="ChangeLangButton_Clicked" />
            </StackLayout>

            <Image Source="centered.png"  Aspect="AspectFit" Margin="{OnPlatform Android='0,-35,0,0', iOS='0,-45,0,0'}" Grid.Row="1">
            </Image>

            <!--  Rotator used to navigate the view  -->
            <rotator:SfRotator             
                Grid.Row="2"
                
                Margin="{OnPlatform Android='0,0,0,0', iOS='0,10,0,0'}"
               
                BackgroundColor="Transparent"
                SelectedDotColor="{StaticResource Yellow}"
                DotsBorderColor="Transparent"
                
                EnableLooping="False"
                EnableSwiping="True"
                HorizontalOptions="Start"
                DotPlacement="None"                
                ItemTemplate="{StaticResource ItemTemplate}"
                ItemsSource="{Binding Boardings}"
                NavigationStripPosition="Bottom"
                NavigationDirection="Horizontal"
                SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                VerticalOptions="CenterAndExpand"
              >
                <rotator:SfRotator.Behaviors>
                    <behavior:SfRotatorBehavior />
                </rotator:SfRotator.Behaviors>

            </rotator:SfRotator>

            <!--  Next button  -->
            <buttons:SfButton

               Margin="40,40,40,50"
                Grid.Row="4"
                Command="{Binding NextCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{Binding NextButtonText}" />

            <commonView:OnBoardingPageIndicator Grid.Row="3"  HorizontalOptions="Center" MaxNum="{Binding MaxIndex}"
                                        MinNum="{Binding SelectedIndex}" DotSize="12" FlowDirection="LeftToRight"/>

        </Grid>
    </ContentPage.Content>
</ContentPage>
