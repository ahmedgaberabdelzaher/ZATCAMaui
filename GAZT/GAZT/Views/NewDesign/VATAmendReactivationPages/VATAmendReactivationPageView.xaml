<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.VATAmendReactivationPages.VATAmendReactivationPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local="clr-namespace:EGAZT"
    xmlns:local1="clr-namespace:GAZT"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Name="VATRegistration"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--<Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="90*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>-->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Margin="12"
                        HorizontalOptions="StartAndExpand"
                        IsVisible="{Binding IsBackStepButtonVisible}"
                        Source="arrowLeftwhite"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label
                        x:Name="lblPageTitle"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="50,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        MaxLines="2"
                        Style="{StaticResource SectionTitleWhiteBold}"
                        Text="{Binding BindingContext.PageTitle, Source={x:Reference VATRegistration}}"
                        VerticalOptions="CenterAndExpand" />

                </Grid>
                <!-- </Grid>-->
                <yummy:PancakeView
                    Grid.Row="1"
                    Padding="0"
                    CornerRadius="14,14,0,0"
                    VerticalOptions="FillAndExpand">
                    <Grid
                        x:Name="VATRMainGrid"
                        Margin="0"
                        Padding="0,0,0,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand" />
                    </Grid>
                </yummy:PancakeView>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <yummy:PancakeView
                Grid.Row="1"
                Padding="0"
                CornerRadius="15,15,0,0">
                <Grid
                    x:Name="VATRMainGrid"
                    Margin="0"
                    Padding="0,15,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="90*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0"
                        Padding="15,15,15,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                            <StackLayout BackgroundColor="White">

                                <Grid
                                    Margin="0"
                                    Padding="0,15,0,10"
                                    BackgroundColor="White"
                                    HorizontalOptions="FillAndExpand"
                                    RowSpacing="0"
                                    VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0"
                                        Padding="15"
                                        BackgroundColor="White"
                                        HorizontalOptions="FillAndExpand"
                                        IsVisible="{Binding IsInstrunctionVisible}"
                                        RowSpacing="0"
                                        VerticalOptions="FillAndExpand">
                                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                                            <StackLayout BackgroundColor="White">

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMediumBlackLabel}"
                                                    Text="{x:Static custom2:AppResources.ZZZZVATREInstructionsandConditions}" />

                                                <Label
                                                    Margin="0"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTSmallGoldLabel}"
                                                    Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsFirst}" />
                                                <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{x:Static custom2:AppResources.ZZZZVATRFAQ1}"
                                                        TextColor="{StaticResource Secondary}" />
                                                    <custom:CustomLabel
                                                        HorizontalOptions="Start"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        Text="{x:Static custom2:AppResources.ZZZZVATRFAQ2}"
                                                        TextColor="{StaticResource Primary}">
                                                        <custom:CustomLabel.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="VATFaqTapped" />
                                                        </custom:CustomLabel.GestureRecognizers>
                                                    </custom:CustomLabel>

                                                </StackLayout>
                                                <custom:CustomLabel
                                                    Margin="0,-10,0,0"
                                                    HorizontalOptions="Start"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource CaptionLabelBlack}"
                                                    Text="{x:Static custom2:AppResources.ZZZZVATRFAQ3}"
                                                    TextColor="{StaticResource NeutralGreay}" />

                                                <custom:CustomLabel
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMicroGrayLabel}"
                                                    VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="1." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions1}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel
                                                    HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start"
                                                    Style="{StaticResource GAZTMicroGrayLabel}"
                                                    VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span FontSize="11" Text="2." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions2}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel Style="{StaticResource GAZTMicroGrayLabel}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="3." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions3}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="4." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions4}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel Style="{StaticResource GAZTMicroGrayLabel}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="5." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions5}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="6." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions6}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="7." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATAmendInstrunctionsAndConditions7}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <StackLayout Orientation="Horizontal">
                                                    <custom1:CheckboxCustom
                                                        x:Name="chkDeclaration"
                                                        IsChecked="{Binding IsInstrunctionChecked}"
                                                        IsEnabled="{Binding InstAndCondition.CBAgreeCondition}"
                                                        Style="{StaticResource CheckboxHeightWidth32}"
                                                        VerticalOptions="CenterAndExpand" />
                                                    <custom:CustomLabel Style="{DynamicResource IsInstrunctionCheckedStyle}">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>
                                            </StackLayout>
                                        </ScrollView>
                                    </Grid>


                                    <!--  TaxPayers Details  -->
                                    <Grid
                                        x:Name="TaxPayersDetailsView"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="0,10,0,0"
                                        IsVisible="{Binding IsTaxPayersVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="28"
                                                Style="{StaticResource SectionTitleBlackBold28}"
                                                Text="{x:Static custom2:AppResources.ZZTaxPayerDetails}"
                                                VerticalOptions="Center" />
                                            <Label Style="{StaticResource GAZTSmallBlackLbl}" Text="{x:Static custom2:AppResources.ZZZZCompletethebelowdetails}" />
                                            <BoxView Margin="0,0,0,15" Style="{StaticResource lineSeperator}" />
                                        </StackLayout>
                                        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">

                                            <Grid
                                                Padding="0"
                                                BackgroundColor="White"
                                                BindingContext="{Binding VATRegistrationDetailsData.d}"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="15"
                                                VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="20*" />
                                                </Grid.RowDefinitions>
                                                <!--  Start Of Read Only or pre-populated  -->

                                                <StackLayout Grid.Row="0">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static custom2:AppResources.TIN}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.TinEntry1, Source={x:Reference VATRegistration}}"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <custom:BorderlessEntry
                                                            IsReadOnly="True"
                                                            Placeholder="{x:Static custom2:AppResources.TINS}"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Gpartz}"
                                                            TextColor="#bbbbbb">
                                                            <Entry.Behaviors>
                                                                <custom1:OnlyNumericValuesBehaviour />
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static custom2:AppResources.ZZName}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <custom:BorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding TinNm}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="2">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static custom2:AppResources.ZZZVATRMainOutlet}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry1, Source={x:Reference VATRegistration}}"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <custom:BorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding CrNo}">
                                                            <Entry.Behaviors>
                                                                <custom1:OnlyNumericValuesBehaviour />
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>

                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry2, Source={x:Reference VATRegistration}}"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <custom:BorderlessEntry
                                                            FontSize="Small"
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding CrNm}"
                                                            TextColor="#bbbbbb" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="3">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static custom2:AppResources.ZZZZVATRStartDate}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <StackLayout Orientation="Horizontal">
                                                            <custom:BorderlessEntry
                                                                x:Name="Entry_CrStdt"
                                                                Margin="0"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.StartdateToshow}" />
                                                        </StackLayout>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="4">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static custom2:AppResources.ZVatAddress}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry1, Source={x:Reference VATRegistration}}"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <custom:BorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}" />
                                                    </inputLayout:SfTextInputLayout>
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry2, Source={x:Reference VATRegistration}}"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <custom:BorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="5">
                                                    <Label
                                                        Padding="0,0,0,0"
                                                        Style="{StaticResource ComponentHeaderBlackBold}"
                                                        Text="{x:Static custom2:AppResources.ZZZVATRSource}" />
                                                    <inputLayout:SfTextInputLayout
                                                        Margin="0,-6,0,-6"
                                                        ContainerType="Outlined"
                                                        ErrorColor="#B00020"
                                                        FocusedColor="{StaticResource Primary}"
                                                        HasError="False"
                                                        HorizontalOptions="FillAndExpand"
                                                        InputViewPadding="16,0,16,0"
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.SourceEntry, Source={x:Reference VATRegistration}}"
                                                        LeadingViewPosition="Inside"
                                                        Style="{StaticResource TextInputLayout}"
                                                        UnfocusedColor="#B1B1B1">
                                                        <custom:BorderlessEntry
                                                            IsReadOnly="True"
                                                            Style="{StaticResource DefaultEntry}"
                                                            Text="{Binding Source}" />
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="6" Margin="0,0,0,15">
                                                    <BoxView Margin="0,5,0,20" Style="{StaticResource lineSeperator}" />

                                                    <StackLayout
                                                        IsEnabled="{Binding BindingContext.TaxPayerDetails.AddInformationCB, Source={x:Reference VATRegistration}}"
                                                        IsVisible="{Binding BindingContext.TaxPayerDetails.AddInformationCBVisible, Source={x:Reference VATRegistration}}"
                                                        Orientation="Horizontal">
                                                        <custom1:CheckboxCustom
                                                            CheckChanged="AddAdditionalInfo_CheckedChanged"
                                                            IsChecked="{Binding BindingContext.IsAddAdditionalInfoChecked, Source={x:Reference VATRegistration}}"
                                                            Style="{StaticResource CheckboxHeightWidth32}"
                                                            VerticalOptions="CenterAndExpand" />

                                                        <custom:CustomLabel Style="{DynamicResource IsAddAdditionalInfoCheckedStyle}">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static custom2:AppResources.VATRTPDetailsAdditionalInformation}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                    </StackLayout>

                                                    <Frame
                                                        Padding="15,20,15,20"
                                                        BackgroundColor="White"
                                                        BorderColor="#bbbbbb"
                                                        CornerRadius="10"
                                                        HasShadow="False">
                                                        <StackLayout>

                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto" />

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    HorizontalOptions="Center"
                                                                    VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource
                                                                            FontFamily="UserIconFont"
                                                                            Glyph="{x:Static FontImage:IconFonts.Information}"
                                                                            Size="30"
                                                                            Color="{StaticResource SecondaryNew}" />
                                                                    </Image.Source>
                                                                </Image>
                                                                <StackLayout
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    Spacing="0"
                                                                    VerticalOptions="Start">
                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}" />
                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
                                                                        HorizontalTextAlignment="Start"
                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                        Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}" />

                                                                    <Label
                                                                        HorizontalOptions="Start"
