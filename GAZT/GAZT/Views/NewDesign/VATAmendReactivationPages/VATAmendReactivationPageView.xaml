                                                            HasError="False"
                                                            HorizontalOptions="FillAndExpand"
                                                            InputViewPadding="16,0,16,0"
                                                            IsEnabled="{Binding Declaration.ContactNameEntry}"
                                                            LeadingViewPosition="Inside"
                                                            Style="{StaticResource TextInputLayout}"
                                                            UnfocusedColor="#B1B1B1">
                                                            <custom:BorderlessEntry
                                                                x:Name="EntryContactName"
                                                                IsSpellCheckEnabled="False"
                                                                Placeholder="{x:Static custom2:AppResources.VATRContactPersonName}"
                                                                Style="{StaticResource DefaultEntry}"
                                                                Text="{Binding FirstNameSR}"
                                                                TextChanged="EntryContactName_TextChanged">
                                                                <Entry.Behaviors>
                                                                    <custom1:AlphabetandArabicCharacters />
                                                                </Entry.Behaviors>
                                                            </custom:BorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>
                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>
                                    </Grid>

                                </Grid>

                                <buttons:SfButton
                                    x:Name="MainButtonName"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,20"
                                    BackgroundColor="{Binding ContinueButtonnBackroundColor}"
                                    Clicked="btnContinue_Clicked"
                                    CornerRadius="14"
                                    IsEnabled="{Binding IsContinueButtonEnable}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{Binding CurrentStep}" />
                            </StackLayout>
                        </ScrollView>

                    </Grid>
                    <StackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="15,-15,15,0"
                        Padding="0"
                        BackgroundColor="White">
                        <Grid Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="60*" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="Start"
                                IsVisible="{Binding IsBackStepButtonVisible}"
                                Source="arrowLeft.png"
                                Style="{DynamicResource BackButtonArrow}"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TappedOnBackButton" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="ic_logo_gazt.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />

                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <StackLayout
                                    HorizontalOptions="EndAndExpand"
                                    Orientation="Horizontal"
                                    Rotation="90"
                                    Spacing="3"
                                    VerticalOptions="CenterAndExpand">
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                    <BoxView
                                        BackgroundColor="{StaticResource NeutralGreay}"
                                        CornerRadius="3"
                                        HeightRequest="5"
                                        WidthRequest="5" />
                                </StackLayout>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="onMoreOptionClicked" />
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Padding="10,0,0,10"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand">
                                <commonView:PageIndicatorView
                                    DotSize="12"
                                    HorizontalOptions="End"
                                    MaxNum="{Binding MaxIndex}"
                                    MinNum="{Binding CurrentIndex}" />

                            </StackLayout>

                        </Grid>
                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="{Binding IsLoading}"
                            TextColor="{StaticResource Primary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="Center"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>