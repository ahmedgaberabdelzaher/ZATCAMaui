                                ContainerType="Outlined"  UnfocusedColor="#B1B1B1"
                                     HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"

                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" HasError="False">
                                                            <custom:BorderlessEntry Text="{Binding IdNumberSR}" MaxLength="{Binding MaxLengthIDSR}" x:Name="EntryContactIDNumber"  TextChanged="EntryContactIDNumber_TextChanged" Unfocused="EntryContactIDNumber_Unfocused" Style="{StaticResource DefaultEntry}"  IsSpellCheckEnabled="False" Keyboard="Numeric"
                                                             Placeholder="{x:Static custom2:AppResources.IDNumber}"  >
                                                                <Entry.Behaviors>
                                                                    <custom1:OnlyNumericValuesBehaviour/>
                                                                </Entry.Behaviors>
                                                            </custom:BorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="2" Grid.Column="0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>

                                                            <custom:CustomLabel x:Name="lblDOB" IsVisible="false"  Grid.Row="0"   Style="{StaticResource ComponentHeaderBlackBold}" >

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{x:Static local:AppResources.ZZDateofBirth}" />
                                                                        <Span  Text="*" TextColor="#ff0000" />
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <inputLayout:SfTextInputLayout Grid.Row="1"  IsVisible="false"
                                        ContainerType="Outlined" x:Name="FrmContactDBO" Margin="0,-6,0,-6" 
       UnfocusedColor="#B1B1B1"
                                     HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"

                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0"  HasError="{Binding FrameContactDOBError}" >
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:BorderlessEntry  x:Name="ContactDateEntry"  Text ="{Binding ContactDOB}"   IsEnabled="False"  TextChanged="ContactDateEntry_TextChanged"  Placeholder="YYYY/MM/DD"  HorizontalOptions="FillAndExpand" Style="{StaticResource DefaultEntry}">
                                                                    </custom:BorderlessEntry>
                                                                    <Image HorizontalOptions="End">
                                                                        <Image.Source>
                                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                                        </Image.Source>
                                                                    </Image>
                                                                </StackLayout>
                                                            </inputLayout:SfTextInputLayout>

                                                            <Button Grid.Row="1" x:Name="btnSR" IsVisible="false" IsEnabled="{Binding Declaration.DOBEntry}" BackgroundColor="Transparent" Clicked="btn4_Clicked" Margin="0,0,0,0" />

                                                            <custom1:CustomDatePicker FlowDirection="RightToLeft"  Grid.Row="1" 
								ShowHeader="false"
								Margin="2" 
                              BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
								ShowFooter="False"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="50"
                                PickerMode="Dialog"
								HeaderText="Date of Birth"
								x:Name="ContactDOBPicker"
                          
                             OKButtonTextColor="#006450" 
                                
                                             CancelButtonTextColor="#006450"
                           Closed="ContactDOBPicker_Closed"
                            SelectedItem="{Binding TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="ContactDOBPicker_OkButtonClicked"
                                CancelButtonClicked="ContactDOBPicker_CancelButtonClicked"
								ItemHeight="45" >
                                                                <custom1:CustomDatePicker.Behaviors>
                                                                    <custom1:SfPickerBehavior />
                                                                </custom1:CustomDatePicker.Behaviors>
                                                            </custom1:CustomDatePicker>
                                                        </Grid>
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="3">
                                                        <custom:CustomLabel  Grid.Row="0"  Style="{StaticResource ComponentHeaderBlackBold}">

                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span  Text="{x:Static custom2:AppResources.VATRContactPersonName}" />
                                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
                                    ContainerType="Outlined" x:Name="FrmContactName" UnfocusedColor="#B1B1B1" IsEnabled="{Binding Declaration.ContactNameEntry}"
                                    
                                     HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"

                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" HasError="False" >
                                                            <custom:BorderlessEntry x:Name="EntryContactName" Style="{StaticResource DefaultEntry}" TextChanged="EntryContactName_TextChanged" Text="{Binding FirstNameSR}" IsSpellCheckEnabled="False"
                                                            Placeholder="{x:Static custom2:AppResources.VATRContactPersonName}"  >
                                                                <Entry.Behaviors>
                                                                    <custom1:AlphabetandArabicCharacters/>
                                                                </Entry.Behaviors>
                                                            </custom:BorderlessEntry>
                                                        </inputLayout:SfTextInputLayout>
                                                    </StackLayout>
                                                </Grid>
                                            </StackLayout>
                                        </StackLayout>
                                    </Grid>

                                </Grid>

                                <buttons:SfButton  x:Name="MainButtonName" Text="{Binding CurrentStep}" Margin="0,0,0,20" 
                                                   Clicked="btnContinue_Clicked" IsEnabled="{Binding IsContinueButtonEnable}"
                                                   CornerRadius="14" Grid.ColumnSpan="2" Style="{StaticResource PrimaryButtonStyle}"
                                                   BackgroundColor="{Binding ContinueButtonnBackroundColor}" />
                            </StackLayout>
                        </ScrollView>

                    </Grid>
                    <StackLayout Grid.Row="0" Grid.Column="0" BackgroundColor="White" Padding="0" Margin="15,-15,15,0">
                        <Grid Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="60*"/>
                                <ColumnDefinition Width="20*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"  Source="arrowLeft.png"  HorizontalOptions="Start" VerticalOptions="CenterAndExpand"   Style="{DynamicResource BackButtonArrow}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="TappedOnBackButton"></TapGestureRecognizer>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="ic_logo_gazt.png" Grid.Row="0" Grid.Column="1" WidthRequest="50" HeightRequest="50" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>

                            <StackLayout  Grid.Row="0" Grid.Column="2">
                                <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                                    <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource NeutralGreay}"/>
                                    <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource NeutralGreay}"/>
                                    <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="{StaticResource NeutralGreay}"/>
                                </StackLayout>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="onMoreOptionClicked"></TapGestureRecognizer>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <StackLayout  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Padding="10,0,0,10" BackgroundColor="White" HorizontalOptions="FillAndExpand">
                                <commonView:PageIndicatorView MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" DotSize="12"/>

                            </StackLayout>

                        </Grid>
                    </StackLayout>
                </Grid>
            </yummy:PancakeView>

            <Grid Grid.Row="0" Grid.RowSpan="2"   Grid.Column="0"   IsVisible="{Binding IsLoading}" >
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0"   Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="Center"
                                           IsBusy="{Binding IsLoading}"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>