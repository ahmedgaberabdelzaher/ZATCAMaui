<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT"
             NavigationPage.HasNavigationBar="False"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
		     xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             xmlns:custom2="clr-namespace:EGAZT"            
             xmlns:local1="clr-namespace:GAZT"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector"
             FlowDirection="RightToLeft"
             x:Name="VATRegistration"
             BackgroundImageSource="partials_background.png"
             x:Class="EGAZT.Views.NewDesign.VATAmendReactivationPages.VATAmendReactivationPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector"/>
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <!--<Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="90*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>-->
                    <Grid   Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <Image Margin="12" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand"
                               HorizontalOptions="StartAndExpand"
                               Grid.Column="0"
                               Source="arrowLeftwhite"  Style="{DynamicResource BackButtonArrow}" >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label x:Name="lblPageTitle" HorizontalOptions="Center"
                               Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="50,0"
                               MaxLines="2" LineHeight="{OnPlatform Android=1.4,Default=.7}"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="CenterAndExpand"
                               Text="{Binding BindingContext.PageTitle,Source={x:Reference VATRegistration}}"
                               Style="{StaticResource SectionTitleWhiteBold}" />

                    </Grid>
                    <!-- </Grid>-->
                    <yummy:PancakeView Grid.Row="1"  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" CornerRadius="15,15,0,0" Padding="0">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*" />
                        <RowDefinition Height="90*" />
                    </Grid.RowDefinitions>
                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1" Grid.Column="0"  Margin="0" 
                  Padding="15,15,15,0" BackgroundColor="White" RowSpacing="0" >
                        <ScrollView  VerticalScrollBarVisibility="Never" HorizontalOptions="FillAndExpand">
                            <StackLayout BackgroundColor="White">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,10" BackgroundColor="White" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid IsVisible="{Binding IsInstrunctionVisible}"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0"  Margin="0" Padding="15" BackgroundColor="White" RowSpacing="0" >
                                        <ScrollView HorizontalOptions="FillAndExpand" VerticalScrollBarVisibility="Never">
                                            <StackLayout BackgroundColor="White">

                                                <Label HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.ZZZZVATREInstructionsandConditions}" Style="{StaticResource GAZTMediumBlackLabel}" Margin="0"/>

                                                <Label HorizontalTextAlignment="Start"  Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsFirst}"  Style="{StaticResource GAZTSmallGoldLabel}" Margin="0"/>
                                                <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                                    <custom:CustomLabel HorizontalOptions="Start" HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.ZZZZVATRFAQ1}" Style="{StaticResource CaptionLabelBlack}" TextColor="{StaticResource Secondary}"></custom:CustomLabel>
                                                    <custom:CustomLabel HorizontalOptions="Start" HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.ZZZZVATRFAQ2}" Style="{StaticResource CaptionLabelBlack}" TextColor="#005e4b">
                                                        <custom:CustomLabel.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="VATFaqTapped"></TapGestureRecognizer>
                                                        </custom:CustomLabel.GestureRecognizers>
                                                    </custom:CustomLabel>

                                                </StackLayout>
                                                <custom:CustomLabel HorizontalOptions="Start" HorizontalTextAlignment="Start" Text="{x:Static custom2:AppResources.ZZZZVATRFAQ3}" Style="{StaticResource CaptionLabelBlack}" TextColor="{StaticResource NeutralGreay}" Margin="0,-10,0,0"></custom:CustomLabel>

                                                <custom:CustomLabel HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand" HorizontalTextAlignment="Start"  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="1."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions1}"  />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="2."   FontSize="11"/>
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions2}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  VerticalOptions="EndAndExpand"  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="3." />
                                                            <Span  Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions3}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="4."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions4}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  VerticalOptions="EndAndExpand" Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="5." />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions5}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="6."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditions6}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  Style="{StaticResource GAZTMicroGrayLabel}">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="7."  />
                                                            <Span Text="{x:Static custom2:AppResources.ZZZVATAmendInstrunctionsAndConditions7}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <StackLayout Orientation="Horizontal">
                                                    <custom1:CheckboxCustom  IsEnabled="{Binding InstAndCondition.CBAgreeCondition}"
                                                                        IsChecked="{Binding IsInstrunctionChecked}" Style="{StaticResource CheckboxHeightWidth32}"
                                                                        x:Name="chkDeclaration"  VerticalOptions="CenterAndExpand"/>
                                                    <custom:CustomLabel   Style="{DynamicResource IsInstrunctionCheckedStyle}">
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}"  />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                    </custom:CustomLabel>
                                                </StackLayout>
                                            </StackLayout>
                                        </ScrollView>
                                    </Grid>


                                    <!--TaxPayers Details-->
                                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,10,0,0" IsVisible="{Binding IsTaxPayersVisible}"
                          x:Name="TaxPayersDetailsView">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Label Text="{x:Static custom2:AppResources.ZZTaxPayerDetails}" Style="{StaticResource SectionTitleBlackBold28}"  VerticalOptions="Center"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="28" />
                                            <Label Text="{x:Static custom2:AppResources.ZZZZCompletethebelowdetails}" Style="{StaticResource GAZTSmallBlackLbl}"/>
                                            <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,15"/>
                                        </StackLayout>
                                        <ScrollView Grid.Row="0"  VerticalScrollBarVisibility="Never" >

                                            <Grid Padding="0" HorizontalOptions="FillAndExpand" BindingContext="{Binding VATRegistrationDetailsData.d}" VerticalOptions="FillAndExpand" 
                                                  ColumnSpacing="0" RowSpacing="15" BackgroundColor="White">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="auto"/>
                                                    <RowDefinition Height="20*"/>
                                                </Grid.RowDefinitions>
                                                <!--Start Of Read Only or pre-populated-->

                                                <StackLayout Grid.Row="0">
                                                    <Label  Text="{x:Static custom2:AppResources.TIN}" Padding="0,0,0,0" Style="{StaticResource ComponentHeaderBlackBold}"/>
                                                    <inputLayout:SfTextInputLayout   
                                     IsEnabled="{Binding BindingContext.TaxPayerDetails.TinEntry1,Source={x:Reference VATRegistration} }"
Margin="0,-6,0,-6"                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"

                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding Gpartz}" Style="{StaticResource DefaultEntry}" IsReadOnly="True" 
                                                            Placeholder="{x:Static custom2:AppResources.TINS}" TextColor="#bbbbbb">
                                                            <Entry.Behaviors>
                                                                <custom1:OnlyNumericValuesBehaviour/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="1">
                                                    <Label Text="{x:Static custom2:AppResources.ZZName}" Padding="0,0,0,0" Style="{StaticResource ComponentHeaderBlackBold}"/>
                                                    <inputLayout:SfTextInputLayout  
Margin="0,-6,0,-6"                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                              Style="{StaticResource TextInputLayout}"

                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0">
                                                        <custom:BorderlessEntry Text="{Binding TinNm}"  Style="{StaticResource DefaultEntry}"
                                                            IsReadOnly="True">
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="2">
                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRMainOutlet}" Padding="0,0,0,0" Style="{StaticResource ComponentHeaderBlackBold}"/>
                                                    <inputLayout:SfTextInputLayout   Margin="0,-6,0,-6"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"

                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry1,Source={x:Reference VATRegistration} }"
                                     HasError="False">
                                                        <custom:BorderlessEntry Text="{Binding CrNo}" Style="{StaticResource DefaultEntry}"
                                                            IsReadOnly="True" >
                                                            <Entry.Behaviors>
                                                                <custom1:OnlyNumericValuesBehaviour/>
                                                            </Entry.Behaviors>
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>

                                                    <inputLayout:SfTextInputLayout Margin="0,-6,0,-6"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"

                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0"  HasError="False" IsEnabled="{Binding BindingContext.TaxPayerDetails.MainOutletEntry2,Source={x:Reference VATRegistration} }">
                                                        <custom:BorderlessEntry Text="{Binding CrNm}" Style="{StaticResource DefaultEntry}" TextColor="#bbbbbb" FontSize="Small"  
                                                            IsReadOnly="True" >
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="3">
                                                    <Label Text="{x:Static custom2:AppResources.ZZZZVATRStartDate}" Padding="0,0,0,0" Style="{StaticResource ComponentHeaderBlackBold}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" HasError="False">
                                                        <StackLayout Orientation="Horizontal">
                                                            <custom:BorderlessEntry x:Name="Entry_CrStdt" Style="{StaticResource DefaultEntry}" Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.StartdateToshow}"
                                                            IsReadOnly="True"  Margin="0">
                                                            </custom:BorderlessEntry>
                                                        </StackLayout>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="4">
                                                    <Label Text="{x:Static custom2:AppResources.ZVatAddress}" Padding="0,0,0,0" Style="{StaticResource ComponentHeaderBlackBold}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" HasError="False" IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry1,Source={x:Reference VATRegistration} }">
                                                        <custom:BorderlessEntry Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineOne}"  
                                                            IsReadOnly="True" Style="{StaticResource DefaultEntry}">
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" HasError="False" IsEnabled="{Binding BindingContext.TaxPayerDetails.AddressEntry2,Source={x:Reference VATRegistration} }">
                                                        <custom:BorderlessEntry Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.AddressLineTwo}"  Style="{StaticResource DefaultEntry}"
                                                            IsReadOnly="True" >
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Grid.Row="5">
                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRSource}" Padding="0,0,0,0" Style="{StaticResource ComponentHeaderBlackBold}"/>
                                                    <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" HasError="False" IsEnabled="{Binding BindingContext.TaxPayerDetails.SourceEntry,Source={x:Reference VATRegistration} }">
                                                        <custom:BorderlessEntry Text="{Binding Source}" Style="{StaticResource DefaultEntry}" IsReadOnly="True"  >
                                                        </custom:BorderlessEntry>
                                                    </inputLayout:SfTextInputLayout>
                                                </StackLayout>

                                                <StackLayout Margin="0,0,0,15" Grid.Row="6">
                                                    <BoxView Style="{StaticResource lineSeperator}" Margin="0,5,0,20"/>

                                                    <StackLayout Orientation="Horizontal" IsVisible="{Binding BindingContext.TaxPayerDetails.AddInformationCBVisible,Source={x:Reference VATRegistration} }"  IsEnabled="{Binding BindingContext.TaxPayerDetails.AddInformationCB,Source={x:Reference VATRegistration} }">
                                                        <custom1:CheckboxCustom   VerticalOptions="CenterAndExpand" Style="{StaticResource CheckboxHeightWidth32}"
                                                                    IsEnabled="{Binding BindingContext.AddAdditionalInfoCheckBoxEnabled,Source={x:Reference VATRegistration}}" 
                                                                    IsChecked="{Binding BindingContext.IsAddAdditionalInfoChecked,Source={x:Reference VATRegistration} }" 
                                                                    CheckChanged="AddAdditionalInfo_CheckedChanged"/>

                                                        <custom:CustomLabel  Style="{DynamicResource IsAddAdditionalInfoCheckedStyle}">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static custom2:AppResources.VATRTPDetailsAdditionalInformation}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                    </StackLayout>

                                                    <Frame BorderColor="#bbbbbb" BackgroundColor="White" CornerRadius="10" Padding="15,20,15,20" HasShadow="False">
                                                        <StackLayout>

                                                            <Grid >
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto"/>

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image HorizontalOptions="Center" Grid.Row="0" Grid.Column="0" VerticalOptions="Start">
                                                                    <Image.Source>
                                                                        <FontImageSource FontFamily="UserIconFont" Color="#909090" Size="30"
                                                        Glyph="{x:Static FontImage:IconFonts.Information}"/>
                                                                    </Image.Source>
                                                                </Image>
                                                                <StackLayout Grid.Column="1" Grid.Row="0" Spacing="0" VerticalOptions="Start">
                                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFirstLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionLabelGrey}"/>
                                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsSecondLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionLabelGrey}"/>

                                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsThirdLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionLabelGrey}"/>

                                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFourthLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionLabelGrey}"/>

                                                                    <Label Text="{x:Static custom2:AppResources.ZZZVATRAdditionalInformationInstrunctionsFifthLine}" HorizontalOptions="Start" HorizontalTextAlignment="Start"  Style="{StaticResource CaptionLabelGrey}"/>
                                                                </StackLayout>
                                                            </Grid>
                                                        </StackLayout>

                                                    </Frame>

                                                </StackLayout>
                                                <StackLayout  Grid.Row="7">
                                                    <StackLayout >
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>
                                                            <custom:CustomLabel  Grid.Row="0"   Padding="0,0,0,0" HorizontalOptions="Start" Style="{StaticResource ComponentHeaderBlackBold}">

                                                                <custom:CustomLabel.FormattedText>
                                                                    <FormattedString>
                                                                        <Span  Text="{x:Static custom2:AppResources.VATREligibleStartDate}"  />
                                                                        <Span  Text="*" TextColor="#ff0000"/>
                                                                    </FormattedString>
                                                                </custom:CustomLabel.FormattedText>
                                                            </custom:CustomLabel>
                                                            <inputLayout:SfTextInputLayout Grid.Row="1"  IsEnabled="{Binding BindingContext.IsTaxPayerEligDateEnabled,Source={x:Reference VATRegistration}}"
Margin="0,-6,0,-6"                            HorizontalOptions="FillAndExpand" x:Name="FrmEStartDate"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            Style="{StaticResource TextInputLayout}"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" HasError="False" >
                                                                <StackLayout Orientation="Horizontal">
                                                                    <custom:BorderlessEntry  x:Name="DateEntry" Focused="DateEntry_Focused"  TextChanged="DateEntry_TextChanged_1" IsEnabled="False"
                                                                                             Text="{Binding Source={x:Reference Name=VATRMainGrid}, Path=BindingContext.VatEligibleStartDate}"
                                                                                             Unfocused="DateEntry_Unfocused"   Placeholder="DD/MM/YYYY" Style="{StaticResource DefaultEntry}" >
                                                                    </custom:BorderlessEntry>
                                                                    <Image HorizontalOptions="EndAndExpand">
                                                                        <Image.Source>
                                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="20"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                                        </Image.Source>
                                                                    </Image>
                                                                    <StackLayout.GestureRecognizers>
                                                                        <TapGestureRecognizer  Tapped="VATEligibleDateClicked" />
                                                                    </StackLayout.GestureRecognizers>
                                                                </StackLayout>
