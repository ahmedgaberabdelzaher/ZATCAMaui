<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.TahqaqViews.TahqaqScanPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:helper="clr-namespace:EGAZT.Helper"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:zxing="clr-namespace:ZXing.Net.Mobile.Forms;assembly=ZXing.Net.Mobile.Forms"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SupportTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <yummy:PancakeView
                Grid.Row="1"
                Margin="0"
                Padding="0"
                IsVisible="{Binding IsShowScanView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid Padding="0,0,0,0" RowDefinitions="auto,auto,*,auto,auto">
                    <Grid
                        x:Name="MainGrid"
                        Grid.RowSpan="5"
                        Margin="0,0,0,0" />
                    <!-- <zxing:ZXingScannerView  x:Name="zxing"  Margin="0,0,0,0" Grid.RowSpan="5" IsAnalyzing="True" IsScanning="True"
                     BackgroundColor="White">
                                </zxing:ZXingScannerView>-->
                    <Grid Grid.Row="0" HorizontalOptions="FillAndExpand">
                        <Frame BackgroundColor="Black" Opacity=".44" />

                        <StackLayout Margin="0,60,0,50">

                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.ScantheQRcode}"
                                TextColor="White" />
                            <!--<Label Margin="0,0,0,30" Text="{x:Static ResourceManager:AppResources.PlacetheQRCodeinsidetheframe}"  HorizontalOptions="CenterAndExpand" TextColor="White" FontSize="14"></Label>-->
                        </StackLayout>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        Margin="2,0,2,-7"
                        FlowDirection="RightToLeft">
                        <Path
                            Margin="-3,-7,-3,0"
                            Data="M 0,0 L 36,0 36,36Z"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="-90"
                            Stroke="transparent"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-5,-15,-5,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Rotation="-90"
                            Source="Path"
                            VerticalOptions="Start" />
                        <Path
                            Margin="-7,-6,-14,0"
                            Data="M 0,0 L 30,0 30,30Z"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            VerticalOptions="Start" />
                        <Image
                            Margin="-3,-15,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="-180"
                            Source="Path"
                            VerticalOptions="Start" />

                        <Path
                            Margin="-3,0,-3,-.2"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="Start"
                            Opacity=".45"
                            Rotation="90"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="StartAndExpand"
                            Source="Path"
                            VerticalOptions="End" />
                        <Path
                            Margin="-3,0,-3,0"
                            Data="M 0,0 L 45,0 45,45"
                            Fill="Black"
                            HorizontalOptions="End"
                            Opacity=".45"
                            Rotation="180"
                            Stroke="transparent"
                            VerticalOptions="End" />
                        <Image
                            Margin="-3,0,-3,0"
                            HeightRequest="90"
                            HorizontalOptions="End"
                            Rotation="90"
                            Source="Path"
                            VerticalOptions="End" />

                    </Grid>
                    <!--
                            <Grid Grid.Row="2" custom:RoundCornersEffect.CornerRadius="30" Margin="2,-20,2,-15">
    <Line  Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" X2="100" HorizontalOptions="StartAndExpand" VerticalOptions="Start"/>
    <Line Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" Y2="100" HorizontalOptions="StartAndExpand" VerticalOptions="Start"/>

                              <Line Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" X2="100" HorizontalOptions="End"  VerticalOptions="Start"/>
    <Line Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" Y2="100" HorizontalOptions="EndAndExpand"  VerticalOptions="Start"/>
    <Line Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" X2="100" HorizontalOptions="StartAndExpand" VerticalOptions="End"/>
    <Line Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" Y2="100" HorizontalOptions="StartAndExpand" VerticalOptions="End"/>
    <Line Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" X2="100" HorizontalOptions="EndAndExpand" VerticalOptions="End"/>
    <Line Stroke="gray" custom:RoundCornersEffect.CornerRadius="10" StrokeThickness="20" Y2="100" HorizontalOptions="EndAndExpand" VerticalOptions="End"/>
</Grid>
                    -->    
                    <!--
                                <Path Fill="#00000000"
       Data="M5,65C5,51.8 5,31.8 5,5L30.79,5L65,5"
        Stroke="red" WidthRequest="10"/>
    <Path Fill="#00000000"
        Data="M165,225C178.2,225 198.2,225 225,225L225,199.21L225,165"
        Stroke="Red" WidthRequest="10"/>
    <Path Fill="#00000000"
        Data="M5,165C5,178.2 5,198.2 5,225L30.79,225L65,225"
        Stroke="Red" WidthRequest="10"/>-->

                    <!--<Grid>
    <Line  Stroke="gray" StrokeThickness="10" X2="100" HorizontalOptions="StartAndExpand" VerticalOptions="Start"/>
    <Line Stroke="gray" StrokeThickness="10" Y2="90" HorizontalOptions="StartAndExpand" VerticalOptions="Start"/>
    <Line Stroke="gray" StrokeThickness="10" X2="100" HorizontalOptions="End"  VerticalOptions="Start"/>
    <Line Stroke="gray" StrokeThickness="20" Y2="100" HorizontalOptions="EndAndExpand"  VerticalOptions="Start"/>
    <Line Stroke="gray" StrokeThickness="10" X2="100" HorizontalOptions="StartAndExpand" VerticalOptions="End"/>
    <Line Stroke="gray" StrokeThickness="10" Y2="100" HorizontalOptions="StartAndExpand" VerticalOptions="End"/>
    <Line Stroke="gray" StrokeThickness="10" X2="100" HorizontalOptions="EndAndExpand" VerticalOptions="End"/>
    <Line Stroke="gray" StrokeThickness="20" Y2="100" HorizontalOptions="EndAndExpand" VerticalOptions="End"/>
</Grid>-->


                    <Grid Grid.Row="4" HorizontalOptions="FillAndExpand">
                        <Frame BackgroundColor="Black" Opacity=".44" />
                        <StackLayout>
                            <Label
                                Grid.Row="3"
                                Margin="0,40,27,0"
                                HorizontalOptions="CenterAndExpand"
                                TextColor="White">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            FontFamily="{StaticResource FontSomarBold}"
                                            FontSize="24"
                                            Text="{x:Static ResourceManager:AppResources.Or}" />
                                        <Span FontSize="16" Text="{x:Static ResourceManager:AppResources.Use}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Frame
                                Grid.Row="4"
                                Margin="21,27,27,40"
                                Padding="12"
                                BackgroundColor="#00BBBD"
                                CornerRadius="14"
                                HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EnterCodeCommand}" />
                                </Frame.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.VerificationForm}"
                                    TextColor="White" />
                            </Frame>
                        </StackLayout>
                    </Grid>
                </Grid>
            </yummy:PancakeView>

            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,20,20,0"
                IsVisible="{Binding IsCheckWithCode}"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <StackLayout
                                x:Name="Main"
                                Margin="24,10,24,0"
                                IsVisible="{Binding IsMainPage}">
                                <Label
                                    Margin="0,34,0,5"
                                    FontSize="26"
                                    Text="{x:Static ResourceManager:AppResources.VerificationForm}"
                                    TextColor="#58595B" />
                                <Label
                                    FontSize="14"
                                    IsVisible="False"
                                    Text="{x:Static ResourceManager:AppResources.VerificationFormHint}"
                                    TextColor="#868894" />
                                <BoxView HeightRequest="1" Color="#EBEBEB" />
                            </StackLayout>
                            <StackLayout Margin="0,9,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.QRCode}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="14"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <control:BorderlessEntry
                                        Placeholder="{x:Static ResourceManager:AppResources.EnterQrCodeHere}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding scanCode}"
                                        VerticalTextAlignment="Center" />
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>
                            <Frame
                                Margin="21,27,27,40"
                                Padding="12"
                                BackgroundColor="#00BBBD"
                                CornerRadius="14"
                                HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GetDataForCodeCommand}" />
                                </Frame.GestureRecognizers>
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Send}"
                                    TextColor="White" />
                            </Frame>
                        </StackLayout>
                    </ScrollView>




                </Grid>
            </yummy:PancakeView>
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,20,20,0"
                IsVisible="{Binding IsShowRsltView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <Image
                                Margin="0,10,0,10"
                                HeightRequest="70"
                                HorizontalOptions="CenterAndExpand"
                                Source="SuccessQr"
                                WidthRequest="70" />
                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Correcttaxstamp}"
                                TextColor="{StaticResource PrimaryColor}" />
                            <Frame
                                Margin="0"
                                Padding="0"
                                BorderColor="LightGray"
                                CornerRadius="8"
                                HasShadow="False">
                                <StackLayout Margin="16">
                                    <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.QRCode}" />
                                    <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding scanCode}" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ProductDescription}" />
                                    <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding QrRslt.ProductDescription}" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.OrganisationName}" />
                                    <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding QrRslt.OrganisationName}" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="auto,auto">
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.CountryofOrigin}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding QrRslt.CountryOfManufacture}" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ProductionDate}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{Binding QrRslt.DateOfManufacture, StringFormat='{0:dd/MM/yyy}'}" />
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </ScrollView>




                </Grid>
            </yummy:PancakeView>
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,20,20,0"
                IsVisible="{Binding IsShowFailRsltView}"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <Image
                                Margin="0,50,0,15"
                                HeightRequest="95"
                                HorizontalOptions="CenterAndExpand"
                                Source="FailedIcon"
                                WidthRequest="95" />
                            <Label
                                FontFamily="{StaticResource FontSomarBold}"
                                FontSize="24"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Incorrecttaxstamp}"
                                TextColor="{StaticResource PrimaryColor}" />
                            <Frame
                                Margin="21,50,27,27"
                                Padding="12"
                                BackgroundColor="#00BBBD"
                                CornerRadius="14"
                                HasShadow="False">
                                <Label
                                    FontSize="16"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Submitareport}"
                                    TextColor="White" />
                                <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenReportsCommand}" />
                            </Frame.GestureRecognizers>
                            </Frame>
                            <Label
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.Exit}"
                                TextColor="#00BBBD">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                        </StackLayout>
                    </ScrollView>




                </Grid>
            </yummy:PancakeView>


            <Grid Grid.Row="0" Padding="20,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0">
                    <Image
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">
                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.TahqaqService}"
                    VerticalOptions="Center" />
            </Grid>
            <controls:Loader
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="{Binding IsLoading}" />
            <controls:MsgView
                Grid.Row="0"
                Grid.RowSpan="2"
                IsVisible="{Binding IsShowMsgView}" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
