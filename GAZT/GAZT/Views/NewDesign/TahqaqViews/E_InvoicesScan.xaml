<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
   xmlns:zxing="clr-namespace:ZXing.Net.Mobile.Forms;assembly=ZXing.Net.Mobile.Forms"
    xmlns="http://xamarin.com/schemas/2014/forms" NavigationPage.HasNavigationBar="False"
           FlowDirection="{Binding AppDirection}"
         xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:EGAZT.Controls"
    x:Class="EGAZT.Views.NewDesign.TahqaqViews.E_InvoicesScan">
      <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
<Grid RowDefinitions="auto,*">
           <!--#region Scan View-->
            <yummy:PancakeView IsVisible="{Binding IsShowScanView}" Margin="0" Padding="0" Grid.Row="1" Style="{StaticResource CommonTopCurves}" >
                        <Grid RowDefinitions="auto,auto,*,auto,auto" Padding="0,0,0,0">
                                        <Grid x:Name="MainGrid"  Margin="0,0,0,0" Grid.RowSpan="5">

                            </Grid>
                               <!-- <zxing:ZXingScannerView  Margin="0,0,0,0" Grid.RowSpan="5" IsAnalyzing="True"   IsScanning="True"
                 Result="{Binding Result, Mode=TwoWay}" ScanResultCommand="{Binding ScanEnvoiceQrCommand}"   BackgroundColor="White">
                                </zxing:ZXingScannerView>-->
                            <Grid Grid.Row="0"   HorizontalOptions="FillAndExpand">
                                                                <Frame  BackgroundColor="Black" Opacity=".44"></Frame>

                                <StackLayout Margin="0,60,0,50">
                          
                            <Label  Text="{x:Static ResourceManager:AppResources.ScantheQRcode}" HorizontalOptions="CenterAndExpand" TextColor="White" FontSize="24" FontFamily="{StaticResource FontSomarBold}"></Label>
                            <Label Margin="0,0,0,30" Text="{x:Static ResourceManager:AppResources.PlacetheQRCodeinsidetheframe}"  HorizontalOptions="CenterAndExpand" TextColor="White" FontSize="14"></Label>
  </StackLayout>
                            </Grid>
                          
                         <Grid Grid.Row="1" Grid.RowSpan="2" Margin="2,0,2,-7">
                             <Image Source="Path" Margin="0,-15,0,0" HeightRequest="90" Rotation="-90" HorizontalOptions="StartAndExpand" VerticalOptions="Start"></Image>
                             <Image Source="Path" Margin="0,-15,0,0"  HorizontalOptions="End" HeightRequest="90" Rotation="-180"  VerticalOptions="Start"></Image>
                             <Image Source="Path"  HeightRequest="90" HorizontalOptions="StartAndExpand"  VerticalOptions="End"></Image>
                             <Image Source="Path" HeightRequest="90" Rotation="90" HorizontalOptions="End"  VerticalOptions="End"></Image>

                         </Grid>       
                      </Grid>              
            </yummy:PancakeView>
    <!--#endregion-->
    <!--#region Success Result View-->
                 <yummy:PancakeView IsVisible="{Binding IsShowRsltView}" Grid.Row="1" Style="{StaticResource CommonTopCurves}" Padding="20,20,20,0" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ScrollView Grid.Row="0" Padding="0,0,0,32" VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0">
                            <Image Source="SuccessQr" HeightRequest="70" WidthRequest="70"  HorizontalOptions="CenterAndExpand" Margin="0,10,0,10"></Image>
                            <Label Text="{x:Static ResourceManager:AppResources.Correcttaxinvoice}" HorizontalOptions="CenterAndExpand" TextColor="{StaticResource PrimaryColor}" FontSize="24" FontFamily="{StaticResource FontSomarBold}"></Label>
                                   <Frame Margin="0"  BorderColor="LightGray" Padding="0" CornerRadius="8"  HasShadow="False">
                            <StackLayout Margin="16" >
                                                                    <Grid ColumnDefinitions="1.25*,*" Padding="8,0">
                                                                                    <Label Text="{Binding eInvoiceQRModel.sellerName}" Grid.Row="0"  TextColor="{StaticResource PrimaryColor}" FontFamily="{StaticResource FontSomarBold}" Style="{StaticResource BodyLabelGrey}"/>
                                        <Grid Grid.Column="1"  RowDefinitions="auto" >
                                        <Frame VerticalOptions="FillAndExpand" Padding="0"  HasShadow="False" BorderColor="#F5BF58"   CornerRadius="14">
                                        </Frame>
                                            <Label VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"  Margin="10,3,10,3" TextColor="#F5BF58" Text="{x:Static ResourceManager:AppResources.Correct}"></Label>

                                        </Grid>
                                    </Grid>
                                                                <BoxView Style="{StaticResource lineSeperator}"/>
                             <Grid RowDefinitions="auto,auto" ColumnSpacing="10" ColumnDefinitions="*,*">
                                <Label Text="{x:Static ResourceManager:AppResources.VATRegistrationNumber}"   Style="{StaticResource BodyLabelGrey}" Grid.Row="0" Grid.Column="0"></Label>
                                  <Label Text="{Binding eInvoiceQRModel.vatNumber}" Grid.Row="1" Grid.Column="0"  Style="{StaticResource BodyLabelBlack}"/>
                                 <Label Text="{x:Static ResourceManager:AppResources.TimeStamp}" Grid.Row="0" Grid.Column="1"  Style="{StaticResource BodyLabelGrey}"></Label>
                                  <Label Text="{Binding eInvoiceQRModel.timeStamp}" Grid.Row="1" Grid.Column="1"  Style="{StaticResource BodyLabelBlack}"/>
                           </Grid>
                                <Label Text="{x:Static ResourceManager:AppResources.InvoiceAmount}"   Style="{StaticResource BodyLabelGrey}" Grid.Row="0" Grid.Column="0"></Label>
                                  <Label Text="{Binding eInvoiceQRModel.invoiceAmount}" Grid.Row="1" Grid.Column="0"  Style="{StaticResource BodyLabelBlack}"/>
                                 <Label Text="{x:Static ResourceManager:AppResources.VATAmount}" Grid.Row="0" Grid.Column="1"  Style="{StaticResource BodyLabelGrey}"></Label>
                                  <Label Text="{Binding eInvoiceQRModel.vatAmount}" Grid.Row="1" Grid.Column="1"  Style="{StaticResource BodyLabelBlack}"/>
                          
                            </StackLayout>
                        </Frame>
                      </StackLayout>
                    </ScrollView>
                


               
                </Grid>
            </yummy:PancakeView>
        <!--#endregion-->
    <!--Header-->

  <controls:Header  TitleText="{x:Static ResourceManager:AppResources.ScantheQRcode}" Grid.Row="0"></controls:Header>
  <controls:Loader IsVisible="{Binding IsLoading}" Grid.Row="0" Grid.RowSpan="2"></controls:Loader>
</Grid>
</ContentPage>
