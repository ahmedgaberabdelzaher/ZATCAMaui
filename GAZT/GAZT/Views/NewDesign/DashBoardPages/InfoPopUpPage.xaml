<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.DashBoardPages.InfoPopUpPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    mc:Ignorable="d">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView
        BackgroundColor="{StaticResource NewDullOrangeColor}"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <StackLayout>
            <Grid
                ColumnSpacing="16"
                IsVisible="{Binding IsVatRegistrationTileVisible}"
                RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="VATInfoImg"
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="StartAndExpand"
                    Source="ic_White_info.png"
                    Style="{DynamicResource BackButtonArrow}" />

                <custom:CustomLabel
                    x:Name="VATTitle"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZRegisterinVATNow}"
                    TextColor="White"
                    VerticalOptions="StartAndExpand" />
                <custom:CustomLabel
                    x:Name="VATDecp"
                    Grid.Row="1"
                    Grid.Column="1"
                    LineSpacing="0.7"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{x:Static ResourceManager:AppResources.NDLessThan5MinRegister}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Zakat Starts  -->

            <Grid
                ColumnSpacing="16"
                IsVisible="{Binding IsEstablishmentRegistrationTileVisible}"
                RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>
                <Image
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="StartAndExpand"
                    Source="ic_White_info.png"
                    Style="{DynamicResource BackButtonArrow}" />

                <custom:CustomLabel
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource SectionTitleBlack}"
                    Text="{x:Static ResourceManager:AppResources.NDRegisterZAKAT}"
                    TextColor="White"
                    VerticalOptions="StartAndExpand" />
                <custom:CustomLabel
                    Grid.Row="1"
                    Grid.Column="1"
                    LineSpacing="0.7"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{x:Static ResourceManager:AppResources.NDRegZakatin5mins}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <!--  Zakat Ends  -->

            <buttons:SfButton
                x:Name="btnLogout"
                Grid.ColumnSpan="2"
                Margin="10,10,10,0"
                Clicked="btnLogout_Clicked"
                CornerRadius="10"
                FontAttributes="Bold"
                FontFamily="{StaticResource SomarSemiBold}"
                FontSize="15"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="{x:Static ResourceManager:AppResources.ZLogout}"
                VerticalOptions="End" />
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>