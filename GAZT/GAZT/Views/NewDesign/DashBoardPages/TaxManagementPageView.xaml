<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             BackgroundImageSource="partials_background.png"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             NavigationPage.HasNavigationBar="False"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.DashBoardPages.TaxManagementPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="ShadowLvl0">#EFEFEF</Color>
            <Style x:Key="GreyBorderFrameWithShadow" TargetType="border:SfBorder">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="BorderColor" Value="{StaticResource NeutralLightGrey}" />
                <Setter Property="ShadowColor" Value="{StaticResource ShadowLvl0}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <ScrollView>
                    <StackLayout>
                        <StackLayout Spacing="16">
                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="vat_user.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDNewProfile}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Label_MyProfile_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.MyBills}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Label_MyBills"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDReturns}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Label_MyRetuns_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDCertificates}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TaxpayerCertificate_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDRegistrationDetails}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TinRegistrationDetails_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <Expander>
                                    <Expander.Header>
                                        <Grid Padding="16,8,16,8" ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="ic_vat_return.png"/>
                                            <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDVATServices}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackLayout>
                                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource NeutralLightGrey}"/>
                                        <StackLayout Padding="45,5,5,5" Spacing="16">
                                        <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                                <Image Source="ic_vat_return.png"/>
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDRefundsRequest}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                            </StackLayout>
                                            <border:SfBorder.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="VATRefundRequest_Tapped"/>
                                            </border:SfBorder.GestureRecognizers>
                                        </border:SfBorder>

                                        <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                                <Image Source="ic_vat_return.png"/>
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDFillingFrequency}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                            </StackLayout>
                                            <border:SfBorder.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="ChnageFillingPeriod_Tapped"/>
                                            </border:SfBorder.GestureRecognizers>
                                        </border:SfBorder>

                                        <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                                <Image Source="ic_vat_return.png"/>
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDDeregistration}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                            </StackLayout>
                                            <border:SfBorder.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="VATDeregistrationDetails_Tapped"/>
                                            </border:SfBorder.GestureRecognizers>
                                        </border:SfBorder>
                                        </StackLayout>
                                    </StackLayout>
                                </Expander>
                            </border:SfBorder>

                            

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDInstallmentPlan}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ZakatInstalmentPlan_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VRObjectionsReviews}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Vat_Review_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8"> 
                                    <Image Source="ic_menu_cr.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDContractReleaseRequest}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ContractRelease_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_Application_Status.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZFormBundleStatus}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnApplicationStatus_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDRegistertoVAT}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <!--<border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnApplicationStatus_Tapped"/>
                                </border:SfBorder.GestureRecognizers>-->
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <!--<border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnApplicationStatus_Tapped"/>
                                </border:SfBorder.GestureRecognizers>-->
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TaxEvasion_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_logo_gazt.png" HeightRequest="25" WidthRequest="25"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZAboutUs}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Aboutus_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPrivacyPolicy}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PrivacyPolicy_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="customerServiceColor.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZSupport}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSupportTapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.AppVersion}"/>
                                                <Span Text="&#160;&#160;"/>
                                                <Span  Text="{Binding AppVersion}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </custom:CustomLabel>
                                </StackLayout>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZChangetoLanguage}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ChangeLanguage_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="20" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZLogout}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>

                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Logout_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </yummy:PancakeView>

            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="70*"/>
                    <ColumnDefinition Width="15*"/>
                </Grid.ColumnDefinitions>

                <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDTaxManagement}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>


                <Image Grid.Column="0" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Source="arrowLeftwhite.png" Style="{DynamicResource BackButtonArrow}" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackButtonClicked}"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <!--<Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}" Margin="0,-20,0,0">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#D99A29"/>
                    </StackLayout>
                </StackLayout>
            </Grid>-->
        </Grid>
    </ContentPage.Content>
</ContentPage>