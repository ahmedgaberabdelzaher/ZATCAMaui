<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:chart="clr-namespace:Syncfusion.SfChart.XForms;assembly=Syncfusion.SfChart.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:progressBar="clr-namespace:Syncfusion.XForms.ProgressBar;assembly=Syncfusion.SfProgressBar.XForms" xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             ios:Page.UseSafeArea="true"
              xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
            BackgroundImageSource="partials_background" x:Class="EGAZT.Views.NewDesign.DashBoardPages.GAZTNewDesignDashBoardPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegetiveToPositiveValueConverter x:Key="negetiveToPositiveValueConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <!--<CustomControl:DataMarkerConverter x:Key="converter" />-->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="ShadowLvl0">#EFEFEF</Color>
            <Style x:Key="GreyBorderFrameWithShadow" TargetType="border:SfBorder">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="BorderColor" Value="{StaticResource NeutralLightGrey}" />
                <Setter Property="ShadowColor" Value="{StaticResource ShadowLvl0}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>

        <Grid RowSpacing="0" BackgroundColor="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Image Aspect="AspectFill" Margin="0,-50,0,0" x:Name="BGImageLogin" BackgroundColor="Transparent" Source="partials_background.png" />


            
            <Grid RowSpacing="0" IsVisible="{Binding HomeViewVisible}" Grid.Row="0" Margin="0" Padding="0,15,0,0">
                <Grid.RowDefinitions>
                    <!--<RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!--<yummy:PancakeView Grid.Row="1" IsVisible="{Binding IsVatRegistrationTileVisible}" CornerRadius="12,12,0,0" BackgroundColor="{StaticResource NewDullOrangeColor}" Padding="15,16,15,8">
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Row="0" Grid.Column="0" Source="ic_White_info.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="StartAndExpand">
                        </Image>

                        <custom:CustomLabel Grid.Row="0" Grid.Column="1" VerticalOptions="StartAndExpand" Text="{x:Static ResourceManager:AppResources.ZZZZRegisterinVATNow}" Style="{StaticResource SectionTitleBlack}" TextColor="White"/>

                        <Image Grid.Row="0" Grid.Column="2" Source="WhiteCircle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVATNowTapped" NumberOfTapsRequired="1"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDLessThan5MinRegister}" Style="{StaticResource BodyLabelBlack}" TextColor="White" LineSpacing="0.7" VerticalOptions="Center"/>
                    </Grid>
                </yummy:PancakeView>-->

                <!--<yummy:PancakeView Grid.Row="2" IsVisible="{Binding IsEstablishmentRegistrationTileVisible}" CornerRadius="12,12,0,0" BackgroundColor="{StaticResource NewDullOrangeColor}" Padding="15,16,15,8">
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Row="0" Grid.Column="0" Source="ic_White_info.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="StartAndExpand">
                        </Image>

                        <custom:CustomLabel Grid.Row="0" Grid.Column="1" VerticalOptions="StartAndExpand" Text="Register in ZAKAT" Style="{StaticResource SectionTitleBlack}" TextColor="White"/>

                        <Image Grid.Row="0" Grid.Column="2" Source="WhiteCircle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnZakatNowTapped" NumberOfTapsRequired="1"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="Register now for Zakat in less than 5 minutes" Style="{StaticResource BodyLabelBlack}" TextColor="White" LineSpacing="0.7" VerticalOptions="Center"/>
                    </Grid>
                </yummy:PancakeView>-->

                <yummy:PancakeView Grid.Row="1" Padding="0" CornerRadius="12,12,0,0" VerticalOptions="FillAndExpand">
                    <ScrollView BackgroundColor="White">
                        <StackLayout Spacing="0">
                            <Grid ColumnSpacing="16" RowSpacing="4" IsVisible="{Binding IsVatRegistrationTileVisible}" BackgroundColor="{StaticResource NewDullOrangeColor}" Padding="15,16,15,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0" Grid.Column="0" Source="ic_White_info.png"   HorizontalOptions="StartAndExpand">
                                </Image>

                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" VerticalOptions="StartAndExpand" Text="{x:Static ResourceManager:AppResources.ZZZZRegisterinVATNow}" Style="{StaticResource SectionTitleBlack}" TextColor="White"/>

                                <Image Grid.Row="0" Grid.Column="2" Source="WhiteCircle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="EndAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnVATNowTapped" NumberOfTapsRequired="1"/>
                                    </Image.GestureRecognizers>
                                </Image>

                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDLessThan5MinRegister}" Style="{StaticResource BodyLabelBlack}" TextColor="White" LineSpacing="0.7" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView Style="{StaticResource WhiteLineSeperator}" />
                            <Grid ColumnSpacing="16" RowSpacing="4" IsVisible="{Binding IsEstablishmentRegistrationTileVisible}" BackgroundColor="{StaticResource NewDullOrangeColor}" Padding="15,16,15,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0" Grid.Column="0" Source="ic_White_info.png"   HorizontalOptions="StartAndExpand">
                                </Image>

                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" VerticalOptions="StartAndExpand" Text="{x:Static ResourceManager:AppResources.NDRegisterZAKAT}" Style="{StaticResource SectionTitleBlack}" TextColor="White"/>

                                <Image Grid.Row="0" Grid.Column="2" Source="WhiteCircle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="EndAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnZakatNowTapped" NumberOfTapsRequired="1"/>
                                    </Image.GestureRecognizers>
                                </Image>

                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDRegZakatin5mins}" Style="{StaticResource BodyLabelBlack}" TextColor="White" LineSpacing="0.7" VerticalOptions="Center"/>
                            </Grid>

                           <StackLayout Orientation="Horizontal" Margin="15,15,15,0" IsVisible="true">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASDashboardBalanceIndicatorTtile}" Style="{StaticResource SectionTitleBlack}" VerticalOptions="Center"/>
                                <Image Source="circle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="EndAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="AccountStatements_Tapped"></TapGestureRecognizer>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

  <yummy:PancakeView BackgroundColor="White" CornerRadius="12,12,0,0" IsVisible="{Binding IfnotRegInVATAndZakat}">

                                <cards:SfCardView HasShadow="True" BackgroundColor="White" CornerRadius="10" Margin="15,15,15,10">

                                    <StackLayout VerticalOptions="Start" Margin="15,5,15,15" Spacing="0" Orientation="Vertical" >
                                        <StackLayout Orientation="Vertical" Margin="0,0,0,10"
                                         HorizontalOptions="StartAndExpand" Spacing="-5">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASAccountStatementTaxType}" Style="{StaticResource SectionTitleBlack}" HorizontalOptions="StartAndExpand">
                                            </custom:CustomLabel>

                                        </StackLayout>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Text="{Binding SelectedTaxTypeForFilterValue.Txt30}" Grid.Column="0" Grid.Row="0" Style="{StaticResource ValueLabelBlackMedium}">
                                            </custom:CustomLabel>

                                            <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown"  Margin="5,5,5,5" HorizontalOptions="Start" VerticalOptions="Start"></Image>
                                            <custom:CustomButton x:Name="btn" Clicked="btnTaxTypePickerClicked"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BackgroundColor="Transparent"></custom:CustomButton>

                                            <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="TaxTypePicker"  HeaderHeight="55"
                                                             HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                                             HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46"
                                                             PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black"
                                                             BackgroundColor="White" SelectedItemFontSize="15" ShowFooter="False"
                                                             SelectedItemFontAttribute="Bold"
                                                             SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}"
                                                             ItemHeight="40" DisplayMemberPath="Txt30" ItemsSource="{Binding TaxTypeFilter}"  Grid.Row="0" Grid.Column="0"
                                                             Margin="10,0,10,0" PickerHeight="250" PickerWidth="300" ShowHeader="False" OKButtonTextColor="#006450"
                                                             CancelButtonTextColor="#006450" OKButtonBackgroundColor="#EAF7CC"
                                                             CancelButtonBackgroundColor="#EAF7CC" SelectedItem="{Binding SelectedTaxTypeForFilterValue}">
                                                <syncfusion:SfPicker.Behaviors>
                                                    <customcontrol:SfPickerBehavior />
                                                </syncfusion:SfPicker.Behaviors>
                                            </syncfusion:SfPicker>
                                        </Grid>

                                        <StackLayout Padding="0">
                                            <progressBar:SfLinearProgressBar Progress="100" x:Name="TaxBalanceProgress" ProgressColor="#006450" TrackHeight="16" HeightRequest="16" CornerRadius="8"
                                                                         Rotation="180">
                                            </progressBar:SfLinearProgressBar>
                                        </StackLayout>
                                        <Grid ColumnSpacing="20" Padding="0" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0" Margin="0,5,0,10" Spacing="-10" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand" >
                                                <Label Text="{x:Static ResourceManager:AppResources.ASAccountStatementDebit}" Style="{StaticResource ValueLabelBlack}"/>
                                            </StackLayout>
                                            <yummy:PancakeView Grid.Row="1" Grid.Column="0" BackgroundColor="{StaticResource ErrorColor}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" >
                                            </yummy:PancakeView>
                                            <StackLayout Grid.Row="1" Grid.Column="0" Orientation="Horizontal"  VerticalOptions="FillAndExpand" Spacing="2"  Margin="0,0,0,0" HorizontalOptions="CenterAndExpand" >
                                                <custom:CustomLabel  TextColor="{StaticResource ErrorColor}" FlowDirection="LeftToRight" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding HeaderSet.D.DebitAmount}"></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  TextColor="{StaticResource ErrorColor}"  Style="{StaticResource CaptionLabelBlack}"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                            </StackLayout>

                                            <StackLayout Grid.Row="0" Grid.Column="1" Margin="0,5,0,10" Spacing="-10" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" >
                                                <Label Text="{x:Static ResourceManager:AppResources.ASAccountStatementCredit}" Style="{StaticResource ValueLabelBlack}"  VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <yummy:PancakeView Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource Primary}" Padding="10,10,10,10" CornerRadius="14" WidthRequest="110"  HeightRequest="20" Opacity=".2"  BorderThickness="1"   VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                                <yummy:PancakeView.Triggers>
                                                    <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding Status}" Value="{x:Static ResourceManager:AppResources.VATRefundsStatusTransferred}">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </yummy:PancakeView.Triggers>
                                            </yummy:PancakeView>
                                            <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalOptions="FillAndExpand" Spacing="2"  Margin="0,0,0,0" HorizontalOptions="FillAndExpand" >
                                                <custom:CustomLabel  TextColor="{StaticResource Primary}" FlowDirection="LeftToRight" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding AccStmtnCreditAmount}"></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                                <custom:CustomLabel  TextColor="{StaticResource Primary}"  Style="{StaticResource CaptionLabelBlack}"  HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" LineBreakMode="WordWrap">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                            </StackLayout>
                                        </Grid>
                                        <BoxView HorizontalOptions="FillAndExpand" Margin="-15,20,-15,10"   HeightRequest="1" BackgroundColor="LightGray" />
                                        <Grid Padding="0" RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Spacing="-5">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ASAccountStatementTheBalances}" Style="{StaticResource BodyLabelBlack}"  HorizontalOptions="StartAndExpand"/>
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Spacing="-5">
                                                <custom:CustomLabel  HorizontalOptions="EndAndExpand" Text="{Binding HeaderSet.D.CloseAmount}"  VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleSmallMediumBlack}" >
                                                </custom:CustomLabel>
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </cards:SfCardView>
                            </yummy:PancakeView>
                            <StackLayout>
                                <yummy:PancakeView BackgroundColor="White" CornerRadius="12,12,0,0">
                                    <StackLayout VerticalOptions="Start" Margin="15,15,15,0">
                                        
                                        <custom:CustomLabel Text="{Binding NextCommitmentsString}" Style="{StaticResource SectionTitleBlack}" VerticalOptions="Center"/>
                                         <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Text="{Binding SelectedCommitmentFilterValue}" Grid.Column="0" Grid.Row="0" Style="{StaticResource ValueLabelBlackMedium}">
                                            </custom:CustomLabel>
                                              
                                              
                                            <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown"  Margin="5,5,5,5" HorizontalOptions="Start" VerticalOptions="Start"></Image>
                                            <custom:CustomButton x:Name="btn1" Clicked="btnCommitmentsPickerClicked"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BackgroundColor="Transparent"></custom:CustomButton>

                                            <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="CommitmentsPicker"  HeaderHeight="55"
                                                                 BackgroundColor="White"  
                                                             HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                                             HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46"
                                                             PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black"
                                                              SelectedItemFontSize="15" ShowFooter="False"
                                                             SelectedItemFontAttribute="Bold"
                                                             SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}"
                                                             ItemHeight="40"  ItemsSource="{Binding CommitmentsListFilter}"  Grid.Row="0" Grid.Column="0"
                                                             Margin="10,0,10,0" PickerHeight="250" PickerWidth="300" ShowHeader="False" OKButtonTextColor="#006450"
                                                             CancelButtonTextColor="#006450" OKButtonBackgroundColor="#EAF7CC"
                                                             CancelButtonBackgroundColor="#EAF7CC" SelectionChanged="CommitmentsPicker_SelectionChanged"  >
                                                <syncfusion:SfPicker.Behaviors>
                                                    <customcontrol:SfPickerBehavior />
                                                </syncfusion:SfPicker.Behaviors>
                                            </syncfusion:SfPicker>
                                        </Grid>
                                        <Label Text="{x:Static ResourceManager:AppResources.NoAppointmentText}" FlowDirection="RightToLeft" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalOptions="Center"  IsVisible="{Binding SetNoCommitmentsAvailableLabelVisibility}"/>

                                        <CollectionView HeightRequest="80"  x:Name="CollectionView_Commitment" ItemsLayout="HorizontalList"
                                                        ItemsSource="{Binding BillsAndReturnsCommitments}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                                        BackgroundColor="Transparent" HorizontalScrollBarVisibility="Never" IsVisible="{Binding SetMyCommitmentsCollectionVisibility}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackLayout Orientation="Horizontal" Margin="8">
                                                        <cards:SfCardView HasShadow="True" CornerRadius="14" Margin="0,0,0,5" >
                                                            <StackLayout Orientation="Horizontal">
                                                                <cards:SfCardView  IsVisible="{Binding IsUnSubmittedReturn}" Margin="{OnPlatform iOS='1', Android='0,0,0,-5'}" HasShadow="True" CornerRadius="14" WidthRequest="80" HeightRequest="80">
                                                                    <StackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                                        <custom:CustomLabel VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                                                                            <custom:CustomLabel.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Text="{Binding Day    }" Style="{StaticResource ValueLabelWhiteMedium}" ></Span>
                                                                                    <Span Text="&#10;" LineHeight="1"/>
                                                                                    <Span Text="{Binding Month}" Style="{StaticResource CaptionLabelWhite}"></Span>
                                                                                </FormattedString>
                                                                            </custom:CustomLabel.FormattedText>
                                                                        </custom:CustomLabel>
                                                                    </StackLayout>
                                                                    <cards:SfCardView.Triggers>
                                                                        <Trigger TargetType="cards:SfCardView" Property="IsVisible" Value="True">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}"></Setter>
                                                                        </Trigger>
                                                                    </cards:SfCardView.Triggers>
                                                                </cards:SfCardView>

                                                                <cards:SfCardView IsVisible="{Binding IsPaymentOverdue}"  Margin="{OnPlatform iOS='1', Android='0,0,0,-5'}" HasShadow="True" CornerRadius="14" WidthRequest="80" HeightRequest="80">
                                                                    <StackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                                        <custom:CustomLabel Style="{StaticResource CaptionLabelWhite}" VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                                                                            <custom:CustomLabel.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Text="{Binding Day}" Style="{StaticResource ValueLabelWhiteMedium}" ></Span>
                                                                                    <Span Text="&#10;"/>
                                                                                    <Span Text="{Binding Month}" ></Span>
                                                                                </FormattedString>
                                                                            </custom:CustomLabel.FormattedText>
                                                                        </custom:CustomLabel>
                                                                    </StackLayout>
                                                                    <cards:SfCardView.Triggers>
                                                                        <Trigger TargetType="cards:SfCardView" Property="IsVisible" Value="True">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"></Setter>
                                                                        </Trigger>
                                                                    </cards:SfCardView.Triggers>
                                                                </cards:SfCardView>

                                                                <StackLayout Padding="10,1,10,1" VerticalOptions="Center" Spacing="0" >
                                                                    <custom:CustomLabel Text="{Binding Incotext}" Style="{StaticResource ValueLabelBlackMedium}" IsVisible="{Binding IsUnSubmittedReturn}" />

                                                                    <custom:CustomLabel Text="{Binding Txt50}" Style="{StaticResource ValueLabelBlackMedium}" IsVisible="{Binding IsPaymentOverdue}"/>

                                                                    <custom:CustomLabel  IsVisible="{Binding IsUnSubmittedReturn}" Style="{StaticResource BodyLabelBlack}" LineBreakMode="WordWrap">
                                                                        <custom:CustomLabel.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Text="{x:Static ResourceManager:AppResources.ZTaxPeriod}"></Span>
                                                                                <Span Text=" : "></Span>
                                                                                <Span Text="{Binding TaxPeriod}"></Span>
                                                                            </FormattedString>
                                                                        </custom:CustomLabel.FormattedText>

                                                                    </custom:CustomLabel>

                                                                    <custom:CustomLabel IsVisible="{Binding IsPaymentOverdue}" Style="{StaticResource BodyLabelBlack}" LineBreakMode="WordWrap">
                                                                        <custom:CustomLabel.FormattedText>
                                                                            <FormattedString>
                                                                                <Span Text="{x:Static ResourceManager:AppResources.ZAmount}"></Span>
                                                                                <Span Text=" : "></Span>
                                                                                <Span Text="{Binding Amount,Converter={StaticResource commaSeparatorConverter}}"/><Span Text=" "/>
                                                                                <!--<Span Text="{Binding Amount}"></Span>-->
                                                                                <Span Text="&#160;&#160;"/>
                                                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"></Span>
                                                                            </FormattedString>
                                                                        </custom:CustomLabel.FormattedText>
                                                                    </custom:CustomLabel>

                                                                    <!--<custom:CustomLabel Text="200,000,00 SAR" TextColor="Black"  />-->
                                                                </StackLayout>

                                                                <!--<Image Source="circle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="EndAndExpand" Margin="10,0">
                                                                </Image>-->
                                                            </StackLayout>
                                                        </cards:SfCardView>
                                                    </StackLayout>

                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <!--End Horizontal List View-->

