<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             xmlns:chart="clr-namespace:Syncfusion.SfChart.XForms;assembly=Syncfusion.SfChart.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             ios:Page.UseSafeArea="True"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
            BackgroundImageSource="partials_background" x:Class="EGAZT.Views.NewDesign.DashBoardPages.GAZTNewDesignDashBoardPageView">


    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegetiveToPositiveValueConverter x:Key="negetiveToPositiveValueConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <local:StringToColorConvertor x:Key="StringToColorConvertor" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <chart:ChartColorCollection x:Key="Colors">
                        <Color>YellowGreen</Color>
                        <Color>Blue</Color>
                        <Color>Aqua</Color>
                    </chart:ChartColorCollection>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Color x:Key="ShadowLvl0">#EFEFEF</Color>
                    <Style x:Key="GreyBorderFrameWithShadow" TargetType="border:SfBorder">
                        <Setter Property="BackgroundColor" Value="White" />
                        <Setter Property="CornerRadius" Value="14" />
                        <Setter Property="HasShadow" Value="True" />
                        <Setter Property="BorderWidth" Value="1"/>
                        <Setter Property="BorderColor" Value="{StaticResource NeutralLightGrey}" />
                        <Setter Property="ShadowColor" Value="{StaticResource ShadowLvl0}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

   
    <ContentPage.Content>

        <Grid RowSpacing="0" BackgroundColor="Transparent" Margin="0,0,0,-16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Image Aspect="AspectFill" Margin="0,-50,0,0" x:Name="BGImageLogin" BackgroundColor="Transparent" Source="partials_background.png" />

         


               
                <Grid RowSpacing="0" IsVisible="{Binding HomeViewVisible}" Grid.Row="0" Margin="0" Padding="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <yummy:PancakeView Grid.Row="1" Padding="0" CornerRadius="12,12,0,0" VerticalOptions="FillAndExpand" >
                    <ScrollView Scrolled="ScrollView_Scrolled" VerticalScrollBarVisibility="Never">
                        <StackLayout Spacing="0">

                            <StackLayout Padding="15,0,15,8" HorizontalOptions="FillAndExpand" VerticalOptions="Fill">
                            <custom:CustomLabel Text="{Binding TaxpayerName}"  HorizontalTextAlignment="Start" Style="{StaticResource PageTitleWhite}" HorizontalOptions="Start"  Margin="0,0,0,10" VerticalOptions="Center" StyleId="SingleLabel" MaxLines="2"/>

                            <StackLayout IsVisible="{Binding IsMyObligationsClear}">
                                <StackLayout Orientation="Horizontal">
                                    <Image Source="ic_maincheck" WidthRequest="15" HeightRequest="15" Margin="0,0,5,0"></Image>
                                    <custom:CustomLabel FontSize="16" Style="{StaticResource 
                                                        CaptionLabelWhite}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.DashBoardWellDone}" TextColor="{StaticResource SuccessColor}"/>
                                                <Span Text=" "/>
                                                <Span Text="{x:Static ResourceManager:AppResources.DashBoardNoTaxObligationsPending}"></Span>
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                </StackLayout>
                                <custom:CustomLabel  Margin="0,-10,0,0" Padding="0" FontSize="20">

                                    <custom:CustomLabel.FormattedText>

                                        <FormattedString>
                                            <Span Text="0.00" Style="{StaticResource ButtonLabelWhiteBold}" FontSize="28"/>
                                            <Span Text=" "/>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" Style="{StaticResource 
                                                        CaptionLabelWhite}" FontSize="16"></Span>
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                            </StackLayout>

                            <border:SfBorder x:Name="btn_frameToolbar" Grid.Row="0"  Grid.Column="1"  CornerRadius="10" HasShadow="False" BorderWidth="0"
                                           VerticalOptions="CenterAndExpand" IsVisible="{Binding IsBodyMyTaxVisible}">
                                <Grid HorizontalOptions="StartAndExpand">

                                    <Frame BackgroundColor="White" Opacity="0.1" CornerRadius="15"></Frame>
                                    <StackLayout Orientation="Vertical" Padding="12,5,12,5" Spacing="0">

                                        <Label Text="{x:Static ResourceManager:AppResources.DashBoardMyTaxObligations}"  
                                               Style="{StaticResource CaptionLabelWhite}" Padding="0" Margin="0" 
                                               HorizontalOptions="StartAndExpand" FontSize="12"></Label>

                                        <custom:CustomLabel  Margin="0,-8,0,0" Padding="0" FontSize="20">

                                            <custom:CustomLabel.FormattedText>

                                                <FormattedString>
                                                    <Span Text="{Binding MyObligationAmountCommas}" Style="{StaticResource ButtonLabelWhiteBold}" FontSize="28"/>
                                                    <Span Text=" "/>
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" Style="{StaticResource 
                                                        CaptionLabelWhite}" FontSize="16"></Span>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </StackLayout>

                                </Grid>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_ToolbarMyTax"></TapGestureRecognizer>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>
                            </StackLayout>
                            <Grid ColumnSpacing="16" RowSpacing="4"
                                  IsVisible="{Binding IsEstablishmentRegistrationTileVisible}"
                                  BackgroundColor="{StaticResource NewDullOrangeColor}"
                                  Padding="15,16,15,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Row="0" Grid.Column="0" Source="ic_White_info.png"   HorizontalOptions="StartAndExpand">
                                </Image>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" VerticalOptions="StartAndExpand" Text="{x:Static ResourceManager:AppResources.NDRegisterZAKAT}" Style="{StaticResource SectionTitleBlack}" TextColor="White"/>

                                <Image Grid.Row="0" Grid.Column="2" Source="WhiteCircle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}" HorizontalOptions="EndAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnZakatNowTapped" NumberOfTapsRequired="1"/>
                                    </Image.GestureRecognizers>
                                </Image>
                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDRegZakatin5mins}" Style="{StaticResource BodyLabelBlack}" TextColor="White" LineSpacing="0.7" VerticalOptions="Center"/>
                                <yummy:PancakeView Grid.Row="2" Grid.ColumnSpan="3" HeightRequest="10"  Margin="-15,10,-15,-8" CornerRadius="12,12,0,0" BackgroundColor="White">

                                </yummy:PancakeView>
                            </Grid>

                            <StackLayout VerticalOptions="FillAndExpand" BackgroundColor="White">
                            <!--Pending Bills-->
                            <StackLayout IsVisible="{Binding IsPendingBillsVisible}">
                                <yummy:PancakeView  BackgroundColor="White"  Padding="15,0,15,0">
                                    <StackLayout  Margin="0,15,0,15"  VerticalOptions="FillAndExpand">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>



                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.DashBoardPendingBills}" Style="{StaticResource SectionTitleBlack}" VerticalOptions="Center"/>

                                            <StackLayout Grid.Column="1" HorizontalOptions="EndAndExpand" Orientation="Horizontal" IsVisible="{Binding IsBillsTotalAmountEN}">

                                                <custom:CustomLabel Grid.Column="0"  Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding BillCount}" Style="{StaticResource CaptionLabelGrey}"/>
                                                            <Span Text="&#160;" Style="{StaticResource CaptionLabelBlack}"/>
                                                            <Span Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" Style="{StaticResource CaptionLabelGrey}"></Span>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                                <Image Source="circle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}"  VerticalOptions="Center">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TappedOnMyBills"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>

                                            <StackLayout Grid.Column="1" HorizontalOptions="EndAndExpand" Orientation="Horizontal" IsVisible="{Binding IsBillsTotalAmountAR}">

                                                <custom:CustomLabel Grid.Column="0"  Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center">
                                                    <custom:CustomLabel.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" Style="{StaticResource CaptionLabelGrey}"></Span>
                                                            <Span Text="&#160;" Style="{StaticResource CaptionLabelGrey}"/>
                                                            <Span Text="{Binding BillCount}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>
                                                <Image Source="circle_arrow_right.png"  Style="{DynamicResource BackButtonArrow}"  VerticalOptions="Center">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TappedOnMyBills"></TapGestureRecognizer>
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </StackLayout>

                                        </Grid>

                                        <cards:SfCardView HasShadow="False" BackgroundColor="White" CornerRadius="10" Margin="0,5,0,0">
                                            <StackLayout >

                                                <listView:SfListView ItemsSource="{Binding PendingBills}"  MinimumHeightRequest="{Binding PendingBillsListHeight}" HorizontalOptions="FillAndExpand" VerticalOptions="Center" AutoFitMode="Height" SelectionBackgroundColor="Transparent" >
                                                    <listView:SfListView.Behaviors>
                                                        <local:ListViewBehavior/>
                                                    </listView:SfListView.Behaviors>
                                                    <listView:SfListView.ItemTemplate>
                                                        <DataTemplate>

                                                            <cards:SfCardView CornerRadius="16" Margin="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >

                                                                <StackLayout Spacing="2" Margin="12" Orientation="Vertical">
                                                                    <Grid HorizontalOptions="FillAndExpand">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="50*"></ColumnDefinition>
                                                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackLayout Orientation="Vertical" Grid.Row="0" Grid.Column="0">

                                                                            <custom:CustomLabel Text="{Binding Amount,Converter={StaticResource 
                                                                        commaSeparatorConverter}}" 
                                                                                            Style="{StaticResource 
                                                                        BodyLabelBlackMedium}" Margin="0,-5,0,-5">

                                                                                <custom:CustomLabel.FormattedText>

                                                                                    <FormattedString>
                                                                                        <Span Text="{Binding Amount,Converter={StaticResource 
                                                                        commaSeparatorConverter}}" />
                                                                                        <Span Text=" "/>
                                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" ></Span>
                                                                                    </FormattedString>
                                                                                </custom:CustomLabel.FormattedText>

                                                                            </custom:CustomLabel>

                                                                            <custom:CustomLabel Margin="0,-5,0,-5" Text="{Binding Abtypt}" 
                                                                                        Style="{StaticResource 
                                                                        CaptionLabelGrey}" VerticalOptions="End"></custom:CustomLabel>

                                                                        </StackLayout>

                                                                        <StackLayout Orientation="Vertical" Grid.Row="0" Grid.Column="1">

                                                                            <border:SfBorder Grid.Row="0" Grid.Column="1" HorizontalOptions="EndAndExpand" 
                                                                     VerticalOptions="CenterAndExpand" Padding="12,2,12,2" 
                                                                     CornerRadius="20" HeightRequest="32" BorderColor="{StaticResource Primary}" BorderWidth="1">
                                                                                <StackLayout BindingContext="{Binding .}"  Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                                                                                    <Image Source="ic_iconpay" HeightRequest="16" WidthRequest="16" 
                                                                   Margin="0,0,5,0" VerticalOptions="CenterAndExpand"/>
                                                                                    <custom:CustomLabel FontFamily="{StaticResource SSTArRoman}" Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}" FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="CenterAndExpand"/>

                                                                                </StackLayout>

                                                                                <border:SfBorder.GestureRecognizers>
                                                                                    <TapGestureRecognizer Tapped="BillsPayNowTapped" />
                                                                                </border:SfBorder.GestureRecognizers>
                                                                            </border:SfBorder>

                                                                            <custom:CustomLabel Margin="0,0,0,0"
                                                                                        Style="{StaticResource 
                                                                        CaptionLabelGrey}" HorizontalOptions="EndAndExpand">

                                                                                <custom:CustomLabel.FormattedText>

                                                                                    <FormattedString>
                                                                                        <Span Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                                                                                        <Span Text=": "/>
                                                                                        <Span Text="{Binding FormatedDuedate}"></Span>
                                                                                    </FormattedString>
                                                                                </custom:CustomLabel.FormattedText>
                                                                            </custom:CustomLabel>

                                                                        </StackLayout>

                                                                    </Grid>

                                                                </StackLayout>
                                                            </cards:SfCardView>

                                                        </DataTemplate>
                                                    </listView:SfListView.ItemTemplate>

                                                </listView:SfListView>


                                                <!--
                                                    <chart:SfChart ChartPadding="15"  BackgroundColor="White"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="250" IsVisible="true">
                                                        <chart:SfChart.Series>
                                                            <chart:DoughnutSeries  x:Name="doughnutSeries"  ItemsSource="{Binding MyBillsChartModels}" XBindingPath="BillType" YBindingPath="BillCount" TrackColor="{Binding BillColor}"
                                                                               Color="{Binding BillColor}" DoughnutCoefficient="0.95" CircularCoefficient=".9">
                                                                <chart:DoughnutSeries.ColorModel>
                                                                    <chart:ChartColorModel Palette="Custom" CustomBrushes="{Binding Colors}">
                                                                    </chart:ChartColorModel>
                                                                </chart:DoughnutSeries.ColorModel>

                                                                <chart:DoughnutSeries.CenterView>
                                                                    <StackLayout HorizontalOptions = "FillAndExpand" VerticalOptions = "FillAndExpand">
                                                                        <custom:CustomLabel Text="{Binding Source={x:Reference Name=doughnutSeries},Path=BindingContext.TotalString}" FontSize="12" Style="{StaticResource CaptionLabelBlack}"/>
                                                                        <custom:CustomLabel Text="{Binding Source={x:Reference Name=doughnutSeries},Path=BindingContext.BillCount}" FontSize="24" HorizontalOptions="Center" HorizontalTextAlignment="Center" StyleId="OnBoardText"/>
                                                                    </StackLayout>
                                                                </chart:DoughnutSeries.CenterView>
                                                            </chart:DoughnutSeries>
                                                        </chart:SfChart.Series>
                                                    </chart:SfChart>
                                                    <StackLayout Orientation="Horizontal" Spacing="2" HorizontalOptions="Center" VerticalOptions="CenterAndExpand">
                                                        <buttons:SfButton  HorizontalTextAlignment="Start" PressedBackgroundColor="AliceBlue" Clicked="unPaidClicked"    Style="{StaticResource CaptionButtonBlack}" ImageSource="ic_unpaid" ShowIcon="True" Text="{Binding UnPaidString}" BorderColor="LightGray" BorderWidth="1" CornerRadius="20"  VerticalTextAlignment="Center" BackgroundColor="White" HorizontalOptions="Start"/>
                                                        <buttons:SfButton   HorizontalTextAlignment="Start" PressedBackgroundColor="AliceBlue"  Clicked="partiallyClicked" Style="{StaticResource CaptionButtonBlack}" ImageSource="partially_clock" ShowIcon="True" Text="{Binding PartiallyPaidString}" BorderColor = "LightGray" BorderWidth="1"  BackgroundColor="White" CornerRadius="20" VerticalTextAlignment="Center" HorizontalOptions="Start"/>
                                                    </StackLayout>
                                                    -->

                                            </StackLayout>
                                        </cards:SfCardView>


                                    </StackLayout>
                                </yummy:PancakeView>
                            </StackLayout>


                            <!--Next Commitments-->
                            <StackLayout>
                                <StackLayout BackgroundColor="LightGray">
                                    <yummy:PancakeView BackgroundColor="White" >
                                        <StackLayout VerticalOptions="Start" Margin="15,15,15,0">

                                            <custom:CustomLabel Text="{Binding NextCommitmentsString}" Style="{StaticResource SectionTitleBlack}" VerticalOptions="Center"/>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel Text="{Binding SelectedCommitmentFilterValue}" Grid.Column="0" Grid.Row="0" Style="{StaticResource ValueLabelBlackMedium}">
                                                </custom:CustomLabel>


                                                <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown"  Margin="5,5,5,5" HorizontalOptions="Start" VerticalOptions="Start"></Image>
                                                <custom:CustomButton x:Name="btn1" Clicked="btnCommitmentsPickerClicked"  Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BackgroundColor="Transparent"></custom:CustomButton>

                                                <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="CommitmentsPicker"  HeaderHeight="55"
                                                                 BackgroundColor="White"  
                                                             HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                                             HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46"
                                                             PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black"
                                                              SelectedItemFontSize="15" ShowFooter="False"
                                                             SelectedItemFontAttribute="Bold"
                                                             SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}"
                                                             ItemHeight="40"  ItemsSource="{Binding CommitmentsListFilter}"  Grid.Row="0" Grid.Column="0"
                                                             Margin="10,0,10,0" PickerHeight="250" PickerWidth="300" ShowHeader="False" OKButtonTextColor="#006450"
                                                             CancelButtonTextColor="#006450" OKButtonBackgroundColor="#EAF7CC"
                                                             CancelButtonBackgroundColor="#EAF7CC" SelectionChanged="CommitmentsPicker_SelectionChanged"  >
                                                    <syncfusion:SfPicker.Behaviors>
                                                        <customcontrol:SfPickerBehavior />
                                                    </syncfusion:SfPicker.Behaviors>
                                                </syncfusion:SfPicker>
                                            </Grid>

                                            <Label Text="{x:Static ResourceManager:AppResources.NoAppointmentText}" FlowDirection="RightToLeft" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalOptions="Center"  IsVisible="{Binding SetNoCommitmentsAvailableLabelVisibility}"/>

                                            <CollectionView HeightRequest="80"  x:Name="CollectionView_Commitment" ItemsLayout="HorizontalList"
                                                        ItemsSource="{Binding BillsAndReturnsCommitments}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                                        BackgroundColor="Transparent" HorizontalScrollBarVisibility="Never" IsVisible="{Binding SetMyCommitmentsCollectionVisibility}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackLayout Orientation="Horizontal" Margin="8" >
                                                            <cards:SfCardView HasShadow="True" CornerRadius="14" Margin="0,0,0,5" >
                                                                <StackLayout Orientation="Horizontal">
                                                                    <cards:SfCardView  IsVisible="{Binding IsUnSubmittedReturn}" Margin="{OnPlatform UWP='*',iOS='1', Android='0,0,0,-5'}" HasShadow="True" CornerRadius="14" WidthRequest="80" HeightRequest="80">
                                                                        <StackLayout Spacing="0" Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                                                                            <custom:CustomLabel VerticalTextAlignment="Center" Margin="0,0,0,-2"   HorizontalTextAlignment="Center" VerticalOptions="End">
                                                                                <custom:CustomLabel.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Text="{Binding Day    }" Style="{StaticResource ValueLabelWhiteMedium}" ></Span>
                                                                                    </FormattedString>
                                                                                </custom:CustomLabel.FormattedText>
                                                                            </custom:CustomLabel>
                                                                            <custom:CustomLabel VerticalTextAlignment="Center"  HorizontalTextAlignment="Center" VerticalOptions="Start" Margin="0,-2,0,0">
                                                                                <custom:CustomLabel.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Text="{Binding Month}" Style="{StaticResource CaptionLabelWhite}"></Span>
                                                                                    </FormattedString>
                                                                                </custom:CustomLabel.FormattedText>
                                                                            </custom:CustomLabel>
                                                                        </StackLayout>
                                                                        <cards:SfCardView.Triggers>
                                                                            <Trigger TargetType="cards:SfCardView" Property="IsVisible" Value="True">
                                                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"></Setter>
                                                                            </Trigger>
                                                                        </cards:SfCardView.Triggers>
                                                                    </cards:SfCardView>

                                                                    <cards:SfCardView IsVisible="{Binding IsPaymentOverdue}" BackgroundColor="Red"   Margin="{OnPlatform UWP='*',iOS='1', Android='0,0,0,-5'}" HasShadow="True" CornerRadius="14" WidthRequest="80" HeightRequest="80">
                                                                        <StackLayout Spacing="0" Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                                                                            <custom:CustomLabel VerticalTextAlignment="Center" Margin="0,0,0,-2"   HorizontalTextAlignment="Center" VerticalOptions="End">
                                                                                <custom:CustomLabel.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Text="{Binding Day    }" Style="{StaticResource ValueLabelWhiteMedium}" ></Span>
                                                                                    </FormattedString>
                                                                                </custom:CustomLabel.FormattedText>
                                                                            </custom:CustomLabel>
                                                                            <custom:CustomLabel VerticalTextAlignment="Center" HorizontalTextAlignment="Center" VerticalOptions="Start" Margin="0,-2,0,0">
                                                                                <custom:CustomLabel.FormattedText>
                                                                                    <FormattedString>
                                                                                        <Span Text="{Binding Month}" Style="{StaticResource CaptionLabelWhite}"></Span>
                                                                                    </FormattedString>
                                                                                </custom:CustomLabel.FormattedText>
                                                                            </custom:CustomLabel>
                                                                        </StackLayout>
                                                                        <cards:SfCardView.Triggers>
                                                                            <Trigger TargetType="cards:SfCardView" Property="IsVisible" Value="True">
                                                                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"></Setter>
                                                                            </Trigger>
                                                                        </cards:SfCardView.Triggers>
                                                                    </cards:SfCardView>

                                                                    <StackLayout Padding="10,1,10,1" VerticalOptions="Center" Spacing="0" >
                                                                        <custom:CustomLabel Text="{Binding Incotext}" Style="{StaticResource ValueLabelBlackMedium}" IsVisible="{Binding IsUnSubmittedReturn}" />

                                                                        <custom:CustomLabel Text="{Binding Txt50}" Style="{StaticResource ValueLabelBlackMedium}" IsVisible="{Binding IsPaymentOverdue}"/>

                                                                        <custom:CustomLabel  IsVisible="{Binding IsUnSubmittedReturn}" Style="{StaticResource BodyLabelBlack}" LineBreakMode="WordWrap">
                                                                            <custom:CustomLabel.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZTaxPeriod}"></Span>
                                                                                    <Span Text=" : "></Span>
                                                                                    <Span Text="{Binding TaxPeriod}"></Span>
                                                                                </FormattedString>
                                                                            </custom:CustomLabel.FormattedText>

                                                                        </custom:CustomLabel>

                                                                        <custom:CustomLabel IsVisible="{Binding IsPaymentOverdue}" Style="{StaticResource BodyLabelBlack}" LineBreakMode="WordWrap">
                                                                            <custom:CustomLabel.FormattedText>
                                                                                <FormattedString>
                                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZAmount}"></Span>
                                                                                    <Span Text=" : "></Span>
                                                                                    <Span Text="{Binding Amount,Converter={StaticResource commaSeparatorConverter}}"/>
                                                                                    <Span Text=" "/>
                                                                                    <!--<Span Text="{Binding Amount}"></Span>-->
                                                                                    <Span Text="&#160;&#160;"/>
                                                                                    <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"></Span>
                                                                                </FormattedString>
                                                                            </custom:CustomLabel.FormattedText>
                                                                        </custom:CustomLabel>
                                                                    </StackLayout>
                                                                </StackLayout>
                                                            </cards:SfCardView>
                                                        </StackLayout>

                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>

