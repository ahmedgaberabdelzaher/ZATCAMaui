<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.DashBoardPages.GAZTNewDesignDashBoardPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:chart="clr-namespace:Syncfusion.SfChart.XForms;assembly=Syncfusion.SfChart.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local="clr-namespace:EGAZT.CustomControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="True"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding CheckSurveyCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegetiveToPositiveValueConverter x:Key="negetiveToPositiveValueConverter" />
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <local:StringToColorConvertor x:Key="StringToColorConvertor" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <chart:ChartColorCollection x:Key="Colors">
                        <Color>YellowGreen</Color>
                        <Color>Blue</Color>
                        <Color>Aqua</Color>
                    </chart:ChartColorCollection>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Color x:Key="ShadowLvl0">#EFEFEF</Color>
                    <Style x:Key="GreyBorderFrameWithShadow" TargetType="border:SfBorder">
                        <Setter Property="BackgroundColor" Value="White" />
                        <Setter Property="CornerRadius" Value="14" />
                        <Setter Property="HasShadow" Value="False" />
                        <Setter Property="BorderWidth" Value="1" />
                        <Setter Property="BorderColor" Value="{StaticResource NeutralLightGrey}" />
                        <Setter Property="ShadowColor" Value="{StaticResource ShadowLvl0}" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Content>
        <Grid>
            <Grid
                Margin="0,0,0,-16"
                BackgroundColor="Transparent"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Image
                    x:Name="BGImageLogin"
                    Margin="0,-50,0,0"
                    Aspect="AspectFill"
                    BackgroundColor="Transparent"
                    Source="partials_background.png" />





                <Grid
                    Grid.Row="0"
                    Margin="0"
                    Padding="0,0,0,0"
                    IsVisible="{Binding HomeViewVisible}"
                    RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        CornerRadius="12,12,0,0"
                        VerticalOptions="FillAndExpand">
                        <ScrollView Scrolled="ScrollView_Scrolled" VerticalScrollBarVisibility="Never">
                            <StackLayout Spacing="0">

                                <StackLayout
                                    Padding="15,0,15,8"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="Fill">
                                    <custom:CustomLabel
                                        Margin="0,0,0,10"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        MaxLines="2"
                                        Style="{StaticResource PageTitleWhite}"
                                        StyleId="SingleLabel"
                                        Text="{Binding TaxpayerName}"
                                        VerticalOptions="Center" />

                                    <StackLayout IsVisible="{Binding IsMyObligationsClear}">
                                        <StackLayout Orientation="Horizontal">
                                            <Image
                                                Margin="0,0,5,0"
                                                HeightRequest="15"
                                                Source="ic_maincheck"
                                                WidthRequest="15" />
                                            <custom:CustomLabel FontSize="15" Style="{StaticResource CaptionLabelWhite}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{x:Static ResourceManager:AppResources.DashBoardWellDone}" TextColor="{StaticResource SuccessColor}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.DashBoardNoTaxObligationsPending}" />
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                        <custom:CustomLabel
                                            Margin="0,-10,0,0"
                                            Padding="0"
                                            FontSize="20">

                                            <custom:CustomLabel.FormattedText>

                                                <FormattedString>
                                                    <Span
                                                        FontSize="28"
                                                        Style="{StaticResource ButtonLabelWhiteBold}"
                                                        Text="0.00" />
                                                    <Span Text=" " />
                                                    <Span
                                                        FontSize="15"
                                                        Style="{StaticResource CaptionLabelWhite}"
                                                        Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                    </StackLayout>

                                    <border:SfBorder
                                        x:Name="btn_frameToolbar"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        BorderWidth="0"
                                        CornerRadius="10"
                                        HasShadow="False"
                                        IsVisible="{Binding IsBodyMyTaxVisible}"
                                        VerticalOptions="CenterAndExpand">
                                        <Grid HorizontalOptions="StartAndExpand">

                                            <Frame
                                                BackgroundColor="White"
                                                CornerRadius="15"
                                                Opacity="0.1" />
                                            <StackLayout
                                                Padding="12,5,12,5"
                                                Orientation="Vertical"
                                                Spacing="0">

                                                <Label
                                                    Margin="0"
                                                    Padding="0"
                                                    FontSize="11"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelWhite}"
                                                    Text="{x:Static ResourceManager:AppResources.DashBoardNewMyTaxObligations}" />

                                                <custom:CustomLabel
                                                    Margin="0,-8,0,0"
                                                    Padding="0"
                                                    FontSize="20">

                                                    <custom:CustomLabel.FormattedText>

                                                        <FormattedString>
                                                            <Span
                                                                FontSize="28"
                                                                Style="{StaticResource ButtonLabelWhiteBold}"
                                                                Text="{Binding MyObligationAmountCommas}" />
                                                            <Span Text=" " />
                                                            <Span
                                                                FontSize="15"
                                                                Style="{StaticResource CaptionLabelWhite}"
                                                                Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                        </FormattedString>
                                                    </custom:CustomLabel.FormattedText>
                                                </custom:CustomLabel>

                                            </StackLayout>

                                        </Grid>
                                        <border:SfBorder.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_ToolbarMyTax" />
                                        </border:SfBorder.GestureRecognizers>
                                    </border:SfBorder>
                                </StackLayout>
                                <Grid
                                    Padding="15,16,15,8"
                                    BackgroundColor="{StaticResource NewDullOrangeColor}"
                                    ColumnSpacing="16"
                                    IsVisible="{Binding IsEstablishmentRegistrationTileVisible}"
                                    RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="StartAndExpand"
                                        Source="ic_White_info.png" />
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDRegisterZAKAT}"
                                        TextColor="White"
                                        VerticalOptions="StartAndExpand" />

                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalOptions="EndAndExpand"
                                        Source="WhiteCircle_arrow_right.png"
                                        Style="{DynamicResource BackButtonArrow}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnZakatNowTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <custom:CustomLabel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        LineSpacing="0.7"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.NDRegZakatin5mins}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <yummy:PancakeView
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Margin="-15,10,-15,-8"
                                        BackgroundColor="White"
                                        CornerRadius="12,12,0,0"
                                        HeightRequest="10" />
                                </Grid>

                                <StackLayout BackgroundColor="White" VerticalOptions="FillAndExpand">
                                    <!--  Pending Bills  -->
                                    <StackLayout IsVisible="{Binding IsPendingBillsVisible}">
                                        <yummy:PancakeView Padding="15,0,15,0" BackgroundColor="White">
                                            <StackLayout Margin="0,15,0,15" VerticalOptions="FillAndExpand">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>



                                                    <custom:CustomLabel
                                                        Grid.Column="0"
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.DashBoardPendingBills}"
                                                        VerticalOptions="Center" />

                                                    <StackLayout
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        IsVisible="{Binding IsBillsTotalAmountEN}"
                                                        Orientation="Horizontal">

                                                        <custom:CustomLabel
                                                            Grid.Column="0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            VerticalOptions="Center">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding BillCount}" />
                                                                    <Span Style="{StaticResource CaptionLabelBlack}" Text="&#160;" />
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Image
                                                            Source="circle_arrow_right.png"
                                                            Style="{DynamicResource BackButtonArrow}"
                                                            VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="TappedOnMyBills" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Column="1"
                                                        HorizontalOptions="EndAndExpand"
                                                        IsVisible="{Binding IsBillsTotalAmountAR}"
                                                        Orientation="Horizontal">

                                                        <custom:CustomLabel
                                                            Grid.Column="0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            VerticalOptions="Center">
                                                            <custom:CustomLabel.FormattedText>
                                                                <FormattedString>
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.DashboardBillsInTotal}" />
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="&#160;" />
                                                                    <Span Style="{StaticResource CaptionLabelGrey}" Text="{Binding BillCount}" />
                                                                </FormattedString>
                                                            </custom:CustomLabel.FormattedText>
                                                        </custom:CustomLabel>
                                                        <Image
                                                            Source="circle_arrow_right.png"
                                                            Style="{DynamicResource BackButtonArrow}"
                                                            VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="TappedOnMyBills" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </StackLayout>

                                                </Grid>

                                                <cards:SfCardView
                                                    Margin="0,5,0,0"
                                                    BackgroundColor="White"
                                                    CornerRadius="10"
                                                    HasShadow="False">
                                                    <StackLayout>

                                                        <listView:SfListView
                                                            AutoFitMode="Height"
                                                            HorizontalOptions="FillAndExpand"
                                                            ItemsSource="{Binding PendingBills}"
                                                            MinimumHeightRequest="{Binding PendingBillsListHeight}"
                                                            SelectionBackgroundColor="Transparent"
                                                            VerticalOptions="Center">
                                                            <listView:SfListView.Behaviors>
                                                                <local:ListViewBehavior />
                                                            </listView:SfListView.Behaviors>
                                                            <listView:SfListView.ItemTemplate>
                                                                <DataTemplate>

                                                                    <cards:SfCardView
                                                                        Margin="2"
                                                                        BorderColor="{StaticResource NeutralLightGrey}"
                                                                        BorderWidth="1"
                                                                        CornerRadius="16"
                                                                        HasShadow="False"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        VerticalOptions="FillAndExpand">

                                                                        <StackLayout
                                                                            Margin="12"
                                                                            Orientation="Vertical"
                                                                            Spacing="2">
                                                                            <Grid HorizontalOptions="FillAndExpand">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="50*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <StackLayout
                                                                                    Grid.Row="0"
                                                                                    Grid.Column="0"
                                                                                    Orientation="Vertical">

                                                                                    <custom:CustomLabel
                                                                                        Margin="0,-5,0,-5"
                                                                                        Style="{StaticResource BodyLabelBlackMedium}"
                                                                                        Text="{Binding Amount, Converter={StaticResource commaSeparatorConverter}}">

                                                                                        <custom:CustomLabel.FormattedText>

                                                                                            <FormattedString>
                                                                                                <Span Text="{Binding Amount, Converter={StaticResource commaSeparatorConverter}}" />
                                                                                                <Span Text=" " />
                                                                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>

                                                                                    </custom:CustomLabel>

                                                                                    <custom:CustomLabel
                                                                                        Margin="0,-5,0,-5"
                                                                                        Style="{StaticResource CaptionLabelGrey}"
                                                                                        Text="{Binding Abtypt}"
                                                                                        VerticalOptions="End" />

                                                                                </StackLayout>

                                                                                <StackLayout
                                                                                    Grid.Row="0"
                                                                                    Grid.Column="1"
                                                                                    Orientation="Vertical">

                                                                                    <border:SfBorder
                                                                                        Grid.Row="0"
                                                                                        Grid.Column="1"
                                                                                        Padding="12,2,12,2"
                                                                                        BorderColor="{StaticResource SecondaryNew}"
                                                                                        BorderWidth="1"
                                                                                        CornerRadius="20"
                                                                                        HasShadow="False"
                                                                                        HeightRequest="32"
                                                                                        HorizontalOptions="EndAndExpand"
                                                                                        VerticalOptions="CenterAndExpand">

                                                                                        <StackLayout
                                                                                            BindingContext="{Binding .}"
                                                                                            HorizontalOptions="CenterAndExpand"
                                                                                            Orientation="Horizontal">
                                                                                            <Image
                                                                                                Margin="0,0,5,0"
                                                                                                HeightRequest="16"
                                                                                                Source="ic_iconpay_white"
                                                                                                VerticalOptions="CenterAndExpand"
                                                                                                WidthRequest="16" />
                                                                                            <custom:CustomLabel
                                                                                                FontFamily="{StaticResource SomarRegular}"
                                                                                                FontSize="11"
                                                                                                Text="{x:Static ResourceManager:AppResources.PaymentMethodPayNow}"
                                                                                                TextColor="{StaticResource SecondaryNew}"
                                                                                                VerticalOptions="CenterAndExpand" />

                                                                                        </StackLayout>

                                                                                        <border:SfBorder.GestureRecognizers>
                                                                                            <TapGestureRecognizer Tapped="BillsPayNowTapped" />
                                                                                        </border:SfBorder.GestureRecognizers>
                                                                                    </border:SfBorder>

                                                                                    <custom:CustomLabel
                                                                                        Margin="0,0,0,0"
                                                                                        HorizontalOptions="EndAndExpand"
                                                                                        Style="{StaticResource CaptionLabelGrey}">

                                                                                        <custom:CustomLabel.FormattedText>

                                                                                            <FormattedString>
                                                                                                <Span Text="{x:Static ResourceManager:AppResources.ASDueDate}" />
                                                                                                <Span Text=": " />
                                                                                                <Span Text="{Binding FormatedDuedate}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>
                                                                                    </custom:CustomLabel>

                                                                                </StackLayout>

                                                                            </Grid>

                                                                        </StackLayout>
                                                                    </cards:SfCardView>

                                                                </DataTemplate>
                                                            </listView:SfListView.ItemTemplate>

                                                        </listView:SfListView>


                                                        <!--
                                                    <chart:SfChart ChartPadding="15"  BackgroundColor="White"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="250" IsVisible="true">
                                                        <chart:SfChart.Series>
                                                            <chart:DoughnutSeries  x:Name="doughnutSeries"  ItemsSource="{Binding MyBillsChartModels}" XBindingPath="BillType" YBindingPath="BillCount" TrackColor="{Binding BillColor}"
                                                                               Color="{Binding BillColor}" DoughnutCoefficient="0.95" CircularCoefficient=".9">
                                                                <chart:DoughnutSeries.ColorModel>
                                                                    <chart:ChartColorModel Palette="Custom" CustomBrushes="{Binding Colors}">
                                                                    </chart:ChartColorModel>
                                                                </chart:DoughnutSeries.ColorModel>

                                                                <chart:DoughnutSeries.CenterView>
                                                                    <StackLayout HorizontalOptions = "FillAndExpand" VerticalOptions = "FillAndExpand">
                                                                        <custom:CustomLabel Text="{Binding Source={x:Reference Name=doughnutSeries},Path=BindingContext.TotalString}" FontSize="11" Style="{StaticResource CaptionLabelBlack}"/>
                                                                        <custom:CustomLabel Text="{Binding Source={x:Reference Name=doughnutSeries},Path=BindingContext.BillCount}" FontSize="24" HorizontalOptions="Center" HorizontalTextAlignment="Center" StyleId="OnBoardText"/>
                                                                    </StackLayout>
                                                                </chart:DoughnutSeries.CenterView>
                                                            </chart:DoughnutSeries>
                                                        </chart:SfChart.Series>
                                                    </chart:SfChart>
                                                    <StackLayout Orientation="Horizontal" Spacing="2" HorizontalOptions="Center" VerticalOptions="CenterAndExpand">
                                                        <buttons:SfButton  HorizontalTextAlignment="Start" PressedBackgroundColor="AliceBlue" Clicked="unPaidClicked"    Style="{StaticResource CaptionButtonBlack}" ImageSource="ic_unpaid" ShowIcon="True" Text="{Binding UnPaidString}" BorderColor="LightGray" BorderWidth="1" CornerRadius="20"  VerticalTextAlignment="Center" BackgroundColor="White" HorizontalOptions="Start"/>
                                                        <buttons:SfButton   HorizontalTextAlignment="Start" PressedBackgroundColor="AliceBlue"  Clicked="partiallyClicked" Style="{StaticResource CaptionButtonBlack}" ImageSource="partially_clock" ShowIcon="True" Text="{Binding PartiallyPaidString}" BorderColor = "LightGray" BorderWidth="1"  BackgroundColor="White" CornerRadius="20" VerticalTextAlignment="Center" HorizontalOptions="Start"/>
                                                    </StackLayout>
                                                        -->

                                                    </StackLayout>
                                                </cards:SfCardView>


                                            </StackLayout>
                                        </yummy:PancakeView>
                                    </StackLayout>


                                    <!--  Next Commitments  -->
                                    <StackLayout>
                                        <StackLayout BackgroundColor="LightGray">
                                            <yummy:PancakeView BackgroundColor="White">
                                                <StackLayout Margin="15,15,15,0" VerticalOptions="Start">

                                                    <custom:CustomLabel
                                                        Style="{StaticResource SectionTitleBlack}"
                                                        Text="{Binding NextCommitmentsString}"
                                                        VerticalOptions="Center" />
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="30" />
                                                        </Grid.ColumnDefinitions>
                                                        <custom:CustomLabel
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Style="{StaticResource ValueLabelBlackMedium}"
                                                            Text="{Binding SelectedCommitmentFilterValue}" />


                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Margin="5,5,5,5"
                                                            HorizontalOptions="Start"
                                                            Source="arrowDropdown"
                                                            VerticalOptions="Start" />
                                                        <custom:CustomButton
                                                            x:Name="btn1"
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            BackgroundColor="Transparent"
                                                            Clicked="btnCommitmentsPickerClicked" />

                                                        <syncfusion:SfPicker
                                                            x:Name="CommitmentsPicker"
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="10,0,10,0"
                                                            BackgroundColor="White"
                                                            BorderColor="Black"
                                                            CancelButtonBackgroundColor="#EAF7CC"
                                                            CancelButtonTextColor="{StaticResource Primary}"
                                                            ColumnHeaderHeight="46"
                                                            FlowDirection="RightToLeft"
                                                            HeaderBackgroundColor="{StaticResource Primary}"
                                                            HeaderHeight="55"
                                                            HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                                            HeaderTextColor="White"
                                                            ItemHeight="40"
                                                            ItemsSource="{Binding CommitmentsListFilter}"
                                                            OKButtonBackgroundColor="#EAF7CC"
                                                            OKButtonTextColor="{StaticResource Primary}"
                                                            PickerHeight="250"
                                                            PickerMode="Dialog"
                                                            PickerWidth="300"
                                                            SelectedItemFontAttribute="Bold"
                                                            SelectedItemFontSize="15"
                                                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                                                            SelectionChanged="CommitmentsPicker_SelectionChanged"
                                                            ShowColumnHeader="False"
                                                            ShowFooter="False"
                                                            ShowHeader="False"
                                                            UnSelectedItemTextColor="{StaticResource NeutralGreay}">
                                                            <syncfusion:SfPicker.Behaviors>
                                                                <customcontrol:SfPickerBehavior />
                                                            </syncfusion:SfPicker.Behaviors>
                                                        </syncfusion:SfPicker>
                                                    </Grid>

                                                    <Label
                                                        FlowDirection="RightToLeft"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        IsVisible="{Binding SetNoCommitmentsAvailableLabelVisibility}"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{x:Static ResourceManager:AppResources.NoAppointmentText}"
                                                        VerticalOptions="Center" />

                                                    <CollectionView
                                                        x:Name="CollectionView_Commitment"
                                                        BackgroundColor="Transparent"
                                                        HeightRequest="80"
                                                        HorizontalOptions="FillAndExpand"
                                                        HorizontalScrollBarVisibility="Never"
                                                        IsVisible="{Binding SetMyCommitmentsCollectionVisibility}"
                                                        ItemsLayout="HorizontalList"
                                                        ItemsSource="{Binding BillsAndReturnsCommitments}"
                                                        VerticalOptions="FillAndExpand">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackLayout Margin="8" Orientation="Horizontal">
                                                                    <cards:SfCardView
                                                                        Margin="0,0,0,5"
                                                                        BorderColor="{StaticResource NeutralLightGrey}"
                                                                        BorderWidth="1"
                                                                        CornerRadius="14"
                                                                        HasShadow="False">
                                                                        <StackLayout Orientation="Horizontal">
                                                                            <cards:SfCardView
                                                                                Margin="{OnPlatform UWP='*',
                                                                                                    iOS='1',
                                                                                                    Android='0,0,0,-5'}"
                                                                                CornerRadius="14"
                                                                                HasShadow="False"
                                                                                HeightRequest="80"
                                                                                IsVisible="{Binding IsUnSubmittedReturn}"
                                                                                WidthRequest="80">
                                                                                <StackLayout
                                                                                    HorizontalOptions="Center"
                                                                                    Orientation="Vertical"
                                                                                    Spacing="0"
                                                                                    VerticalOptions="Center">
                                                                                    <custom:CustomLabel
                                                                                        Margin="0,0,0,-2"
                                                                                        HorizontalTextAlignment="Center"
                                                                                        VerticalOptions="End"
                                                                                        VerticalTextAlignment="Center">
                                                                                        <custom:CustomLabel.FormattedText>
                                                                                            <FormattedString>
                                                                                                <Span Style="{StaticResource ValueLabelWhiteMedium}" Text="{Binding Day}" />
                                                                                            </FormattedString>
                                                                                        </custom:CustomLabel.FormattedText>
                                                                                    </custom:CustomLabel>
                                                                                    <custom:CustomLabel
                                                                                        Margin="0,-2,0,0"
                                                                                        HorizontalTextAlignment="Center"
                                                                                        VerticalOptions="Start"
                                                                                        VerticalTextAlignment="Center">
                                                                                        <custom:CustomLabel.FormattedText>
                                                                                            <FormattedString>
