                                                        Grid.Column="0"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        Text="{x:Static ResourceManager:AppResources.ZakatBillAmount}" />
                                                    <custom:CustomLabel
                                                        Grid.Row="4"
                                                        Grid.Column="1"
                                                        HorizontalOptions="StartAndExpand"
                                                        HorizontalTextAlignment="Start"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding amount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                </StackLayout>
                            </border:SfBorder>

                            <!--  Installment Agreement Section  -->


                            <border:SfBorder
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,16,0,10"
                                HasShadow="False"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>-->
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_vat_bill"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />
                                            <custom:CustomLabel
                                                Padding="8,0"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.VATInstalmentAgrement}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="8,0"
                                            HorizontalOptions="End">
                                            <custom:CustomLabel
                                                FontSize="Medium"
                                                Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                TextColor="{StaticResource Secondary}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoBackToAggrement}" />
                                                </Label.GestureRecognizers>
                                            </custom:CustomLabel>

                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                    <Grid
                                        Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Margin="10,5,10,5">
                                        <custom:CustomLabel
                                            Grid.Column="0"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" />
                                        <custom:CustomLabel
                                            Grid.Column="1"
                                            HorizontalOptions="StartAndExpand"
                                            HorizontalTextAlignment="Start"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding NoOfInstalments}" />
                                    </Grid>

                                </StackLayout>
                            </border:SfBorder>


                            <border:SfBorder
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,16,0,10"
                                HasShadow="False"
                                IsVisible="{Binding IsAttachmentsListVisible}"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0">
                                    <Grid Padding="15" RowSpacing="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>-->
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">
                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_attachment"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <custom:CustomLabel
                                                Padding="8,0"
                                                Style="{StaticResource SectionTitleBlackBold}"
                                                Text="{x:Static ResourceManager:AppResources.Attachments}"
                                                VerticalOptions="CenterAndExpand" />
                                        </StackLayout>
                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="8,0"
                                            HorizontalOptions="End">
                                            <custom:CustomLabel
                                                FontSize="Medium"
                                                Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                TextColor="{StaticResource Secondary}"
                                                VerticalOptions="CenterAndExpand">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding GoBackToAttachments}" />
                                                </Label.GestureRecognizers>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                    </Grid>

                                    <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                    <listView:SfListView
                                        x:Name="SummaryattachmentsListView"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        AutoFitMode="Height"
                                        HorizontalOptions="Center"
                                        IsScrollBarVisible="False"
                                        IsScrollingEnabled="False"
                                        ItemSpacing="5"
                                        ItemsSource="{Binding AttachmentsListViewData}"
                                        SelectionBackgroundColor="Transparent"
                                        SelectionMode="None"
                                        VerticalOptions="Center">
                                        <listView:SfListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Margin="10,5,10,0"
                                                    Padding="0"
                                                    RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Spacing="-2">
                                                        <Image
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="5,0"
                                                            HeightRequest="25"
                                                            HorizontalOptions="Start"
                                                            Source="documents_Green"
                                                            VerticalOptions="Center"
                                                            WidthRequest="25" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Spacing="-2">
                                                        <custom:CustomLabel
                                                            HorizontalOptions="End"
                                                            HorizontalTextAlignment="End"
                                                            Style="{StaticResource ValueLabelBlack}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="FillAndExpand" />
                                                    </StackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </listView:SfListView.ItemTemplate>
                                    </listView:SfListView>
                                </StackLayout>
                            </border:SfBorder>

                        </Grid>


                        <Grid Grid.Row="2" Grid.ColumnSpan="2">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0">
                                <Frame
                                    Grid.Row="0"
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    CornerRadius="12"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">
                                    <Grid Padding="10,3,10,2" HorizontalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>



                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}" />
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding MonthlyInstalment, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                    </Grid>
                                </Frame>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0">
                                <Frame
                                    Grid.Row="0"
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    CornerRadius="12"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">
                                    <StackLayout
                                        Padding="10,3,10,2"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.VatInstalmentAgrPenalty}" />
                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding VATPenalityAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                    </StackLayout>
                                </Frame>
                            </Grid>



                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0">

                                <Frame
                                    Grid.Row="0"
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    CornerRadius="12"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">
                                    <StackLayout
                                        Padding="10,3,10,2"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal">
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetTotalAmount}" />
                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding VATBillDueAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}" />
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <Grid
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,10">

                                <StackLayout>

                                    <buttons:SfButton
                                        x:Name="SummarybtnContinue"
                                        Margin="0,16,0,16"
                                        Command="{Binding SummaryContinueBtnTapped}"
                                        HeightRequest="48"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.Submit}"
                                        WidthRequest="366" />

                                </StackLayout>
                            </Grid>
                        </Grid>
                    </Grid>


                    <!--  Loadig Indiacatr  -->


                    <Grid BackgroundColor="Transparent" IsVisible="{Binding IsLoading}">
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="Black"
                            Opacity="0.4"
                            Orientation="Vertical"
                            VerticalOptions="FillAndExpand" />
                        <StackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="15,15"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            Opacity="0.8"
                            Orientation="Vertical"
                            VerticalOptions="Center">
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                <busyindicator:SfBusyIndicator
                                    x:Name="busyindicatorForLanding"
                                    AnimationType="SingleCircle"
                                    EnableAnimation="True"
                                    HorizontalOptions="CenterAndExpand"
                                    IsBusy="True"
                                    TextColor="{StaticResource Secondary}"
                                    TitlePlacement="Bottom"
                                    VerticalOptions="CenterAndExpand"
                                    ViewBoxHeight="70"
                                    ViewBoxWidth="70" />
                                <!--  Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"  -->
                            </StackLayout>
                        </StackLayout>
                    </Grid>


                </Grid>

            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
