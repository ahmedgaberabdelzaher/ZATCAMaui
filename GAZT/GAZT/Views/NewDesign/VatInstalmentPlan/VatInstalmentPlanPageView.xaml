<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
            xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:local1="clr-namespace:EGAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:custom2="clr-namespace:EGAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             mc:Ignorable="d" FlowDirection="RightToLeft"    
              xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.VatInstalmentPlan.VatInstalmentPlanPageView" 
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--<DataTemplate x:Key="BillStatusFilterTemplate">
                <StackLayout>
                    <buttons:SfChip HeightRequest="40" WidthRequest="120" Text="{Binding Text}" BackgroundColor="White" TextColor="{StaticResource NeutralBlack}" ShowIcon="True" ImageSource="{Binding ImageSource}"  ShowCloseButton="False" ShowSelectionIndicator="False" ImageAlignment="Left" />
                </StackLayout>
            </DataTemplate>
            <local1:ChipDataTemplateSelector x:Key="selector" 
                                          
                                            SadEmojiTemplate = "{StaticResource BillStatusFilterTemplate}"/>-->
        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </custom:CustomLabel>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="2"  Style="{StaticResource IconLabelStyle}" TextColor="White" Text="{StaticResource Close}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </custom:CustomLabel>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <Grid>
                <Grid.RowDefinitions>
                   
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
               
                <Grid Grid.Row="0">

                    <!--Code for Zakat & VAT options-->

                    <Grid IsVisible="{Binding IsSelectionViewEnabled}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand"/>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPlan}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                           
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="2" VerticalOptions="End">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"  Margin="0,10,0,0">

                                <border:SfBorder Style="{StaticResource SfStyleGreyBorderFrame}" Padding="10">
                                    <StackLayout  Orientation="Horizontal">

                                        <custom:CustomLabel
                                        Text="{x:Static ResourceManager:AppResources.VATAmountDue}"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center"
                                        Style="{StaticResource BodyLabelBlack}" />

                                        <custom:CustomLabel Text="{Binding VATDueAmount,StringFormat='{0:N} SAR'}" HorizontalOptions="EndAndExpand"
                                                        VerticalOptions="Center"
                                                        Style="{StaticResource SectionTitleBlackBold}" />

                                    </StackLayout>
                                </border:SfBorder>

                            </Grid>

                            <border:SfBorder Grid.Row="1" BorderColor="#B1B1B1" BorderWidth="1" Margin="0,10,0,10"
                             Style="{StaticResource GreyBorderFrame}">
                                <Grid Margin="8">
                                    <StackLayout Orientation="Vertical">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Row="0" Grid.Column="0 ">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                 Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                                </Image.Source>

                                            </Image>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.Information}"
                                            Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" />
                                        </Grid>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VatDueAmountInstruction}"
                                        HorizontalOptions="StartAndExpand"
                                        VerticalOptions="Fill"
                                        Style="{StaticResource CaptionLabelGrey}" />

                                    </StackLayout>
                                </Grid>
                            </border:SfBorder>

                            <buttons:SfButton Grid.Row="2" Grid.Column="0"
                                          Margin="0,10,0,20" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                          Style="{StaticResource PrimaryButtonStyle}"
                                          Command="{Binding ReasonContinueBtnTapped}"
                                          IsEnabled="{Binding IsContinueButtonEnable}" />

                        </Grid>
                    </Grid>
                    <!-- Code for VAT Agreeemtns -->

                    <Grid IsVisible="{Binding IsAgreementViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand"/>
                        </Grid>
                        <Grid Grid.Row="1" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAgrement}" HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetRequestInstalmentDesc}" HorizontalOptions="StartAndExpand"
                                              Style="{StaticResource CaptionLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" HeightRequest="1"/>
                        </Grid>

                        <Grid Grid.Row="2"  >

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSchedule}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                        </Grid>

                        <Grid Grid.Row="3"  Margin="0,10,0,0">

                            <cards:SfCardView HasShadow="True"  CornerRadius="20" >
                                <StackLayout Padding="10">

                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />

                                    <custom:CustomLabel  Text="{Binding NoOfInstalments}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}" />

                                    <Frame CornerRadius="10"  
                                  BackgroundColor="WhiteSmoke" HasShadow="False"
                                    Padding="0">
                                        <StackLayout>
                                            <Slider  
                                            Maximum="{Binding MaxInstalments}" 
                                            Margin="5,5,5,10"                                                                                              
                                            MinimumTrackColor="{StaticResource Primary}"
                                                MaximumTrackColor="LightSlateGray"
                                                ThumbColor="{StaticResource Primary}"
                                            ValueChanged="Installment_ValueChanged"
                                     Minimum="{Binding MinInstalments}"/>

                                        </StackLayout>
                                    </Frame>
                                    <StackLayout Padding="10" Orientation="Horizontal">

                                        <custom:CustomLabel Text="{Binding MinInstalments,StringFormat='Min. {0}'}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                                        <custom:CustomLabel  Text="{Binding MaxInstalments,StringFormat='Max. {0}'}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </StackLayout>
                            </cards:SfCardView>

                        </Grid>

                        <Grid Grid.Row="4"  Margin="0,10,0,10" VerticalOptions="End">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <Frame Grid.Row="0" HorizontalOptions="FillAndExpand"
                               Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12"
                               Margin="0,20,0,0" Padding="0">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="10,3,10,2">
                                    <custom:CustomLabel
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}"
                                    Style="{StaticResource BodyLabelBlack}" HorizontalOptions="StartAndExpand" />
                                    <custom:CustomLabel Text="{Binding TotalAmountSAR}"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                    HorizontalOptions="EndAndExpand" />
                                </StackLayout>
                            </Frame>

                            <Grid Grid.Row="1">

                                <buttons:SfButton  Margin="0,16,0,16"  Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}"
                                              Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AggrementContinueBtnTapped}"/>

                            </Grid>
                        </Grid>

                    </Grid>

                    <!-- Code for Zakat & VAT Attachments -->

                    <Grid IsVisible="{Binding IsAttachmentsViewEnabled}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAttachments}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmentPleaseProvideWithSupportingDocuments}"
                                            HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />
                            <BoxView Grid.Row="2" Margin="0,15,0,0" Grid.Column="0"
                                 Style="{StaticResource NeutralGrayOpacity90BoxView}" HeightRequest="1" />
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="0">
                            <listView:SfListView x:Name="attachmentsListView" HorizontalOptions="Center"
                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding AttachmentsListViewData}"
                                             TapCommand="{Binding NewAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent"
                                             SelectionChanged="attachmentsListView_SelectionChanged">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Row="0" Grid.Column="0" Source="newui_ic_pdf" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>


                                                    <custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                    Text="{Binding Filename}"
                                                                    FontSize="Small" TextColor="Black"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    VerticalOptions="Center"/>
                                                    <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                        <Image.Source>
                                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </border:SfBorder>
                                            <custom:CustomLabel Grid.Row="1"
                                                            Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                                            HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MicroGrayLabelStyle}" />

                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="0" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0"
                                            Text="{x:Static ResourceManager:AppResources.FDANewAttachment}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />
                            <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                    FontSize="Small" TextColor="Black"
                                                    HorizontalOptions="FillAndExpand" />
                                    <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                       Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                         Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </border:SfBorder>
                            <custom:CustomLabel Grid.Row="2"
                                            Text="{x:Static ResourceManager:AppResources.VR20MB}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                            </Grid.GestureRecognizers>

                        </Grid>
                        <Grid Grid.Row="4" VerticalOptions="End" Grid.Column="0">
                            <StackLayout>
                                <buttons:SfButton Margin="0,16,0,16" x:Name="btnAttachmentContinue"
                                              Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding AttachmentsContinueBtnTapped}" />
                            </StackLayout>
                        </Grid>

                    </Grid>


                    <!--Code for VAT Bill selection-->

                    <Grid IsVisible="{Binding IsVATBillsViewEnabled}" BackgroundColor="Transparent"  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="15,10,15,10" >

                        <listView:SfListView x:Name="BillsVATListVIew" HorizontalOptions="FillAndExpand"
                                              VerticalOptions="FillAndExpand"
                                                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                  AutoFitMode="DynamicHeight" ItemSpacing="10" RowSpacing="15" SelectionMode="Multiple"
                                      SelectionBackgroundColor="Transparent" ItemTapped="Bills_ItemTapped" ColumnSpacing="10" >

                       
                            <listView:SfListView.HeaderTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ViewCell.View>
                                            <StackLayout>
                                                <Grid Grid.Row="0">
                                                    <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand"/>
                                                </Grid>
                                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatSelectBillsPageViewSelectBills}" HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource PageTitleBlack}" />
                                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatSelectBillsPageViewSelectBillsGray}" HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}" />
                                                <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" HeightRequest="1"/>

                                                <Frame Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="0" Grid.ColumnSpan="3" HasShadow="False"  CornerRadius="12" BorderColor="Gray"  Margin="0,15,0,15">

                                                    <SearchBar Text="{Binding InputData}"  Margin="0" TextChanged="SearchItem_PropertyChanged"
                           Placeholder="{x:Static ResourceManager:AppResources.ZakatSelectBillsPageViewPlaceholder}"
                           Style="{StaticResource CaptionLabelGrey}" HorizontalTextAlignment="Center"
                           HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />

                                                </Frame>

                                            </StackLayout>
                                        </ViewCell.View>
                                    </ViewCell>
                                </DataTemplate>
                            </listView:SfListView.HeaderTemplate>

                            <listView:SfListView.FooterTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ViewCell.View>

                                            <StackLayout>
                                                <Frame Grid.Row="0"  HorizontalOptions="FillAndExpand" Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12" Margin="0,20,0,0" Padding="0">
                                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10,3,10,2">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetTotalAmount}" Style="{StaticResource BodyLabelBlack}" HorizontalOptions="StartAndExpand" />
                                                        <custom:CustomLabel Text="{Binding TotalAmountSAR}" Style="{StaticResource SectionTitleBlackBold}" HorizontalOptions="EndAndExpand" />
                                                    </StackLayout>
                                                </Frame>

                                                <buttons:SfButton  Margin="0,16,0,16" x:Name="btnVATBillsContinue"
                                                   Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   BackgroundColor="{Binding IsBillContinueBackGroundColor}"
                                                   IsEnabled="{Binding IsBillContinueEnabled}"
                                                   Command="{Binding BillContinueBtnTapped}"/>

                                            </StackLayout>
                                        </ViewCell.View>
                                    </ViewCell>
                                </DataTemplate>
                            </listView:SfListView.FooterTemplate>

                            <listView:SfListView.ItemTemplate>

                                    <DataTemplate>
                                        <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="10"  >
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                                                <Image Source="vat_tile_IbanCard_background_white" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="10" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50*"></ColumnDefinition>
                                                        <ColumnDefinition Width="50*"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZZVAT}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource SectionTitleBlack}" />
                                                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageAmendment}" HorizontalOptions="StartAndExpand"
                                                            Style="{StaticResource MiniNewGrayLabelStyle}"/>
                                                    <BoxView Grid.Row="2"  Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="1"/>
                                                    <custom:CustomLabel Grid.Row="3" Text="{x:Static ResourceManager:AppResources.ZakatBillAmount}" HorizontalOptions="StartAndExpand" Style="{StaticResource MiniNewGrayLabelStyle}"></custom:CustomLabel>
                                                    <custom:CustomLabel Grid.Row="4" Text="{Binding Betrh,StringFormat='{0:N} SAR'}" HorizontalOptions="StartAndExpand" Style="{StaticResource SectionTitleBlack}"></custom:CustomLabel>

                                                    <custom:CustomLabel Grid.Row="5" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZSadadNumber}" Style="{StaticResource MiniNewGrayLabelStyle}"></custom:CustomLabel>
                                                    <custom:CustomLabel Grid.Row="6" Grid.Column="0" Text="{Binding SadadNo}" Style="{StaticResource GAZTCaptionBlackLabel}"></custom:CustomLabel>
                                                    <custom:CustomLabel Grid.Row="5" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZTaxPeriod}" Style="{StaticResource MiniNewGrayLabelStyle}"></custom:CustomLabel>
                                                    <custom:CustomLabel Grid.Row="6" Grid.Column="1" Text="{Binding Taxperioddsc}" Style="{StaticResource GAZTCaptionBlackLabel}"></custom:CustomLabel>
                                                </Grid>
                                            </Grid>
                                        </cards:SfCardView>

                                    </DataTemplate>

                                </listView:SfListView.ItemTemplate>

                                <listView:SfListView.SelectedItemTemplate>

                                    <DataTemplate>
                                        <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="10"  >
                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
