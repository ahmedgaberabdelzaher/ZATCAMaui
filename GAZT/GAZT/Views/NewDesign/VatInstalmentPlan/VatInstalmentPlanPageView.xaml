<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.VatInstalmentPlan.VatInstalmentPlanPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local1="clr-namespace:EGAZT.CustomControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>

                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            MaxLines="1"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <Grid>
                <Grid.RowDefinitions>

                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <!--  Code for Zakat & VAT options  -->

                    <Grid
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsSelectionViewEnabled}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <commonView:PageIndicatorView
                                Margin="20,25,0,0"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="0,5,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPlan}" />

                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="2" VerticalOptions="StartAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,10,0,0">

                                <border:SfBorder Padding="10" Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <StackLayout Orientation="Horizontal">

                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.VATAmountDue}"
                                            VerticalOptions="Center" />

                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlack}"
                                            Text="{Binding VATDueAmount, StringFormat='{0:N} SAR', Converter={StaticResource commaSeparatorConverter}}"
                                            VerticalOptions="Center" />

                                    </StackLayout>
                                </border:SfBorder>

                            </Grid>

                            <border:SfBorder
                                Grid.Row="1"
                                Margin="0,10,0,10"
                                BorderColor="#B1B1B1"
                                BorderWidth="1"
                                Style="{StaticResource GreyBorderFrame}">
                                <Grid Margin="8">
                                    <StackLayout Orientation="Vertical">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Row="0" Grid.Column="0 ">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                                        Size="24"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>

                                            </Image>
                                            <custom:CustomLabel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{x:Static ResourceManager:AppResources.Information}" />
                                        </Grid>
                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.VatDueAmountInstruction}"
                                            VerticalOptions="Fill" />

                                    </StackLayout>
                                </Grid>
                            </border:SfBorder>

                            <Grid
                                Grid.Row="2"
                                Margin="0,10,0,10"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--<CheckBox Grid.Column="0" Color="{StaticResource NewDarkGreenColor}"
                                          IsChecked="{Binding IsFirstCheckboxChecked}">
                                    <CheckBox.Triggers>
                                        <DataTrigger TargetType="CheckBox" Value="false">
                                            <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                        </DataTrigger>
                                    </CheckBox.Triggers>
                                </CheckBox>

                                <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.VatInstalmentContinueCheckboxText}"
                                                    Style="{StaticResource GAZTMicroMediumGrayLabel}" HorizontalOptions="StartAndExpand"
                                                    HorizontalTextAlignment="Start" VerticalTextAlignment="Center"/>-->

                                <custom1:CheckboxCustom
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsChecked="{Binding IsFirstCheckboxChecked}"
                                    Style="{StaticResource CheckboxHeightWidth32}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.VatInstalmentContinueCheckboxText}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsFirstCheckboxChecked}"
                                            TargetType="custom:CustomLabel"
                                            Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsFirstCheckboxChecked}"
                                            TargetType="custom:CustomLabel"
                                            Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </Grid>


                            <buttons:SfButton
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,10,0,20"
                                BackgroundColor="{Binding IsSelectionContinueBackGroundColor}"
                                Command="{Binding ReasonContinueBtnTapped}"
                                HeightRequest="48"
                                IsEnabled="{Binding IsFirstCheckboxChecked}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                WidthRequest="366" />

                        </Grid>
                    </Grid>
                    <!--  Code for VAT Agreeemtns  -->

                    <Grid
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsAgreementViewEnabled}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <commonView:PageIndicatorView
                                Margin="20,25,0,0"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="0,5,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.VATInstalmentAgrement}" />
                            <custom:CustomLabel
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.VATInstalmetRequestInstalmentDesc}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                HeightRequest="1"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                        </Grid>

                        <Grid Grid.Row="2">

                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource SectionTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSchedule}" />

                        </Grid>

                        <Grid Grid.Row="3" Margin="0,10,0,0">

                            <cards:SfCardView CornerRadius="20" HasShadow="False">
                                <StackLayout Padding="10">

                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" />

                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{Binding NoOfInstalments}" />

                                    <Frame
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        CornerRadius="10"
                                        HasShadow="False">
                                        <StackLayout>
                                            <Slider
                                                Margin="5,5,5,10"
                                                IsEnabled="{Binding IsViewEnable}"
                                                Maximum="{Binding MaxInstalments}"
                                                MaximumTrackColor="LightSlateGray"
                                                Minimum="{Binding MinInstalments}"
                                                MinimumTrackColor="{StaticResource Primary}"
                                                ThumbColor="{StaticResource Primary}"
                                                ValueChanged="Installment_ValueChanged"
                                                Value="{Binding NoOfInstalments}" />

                                        </StackLayout>
                                    </Frame>
                                    <StackLayout Padding="10" Orientation="Horizontal">


                                        <custom:CustomLabel
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding MinInstalmentsTitle}"
                                            VerticalTextAlignment="Center" />



                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding MaxInstalmentsTitle}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>
                                </StackLayout>
                            </cards:SfCardView>

                        </Grid>

                        <Grid
                            Grid.Row="4"
                            Margin="0,10,0,10"
                            VerticalOptions="End">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Frame
                                Grid.Row="0"
                                Margin="0,20,0,0"
                                Padding="0"
                                CornerRadius="12"
                                HasShadow="False"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="False"
                                Style="{StaticResource SfStyleForZakatPlanGreen}">
                                <StackLayout
                                    Padding="10,3,10,2"
                                    HorizontalOptions="FillAndExpand"
                                    Orientation="Horizontal">
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}" />
                                    <custom:CustomLabel
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource SectionTitleBlack}"
                                        Text="{Binding TotalAmountSAR, Converter={StaticResource commaSeparatorConverter}}" />
                                </StackLayout>
                            </Frame>

                            <Grid Grid.Row="1">

                                <buttons:SfButton
                                    Margin="0,16,0,16"
                                    Command="{Binding AggrementContinueBtnTapped}"
                                    HeightRequest="48"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDetails}"
                                    WidthRequest="366" />

                            </Grid>
                        </Grid>

                    </Grid>

                    <!--  Code for Zakat & VAT Attachments  -->

                    <Grid
                        Margin="20,10,20,0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsAttachmentsViewEnabled}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <commonView:PageIndicatorView
                                Margin="20,25,0,0"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="0,5,0,0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAttachments}" />
                            <custom:CustomLabel
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentPleaseProvideWithSupportingDocuments}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,15,0,0"
                                HeightRequest="1"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="0">
                            <listView:SfListView
                                x:Name="attachmentsListView"
                                AutoFitMode="Height"
                                HorizontalOptions="Center"
                                IsScrollBarVisible="False"
                                IsScrollingEnabled="False"
                                ItemSpacing="5"
                                ItemsSource="{Binding AttachmentsListViewData}"
                                SelectionBackgroundColor="Transparent"
                                SelectionChanged="attachmentsListView_SelectionChanged"
                                SelectionMode="SingleDeselect"
                                TapCommand="{Binding NewAttachmentTapped}"
                                VerticalOptions="Center">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>

                                            <border:SfBorder
                                                Grid.Row="0"
                                                Margin="0,0,0,10"
                                                Padding="12"
                                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Margin="5,0"
                                                        HeightRequest="25"
                                                        HorizontalOptions="Start"
                                                        Source="Generic_attachment_icon"
                                                        VerticalOptions="Center"
                                                        WidthRequest="25" />

                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource ValueLabelBlack}"
                                                        Text="{Binding Filename}"
                                                        VerticalOptions="Center" />

                                                    <!--<custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                                                    Text="{Binding Filename}"
                                                                    FontSize="Small" TextColor="{StaticResource PrimaryColor}"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    VerticalOptions="FillAndExpand"/>-->
                                                    <Image
                                                        Grid.Row="0"
                                                        Grid.Column="2"
                                                        HorizontalOptions="Center"
                                                        Rotation="90"
                                                        VerticalOptions="Center">
                                                        <Image.Source>
                                                            <FontImageSource
                                                                FontFamily="UserIconFont"
                                                                Glyph="{x:Static FontImage:IconFonts.Close}"
                                                                Size="24"
                                                                Color="{StaticResource SecondaryNew}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </border:SfBorder>


                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </Grid>

                        <Grid
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource MicroGrayLabelStyle}"
                                Text="{x:Static ResourceManager:AppResources.FDANewAttachment}" />
                            <border:SfBorder
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="10"
                                Style="{StaticResource SfStyleGreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="Small"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                        TextColor="{StaticResource PrimaryColor}" />
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="Center"
                                        Rotation="90"
                                        VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.Attachment}"
                                                Size="24"
                                                Color="{StaticResource SecondaryNew}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </border:SfBorder>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                            </Grid.GestureRecognizers>

                        </Grid>
                        <Grid
                            Grid.Row="4"
                            Grid.Column="0"
                            VerticalOptions="End">
                            <StackLayout>
                                <buttons:SfButton
                                    x:Name="btnAttachmentContinue"
                                    Margin="0,16,0,16"
                                    Command="{Binding AttachmentsContinueBtnTapped}"
                                    HeightRequest="48"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}"
                                    WidthRequest="366" />
                            </StackLayout>
                        </Grid>

                    </Grid>


                    <!--  Code for VAT Bill selection  -->

                    <Grid
                        Margin="15,10,15,10"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsVATBillsViewEnabled}"
                        VerticalOptions="FillAndExpand">

                        <listView:SfListView
                            x:Name="BillsVATListVIew"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            AutoFitMode="DynamicHeight"
                            ColumnSpacing="10"
                            HorizontalOptions="FillAndExpand"
                            ItemSpacing="10"
                            ItemTapped="Bills_ItemTapped"
                            RowSpacing="10"
                            SelectionBackgroundColor="Transparent"
                            SelectionChanging="listView_SelectionChanging"
                            SelectionMode="Multiple"
                            VerticalOptions="FillAndExpand">


                            <listView:SfListView.HeaderTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <ViewCell.View>
                                            <StackLayout>
                                                <Grid Grid.Row="0">
                                                    <commonView:PageIndicatorView
                                                        Margin="20,25,0,0"
                                                        Completed="{Binding MarkComplete}"
                                                        DotSize="12"
                                                        HorizontalOptions="End"
                                                        MaxNum="{Binding MaxIndex}"
