<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:local1="clr-namespace:EGAZT.CustomControl"
    x:Name="ChangeMobPageView"
    xmlns:converter="clr-namespace:EGAZT.Helper"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    x:Class="EGAZT.Views.SyncFusionEnabledViews.LoginPages.ChangeMobileRequestPageView">
      <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
          <converter:InverseBoolConverter x:Key="BoolConverter"/>
    </ContentPage.Resources>
    <ContentPage.Content>

         <ScrollView>
                <StackLayout>

                    <Grid>

                        <Grid Grid.Row="0" VerticalOptions="StartAndExpand" Margin="0,8,0,0" IsVisible="{Binding ShowMainForm}">
                    <Grid Margin="8,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" /> 
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                    <StackLayout Orientation="Vertical" Grid.Row="0" VerticalOptions="StartAndExpand">

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ChangeMobileNumber}" Margin="8"   Style="{StaticResource PageTitleBlack}" />
                        <BoxView BackgroundColor="{StaticResource NeutralLightGrey}"  HeightRequest="1"/>
                        <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1" Margin="0,0,0,10"
                             Style="{StaticResource GreyBorderFrame}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                    
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" Source="ic_vat_info.png" HorizontalOptions="Start"
                                           VerticalOptions="Center" />
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ChangeMobHeader}" 
                                                        Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource ValueLabelBlack}" />
                                                                                                                                                                                                                                                                                                                                                                               

                            </Grid>
                        </border:SfBorder>                                                    
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.DoYouHaveAccountInNafath}" Margin="8,0,0,0"   Style="{StaticResource CardLabelBlack}" />
                        <cards:SfCardView HasShadow="True" TranslationX="5" Padding="10" Margin="8,0,18,8" >
                                 <custom:CustomLabel FontSize="14" TextColor="Blue" Text="{x:Static ResourceManager:AppResources.NafathLinkText}" 
                                                            Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                                             >
                                     <custom:CustomLabel.GestureRecognizers>
                                         <TapGestureRecognizer Command="{Binding NafathClicked}" NumberOfTapsRequired="1" />
                                     </custom:CustomLabel.GestureRecognizers>

                                 </custom:CustomLabel>
                            </cards:SfCardView>

                    </StackLayout>

                    <StackLayout Orientation="Vertical" Margin="10,0,10,0" Grid.Row="1" VerticalOptions="StartAndExpand">
                        <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1" Margin="0,0,0,10"
                            Style="{StaticResource GreyBorderFrame}">
                            <StackLayout Orientation="Vertical">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ManualRequestTitle}" Margin="8,15,0,0"   Style="{StaticResource CardLabelBlack}" />
                  
                                <StackLayout  Orientation="Vertical" Margin="8,0,8,0">
                                    <custom:CustomLabel 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ManagerName}"  />
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <border:SfBorder Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry
                                        HorizontalOptions="FillAndExpand"
                                        MaxLength="40"
                                        Text="{Binding ManagerName}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </border:SfBorder>

                                </StackLayout>
                                <StackLayout Margin="8,0,8,0">
                                <custom:CustomLabel 
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" FontFamily="{StaticResource SomarLight}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}"/>
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <border:SfBorder Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding SelectedIDType}"
                                                        HorizontalOptions="FillAndExpand"
                                                        Style="{StaticResource BodyLabelBlack}"  />

                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" >
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource Secondary}" Size="32"
                                                                Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                            </Image.Source>
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowIdTypePicker}" NumberOfTapsRequired="1"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Grid>

                                
                                </border:SfBorder>
                                </StackLayout>
                                <StackLayout Margin="8,0,8,0">

                                    <custom:CustomLabel 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ManagerID}"  />
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <border:SfBorder Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry
                                        MaxLength="15"
                                        HorizontalOptions="FillAndExpand"
                                        Text="{Binding ManagerId}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </border:SfBorder>
                                </StackLayout>
                                <StackLayout Margin="8,0,8,0" Orientation="Vertical">
                                    <custom:CustomLabel 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.TIN}"  />
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                <border:SfBorder Padding="10" Style="{StaticResource GreyBorderFrame}">
                                    <custom:BorderlessEntry
                                        Keyboard="Numeric"
                                        MaxLength="10"
                                        HorizontalOptions="FillAndExpand"
                                        Text="{Binding TinNumber}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </border:SfBorder>

                                </StackLayout>
                                <buttons:SfButton  Margin="8,0,8,8" 
                                              
                                              Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding ContinueBtnTapped}" />


                            </StackLayout>
                       
                        </border:SfBorder>
                    </StackLayout>

                    </Grid>
                    </Grid >

                    <Grid Grid.Row="0" VerticalOptions ="FillAndExpand" Margin="0,8,0,0" IsVisible="{Binding ShowOtpForm}" >
                    <Grid Margin="8,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" /> 
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                    <StackLayout Orientation="Vertical" Grid.Row="0" VerticalOptions="StartAndExpand">

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ChangeMobileNumber}" Margin="8"   Style="{StaticResource PageTitleBlack}" />

                        <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1" Margin="0,0,0,10"
                             Style="{StaticResource GreyBorderFrame}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                    
                                    <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" Source="ic_vat_info.png" HorizontalOptions="Start"
                                           VerticalOptions="Center" />
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ChangeMobHeader}" 
                                                        Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                                        Style="{StaticResource ValueLabelBlack}" />
                                                                                                                                                                                                                                                                                                                                                                               

                            </Grid>
                        </border:SfBorder> 

                        <BoxView BackgroundColor="{StaticResource NeutralLightGrey}"  HeightRequest="1"/>
                        <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1" Margin="0,0,0,10"
                             Style="{StaticResource GreyBorderFrame}">
                            <Grid Margin="8" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>


                                <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ManagerID}"  />
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding ManagerId}" Margin="8,0,0,0"   Style="{StaticResource CardLabelBlack}" />
                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" 
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ManagerName}"  />
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="{Binding ManagerName}" Margin="8,0,0,0"   Style="{StaticResource CardLabelBlack}" />

                                <custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="Center"
                                        Style="{StaticResource CaptionLabelGrey}"
                                    FontSize="14">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.TIN}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <custom:CustomLabel Grid.Row="2" Grid.Column="1" Text="{Binding TinNumber}" Margin="8,0,0,0"   Style="{StaticResource CardLabelBlack}" IsVisible="{Binding IsTINManual,Converter={StaticResource BoolConverter}}" />

                                <border:SfBorder Grid.Row="2" Grid.Column="1" Padding="8" Style="{StaticResource GreyBorderFrame}" IsVisible="{Binding IsTINManual}">
                                    <custom:BorderlessEntry
                                        Placeholder="{x:Static ResourceManager:AppResources.EnterTin}"
                                        HorizontalOptions="StartAndExpand"
                                        WidthRequest="200"
                                        MaxLength="10"
                                        Text="{Binding TinNumber}" TextColor="{StaticResource NeutralBlack}"
                                        FontFamily="{StaticResource SomarRegular}"
                                        />
                                </border:SfBorder>
                                
                                <!--<custom:CustomLabel Grid.Row="2" Grid.Column="0"
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                    FontSize="14">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <custom:CustomLabel Grid.Row="2" Grid.Column="1" Text="{Binding SelectedIDType}" Margin="8,0,0,0"   Style="{StaticResource CardLabelBlack}" />-->

                                
                                

                                <!--<buttons:SfButton Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="8"
                                              BackgroundColor="{Binding ContinueBtnBackgroundColor}"
                                              Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding ContinueBtnTapped}" />-->

                                <custom:CustomLabel Grid.Row="4" Grid.Column="0"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource CaptionLabelGrey}"
                                        FontSize="14">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FieldText}"  />
                                                <Span  Text="" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <custom:CustomLabel Grid.Row="4" Grid.Column="1" Text="{Binding FieldValue}" Margin="8,0,0,0"   Style="{StaticResource CardLabelBlack}" />
                            </Grid>

                            
                        </border:SfBorder>
                        <buttons:SfButton Margin="8"
                                              IsVisible="{Binding ShowContinue2}"
                                              Text="{x:Static ResourceManager:AppResources.VRContinue}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding ContinueBtnTapped2}"
                                          />
                                                    
                        
                    </StackLayout>

                    <StackLayout Orientation="Vertical" Margin="10,0,10,0" Grid.Row="1" VerticalOptions="StartAndExpand" IsVisible="{Binding OtpSection1}" >

                        <StackLayout Orientation="Vertical" >
                            <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ToThisMobNumber}" Margin="8,0,0,0"   Style="{StaticResource CardLabelBlack}" />-->

                            <StackLayout Orientation="Vertical" >

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.NewMobileNumber}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <border:SfBorder Padding="4" Style="{d:StaticResource GreyBorderFrame}">
                                         <StackLayout FlowDirection="LeftToRight" Orientation="Horizontal" VerticalOptions="CenterAndExpand" Spacing="0">
                                        <Image HorizontalOptions="Start" Source="arrowDropdown.png" >
                                            <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="CountryCodeTapped"/>
                                        </Image.GestureRecognizers>   
                                                                       
                                        </Image>
                                        <custom:CustomButton HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource PrimaryColor}" 
                                            Text="{Binding TxtCountryCode}" x:Name="IntnlCodes"
                                            Clicked="CountryCodeTapped"
                                            BackgroundColor="Transparent"/>
                                            <custom:GAZTBorderlessEntry x:Name="EntryMobileNumber" Margin="5,0,0,0"
                                            MaxLength="{Binding MaxDigids}"
                                            Text="{Binding TxtMobileNumber}"
                                            HorizontalOptions="FillAndExpand"
                                            TextChanged="PhoneNumberTextChanged"
                                            Keyboard="Telephone" TextColor="{StaticResource PrimaryColor}"
                                            Style="{StaticResource DefaultEntry}"/>
                                    



                                        </StackLayout>
                             

                                     </border:SfBorder>
                                  
                                 <buttons:SfButton  Margin="0" IsEnabled="{Binding DissableSendOtp}"
                                                    HorizontalOptions="CenterAndExpand"
                                              
                                              Text="{x:Static ResourceManager:AppResources.SendOTP}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding SendOTPBtnCliked}"
                                                    />

                            <StackLayout x:Name="OTP" Orientation="Vertical" Grid.Row="2">

<!-- otp-->
                        <StackLayout Padding="0,15,0,0" IsVisible="{Binding ShowOTPSection}">

                            <StackLayout Padding="0,0,0,0" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0"
                                            ColumnSpacing="20"
                                            Padding="30,20,30,20"
                                            FlowDirection="LeftToRight">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>


                                        <!--First OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                                Grid.Column="0"
                                                ContainerType="Outlined"
                                                UnfocusedColor="#B1B1B1"
                                                OutlineCornerRadius="8"
                                                FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                    x:Name="OTPFirstEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    WidthRequest="8"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{Binding OTPFirstDigit}"
                                                    TextChanged="OtpFirstEntry_TextChanged"
                                                    ReturnType="Next"
                                                    Keyboard="Numeric"
                                                    IsPassword="True"
                                                    MaxLength="1"
                                                    TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
                                                    <local1:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry" />
                                                </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--First OTP Digit End-->

                                        <!--Second OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                                Grid.Column="1"
                                                ContainerType="Outlined"
                                                UnfocusedColor="#B1B1B1"
                                                OutlineCornerRadius="8"
                                                FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                    x:Name="OTPSecondEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    WidthRequest="8"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Text="{Binding OTPSecondDigit}"
                                                    TextChanged="OtpSecondEntry_TextChanged"
                                                    ReturnType="Next"
                                                    IsPassword="True"
                                                    Keyboard="Numeric"
                                                    MaxLength="1"
                                                    TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
                                                    <local1:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry" />
                                                </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--Second OTP Digit End-->

                                        <!--Third OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                                Grid.Column="2"
                                                ContainerType="Outlined"
                                                UnfocusedColor="#B1B1B1"
                                                OutlineCornerRadius="8"
                                                FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                    x:Name="OTPThirdEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    WidthRequest="8"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Text="{Binding OTPThirdDigit}"
                                                    TextChanged="OtpThirdEntry_TextChanged"
                                                    ReturnType="Next"
                                                    IsPassword="True"
                                                    Keyboard="Numeric"
                                                    MaxLength="1"
                                                    TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
                                                    <local1:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry" />
                                                </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--Third OTP Digit End-->

                                        <!--Fourth OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                                Grid.Column="3"
                                                ContainerType="Outlined"
                                                UnfocusedColor="#B1B1B1"
                                                OutlineCornerRadius="8"
                                                FocusedColor="{StaticResource Primary}" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                    x:Name="OTPFourthEntry"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    WidthRequest="8"
                                                    HorizontalTextAlignment="Center"
                                                    IsEnabled="{Binding IsOTPEntryEnable}"
                                                    Text="{Binding OTPFourthDigit}"
                                                    TextChanged="OtpFourthEntry_TextChanged"
                                                    ReturnType="Next"
                                                    Keyboard="Numeric"
                                                    MaxLength="1"
                                                    IsPassword="True"
                                                    TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand"
                                                    Unfocused="OtpFourthEntry_Unfocused">
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--Fourth OTP Digit End-->
                                    </Grid>

                                    <!--<custom:CustomLabel Grid.Row="1" Text="{x:Static ResourceManager:AppResources.AccountLocked}" Style="{StaticResource BodyLabelGrey}"/>-->

                                </Grid>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal"
                                            HorizontalOptions="Center">
                                <Image Source="clock">
                                </Image>
                                <custom:CustomLabel  Text="{Binding LblCountDownTimer}"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        VerticalOptions="Center" />
                            </StackLayout>
                            <buttons:SfButton  Command="{Binding OnResendOTPClicked}"
                                            IsEnabled="{Binding IsResendOTPEnabled}"
                                            Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                            VerticalOptions="EndAndExpand"
                                            Margin="0,8,0,0"
                                            BackgroundColor="Transparent"
                                            TextColor="{Binding ResendOTPTextColor}"/>
                            <buttons:SfButton  Margin="0"
                                HorizontalOptions="CenterAndExpand"
                                
                                Text="{x:Static ResourceManager:AppResources.VerifyOtp}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding VerifyOTPBtnCliked}"
                            />
                        </StackLayout>
<!-- End otp-->

                            <StackLayout IsVisible="{Binding ShowAttachmentSection}">
                                 <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.OTPVerifiedSuccessFully}" 
                                                     Style="{StaticResource CaptionLabelGrey}"
                                                     TextColor="green"
                                                     FontSize="Medium"
                                                     IsVisible="{Binding ShowOTPSuccessMessage}"
                                                     HorizontalOptions="CenterAndExpand"
                                                     VerticalOptions="Center"/>
                            
                                <buttons:SfButton  Margin="0"
                                HorizontalOptions="CenterAndExpand"
                                IsVisible="{Binding ShowPrintFormButton}"
                                Text="{x:Static ResourceManager:AppResources.PrintForm}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PrintFormClicked}"
                            />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.YouMustPrintForm}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" IsVisible="{Binding ShowPrintFormButton}"/>
                                

                                <StackLayout x:Name="Attachments">
                                    <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="EndAndExpand" Padding="0,0" Margin="0,10,0,0">
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span   Text="{Binding AttachmentLable}"/>
                                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}"/>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                        <Image Source="ic_vat_info.png" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </StackLayout>

                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.AttachmentInstruction1}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" />
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.AttachmentInstruction2}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" IsVisible="{Binding ShowPrintFormButton,Converter={StaticResource BoolConverter}}"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.AttachmentInstructionPrintForm}" Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" IsVisible="{Binding ShowPrintFormButton}"/>
                                

                                    <StackLayout Padding="0">
                                        <buttons:SfButton ShowIcon="True" ImageSource="ic_attachment" ImageAlignment="End"
                                            Command="{Binding OnTransferCopyOfCRChoiceButtonClick}"
                                            Style="{StaticResource ButtonBlackBold16}" FontSize="13"
                                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                            BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="14"
                                            TextColor="{StaticResource NeutralGreay}" HorizontalTextAlignment="Start" Padding="5"
                                            Margin="0,5,0,0" IsEnabled="{Binding ActivityDetails.CRCopy}"/>
                                    </StackLayout>
                                    <StackLayout VerticalOptions="Start" Orientation="Vertical" Spacing="5" Margin="0,5,0,0" BindableLayout.ItemsSource="{Binding AttachedForms}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <border:SfBorder BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" Padding="10" CornerRadius="14">
                                                    <Grid HorizontalOptions="Fill" VerticalOptions="Center" ColumnSpacing="0" RowSpacing="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="Generic_attachment_icon.png" HorizontalOptions="Center" VerticalOptions="Center" />
                                                        <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}" Margin="10,0,0,0" Style="{StaticResource BodyLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" />
                                                        <Image Grid.Column="2" Source="close.png"  HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <TapGestureRecognizer CommandParameter="Rentcommand" Tapped="TapRentDeleteGestureRecognizer_Tapped"/>
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                    <Grid ColumnDefinitions="1*,4*,4*,1*" >
                                        <custom1:CheckboxCustom x:Name="CBAcknowledment" Grid.Row="0" Grid.Column="0" VerticalOptions="CenterAndExpand"  IsChecked="{Binding ESTLedge}" Style="{StaticResource CheckboxHeightWidth32}"/>
                                        <custom:CustomLabel Margin="5,0,0,0" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" VerticalOptions="CenterAndExpand" 
                                                            VerticalTextAlignment="Start" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" 
                                                            Style="{DynamicResource IsInstrunctionCheckedStyle}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span     Text="{x:Static ResourceManager:AppResources.Ideclare}"/>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                    </Grid>
                                </StackLayout>

                                <buttons:SfButton
                                    IsEnabled="{Binding ESTLedge}"
                                    Margin="0"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Submit}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SubmitBtnClicked}"
                            />
                            </StackLayout>
                            <StackLayout IsVisible="{Binding ShowSubmitForAutomatic}" >
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.OTPVerifiedSuccessFully}"
                                                     Style="{StaticResource CaptionLabelGrey}"
                                                     TextColor="green"
                                                     FontSize="Medium"
                                                     IsVisible="{Binding ShowOTPSuccessMessage}"
                                                     HorizontalOptions="CenterAndExpand"
                                                     VerticalOptions="Center"/>
                                <Grid ColumnDefinitions="1*,4*,4*,1*" IsVisible="{Binding ShowPrintFormButton}">
                                        <custom1:CheckboxCustom Grid.Row="0" Grid.Column="0" VerticalOptions="CenterAndExpand"  IsChecked="{Binding ESTLedge}" Style="{StaticResource CheckboxHeightWidth32}"/>
                                        <custom:CustomLabel Margin="5,0,0,0" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" VerticalOptions="CenterAndExpand" 
                                                            VerticalTextAlignment="Start" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" 
                                                            Style="{DynamicResource IsInstrunctionCheckedStyle}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span     Text="{x:Static ResourceManager:AppResources.Ideclare}"/>
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                    </Grid>
                                <!--Text="{x:Static ResourceManager:AppResources.Submit}"-->
                                <buttons:SfButton
                                    IsEnabled="{Binding ESTLedge}"
                                    Margin="0"
                                    HorizontalOptions="CenterAndExpand"
                                    Text="{Binding ChangeButtonLabel}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SubmitBtnClicked}"
                            />
                            </StackLayout>
                </StackLayout>   

                                

                            

                            

                                    

                            </StackLayout>
                        </StackLayout>

                    </StackLayout>

                        
                </Grid>

                
               

                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsLoading}">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="StartAndExpand" HorizontalOptions="StartAndExpand">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                               EnableAnimation="True"
                                           AnimationType="SingleCircle"
                                               HorizontalOptions="CenterAndExpand"
                                               VerticalOptions="CenterAndExpand"
                                               IsBusy="True"
                                           ViewBoxWidth = "70" 
                                       
                                           TitlePlacement="Bottom"
                                           ViewBoxHeight="70" 
                                           TextColor="{StaticResource Primary}"/>
                            <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                        </StackLayout>
                    </StackLayout>
            </Grid>

                    </Grid>

                    
                    
                    <buttons:SfButton VerticalOptions="End"
                                              IsVisible="{Binding ShowOtpForm}"
                                              Margin="30,0,30,0"
                                              Text="{x:Static ResourceManager:AppResources.ZZZCancelText}"
                                              Style="{StaticResource PrimaryButtonStyle}"
                                              Command="{Binding CancelBtnTapped}"
                        />
                </StackLayout>



         </ScrollView>
       
        
    </ContentPage.Content>
</ContentPage>

