<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="EGAZT.Views.NewDesign.LoginPages.LoginSelectionView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign">
    <Grid VerticalOptions="FillAndExpand">
        <StackLayout Margin="20">
            <Image
                Margin="0,30,0,10"
                HeightRequest="100"
                HorizontalOptions="CenterAndExpand"
                Source="ZatcaLogoWithTitle"
                VerticalOptions="Start"
                WidthRequest="190" />
            <StackLayout VerticalOptions="FillAndExpand">
                <!--  Login title  -->
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="28"
                    HorizontalOptions="StartAndExpand"
                    Text="{x:Static ResourceManager:AppResources.LogIn}"
                    TextColor="#4FBBBD" />

                <!--  Select Account  title  -->
                <Label
                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="16"
                    HorizontalOptions="StartAndExpand"
                    Text="{x:Static ResourceManager:AppResources.Selectaccounttype}"
                    TextColor="White" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Grid Grid.Column="0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCustomLoginCommand}" />

                        </Grid.GestureRecognizers>
                        <Image
                            HeightRequest="136"
                            Source="UnselectedCard.png"
                            WidthRequest="171" />
                        <Label
                            Margin="25,10,25,15"
                            FontSize="16"
                            Text="{x:Static ResourceManager:AppResources.Customs}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="EndAndExpand" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToZakatLoginCommand}" />

                        </Grid.GestureRecognizers>
                        <Image Source="UnselectedCard.png" />
                        <Label
                            Margin="25,10,25,15"
                            FontSize="16"
                            Text="{x:Static ResourceManager:AppResources.ZakatandTax}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="EndAndExpand" />
                    </Grid>
                </Grid>
                <Label
                    Margin="0,20,0,10"
                    HorizontalOptions="CenterAndExpand"
                    Text="{x:Static ResourceManager:AppResources.ZZZDontHaveAccount}"
                    TextColor="White" />
                <Frame
                    Padding="10"
                    BackgroundColor="#4FBBBD"
                    CornerRadius="15">
                    <Label
                        HorizontalOptions="CenterAndExpand"
                        Text="{x:Static ResourceManager:AppResources.CreateAccount}"
                        TextColor="White" />
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToZakatRegistrationCommand}" />
                    </Frame.GestureRecognizers>
                </Frame>
            </StackLayout>
        </StackLayout>
    </Grid>
</newdesign:BaseContentPage>
