<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:control="clr-namespace:GAZT"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png"
             FlowDirection="LeftToRight"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:ResourceManager="clr-namespace:EGAZT" xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             x:Class="EGAZT.Views.NewDesign.VATLookUp.VATLookUpNewPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        
        </ResourceDictionary>
    </ContentPage.Resources>
     <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="0,5,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.MyBills}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>
                        <Label Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer      Command="{TemplateBinding BindingContext.OnBackButtonClicked}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="10*" />
                                <RowDefinition Height="90*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="1" BackgroundColor="White"/>
                        <Grid Grid.Row="0" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="1" Source="ic_logo_gazt.png" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" HorizontalOptions="Center"/>

                        <Label Grid.Column="0" x:Name="Image_backArrow" Grid.Row="0" Margin="10,0,10,0" HorizontalOptions="Start" VerticalOptions="Center"   Style="{StaticResource IconLabelStyle}" Text="{StaticResource Back}" Rotation="270"/>

                        <Image Grid.Column="2" IsVisible="False">
                            <Image.Source>
                                <FontImageSource Color="White" FontFamily="UserIconFont" Glyph="{x:Static FontImage:IconFonts.Close}"/>
                            </Image.Source>
                        </Image>
                    </Grid>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0">
                <ScrollView>
                    <StackLayout Padding="10">
                        <control:CustomLabel Text="{x:Static ResourceManager:AppResources.ForgotPasswordORUseName}" Style="{StaticResource SectionTitleBlack}" />
                        <control:CustomLabel Text="{x:Static ResourceManager:AppResources.NDSelectTheOptionAndCompleteDetails}" Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>
                        <Grid>
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>

                        <control:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.IDNumber}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>

                         <inputLayout:SfTextInputLayout Grid.Row="1"  Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <control:BorderlessEntry  Text="{Binding TxtSearchParameter}" Placeholder="{x:Static ResourceManager:AppResources.TINS}" TextColor="#bbbbbb" >
                                            </control:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <control:CustomButton x:Name="PPicker_btn"
                                                              Grid.Row="1"
                                                              FontSize="Small"
                                                              BackgroundColor="Transparent"
                                                              Clicked="PPicker_btn_Clicked"/>

                                        <syncfusion:SfPicker
                                            x:Name="PPicker"
                                            Grid.Row="1" 
                                            HeaderHeight="55"
                                            ShowHeader="False"             
                                            HeaderTextColor="White"
                                            ShowColumnHeader="False"
                                            ColumnHeaderHeight="46"
                                            PickerMode="Dialog"
                                            HeaderBackgroundColor="#006450"
                  
                                            BorderColor="Black"
                                            BackgroundColor="#EAF7CC"
                                            UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                            SelectedItemFontSize="15"
                                            
                                            ItemHeight="40"
                                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                                            DisplayMemberPath="ParameterType"
                                            ItemsSource="{Binding ParameterTypeList}"
                                            Grid.Column="0" 
                                            PickerHeight="250"
                                            PickerWidth="300"
                                            HeaderFontSize="14"
                                            OKButtonTextColor="#006450"
                                            CancelButtonTextColor="#006450"
                                            ShowFooter="False"
                                            SelectionChanged="PPicker_SelectionChanged"
                                            OKButtonBackgroundColor="#EAF7CC"
                                            CancelButtonBackgroundColor="#EAF7CC"
                                            FooterHeight="46">
                                            <syncfusion:SfPicker.Behaviors>
                                                <custom1:SfPickerBehavior />
                                            </syncfusion:SfPicker.Behaviors>
                                        </syncfusion:SfPicker>

                             <StackLayout Grid.Row="2">
                                        <control:CustomLabel  Text="{x:Static ResourceManager:AppResources.IDNumber}" Padding="0,0,0,0" Style="{StaticResource CaptionLabelGrey}"/>
                                        <inputLayout:SfTextInputLayout x:Name="frmLookupNumner" Margin="0,-6,0,-6" 
										ContainerType="Outlined" UnfocusedColor="#B1B1B1"
										OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <control:BorderlessEntry Text="{Binding LookupNumber}" MaxLength="{Binding MaxDigids}" Placeholder="{x:Static ResourceManager:AppResources.NDTypeyourIDNumber}" TextColor="#bbbbbb" >
                                            </control:BorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView >
                                                <Label HorizontalOptions="End" IsEnabled="{Binding IsTooltipEnableVisible}"
                                                           IsVisible="{Binding IsTooltipEnableVisible}"
                                        Margin="0,0,0,4" FontSize="Title"   VerticalOptions="Center"
                                       Style="{StaticResource IconLabelStyle}"
                                         TextColor="#005e4b"
                                        Text="{StaticResource Help}"  >
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>

                            <border:SfBorder Grid.Row="3"  Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                                    <Label Text="TIN Number" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <Label x:Name="lbResult" Text="{Binding Name}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>

                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                     </Grid>
                    </StackLayout>
                     
                </ScrollView>

            </StackLayout>
            <StackLayout Grid.Row="1" HorizontalOptions="Center" Padding="10,5,10,10" >
                <buttons:SfButton x:Name="btnprimary" Text="Primary" Clicked="btnSubmit_Clicked"  Style="{StaticResource PrimaryButtonStyle}"/>
            </StackLayout>
        </Grid>
