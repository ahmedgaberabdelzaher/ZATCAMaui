    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">
             <yummy:PancakeView IsVisible="{Binding IsMainView}"
            Grid.Row="1" VerticalOptions="FillAndExpand"
            Margin="0"
            Padding="0" 
            Style="{StaticResource CommonTopCurves}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <StackLayout Padding="10">
                        <control:CustomLabel LineSpacing=".8" Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}"
                                             Style="{StaticResource SectionTitleBlack}" />
                        <control:CustomLabel Text="{x:Static ResourceManager:AppResources.ZVATLookUpTitleSub}"
                                             Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView BackgroundColor="{StaticResource NeutralGreay}"
                                 HeightRequest="1"/>
                        <Grid>
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                             <RowDefinition Height="auto" />
                         </Grid.RowDefinitions>

                        <control:CustomLabel Grid.Row="0"
                                             Text="{x:Static ResourceManager:AppResources.ZSearchParameter}"
                                             Padding="0,0,0,0"
                                             Style="{StaticResource CaptionLabelGrey}"/>

                        <inputLayout:SfTextInputLayout Grid.Row="1"
                                                        Margin="0,-6,0,-6" 
										                ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1"
										                OutlineCornerRadius="8"
                                                        FocusedColor="{StaticResource Primary}"
                                                       
                                                        ErrorColor="#B00020"
                                                        HasError="False">
                                            <control:BorderlessEntry  Text="{Binding TxtSearchParameter}"
                                                                     Style="{StaticResource DefaultEntry}"   
                                                                      TextColor="{StaticResource Primary}" >
                                            </control:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <control:CustomButton x:Name="PPicker_btn"
                                                              Grid.Row="1"
                                                              FontSize="Small"
                                                              BackgroundColor="Transparent"
                                                              Clicked="PPicker_btn_Clicked"/>

                                        <syncfusion:SfPicker
                                            x:Name="PPicker"
                                            Grid.Row="1" 
                                            HeaderHeight="55"
                                            ShowHeader="False"             
                                            HeaderTextColor="White"
                                            ShowColumnHeader="False"
                                            ColumnHeaderHeight="46"
                                            PickerMode="Dialog"
                                            
                                            HeaderBackgroundColor="{StaticResource Primary}"              
                                            BorderColor="Black"
                                            BackgroundColor="white"
                                            UnSelectedItemTextColor="{StaticResource NeutralGreay}"
                                            SelectedItemFontAttribute="Bold"
                                            SelectedItemFontSize="15"
                                            ItemHeight="40"
                                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                                            DisplayMemberPath="ParameterType"
                                            ItemsSource="{Binding ParameterTypeList}"
                                            Grid.Column="0" 
                                            PickerHeight="250"
                                            PickerWidth="300"
                                            HeaderFontSize="13"
                                            OKButtonTextColor="{StaticResource Primary}"
                                            CancelButtonTextColor="{StaticResource Primary}"
                                            ShowFooter="False"
                                            SelectionChanged="PPicker_SelectionChanged"
                                            OKButtonBackgroundColor="#EAF7CC"
                                            CancelButtonBackgroundColor="#EAF7CC"
                                            FooterHeight="46">
                                            <syncfusion:SfPicker.Behaviors>
                                                <custom1:SfPickerBehavior />
                                            </syncfusion:SfPicker.Behaviors>
                                        </syncfusion:SfPicker>

                             <StackLayout Grid.Row="2">
                                <control:CustomLabel  Text="{Binding SelectedParameterType.ParameterType}"
                                                            Padding="0,0,0,0"
                                                            Style="{StaticResource CaptionLabelGrey}"/>
                                    <inputLayout:SfTextInputLayout x:Name="frmLookupNumner"
                                                                    Margin="0,-6,0,-6" 
										                            ContainerType="Outlined"
                                                                    UnfocusedColor="#B1B1B1"
										                            OutlineCornerRadius="8"
                                                                    FocusedColor="{StaticResource Primary}"
                                                                    ErrorColor="#B00020"
                                                                    HasError="False">
                                        <control:BorderlessEntry Text="{Binding LookupNumber}"
                                                                    MaxLength="{Binding MaxDigids}"
                                                                     Style="{StaticResource DefaultEntry}"  
                                                                    Placeholder="{Binding SelectedParameterType.ParameterType}"
                                                                    TextColor="{StaticResource Primary}" >
                                        <!--IsReadOnly="{Binding IsNameVisible}"                                                                   TextChanged="BorderlessEntry_TextChanged"
-->
                                        <Entry.Behaviors>
                                                <custom1:OnlyNumericValuesBehaviour/>
                                            </Entry.Behaviors>
                                        </control:BorderlessEntry>
                                        <inputLayout:SfTextInputLayout.TrailingView >
                                            <Label HorizontalOptions="End"
                                                    IsEnabled="{Binding IsTooltipEnableVisible}"
                                                    IsVisible="{Binding IsTooltipEnableVisible}"
                                                    Margin="0,0,0,4"
                                                    FontSize="Title"
                                                    VerticalOptions="Center"
                                                    Style="{StaticResource IconLabelStyle}"
                                                    TextColor="{StaticResource SecondaryNew}"
                                                    Text="{StaticResource Help}"  >
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>

                            <border:SfBorder Grid.Row="3"
                                             Margin="0,10,0,10"
                                             IsVisible="{Binding IsNameVisible}"
                                             Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Orientation="Horizontal"
                                             IsVisible="{Binding IsNameVisible}"
                                             Padding="15,10,15,10">
                                    <Label Text="{x:Static ResourceManager:AppResources.ZZTaxPayerName}" Style="{StaticResource ValueLabelGrey}"
                                           HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="StartAndExpand"
                                                 Orientation="Horizontal" >
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource ValueLabelBlack}"
                                               HorizontalOptions="Start"/>

                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                     </Grid>
                    </StackLayout>
                     
                </ScrollView>

            </StackLayout>
            <StackLayout Grid.Row="1"
                         HorizontalOptions="Center"
                         Padding="10,5,10,30"
                         BackgroundColor="White">
                <buttons:SfButton x:Name="btnScan"
                                  Text="{x:Static ResourceManager:AppResources.ZQRScanner}"
                                  Style="{StaticResource PrimaryButtonStyle}"/>
                <buttons:SfButton x:Name="btnSearch"
                                  Text="{Binding LookUpButtonText}"
                                  Command="{Binding OnSearchButtonClicked}"
                                  Style="{StaticResource PrimaryButtonStyle}"/>

            </StackLayout>
            <!--<StackLayout Grid.Row="2"
                         HorizontalOptions="Center"
                         Padding="10,5,10,20" >
                <buttons:SfButton x:Name="btnSearch"
                                  Text="{Binding LookUpButtonText}"
                                  Command="{Binding OnSearchButtonClicked}"
                                  Style="{StaticResource PrimaryButtonStyle}"/>
            </StackLayout>-->

            <!--Loading layout-->
         

                   


           
        </Grid>
                </yummy:PancakeView>
                      <!--#region Scan View-->
        <yummy:PancakeView
            Grid.Row="1" 
            Margin="0"
            Padding="0" 
            IsVisible="{Binding IsShowScanView}"
            Style="{StaticResource CommonTopCurves}">
            <Grid Padding="0,0,0,0" RowDefinitions="1.2*,*,*,*,*">
                <Grid
                    x:Name="MainGrid"
                    Grid.RowSpan="5"
                    Margin="0,0,0,0" />
                <!-- <zxing:ZXingScannerView  x:Name="zxing"  Margin="0,0,0,0" Grid.RowSpan="5" IsAnalyzing="True" IsScanning="True"
                     BackgroundColor="White">
                                </zxing:ZXingScannerView>-->
                <Grid Grid.Row="0"  HorizontalOptions="FillAndExpand">
                    <Frame BackgroundColor="Black" Opacity=".44" />

                    <StackLayout Margin="0,30,0,30">

                        <Label
                            FontFamily="{StaticResource FontSomarBold}"
                            FontSize="22"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ScantheQRcode}"
                            TextColor="White" />
                        <!--<Label
                            Margin="0,0,0,30"
                            FontSize="14"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.PlacetheQRCodeinsidetheframe}"
                            TextColor="White" />-->
                        <BoxView HeightRequest="30"></BoxView>
                    </StackLayout>
                </Grid>

                <Grid 
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    Margin="2,0,2,-7"
                    FlowDirection="RightToLeft">
                    <Path
                        Margin="-3,-7,-3,0"
                        Data="M 0,0 L 36,0 36,36Z"
                        Fill="Black"
                        HorizontalOptions="End"
                        Opacity=".45"
                        Rotation="-90"
                        Stroke="transparent"
                        VerticalOptions="Start" />
                    <Image
                        Margin="-5,-15,-5,0"
                        HeightRequest="90"
                        HorizontalOptions="StartAndExpand"
                        Rotation="-90"
                        Source="Path"
                        VerticalOptions="Start" />
                    <Path
                        Margin="-7,-6,-15,0"
                        Data="M 0,0 L 30,0 30,30Z"
                        Fill="Black"
                        HorizontalOptions="Start"
                        Opacity=".45"
                        VerticalOptions="Start" />
                    <Image
                        Margin="-3,-15,-5,0"
                        HeightRequest="90"
                        HorizontalOptions="End"
                        Rotation="-180"
                        Source="Path"
                        VerticalOptions="Start" />

                    <Path
                        Margin="-3,0,-3,-.2"
                        Data="M 0,0 L 45,0 45,45"
                        Fill="Black"
                        HorizontalOptions="Start"
                        Opacity=".45"
                        Rotation="90"
                        Stroke="transparent"
                        VerticalOptions="End" />
                    <Image
                        Margin="-3,0,-3,0"
                        HeightRequest="90"
                        HorizontalOptions="StartAndExpand"
                        Source="Path"
                        VerticalOptions="End" />
                    <Path
                        Margin="-3,0,-3,0"
                        Data="M 0,0 L 45,0 45,45"
                        Fill="Black"
                        HorizontalOptions="End"
                        Opacity=".45"
                        Rotation="180"
                        Stroke="transparent"
                        VerticalOptions="End" />
                    <Image
                        Margin="-3,0,-3,0"
                        HeightRequest="90"
                        HorizontalOptions="End"
                        Rotation="90"
                        Source="Path"
                        VerticalOptions="End" />

                </Grid>


                <Grid Grid.Row="4" HorizontalOptions="FillAndExpand">
                    <Frame BackgroundColor="Black" Opacity=".44" />
                    <StackLayout>
                        <Label
                            Grid.Row="3"
                            Margin="0,40,27,0"
                            HorizontalOptions="CenterAndExpand"
                            TextColor="White">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontFamily="{StaticResource FontSomarBold}" FontSize="24" />
                                    <Span FontSize="16" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Frame
                            Grid.Row="4"
                            Margin="21,27,27,40"
                            Padding="12"
                            BackgroundColor="Transparent"
                            CornerRadius="14"
                            HasShadow="False">

                            <Label
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                TextColor="White" />
                        </Frame>
                    </StackLayout>
                </Grid>
            </Grid>
        </yummy:PancakeView>

        <!--#endregion-->
             <!--#region Success Result View-->

              <yummy:PancakeView 
            Margin="0" Grid.Row="1"
            Padding="20"
            IsVisible="{Binding IsShowRsltView}"
            Style="{StaticResource CommonTopCurves}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollView
                    Grid.Row="0"
                    Padding="0,0,0,32"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout Padding="0,12,0,0">
                        <Image
                            Margin="0,10,0,10"
                            HeightRequest="70"
                            HorizontalOptions="CenterAndExpand"
                            Source="SuccessQr"
                            WidthRequest="70" >
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding IsVatLookUp}"
                                                 Value="false">
                                        <Setter Property="Source" Value="failQR.png"/>
                                    </DataTrigger>
                                     <DataTrigger TargetType="Image"
                                                 Binding="{Binding IsVatLookUp}"
                                                 Value="true">
                                        <Setter Property="Source" Value="SuccessQr.png"/>
                                    </DataTrigger>
                                </Image.Triggers>

                            </Image>
                        <Label
                            FontFamily="{StaticResource FontSomarBold}"
                            FontSize="24"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.RegisteredVAT}"
                            TextColor="{StaticResource PrimaryColor}" >
                                 <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsVatLookUp}"
                                                 Value="false">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.UnregisteredFacility}"/>
                                    </DataTrigger>
                                     <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsVatLookUp}"
                                                 Value="true">
                                        <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.RegisteredVAT}"/>
                                    </DataTrigger>
                                </Label.Triggers>


                            </Label>
                        <Frame
                            Margin="0"
                            Padding="0"
                            BorderColor="LightGray"
                            CornerRadius="8"
                            HasShadow="False">
                            <StackLayout Margin="16">
                                <Grid Padding="8,0" ColumnDefinitions="1.25*,*">
                                    <Label
                                        Grid.Row="0"
                                        FontFamily="{StaticResource FontSomarBold}"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{Binding Name}"
                                        TextColor="{StaticResource PrimaryColor}" />
                                    <Grid Grid.Column="1" RowDefinitions="auto">
                                        <Frame
                                            Padding="0" BackgroundColor="#62B34F"
                                            CornerRadius="14" Opacity=".1" 
                                            HasShadow="False"
                                            VerticalOptions="FillAndExpand" >
                                            <Frame.Triggers>
                                                <DataTrigger TargetType="Frame"
                                                             Binding="{Binding IsVatLookUp}"
                                                             Value="false">
                                                    <Setter Property="BackgroundColor" Value="#E84A41"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Frame"
                                                             Binding="{Binding IsVatLookUp}"
                                                             Value="true">
                                                    <Setter Property="BackgroundColor" Value="#62B34F"/>
                                                </DataTrigger>
                                            </Frame.Triggers>

                                            </Frame>
                                        <Label
                                            Margin="10,3,10,3"
                                            HorizontalOptions="CenterAndExpand"
                                            Text="{x:Static ResourceManager:AppResources.Correct}"
                                            TextColor="#62B34F"
                                            VerticalOptions="CenterAndExpand" >
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsVatLookUp}"
                                                             Value="false">
                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Incorrect}"/>
                                                    <Setter Property="TextColor" Value="#E84A41"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsVatLookUp}"
                                                             Value="true">
                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Correct}"/>
                                                    <Setter Property="TextColor" Value="#62B34F"/>
                                                </DataTrigger>
                                            </Label.Triggers>

                                            </Label>

                                    </Grid>
                                </Grid>
                                <BoxView Style="{StaticResource lineSeperator}" />
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    RowDefinitions="auto,auto">
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.VATRegistrationNumber}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0" FontSize="14"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding VatNumber}" />
                                    <Label
                                        Grid.Row="0" HorizontalOptions="EndAndExpand"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.TIN}" />
                                    <Label  HorizontalOptions="EndAndExpand"
                                        Grid.Row="1" FontSize="14"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding TIN}" />
                                       


                                    </Grid>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.VATCertificateNumber}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{Binding VATCertificateNumber}" />

                                    <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.NDTaxEvasionRegion}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="{Binding Region}" />
                                   
                                </StackLayout>
                        </Frame>

                    </StackLayout>
                </ScrollView>




            </Grid>
        </yummy:PancakeView>
                  
        <!--#endregion-->
                        <Grid Grid.Row="1"  Grid.Column="0"  IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                         TextColor="{StaticResource Secondary}"/>
                        <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                    </StackLayout>
                </StackLayout>
            </Grid>

                   <controls:Header
            Grid.Row="0"
            Padding="0,35,0,10"
            TitleText="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}" >
               <controls:Header.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="iOS" Value="0,10,0,10" />
                        <On Platform="Android" Value="0,10,0,10" />
                    </OnPlatform>
                </controls:Header.Padding>

        </controls:Header>
        </Grid>
    </ContentPage.Content>
</ContentPage>
