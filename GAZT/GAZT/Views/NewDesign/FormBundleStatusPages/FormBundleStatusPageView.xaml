<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.FormBundleStatusPages.FormBundleStatusPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <!--<ScrollView> -->
                <StackLayout>
                    <!--  Start Of Type  -->
                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" />
                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>
                    <Grid>
                        <inputLayout:SfTextInputLayout
                            x:Name="txtBundleType"
                            Margin="0,6,0,6"
                            ContainerType="Outlined"
                            ErrorColor="#B00020"
                            FocusedColor="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="8"
                            Style="{StaticResource TextInputLayout}"
                            UnfocusedColor="#B1B1B1">
                            <control:BorderlessEntry
                                IsReadOnly="True"
                                Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding TxtFBtype}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalTextAlignment="Center" />
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Source="arrowDropdown.png" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>
                        <Button BackgroundColor="Transparent" Clicked="OnBundleTypeClicked" />
                        <syncfusion:SfPicker
                            x:Name="BundleType"
                            Margin="10,0,10,0"
                            BackgroundColor="White"
                            BorderColor="Black"
                            CancelButtonBackgroundColor="#EAF7CC"
                            CancelButtonTextColor="{StaticResource Primary}"
                            Closed="BundleType_Closed"
                            ColumnHeaderHeight="46"
                            DisplayMemberPath="Txt50"
                            FlowDirection="RightToLeft"
                            FooterHeight="46"
                            HeaderBackgroundColor="{StaticResource Primary}"
                            HeaderFontSize="13"
                            HeaderHeight="55"
                            HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                            HeaderTextColor="White"
                            ItemHeight="40"
                            ItemsSource="{Binding FormBundleList}"
                            OKButtonBackgroundColor="#EAF7CC"
                            OKButtonTextColor="{StaticResource Primary}"
                            OkButtonClicked="BundleType_OkButtonClicked"
                            PickerHeight="250"
                            PickerMode="Dialog"
                            PickerWidth="300"
                            SelectedIndex="{Binding IDTypeIndex}"
                            SelectedItemFontAttribute="Bold"
                            SelectedItemFontSize="15"
                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                            SelectionChanged="BundleType_SelectionChanged"
                            ShowColumnHeader="False"
                            ShowFooter="False"
                            ShowHeader="False"
                            UnSelectedItemTextColor="{StaticResource NeutralBlack}">
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                    </Grid>
                    <!--  End Of Type  -->

                    <custom:CustomLabel Margin="0,16,0,0" Style="{StaticResource CaptionLabelGrey}">
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}" />
                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>

                    <Grid>
                        <inputLayout:SfTextInputLayout
                            x:Name="txtBundleNumber"
                            Margin="0,6,0,6"
                            ContainerType="Outlined"
                            ErrorColor="#B00020"
                            FocusedColor="{StaticResource Primary}"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="8"
                            Style="{StaticResource TextInputLayout}"
                            UnfocusedColor="#B1B1B1">
                            <control:BorderlessEntry
                                IsReadOnly="True"
                                Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding TxtFBnum}"
                                TextColor="{StaticResource NeutralBlack}"
                                VerticalTextAlignment="Center" />
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Source="arrowDropdown.png" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>
                        <Button BackgroundColor="Transparent" Clicked="OnBundleNumberClicked" />
                        <syncfusion:SfPicker
                            x:Name="BundleNumber"
                            Margin="10,0,10,0"
                            BackgroundColor="White"
                            BorderColor="Black"
                            CancelButtonBackgroundColor="#EAF7CC"
                            CancelButtonTextColor="{StaticResource Primary}"
                            ColumnHeaderHeight="46"
                            DisplayMemberPath="Fbnum"
                            FlowDirection="RightToLeft"
                            FooterHeight="46"
                            HeaderBackgroundColor="{StaticResource Primary}"
                            HeaderFontSize="13"
                            HeaderHeight="55"
                            HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}"
                            HeaderTextColor="White"
                            ItemHeight="40"
                            ItemsSource="{Binding FormBundleApplicatioNumberList}"
                            OKButtonBackgroundColor="#EAF7CC"
                            OKButtonTextColor="{StaticResource Primary}"
                            OkButtonClicked="BundleNumber_OkButtonClicked"
                            PickerHeight="250"
                            PickerMode="Dialog"
                            PickerWidth="300"
                            SelectedIndex="{Binding IDTypeIndex}"
                            SelectedItemFontAttribute="Bold"
                            SelectedItemFontSize="15"
                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                            SelectionChanged="BundleNumber_SelectionChanged"
                            ShowColumnHeader="False"
                            ShowFooter="False"
                            ShowHeader="False"
                            UnSelectedItemTextColor="{StaticResource NeutralBlack}">
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                    </Grid>

                    <ListView
                        Margin="0,10,0,10"
                        BackgroundColor="White"
                        HasUnevenRows="True"
                        HorizontalOptions="FillAndExpand"
                        ItemTapped="ListView_ItemTapped"
                        ItemsSource="{Binding ListFormBudles}"
                        SeparatorVisibility="None"
                        VerticalOptions="Start">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <StackLayout Padding="10">
                                            <StackLayout Orientation="Horizontal">
                                                <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZStatus}" />
                                                <custom:CustomLabel
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding FbStatus}" />
                                            </StackLayout>
                                            <StackLayout Orientation="Horizontal">
                                                <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZDescriptionForFormBundle}" Style="{StaticResource ValueLabelGrey}"/>
                                    <custom:CustomLabel Text="{Binding FbDesc}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>-->
                                            </StackLayout>
                                        </StackLayout>
                                    </border:SfBorder>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
                <!--</ScrollView> -->
            </yummy:PancakeView>


            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*" />
                    <ColumnDefinition Width="70*" />
                    <ColumnDefinition Width="15*" />
                </Grid.ColumnDefinitions>

                <custom:CustomLabel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.ZZFormBundleStatus}"
                    TextColor="White" />

                <Image
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackStepButtonVisible}"
                    Source="arrowLeftwhite"
                    Style="{DynamicResource BackButtonArrow}"
                    VerticalOptions="CenterAndExpand">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>