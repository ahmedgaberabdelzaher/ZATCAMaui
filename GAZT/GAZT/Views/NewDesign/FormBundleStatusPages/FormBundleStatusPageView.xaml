<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             mc:Ignorable="d"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.FormBundleStatusPages.FormBundleStatusPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">
                <ScrollView>
                <StackLayout>
                    <!--Start Of Type-->
                    <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"/>
                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>
                    <Grid>
                        <inputLayout:SfTextInputLayout x:Name="txtBundleType" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry Style="{StaticResource InputTableEntryLayoutStyle}" Text="{Binding TxtFBtype}" Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" VerticalTextAlignment="End" IsReadOnly="True"   TextColor="{StaticResource NeutralBlack}">
                            </control:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Source="arrowDropdown.png"/>
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>
                        <Button Clicked="OnBundleTypeClicked" BackgroundColor="Transparent"/>
                        <syncfusion:SfPicker x:Name="BundleType"
                                                         HeaderHeight="55"
                                                         HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
                                                         HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46" 
                                                         PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" 
                                                         BackgroundColor="White" SelectedItemFontSize="15"
                                                         ShowFooter="False" ItemHeight="40" 
                                                         DisplayMemberPath="Txt50" Margin="10,0,10,0" PickerHeight="250" 
                                                         SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" 
                                                         UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                                         PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                                                         FooterHeight="46" SelectionChanged="BundleType_SelectionChanged" 
                                                         ItemsSource="{Binding FormBundleList}"                                             
SelectedIndex="{Binding IDTypeIndex}"  OkButtonClicked="BundleType_OkButtonClicked" Closed="BundleType_Closed">
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                    </Grid>
                    <!--End Of Type-->

                    <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                        <custom:CustomLabel.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}"/>
                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                            </FormattedString>
                        </custom:CustomLabel.FormattedText>
                    </custom:CustomLabel>
                    <Grid>
                        <inputLayout:SfTextInputLayout x:Name="txtBundleNumber" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry Style="{StaticResource InputTableEntryLayoutStyle}" Text="{Binding TxtFBnum}" Placeholder="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}" VerticalTextAlignment="End" IsReadOnly="True"   TextColor="{StaticResource NeutralBlack}">
                            </control:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Source="arrowDropdown.png"/>
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>
                        <Button Clicked="OnBundleNumberClicked" BackgroundColor="Transparent"/>
                        <syncfusion:SfPicker x:Name="BundleNumber"
                                                         HeaderHeight="55"
                                                         HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleNumber}"
                                                         HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46" 
                                                         PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" 
                                                         BackgroundColor="White" SelectedItemFontSize="15"
                                                         ShowFooter="False" ItemHeight="40" 
                                                         DisplayMemberPath="Fbnum" Margin="10,0,10,0" PickerHeight="250" 
                                                         SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" 
                                                         UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                                         PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                                                         FooterHeight="46" SelectionChanged="BundleNumber_SelectionChanged" 
                                                         ItemsSource="{Binding FormBundleApplicatioNumberList}" SelectedIndex="{Binding IDTypeIndex}"  OkButtonClicked="BundleNumber_OkButtonClicked">
                            <syncfusion:SfPicker.Behaviors>
                                <customcontrol:SfPickerBehavior />
                            </syncfusion:SfPicker.Behaviors>
                        </syncfusion:SfPicker>
                    </Grid>

                        <ListView ItemsSource="{Binding ListFormBudles}"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="Start"
                                    HasUnevenRows="True"
                                    BackgroundColor="White"
                            ItemTapped="ListView_ItemTapped" SeparatorVisibility="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                        <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="10">
                                <StackLayout Orientation="Horizontal">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZStatus}" Style="{StaticResource ValueLabelGrey}"/>
                                    <custom:CustomLabel Text="{Binding FbStatus}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                </StackLayout>
                                <StackLayout Orientation="Horizontal">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZDescriptionForFormBundle}" Style="{StaticResource ValueLabelGrey}"/>
                                    <custom:CustomLabel Text="{Binding FbDesc}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>
                        </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackLayout>
                </ScrollView>
            </yummy:PancakeView>
            
            
            <Grid Grid.Row="0" Padding="15,5,15,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="70*"/>
                    <ColumnDefinition Width="15*"/>
                </Grid.ColumnDefinitions>

                <custom:CustomLabel Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ZZFormBundleStatus}" TextColor="White" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                <Image Grid.Row="0" Grid.Column="0"   IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackButtonClicked}"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}" Margin="0,-20,0,0">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#D99A29"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>