<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ZakatInstalmentPlan.OldZakatInstalmentPlanPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local1="clr-namespace:EGAZT.CustomControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">



    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CommaSeparatorConverter x:Key="commaSeparatorConverter" />

            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />

                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>



        </ResourceDictionary>



    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Grid.Row="0" Padding="24,10,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontFamily="{StaticResource GAZT_FONT_BOLD}"
                            FontSize="Large"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="24"
                            HorizontalOptions="StartAndExpand"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand"
                            WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>



    <ContentPage.Content>

        <Grid>
            <ScrollView
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand"
                VerticalScrollBarVisibility="Never">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                    <!--  Display Instalments  -->


                    <!--  Data Entry/calculations screen  -->

                    <StackLayout
                        Margin="5,10,5,10"
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding InstalmentPlanAgreementsVisible}"
                        Orientation="Vertical"
                        VerticalOptions="FillAndExpand">
                        <!--
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        -->
                        <Grid
                            Grid.Row="0"
                            Grid.ColumnSpan="3"
                            HorizontalOptions="EndAndExpand">
                            <commonView:PageIndicatorView
                                Margin="20,25,0,0"
                                Completed="{Binding MarkComplete}"
                                DotSize="12"
                                HorizontalOptions="End"
                                MaxNum="{Binding MaxIndex}"
                                MinNum="{Binding CurrentIndex}"
                                VerticalOptions="CenterAndExpand" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource PageTitleBlack}"
                                Text="{x:Static ResourceManager:AppResources.ZakatOldFinancialDetails}" />
                            <custom:CustomLabel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,-10,0,15"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource BodyLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}" />
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource ValueLabelBlack}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTaxpayerHoldingFinancialStatement}" />
                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <border:SfBorder
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                Padding="10"
                                Style="{StaticResource GreyBorderFrame}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource BodyLabelBlack}"
                                        Text="{Binding PickedFinancialStatement}" />


                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="UserIconFont"
                                                Glyph="{x:Static FontImage:IconFonts.ChevronDown}"
                                                Size="28"
                                                Color="{StaticResource Secondary}" />
                                        </Image.Source>
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowFinancialStatementPicker}" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                </Grid>
                            </border:SfBorder>

                        </Grid>

                        <Grid
                            Grid.Row="3"
                            Margin="0,10,0,10"
                            HorizontalOptions="FillAndExpand"
                            IsEnabled="{Binding IsFinsancialStatementsEditable}"
                            VerticalOptions="FillAndExpand">
                            <cards:SfCardView
                                Padding="10"
                                CornerRadius="20"
                                HasShadow="False"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,10"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        VerticalOptions="FillAndExpand">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZakatYearOne}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                    <!--  ZakatYear  -->
                                    <StackLayout
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="EndAndExpand">
                                        <border:SfBorder
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEntry
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                MaxLength="4"
                                                Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}"
                                                PlaceholderColor="Gray"
                                                Text="{Binding Year1}"
                                                TextChanged="Year1Change_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--  ZakatCashBank  -->
                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="2. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatCashBank}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="CashBankText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding CashBankY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>



                                    <!--  ZakatShortTermInvestment  -->

                                    <StackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="3. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="ShortTermInvestmentText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding StiY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>


                                    <!--  ZakatDebitors  -->

                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="4. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatDebitors}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="DebitorsText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding DebitorsY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>

                                    </StackLayout>

                                    <!--  ZakatInventory  -->
                                    <StackLayout
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="5. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatInventory}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="InventoryText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding InventoryY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>
                                    <!--  ZakatInstalmentTotalCurrentAssets  -->
                                    <StackLayout
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="6. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentAssets}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="TcAssetsText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding TcAssetsY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--  ZakatInstalmentZakatAndTax  -->

                                    <StackLayout
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="7. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatInstalmentZakatAndTax}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="ZakatText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding ZakatY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--  ZakatInstalmentTotalCurrentLiabilities  -->

                                    <StackLayout
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="8. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentLiabilities}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="TcLiabilityText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding TcLiabilityY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--  ZakatRevenue  -->

                                    <StackLayout
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="9. " />
                                                    <Span Text="{x:Static ResourceManager:AppResources.ZakatRevenue}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <border:SfBorder
                                            Padding="5"
                                            HorizontalOptions="FillAndExpand"
                                            Style="{StaticResource GreyBorderFrame}"
                                            VerticalOptions="FillAndExpand">

                                            <custom:GAZTBorderlessEntry
                                                x:Name="RevenueText"
                                                FontFamily="{StaticResource SomarRegular}"
                                                FontSize="Small"
                                                HorizontalOptions="FillAndExpand"
                                                Keyboard="Numeric"
                                                PlaceholderColor="Gray"
                                                Text="{Binding RevenueY1}"
                                                TextChanged="calculation_TextChanged"
                                                TextColor="{StaticResource PrimaryColor}"
                                                Unfocused="CashBankText_Unfocused"
                                                VerticalOptions="FillAndExpand">
                                                <custom:GAZTBorderlessEntry.Behaviors>
                                                    <custom1:AmountValidator />
                                                </custom:GAZTBorderlessEntry.Behaviors>
                                            </custom:GAZTBorderlessEntry>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--  ZakatInstalmentNetIncome  -->

                                    <StackLayout
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="FillAndExpand">
                                        <Label
                                            Grid.Row="10"
                                            Grid.Column="0"
                                            FontFamily="{StaticResource SomarRegular}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}"
                                            VerticalOptions="FillAndExpand">
                                            <Label.FormattedText>
