                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel
                                                Grid.Column="0"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmetFrequency}" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding SelectedFrequencyName}" />
                                        </Grid>

                                    </StackLayout>
                                    <!--<Grid Grid.Row="3" Grid.ColumnSpan="2" Padding="8">
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" Style="{StaticResource BodyLabelGrey}"  HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"></custom:CustomLabel>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding NoOfInstalments}" Style="{StaticResource ValueLabelBlack}"  HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"></custom:CustomLabel>
                                    </Grid>
                                    <Grid Grid.Row="4" Grid.ColumnSpan="2" Padding="8">
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetFrequency}" Style="{StaticResource BodyLabelGrey}"  HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"></custom:CustomLabel>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding SelectedFrequencyName}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"></custom:CustomLabel>
                                    </Grid>-->

                                </StackLayout>
                            </border:SfBorder>

                            <!--  Summary Attachments  -->

                            <border:SfBorder
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,16,0,10"
                                HasShadow="False"
                                Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout
                                    Padding="0"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand">
                                    <Grid Padding="0">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="*" />

                                        </Grid.RowDefinitions>
                                        <Grid
                                            Grid.Row="0"
                                            Padding="15"
                                            RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                            </Frame>-->
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Padding="8,0"
                                                HorizontalOptions="FillAndExpand"
                                                Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Center"
                                                    Source="ic_attachment"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />

                                                <Label
                                                    Padding="8,0"
                                                    Style="{StaticResource SectionTitleBlackBold}"
                                                    Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </StackLayout>
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="8,0"
                                                HorizontalOptions="End">
                                                <Label
                                                    FontSize="Medium"
                                                    Style="{StaticResource GAZTCaptionGreenLabelStyle}"
                                                    Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                                    TextColor="{StaticResource Secondary}"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding GoBackToAttachments}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </StackLayout>
                                        </Grid>

                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="1"
                                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                        <listView:SfListView
                                            x:Name="SummaryAttachmentsListView"
                                            Grid.Row="2"
                                            Padding="3,0,3,0"
                                            AutoFitMode="Height"
                                            HorizontalOptions="Center"
                                            IsScrollBarVisible="False"
                                            IsScrollingEnabled="False"
                                            ItemSpacing="5"
                                            ItemsSource="{Binding AttachmentsListViewData}"
                                            SelectionBackgroundColor="Transparent"
                                            SelectionMode="None"
                                            VerticalOptions="StartAndExpand">
                                            <listView:SfListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Margin="10,5,10,0"
                                                        Padding="0"
                                                        RowSpacing="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>


                                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                                            <Image
                                                                HeightRequest="25"
                                                                HorizontalOptions="StartAndExpand"
                                                                Source="documents_Green"
                                                                VerticalOptions="CenterAndExpand"
                                                                WidthRequest="25" />
                                                        </StackLayout>

                                                        <StackLayout
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Margin="10,0,10,0">

                                                            <custom:CustomLabel
                                                                HorizontalOptions="End"
                                                                HorizontalTextAlignment="End"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Filename}"
                                                                VerticalOptions="FillAndExpand" />
                                                        </StackLayout>


                                                    </Grid>
                                                </DataTemplate>
                                            </listView:SfListView.ItemTemplate>
                                        </listView:SfListView>

                                    </Grid>
                                </StackLayout>

                            </border:SfBorder>



                        </Grid>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <!--<RowDefinition Height="auto"/>-->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>

                            <!--<Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">

                                <Frame CornerRadius="10"
                               HasShadow="False"
                               Style="{StaticResource SfStyleForZakatPlanGreen}"
                                Padding="0">
                                    <StackLayout Padding="10" Orientation="Horizontal">

                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                                        <custom:CustomLabel Text="{Binding PeriodicInstalment,StringFormat='{0:N} SAR'}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}" VerticalTextAlignment="Center"/>

                                    </StackLayout>
                                </Frame>
                            </Grid>-->

                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Orientation="Vertical">

                                <Frame
                                    Padding="0"
                                    CornerRadius="10"
                                    HasShadow="False"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">
                                    <StackLayout Padding="10" Orientation="Horizontal">


                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstalmetTotalAmount}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />

                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{Binding VATBillDueAmount, Converter={StaticResource commaSeparatorConverter}}" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="&#160;" />
                                                    <Span Style="{StaticResource ValueLabelBlack}" Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>





                                    </StackLayout>
                                </Frame>



                                <Frame
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    CornerRadius="10"
                                    HasShadow="False"
                                    IsVisible="False"
                                    Style="{StaticResource SfStyleForZakatPlanGreen}">

                                    <StackLayout Padding="10" Orientation="Horizontal">



                                        <custom:CustomLabel
                                            HorizontalOptions="Start"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZakatInstallmentAgreementPenalty}"
                                            VerticalOptions="Center" />



                                        <custom:CustomLabel
                                            HorizontalOptions="EndAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}"
                                            Text="{Binding VATPenalityAmount, Converter={StaticResource commaSeparatorConverter}}"
                                            VerticalOptions="Center" />



                                    </StackLayout>
                                </Frame>
                            </StackLayout>

                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,10">

                                <StackLayout>

                                    <buttons:SfButton
                                        x:Name="SummarybtnContinue"
                                        Margin="0,16,0,16"
                                        Command="{Binding SummaryContinueBtnTapped}"
                                        HeightRequest="48"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.Submit}"
                                        WidthRequest="366" />

                                </StackLayout>
                            </Grid>
                        </Grid>
                    </Grid>


                </Grid>
            </ScrollView>
            <Grid
                BackgroundColor="Transparent"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                        <!--  Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"  -->
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
