<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
            xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" xmlns:local1="clr-namespace:EGAZT.CustomControl"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             mc:Ignorable="d" FlowDirection="RightToLeft"    
              xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             x:Class="EGAZT.Views.NewDesign.ZakatInstalmentPlan.OldZakatInstalmentPlanPageView" 
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

 

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                  <ResourceDictionary>
                <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                    <Setter Property="Rotation" Value="180" />
                </Style>
                <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                    <Setter Property="Rotation" Value="0" />
                </Style>
            </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

 

        </ResourceDictionary>

 

    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPageTitle}" TextColor="White" HorizontalOptions="CenterAndExpand" FontFamily="{StaticResource GAZT_FONT_BOLD}" VerticalOptions="Center" FontSize="Large" />
                        <Label Grid.Row="0" Grid.Column="0"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}" ></TapGestureRecognizer>
                            </Label.GestureRecognizers>
                        </Label>
                       
                        <StackLayout  Grid.Row="0" Grid.Column="2">
                            <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" Orientation="Horizontal" Rotation="90">
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked }"/>
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

 

    <ContentPage.Content>

        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                    <!--Display Instalments-->


                    <!--Data Entry/calculations screen-->

                                        <StackLayout Orientation="Vertical" IsVisible="{Binding InstalmentPlanAgreementsVisible}" BackgroundColor="Transparent" Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <!--
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        -->
                        <Grid Grid.Row="0">
                            <commonView:PageIndicatorView Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,5,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.ZakatOldFinancialDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Margin="0,-10,0,15"
                                            Text="{x:Static ResourceManager:AppResources.CRCompleteBelowDetails}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" />
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                        </Grid>

                         <Grid Grid.Row="2" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlack}" >
                             <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTaxpayerHoldingFinancialStatement}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                              </custom:CustomLabel>

                        <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Style="{StaticResource GreyBorderFrame}">
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{Binding PickedFinancialStatement}"
                                                    HorizontalOptions="FillAndExpand"
                                                    Style="{StaticResource BodyLabelBlack}" />
                            

                                <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="28"
                                                         Glyph="{x:Static FontImage:IconFonts.ChevronDown}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowFinancialStatementPicker}"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            
                            </Grid>
                        </border:SfBorder>

                    </Grid>

                        <Grid Grid.Row="3" IsEnabled="{Binding IsFinsancialStatementsEditable}" Margin="0,10,0,10" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <cards:SfCardView  HasShadow="True" Padding="10" CornerRadius="20" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*"></ColumnDefinition>
                                        <ColumnDefinition Width="50*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="0,0,0,10"
                                                VerticalOptions="FillAndExpand"
                                                Style="{StaticResource ValueLabelBlack}" >
                                          <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZakatYearOne}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                              </custom:CustomLabel>

                                    <!--ZakatYear-->
                                    <StackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="EndAndExpand" Orientation="Vertical">
                                        <border:SfBorder HorizontalOptions="FillAndExpand"  Padding="10" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding Year1}" Keyboard="Numeric" TextChanged="Year1Change_TextChanged"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}"/>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--ZakatCashBank-->
                                    <StackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatCashBank}"
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder  HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding CashBankY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged" />
                                        </border:SfBorder>
                                    </StackLayout>



                                    <!--ZakatShortTermInvestment-->

                                    <StackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding StiY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged" />
                                        </border:SfBorder>
                                    </StackLayout>


                                    <!--ZakatDebitors-->

                                    <StackLayout Grid.Row="2" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatDebitors}"
                                                HorizontalOptions="StartAndExpand"
                                                   VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding DebitorsY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged"/>
                                        </border:SfBorder>

                                    </StackLayout>

                                    <!--ZakatInventory-->
                                    <StackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInventory}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding InventoryY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged" />
                                        </border:SfBorder>
                                    </StackLayout>
                                    <!--ZakatInstalmentTotalCurrentAssets-->
                                    <StackLayout Grid.Row="3" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentAssets}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding TcAssetsY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged" />
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--ZakatInstalmentZakatAndTax-->

                                    <StackLayout Grid.Row="3" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentZakatAndTax}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding ZakatY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged" />
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--ZakatInstalmentTotalCurrentLiabilities-->

                                    <StackLayout Grid.Row="4" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentLiabilities}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding TcLiabltyY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged" />
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--ZakatRevenue-->

                                    <StackLayout Grid.Row="4" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatRevenue}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding RevenueY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand"  TextChanged="calculation_TextChanged"/>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--ZakatInstalmentNetIncome-->

                                    <StackLayout Grid.Row="5" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label Grid.Row="10" Grid.Column="0"
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetIncome}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand"  Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding NetIncomeY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged"/>
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--ZakatInstalmentNetCashFlowFromOperation-->

                                    <StackLayout Grid.Row="5" Grid.Column="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentNetCashFlowFromOperation}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding NcFlowY1}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation_TextChanged"/>
                                        </border:SfBorder>
                                    </StackLayout>
                                    <StackLayout Grid.Row="6" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentProfitabilityRatio}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:CustomLabel Text="{Binding ProfitRatioY1}"
                                                          FontSize="Small" TextColor="Black" VerticalOptions="Center"
                                                          HorizontalOptions="FillAndExpand" />
                                        </border:SfBorder>
                                    </StackLayout>

                                    <StackLayout Grid.Row="6" Grid.Column="1" HorizontalOptions="FillAndExpand" Orientation="Vertical" VerticalOptions="FillAndExpand">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentCashRatio}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="FillAndExpand"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand"  Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:CustomLabel Text="{Binding CashRatioY1}"
                                                          FontSize="Small" TextColor="Black" VerticalOptions="FillAndExpand"
                                                          HorizontalOptions="FillAndExpand" />
                                        </border:SfBorder>
                                    </StackLayout>
                                </Grid>
                            </cards:SfCardView>
                        </Grid>

                        <Grid Grid.Row="4" IsEnabled="{Binding IsFinsancialStatementsEditable}" Margin="0,10,0,10" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <cards:SfCardView  HasShadow="True" Padding="10" CornerRadius="20" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*"></ColumnDefinition>
                                        <ColumnDefinition Width="50*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                HorizontalOptions="StartAndExpand"
                                                Margin="0,0,0,10"
                                                Style="{StaticResource ValueLabelBlack}" >
                                           <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZakatYearTwo}"  />
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                              </custom:CustomLabel>

                                    <!--ZakatYear-->
                                    <StackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="FillAndExpand" Orientation="Vertical">

                                        <border:SfBorder HorizontalOptions="FillAndExpand"  Padding="10" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding Year2}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="Center"
                                                          HorizontalOptions="FillAndExpand" Placeholder="{x:Static ResourceManager:AppResources.ZakatYear}" />
                                        </border:SfBorder>
                                    </StackLayout>

                                    <!--ZakatCashBank-->
                                    <StackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatCashBank}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="Center"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder  HorizontalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding CashBankY2}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="Center"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation2_TextChanged"/>
                                        </border:SfBorder>
                                    </StackLayout>



                                    <!--ZakatShortTermInvestment-->

                                    <StackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatShortTermInvestment}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="Center"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand"  Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding StiY2}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="Center"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation2_TextChanged"/>
                                        </border:SfBorder>
                                    </StackLayout>


                                    <!--ZakatDebitors-->

                                    <StackLayout Grid.Row="2" Grid.Column="0" HorizontalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatDebitors}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="Center"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding DebitorsY2}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="Center"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation2_TextChanged"/>
                                        </border:SfBorder>

                                    </StackLayout>

                                    <!--ZakatInventory-->
                                    <StackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInventory}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="Center"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand" Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding InventoryY2}" Keyboard="Numeric"
                                                         PlaceholderColor="Gray" FontSize="Small" TextColor="Black" VerticalOptions="Center"
                                                          HorizontalOptions="FillAndExpand" TextChanged="calculation2_TextChanged"/>
                                        </border:SfBorder>
                                    </StackLayout>
                                    <!--ZakatInstalmentTotalCurrentAssets-->
                                    <StackLayout Grid.Row="3" Grid.Column="0" HorizontalOptions="FillAndExpand" Orientation="Vertical">
                                        <Label
                                                Text="{x:Static ResourceManager:AppResources.ZakatInstalmentTotalCurrentAssets}"
                                                HorizontalOptions="StartAndExpand"
                                                    VerticalOptions="Center"
                                                Style="{StaticResource MicroGrayLabelStyle}" />

                                        <border:SfBorder HorizontalOptions="FillAndExpand"  Padding="5" Style="{StaticResource GreyBorderFrame}">

                                            <custom:GAZTBorderlessEditor Text="{Binding TcAssetsY2}" Keyboard="Numeric"
