<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.ZakatInstalmentPlan.ZakatInstalmentPlanBottomPopup"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    mc:Ignorable="d">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </pages:PopupPage.Resources>

    <yummy:PancakeView
        Padding="15"
        BackgroundColor="White"
        CornerRadius="15,15,0,0"
        VerticalOptions="EndAndExpand">
        <StackLayout Spacing="15">
            <custom:CustomLabel
                HorizontalOptions="Center"
                Style="{StaticResource SectionTitleBlack}"
                Text="Instructions and Conditions" />
            <ScrollView Grid.Row="1">
                <StackLayout Padding="5" Spacing="15">
                    <Frame
                        Padding="15"
                        BorderColor="LightGray"
                        CornerRadius="12"
                        HasShadow="False">
                        <StackLayout>
                            <StackLayout Orientation="Horizontal">
                                <Image Source="ic_vat_info" />
                                <custom:CustomLabel
                                    CharacterSpacing="0"
                                    Style="{StaticResource BodyLabelBlack}"
                                    Text="Information"
                                    VerticalOptions="CenterAndExpand" />
                            </StackLayout>
                            <custom:CustomLabel Style="{StaticResource BodyLabelBlack}" Text="The adjustment amount entered is more than 10% larger than the amount of domestic standard-rated sales. please verify the amount entered in the return or continue if the amount entered is correct." />
                        </StackLayout>
                    </Frame>
                    <StackLayout Margin="10" Orientation="Horizontal">

                        <buttons:SfCheckBox IsChecked="{Binding IsVatTermsChecked}" />
                        <custom:CustomLabel
                            CharacterSpacing="0"
                            Style="{StaticResource BodyLabelBlack}"
                            Text="I agree with these instructions and conditions."
                            VerticalOptions="CenterAndExpand" />

                    </StackLayout>
                </StackLayout>
            </ScrollView>
            <buttons:SfButton
                x:Name="btnVATInstalement"
                Grid.ColumnSpan="2"
                Margin="0,24,0,24"
                Command="{Binding VATInstalationClicked}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="VAT Instalment" />
            <!--<buttons:SfButton VerticalOptions="EndAndExpand" Margin="0,0,0,0" Style="{StaticResource PrimaryButtonStyle}"  Text="{x:Static ResourceManager:AppResources.VatInstalmetPlanTitle}" Command="{Binding ZakatInstalationClicked}"/>-->
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>