                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalOptions="End" >
                         <Grid.RowDefinitions>
                             <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                         <Frame Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand" Style="{StaticResource SfStyleForZakatPlanGreen}" HasShadow="False" CornerRadius="12" Margin="0,20,0,0" Padding="0">

 

                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="12">
                                <Label Text="{x:Static ResourceManager:AppResources.VATAmountDue}" FontSize="Medium" TextColor="Black" HorizontalOptions="StartAndExpand" />
                                <Label Text="{Binding VATDueAmount,StringFormat='{0:N} SAR'}" FontSize="Medium" FontAttributes="Bold" TextColor="Black" HorizontalOptions="EndAndExpand" />

 

                            </StackLayout>
                        </Frame>
                     
                    <Frame  Grid.Row="1" Grid.ColumnSpan="2"  HasShadow="False" Padding="10">


                        <buttons:SfButton    x:Name="btnZakatContinue" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ReasonContinueBtnTapped}" IsEnabled="{Binding IsContinueButtonEnable}"/>

                    </Frame>
                      </Grid>
                </Grid>
           <!-- Code for Zakat & VAT Agreeemtns -->

               
               <Grid IsVisible="{Binding IsAgreementViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAgrement}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetRequestInstalmentDesc}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.Column="0" BackgroundColor="{StaticResource NeutralGreay}" HeightRequest="1"/>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsZakatSelected}" >

                        <StackLayout Grid.Row="0" Grid.Column="0">

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetFrequency}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />

                        </StackLayout>

                    </Grid>

                    <listView:SfListView x:Name="frequencyOptionsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding ZakatAgreementOptions}"  SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent" IsVisible="{Binding IsZakatSelected}">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="100">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                        <Image Source="vat_tile_listofsignup_W" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                        <custom:CustomLabel Text="{Binding FrequencyOptions}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                    Margin="20,0,20,20" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                        </custom:CustomLabel>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <listView:SfListView.SelectedItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="100">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                        <Image Source="vat_tile_listofsignup" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                        <custom:CustomLabel Text="{Binding FrequencyOptions}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                    Margin="20,0,20,20" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                        </custom:CustomLabel>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.SelectedItemTemplate>
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayoutAgreement" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>
                    </listView:SfListView>

                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" >

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentSchedule}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />
                        
                    </Grid>

                    <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">

                        <cards:SfCardView HasShadow="True"  CornerRadius="20" >
                            <StackLayout Padding="10">

                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetNumberOfInstalments}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />

                                <custom:CustomLabel  Text="{Binding NoOfInstalments}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}" />

                                <Frame CornerRadius="10"  
                                  BackgroundColor="WhiteSmoke" HasShadow="False"
                                    Padding="0">
                                    <StackLayout>
                                        <Slider x:Name="installmentsSlider" 
                                            Maximum="{Binding MaxInstalments}" 
                                            Margin="5,5,5,10"                                                                                              
                                            MinimumTrackColor="{StaticResource Primary}"
                                                MaximumTrackColor="LightSlateGray"
                                                ThumbColor="{StaticResource Primary}"
                                            ValueChanged="Installment_ValueChanged"
                                     Minimum="{Binding MinInstalments}"/>

                                    </StackLayout>
                                </Frame>
                                <StackLayout Padding="10" Orientation="Horizontal">

                                    <custom:CustomLabel Text="{Binding MinInstalments,StringFormat='Min. {0}'}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                                    <custom:CustomLabel  Text="{Binding MaxInstalments,StringFormat='Max. {0}'}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>
                                </StackLayout>
                            </StackLayout>
                            </cards:SfCardView>
                           
                    </Grid>

                    <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" IsVisible="{Binding IsZakatSelected}">

                        <cards:SfCardView HasShadow="True"  CornerRadius="20" >
                            <StackLayout Padding="10">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDownPaymentAmount}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" />

                                <custom:CustomLabel  Text="{Binding DownPaymentAmount,StringFormat='{0:0,0.00} SAR'}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}" />

                                <Frame CornerRadius="10"  
                                     BackgroundColor="WhiteSmoke" 
                                        Padding="0"
                                       HasShadow="False"
                                       >
                                    <StackLayout>
                                        <Slider x:Name="downPaymentSlider" 
                                        ThumbColor="{StaticResource Primary}"
                                        MinimumTrackColor="{StaticResource Primary}"
                                                MaximumTrackColor="LightSlateGray"
                                        ValueChanged="DownPayment_ValueChanged"
                                            Maximum="{Binding MaxAmount}" 
                                            Margin="5,5,5,10"
                                     Minimum="{Binding MinAmount}"/>

                                    </StackLayout>
                                </Frame>
                                <StackLayout Padding="10" Orientation="Horizontal">

                                    <custom:CustomLabel Text="{Binding MinAmount,StringFormat='Min. {0:0,0.00} SAR'}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                                    <custom:CustomLabel  Text="{Binding MaxAmount,StringFormat='Max. {0:0,0.00} SAR'}" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center"/>

                                </StackLayout>
                            </StackLayout>
