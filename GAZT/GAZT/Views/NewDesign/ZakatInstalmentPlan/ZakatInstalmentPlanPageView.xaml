                            </Frame>

 
                            <Frame CornerRadius="10"  
                               Style="{StaticResource SfStyleForZakatPlanGreen}"
                                HasShadow="False"
                                     Padding="0">
                                <StackLayout Padding="10" Orientation="Horizontal">


                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetDownPaymentAmount}" HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                Style="{StaticResource BodyLabelBlack}" />

                                    <custom:CustomLabel Text="{Binding DownPaymentSAR}" HorizontalOptions="EndAndExpand" VerticalOptions="Center"
                                                Style="{StaticResource SectionTitleBlackBold}" />

 

                                </StackLayout>
                            </Frame>


                                <Frame CornerRadius="10"  Margin="0,10,0,0"
