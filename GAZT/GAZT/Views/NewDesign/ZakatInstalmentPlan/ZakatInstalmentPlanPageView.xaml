                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZSummary}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlackBold}" />
                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}" Margin="0,0,0,8" />
                    <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                    <border:SfBorder Margin="0,16,0,10" Grid.Row="3" Grid.Column="0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0">
                            <Grid Padding="15" RowSpacing="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame>
                                <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="establishments"/>
                                <StackLayout  HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1" Padding="8,0">
                                    <Label Text="{x:Static ResourceManager:AppResources.Bills}" VerticalOptions="CenterAndExpand"
                                           Style="{StaticResource SectionTitleBlackBold}"/>
                                </StackLayout>
                                <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                   <Label TextColor="ForestGreen" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                           VerticalOptions="CenterAndExpand"  Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToBills}" ></TapGestureRecognizer>
                                            </Label.GestureRecognizers>
                                        </Label>
                                </StackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                            <listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding SummarySelectedBillsList}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0" RowSpacing="0" Margin="10,5,10,0">
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*"/>
                                                <ColumnDefinition Width="50*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                                                <custom:CustomLabel Text="{Binding billNumber}" Style="{StaticResource SectionTitleBlackBold}"  HorizontalOptions="StartAndExpand"/>
                                            </StackLayout>

                                            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                                <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryBillType}" Style="{StaticResource BodyLabelGrey}" LineHeight="0.7" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"></custom:CustomLabel>
                                                <custom:CustomLabel Grid.Column="1" Text="{Binding billType}" Style="{StaticResource ValueLabelBlack}" LineHeight="0.7" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"></custom:CustomLabel>
                                            </Grid>
                                            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                                <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummarySadadNumber}" Style="{StaticResource BodyLabelGrey}" LineHeight="0.7" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"></custom:CustomLabel>
                                                <custom:CustomLabel Grid.Column="1" Text="{Binding saadNumber}" Style="{StaticResource ValueLabelBlack}" LineHeight="0.7" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"></custom:CustomLabel>
                                            </Grid>
                                            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                                                <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryTaxPeriod}" Style="{StaticResource BodyLabelGrey}" LineHeight="0.7" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"></custom:CustomLabel>
                                                <custom:CustomLabel Grid.Column="1" Text="{Binding taxPeriod}" Style="{StaticResource ValueLabelBlack}" LineHeight="0.7" HorizontalTextAlignment="End" HorizontalOptions="EndAndExpand"></custom:CustomLabel>
                                            </Grid>

                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </StackLayout>
                    </border:SfBorder >

                    <!-- Installment Agreement Section-->
                    
                    <border:SfBorder Margin="0,16,0,10" Grid.Row="4" Grid.Column="0"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0">
                            <Grid Padding="15" RowSpacing="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame>
                                <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="establishments"/>
                                <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1" Padding="8,0">
                                    <Label Text="{x:Static ResourceManager:AppResources.ZakatInstalmentAgrement}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                </StackLayout>
                                <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                               <Label TextColor="ForestGreen" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                           VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToAggrement}" ></TapGestureRecognizer>
                                            </Label.GestureRecognizers>
                                        </Label>

                                </StackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                            <listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="summaryReaonListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding InstallmentAgreementListViewData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0" RowSpacing="0" Margin="10,5,10,0">
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                                <Label Text="{Binding FieldTitle}" Style="{StaticResource BodyLabelGrey}" LineHeight="0.7" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                                <Label Text="{Binding AttachmentName}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                            </StackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </StackLayout>
                    </border:SfBorder >

                    <!-- Attachments Section -->

                    <border:SfBorder Margin="0,16,0,10" Grid.Row="5" Grid.Column="0"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <StackLayout Padding="0">
                            <Grid Padding="15" RowSpacing="0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                </Frame>
                                <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center"  Aspect="AspectFit" Source="ic_attachment"/>
                                <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="1" Padding="8,0">
                                    <Label Text="{x:Static ResourceManager:AppResources.Attachments}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                </StackLayout>
                                <StackLayout HorizontalOptions="Center" Grid.Row="0" Grid.Column="2" Padding="8,0">
                                   <Label TextColor="ForestGreen" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentSummaryEdit}"
                                           VerticalOptions="CenterAndExpand" Style="{StaticResource GAZTCaptionGreenLabelStyle}" FontSize="Medium">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding GoBackToAttachments}" ></TapGestureRecognizer>
                                            </Label.GestureRecognizers>
                                        </Label>
                                </StackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                            <listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="SummaryattachmentsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding SummaryAttachmentsListViewData}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                                <listView:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0" RowSpacing="0" Margin="10,5,10,0">
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0" Spacing="-5">
                                                <Label Text="{Binding FieldTitle}" Style="{StaticResource BodyLabelGrey}" LineHeight="0.7" HorizontalTextAlignment="Start" HorizontalOptions="StartAndExpand"/>
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="-5">
                                                <Label Text="{Binding AttachmentName}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" HorizontalOptions="End"/>
                                            </StackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </listView:SfListView.ItemTemplate>
                            </listView:SfListView>
                        </StackLayout>
                    </border:SfBorder >
                    
                    
                </Grid>
                <Grid Grid.Row="1"  Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">

                        <Frame CornerRadius="10"
                               HasShadow="False"
                               Style="{StaticResource SfStyleForZakatPlanGreen}"
                                Padding="0">
                            <StackLayout Padding="10" Orientation="Horizontal">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetPeriodicInstalment}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelBlack}" VerticalTextAlignment="Center" />

                                <custom:CustomLabel  Text="38,000.00 SAR" HorizontalOptions="EndAndExpand"
                                                Style="{StaticResource SectionTitleBlackBold}" VerticalTextAlignment="Center"/>

                            </StackLayout>
                        </Frame>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">

                        <Frame CornerRadius="10"  
                               Style="{StaticResource SfStyleForZakatPlanGreen}"
                                HasShadow="False"
                                     Padding="0">
                            <StackLayout Padding="10" Orientation="Horizontal">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetTotalAmount}" HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                Style="{StaticResource BodyLabelBlack}" />

                                <custom:CustomLabel Text="50,000.00 SAR" HorizontalOptions="EndAndExpand" VerticalOptions="Center"
                                                Style="{StaticResource SectionTitleBlackBold}" />

                            </StackLayout>
                        </Frame>
                    </Grid>
                   
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,10">

                        <StackLayout>

                            <buttons:SfButton  Margin="0,16,0,16"  x:Name="SummarybtnContinue" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SummaryContinueBtnTapped}" />

                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>

        <Grid IsVisible="{Binding IsSucessViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

              <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand">

                <Image x:Name="imgCheck" HorizontalOptions="CenterAndExpand">
                    <Image.Source>
                        <FontImageSource FontFamily="UserIconFont" Color="White" Size="100"
                                         Glyph="{x:Static FontImage:IconFonts.CheckboxMarkedCircle}"/>
                    </Image.Source>
                </Image>
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentRequestInstalmentPlan}" Margin="0,20,0,0" FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentYourVatInstalmentPlanIsSuccessfullySubmitted}" Margin="0,15,0,0"
                       TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </StackLayout>
            <ScrollView>
                <yummy:PancakeView BackgroundColor="White" CornerRadius="20,20,0,0" Padding="20" HasShadow="False" VerticalOptions="EndAndExpand">
                    <StackLayout>

                        <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="10,15,10,20" HasShadow="False">
                            <StackLayout Orientation="Horizontal" Padding="10">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentReferenceNumber}" VerticalOptions="Center" FontSize="12" TextColor="#909090"   HorizontalOptions="StartAndExpand"/>
                                <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                    <custom:CustomLabel x:Name="Label_ApplicationNumber" Text="1234567890" FontSize="16" VerticalOptions="Center" TextColor="#010101" />
                                    <Image>
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont" Color="DarkGreen" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ContentCopy}"/>
                                        </Image.Source>
                                    </Image>
                                </StackLayout>
                            </StackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer />
                            </Frame.GestureRecognizers>
                        </Frame>
                        <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="10,5,10,5" HasShadow="False">
                                    <StackLayout Orientation="Horizontal" Padding="10">
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentsSadadNumber}" VerticalOptions="Center" FontSize="12" TextColor="#909090"   HorizontalOptions="StartAndExpand"/>
                                        
                                         <custom:CustomLabel x:Name="Label_SadadNumber" Text="1234567890" FontSize="16" VerticalOptions="Center" TextColor="#010101" />
                                            
                                    </StackLayout>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer />
                                    </Frame.GestureRecognizers>
                                </Frame>
                                <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="10,5,10,5" HasShadow="False">
                                    <StackLayout Orientation="Horizontal" Padding="10">
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDownPaymentAmountPayable}" VerticalOptions="Center" FontSize="12" TextColor="#909090"   HorizontalOptions="StartAndExpand"/>
                                        
                                        <custom:CustomLabel x:Name="Label_DownPaymentNumber" Text="1234567890" FontSize="16" VerticalOptions="Center" TextColor="#010101" />
                                           
                                    </StackLayout>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer />
                                    </Frame.GestureRecognizers>
                                </Frame>

                        <buttons:SfButton x:Name="btnDashboard" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentDownloadConfirmation}" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="46"  Margin="10,20,10,20" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="#d49504" TextColor="White" />

                        <custom:CustomLabel Margin="10,10,10,20" Text="{x:Static ResourceManager:AppResources.ZakatInstalmentGoToDashboard}"
                       TextColor="#d49504" HorizontalOptions="Center"  HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </yummy:PancakeView>
            </ScrollView>
        </StackLayout>
         </Grid>
           </Grid>
       </ScrollView>
    </ContentPage.Content>
</ContentPage>
