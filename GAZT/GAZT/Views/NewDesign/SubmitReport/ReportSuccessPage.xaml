<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.SubmitReport.ReportSuccessPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="2.5*,*">

            <!--#region Header-->
            <StackLayout>

                <!--  Success Icon and Msg  -->
                <StackLayout
                    HorizontalOptions="Start"
                    Spacing="10"
                    VerticalOptions="CenterAndExpand">

                    <!--  Success icon  -->
                    <Image
                        Margin="0,0,0,30"
                        Aspect="AspectFit"
                        HeightRequest="150"
                        Source="Forget_ic_success"
                        WidthRequest="150" />

                    <!--  Success Msg1 Label  -->
                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static ResourceManager:AppResources.ReportSentSuccess}"
                        TextColor="White" />

                    <!--  Success Msg2 Label  -->
                    <Label
                        Margin="40,0"
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="18"
                        HorizontalOptions="CenterAndExpand"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{x:Static ResourceManager:AppResources.ReportSuccessMsg}"
                        TextColor="White" />

                    <!--  Back to Home Button  -->
                    <buttons:SfButton
                        Margin="20,50"
                        BackgroundColor="#0996D4"
                        Command="{Binding BackToHomeCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.BackToHome}" />
                </StackLayout>


            </StackLayout>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">

                    <StackLayout Margin="0,0,0,20">


                        <!--  ReportNote Frame  -->
                        <yummy:PancakeView
                            Margin="0,15"
                            Border="{yummy:BorderMarkup Color=#EBEBEB,
                                                        Thickness='1'}"
                            CornerRadius="15"
                            Style="{StaticResource CommonTopCurves}"
                            VerticalOptions="Start">



                            <StackLayout Orientation="Horizontal" Spacing="10">

                                <!--  ReportNumber Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.ZTEReportReportNumber}"
                                    TextColor="{StaticResource NeutralGreay}" />

                                <!--  Report Number Result Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding ReportNumberResult}"
                                    TextColor="#58595B" />

                                <!--  Report icon  -->
                                <Image
                                    HorizontalOptions="End"
                                    Source="zakat_copy"
                                    Style="{StaticResource SmallIcon}" />

                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CopyCommand}"/>
                                </StackLayout.GestureRecognizers>

                            </StackLayout>



                        </yummy:PancakeView>

                        <!--  Send Report Button  -->
                        <buttons:SfButton
                            BackgroundColor="White"
                            BorderColor="#0996D4"
                            BorderWidth="1"
                            Command="{Binding GoToMyReportsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.NDMyReports}"
                            TextColor="#0996D4" />

                    </StackLayout>

                </ScrollView>


            </yummy:PancakeView>
            <!--#endregion Body-->

        </Grid>
    </ContentPage.Content>
</ContentPage>