<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      x:Class="EGAZT.Views.NewDesign.CustomServicesPages.Transaction_Reception.NewCrPopupView"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    FlowDirection="{Binding AppDirection}">

    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />      
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            HasBackgroundAnimation="True"
            PositionIn="Bottom"
            PositionOut="Bottom" />
    </pages:PopupPage.Animation>

     <Grid VerticalOptions="EndAndExpand">

                     <yummy:PancakeView Grid.Row="0" VerticalOptions="EndAndExpand" Style="{StaticResource CommonTopCurves}">
                <StackLayout>
                    <Image Source="CloseIcon" HeightRequest="22" WidthRequest="22" HorizontalOptions="EndAndExpand">
                        <Image.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding DisplayAddNewCRViewCommand}" CommandParameter="false"></TapGestureRecognizer>

                            </Image.GestureRecognizers>

                    </Image>
                        <!--#region New CR Field -->
                        <StackLayout Spacing="0">
                            <!--  New CR Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}"
                                                 >
                            <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.AddNewCRTitle}"/>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                             </custom:CustomLabel>
                            <!--  New CR  Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.AddNewCRTitle}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding CRNo}"
                                    TextColor="#58595B" />
                            </inputLayout:SfTextInputLayout>
                 
                        </StackLayout>
                    <!--#endregion-->
                              <!--  Add Button  -->
                        <buttons:SfButton
                            Margin="0,40"
                            BackgroundColor="#0996D4"
                            Command="{Binding AddNewCRCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.Add}" />
                </StackLayout>

            </yummy:PancakeView>


     </Grid>
</pages:PopupPage>



