                <Grid IsVisible="{Binding IsNoUserShowMsg}"
        Grid.Row="0"
        Margin="0,0,0,0"
        VerticalOptions="EndAndExpand">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}" />
        </Grid.GestureRecognizers>

        <StackLayout
            BackgroundColor="Black"
            Opacity="0.4"
            VerticalOptions="FillAndExpand" />

        <yummy:PancakeView
            Padding="20,20,20,10"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            Style="{StaticResource CommonTopCurves}"
            VerticalOptions="EndAndExpand">

            <StackLayout Margin="0" VerticalOptions="Center">

                <Label
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource BodyLabelBlack}"
                    Text="{Binding MessageTxt}" />

                <buttons:SfButton
                    Margin="0,0,0,10"
                    Command="{Binding CloseMsgViewCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                    VerticalOptions="CenterAndExpand" />
 <buttons:SfButton 
                    Margin="0,0,0,10"
                    Command="{Binding OpenIAMRegistrationUrlCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.Clickhereforlogin}"
                    VerticalOptions="CenterAndExpand" />
           </StackLayout>

        </yummy:PancakeView>

    </Grid>
