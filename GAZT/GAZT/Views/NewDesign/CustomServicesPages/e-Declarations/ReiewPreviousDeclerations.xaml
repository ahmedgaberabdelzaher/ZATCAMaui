<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="EGAZT.Views.NewDesign.CustomServicesPages.eDeclarations.ReiewPreviousDeclerations"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView">
    <Grid RowDefinitions="auto,*">
        <yummy:PancakeView
            Grid.Row="1"
            Padding="20,20,20,0"
            Style="{StaticResource CommonTopCurves}">
            <WebView
                Margin="-20,0,-20,0" Navigating="WebView_Navigating"
                HorizontalOptions="FillAndExpand"
                IsTabStop="True"
                x:Name="webc"
                VerticalOptions="FillAndExpand" />
        </yummy:PancakeView>
        <controls:Header TitleText="{x:Static ResourceManager:AppResources.CarImport}" />
        <controls:Loader
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsLoading}" />
    </Grid>
</newdesign:BaseContentPage>
