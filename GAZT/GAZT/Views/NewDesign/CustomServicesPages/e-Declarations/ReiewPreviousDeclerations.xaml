<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
 xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:controls="clr-namespace:EGAZT.Controls"
    x:Class="EGAZT.Views.NewDesign.CustomServicesPages.eDeclarations.ReiewPreviousDeclerations"
    >
 <Grid RowDefinitions="auto,*">
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}" Padding="20,20,20,0" >
              <WebView  IsTabStop="True"  Margin="-20,-40,-20,0" Source="{Binding WebViewUrl}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />
            </yummy:PancakeView>
        <controls:Header TitleText="{x:Static ResourceManager:AppResources.Reviewapreviousrequest}"></controls:Header>
        <controls:Loader  Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}"></controls:Loader>
        </Grid>
    </newdesign:BaseContentPage>
