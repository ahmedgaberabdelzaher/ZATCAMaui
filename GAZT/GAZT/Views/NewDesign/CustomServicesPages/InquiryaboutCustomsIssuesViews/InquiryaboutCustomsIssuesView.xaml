<ContentPage
x:Class="EGAZT.Views.NewDesign.CustomServicesPages.InquiryaboutCustomsIssuesViews.InquiryaboutCustomsIssuesView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       BackgroundImageSource="partials_background.png"
          FlowDirection="{Binding AppDirection}"
    xmlns:ResourceManager="clr-namespace:EGAZT" NavigationPage.HasNavigationBar="False"
        xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:controls="clr-namespace:EGAZT.Controls"  ios:Page.UseSafeArea="true"
    xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:custom="clr-namespace:GAZT">
  <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="auto,*">
            <Grid Padding="20,5,20,5" Grid.Row="0" ColumnDefinitions="10*,80*,10*">
        <StackLayout Grid.Column="0">
            <Image
                x:Name="backbutton"
                HorizontalOptions="Start"
                Rotation="180"
                Source="arrowLeftwhite.png"
                Style="{DynamicResource BackButtonArrow}"
                VerticalOptions="CenterAndExpand">
                <Image.Triggers>
                    <DataTrigger
                        Binding="{Binding AppDirection}"
                        TargetType="Image"
                        Value="LeftToRight">
                        <Setter Property="Rotation" Value="0" />

                    </DataTrigger>
                </Image.Triggers>
            </Image>
            <StackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="BackTapped"/>
            </StackLayout.GestureRecognizers>
        </StackLayout>
        <custom:CustomLabel
           Text="{x:Static ResourceManager:AppResources.InquiryaboutCustomsIssuesView}" 
            Grid.Column="1"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            LineSpacing=".9"
            Style="{StaticResource SectionTitleWhiteBold}"
            VerticalOptions="Center" />
    </Grid>

        <yummy:PancakeView
            Grid.Row="1"
            Padding="20,20,20,0"
            Style="{StaticResource CommonTopCurves}">
            <WebView
                Margin="-20,0,-20,0"
                HorizontalOptions="FillAndExpand"
                IsTabStop="True"
                x:Name="webc"
                VerticalOptions="FillAndExpand" />
        </yummy:PancakeView>
        <controls:Loader
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsLoading}" />
    </Grid>
</ContentPage>


