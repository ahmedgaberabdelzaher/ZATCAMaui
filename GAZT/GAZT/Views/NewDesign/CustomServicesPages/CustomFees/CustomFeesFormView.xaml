<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="EGAZT.Views.NewDesign.CustomServicesPages.CustomFees.CustomFeesFormView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:behaviour="clr-namespace:GAZT.CustomControl"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:controls1="clr-namespace:EGAZT.Views.NewDesign.EDeclaration.QuestionsViews"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
    HasBackButton="True"
    TitleText="{x:Static ResourceManager:AppResources.CustomFeesCalculator}">

    <newdesign:BaseContentPage.PancakeView>

        <Grid>
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">

                <ScrollView.Triggers>
                    <DataTrigger
                        Binding="{Binding IsshowFeesView}"
                        TargetType="ScrollView"
                        Value="true">
                        <Setter Property="IsVisible" Value="false" />

                    </DataTrigger>
                </ScrollView.Triggers>

                <StackLayout VerticalOptions="Start">


                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="16"
                        Text="{x:Static ResourceManager:AppResources.CustomFeesCalculator}"
                        TextColor="#14395B" />

                    <!--#region Hint view-->
                    <Frame
                        Padding="10"
                        BorderColor="#E6E6E6"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="StartAndExpand">
                        <StackLayout
                            HorizontalOptions="StartAndExpand"
                            Spacing="10"
                            VerticalOptions="FillAndExpand">
                            <Grid ColumnDefinitions="auto,auto" RowDefinitions="auto,auto">
                                <!--  info icon  -->
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="20"
                                    HorizontalOptions="CenterAndExpand"
                                    Source="information.png"
                                    VerticalOptions="StartAndExpand"
                                    WidthRequest="20" />
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontFamily="{StaticResource SomarBold}"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.Disclaimer}"
                                    TextColor="#14395B" />
                                <!--  Question Hint Label  -->
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="1" LineSpacing=".8"
                                    FontSize="12"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.FeesCalcDisclaimerTXt}"
                                    TextColor="Gray" />
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <!--#endregion-->

                    <!--#region Material Selection-->

                    <!--  TypeItem Field  -->
                    <StackLayout Spacing="0">

                        <!--  TypeItem Label  -->
                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.Thetypeofmerchandise}" />
                                    <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>

                        <!--  TypeItem Entry  -->
                        <inputLayout:SfTextInputLayout
                            ContainerBackgroundColor="White"
                            ContainerType="Outlined"
                            ErrorColor="#B00020"
                            FocusedColor="{StaticResource NeutralGreay}"
                            InputViewPadding="16,0,16,0"
                            LeadingViewPosition="Inside"
                            OutlineCornerRadius="15"
                            UnfocusedColor="{StaticResource NeutralGreay}">
                            <custom:BorderlessEntry
                                InputTransparent="True"
                                IsReadOnly="True"
                                Keyboard="Text"
                                Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding SelectedCalcTypeName}"
                                TextColor="#58595B">
                                <custom:BorderlessEntry.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                                </custom:BorderlessEntry.GestureRecognizers>
                            </custom:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.TrailingView>
                                <Image Aspect="AspectFit" Source="greyDropDown" />
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                        </StackLayout.GestureRecognizers>

                    </StackLayout>

                    <!--#endregion-->

                    <!--#region TProductView-->
                    <StackLayout IsVisible="false" VerticalOptions="StartAndExpand">
                        <StackLayout.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedCalcType}"
                                TargetType="StackLayout"
                                Value="2">
                                <Setter Property="IsVisible" Value="true" />
                            </DataTrigger>

                        </StackLayout.Triggers>

                        <!--  ProductName Field  -->
                        <StackLayout IsVisible="{Binding IsProductItemHaveSubType}" Spacing="0">

                            <!--  ProductName Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Selecttheitem}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  ProductName Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedProductSubTypes.Name}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                    </custom:BorderlessEntry.GestureRecognizers>
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>

                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                            </StackLayout.GestureRecognizers>

                        </StackLayout>

                        <!--  Quantity Field  -->
                        <StackLayout IsVisible="false" Spacing="0">

                            <!--  Quantity Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Quantity}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Quantity Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding Quantity}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.Behaviors>
                                        <behaviour:OnlyNumericValuesBehaviour />
                                    </custom:BorderlessEntry.Behaviors>

                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                        </StackLayout>
                        <!--#region units View-->
                        <!--  unit Label  -->
                        <StackLayout IsVisible="false">
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.units}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    InputTransparent="True"
                                    IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedUnit.Name}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                                    </custom:BorderlessEntry.GestureRecognizers>
                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image Aspect="AspectFit" Source="greyDropDown" />
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                        <!--#endregion-->
                        <!--  Value Field  -->
                        <StackLayout Spacing="0">

                            <!--  Quantity Label  -->
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.Productvalue}" />
                                        <Span Style="{StaticResource MandatoryRedColorSpan}" Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <!--  Total Value Entry  -->
                            <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                HelperText="{x:Static ResourceManager:AppResources.ProductValueHint}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                <custom:BorderlessEntry
                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.Productvalue}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding TotalValue}"
                                    TextColor="#58595B">
                                    <custom:BorderlessEntry.Behaviors>
                                        <behaviour:OnlyNumericWithDecimalValuesBehaviour />
                                    </custom:BorderlessEntry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <Label
                                Margin="16,0,16,0"
                                FontSize="12"
                                IsVisible="false"
                                Text="{x:Static ResourceManager:AppResources.NumberHint}"
                                TextColor="#58595B" />
                        </StackLayout>

                    </StackLayout>
                    <!--#endregion-->

                    <!--#region TobacoView-->
                    <controls1:TobacoView IsVisible="false">
                        <controls1:TobacoView.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedCalcType}"
                                TargetType="controls1:TobacoView"
                                Value="1">
                                <Setter Property="IsVisible" Value="true" />
                            </DataTrigger>

                        </controls1:TobacoView.Triggers>

                    </controls1:TobacoView>
                    <!--#region-->

                    <Frame
                        Margin="0,40,0,0"
                        Padding="10"
                        BackgroundColor="#0996D4"
                        CornerRadius="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CalculateCommand}" />
                        </Frame.GestureRecognizers>
                        <Label
                            FontSize="16"
                            HorizontalOptions="CenterAndExpand"
                            Text="{x:Static ResourceManager:AppResources.Calculate}"
                            TextColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CalculateCommand}" />
                            </Label.GestureRecognizers>

                        </Label>
                    </Frame>

                </StackLayout>
            </ScrollView>

            <Grid Grid.Row="0" IsVisible="{Binding IsshowFeesView}">

                <StackLayout VerticalOptions="Start">

                    <Label
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="16"
                        Text="{x:Static ResourceManager:AppResources.CustomsFeesValue}"
                        TextColor="#14395B" />

                    <!--  Horizontal Line  -->
                    <BoxView
                        Grid.Column="7"
                        BackgroundColor="#EBEBEB"
                        HeightRequest="1"
                        WidthRequest="20" />

                    <!--#region Fees Details-->

                    <!--  Fees Details frame  -->
                    <Frame
                        Padding="10"
                        BorderColor="#E6E6E6"
                        CornerRadius="10"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <StackLayout>

                            <Label
                                Margin="20"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="16"
                                Text="{Binding SelectedCalcTypeName}"
                                TextColor="#14395B" />

                            <BoxView
                                Grid.Column="7"
                                BackgroundColor="#EBEBEB"
                                HeightRequest="1"
                                WidthRequest="20" />

                            <Grid
                                Margin="16"
                                ColumnDefinitions="*,*"
                                RowDefinitions="auto,auto,auto,auto,auto">

                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2">

                                    <Label Style="{StaticResource BodyLabelGrey}"
                                           Text="{x:Static ResourceManager:AppResources.Productvalue}" />

                                    <Label Style="{StaticResource BodyLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FeesCalculatorResponse.productFinalPrice}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </StackLayout>

                                <StackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2">

                                    <Label Style="{StaticResource BodyLabelGrey}" >

                                           <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.CustomsFees}" />
                                                    <Span Text=" " />
                                                    <Span Text="5%" />
                                                </FormattedString>
                                           </Label.FormattedText>

                                    </Label>

                                     <!--CustomsFeesDisclaimer Label-->
                                    <Label Style="{StaticResource BodyLabelGrey}"
                                           FontSize="12"
                                           Margin="0,-10,0,0"
                                           Text="{x:Static ResourceManager:AppResources.CustomsdeclarationDisclaimer}" />

                                    <Label Style="{StaticResource BodyLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FeesCalculatorResponse.totalDuty}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </StackLayout>

                                <StackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2">

                                    <Label Style="{StaticResource BodyLabelGrey}"
                                           Text="{x:Static ResourceManager:AppResources.Customsdeclarationissuancefees}" />

                                    <Label Style="{StaticResource BodyLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FeesCalculatorResponse.extraFees}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                </StackLayout>

                                <StackLayout
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    IsVisible="false">

                                    <StackLayout.Triggers>
                                        <DataTrigger
                                            Binding="{Binding SelectedCalcType}"
                                            TargetType="StackLayout"
                                            Value="1">
                                            <Setter Property="IsVisible" Value="true" />
                                        </DataTrigger>

                                    </StackLayout.Triggers>

                                    <Label Style="{StaticResource BodyLabelGrey}"
                                           Text="{x:Static ResourceManager:AppResources.ExciseTax2}" />

                                    <Label Style="{StaticResource BodyLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FeesCalculatorResponse.excise}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                </StackLayout>

                                <StackLayout
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2">

                                    <Label Style="{StaticResource BodyLabelGrey}"
                                           Text="{x:Static ResourceManager:AppResources.VATCertificates}" >

                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.VATCertificates}" />
                                                    <Span Text=" " />
                                                    <Span Text="15%" />
                                                </FormattedString>
                                            </Label.FormattedText>

                                    </Label>

                                    <!--VATCertificates Disclamier-->
                                    <Label Style="{StaticResource BodyLabelGrey}"
                                            FontSize="12"
                                            Margin="0,-10,0,0"
                                            Text="{x:Static ResourceManager:AppResources.VATCertificatesDisclaimer}" />

                                    <Label Style="{StaticResource BodyLabelBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FeesCalculatorResponse.vat}" />
                                                <Span Text=" " />
                                                <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                </StackLayout>
                            </Grid>

                            <Grid Margin="5"
                                  VerticalOptions="EndAndExpand">

                                <Frame
                                    Margin="-16"
                                    BackgroundColor="#0996D4"
                                    CornerRadius="8"
                                    HasShadow="False"
                                    HorizontalOptions="FillAndExpand"
                                    Opacity=".1" />

                                <StackLayout VerticalOptions="CenterAndExpand">

                                     <StackLayout Orientation="Horizontal">
                                            <Label
                                                FontSize="20"
                                                Text="{x:Static ResourceManager:AppResources.Total2}"
                                                TextColor="#002447" />

                                            <Label HorizontalOptions="EndAndExpand"
                                                   Style="{StaticResource BodyLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding FeesCalculatorResponse.totalPayment}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                     </StackLayout>

                                     <!--Total Disclaimer-->
                                     <Label Style="{StaticResource BodyLabelGrey}"
                                            FontSize="12"
                                            TextColor="#002447"
                                            Text="{x:Static ResourceManager:AppResources.NDTotalDisclaimer}" />
                                </StackLayout>
                               
                            </Grid>

                        </StackLayout>

                    </Frame>

                    <!--#endregion-->

                </StackLayout>

            </Grid>

            <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet Grid.Row="0"
                                      IsVisible="{Binding IsShowBottomSheet}" />

        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

