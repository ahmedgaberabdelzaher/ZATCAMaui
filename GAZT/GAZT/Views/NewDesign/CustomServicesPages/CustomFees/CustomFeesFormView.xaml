<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
        xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
     xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign" HasBackButton="True"
         xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
         xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
         xmlns:behaviour="clr-namespace:GAZT.CustomControl"
         xmlns:controls1="clr-namespace:EGAZT.Views.NewDesign.EDeclaration.QuestionsViews"
      TitleText="{x:Static ResourceManager:AppResources.CustomFeesCalculator}"
    x:Class="EGAZT.Views.NewDesign.CustomServicesPages.CustomFees.CustomFeesFormView">
   
    <newdesign:BaseContentPage.PancakeView>
      
        <Grid>
            <ScrollView VerticalScrollBarVisibility="Never"  Grid.Row="0">
                <ScrollView.Triggers>
                    <DataTrigger TargetType="ScrollView" Binding="{Binding IsshowFeesView}" Value="true">
                        <Setter Property="IsVisible" Value="false"></Setter>

                    </DataTrigger>
                                    </ScrollView.Triggers>

       <StackLayout VerticalOptions="Start" >
                

                <Label  TextColor="#14395B" FontFamily="{StaticResource SomarBold}"  FontSize="16" Text="{x:Static ResourceManager:AppResources.CustomFeesCalculator}"></Label>
               <!--#region Hint view-->
                            <Frame Padding="10" 
                               BorderColor="#E6E6E6"
                               VerticalOptions="StartAndExpand"
                               HorizontalOptions="FillAndExpand"
                               CornerRadius="10">
                                <StackLayout 
                                    VerticalOptions="FillAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="10">
                        <Grid RowDefinitions="auto,auto" ColumnDefinitions="auto,auto">
                                    <!--info icon-->
                                    <Image Grid.Row="0" Grid.Column="0"  Aspect="AspectFit"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        HorizontalOptions="CenterAndExpand"
                                        Source="information.png"/>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                            HorizontalOptions="StartAndExpand"
                                            FontSize="12" FontFamily="{StaticResource SomarBold}"
                                            TextColor="#14395B"
                                            Text="{x:Static ResourceManager:AppResources.Disclaimer}">
                                    </custom:CustomLabel>
                               <!--  Question Hint Label  -->
                             <custom:CustomLabel Grid.Row="1" Grid.Column="1"
                                            HorizontalOptions="StartAndExpand"
                                            FontSize="12"
                                            TextColor="Gray"
                                            Text="{x:Static ResourceManager:AppResources.FeesCalcDisclaimerTXt}">
                                    </custom:CustomLabel>
                        </Grid>
                                </StackLayout>
                            </Frame>
                            <!--#endregion-->

                <!--#region Material Selection-->
                       <!--  TypeItem Field  -->
                                    <StackLayout Spacing="0">

                                        <!--  TypeItem Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.Thetypeofmerchandise}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  TypeItem Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry

                                    InputTransparent="True"
                                                IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedCalcTypeName}"
                                    TextColor="#58595B">
                                                <custom:BorderlessEntry.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                                                </custom:BorderlessEntry.GestureRecognizers>
                                            </custom:BorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>

                <!--#endregion-->
                                            <!--#region TProductView-->
                                <StackLayout VerticalOptions="StartAndExpand" IsVisible="false">
                                   <StackLayout.Triggers>
                        <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedCalcType}" Value="2">
                            <Setter Property="IsVisible" Value="true"></Setter>
                        </DataTrigger>

                    </StackLayout.Triggers>
                             
                                    <!--  ProductName Field  -->
                                    <StackLayout Spacing="0" IsVisible="{Binding IsProductItemHaveSubType}">

                                        <!--  ProductName Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.Selecttheitem}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  ProductName Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry
                                    InputTransparent="True"
                                                IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedProductSubTypes.Name}"
                                    TextColor="#58595B">
                                                <custom:BorderlessEntry.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                                </custom:BorderlessEntry.GestureRecognizers>
                                            </custom:BorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>

                                    <!--  Quantity Field  -->
                                    <StackLayout Spacing="0" IsVisible="false">

                                        <!--  Quantity Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.Quantity}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  Quantity Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                            HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry

                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding Quantity}"
                                    TextColor="#58595B" >
                                            <custom:BorderlessEntry.Behaviors>
                                                <behaviour:OnlyNumericValuesBehaviour/>
                                            </custom:BorderlessEntry.Behaviors>

                                        </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>

                                    </StackLayout>
                           <!--#region units View-->
                                <!--  unit Label  -->
                                <StackLayout IsVisible="false">
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.units}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                    <custom:BorderlessEntry

                                    InputTransparent="True"
                                        IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedUnit.Name}"
                                    TextColor="#58595B">
                                        <custom:BorderlessEntry.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                                        </custom:BorderlessEntry.GestureRecognizers>
                                    </custom:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image Aspect="AspectFit" Source="greyDropDown" />
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                               <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenUnitsCommand}" />
                                        </StackLayout.GestureRecognizers>
                                </StackLayout>
                                <!--#endregion-->
                                    <!--  Value Field  -->
                                    <StackLayout Spacing="0">

                                        <!--  Quantity Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.Productvalue}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  Total Value Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside" 
                                            HelperText="{x:Static ResourceManager:AppResources.ProductValueHint}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry

                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.Productvalue}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding TotalValue}"
                                    TextColor="#58595B" >
                                            <custom:BorderlessEntry.Behaviors>
                                                <behaviour:OnlyNumericWithDecimalValuesBehaviour/>
                                            </custom:BorderlessEntry.Behaviors>
                                        </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                            <Label IsVisible="false" Text="{x:Static ResourceManager:AppResources.NumberHint}" FontSize="12" Margin="16,0,16,0" TextColor="#58595B" ></Label>
                                    </StackLayout>

                                </StackLayout>
                                <!--#endregion-->

                <!--#region TobacoView-->
                <controls1:TobacoView IsVisible="false">
                             <controls1:TobacoView.Triggers>
                        <DataTrigger TargetType="controls1:TobacoView" Binding="{Binding SelectedCalcType}" Value="1">
                            <Setter Property="IsVisible" Value="true"></Setter>
                        </DataTrigger>

                    </controls1:TobacoView.Triggers>

                    </controls1:TobacoView>
                <!--#region-->
                <Frame CornerRadius="14"  Margin="0,40,0,0" Padding="10" BackgroundColor="#0996D4">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CalculateCommand}"></TapGestureRecognizer>
                    </Frame.GestureRecognizers>
                    <Label FontSize="16" HorizontalOptions="CenterAndExpand" TextColor="White" Text="{x:Static ResourceManager:AppResources.Calculate}">
                          <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CalculateCommand}"></TapGestureRecognizer>
                    </Label.GestureRecognizers>

                    </Label>
                </Frame>
            </StackLayout>
          </ScrollView>  <Grid Grid.Row="0" IsVisible="{Binding IsshowFeesView}">
      <StackLayout VerticalOptions="Start" >
                                <Label  TextColor="#14395B"  FontFamily="{StaticResource SomarBold}"  FontSize="16" Text="{x:Static ResourceManager:AppResources.CustomsFeesValue}"></Label>
                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="7"
                                WidthRequest="20"
                                BackgroundColor="#EBEBEB"
                                HeightRequest="1" />
                <!--#region Fees Details-->
                    <!--  Fees Details frame  -->
                <Frame Padding="10" 
                               BorderColor="#E6E6E6"
                               VerticalOptions="FillAndExpand"
                               HorizontalOptions="FillAndExpand"
                               CornerRadius="10">

                    <StackLayout>
                          <Label Margin="20" TextColor="#14395B" FontFamily="{StaticResource SomarBold}"  FontSize="16" Text="{Binding SelectedCalcTypeName}"></Label>
                             <BoxView
                                Grid.Column="7"
                                WidthRequest="20"
                                BackgroundColor="#EBEBEB"
                                HeightRequest="1" />
                            <Grid
                                                        Margin="16"
                                                        ColumnDefinitions="*,*"
                                                        RowDefinitions="auto,auto,auto,auto,auto">
                                  <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="0">
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Productvalue}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}">
                                              <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding FeesCalculatorResponse.productFinalPrice}" />
                                                                        <Span Text=" " />
                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>

                                </Label>

                                                        </StackLayout>
                                                        <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0">
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.CustomsFees}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}">
                                              <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding FeesCalculatorResponse.totalDuty}" />
                                                                        <Span Text=" " />
                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>

                                </Label>

                                                        </StackLayout>
                                                        <StackLayout Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0">
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.Customsdeclarationissuancefees}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}" >
                                    <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding FeesCalculatorResponse.extraFees}" />
                                                                        <Span Text=" " />
                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                    </Label>

                                                        </StackLayout>
                                                                                        <StackLayout IsVisible="false" Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0">
                                                                 <StackLayout.Triggers>
                        <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedCalcType}" Value="1">
                            <Setter Property="IsVisible" Value="true"></Setter>
                        </DataTrigger>

                    </StackLayout.Triggers>
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ExciseTax2}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}" >
                                    <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding FeesCalculatorResponse.excise}" />
                                                                        <Span Text=" " />
                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                    </Label>

                                                        </StackLayout>
                                <StackLayout
                                                            Grid.Row="4"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2">
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.VATCertificates}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding FeesCalculatorResponse.vat}" />
                                                                        <Span Text=" " />
                                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                        </StackLayout>
                                                    </Grid>
                               <Grid Margin="5" VerticalOptions="EndAndExpand">
                                        <Frame
                                            Margin="-16"
                                            BackgroundColor="#0996D4"
                                            CornerRadius="8"
                                            HasShadow="False"
                                            HorizontalOptions="FillAndExpand"
                                            Opacity=".1" />
                                        <StackLayout Orientation="Horizontal" VerticalOptions="CenterAndExpand">
                                            <Label
                                                FontSize="20"
                                                Text="{x:Static ResourceManager:AppResources.Total2}"
                                                TextColor="#002447" />
                                            <Label HorizontalOptions="EndAndExpand" Style="{StaticResource BodyLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding FeesCalculatorResponse.totalPayment}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZSAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                    </Grid>

                    </StackLayout>
                </Frame>
                <!--#endregion-->

            </StackLayout></Grid>
                        <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet  Grid.Row="0" IsVisible="{Binding IsShowBottomSheet}" />
        </Grid>
</newdesign:BaseContentPage.PancakeView>
    </newdesign:BaseContentPage>

