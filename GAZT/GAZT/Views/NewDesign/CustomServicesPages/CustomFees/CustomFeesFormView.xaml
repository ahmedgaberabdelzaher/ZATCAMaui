<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
        xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
     xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign" HasBackButton="True"
         xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:behaviour="clr-namespace:GAZT.CustomControl"
      TitleText="{x:Static ResourceManager:AppResources.CustomFeesCalculator}"
    x:Class="EGAZT.Views.NewDesign.CustomServicesPages.CustomFees.CustomFeesFormView">
    <newdesign:BaseContentPage.PancakeView>
        <Grid VerticalOptions="Fill" >
       <StackLayout Grid.Row="0" IsVisible="false">
                <Label  TextColor="#14395B" FontFamily="{StaticResource SomarBold}"  FontSize="16" Text="{x:Static ResourceManager:AppResources.CustomFeesCalculator}"></Label>
               <!--#region Hint view-->
                            <Frame Padding="10" 
                               BorderColor="#E6E6E6"
                               VerticalOptions="FillAndExpand"
                               HorizontalOptions="FillAndExpand"
                               CornerRadius="10">
                                <StackLayout 
                                    VerticalOptions="FillAndExpand"
                                    HorizontalOptions="StartAndExpand"
                                    Spacing="10">
                        <Grid RowDefinitions="auto,auto" ColumnDefinitions="auto,auto">
                                    <!--info icon-->
                                    <Image Grid.Row="0" Grid.Column="0"  Aspect="AspectFit"
                                        VerticalOptions="StartAndExpand"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        HorizontalOptions="CenterAndExpand"
                                        Source="information.png"/>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1"
                                            HorizontalOptions="StartAndExpand"
                                            FontSize="12" FontFamily="{StaticResource SomarBold}"
                                            TextColor="#14395B"
                                            Text="{x:Static ResourceManager:AppResources.Disclaimer}">
                                    </custom:CustomLabel>
                               <!--  Question Hint Label  -->
                             <custom:CustomLabel Grid.Row="1" Grid.Column="1"
                                            HorizontalOptions="StartAndExpand"
                                            FontSize="12"
                                            TextColor="Gray"
                                            Text="{x:Static ResourceManager:AppResources.FeesCalcDisclaimerTXt}">
                                    </custom:CustomLabel>
                        </Grid>
                                </StackLayout>
                            </Frame>
                            <!--#endregion-->

                                            <!--#region TProductView-->
                                <StackLayout>
                                   
                                    <!--  TypeItem Field  -->
                                    <StackLayout Spacing="0">

                                        <!--  TypeItem Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.TypeItem}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  TypeItem Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry

                                    InputTransparent="True"
                                                IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedProductTypes.Name}"
                                    TextColor="#58595B">
                                                <custom:BorderlessEntry.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                                                </custom:BorderlessEntry.GestureRecognizers>
                                            </custom:BorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenPoductTypesCommand}" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>

                                    <!--  ProductName Field  -->
                                    <StackLayout Spacing="0" IsVisible="{Binding IsProductItemHaveSubType}">

                                        <!--  ProductName Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.ProductName}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  ProductName Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry
                                    InputTransparent="True"
                                                IsReadOnly="True"
                                    Keyboard="Text"
                                    Placeholder="{x:Static ResourceManager:AppResources.Select}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding SelectedProductSubTypes.Name}"
                                    TextColor="#58595B">
                                                <custom:BorderlessEntry.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                                </custom:BorderlessEntry.GestureRecognizers>
                                            </custom:BorderlessEntry>
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <Image Aspect="AspectFit" Source="greyDropDown" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenProductSubTypesCommand}" />
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>

                                    <!--  Quantity Field  -->
                                    <StackLayout Spacing="0">

                                        <!--  Quantity Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.Quantity}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  Quantity Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                            HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry

                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.Quantity}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding Quantity}"
                                    TextColor="#58595B" >
                                            <custom:BorderlessEntry.Behaviors>
                                                <behaviour:OnlyNumericValuesBehaviour/>
                                            </custom:BorderlessEntry.Behaviors>

                                        </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>

                                    </StackLayout>

                                    <!--  Quantity Field  -->
                                    <StackLayout Spacing="0">

                                        <!--  Quantity Label  -->
                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.TotalPriceValue}"/>
                                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorSpan}" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>

                                        <!--  Total Value Entry  -->
                                        <inputLayout:SfTextInputLayout
                                ContainerBackgroundColor="White"
                                ContainerType="Outlined"
                                ErrorColor="#B00020"
                                FocusedColor="{StaticResource NeutralGreay}"
                                InputViewPadding="16,0,16,0"
                                LeadingViewPosition="Inside"
                                            HelperText="{x:Static ResourceManager:AppResources.NumberHint}"
                                OutlineCornerRadius="15"
                                UnfocusedColor="{StaticResource NeutralGreay}">
                                            <custom:BorderlessEntry

                                    Keyboard="Numeric"
                                    Placeholder="{x:Static ResourceManager:AppResources.TotalPriceValue}"
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding TotalValue}"
                                    TextColor="#58595B" >
                                            <custom:BorderlessEntry.Behaviors>
                                                <behaviour:OnlyNumericWithDecimalValuesBehaviour/>
                                            </custom:BorderlessEntry.Behaviors>
                                        </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>

                                    </StackLayout>
                                </StackLayout>
                                <!--#endregion-->
                <Frame CornerRadius="14" Margin="0,40,0,0" Padding="10" BackgroundColor="#0996D4">
                    <Label FontSize="16" HorizontalOptions="CenterAndExpand" TextColor="White" Text="{x:Static ResourceManager:AppResources.CalculateTheAmount}"></Label>
                </Frame>
        </StackLayout>
            <StackLayout>
                                <Label  TextColor="#14395B" FontFamily="{StaticResource SomarBold}"  FontSize="16" Text="{x:Static ResourceManager:AppResources.FeeCost}"></Label>
                            <!--  Horizontal Line  -->
                            <BoxView
                                Grid.Column="7"
                                WidthRequest="20"
                                BackgroundColor="#EBEBEB"
                                HeightRequest="1" />
                <!--#region Fees Details-->
                    <!--  Fees Details frame  -->
                <Frame Padding="10" 
                               BorderColor="#E6E6E6"
                               VerticalOptions="FillAndExpand"
                               HorizontalOptions="FillAndExpand"
                               CornerRadius="10">

                    <StackLayout>
                            <Grid
                                                        Margin="16"
                                                        ColumnDefinitions="*,*"
                                                        RowDefinitions="auto,auto">
                                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.FeeType}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding aid_type}" />

                                                        </StackLayout>
                                                        <StackLayout Grid.Row="0" Grid.Column="1">
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.FeeDescription}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}" Text="{Binding acct_desc}" />

                                                        </StackLayout>
                                                        <StackLayout
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2">
                                                            <Label Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.FeeCost}" />
                                                            <Label Style="{StaticResource BodyLabelBlack}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding amt}" />
                                                                        <Span Text=" " />
                                                                        <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                        </StackLayout>
                                                    </Grid>
                               <Grid Margin="5" VerticalOptions="EndAndExpand">
                                        <Frame
                                            Margin="-16"
                                            BackgroundColor="#0996D4"
                                            CornerRadius="8"
                                            HasShadow="False"
                                            HorizontalOptions="FillAndExpand"
                                            Opacity=".1" />
                                        <StackLayout Orientation="Horizontal" VerticalOptions="CenterAndExpand">
                                            <Label
                                                FontSize="20"
                                                Text="{x:Static ResourceManager:AppResources.Total}"
                                                TextColor="#002447" />
                                            <Label HorizontalOptions="EndAndExpand" Style="{StaticResource BodyLabelBlack}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TotalFees}" />
                                                        <Span Text=" " />
                                                        <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </StackLayout>
                                    </Grid>

                    </StackLayout>
                </Frame>
                <!--#endregion-->

            </StackLayout>
                        <!--  Bottom Sheet List  -->
            <controls:ListBottomSheet Grid.RowSpan="2"  Grid.Row="0" IsVisible="{Binding IsShowBottomSheet}" />

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />
        </Grid>
</newdesign:BaseContentPage.PancakeView>
    </newdesign:BaseContentPage>

