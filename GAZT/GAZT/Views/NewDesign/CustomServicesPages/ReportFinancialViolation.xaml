<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
        FlowDirection="{Binding AppDirection}"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:system="clr-namespace:System;assembly=netstandard"
           xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:syncfusion="http://schemas.syncfusion.com/xamarin" xmlns:control="clr-namespace:GAZTeServicesApp.Controls" xmlns:customcontrol="clr-namespace:GAZT.CustomControl" xmlns:custom="clr-namespace:GAZT" xmlns:converter="clr-namespace:EGAZT.Converters"
             ios:Page.UseSafeArea="true" x:Name="TraiffPage"
             BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:xct="http://xamarin.com/schemas/2020/toolkit" xmlns:controls="clr-namespace:EGAZT.Controls"
    x:Class="EGAZT.Views.NewDesign.CustomServicesPages.ReportFinancialViolation">
        <ContentPage.Resources>
        <ResourceDictionary>
           <converter:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                     <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                          <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>          
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
              <xct:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadIntialLookupsCommand}" >

        </xct:EventToCommandBehavior>
        </ContentPage.Behaviors>
   <Grid>
        <Grid.Resources>
                    <ResourceDictionary>
                        <Style TargetType="Label" x:Key="titleLabel">
                            <Setter Property="FontSize" Value="24"></Setter>
                            <Setter Property="TextColor" Value="{StaticResource Primary}"></Setter>
                            <Setter Property="FontFamily" Value="{StaticResource SomarRegular}"></Setter>
                        </Style>
                          <Style TargetType="Label">
                            <Setter Property="FontFamily" Value="{StaticResource SomarRegular}"></Setter>
                        </Style>
                    </ResourceDictionary>
                </Grid.Resources>
                <StackLayout IsVisible="{Binding IsMainView}" >
                    <StackLayout Orientation="Horizontal"  Padding="15,5,15,5">
                        
                        
                         <Image HeightRequest="25" WidthRequest="25" Grid.Row="0" Rotation="180" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start"
                               Source="GrayBackButton" x:Name="Image_BacKIcon"  >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}"/>
                            </Image.GestureRecognizers>
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsArabicLang}" Value="False">
                                    <Setter Property="Rotation" Value="0"></Setter>
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>

                        <Label Grid.Column="1" Grid.Row="0"  Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}"  MaxLines="1"  Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="CenterAndExpand"/>

                                           </StackLayout>
                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,0" BackgroundColor="White">


                            <ScrollView VerticalScrollBarVisibility="Never">
<StackLayout Margin="24,34,21,5">
            <Label Style="{x:StaticResource titleLabel}" Text="{x:Static ResourceManager:AppResources.Submitanewreport}"  Margin="0,34,0,5"></Label>
            <Label Text="{x:Static ResourceManager:AppResources.SelectTheOptionAndCompleteDetails}" FontSize="16"  TextColor="#999999"></Label>
            <BoxView HeightRequest="1" Color="#EBEBEB"></BoxView>
    <Frame CornerRadius="14" HasShadow="False" BorderColor="#EBEBEB">
        <Grid ColumnDefinitions="auto,*" RowDefinitions="auto,*">
            <Label TextColor="#999999" Grid.Row="0" Grid.RowSpan="2" FontSize="12" VerticalTextAlignment="Center" VerticalOptions="StartAndExpand" Grid.Column="1">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="• " FontSize="25" TextColor="Black"></Span>
                        <Span Text="{x:Static ResourceManager:AppResources.BalaghHintFthLne}"></Span>
                         <Span Text="{x:Static system:Environment.NewLine}"/>
                        <Span Text="•" FontSize="24" TextColor="Black"></Span>
                        <Span Text="{x:Static ResourceManager:AppResources.BalaghHintSecLne}"></Span>
                        <Span Text="{x:Static system:Environment.NewLine}"/>
                        <Span Text="•" FontSize="24" TextColor="Black"></Span>
                        <Span Text="{x:Static ResourceManager:AppResources.BalaghHintThrdLne}"></Span>
                        <Span Text="{x:Static system:Environment.NewLine}"/>
                        <Span Text="•" FontSize="24" TextColor="Black"></Span>
                        <Span Text="{x:Static ResourceManager:AppResources.BalaghHintFrthLne}"></Span>
                   
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Image HeightRequest="22" Grid.Row="0" WidthRequest="22" Source="InfoIcon" Grid.Column="0"></Image>
        </Grid>
    </Frame>
                        <StackLayout Margin="0,10,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NameForImprter}"/>
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                               LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0" >
                                    <control:BorderlessEntry Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding Name}" 
                                                         Placeholder="{x:Static ResourceManager:AppResources.NameForImprter}"
                                                     VerticalTextAlignment="Center" 
                                                      >
                                  

                                    </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                                </StackLayout>
                            <StackLayout Margin="0,9,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.PhoneNumber}"/>
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout HasError="{Binding PhoneHasError}" ErrorColor="Red" ErrorText="{x:Static ResourceManager:AppResources.PhoneNotCorrect}" Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                               LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0" >
                                    <control:BorderlessEntry Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding Phone}"  MaxLength="10" Keyboard="Numeric"
                                                         Placeholder="0xxxxxxxxx"
                                                     VerticalTextAlignment="Center" 
                                                      >
                                        <control:BorderlessEntry.Behaviors>
                                            <customcontrol:OnlyNumericValuesBehaviour/>
                                        </control:BorderlessEntry.Behaviors>

                                    </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                                </StackLayout>
                            <StackLayout Margin="0,9,0,0" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.Email}"/>
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout HasError="{Binding MailHasError}" ErrorColor="Red" ErrorText="{x:Static ResourceManager:AppResources.Mailnotcorrect}" Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                               LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0" >
                                    <control:BorderlessEntry Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding Mail}" Keyboard="Email"
                                                         Placeholder="{x:Static ResourceManager:AppResources.Email}"
                                                     VerticalTextAlignment="Center" 
                                                      >
                                   

                                    </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                                </StackLayout>
                                                                                 <StackLayout Margin="0,9,0,0">
               
                        <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ReportType}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                                            <Grid>
                                                               
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyleWuthoutHeighandWidth}" ContainerType="Outlined"
                                                         OutlineCornerRadius="14" UnfocusedColor="#B8BABA" 
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0">
                                <Grid>
                                <StackLayout Orientation="Horizontal">
                                    
                                <control:BorderlessEntry Style="{StaticResource DefaultEntryWithoutHeigh}" Placeholder="{x:Static ResourceManager:AppResources.ReportType}"
                                                                 
                                                         VerticalTextAlignment="Center" TextColor="{StaticResource NeutralBlack}" IsReadOnly="True" Text="{Binding SelectedBalaghType.Name}">
                                          
                                    </control:BorderlessEntry>
                                <Image Source="arrowDropdown.png" HorizontalOptions="EndAndExpand"></Image></StackLayout>
                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0">
                                        
  <StackLayout.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding SelectBalaghTypeCommand}"></TapGestureRecognizer>
                                                                </StackLayout.GestureRecognizers>
                                    </StackLayout>
                                </Grid> 
                                    </inputLayout:SfTextInputLayout>
                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding SelectBalaghTypeCommand}"></TapGestureRecognizer>
                                                                </Grid.GestureRecognizers>
                            </Grid>
                                <inputLayout:SfTextInputLayout IsVisible="{Binding IsBalaghTypeOOther}" HasError="{Binding BalaghOtherTypeTxtHasError}" ErrorColor="Red" ErrorText="{x:Static ResourceManager:AppResources.FieldRequired}" Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                               LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        OutlineCornerRadius="14"
                                                        InputViewPadding="16,0,16,0"  Margin="0,5,0,9" >
                                    <control:BorderlessEntry Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding BalaghTypeOtherTxt}"
                                                         Placeholder="{x:Static ResourceManager:AppResources.IndicateTheTypeOfReport}"
                                                     VerticalTextAlignment="Center" 
                                                      >
                                   

                                    </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

            </StackLayout>

                                                                             <StackLayout Margin="0,9,0,0">
               
                        <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ReportLocation}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                                            <Grid>
                                                               
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyleWuthoutHeighandWidth}" ContainerType="Outlined"
                                                         OutlineCornerRadius="14" UnfocusedColor="#B8BABA" 
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0">
                                <Grid>
                                <StackLayout Orientation="Horizontal">
                                    
                                <control:BorderlessEntry Style="{StaticResource DefaultEntryWithoutHeigh}" Placeholder="{x:Static ResourceManager:AppResources.ReportLocation}"
                                                                 
                                                         VerticalTextAlignment="Center" TextColor="{StaticResource NeutralBlack}" IsReadOnly="True" Text="{Binding SelectedPort.Name}">
                                          
                                    </control:BorderlessEntry>
                                <Image Source="arrowDropdown.png" HorizontalOptions="EndAndExpand"></Image></StackLayout>
                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0">
                                        
  <StackLayout.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding OpenPortsCommand}"></TapGestureRecognizer>
                                                                </StackLayout.GestureRecognizers>
                                    </StackLayout>
                                </Grid> 
                                    </inputLayout:SfTextInputLayout>
                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding OpenPortsCommand}"></TapGestureRecognizer>
                                                                </Grid.GestureRecognizers>
                            </Grid>

            </StackLayout>

                                <StackLayout Margin="0,9,0,0" HeightRequest="200" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ReportText}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                            <!--HasError="{Binding BalaghTxtHasError}"-->    <inputLayout:SfTextInputLayout   ErrorText="{x:Static ResourceManager:AppResources.FieldRequired}"  HeightRequest="137" ContainerType="Outlined" UnfocusedColor="#B1B1B1" OutlineCornerRadius="14" FocusedColor="{StaticResource Primary}" ErrorColor="#B00020">
                    <Editor VerticalOptions="FillAndExpand" HeightRequest="137"
                                       Text="{Binding Balaghtx}"
                                                HorizontalOptions="FillAndExpand"
                                                
                                                ></Editor>



            </inputLayout:SfTextInputLayout>

                                </StackLayout>
    <StackLayout Margin="0,10,0,10" Padding="0,10,0,10">
    <Label Text="{x:Static ResourceManager:AppResources.Attachment}" TextColor="#999999"></Label>
    <BoxView Color="#999999" HeightRequest=".8"></BoxView>
        <StackLayout x:Name="filesLst" BindableLayout.ItemsSource="{Binding TicketFiles}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="Item"  RowSpacing="0" Padding="0" Margin="0"  RowDefinitions="*,auto" ColumnDefinitions="auto,*,auto">
                        <Image Source="PDF" HeightRequest="24" WidthRequest="17" VerticalOptions="Start"  Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"></Image>
                        <Label Text="{Binding filename}" TextColor="#232323"  VerticalOptions="CenterAndExpand" FontSize="16" Grid.Row="0" Grid.Column="1"></Label>
                          <Label TextColor="#999999" FontSize="8" Grid.Row="1" Grid.Column="1">
                              <Label.FormattedText>
                                  <FormattedString>
                                            <Span Text="{Binding FileSize}"/>
                                      <Span Text=" "></Span>
                                            <Span  Text="{x:Static ResourceManager:AppResources.MB}" />
                                        </FormattedString>
                              </Label.FormattedText>
                          </Label>
                        <Grid HeightRequest="24" WidthRequest="24" RowSpacing="0" Margin="0" Padding="0" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2">
                             <Grid.GestureRecognizers>
                                <TapGestureRecognizer BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"   Command="{Binding DeleteAttatchementCommand}"  CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}"></TapGestureRecognizer>
                            </Grid.GestureRecognizers>
                            <Image Source="Ellipse" HeightRequest="24" WidthRequest="24"></Image>
                            <Image Source="cancel" Margin="8" HeightRequest="9" WidthRequest="9"></Image>
                        </Grid>
                        <Image IsVisible="false" HeightRequest="24" WidthRequest="24" Source="AddNew" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer BindingContext="{Binding Source={x:Reference filesLst}, Path=BindingContext}"   Command="{Binding DeleteAttatchementCommand}"  CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}"></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </StackLayout>
        <Frame HasShadow="False" Margin="0,30,0,34" Padding="12"  CornerRadius="14"  BorderColor="#0996D4" BackgroundColor="White">
        <Frame.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding UploadFileCommand}"></TapGestureRecognizer>
        </Frame.GestureRecognizers>
            <StackLayout Orientation="Horizontal">
                <Image Source="AddNew" HeightRequest="34" WidthRequest="34" Margin="0,0,7,0"></Image>
                <Label Text="{x:Static ResourceManager:AppResources.Addattachments}"  TextColor="{StaticResource PrimaryColor}"  VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"></Label>

            </StackLayout>
</Frame>

        <StackLayout Orientation="Horizontal">
            <Image Source="UncheckedCheckBox" HeightRequest="25" WidthRequest="25">
                  <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PolicyCheckedCommand}"></TapGestureRecognizer>
                </Image.GestureRecognizers>
                <Image.Triggers>
                    <DataTrigger TargetType="Image" Binding="{Binding IsPolicyChecked}" Value="true">
                        <Setter Property="Source" Value="CheckedCheckbox"></Setter>
                    </DataTrigger>
                </Image.Triggers>
            </Image>
            <Label VerticalOptions="CenterAndExpand"  Text="{x:Static ResourceManager:AppResources.BalaghPolicytxt}" TextColor="{StaticResource PrimaryColor}"  TextDecorations="Underline" FontSize="12">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewPrivacyandPolicyCommand}"></TapGestureRecognizer>
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>

        <Frame HasShadow="False" Margin="0,34,0,15" Padding="12" BackgroundColor="#0996D4" HorizontalOptions="FillAndExpand" CornerRadius="14">
             <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SendTicketCommand}"></TapGestureRecognizer>
                </Frame.GestureRecognizers>
            <Label FontSize="16" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" TextColor="White" Text="{x:Static ResourceManager:AppResources.Send}"></Label>
        </Frame>
        <Label Text="{x:Static ResourceManager:AppResources.CancelText}" TextColor="#0996D4" HorizontalOptions="CenterAndExpand"  FontSize="16">
 <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClearCommand}"></TapGestureRecognizer>
                </Label.GestureRecognizers>
        </Label>
    </StackLayout>

</StackLayout>
                            </ScrollView>

                        </Grid>
                    </yummy:PancakeView>

                </StackLayout>
       <StackLayout IsVisible="{Binding IsShowSuccessView}"><!--"{Binding IsShowSuccessView}"-->
           <Image Source="Success" HeightRequest="120" WidthRequest="120"  HorizontalOptions="CenterAndExpand" Margin="0,137,0,50"></Image>
           <Label Text="{x:Static ResourceManager:AppResources.Reportsubmittedsuccessfully}" Margin="10,0,10,0" FontFamily="{StaticResource SomarSemiBold}" HorizontalOptions="CenterAndExpand" TextColor="White" FontSize="28"></Label>
           <Label Text="{x:Static ResourceManager:AppResources.ReportSentSuccess}" TextColor="White" FontSize="16" HorizontalOptions="CenterAndExpand"></Label>

           <yummy:PancakeView VerticalOptions="EndAndExpand" CornerRadius="14,14,0,0" BackgroundColor="White" Padding="24,38,24,38">

                <StackLayout>
                   <Grid>

                   <Frame HasShadow="False" BorderColor="#0996D4" BackgroundColor="#0996D4" Opacity=".1" CornerRadius="14">
                       
                   </Frame>
                                                                 <Frame HasShadow="False" BorderColor="#0996D4" BackgroundColor="Transparent" CornerRadius="14">
<Grid RowSpacing="10" ColumnSpacing="5" RowDefinitions="*,*" ColumnDefinitions="auto,*">
                       <Label Text="{x:Static ResourceManager:AppResources.ReportSendingDate}" TextColor="#002447" Grid.Row="0" Grid.Column="0"></Label>
                       <Label Text="{x:Static ResourceManager:AppResources.Thereportnumber}" Grid.Row="1" TextColor="#002447" Grid.Column="0"></Label>
                           <Label Text="{Binding DateTime,StringFormat='{0:dd-MM-yyyy}'}" HorizontalOptions="EndAndExpand"  TextColor="#002447" Grid.Row="0" Grid.Column="1"></Label>
                               <Label Text="{Binding BalaghNoTxt}" HorizontalOptions="EndAndExpand" TextColor="#002447" Grid.Row="1" Grid.Column="1"></Label>

                       </Grid>
</Frame>
                   </Grid>
                    <Frame HasShadow="False" Margin="0,37,0,0" Padding="12" BackgroundColor="#0996D4" HorizontalOptions="FillAndExpand" CornerRadius="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}"></TapGestureRecognizer>
                        </Frame.GestureRecognizers>
                        <Label FontSize="16" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" TextColor="White" Text="{x:Static ResourceManager:AppResources.Backtomainmenu}"></Label>
        </Frame>
               </StackLayout>
           </yummy:PancakeView>
       </StackLayout>
                            <controls:PickerWithSearch IsVisible="{Binding IsPortsPickerSearch}"></controls:PickerWithSearch>
            <controls:MsgView Grid.Row="0" VerticalOptions="FillAndExpand" IsVisible="{Binding IsShowMsgView}"  Margin="0,0,0,0"></controls:MsgView>

       <controls:Loader IsVisible="{Binding IsLoading}"></controls:Loader>

       </Grid>
</ContentPage>
