<?xml version="1.0" encoding="UTF-8" ?>
<ViewCell
    x:Class="EGAZT.Views.NewDesign.Template.UnSelectedItemTemplateNoIcon"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:custom="clr-namespace:GAZT">
    <ViewCell.View>
        <Grid Padding="4">
            <cards:SfCardView
                BackgroundColor="Transparent"
                CornerRadius="20"
                HasShadow="False"
                HeightRequest="104"
                WidthRequest="171">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Aspect="Fill"
                        HorizontalOptions="FillAndExpand"
                        Source="unselected171x136"
                        VerticalOptions="FillAndExpand" />
                    <StackLayout
                        HorizontalOptions="FillAndExpand"
                        Style="{DynamicResource CardParentStacklayout}"
                        VerticalOptions="End">
                        <custom:CustomLabel
                            FontSize="Small"
                            Style="{DynamicResource CardLabelBlack}"
                            Text="{Binding CardLabel}" />
                    </StackLayout>
                </Grid>
            </cards:SfCardView>
        </Grid>
    </ViewCell.View>
</ViewCell>