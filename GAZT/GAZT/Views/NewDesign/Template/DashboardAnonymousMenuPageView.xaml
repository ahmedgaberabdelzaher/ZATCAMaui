<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             mc:Ignorable="d"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             NavigationPage.HasNavigationBar="False"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.Template.DashboardAnonymousMenuPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="ShadowLvl0">#EFEFEF</Color>
            <Color x:Key="ShadowLvl1">#232323</Color>
            <Color x:Key="ShadowLvl2">#232323</Color>
            <Style x:Key="GreyBorderFrameWithShadow" TargetType="border:SfBorder">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="BorderColor" Value="{StaticResource NeutralLightGrey}" />
                <Setter Property="ShadowColor" Value="{StaticResource ShadowLvl0}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>

            <Image Aspect="AspectFill" Margin="0,-50,0,0" x:Name="BGImageLogin" Source="partials_background.png" />
            <Grid x:Name="OldMenu">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="50*" />
                    <RowDefinition Height="20*" />
                    <RowDefinition Height="20*" />
                </Grid.RowDefinitions>
                <StackLayout Grid.Row="0" Orientation="Horizontal" Padding="10,30,10,0" Spacing="10">
                    <Image Source="ic_Gazt.png" WidthRequest="40" HeightRequest="40" VerticalOptions="Start" HorizontalOptions="Start"/>

                    <Image Source="close" VerticalOptions="Center" HorizontalOptions="EndAndExpand">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="GoBackTapped" NumberOfTapsRequired="1"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <StackLayout.Margin>
                        <OnPlatform x:TypeArguments="Thickness">
                            <On Platform="iOS" Value="0,20,0,0"/>
                            <On Platform="Android" Value="0,0,0,0"/>
                        </OnPlatform>
                    </StackLayout.Margin>
                </StackLayout>
                <Grid Grid.Row="1" Padding="15,15,0,0">
                    <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDServices}" Style="{StaticResource SectionTitleWhiteBold}" FontSize="24" VerticalOptions="Center" />-->
                    <ScrollView Margin="0,20,0,0">
                        <StackLayout Spacing="20" Padding="0,0,0,10">
                            <StackLayout Spacing="5">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDServices}" Style="{StaticResource PageTitleWhite}" VerticalOptions="Center" HorizontalTextAlignment="Start"/>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelWhite}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.NDV}"/>
                                            <Span Text="&#160;&#160;"/>
                                            <Span  Text="{Binding AppVersion}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </custom:CustomLabel>
                                <BoxView Style="{StaticResource WhiteLineSeperator}"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="20">
                                <Image Source="password_key.png" Style="{StaticResource SmallIcon}"/>


                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDVATRegistrationVerification}" Style="{StaticResource ValueLabelWhiteBold}" VerticalOptions="Center"/>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVATRefundTapped" NumberOfTapsRequired="1"/>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>

                            <BoxView Style="{StaticResource WhiteLineSeperator}"/>


                            <StackLayout Orientation="Horizontal" Spacing="20">
                                <Image Source="taxEvasion.png" Style="{StaticResource SmallIcon}"/>


                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDTaxEvasionReport}" Style="{StaticResource ValueLabelWhiteBold}" VerticalOptions="Center"/>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTaxEvasionTapped" NumberOfTapsRequired="1"/>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>

                            <BoxView Style="{StaticResource WhiteLineSeperator}"/>

                            <StackLayout Orientation="Horizontal" Spacing="20">
                                <Image Source="customerService" Style="{StaticResource SmallIcon}"/>


                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZSupport}" Style="{StaticResource ValueLabelWhiteBold}" VerticalOptions="Center" />
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSupportTapped" NumberOfTapsRequired="1"/>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                            <BoxView Style="{StaticResource WhiteLineSeperator}"/>
                        </StackLayout>
                    </ScrollView>
                </Grid>
                <Grid VerticalOptions="EndAndExpand" Grid.Row="3" Margin="0,0,0,57" RowSpacing="0" HeightRequest="73">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="60*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <BoxView Style="{StaticResource WhiteLineSeperator}" HeightRequest="1" Grid.Row="0" Grid.ColumnSpan="3" Grid.Column="0"/>
                    <StackLayout Orientation="Horizontal"  Grid.Row="1"  Grid.Column="0" Spacing="20" HorizontalOptions="Start" Padding="20,0,20,0">
                        <Image Source="language" HorizontalOptions="Start" Style="{StaticResource SmallIcon}"/>
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZChangetoLanguage}" Style="{StaticResource ValueLabelWhiteBold}" 
                                                    VerticalOptions="Center" HorizontalTextAlignment="Start"/>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ChangeLanguage_Tapped" NumberOfTapsRequired="1"/>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    <BoxView Style="{StaticResource VerticalWhiteLineSeperator}" WidthRequest="1" Grid.Row="1" Grid.Column="1"/>
                    <StackLayout Orientation="Horizontal" Spacing="20" Grid.Row="1" Grid.Column="2" HorizontalOptions="StartAndExpand" Padding="20,0,20,0">
                        <Image Source="user_profile" HorizontalOptions="StartAndExpand" Style="{StaticResource SmallIcon}"/>
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDSwitchUser}" Style="{StaticResource ValueLabelWhiteBold}" VerticalOptions="Center"
                                                    HorizontalTextAlignment="Start"/>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SwitchUser_Tapped" NumberOfTapsRequired="1"/>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                    <BoxView Style="{StaticResource WhiteLineSeperator}" HeightRequest="1" Grid.Row="2" Grid.ColumnSpan="3" Grid.Column="0"/>
                </Grid>
                <Grid Grid.Row="0" Grid.RowSpan="3"  IsVisible="{Binding IsLoading}" Margin="0,-20,0,0">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#D99A29"/>
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>