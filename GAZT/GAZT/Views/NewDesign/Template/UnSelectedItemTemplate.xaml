        <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="136" WidthRequest="171">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                <StackLayout Style="{DynamicResource CardParentStacklayout}" Grid.Row="2">
                    <Image Style="{DynamicResource CardIcon}" Source="{Binding UnSelectedCardIcon}" IsVisible="{Binding IsUnSelectedCardIconVisible}" />
                    <Label Text="{Binding CardLabel}" Style="{DynamicResource CardLabelBlack}" LineHeight="0.8"/>
                </StackLayout>
            </Grid>
        </cards:SfCardView>
    </ViewCell.View>
</ViewCell>