<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             BackgroundImageSource="partials_background"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:models="clr-namespace:EGAZT.Models"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             NavigationPage.HasNavigationBar="False"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             x:Class="EGAZT.Views.NewDesign.ZakatForm5.ZakatForm5PageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ZakatForm5TabEnumToVisibilityConverter x:Key="enumToVisibilityConverter"/>
            <Style TargetType="buttons:SfButton" x:Key="BackgroundWhiteBtn">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="BorderColor" Value="{StaticResource NeutralLightGrey}"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="CornerRadius" Value="20"/>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="SelectionMode" Value="None"/>
            </Style>
            <Style TargetType="Image">
                <Setter Property="Margin" Value="0,5,0,0"/>

            </Style>
            <Style TargetType="buttons:SfButton" x:Name="SelectedBtn">
                <Setter Property="BackgroundColor" Value="AliceBlue"/>
                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                <Setter Property="BorderColor" Value="AliceBlue"/>
            </Style>
            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}"/>
                <Setter Property="CornerRadius" Value="{OnPlatform Android=50,iOS=22}"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="HeightRequest" Value="25"/>
                <Setter Property="WidthRequest" Value="25"/>
                <Setter Property="HasShadow" Value="False"/>

            </Style>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>


        <yummy:PancakeView Grid.Row="0" CornerRadius="15,15,0,0"  HasShadow="True" BackgroundColor="White">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>


                <!--Start Of Basic Information View-->
                <Grid Grid.Row="1" x:Name="BasicInformation" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:ZakatForm5TabEnum.BasicInformation}}" Padding="20,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                        <StackLayout>
                            <!--Start of Return Details-->
                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>

                                    <StackLayout Orientation="Horizontal" Padding="10">
                                        <Frame Style="{StaticResource circleFrame}">
                                            <Image Margin="0" Source="ic_vat_return.png">

                                            </Image>
                                        </Frame>
                                        <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}" Style="{StaticResource SectionTitleBlackBold}" VerticalTextAlignment="Center"/>
                                    </StackLayout>

                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                    <StackLayout Padding="10" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5Return}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5ZakatEstimation}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                        </StackLayout>
                                        <!--FORM5ZakatEstimation-->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40*"/>
                                                <ColumnDefinition Width="60*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.NDFinancialYear}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Column="1"  Text="{Binding FinancialYear}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </Grid>
                                        <StackLayout>
                                            <custom:CustomLabel x:Name="PeriodLbl" Text="{x:Static ResourceManager:AppResources.FORM5Period}" Style="{StaticResource ValueLabelGrey}"/>
                                            <!--<custom:CustomLabel Style="{StaticResource ValueLabelBlack}" FlowDirection="LeftToRight">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding ZakatFromDate}" />
                                                        <Span Text=" - "/>
                                                        <Span Text="{Binding ZakatToDate}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                                <custom:CustomLabel.Triggers>
                                                    <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding Source={x:Reference PeriodLbl}, Path=Text}" Value="Period">
                                                        <Setter Property="HorizontalOptions" Value="EndAndExpand"/>
                                                        <Setter Property="HorizontalTextAlignment" Value="End"/>
                                                    </DataTrigger>
                                                </custom:CustomLabel.Triggers>
                                            </custom:CustomLabel>-->

                                            <!--<custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding Period}" FlowDirection="LeftToRight" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"></custom:CustomLabel>-->


                                            <StackLayout  Orientation="Horizontal">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5From}" Style="{StaticResource ValueLabelGrey}"/>
                                                <!--<custom:CustomLabel Text=" " Style="{StaticResource ValueLabelBlack}"/>-->
                                                <!--<custom:CustomLabel Text="{Binding Taxpayer}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>-->
                                                <custom:CustomLabel Text="{Binding ZakatFromDate}" Style="{StaticResource ValueLabelBlack}"  HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                            </StackLayout>




                                            <StackLayout  Orientation="Horizontal">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5To}" Style="{StaticResource ValueLabelGrey}"/>
                                                <!--<custom:CustomLabel Text=" " Style="{StaticResource ValueLabelBlack}"/>-->
                                                <!--<custom:CustomLabel Text="{Binding Taxpayer}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>-->
                                                <custom:CustomLabel Text="{Binding ZakatToDate}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                            </StackLayout>


                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                            <!--End of Return Details-->
                            <!--Start of Taxpayer Details-->
                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Padding="10">
                                        <Frame Style="{StaticResource circleFrame}">
                                            <Image Margin="0" Source="vat_user">

                                            </Image>
                                        </Frame>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5TaxpayerDetails}" Style="{StaticResource SectionTitleBlackBold}" VerticalTextAlignment="Center"/>
                                    </StackLayout>

                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                    <StackLayout Padding="10" Spacing="10" >
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5Taxpayer}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding Taxpayer}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5Branch}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding Branch}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel x:Name="addressLbL" Text="{x:Static ResourceManager:AppResources.ZVatAddress}" Style="{StaticResource ValueLabelGrey}" WidthRequest="140"/>
                                            <custom:CustomLabel Text="{Binding Address}" Style="{StaticResource ValueLabelBlack}" FlowDirection="LeftToRight" StyleId="ValueLabel" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start">
                                                <custom:CustomLabel.Triggers>
                                                    <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding Source={x:Reference addressLbL}, Path=Text}" Value="Address">
                                                        <Setter Property="HorizontalOptions" Value="EndAndExpand"/>
                                                        <Setter Property="HorizontalTextAlignment" Value="End"/>
                                                    </DataTrigger>
                                                </custom:CustomLabel.Triggers>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEmail}" WidthRequest="100" Style="{StaticResource ValueLabelGrey}" />
                                            <custom:CustomLabel Text="{Binding UserEmail}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.MobileNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding MobileNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                            <!--End of Taxpayer Details-->
                            <!--Start of Registration Information-->
                            <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout>
                                    <StackLayout Orientation="Horizontal" Padding="10">
                                        <Frame Style="{StaticResource circleFrame}">
                                            <Image Margin="0" Source="ic_vat_bill">

                                            </Image>
                                        </Frame>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5RegistrationInfo}" Style="{StaticResource SectionTitleBlackBold}" VerticalTextAlignment="Center"/>
                                    </StackLayout>

                                    <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                    <StackLayout Padding="10" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5NoOutlet}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding NumberOfOutlet}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                        </StackLayout>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.FORM5ResidencyStatus}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Column="1" Text="{Binding Residency_Status}" Style="{StaticResource ValueLabelBlack}"  HorizontalTextAlignment="End" StyleId="ValueLabel"/>
                                        </Grid>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5MainOutlet}" Style="{StaticResource ValueLabelGrey}" WidthRequest="180"/>
                                            <custom:CustomLabel Text="{Binding MainOutlet}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End" StyleId="ValueLabel"/>
                                        </StackLayout>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.FORM5AccountingMethod}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding AccountMethod}" Style="{StaticResource ValueLabelBlack}" StyleId="ValueLabel" HorizontalOptions="EndAndExpand" />
                                        </Grid>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.FORM5FinancialPeriodEnd}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Grid.Column="1" Text="{Binding FinancialPeriod}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                        </Grid>
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5CalendarType}" Style="{StaticResource ValueLabelGrey}"/>
                                            <custom:CustomLabel Text="{Binding Calendar_Type}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                            <!--End of Registration Information-->
                            <!--   <StackLayout Orientation="Horizontal" Margin="0,0,0,15">
                                <CheckBox IsChecked="{Binding IsConditionRadio}" IsEnabled="False"/> 
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5IsCorrect}" StyleId="ValueLabel" Style="{StaticResource ValueLabelGrey}" />
                            </StackLayout>-->


                        </StackLayout>
                    </ScrollView>
                    <StackLayout Grid.Row="0" BackgroundColor="White">
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5BasicInformation}" Style="{StaticResource SectionTitleBlackBold}" />
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDReviewBelow}" Style="{StaticResource ValueLabelGrey}" />
                        <BoxView Style="{StaticResource lineSeperator}" Margin="0,0,0,10"/>
                    </StackLayout>
                </Grid>
                <!--End of Basic Information View-->

                <!--Start of Financial Information-->
                <Grid Grid.Row="1" x:Name="FinancialInformation" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:ZakatForm5TabEnum.FinancialInformation}}" Padding="20,0,20,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="1">

                        <StackLayout>
                            <!--On Cabs Clicked Starts-->
                            <StackLayout x:Name="Cabs" IsVisible="{Binding isCabVisible}">

                                <ListView  x:Name="CarList" 
           ItemsSource="{Binding Cabs}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
            VerticalScrollBarVisibility="Never"
            BackgroundColor="White"
                     SelectionMode="None"
            SeparatorVisibility="None"
            >
                                    <x:Arguments>
                                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                    </x:Arguments>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <!--Start of General taxi Office-->

                                                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                                    <StackLayout>
                                                        <StackLayout Orientation="Horizontal" Padding="10">
                                                            <Frame Style="{StaticResource circleFrame}">
                                                                <Image Margin="0" Source="ic_vat_bill">
                                                                </Image>
                                                            </Frame>
                                                            <!--   <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5GenTaxiOffice}" Style="{StaticResource SectionTitleBlack}"/> -->
                                                            <custom:CustomLabel Text="{Binding ActDesc}" Style="{StaticResource SectionTitleBlack}" VerticalTextAlignment="Center"/>
                                                        </StackLayout>

                                                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                                        <StackLayout Padding="10" Spacing="10">

                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5OutletName}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <custom:CustomLabel Text="{Binding ActDesc}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                                            </StackLayout>

                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5NumOfCars}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <custom:CustomLabel Text="{Binding NoOfCars}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal" Spacing="5">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5AvgDailyIncome}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <custom:CustomLabel WidthRequest="180" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" StyleId="ValueLabel">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding AgvDlyIncome}" />
                                                                            <Span Text=" "/>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5OccupancyRate}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <!--<Image Source="ic_vat_info">
                                                                    <Image.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnInfoTapped"/>
                                                                    </Image.GestureRecognizers>
                                                                </Image>-->
                                                                <custom:CustomLabel Text="{Binding OccRate, StringFormat='{0:F2} %'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5NetProfitPer}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <!--<Image Source="ic_vat_info">
                                                                </Image>-->
                                                                <custom:CustomLabel Text="{Binding NetPftPer, StringFormat='{0:F2} %'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand"/>
                                                            </StackLayout>

                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5Revenue}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <!--<custom:CustomLabel Text="{Binding Revenue, StringFormat='{0:F2} SAR'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">-->
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding Revenue}" />
                                                                            <Span Text=" "/>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>

                                                            <Grid RowSpacing="0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto"/>

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.FORM5Expenses}" Style="{StaticResource ValueLabelGrey}"/>
                                                                    <!--<Image Source="ic_vat_info" >

                                                                    </Image>-->
                                                                </StackLayout>

                                                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding IsApplicable}"  Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" StyleId="ValueLabel"/>
                                                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueLabelBlack}" IsVisible="{Binding IsApplicableVisible}" HorizontalTextAlignment="End" StyleId="ValueLabel">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding Expenses}" />
                                                                            <Span Text=" "/>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>

                                                            </Grid>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5NetProfit}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <!--<Image Source="ic_vat_info">

                                                                </Image>-->
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding NetPft}" />
                                                                            <Span Text=" "/>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>
                                                        </StackLayout>
                                                    </StackLayout>
                                                </border:SfBorder>
                                                <!--End of General taxi Office-->
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackLayout>
                            <!--On Cabs Clicked Ends-->

                            <!--On Professionals Clicked starts-->
                            <StackLayout x:Name="Professionals" IsVisible="{Binding isProfessionalVisible}">

                                <ListView  x:Name="ProfessionalsList" 
           ItemsSource="{Binding Professionals}"
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
             BackgroundColor="White"
             VerticalScrollBarVisibility="Never"
            SeparatorVisibility="None"
            >
                                    <x:Arguments>
                                        <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
                                    </x:Arguments>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <!--Start Of Land Travel Starts-->
                                                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                                                    <StackLayout>
                                                        <StackLayout Orientation="Horizontal" Padding="10">
                                                            <Frame Style="{StaticResource circleFrame}">
                                                                <Image Margin="0" Source="ic_vat_bill">
                                                                </Image>
                                                            </Frame>
                                                            <custom:CustomLabel Text="{Binding ActDesc}" Style="{StaticResource SectionTitleBlack}"/>
                                                        </StackLayout>

                                                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                                        <StackLayout Padding="10" Spacing="10">
                                                            <StackLayout  Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5OutletName}" Style="{StaticResource ValueLabelGrey}" WidthRequest="140"/>
                                                                <custom:CustomLabel Text="{Binding ActDesc}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End" StyleId="ValueLabel"/>
                                                            </StackLayout>
                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5Revenue}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding Revenue}" />
                                                                            <Span Text=" "/>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>

                                                            <Grid RowSpacing="0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="auto"/>

                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                                    <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.FORM5Expenses}" Style="{StaticResource ValueLabelGrey}"/>
                                                                    <!--<Image Source="ic_vat_info" >

                                                                    </Image>-->
                                                                </StackLayout>

                                                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="{Binding IsApplicable}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End" StyleId="ValueLabel"/>
                                                                <custom:CustomLabel Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueLabelBlack}" IsVisible="{Binding IsApplicableVisible}" HorizontalTextAlignment="End" StyleId="ValueLabel">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding Expenses}" />
                                                                            <Span Text=" "/>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>

                                                            </Grid>

                                                            <StackLayout Orientation="Horizontal">
                                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5NetProfit}" Style="{StaticResource ValueLabelGrey}"/>
                                                                <!--<Image Source="ic_vat_info">

                                                                </Image>-->
                                                                <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand">
                                                                    <Label.FormattedText>
                                                                        <FormattedString>
                                                                            <Span Text="{Binding NetPft}" />
                                                                            <Span Text=" "/>
                                                                            <Span Text="{x:Static ResourceManager:AppResources.ZSAR}"/>
                                                                        </FormattedString>
                                                                    </Label.FormattedText>
                                                                </custom:CustomLabel>
                                                            </StackLayout>

                                                        </StackLayout>
                                                    </StackLayout>
                                                </border:SfBorder>

                                                <!--End Of Land Travel-->
                                            </ViewCell>
