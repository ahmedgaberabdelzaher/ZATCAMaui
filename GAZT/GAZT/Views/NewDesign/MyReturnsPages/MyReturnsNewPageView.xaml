<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.MyReturnsNewPages.GAZTNewDesignMyReturnsNewPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.NDReturns}" />


                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="Start"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <yummy:PancakeView
                        Padding="0"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,15,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <StackLayout Grid.Row="0">

                <Grid Padding="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackLayout Grid.Row="0" Spacing="-5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontFamily="{StaticResource SomarBold}"
                                FontSize="28"
                                HorizontalOptions="StartAndExpand"
                                HorizontalTextAlignment="Start"
                                Text="{Binding FilterLabelText}"
                                TextColor="{StaticResource NeutralBlack}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_Clicked" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Image
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="Center"
                                Source="arrowDropdown"
                                VerticalOptions="Center">
                                <Image.Margin>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="iOS" Value="5,8,5,0" />
                                        <On Platform="Android" Value="5,10,5,0" />
                                    </OnPlatform>
                                </Image.Margin>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_Clicked" />
                                </Image.GestureRecognizers>
                            </Image>

                            <!--<syncfusion:SfPicker FlowDirection="RightToLeft"   x:Name="TaxTypePicker" HeaderHeight="55" HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="{StaticResource Primary}" BorderColor="Black" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType" ItemsSource="{Binding ReturnTypeForFilter}" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0"
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}" PickerWidth="300" HeaderFontSize="13" OKButtonTextColor="{StaticResource Primary}" CancelButtonTextColor="{StaticResource Primary}" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" SelectionChanged="TaxTypePicker_SelectionChanged">
                                <syncfusion:SfPicker.Behaviors>
                                    <customcontrol:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                            </syncfusion:SfPicker>-->
                        </Grid>

                        <ScrollView
                            Margin="0,12,0,12"
                            HorizontalOptions="StartAndExpand"
                            HorizontalScrollBarVisibility="Never"
                            Orientation="Horizontal">

                            <buttons:SfChipGroup
                                x:Name="ChipGroup_statusFilter"
                                ChipBackgroundColor="Transparent"
                                ItemsSource="{Binding ChipDataFilterlist}"
                                SelectionChanged="ChipGroup_statusFilter_SelectionChanged"
                                Style="{StaticResource ReturnsChipGroup}"
                                Type="Choice">
                                <buttons:SfChipGroup.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout Style="{StaticResource ChipParentLayout}">
                                            <Image Source="{Binding ImageSource}" Style="{StaticResource ChipIcon}" />
                                            <custom:CustomLabel
                                                Style="{StaticResource CaptionLabelBlack}"
                                                Text="{Binding Text}"
                                                TextColor="{Binding TextColor}">
                                                <custom:CustomLabel.Margin>
                                                    <OnPlatform x:TypeArguments="Thickness">
                                                        <On Platform="iOS" Value="0,0,0,0" />
                                                        <On Platform="Android" Value="0,0,0,0" />
                                                    </OnPlatform>
                                                </custom:CustomLabel.Margin>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                    </DataTemplate>
                                </buttons:SfChipGroup.ItemTemplate>
                            </buttons:SfChipGroup>
                        </ScrollView>
                    </StackLayout>

                    <StackLayout
                        Grid.Row="1"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand">

                        <ListView
                            x:Name="ListView_Returns"
                            BackgroundColor="White"
                            HasUnevenRows="True"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="{Binding IsListVisible}"
                            ItemsSource="{Binding ListToDisplay, Mode=TwoWay}"
                            SeparatorVisibility="None"
                            VerticalOptions="FillAndExpand"
                            VerticalScrollBarVisibility="Never">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <border:SfBorder Margin="0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Padding="0,10">
                                                <Grid Padding="10" RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65*" />
                                                        <ColumnDefinition Width="35*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout Grid.Row="0" Grid.Column="0">
                                                        <custom:CustomLabel
                                                            Style="{StaticResource SectionTitleBlackBold}"
                                                            Text=""
                                                            VerticalOptions="CenterAndExpand">
                                                            <custom:CustomLabel.Triggers>
                                                                <!--  Text="{Binding statusMessage}" TextColor="{Binding statusColor}"  -->
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="ITAX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="ZAKT">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="VATX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="VTEP">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="ETAX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ETReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding TaxType}"
                                                                    TargetType="Label"
                                                                    Value="WHTX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.WHTreturns1}" />
                                                                </DataTrigger>
                                                            </custom:CustomLabel.Triggers>
                                                        </custom:CustomLabel>
                                                        <custom:CustomLabel
                                                            Margin="0,10,0,0"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{Binding TaxtpText}"
                                                            VerticalOptions="CenterAndExpand" />
                                                    </StackLayout>
                                                    <!--  StatusTxt  -->
                                                <!--
                                                    <buttons:SfButton
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Padding="12,0,12,0"
                                                        CornerRadius="20"
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        FontSize="Small"
                                                        HeightRequest="40"
                                                        HorizontalOptions="End"
                                                        IsEnabled="False"
                                                        Text="{Binding Status}"
                                                        VerticalOptions="CenterAndExpand">
                                                   
                                                            BackgroundColor="{StaticResource LightGreenColor}"
                                                            TextColor="{StaticResource Primary}"
                                                        
                                                        <buttons:SfButton.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding StatusMessage}"
                                                                TargetType="buttons:SfButton"
                                                                Value="submitted">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Submitted}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundGray}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding StatusMessage}"
                                                                TargetType="buttons:SfButton"
                                                                Value="unsubmitted">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.UnSubmitted}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                                <Setter Property="FontSize" Value="11" />
                                                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorBg}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding StatusMessage}"
                                                                TargetType="buttons:SfButton"
                                                                Value="overdue">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.OverDue}" />
                                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                                <Setter Property="BackgroundColor" Value="{StaticResource ChipPaidColor}" />
                                                            </DataTrigger>


                                                        </buttons:SfButton.Triggers>
                                                    </buttons:SfButton>
                                               -->
                                                    <buttons:SfButton TextColor="{StaticResource Success}" BackgroundColor="{StaticResource BackgroundGray}" Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource SomarRegular}" FontSize="Small" IsEnabled="False" Text="{Binding RetStatTxt}" HorizontalOptions="End" VerticalOptions="CenterAndExpand" HeightRequest="80" Padding="12,0,12,0" CornerRadius="20" >
<buttons:SfButton.Triggers>
<DataTrigger TargetType="buttons:SfButton" Binding="{Binding StatusTxt}" Value="Submitted" >
<Setter Property="TextColor" Value="{StaticResource Success}" />
<Setter Property="FontSize" Value="12" />
<Setter Property="BackgroundColor" Value="{StaticResource BackgroundGray}" />
</DataTrigger>
<DataTrigger TargetType="buttons:SfButton" Binding="{Binding StatusTxt}" Value="Non Submitted">
<Setter Property="TextColor" Value="{StaticResource Error}" />
<Setter Property="FontSize" Value="12" />
<Setter Property="BackgroundColor"  Value="{StaticResource ErrorBg}" />
</DataTrigger>
<DataTrigger TargetType="buttons:SfButton" Binding="{Binding StatusTxt}" Value="Overdue">
<Setter Property="TextColor"  Value="{StaticResource Error}" />
<Setter Property="FontSize" Value="12" />
<Setter Property="BackgroundColor" Value="{StaticResource ChipPaidColor}" />
</DataTrigger>
 
 
                                                        </buttons:SfButton.Triggers>
</buttons:SfButton>
                                                </Grid>
                                                <BoxView
                                                    BackgroundColor="LightGray"
                                                    HeightRequest="1"
                                                    HorizontalOptions="FillAndExpand" />
                                                <Grid
                                                    Padding="10"
                                                    ColumnSpacing="15"
                                                    RowSpacing="15">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--<Label Grid.Row="0" Grid.Column="0" Text="1200.00 SAR" VerticalOptions="CenterAndExpand" TextColor="{StaticResource PrimaryColor}" FontSize="Medium" FontAttributes="Bold"/>-->
                                                    <StackLayout
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="-5">
                                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZReturnPeriod}" />
                                                        <StackLayout Orientation="Horizontal">
                                                            <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding FormatedAbrzu}" />
                                                            <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="-" />
                                                            <custom:CustomLabel
                                                                HorizontalOptions="StartAndExpand"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding FormatedAbrzo}" />
                                                        </StackLayout>

                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Spacing="-5">
                                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDReturnType}" />
                                                        <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding FbtText}" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Spacing="-5">
                                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDDescription}" />
                                                        <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding TaxPeriod}" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Spacing="-5">
                                                        <custom:CustomLabel
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.NDPeriod}" />
                                                        <StackLayout HorizontalOptions="StartAndExpand">
                                                            <custom:CustomLabel
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding Persl}" />
                                                        </StackLayout>
                                                    </StackLayout>

                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.Column="0"
                                                        Spacing="-5">
                                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDReturnNumber}" />
                                                        <custom:CustomLabel Style="{StaticResource ValueLabelBlack}" Text="{Binding Fbnum}" />
                                                    </StackLayout>
                                                    <StackLayout
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Spacing="-5">
                                                        <custom:CustomLabel
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource CaptionLabelGrey}"
                                                            Text="{x:Static ResourceManager:AppResources.DueDate}" />
                                                        <StackLayout HorizontalOptions="Start">
                                                            <custom:CustomLabel
                                                                HorizontalTextAlignment="Start"
                                                                Style="{StaticResource ValueLabelBlack}"
                                                                Text="{Binding FormatedSingleDueDate}" />
                                                        </StackLayout>

                                                    </StackLayout>
                                                </Grid>

                                            </StackLayout>
                                        </border:SfBorder>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <custom:CustomLabel
                            Margin="0,20,0,0"
                            HorizontalOptions="Center"
                            IsVisible="{Binding SetNoDataLabelVisibilityALL}"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}"
                            VerticalOptions="Center" />

                    </StackLayout>


                </Grid>

            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>




    </ContentPage.Content>
</ContentPage>