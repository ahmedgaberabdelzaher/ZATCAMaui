                <!-- My Bills template UI Ends  ItemTapped="Bills_ItemTapped" -->

                <ListView  x:Name="Bills" 
           ItemsSource="{Binding ListToDisplay,Mode=TwoWay}"
                                           IsVisible="{Binding SetNoDataLabelVisibilityALLList}"
                                  VerticalScrollBarVisibility="Never"    
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                 BackgroundColor="White"     
            SeparatorVisibility="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <border:SfBorder   Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid  Padding="15" RowSpacing="0" >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                <Label  Text="ZAkat" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                                <Label  Text="Amendment by" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand"   />
                                            </StackLayout>
                                            <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                                <yummy:PancakeView    Padding="10,10,10,10"  
                               CornerRadius="14"  BorderThickness="1" BackgroundColor="{Binding FrameColorHighlight}"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                                    <Label Text="{Binding statusMessage}" Style="{StaticResource CaptionLabelGrey}" TextColor="{Binding TextColorHighlight}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"/>
                                                </yummy:PancakeView>
                                            </StackLayout>
                                        </Grid>
                                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                                        <Grid Padding="10,10,10,10" RowSpacing="15" >
