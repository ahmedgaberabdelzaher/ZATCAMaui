                                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                                <Label Text="SADAD Number" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="SADAD Number" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                                <Label Text="SADAD Number" Style="{StaticResource CaptionLabelGrey}"/>
                                                <Label Text="SADAD Number" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                        </Grid>

                                    </StackLayout>
                                </border:SfBorder >
