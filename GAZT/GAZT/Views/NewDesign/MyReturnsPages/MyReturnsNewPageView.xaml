<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             mc:Ignorable="d"
             x:Class="EGAZT.Views.NewDesign.MyReturnsNewPages.GAZTNewDesignMyReturnsNewPageView"
             FlowDirection="RightToLeft"    
             
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <StackLayout>
                    <Grid Padding="0,5,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <custom:CustomLabel Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.Returns}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" IsVisible="{Binding IsBackStepButtonVisible}"  Style="{StaticResource IconLabelStyle}" Text="{DynamicResource StyleReverseBack}" TextColor="White" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <custom:CustomLabel.GestureRecognizers>
                                <TapGestureRecognizer      Command="{TemplateBinding BindingContext.OnBackButtonClicked}" ></TapGestureRecognizer>
                            </custom:CustomLabel.GestureRecognizers>
                        </custom:CustomLabel>
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
      
        <Grid Padding="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackLayout Spacing="-5" Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <custom:CustomLabel Text="{Binding FilterLabelText}" Grid.Column="0" Grid.Row="0" Style="{StaticResource PageTitleBlack}">
                        <!--<custom:CustomLabel.GestureRecognizers>
                            <TapGestureRecognizer Tapped="btn_Clicked"/>
                        </custom:CustomLabel.GestureRecognizers>-->
                    </custom:CustomLabel>
                    <custom:CustomButton x:Name="btn" Grid.Column="0" Grid.Row="0"  Clicked="btn_Clicked" Grid.ColumnSpan="2" BackgroundColor="Transparent"  >
                    <!--Margin="10,0,10,0"-->
                    </custom:CustomButton>

                    <syncfusion:SfPicker x:Name="TaxTypePicker"
                    HeaderHeight="55"
                    ShowHeader="true"
                    HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}"
HeaderTextColor="White"
                                             ShowColumnHeader="False"
                    ColumnHeaderHeight="46"
                    PickerMode="Dialog"
                                            HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="#006450"
                    BorderColor="Black"
                     BackgroundColor="#EAF7CC"
                    UnSelectedItemTextColor="#006450"
                                SelectedItemFontSize="15"
                                           
                   ItemHeight="40"
                     DisplayMemberPath="TaxType" ItemsSource="{Binding ReturnTypeForFilter}"  Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                   PickerHeight="250"
                    PickerWidth="300"
                                             HeaderFontSize="14"
                    OKButtonTextColor="#006450"
                    CancelButtonTextColor="#006450"
                        ShowFooter="True" 
                                    OKButtonBackgroundColor="#EAF7CC"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                             FooterHeight="46"
                                         SelectionChanged="TaxTypePicker_SelectionChanged">
                        <syncfusion:SfPicker.Behaviors>
                            <custom1:SfPickerBehavior />
                        </syncfusion:SfPicker.Behaviors>
                    </syncfusion:SfPicker>
                </Grid>
                <!--custom:RoundCornersEffect.CornerRadius="14" SelectionChanged="DDlIDType_SelectionChanged" OkButtonClicked="DDlIDType_OkButtonClicked"  CancelButtonClicked="DDlIDType_CancelButtonClicked"-->

                <custom:CustomLabel Text="60,0000 SAR" Style="{StaticResource CaptionLabelGrey}"/>
            </StackLayout>
            <StackLayout Grid.Row="1">
       

                <ListView  x:Name="Bills" 
           ItemsSource="{Binding ListToDisplay,Mode=TwoWay}"
                                           IsVisible="{Binding SetNoDataLabelVisibilityALLList}"
                                  VerticalScrollBarVisibility="Never"    
          HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            HasUnevenRows="True"
                 BackgroundColor="White"     
            SeparatorVisibility="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <border:SfBorder   Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout Padding="0">
                                        <Grid  Padding="15" RowSpacing="0" >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                <custom:CustomLabel  Text="" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}">
                                                    <custom:CustomLabel.Triggers>
                                                        <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                                        <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="ITAX">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="ZAKT">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="VATX">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="VTEP">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="ETAX">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ETReturns}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="WHTX">
                                                            <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.WHTreturns}" />
                                                        </DataTrigger>
                                                    </custom:CustomLabel.Triggers>
                                                </custom:CustomLabel>
                                                <custom:CustomLabel  Text="{Binding FbtText}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand"   />
                                            </StackLayout>
                                            <!--StatusTxt-->
                                            <StackLayout Grid.Row="0" Grid.Column="1"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                                <yummy:PancakeView    Padding="10,10,10,10"  
                               CornerRadius="14"  BorderThickness="1" BackgroundColor="{Binding FrameColorHighlight}"  VerticalOptions="CenterAndExpand" HorizontalOptions="End" >
                                                    <custom:CustomLabel Text="{Binding statusMessage}" Style="{StaticResource CaptionLabelGrey}" TextColor="{Binding TextColorHighlight}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                                                        <custom:CustomLabel.Triggers>
                                                            <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                                            <DataTrigger TargetType="Label" Binding="{Binding StatusTxt}" Value="Submitted">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Submitted}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="Non Submitted">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.UnSubmitted}" />
                                                            </DataTrigger>
                                                            <MultiTrigger TargetType="Label">
                                                                <MultiTrigger.Conditions>
                                                                    <BindingCondition Binding="{Binding TaxType}" Value="Non Submitted"/>
                                                                    <BindingCondition Binding="{Binding Due}" Value="X"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter Property="Text"  Value="{x:Static ResourceManager:AppResources.OverDue}" />
                                                                <!-- multiple Setter elements are allowed -->
                                                            </MultiTrigger>
                                                        </custom:CustomLabel.Triggers>
                                                    </custom:CustomLabel>
                                                    <yummy:PancakeView.Triggers>
                                                        <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                                        <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding StatusTxt}" Value="Submitted">
                                                            <Setter Property="BackgroundColor" Value="#E5EFED" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="yummy:PancakeView" Binding="{Binding TaxType}" Value="Non Submitted">
                                                            <Setter Property="BackgroundColor" Value="#F6E6E8" />
                                                        </DataTrigger>
                                                        <MultiTrigger TargetType="yummy:PancakeView">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding TaxType}" Value="Non Submitted"/>
                                                                <BindingCondition Binding="{Binding Due}" Value="X"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="BackgroundColor"  Value="#F5F5F5" />
                                                            <!-- multiple Setter elements are allowed -->
                                                        </MultiTrigger>
                                                    </yummy:PancakeView.Triggers>
                                                </yummy:PancakeView>
                                            </StackLayout>
                                        </Grid>
                                        <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                                        <Grid Padding="10,10,10,10" RowSpacing="15" >
                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0" Text="1200.00 SAR" VerticalOptions="CenterAndExpand" TextColor="Black" FontSize="Medium" FontAttributes="Bold"/>
                                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="-5">
                                                <custom:CustomLabel Text="SADAD Number" Style="{StaticResource CaptionLabelGrey}"/>
                                                <custom:CustomLabel Text="SADAD Number" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="-5">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.DueDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                <custom:CustomLabel   FlowDirection="LeftToRight" Text="{Binding FormatedSingleDueDate}" Style="{StaticResource ValueLabelBlack}" />
                                            </StackLayout>
                                        </Grid>

                                    </StackLayout>
                                </border:SfBorder >
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>