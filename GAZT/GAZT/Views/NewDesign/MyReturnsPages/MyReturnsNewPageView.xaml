<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" 
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             ios:Page.UseSafeArea="true"
             mc:Ignorable="d"
             x:Class="EGAZT.Views.NewDesign.MyReturnsNewPages.GAZTNewDesignMyReturnsNewPageView"
             FlowDirection="RightToLeft"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>
                <StackLayout>
                    <Grid Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <custom:CustomLabel Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.NDReturns}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>


                        <Image Grid.Row="0" Grid.Column="0"   IsVisible="{Binding IsBackStepButtonVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}" >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnBackButtonClicked}"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <yummy:PancakeView  VerticalOptions="FillAndExpand" CornerRadius="14,14,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Grid.Column="0" Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                </StackLayout>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <StackLayout Grid.Row="0">

                <Grid Padding="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackLayout Spacing="-5" Grid.Row="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <custom:CustomLabel Text="{Binding FilterLabelText}" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0" Grid.Row="0" Style="{StaticResource PageTitleBlack}">
                            </custom:CustomLabel>

                            <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown"  HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,8">

                            </Image>

                            <custom:CustomButton x:Name="btn" Grid.Column="0" Grid.Row="0"  Clicked="btn_Clicked" Grid.ColumnSpan="2" BackgroundColor="Transparent"  >
                            </custom:CustomButton>

                            <syncfusion:SfPicker FlowDirection="RightToLeft"   x:Name="TaxTypePicker" HeaderHeight="55" HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType" ItemsSource="{Binding ReturnTypeForFilter}" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" SelectionChanged="TaxTypePicker_SelectionChanged">
                                <syncfusion:SfPicker.Behaviors>
                                    <customcontrol:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                            </syncfusion:SfPicker>
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalOptions="StartAndExpand" HorizontalScrollBarVisibility="Never" Margin="0,24,0,24">

                            <buttons:SfChipGroup x:Name="ChipGroup_statusFilter" Type="Choice" 
                                                 ChipBackgroundColor="Transparent"  ItemsSource="{Binding ChipDataFilterlist}"   
                                                 SelectionChanged="ChipGroup_statusFilter_SelectionChanged" Style="{StaticResource ChipGroup}">
                                <buttons:SfChipGroup.ItemTemplate>
                                    <DataTemplate >
                                        <StackLayout Style="{StaticResource ChipParentLayout}">
                                            <Image Source="{Binding ImageSource}"  Style="{StaticResource ChipIcon}" />
                                            <custom:CustomLabel Text="{Binding Text}" Style="{StaticResource CaptionLabelBlack}" >
                                                <custom:CustomLabel.Margin>
                                                    <OnPlatform x:TypeArguments="Thickness">
                                                        <On Platform="iOS" Value="0,-6,0,0"/>
                                                        <On Platform="Android" Value="0,-6,0,0"/>
                                                    </OnPlatform>
                                                </custom:CustomLabel.Margin>
                                            </custom:CustomLabel>
                                        </StackLayout>
                                    </DataTemplate>
                                </buttons:SfChipGroup.ItemTemplate>
                            </buttons:SfChipGroup>


                        </ScrollView>
                    </StackLayout>

                    <StackLayout Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                        <ListView  x:Name="ListView_Returns" ItemsSource="{Binding ListToDisplay,Mode=TwoWay}" IsVisible="{Binding IsListVisible}" VerticalScrollBarVisibility="Never"   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HasUnevenRows="True" BackgroundColor="White" SeparatorVisibility="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <border:SfBorder   Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                            <StackLayout Padding="0">
                                                <Grid  Padding="15" RowSpacing="0" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackLayout Grid.Row="0" Grid.Column="0"  Spacing="-10">
                                                        <custom:CustomLabel  Text="" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}">
                                                            <custom:CustomLabel.Triggers>
                                                                <!--Text="{Binding statusMessage}" TextColor="{Binding statusColor}"-->
                                                                <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="ITAX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="ZAKT">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZAKATReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="VATX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="VTEP">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.VatReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="ETAX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ETReturns1}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding TaxType}" Value="WHTX">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.WHTreturns1}"/>
                                                                </DataTrigger>
                                                            </custom:CustomLabel.Triggers>
                                                        </custom:CustomLabel>
                                                        <!--<custom:CustomLabel  Text="{Binding FbtText}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand"   />-->
                                                        <custom:CustomLabel  Text="{Binding RetStatTxt}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="CenterAndExpand"   />
                                                    </StackLayout>
                                                    <!--StatusTxt-->
                                                    <buttons:SfButton Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource SSTArRoman}" Text="{Binding Status}" HorizontalOptions="End" VerticalOptions="CenterAndExpand" HeightRequest="40" Padding="12,0,12,0" CornerRadius="20" >
                                                        <!--BackgroundColor="{StaticResource LightGreenColor}"
                                                        TextColor="{StaticResource Primary}"-->
                                                        <buttons:SfButton.Triggers>
                                                            <DataTrigger TargetType="buttons:SfButton" Binding="{Binding StatusMessage}" Value="submitted">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.Submitted}" />
                                                                <Setter Property="TextColor" Value="#006450" />
                                                                <Setter Property="BackgroundColor" Value="#E5EFED" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="buttons:SfButton" Binding="{Binding StatusMessage}" Value="unsubmitted">
                                                                <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.UnSubmitted}" />
                                                                <Setter Property="TextColor" Value="#999999" />
                                                                <Setter Property="BackgroundColor"  Value="#F5F5F5" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="buttons:SfButton" Binding="{Binding StatusMessage}" Value="overdue">
                                                                <Setter Property="Text"  Value="{x:Static ResourceManager:AppResources.OverDue}" />
                                                                <Setter Property="TextColor"  Value="#aa0c19" />
                                                                <Setter Property="BackgroundColor" Value="#F6E6E8" />
                                                            </DataTrigger>


                                                        </buttons:SfButton.Triggers>
                                                    </buttons:SfButton>
                                                </Grid>
                                                <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />
                                                <Grid Padding="10,10,10,10" RowSpacing="15" ColumnSpacing="15" >
                                                    <Grid.RowDefinitions >
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!--<Label Grid.Row="0" Grid.Column="0" Text="1200.00 SAR" VerticalOptions="CenterAndExpand" TextColor="Black" FontSize="Medium" FontAttributes="Bold"/>-->
                                                    <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZReturnPeriod}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <StackLayout Orientation="Horizontal">
                                                            <custom:CustomLabel Text="{Binding FormatedAbrzu}"  Style="{StaticResource ValueLabelBlack}" />
                                                            <custom:CustomLabel Text="-" Style="{StaticResource ValueLabelBlack}" />
                                                            <custom:CustomLabel HorizontalOptions="StartAndExpand" Text="{Binding FormatedAbrzo}"  Style="{StaticResource ValueLabelBlack}" />
                                                        </StackLayout>

                                                    </StackLayout>
                                                    <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="-5">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDReturnType}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <custom:CustomLabel Text="{Binding FbtText}" Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="2" Grid.Column="0" Spacing="-5">
                                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDDescription}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <custom:CustomLabel Text="{Binding TaxPeriod}" Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="2" Grid.Column="1" Spacing="-5">
                                                        <custom:CustomLabel HorizontalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.NDPeriod}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <StackLayout HorizontalOptions="StartAndExpand">
                                                            <custom:CustomLabel HorizontalTextAlignment="Start"   Text="{Binding Persl}" Style="{StaticResource ValueLabelBlack}" />
                                                        </StackLayout>
                                                    </StackLayout>

                                                    <StackLayout Grid.Row="3" Grid.Column="0" Spacing="-5">
                                                        <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.NDReturnNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <custom:CustomLabel Text="{Binding Fbnum}" Style="{StaticResource ValueLabelBlack}" />
                                                    </StackLayout>
                                                    <StackLayout Grid.Row="3" Grid.Column="1" Spacing="-5">
                                                        <custom:CustomLabel HorizontalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.DueDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <StackLayout HorizontalOptions="Start">
                                                            <custom:CustomLabel HorizontalTextAlignment="Start"   Text="{Binding FormatedSingleDueDate}" Style="{StaticResource ValueLabelBlack}" />
                                                        </StackLayout>

                                                    </StackLayout>
                                                </Grid>

                                            </StackLayout>
                                        </border:SfBorder >
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <custom:CustomLabel Margin="0,20,0,0"  Text="{x:Static ResourceManager:AppResources.ZZZReturnsNotFound}" Style="{StaticResource CaptionLabelGrey}"  HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SetNoDataLabelVisibilityALL}"/>

                    </StackLayout>

               
                </Grid>

            </StackLayout>

            <Grid Grid.Row="0" Grid.Column="0"  IsVisible="{Binding IsLoading}" Margin="0,-20,0,0">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="#D99A29"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
       



    </ContentPage.Content>
</ContentPage>