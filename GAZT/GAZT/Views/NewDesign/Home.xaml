<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="EGAZT.Views.NewDesign.Home"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    HasBackButton="False">
    <newdesign:BaseContentPage.PancakeView>
        <Grid RowDefinitions="*,auto">
            <WebView x:Name="youtubeView" IsVisible="false" />
            <Label Text="{}" />
            <StackLayout BindableLayout.ItemsSource="{Binding MenuLst}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame>
                            <Grid ColumnDefinitions="30,*">
                                <Image Grid.Column="0" Source="{Binding ImageSource}" />
                                <Label Text="{Binding Name}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
            <controls:BottomMenu Grid.Row="1" VerticalOptions="EndAndExpand" />

        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>
