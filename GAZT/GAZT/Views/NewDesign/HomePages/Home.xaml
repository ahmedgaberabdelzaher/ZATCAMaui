<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    x:Class="EGAZT.Views.NewDesign.Home"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    Padding="0,45,0,0"
    ios:Page.UseSafeArea="False"
    HasBackButton="False"
    TitleText="{x:Static ResourceManager:AppResources.Home}">

    <newdesign:BaseContentPage.PancakMargin>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="iOS" Value="0,0,0,20" />
            <On Platform="Android" Value="0" />
        </OnPlatform>
    </newdesign:BaseContentPage.PancakMargin>
    <newdesign:BaseContentPage.PancakeView>
        <Grid Margin="-20,0,-20,0" RowDefinitions="auto,*,auto">
            <Label
                Grid.Row="0"
                Margin="24,10,24,10"
                FontFamily="{StaticResource SomarBold}"
                FontSize="18"
                Text="{x:Static ResourceManager:AppResources.ZATCAServices}"
                TextColor="{StaticResource Primary}" />
            <StackLayout
                x:Name="HomeMenuLst"
                Grid.Row="1"
                Margin="20,0,20,0"
                BindableLayout.ItemsSource="{Binding MenuLst}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            x:Name="Item"
                            Margin="0,15,0,0"
                            Padding="22"
                            BorderColor="#DDDDDD"
                            CornerRadius="15">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    BindingContext="{Binding Source={x:Reference HomeMenuLst}, Path=BindingContext}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />

                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="30,*">
                                <Image
                                    Grid.Column="0"
                                    HeightRequest="20"
                                    Source="{Binding ImageSource}" />
                                <Label
                                    Grid.Column="1"
                                    Margin="20,0,20,0"
                                    Text="{Binding Name}"
                                    VerticalOptions="CenterAndExpand" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
            <controls:BottomMenu
                Grid.Row="2"
                Margin="20,0,20,0"
                HorizontalOptions="Fill"
                VerticalOptions="EndAndExpand" />

        </Grid>
    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>
