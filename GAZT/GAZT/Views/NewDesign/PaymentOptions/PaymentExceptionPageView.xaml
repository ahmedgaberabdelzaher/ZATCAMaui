<?xml version="1.0" encoding="utf-8"?>

<pages:PopupPage xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:FontImage="clr-namespace:MVP.FontIcons"
                 xmlns:custom2="clr-namespace:EGAZT"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"             
                 xmlns:local="clr-namespace:EGAZT" xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" xmlns:custom="clr-namespace:GAZT"
                 NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background"
                 x:Class="EGAZT.Views.NewDesign.PaymentOptions.PaymentExceptionPageView">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.Content>
        <ScrollView>
            <StackLayout IsVisible="true" Margin="0" BackgroundColor="Transparent" >
                <StackLayout Padding="40" VerticalOptions="CenterAndExpand" BackgroundColor="Transparent">
                    <Image Source="errorNew.png"   Aspect="AspectFit"/>
                    <Label Text="{x:Static custom2:AppResources.ZZSomethingwentwrong}" FontFamily="{StaticResource SomarBold}"  FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                    <Label Text= "{x:Static custom2:AppResources.ErrorOccuredContactCustomerService}" FontFamily="{StaticResource SomarSemiBold}"
                           TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </StackLayout>

                <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalOptions="Center" VerticalOptions="End" Margin="30,60,30,80" >
                    <buttons:SfButton Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,16"  Clicked="TryAgainClicked" Text="{x:Static ResourceManager:AppResources.tryAgain}"
                                      Style="{StaticResource PrimaryButtonStyle}" HeightRequest="46" />
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</pages:PopupPage>