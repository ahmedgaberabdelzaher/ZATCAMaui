<pages:PopupPage
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    mc:Ignorable="d"
    FlowDirection="RightToLeft"
    xmlns:ResourceManager="clr-namespace:EGAZT"  xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    x:Class="EGAZT.Views.NewDesign.PaymentOptions.PaymentOptionsPageView">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <templateSelector:LVUnselectedItemTemplateSelector x:Key="UnselectedItemTemplateSelector"/>
            <templateSelector:LVSelectedItemTemplateSelector x:Key="SelectedIttemTemplateSelector"/>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand" BackgroundColor="White">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0">
                <Label Margin="10" Text="{x:Static ResourceManager:AppResources.PaymentMethod}"  Style="{StaticResource TPProfileLabelBlackBold}"/>
            </StackLayout>
            <Grid Grid.Row="1">
                <listView:SfListView x:Name="paymentItemsListView" HorizontalOptions="EndAndExpand" IsScrollBarVisible="False" IsScrollingEnabled="False"
                                      VerticalOptions="Center"  AutoFitMode="DynamicHeight" ItemSpacing="12"
                                      SelectionMode="Single" 
                                      SelectionBackgroundColor="Transparent" SelectionChanged="paymentItemSelectionChanged">
                    
                            <listView:SfListView.ItemTemplate>

                                <DataTemplate>
                                    <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="104" WidthRequest="171" HorizontalOptions="Start">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="unselected171x136" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                <Image Source="{Binding SelectedCardIcon}" HeightRequest="30" HorizontalOptions="Start" VerticalOptions="EndAndExpand" Aspect="AspectFit" Margin="0,0,0,10"></Image>
                                                <Label Text="{Binding CardLabel}" Style="{DynamicResource CardLabelBlack}"  Padding="0" Margin="0,-10" HorizontalOptions="Start"/> 
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView>

                                </DataTemplate>

                            </listView:SfListView.ItemTemplate>

                            <listView:SfListView.SelectedItemTemplate>

                                <DataTemplate>
                                    <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="104" WidthRequest="171">
                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="re_Tile_Background_S" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                <Image Source="{Binding UnSelectedCardIcon}" HeightRequest="30" HorizontalOptions="Start" VerticalOptions="EndAndExpand" Aspect="AspectFit" Margin="0"></Image>
                                                <Label Text="{Binding CardLabel}" Style="{DynamicResource CardLabelBlack}" TextColor="White" LineHeight="0.8" Padding="0" Margin="0,-10" HorizontalOptions="Start"/>
                                            </StackLayout>
                                        </Grid>
                                    </cards:SfCardView>

                                </DataTemplate>

                            </listView:SfListView.SelectedItemTemplate>             
                    <listView:SfListView.LayoutManager>

                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />

                    </listView:SfListView.LayoutManager>

                </listView:SfListView>
                
            </Grid>
            <cards:SfCardView Grid.Row="2" x:Name="FrameMadaPaymentText" HorizontalOptions="FillAndExpand"  BackgroundColor="#CCE0DC" Padding="10" HasShadow="False" VerticalOptions="FillAndExpand">
                <custom:CustomLabel x:Name="TextMadaPaymentText"  LineSpacing="1" ></custom:CustomLabel>
            </cards:SfCardView> 
           
        </Grid>
    </yummy:PancakeView>
</pages:PopupPage>