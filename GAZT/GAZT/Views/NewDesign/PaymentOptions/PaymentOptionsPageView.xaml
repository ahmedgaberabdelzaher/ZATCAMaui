<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.PaymentOptions.PaymentOptionsPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    FlowDirection="RightToLeft"
    mc:Ignorable="d">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <templateSelector:LVUnselectedItemTemplateSelector x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelector x:Key="SelectedIttemTemplateSelector" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0">
                <Label
                    Margin="10"
                    Style="{StaticResource TPProfileLabelBlackBold}"
                    Text="{x:Static ResourceManager:AppResources.PaymentMethod}" />
            </StackLayout>
            <Grid Grid.Row="1">
                <listView:SfListView
                    x:Name="paymentItemsListView"
                    HorizontalOptions="EndAndExpand"
                    IsScrollBarVisible="False"
                    IsScrollingEnabled="False"
                    ItemSpacing="12"
                    SelectionBackgroundColor="Transparent"
                    SelectionChanged="paymentItemSelectionChanged"
                    SelectionMode="Single"
                    VerticalOptions="Center">

                    <listView:SfListView.ItemTemplate>

                        <DataTemplate>
                            <cards:SfCardView
                                BackgroundColor="{StaticResource PickerBgGray}"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="10"
                                HasShadow="False"
                                HeightRequest="55"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Start">
                                <Grid
                                    Padding="0,-4"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="CenterAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="55" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        x:Name="PayIcon"
                                        Grid.Column="0"
                                        Margin="4,0,0,0"
                                        Aspect="AspectFit"
                                        HeightRequest="{Binding IconHeight}"
                                        HorizontalOptions="Start"
                                        Source="{Binding SelectedCardIcon}"
                                        VerticalOptions="CenterAndExpand" />
                                    <Label
                                        Grid.Column="1"
                                        Padding="8,0"
                                        HorizontalOptions="Start"
                                        Style="{DynamicResource CardLabelBlack}"
                                        Text="{Binding CardLabel}"
                                        VerticalOptions="CenterAndExpand" />
                                </Grid>
                            </cards:SfCardView>

                        </DataTemplate>

                    </listView:SfListView.ItemTemplate>

                    <listView:SfListView.SelectedItemTemplate>


                        <DataTemplate>
                            <cards:SfCardView
                                BackgroundColor="{StaticResource PickerBgGray}"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                BorderWidth="1"
                                CornerRadius="10"
                                HasShadow="False"
                                HeightRequest="55"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Start">
                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="55" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackLayout
                                        Margin="4,0,0,0"
                                        HorizontalOptions="FillAndExpand"
                                        Orientation="Horizontal"
                                        Style="{DynamicResource CardParentStacklayout}"
                                        VerticalOptions="CenterAndExpand">
                                        <Image
                                            x:Name="PayIcon"
                                            Margin="4,0,0,0"
                                            Aspect="AspectFit"
                                            HeightRequest="{Binding IconHeight}"
                                            HorizontalOptions="Start"
                                            Source="{Binding SelectedCardIcon}"
                                            VerticalOptions="CenterAndExpand" />
                                        <Label
                                            Padding="8,0"
                                            HorizontalOptions="Start"
                                            Style="{DynamicResource CardLabelBlack}"
                                            Text="{Binding CardLabel}"
                                            VerticalOptions="CenterAndExpand" />
                                    </StackLayout>
                                </Grid>
                            </cards:SfCardView>

                        </DataTemplate>

                    </listView:SfListView.SelectedItemTemplate>
                    <listView:SfListView.LayoutManager>

                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=1, Tablet=4, Desktop=5}" />

                    </listView:SfListView.LayoutManager>

                </listView:SfListView>

            </Grid>
            <cards:SfCardView
                x:Name="FrameMadaPaymentText"
                Grid.Row="2"
                Padding="10"
                BackgroundColor="#b6e7fc"
                HasShadow="False"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
                <custom:CustomLabel
                    x:Name="TextMadaPaymentText"
                    LineSpacing="0.8"
                    Style="{StaticResource ValueLabelBlackLight}" />
            </cards:SfCardView>

        </Grid>
    </yummy:PancakeView>
</pages:PopupPage>