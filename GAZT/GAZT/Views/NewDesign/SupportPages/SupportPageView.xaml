<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:gmaps="clr-namespace:Xamarin.Forms.GoogleMaps;assembly=Xamarin.Forms.GoogleMaps"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False"
             x:Class="EGAZT.Views.NewDesign.SupportPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SupportTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter"/>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="BackButtonArrow" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}" Padding="20,20,20,0" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--Parent View Starts-->
                    <ScrollView Grid.Row="0" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:SupportTabEnum.Parent}}">
                        <StackLayout Spacing="16" Padding="0,24,0,0">

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image Source="ic_logo_gazt.png" HeightRequest="25" WidthRequest="25"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZAboutUs}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Aboutus_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image Source="ic_vat_return.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPrivacyPolicy}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PrivacyPolicy_Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>
                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image Source="faQs.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZFaq}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center" VerticalOptions="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFAQTapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <!--<border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image Source="ColorChat.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDChat}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChatTapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>-->

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image Source="customerServiceColor.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZContactus}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnContactUsTapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <!--<border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image Source="branchLocator.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDBranchLocator}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchLocatorTapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>-->
                        </StackLayout>
                    </ScrollView>
                    <!--Parent View End-->
                    
                    <!--FAQ View Starts-->
                    <StackLayout IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:SupportTabEnum.FAQ}}">
                        <WebView x:Name="ContactWebView" WidthRequest="1000" Navigating="ContactWebView_Navigating" Navigated="ContactWebView_Navigated" VerticalOptions="FillAndExpand" />
                    </StackLayout>
                    <!--FAQ View End-->

                    <!--Chat View Ends-->
                    <StackLayout IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:SupportTabEnum.Chat}}">
                        <WebView x:Name="ChatWebView" WidthRequest="1000" Navigating="ChatWebView_Navigating" Navigated="ChatWebView_Navigated" VerticalOptions="FillAndExpand" />
                    </StackLayout>
                    <!--Chat View Ends-->

                    <!--ContactUs View Starts-->
                    <Grid IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:SupportTabEnum.ContactUs}}">
                        <Grid x:Name="ContactUsMainPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never" >
                            <StackLayout>
                        <!--<WebView x:Name="ContactUsWebView" WidthRequest="1000" Navigating="ContactWebView_Navigating" Navigated="ContactWebView_Navigated" VerticalOptions="FillAndExpand" />-->
                                    <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZZZLandingPageTitle}" Style="{StaticResource PageTitleBlack}" />
                                    <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDHeadquaeterRiyadh}" Style="{StaticResource SectionTitleBlack}" />
                        <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False">
                            <Grid Padding="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40*"/>
                                    <ColumnDefinition Width="60*"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Column="0" Orientation="Horizontal">
                                    <Image Source="ic_location_Outline.png" VerticalOptions="Start" Margin="0,3,0,0"/>
                                    <custom:CustomLabel VerticalOptions="StartAndExpand" VerticalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.ZVatAddress}" Style="{StaticResource BodyLabelGrey}"/>
                                </StackLayout>
                                            <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDHeadQAddress}" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End"/>
                            </Grid>
                        </border:SfBorder>
                                    <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" BorderWidth="0" Margin="0,10,0,0">
                                        <gmaps:Map Margin="0"  MapType="Street" IsEnabled="False" x:Name="mapView" HeightRequest="200" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand" />
                                    </border:SfBorder>
                                    <custom:CustomLabel Margin="0,15,0,0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.ZZZContactInformation}" Style="{StaticResource SectionTitleBlack}" />

                        <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False">
                            <Grid Padding="16,8,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Column="0" Orientation="Horizontal">
                                    <Image Source="phone_Green.png" VerticalOptions="Start" Margin="0,3,0,0"/>
                                    <custom:CustomLabel VerticalOptions="StartAndExpand" VerticalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.NDLocalPhone}" Style="{StaticResource BodyLabelGrey}"/>
                                </StackLayout>
                                <custom:CustomLabel Grid.Column="1" Text="19993" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End"/>
                            </Grid>
                        </border:SfBorder>

                        <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False">
                            <Grid Padding="16,8,16,8" ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Column="0" Orientation="Horizontal">
                                    <Image Source="phone_Green.png" VerticalOptions="CenterAndExpand" Margin="0,3,0,0"/>
                                                <custom:CustomLabel VerticalOptions="StartAndExpand" VerticalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.NDInternationalPhone}" Style="{StaticResource BodyLabelGrey}"/>
                                </StackLayout>
                                <custom:CustomLabel VerticalTextAlignment="Center" Grid.Column="1" Text="+966 112 048 998" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End"/>
                            </Grid>
                        </border:SfBorder>

                        <border:SfBorder Margin="0,0,0,15" Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False">
                            <Grid Padding="16,8,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackLayout Grid.Column="0" Orientation="Horizontal">
                                    <Image Source="phone_Green.png" VerticalOptions="Start" Margin="0,3,0,0"/>
                                                <custom:CustomLabel VerticalOptions="StartAndExpand" VerticalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.NDContactEmail}" Style="{StaticResource BodyLabelGrey}"/>
                                </StackLayout>
                                <custom:CustomLabel Grid.Column="1" Text="info@gazt.gov.sa" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End"/>
                            </Grid>
                        </border:SfBorder>

                                    <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.NDSocial}" Style="{StaticResource SectionTitleBlack}" />
                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <border:SfBorder.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTwitterGAZTTapped"/>
                                        </border:SfBorder.GestureRecognizers>
                                        <StackLayout Orientation="Horizontal" Spacing="16">

                                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False" BorderWidth="0" BackgroundColor="{StaticResource Primary}" Padding="12">
                                                <Image>
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="White" Size="30" Glyph="{x:Static FontImage:IconFonts.Twitter}"/>
                                                    </Image.Source>
                                                </Image>
                                            </border:SfBorder>

                                            <StackLayout VerticalOptions="CenterAndExpand">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDGAZT}" Style="{StaticResource ButtonLabelBlackBold}"/>
                                                <custom:CustomLabel Margin="0,-16,0,0" Text="{x:Static ResourceManager:AppResources.NDTwitter}" Style="{StaticResource CaptionLabelGrey}"/>
                                            </StackLayout>
                                            <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" Style="{DynamicResource BackButtonArrow}" Margin="16,0,16,0"/>
                                        </StackLayout>
                                    </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                        <border:SfBorder.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTwitterVATTapped"/>
                                        </border:SfBorder.GestureRecognizers>
                                        <StackLayout Orientation="Horizontal" Spacing="16">

                                    <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False" BorderWidth="0" BackgroundColor="{StaticResource NewDullOrangeColor}" Padding="12">
                                        <Image>
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="White" Size="30" Glyph="{x:Static FontImage:IconFonts.Twitter}"/>
                                            </Image.Source>
                                        </Image>
                                    </border:SfBorder>

                                    <StackLayout VerticalOptions="CenterAndExpand">
                                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZakatInstalmetSelectTypeVAT}" Style="{StaticResource ButtonLabelBlackBold}"/>
                                                <custom:CustomLabel Margin="0,-16,0,0" Text="{x:Static ResourceManager:AppResources.NDTwitter}" Style="{StaticResource CaptionLabelGrey}"/>
                                    </StackLayout>
                                            <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" Style="{DynamicResource BackButtonArrow}" Margin="16,0,16,0"/>
                                </StackLayout>
                            </border:SfBorder>
                        </StackLayout>
                            </ScrollView>
                            <StackLayout Grid.Row="1" BackgroundColor="White" Padding="0,8,0,10">
                                <buttons:SfButton Text="{x:Static ResourceManager:AppResources.NDSuggestionsandComplaints}" Style="{StaticResource PrimaryButtonStyle}" Clicked="SuggestionsandComplaintsClicked"/>
                            </StackLayout>
                        </Grid>

                        <WebView x:Name="ContactUsWebView" IsVisible="False"  WidthRequest="1000" Navigating="ContactWebView_Navigating" Navigated="ContactWebView_Navigated" VerticalOptions="FillAndExpand" />
                    </Grid>
                    <!--ContactUs View End-->

                    <!--Branch Locator Starts-->
                    <ScrollView Grid.Row="0" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:SupportTabEnum.BranchLocator}}">
                        <StackLayout>
                            <!--DropDown Starts-->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Text="Dammam" Grid.Column="0" Grid.Row="0" Style="{StaticResource PageTitleBlack}">
                                </custom:CustomLabel>

                                <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown"  Margin="5,10,5,0" HorizontalOptions="Start" VerticalOptions="Center">

                                </Image>

                                <custom:CustomButton x:Name="btn" Grid.Column="0" Grid.Row="0"  Clicked="Branch_Clicked" Grid.ColumnSpan="2" BackgroundColor="Transparent"  >
                                </custom:CustomButton>

                                <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="BranchLocation" HeaderHeight="55" HeaderText="{x:Static ResourceManager:AppResources.ZZPleaseselectFormBundleType}" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="False" ItemHeight="40" DisplayMemberPath="TaxType" ItemsSource="{Binding ReturnTypeForFilter}" Grid.Row="0" Grid.Column="0" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralGreay}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46" SelectionChanged="BranchLocation_SelectionChanged">
                                    <syncfusion:SfPicker.Behaviors>
                                        <customcontrol:SfPickerBehavior />
                                    </syncfusion:SfPicker.Behaviors>
                                </syncfusion:SfPicker>
                            </Grid>
                            <!--DropDown Ends-->

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}" HasShadow="False">
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40*"/>
                                        <ColumnDefinition Width="60*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Column="0" Orientation="Horizontal">
                                    <Image Source="ic_location_Outline.png" VerticalOptions="Start" Margin="0,3,0,0"/>
                                    <custom:CustomLabel VerticalOptions="StartAndExpand" VerticalTextAlignment="Start" Text="{x:Static ResourceManager:AppResources.ZVatAddress}" Style="{StaticResource BodyLabelGrey}"/>
                                    </StackLayout>
                                    <custom:CustomLabel Grid.Column="1" Text="Al Haras Al Watani, Dhahran 34232, Arabia Saudita" Style="{StaticResource ValueLabelBlack}" HorizontalTextAlignment="End"/>
                                </Grid>
                            </border:SfBorder>
                            <!--For Google MAP-->
                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                
                            </border:SfBorder>
                            <!--For Google MAP End-->

                            <border:SfBorder Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Padding="16,8,16,8" Orientation="Horizontal">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPobox1}" Style="{StaticResource BodyLabelGrey}"/>
                                    <custom:CustomLabel Text="5545" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                </StackLayout>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Padding="16,8,16,8" Orientation="Horizontal">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZPostalCode}" Style="{StaticResource BodyLabelGrey}"/>
                                    <custom:CustomLabel Text="31187" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                </StackLayout>
                            </border:SfBorder>

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZContactInformation}" Style="{StaticResource SectionTitleBlack}"/>
                            <border:SfBorder Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Padding="16,8,16,8" Orientation="Horizontal">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDLocalPhone}" Style="{StaticResource BodyLabelGrey}"/>
                                    <custom:CustomLabel Text="0138277858" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                </StackLayout>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrame}">
                                <StackLayout Padding="16,8,16,8" Orientation="Horizontal">
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDOpeningHours}" Style="{StaticResource BodyLabelGrey}"/>
                                    <custom:CustomLabel Text="Sun - Thur 8am - 4pm" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                </StackLayout>
                            </border:SfBorder>

                        </StackLayout>
                    </ScrollView>
                    <!--Branch Locator Ends-->
                </Grid>
            </yummy:PancakeView>

            <Grid Grid.Row="0" Padding="20,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0">
                    <Image Source="arrowLeftwhite.png" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Style="{DynamicResource BackButtonArrow}"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" NumberOfTapsRequired="1"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <custom:CustomLabel Grid.Column="1" Text="{Binding PageTitle}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>