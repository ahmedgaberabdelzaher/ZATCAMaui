<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:gmaps="clr-namespace:Xamarin.Forms.Maps;assembly=Xamarin.Forms.Maps"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" 
             ios:Page.UseSafeArea="true"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl" xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:helper="clr-namespace:EGAZT.Helper"
             BackgroundImageSource="partials_background.png"
             NavigationPage.HasNavigationBar="False"
             x:Class="EGAZT.Views.NewDesign.ZatcaInfoMenuPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SupportTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter"/>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}" Padding="20,20,20,0" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--Parent View Starts-->
                    <ScrollView Grid.Row="0" Padding="0,0,0,32" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}" VerticalScrollBarVisibility="Never">
                        <StackLayout Spacing="24" Padding="0,12,0,0">

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadowSupportPage}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image WidthRequest="25" HeightRequest="50" Source="education.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CustomsZATCAIntegrat}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenu1Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                              <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadowSupportPage}">
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="16,8,16,8">
                                    <Image Source="ic_menu_Tax_check.png"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CustomsZatcaDelca}" Style="{StaticResource ValueLabelBlack}" VerticalTextAlignment="Center"/>
                                    <Image Source="arrowRight.png" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand" Style="{DynamicResource BackButtonArrow}"/>
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenu2Tapped"/>
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>
                           
                       
                        </StackLayout>
                    </ScrollView>
                    <!--Parent View End-->

                    <!--Chat View starts-->
                       <Grid Padding="0,0,0,0"  IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.customsTarrifs}}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="AliceBlue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <helper:MyWebView x:Name="CustomsTraffis"  Navigating="CustomsTraffis_Navigating" Navigated="CustomsTraffis_Navigated"/>
                        </Grid>
                    <!-- Chat View Ends-->

                     <!--Customs View starts-->
                       <Grid Padding="0,0,0,0"  IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.customsDelecrations}}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="AliceBlue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <helper:MyWebView x:Name="CustomsView"  Navigating="CustomsView_Navigating" Navigated="CustomsView_Navigated"/>
                        </Grid>
                    <!-- Customs View Ends-->
                </Grid>
            </yummy:PancakeView>
                <Grid Grid.Row="1" IsVisible="{Binding IsLoading}" Margin="0,0,0,0">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70"
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70"
                                       TextColor="{StaticResource Secondary}"/>
                    </StackLayout>
                </StackLayout>
            </Grid>

            <Grid Grid.Row="0" Padding="20,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0">
                    <Image Source="arrowLeftwhite.png" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Style="{DynamicResource BackButtonArrow}"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" NumberOfTapsRequired="1"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <custom:CustomLabel Grid.Column="1" Text="{Binding PageTitle}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>