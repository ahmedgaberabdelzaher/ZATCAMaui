<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ZatcaInfoMenuPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:gmaps="clr-namespace:Xamarin.Forms.Maps;assembly=Xamarin.Forms.Maps"
    xmlns:helper="clr-namespace:EGAZT.Helper"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
    xmlns:settings="clr-namespace:EGAZT.AppConfigurations"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SupportTabEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,20,20,0"
                Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Parent View Starts  -->
                    <ScrollView
                        Grid.Row="0"
                        Padding="0,0,0,32"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.parentCstoms}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout Padding="0,12,0,0" Spacing="24">

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadowSupportPage}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image
                                        HeightRequest="50"
                                        Source="education.png"
                                        WidthRequest="25" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsZATCAIntegrat}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenu1Tapped" />
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadowSupportPage}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image Source="ic_menu_Tax_check.png" />
                                    <custom:CustomLabel
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsZatcaDelca}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <border:SfBorder.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMenu2Tapped" />
                                </border:SfBorder.GestureRecognizers>
                            </border:SfBorder>

                            <Frame
                                Padding="5"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                CornerRadius="14"
                                HasShadow="False"
                                IsVisible="{x:Static settings:PageSettings.IsIncludeLapFees}">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image Source="ic_menu_Tax_check.png" />
                                    <custom:CustomLabel
                                        LineSpacing="1"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.InquireaboutPaymentofInsuranceTitle}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToInquireaboutPaymentofInsurance}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                            <Frame
                                Padding="5"
                                BorderColor="{StaticResource NeutralLightGrey}"
                                CornerRadius="14"
                                HasShadow="False">
                                <StackLayout
                                    Padding="16,8,16,8"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Image
                                        HeightRequest="50"
                                        Source="EDeclerationicon"
                                        WidthRequest="25" />
                                    <custom:CustomLabel
                                        LineSpacing="1"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{x:Static ResourceManager:AppResources.CustomsDeclarationforTravelers}"
                                        VerticalTextAlignment="Center" />
                                    <Image
                                        HorizontalOptions="EndAndExpand"
                                        Source="arrowRight.png"
                                        Style="{DynamicResource BackButtonArrow}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToCustomsDeclarationforTravelers}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                        </StackLayout>
                    </ScrollView>
                    <!--  Parent View End  -->

                    <!--  Chat View starts  -->
                    <Grid
                        Padding="0,0,0,0"
                        BackgroundColor="AliceBlue"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.customsTarrifs}}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <helper:MyWebView
                            x:Name="CustomsTraffis"
                            Navigated="CustomsTraffis_Navigated"
                            Navigating="CustomsTraffis_Navigating" />
                    </Grid>
                    <!--  Chat View Ends  -->

                    <!--  Customs View starts  -->
                    <Grid
                        Padding="0,0,0,0"
                        BackgroundColor="AliceBlue"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:CustomsEnum.customsDelecrations}}"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <helper:MyWebView
                            x:Name="CustomsView"
                            Navigated="CustomsView_Navigated"
                            Navigating="CustomsView_Navigating" />
                    </Grid>
                    <!--  Customs View Ends  -->
                </Grid>
            </yummy:PancakeView>
            <Grid
                Grid.Row="1"
                Margin="0,0,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>

            <Grid Grid.Row="0" Padding="20,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0">
                    <Image
                        HorizontalOptions="Start"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnBackArrowTapped" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{Binding PageTitle}"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>