<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.MyReports.MyReportsPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:filterView="clr-namespace:EGAZT.Views.NewDesign.MyReports" 
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior EventName="Appearing" Command="{Binding GetMyReportsCommand}"/>
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,5,20,5" ColumnDefinitions="*,2*,*">

                <StackLayout>

                    <!--  Back Button  -->
                    <Image
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  My Reports Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDMyReports}"
                    VerticalOptions="Center" />

                <StackLayout Grid.Column="2">

                    <!--  Search Image  -->
                    <Image
                        HorizontalOptions="End"
                        Source="search.png"
                        WidthRequest="25"
                        HeightRequest="25"
                        VerticalOptions="CenterAndExpand" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SearchCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView>

                    <StackLayout Spacing="30">

                        <!--All Reports Layout-->
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,*"
                              RowSpacing="0">


                            <!--  All Reports Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="28"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.NDMyReports}"
                                TextColor="#58595B" />

                            <!--  Down arrow Button  -->
                            <Image
                                HorizontalOptions="Start"
                                Grid.Column="1"
                                Source="arrowDropdown.png"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FilterCommand}"/>
                                </Image.GestureRecognizers>

                            </Image>

                            <!--  Reports Count Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="12"
                                Grid.Row="1"
                                HorizontalOptions="StartAndExpand"
                                Text="{Binding ReportsCount}"
                                TextColor="#999999" />

                        </Grid>

                        <!--Add new report Frame-->
                        <Frame CornerRadius="12"
                               Padding="8"
                               BorderColor="#EBEBEB">

                            <StackLayout Orientation="Horizontal">

                                <!--  Add Report Image  -->
                                <Image
                                    HorizontalOptions="Start"
                                    Source="add.png"
                                    VerticalOptions="CenterAndExpand" />

                                <!--  Add new report Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.AddNewReport}"
                                    VerticalTextAlignment="Center"
                                    TextColor="#042E66" />

                            </StackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddNewReportCommand}" />
                            </Frame.GestureRecognizers>

                        </Frame>

                        <!--  MyReports List  -->

                        <StackLayout
                             x:Name="reportsList"
                             BindableLayout.ItemsSource="{Binding MyReportsList}"
                             Spacing="20">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate>

                                    <!--Report list Frame-->

                                    <Frame CornerRadius="12"
                                            Padding="0"
                                            x:Name="Item"
                                            BorderColor="#EBEBEB">

                                        <StackLayout Padding="25,20">

                                            <!--First section-->
                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="*,*"
                                                  RowSpacing="0">


                                                <!--  Facility name Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="20"
                                                    HorizontalOptions="Fill"
                                                    LineBreakMode="WordWrap"
                                                    MaxLines="2"
                                                    Grid.ColumnSpan="2"
                                                    Text="{Binding facilityName}"
                                                    TextColor="#232323" />

                                                <!--Status region-->
                                                <Grid Grid.RowSpan="2"
                                                      Grid.Column="1"
                                                      HorizontalOptions="EndAndExpand"
                                                      VerticalOptions="CenterAndExpand"
                                                      ColumnDefinitions="80">

                                                    <Frame CornerRadius="15"
                                                           BackgroundColor="#0996D4"
                                                           Padding="5"
                                                           Opacity="0.1"
                                                           BorderColor="#EBEBEB">

                                                        <Frame.Triggers>

                                                            <!--Closed status-->
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="0">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>

                                                            <!--Open status-->
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="1">
                                                                <Setter Property="BackgroundColor" Value="#0996D4" />
                                                             </DataTrigger>

                                                            <!--Open status with different value-->
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="3">
                                                                <Setter Property="BackgroundColor" Value="#0996D4" />
                                                             </DataTrigger>

                                                        </Frame.Triggers>

                                                    </Frame>

                                                    <!--  Status Label  -->
                                                    <Frame
                                                        CornerRadius="15"
                                                        Padding="5"
                                                        BackgroundColor="Transparent">

                                                        <Label
                                                            FontFamily="{StaticResource SomarBold}"
                                                            FontSize="16"
                                                            VerticalOptions="CenterAndExpand"
                                                            HorizontalOptions="CenterAndExpand"
                                                            Text="{Binding reportStatus}"
                                                            LineBreakMode="TailTruncation"
                                                            MaxLines="2"
                                                            TextColor="#0996D4" >
                                                            <Label.Triggers>

                                                                <!--Open status-->
                                                                <DataTrigger TargetType="Label"
                                                                            Binding="{Binding reportStatus}"
                                                                            Value="1">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.OpenReports}" />
                                                                    <Setter Property="TextColor" Value="#0996D4" />
                                                                </DataTrigger>

                                                                 <!--Closed status-->
                                                                 <DataTrigger TargetType="Label"
                                                                            Binding="{Binding reportStatus}"
                                                                            Value="0">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                </DataTrigger>

                                                                 <!--Open status with different value-->
                                                                 <DataTrigger TargetType="Label"
                                                                            Binding="{Binding reportStatus}"
                                                                            Value="3">
                                                                   <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.OpenReports}" />
                                                                    <Setter Property="TextColor" Value="#0996D4" />
                                                                </DataTrigger>
                                                            </Label.Triggers>

                                                        </Label>

                                                    </Frame>

                                                </Grid>


                                                <!--  Region Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{Binding region}"
                                                    TextColor="#999999" />

                                            </Grid>

                                            <!--  Horizontal Line  -->
                                            <BoxView
                                                BackgroundColor="{StaticResource NeutralLightGrey}"
                                                HeightRequest="2" />


                                            <!--Second section-->
                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="*,*"
                                                  
                                                  RowSpacing="0">


                                                <!--  Report type value  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="20"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{Binding reportType}"
                                                    TextColor="#232323" />

                                                <!--  Report number Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.VATRSAppNumber}"
                                                    TextColor="#999999" />

                                                <!--  Report number value  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="2"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{Binding reportNumber}"
                                                    TextColor="#999999" />

                                                <!--  Report date Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.ZTEReportReportDate}"
                                                    TextColor="#999999" />

                                                <!--  Report date value  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{Binding addedDate}"
                                                    TextColor="#999999" />

                                            </Grid>

                                        </StackLayout>

                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference reportsList},Path=BindingContext}"
                                                Command="{Binding SelectedReportItemCommand}"
                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                        </Frame.GestureRecognizers>

                                    </Frame>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </StackLayout>




                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

            <!--  Popup Filter report  -->
            <filterView:FilterBottomSheetPage Grid.RowSpan="2" IsVisible="{Binding IsFilterReportView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

