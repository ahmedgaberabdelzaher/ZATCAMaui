<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.MyReports.MyReportsPage"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" 
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />
            <xct:ListIsNotNullOrEmptyConverter x:Key="ListIsNotNullOrEmptyConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <xct:EventToCommandBehavior EventName="Appearing" Command="{Binding GetMyReportsCommand}"/>
    </ContentPage.Behaviors>

    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,15" ColumnDefinitions="*,2*,*">

                <!--  Back Button  -->
                <StackLayout IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}">

                   <Image
                        HorizontalOptions="Start"
                        Rotation="0"
                        Source="whiteRightBack.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand" >

                         <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="180" />
                            </DataTrigger>
                        </Image.Triggers>

                    </Image>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  My Reports Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    FontSize="20"
                    IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.NDMyReports}"
                    VerticalOptions="Center" />

                <!--  Report Type Entry  -->
                <inputLayout:SfTextInputLayout
                    ContainerBackgroundColor="White"
                    ContainerType="Outlined"
                    FocusedColor="{StaticResource NeutralGreay}"
                    InputViewPadding="10,0,10,0"
                    Grid.ColumnSpan="2"
                    OutlineCornerRadius="15"
                    IsVisible="{Binding IsSearching}"
                    UnfocusedColor="{StaticResource NeutralGreay}"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand">
                    <custom:BorderlessEntry
                        Keyboard="Text"
                        Style="{StaticResource DefaultEntry}"
                        Text="{Binding SearchValue}"
                        TextColor="#58595B">
                        <custom:BorderlessEntry.Behaviors>
                           <xct:EventToCommandBehavior EventName="Completed" Command="{Binding SearchReportCommand}"/>
                        </custom:BorderlessEntry.Behaviors>
                    </custom:BorderlessEntry>
                </inputLayout:SfTextInputLayout>

                <!--  Search Image  -->
                <StackLayout Grid.Column="2"
                             IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}">
                    
                    <Image
                        HorizontalOptions="End"
                        Source="reportSearch.png"
                        WidthRequest="25"
                        HeightRequest="25"
                        VerticalOptions="CenterAndExpand" />

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SearchCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

                <!--  Close Label  -->
                <StackLayout Grid.Column="2"
                             VerticalOptions="CenterAndExpand"
                             IsVisible="{Binding IsSearching}">
                    
                     <Label
                        FontFamily="{StaticResource SomarRegular}"
                        FontSize="16"
                        Style="{StaticResource SectionTitleWhiteBold}"
                        HorizontalOptions="EndAndExpand"
                        Text="{x:Static ResourceManager:AppResources.ZClose}"/>

                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SearchCommand}" />
                    </StackLayout.GestureRecognizers>

                </StackLayout>

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                 <StackLayout Spacing="30">

                        <!--All Reports Layout-->
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,Auto"
                              RowSpacing="0">


                            <!--  All Reports Label -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="28"
                                HorizontalOptions="StartAndExpand"
                                Text="{Binding ReportsResultTitle}"
                                IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}"
                                TextColor="#58595B" />

                            <!--  Down arrow Button  -->
                            <Image
                                HorizontalOptions="StartAndExpand"
                                Grid.Column="1"
                                Source="arrowDropdown.png"
                                IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}"
                                VerticalOptions="CenterAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding FilterCommand}"/>
                                </Image.GestureRecognizers>

                            </Image>

                            <!--  Reports Count Label  -->
                            <Label
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="12"
                                Grid.Row="1"
                                IsVisible="{Binding IsSearching, Converter={StaticResource InverseBoolConverter}}"
                                HorizontalOptions="StartAndExpand"
                                Text="{Binding ReportsCount}"
                                TextColor="#999999" />

                        </Grid>

                        <!--Add new report Frame-->
                        <Frame CornerRadius="12"
                               Padding="15"
                               IsVisible="{Binding MyReportsList, Converter={StaticResource ListIsNotNullOrEmptyConverter}}"
                               BorderColor="#EBEBEB">

                            <StackLayout Orientation="Horizontal">

                                <!--  Add Report Image  -->
                                <Image
                                    HorizontalOptions="Start"
                                    Source="reportAdd.png"
                                    WidthRequest="25"
                                    HeightRequest="25"
                                    VerticalOptions="CenterAndExpand" />

                                <!--  Add new report Label  -->
                                <Label
                                    FontFamily="{StaticResource SomarRegular}"
                                    FontSize="16"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{x:Static ResourceManager:AppResources.AddNewReport}"
                                    VerticalTextAlignment="Center"
                                    TextColor="#042E66" />

                            </StackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddNewReportCommand}" />
                            </Frame.GestureRecognizers>

                        </Frame>

                        <!--  MyReports List  -->
                        <CollectionView
                             x:Name="reportsList"
                             VerticalOptions="FillAndExpand"
                             HorizontalOptions="FillAndExpand"
                             RemainingItemsThreshold="3"
                             Margin="0,0,0,20"
                             VerticalScrollBarVisibility="Never"
                             RemainingItemsThresholdReachedCommand="{Binding LoadMoreMyReportsCommand}"
                             ItemsSource="{Binding MyReportsList}">

                             <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"  VerticalItemSpacing="20"/>
                             </CollectionView.ItemsLayout>

                            <CollectionView.EmptyView>

                                <StackLayout Spacing="20"
                                             VerticalOptions="CenterAndExpand"
                                             HorizontalOptions="CenterAndExpand">

                                    <!--  Document icon  -->
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="80"
                                        Source="emptyReport.png"
                                        VerticalOptions="CenterAndExpand"
                                        HorizontalOptions="CenterAndExpand"
                                        WidthRequest="80" />

                                    <!--  Empty Reports Label  -->
                                    <Label
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="18"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="WordWrap"
                                        VerticalOptions="CenterAndExpand"
                                        HorizontalOptions="CenterAndExpand"
                                        Text="{x:Static ResourceManager:AppResources.EmptyReports}"
                                        TextColor="#999999" />

                                     <!--  Submita new report Button  -->
                                    <buttons:SfButton
                                        Margin="0,40"
                                        BackgroundColor="#0996D4"
                                        Command="{Binding AddNewReportCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Text="{x:Static ResourceManager:AppResources.Submitanewreport}" />

                                </StackLayout>

                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <!--Report list Frame-->

                                    <Frame CornerRadius="12"
                                            Padding="0"
                                            x:Name="Item"
                                            BorderColor="#EBEBEB">

                                        <StackLayout Padding="25,20">

                                            <!--First section-->
                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="*,*"
                                                  RowSpacing="0">


                                                <!--  Facility name Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="20"
                                                    HorizontalOptions="Fill"
                                                    LineBreakMode="WordWrap"
                                                    MaxLines="2"
                                                    Grid.ColumnSpan="2"
                                                    Text="{Binding facilityName}"
                                                    TextColor="#232323" />

                                                <!--Status region-->
                                                <Grid Grid.RowSpan="2"
                                                      Grid.Column="1"
                                                      HorizontalOptions="EndAndExpand"
                                                      VerticalOptions="CenterAndExpand"
                                                      ColumnDefinitions="80">

                                                    <Frame CornerRadius="15"
                                                           BackgroundColor="#0996D4"
                                                           Padding="5"
                                                           Opacity="0.1"
                                                           BorderColor="#EBEBEB">

                                                        <Frame.Triggers>

                                                            <!--Closed status-->
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="3">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="4">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="17">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="18">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="20">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="21">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="22">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="23">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="24">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>
                                                             <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="25">
                                                                <Setter Property="BackgroundColor" Value="#62B34F" />
                                                             </DataTrigger>


                                                             <!--Open status-->
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="0">
                                                                <Setter Property="BackgroundColor" Value="#0996D4" />
                                                             </DataTrigger>

                                                            <!--Open status-->
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="1">
                                                                <Setter Property="BackgroundColor" Value="#0996D4" />
                                                             </DataTrigger>

                                                             <!--In progress status-->
                                                            <DataTrigger TargetType="Frame"
                                                                    Binding="{Binding reportStatus}"
                                                                    Value="2">
                                                                <Setter Property="BackgroundColor" Value="#0996D4" />
                                                             </DataTrigger>

                                                        </Frame.Triggers>

                                                    </Frame>

                                                    <!--  Status Label  -->
                                                    <Frame
                                                        CornerRadius="15"
                                                        Padding="5"
                                                        BackgroundColor="Transparent">

                                                        <Label
                                                            FontFamily="{StaticResource SomarRegular}"
                                                            FontSize="12"
                                                            VerticalOptions="CenterAndExpand"
                                                            HorizontalOptions="CenterAndExpand"
                                                            Text="{Binding reportStatus}"
                                                            LineBreakMode="TailTruncation"
                                                            MaxLines="2"
                                                            TextColor="#0996D4" >
                                                            <Label.Triggers>

                                                                <!--Open status-->
                                                                <DataTrigger TargetType="Label"
                                                                            Binding="{Binding reportStatus}"
                                                                            Value="1">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.OpenReports}" />
                                                                    <Setter Property="TextColor" Value="#0996D4" />
                                                                </DataTrigger>

                                                                 <!--Open status-->
                                                                 <DataTrigger TargetType="Label"
                                                                            Binding="{Binding reportStatus}"
                                                                            Value="0">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.OpenReports}" />
                                                                    <Setter Property="TextColor" Value="#0996D4" />
                                                                </DataTrigger>

                                                                 
                                                                <!--In progress status-->
                                                                 <DataTrigger TargetType="Label"
                                                                            Binding="{Binding reportStatus}"
                                                                            Value="2">
                                                                   <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ZReportStatusInprogress}" />
                                                                    <Setter Property="TextColor" Value="#0996D4" />
                                                                </DataTrigger>

                                                                <!--Closed status-->
                                                                <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="3">
                                                                     <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="4">
                                                                     <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="17">
                                                                     <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="18">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="20">
                                                                     <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="21">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="22">
                                                                     <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="23">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="24">
                                                                     <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                                 <DataTrigger TargetType="Label"
                                                                        Binding="{Binding reportStatus}"
                                                                        Value="25">
                                                                    <Setter Property="Text" Value="{x:Static ResourceManager:AppResources.ClosedReports}" />
                                                                    <Setter Property="TextColor" Value="#62B34F" />
                                                                 </DataTrigger>
                                                            </Label.Triggers>

                                                        </Label>

                                                    </Frame>

                                                </Grid>


                                                <!--  Region Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{Binding region}"
                                                    TextColor="#002447" />

                                            </Grid>

                                            <!--  Horizontal Line  -->
                                            <BoxView
                                                BackgroundColor="{StaticResource NeutralLightGrey}"
                                                HeightRequest="2" />


                                            <!--Second section-->
                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="*,*"
                                                  
                                                  RowSpacing="0">


                                                <!--  Report type value  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="20"
                                                    LineBreakMode="WordWrap"
                                                    Grid.ColumnSpan="2"
                                                    HorizontalOptions="FillAndExpand"
                                                    Text="{Binding reportType}"
                                                    TextColor="#002447" />

                                                <!--  Report number Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.VATRSAppNumber}"
                                                    TextColor="#999999" />

                                                <!--  Report number value  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="2"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{Binding reportNumber}"
                                                    TextColor="#002447" />

                                                <!--  Report date Label  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{x:Static ResourceManager:AppResources.ZTEReportReportDate}"
                                                    TextColor="#999999" />

                                                <!--  Report date value  -->
                                                <Label
                                                    FontFamily="{StaticResource SomarRegular}"
                                                    FontSize="12"
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    HorizontalOptions="StartAndExpand"
                                                    Text="{Binding addedDate}"
                                                    TextColor="#002447" />

                                            </Grid>

                                        </StackLayout>

                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                BindingContext="{Binding Source={x:Reference reportsList},Path=BindingContext}"
                                                Command="{Binding SelectedReportItemCommand}"
                                                CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />
                                        </Frame.GestureRecognizers>

                                    </Frame>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </StackLayout>

            </yummy:PancakeView>
            <!--#endregion Body-->

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

            <!--  Popup Msg  -->
            <controls:MsgView Grid.RowSpan="2" IsVisible="{Binding IsShowMsgView}" />

        </Grid>
    </ContentPage.Content>
</ContentPage>

