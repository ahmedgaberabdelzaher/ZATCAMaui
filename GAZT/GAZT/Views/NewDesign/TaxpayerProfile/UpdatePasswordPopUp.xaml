<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
                 xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:custom="clr-namespace:GAZT"
                 xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.UpdatePasswordPopUp">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <yummy:PancakeView Padding="0" Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand">
        <StackLayout>

            <Image Margin="24,16,0,8" HorizontalOptions="Start"
                   Source="arrowLeft.png">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                              Tapped="OnBackArrowTapped" />
                </Image.GestureRecognizers>
            </Image>

            <BoxView Style="{StaticResource SeparatorStyle}"/>
            <StackLayout Padding="24,16,24,0">
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TPUpdatePassword}" Style="{StaticResource SectionTitleBlackBold}"/>

                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CurrentPassword}" Style="{StaticResource CaptionLabelGrey}"/>
                <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">


                    <control:BorderlessEntry x:Name="CurrentPassword"
                                             Style="{StaticResource DefaultEntry}"
                                             Text="{Binding CurrentPasswordEntry}" IsPassword="False" >
                    </control:BorderlessEntry>

                    <inputLayout:SfTextInputLayout.TrailingView >
                        <Image x:Name="CurrentPasswordImg"
                               Source="hidePassword.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer
                                                            Tapped="OnCurrentPasswordTapped" 
                                                            NumberOfTapsRequired="1">
                                </TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </inputLayout:SfTextInputLayout.TrailingView>
                </inputLayout:SfTextInputLayout>


                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDNewPassword}" Style="{StaticResource CaptionLabelGrey}"/>
                <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">

                    <control:BorderlessEntry x:Name="NewPassword"
                                             Style="{StaticResource DefaultEntry}"
                                             Text="{Binding NewPasswordEntry}" IsPassword="False" >
                    </control:BorderlessEntry>

                    <inputLayout:SfTextInputLayout.TrailingView >
                        <Image x:Name="NewPasswordImg"
                               Source="hidePassword.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer
                                                            Tapped="OnNewPasswordTapped" 
                                                            NumberOfTapsRequired="1">
                                </TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </inputLayout:SfTextInputLayout.TrailingView>
                </inputLayout:SfTextInputLayout>


                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" Style="{StaticResource CaptionLabelGrey}"/>
                <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">

                    <control:BorderlessEntry x:Name="ConfirmPassword"
                                             Style="{StaticResource DefaultEntry}"
                                             Text="{Binding ConfirmPasswordEntry}" IsPassword="False" >
                    </control:BorderlessEntry>

                    <inputLayout:SfTextInputLayout.TrailingView >
                        <Image x:Name="ConfirmPasswordImg"
                               Source="hidePassword.png">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer
                                                            Tapped="OnConfirmPasswordTapped" 
                                                            NumberOfTapsRequired="1">
                                </TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </inputLayout:SfTextInputLayout.TrailingView>
                </inputLayout:SfTextInputLayout>
            </StackLayout>

            <buttons:SfButton Margin="24,0,24,24" x:Name="btn" Text="{x:Static ResourceManager:AppResources.TPUpdate}"
                              Clicked="OnUpdateBtnClicked"
                              Style="{StaticResource PrimaryButtonStyle}"/>
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>



