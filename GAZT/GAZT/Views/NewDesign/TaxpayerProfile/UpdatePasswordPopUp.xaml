<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.UpdatePasswordPopUp"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:GAZTBehaviors="clr-namespace:EGAZT"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    mc:Ignorable="d">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <yummy:PancakeView
        Padding="0"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0">
                <Image Margin="24,16,24,8" HorizontalOptions="Start">
                    <Image.Source>
                        <FontImageSource
                            FontFamily="UserIconFont"
                            Glyph="{x:Static FontImage:IconFonts.Close}"
                            Size="25"
                            Color="{StaticResource SecondaryNew}" />
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <BoxView Style="{StaticResource SeparatorStyle}" />
                <StackLayout Padding="24,16,24,0">
                    <custom:CustomLabel Style="{StaticResource SectionTitleBlackBold}" Text="{x:Static ResourceManager:AppResources.TPUpdatePassword}" />

                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.CurrentPassword}" />
                    <inputLayout:SfTextInputLayout
                        Margin="0,-10,0,0"
                        ContainerType="Outlined"
                        ErrorColor="#B00020"
                        FocusedColor="{StaticResource Primary}"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        UnfocusedColor="#B1B1B1">

                        <control:BorderlessEntry
                            x:Name="CurrentPassword"
                            IsPassword="True"
                            MaxLength="16"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding CurrentPasswordEntry}"
                            TextColor="{StaticResource NeutralBlack}">
                            <control:BorderlessEntry.Behaviors>
                                <GAZTBehaviors:PasswordTextBehaviour />
                            </control:BorderlessEntry.Behaviors>
                        </control:BorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="CurrentPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnCurrentPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>


                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDNewPassword}" />
                    <inputLayout:SfTextInputLayout
                        Margin="0,-10,0,0"
                        ContainerType="Outlined"
                        ErrorColor="#B00020"
                        FocusedColor="{StaticResource Primary}"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        UnfocusedColor="#B1B1B1">

                        <control:BorderlessEntry
                            x:Name="NewPassword"
                            IsPassword="True"
                            MaxLength="16"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding NewPasswordEntry}"
                            TextColor="{StaticResource NeutralBlack}">
                            <control:BorderlessEntry.Behaviors>
                                <GAZTBehaviors:PasswordTextBehaviour />
                            </control:BorderlessEntry.Behaviors>
                        </control:BorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="NewPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNewPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>


                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDConfirmNewPassword}" />
                    <inputLayout:SfTextInputLayout
                        Margin="0,-10,0,0"
                        ContainerType="Outlined"
                        ErrorColor="#B00020"
                        FocusedColor="{StaticResource Primary}"
                        HorizontalOptions="FillAndExpand"
                        InputViewPadding="16,0,16,0"
                        LeadingViewPosition="Inside"
                        OutlineCornerRadius="8"
                        UnfocusedColor="#B1B1B1">

                        <control:BorderlessEntry
                            x:Name="ConfirmPassword"
                            IsPassword="True"
                            MaxLength="16"
                            Style="{StaticResource DefaultEntry}"
                            Text="{Binding ConfirmPasswordEntry}"
                            TextColor="{StaticResource NeutralBlack}">
                            <control:BorderlessEntry.Behaviors>
                                <GAZTBehaviors:PasswordTextBehaviour />
                            </control:BorderlessEntry.Behaviors>
                        </control:BorderlessEntry>

                        <inputLayout:SfTextInputLayout.TrailingView>
                            <Image x:Name="ConfirmPasswordImg" Source="hidePassword.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnConfirmPasswordTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>

                <buttons:SfButton
                    x:Name="btn"
                    Margin="24,0,24,24"
                    Clicked="OnUpdateBtnClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.TPUpdate}" />
            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="1"
                Margin="-20"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Primary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </yummy:PancakeView>

</pages:PopupPage>
