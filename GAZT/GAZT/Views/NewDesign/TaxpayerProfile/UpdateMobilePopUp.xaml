<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:d="http://xamarin.com/schemas/2014/forms/design"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 xmlns:local="clr-namespace:EGAZT.CustomControl"
                 xmlns:FontImage="clr-namespace:MVP.FontIcons"
                 xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                 xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
                 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
                 xmlns:custom1="clr-namespace:GAZT.CustomControl"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:custom="clr-namespace:GAZT"
                 x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.UpdateMobilePopUp">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView Padding="0" Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand">
        <ScrollView>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <StackLayout Grid.Row="0">

                    <StackLayout Grid.Row="0" x:Name="UpdateMobile"
                         IsVisible="True">
                        <Image Margin="24,16,24,8" HorizontalOptions="Start">
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.Close}"/>
                            </Image.Source>
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackArrowTapped"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <BoxView Style="{StaticResource SeparatorStyle}" BackgroundColor="{StaticResource NeutralLightGrey}" />
                        <StackLayout Padding="24,16,24,0">

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TPUpdateMobile}" Style="{StaticResource SectionTitleBlackBold}"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZCurrentMobileNumber}" Style="{StaticResource CaptionLabelGrey}"/>

                            <inputLayout:SfTextInputLayout  Margin="0,-10,0,0"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            OutlineCornerRadius="8"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0">

                                <Entry  FlowDirection="LeftToRight"
                                        x:Name="Mobile_Entry"
                                        Text="{Binding CurrentMobileNumberEntryText}"
                                        Style="{StaticResource DefaultEntry}"
                                        VerticalTextAlignment="Center" 
                                        Keyboard="Telephone"
                                        IsReadOnly="True"
                                        TextColor="{StaticResource NeutralBlack}" HorizontalOptions="FillAndExpand">
                                </Entry>
                            </inputLayout:SfTextInputLayout>

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NewMobileNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                            
                            <!--<Frame BorderColor="LightGray" Padding="8" HeightRequest="45" HasShadow="False" CornerRadius="8"
                                   Grid.Row="2" Grid.Column="0" Margin="0,-6,0,12">-->
                                    <Frame BorderColor="LightGray"  Padding="18,0,18,6" HasShadow="False" CornerRadius="8" Grid.Row="2" Grid.Column="0" Margin="0,-6,0,12">
                            <StackLayout FlowDirection="LeftToRight" Orientation="Horizontal" VerticalOptions="CenterAndExpand" Spacing="0">
                                <Image HorizontalOptions="Start" Source="arrowDropdown.png" >                           
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                        </Image.GestureRecognizers>                                  
                                </Image>
                                <custom:CustomButton HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black" 
                                    Text="{Binding CountryCode}" x:Name="Label_InternationalnoCode"
                                    Clicked="TapGestureRecognizer_Tapped"
                                    BackgroundColor="Transparent"/>
                                <custom:GAZTBorderlessEntry x:Name="Mobile_entry"
                                MaxLength="{Binding MaxDigids}"
                                Text="{Binding NewMobileNumberEntryText}"
                                HorizontalOptions="FillAndExpand"
                                IsSpellCheckEnabled="False"
                                Keyboard="Telephone" TextColor="Black"
                            Style="{StaticResource DefaultEntry}"
                                Unfocused="Mobile_entry_Unfocused">                               
                                </custom:GAZTBorderlessEntry>
                            </StackLayout>
                                </Frame>
                        </StackLayout>
                    </StackLayout>

                    <!--OTP View-->
                    <StackLayout Grid.Row="0" x:Name="VerificationView" Padding="24"
                         IsVisible="False">
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VerificationCode}" Style="{StaticResource SectionTitleBlackBold}" />
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}" Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1"/>

                        <StackLayout Padding="0,15,0,0" >
                            <StackLayout Orientation="Horizontal"
                                         Spacing="5"
                                         FlowDirection="LeftToRight"
                                         HorizontalOptions="CenterAndExpand"
                                         VerticalOptions="CenterAndExpand">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.MobileNumber}"
                                        Style="{StaticResource BodyLabelGrey}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"/>
                                <custom:CustomLabel x:Name="OTPSentOnThisMobileNumberLbl"
                                        Text="{Binding OTPSentOnThisMobileNumber}"
                                        Style="{StaticResource BodyLabelGrey}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"/>
                            </StackLayout>

                            <Grid Margin="0,-10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,20,30,20" FlowDirection="LeftToRight">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--First OTP Digit Start-->
                                    <inputLayout:SfTextInputLayout
                                                    Grid.Column="0"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry
                                                        x:Name="OTPFirstEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFirstDigit}"
                                                        TextChanged="OtpFirstEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                            <custom:BorderlessEntry.Behaviors>
                                                <local:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry"/>
                                            </custom:BorderlessEntry.Behaviors>
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <!--First OTP Digit End-->

                                    <!--Second OTP Digit Start-->
                                    <inputLayout:SfTextInputLayout
                                                    Grid.Column="1"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry
                                                        x:Name="OTPSecondEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPSecondDigit}"
                                                        TextChanged="OtpSecondEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                            <custom:BorderlessEntry.Behaviors>
                                                <local:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry"/>
                                            </custom:BorderlessEntry.Behaviors>
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <!--Second OTP Digit End-->

                                    <!--Third OTP Digit Start-->
                                    <inputLayout:SfTextInputLayout
                                                    Grid.Column="2"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry
                                                        x:Name="OTPThirdEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPThirdDigit}"
                                                        TextChanged="OtpThirdEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                            <custom:BorderlessEntry.Behaviors>
                                                <local:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry"/>
                                            </custom:BorderlessEntry.Behaviors>
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <!--Third OTP Digit End-->

                                    <!--Fourth OTP Digit Start-->
                                    <inputLayout:SfTextInputLayout
                                                    Grid.Column="3"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                        <custom:BorderlessEntry
                                                        x:Name="OTPFourthEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFourthDigit}"
                                                        TextChanged="OtpFourthEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand"
                                                        Unfocused="OtpFourthEntry_Unfocused">
                                        </custom:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <!--Fourth OTP Digit End-->

                                </Grid>
                            </Grid>

                            <StackLayout Orientation="Horizontal" Margin="0,10,0,0" HorizontalOptions="Center">
                                <Image Source="clock">
                                </Image>
                                <custom:CustomLabel  Text="{Binding LblCountDownTimer}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                            </StackLayout>
                            <buttons:SfButton Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                      VerticalOptions="EndAndExpand"
                                      Margin="0,10,0,0" BackgroundColor="Transparent"
                                      TextColor="{Binding ResendOTPTextColor}"
                                      Clicked="OnResendOTPBtnClicked"/>
                        </StackLayout>
                    </StackLayout>

                    <StackLayout Grid.Row="1">
                        <buttons:SfButton Margin="24,0,24,24"
                                      x:Name="btn" Text="{x:Static ResourceManager:AppResources.TPUpdate}"
                                      Style="{StaticResource PrimaryButtonStyle}"
                                      Clicked="UpdatedClicked"
                                      IsEnabled="{Binding BtnEnableFlag}">
                        </buttons:SfButton>
                    </StackLayout>
                </StackLayout>

                <Grid Grid.Row="0" Grid.RowSpan="1" Margin="-20"
                      IsVisible="{Binding IsLoading}">
                    <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Black"
                             Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Transparent"
                             Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                       EnableAnimation="True"
                                                       AnimationType="SingleCircle"
                                                       HorizontalOptions="CenterAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                       IsBusy="True"
                                                       ViewBoxWidth = "70"
                                                       TitlePlacement="Bottom"
                                                       ViewBoxHeight="70" TextColor="#006450"/>
                        </StackLayout>
                    </StackLayout>
                </Grid>

            </Grid>
        </ScrollView>
    </yummy:PancakeView>
</pages:PopupPage>