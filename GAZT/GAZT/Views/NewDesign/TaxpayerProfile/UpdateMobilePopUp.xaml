<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
                 xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
                 xmlns:custom1="clr-namespace:GAZT.CustomControl"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:custom="clr-namespace:GAZT"
                 x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.UpdateMobilePopUp">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <yummy:PancakeView Padding="0" Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand">
        <StackLayout>

            <StackLayout x:Name="UpdateMobile"
                         IsVisible="True">

                <Image Margin="24,16,0,8" HorizontalOptions="Start"
                       Source="arrowLeft.png">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1"
                                              Tapped="OnBackArrowTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <BoxView Style="{StaticResource SeparatorStyle}" BackgroundColor="{StaticResource NeutralLightGrey}" />
                <StackLayout Padding="24,16,24,0">

                    <custom:CustomLabel Text="Update Mobile Number" Style="{StaticResource SectionTitleBlackBold}"/>
                    <custom:CustomLabel Text="Current Mobile Number" Style="{StaticResource CaptionLabelGrey}"/>

                    <inputLayout:SfTextInputLayout  Margin="0,-10,0,0"
                                                    HorizontalOptions="FillAndExpand"
                                                    LeadingViewPosition="Inside" ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,0,16,0">
                        <StackLayout Orientation="Horizontal" Padding="0,8,0,8">

                            <OnPlatform x:TypeArguments="custom:CustomLabel">
                                <On Platform="iOS">
                                    <custom:CustomLabel Text="+966"
                                                        VerticalTextAlignment="Center"
                                                        Style="{StaticResource BodyLabelGrey}" />
                                </On>
                            </OnPlatform>
                            <OnPlatform x:TypeArguments="control:BorderlessEntry">
                                <On Platform="Android">
                                    <control:BorderlessEntry
                                        Placeholder="+966"
                                        VerticalTextAlignment="Center"
                                        Style="{StaticResource DefaultEntry}"
                                        IsEnabled="False" />
                                </On>
                            </OnPlatform>

                            <BoxView WidthRequest="1" HeightRequest="1"
                                         BackgroundColor="{StaticResource NeutralLightGrey}"/>

                            <control:BorderlessEntry x:Name="EntryCurrentMobileNumber"
                                                         Style="{StaticResource DefaultEntry}"
                                                         Text="{Binding CurrentMobileNumberEntryText}"
                                                         Keyboard="Numeric"
                                                         HorizontalOptions="FillAndExpand">
                            </control:BorderlessEntry>
                        </StackLayout>
                    </inputLayout:SfTextInputLayout>

                    <custom:CustomLabel Text="New Mobile Number" Style="{StaticResource CaptionLabelGrey}"/>

                    <inputLayout:SfTextInputLayout Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,0,16,0">
                        <StackLayout Orientation="Horizontal" Padding="0,8,0,8">
                            <OnPlatform x:TypeArguments="custom:CustomLabel">
                                <On Platform="iOS">
                                    <custom:CustomLabel Text="+966"
                                                        VerticalTextAlignment="Center"
                                                        Style="{StaticResource BodyLabelGrey}" />
                                </On>
                            </OnPlatform>
                            <OnPlatform x:TypeArguments="control:BorderlessEntry">
                                <On Platform="Android">
                                    <control:BorderlessEntry
                                        Placeholder="+966"
                                        VerticalTextAlignment="Center"
                                        Style="{StaticResource DefaultEntry}"
                                        IsEnabled="False" />
                                </On>
                            </OnPlatform>

                            <BoxView WidthRequest="1" HeightRequest="1" BackgroundColor="{StaticResource NeutralLightGrey}"/>

                            <control:BorderlessEntry
                                    Style="{StaticResource DefaultEntry}"
                                    Text="{Binding NewMobileNumberEntryText}"
                                    Keyboard="Numeric"
                                    HorizontalOptions="FillAndExpand">
                            </control:BorderlessEntry>
                        </StackLayout>
                    </inputLayout:SfTextInputLayout>
                </StackLayout>
            </StackLayout>


            <!--OTP View-->
            <StackLayout x:Name="VerificationView" Padding="24"
                         IsVisible="False">
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VerificationCode}" Style="{StaticResource SectionTitleBlackBold}" />
                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDPleaseEnterVerificationSenttomobile}" Style="{StaticResource BodyLabelGrey}"/>
                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1"/>

                <StackLayout Padding="0,15,0,0" >
                    <custom:CustomLabel Text="{Binding NewMobileNumberLabel}"
                                        Style="{StaticResource BodyLabelGrey}"
                                        HorizontalOptions="Center"  HorizontalTextAlignment="Center"/>


                    <Grid Margin="0,-10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,20,30,20" FlowDirection="LeftToRight">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!--First OTP Digit Start-->
                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="0"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                <custom:BorderlessEntry
                                                        x:Name="OTPFirstEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFirstDigit}"
                                                        TextChanged="OtpFirstEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                    <custom:BorderlessEntry.Behaviors>
                                        <local:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry"/>
                                    </custom:BorderlessEntry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--First OTP Digit End-->

                            <!--Second OTP Digit Start-->
                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="1"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                <custom:BorderlessEntry
                                                        x:Name="OTPSecondEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPSecondDigit}"
                                                        TextChanged="OtpSecondEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                    <custom:BorderlessEntry.Behaviors>
                                        <local:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry"/>
                                    </custom:BorderlessEntry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--Second OTP Digit End-->

                            <!--Third OTP Digit Start-->
                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="2"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                <custom:BorderlessEntry
                                                        x:Name="OTPThirdEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPThirdDigit}"
                                                        TextChanged="OtpThirdEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                    <custom:BorderlessEntry.Behaviors>
                                        <local:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry"/>
                                    </custom:BorderlessEntry.Behaviors>
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--Third OTP Digit End-->

                            <!--Fourth OTP Digit Start-->
                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="3"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                <custom:BorderlessEntry
                                                        x:Name="OTPFourthEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFourthDigit}"
                                                        TextChanged="OtpFourthEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand"
                                                        Unfocused="OtpFourthEntry_Unfocused">
                                </custom:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                            <!--Fourth OTP Digit End-->

                        </Grid>
                    </Grid>

                    <StackLayout Orientation="Horizontal" Margin="0,-15,0,0" HorizontalOptions="Center">
                        <Image Source="clock">
                        </Image>
                        <custom:CustomLabel  Text="{Binding LblCountDownTimer}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                    </StackLayout>
                    <buttons:SfButton Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}" VerticalOptions="EndAndExpand" Margin="0,10,0,0" BackgroundColor="Transparent" TextColor="{StaticResource Primary}"/>
                </StackLayout>
            </StackLayout>

            <buttons:SfButton Margin="24,0,24,24"
                              x:Name="btn" Text="Update"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Clicked="UpdatedClicked"/>
        </StackLayout>
    </yummy:PancakeView>
</pages:PopupPage>