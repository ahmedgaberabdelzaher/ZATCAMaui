<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:GAZTBehaviors="clr-namespace:EGAZT"

             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             BackgroundImageSource="partials_background.png"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.VerificationPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackLayout Padding="0,56,0,0" Grid.Row="0">
                <yummy:PancakeView Style="{StaticResource CommonTopCurves}"
                           
                           CornerRadius="10"
                               BorderColor="DarkGray" 
                               BorderThickness="1"
                               BackgroundColor="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <ScrollView Grid.Row="1">
                            <StackLayout >
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VerificationCode}" Style="{StaticResource PageTitleBlack}" />
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TPOTPSentToEmail}" Style="{StaticResource BodyLabelGrey}" Padding="0,0,0,16"/>
                                <BoxView BackgroundColor="{StaticResource NeutralLightGrey}" HeightRequest="1"/>

                                <StackLayout Padding="0,15,0,0" >
                                    <custom:CustomLabel Text="{Binding OTPSentOnThisMobileNumber}"
                                                    Style="{StaticResource BodyLabelGrey}"
                                                    HorizontalOptions="Center"  HorizontalTextAlignment="Center"/>

                                    <Grid Margin="0,-10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,20,30,20" FlowDirection="LeftToRight">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>


                                            <!--First OTP Digit Start-->
                                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="0"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                <custom:BorderlessEntry
                                                        x:Name="OTPFirstEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFirstDigit}"
                                                        TextChanged="OtpFirstEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                    <custom:BorderlessEntry.Behaviors>
                                                        <local:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry"/>
                                                    </custom:BorderlessEntry.Behaviors>
                                                </custom:BorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--First OTP Digit End-->

                                            <!--Second OTP Digit Start-->
                                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="1"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                <custom:BorderlessEntry
                                                        x:Name="OTPSecondEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPSecondDigit}"
                                                        TextChanged="OtpSecondEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                    <custom:BorderlessEntry.Behaviors>
                                                        <local:EntryFocusBehaviour NextFocusElementName="OTPThirdEntry"/>
                                                    </custom:BorderlessEntry.Behaviors>
                                                </custom:BorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--Second OTP Digit End-->

                                            <!--Third OTP Digit Start-->
                                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="2"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                <custom:BorderlessEntry
                                                        x:Name="OTPThirdEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPThirdDigit}"
                                                        TextChanged="OtpThirdEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                    <custom:BorderlessEntry.Behaviors>
                                                        <local:EntryFocusBehaviour NextFocusElementName="OTPFourthEntry"/>
                                                    </custom:BorderlessEntry.Behaviors>
                                                </custom:BorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--Third OTP Digit End-->

                                            <!--Fourth OTP Digit Start-->
                                            <inputLayout:SfTextInputLayout
                                                    Grid.Column="3"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                                <custom:BorderlessEntry
                                                        x:Name="OTPFourthEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFourthDigit}"
                                                        TextChanged="OtpFourthEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand"
                                                        Unfocused="OtpFourthEntry_Unfocused">
                                                </custom:BorderlessEntry>
                                            </inputLayout:SfTextInputLayout>
                                            <!--Fourth OTP Digit End-->

                                        </Grid>

                                    </Grid>


                                    <StackLayout Orientation="Horizontal" Margin="0,-15,0,0" HorizontalOptions="Center">
                                        <Image Source="clock">
                                        </Image>
                                        <custom:CustomLabel  Text="{Binding LblCountDownTimer}" Style="{StaticResource CaptionLabelGrey}" VerticalOptions="Center" />
                                    </StackLayout>
                                    <buttons:SfButton Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                                  VerticalOptions="EndAndExpand"
                                                  Margin="0,16,0,0" BackgroundColor="Transparent"
                                                  TextColor="{StaticResource Primary}"
                                                  Clicked="OnResendOTPBtnClicked"/>
                                </StackLayout>

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.CurrentPassword}" Style="{StaticResource CaptionLabelGrey}"/>
                                <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">


                                    <control:BorderlessEntry x:Name="CurrentPassword"
                                                             Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding CurrentPasswordEntry}"
                                                             IsPassword="True"
                                                             MaxLength="16">
                                         <control:BorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:PasswordTextBehaviour />
                                                        </control:BorderlessEntry.Behaviors>
                     
                                    </control:BorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image x:Name="CurrentPasswordImg"
                                           Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                            Tapped="OnCurrentPasswordTapped" 
                                                            NumberOfTapsRequired="1">
                                                </TapGestureRecognizer>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>


                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NewPassword}" Style="{StaticResource CaptionLabelGrey}"/>
                                <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">

                                    <control:BorderlessEntry x:Name="NewPassword"
                                                             Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding NewPasswordEntry}"
                                                             IsPassword="True"
                                                             MaxLength="16">
                                         <control:BorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:PasswordTextBehaviour />
                                                        </control:BorderlessEntry.Behaviors>
                     
                                    </control:BorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image x:Name="NewPasswordImg"
                                           Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                            Tapped="OnNewPasswordTapped" 
                                                            NumberOfTapsRequired="1">
                                                </TapGestureRecognizer>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZConfirmpassword}" Style="{StaticResource CaptionLabelGrey}"/>
                                <inputLayout:SfTextInputLayout Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">

                                    <control:BorderlessEntry x:Name="ConfirmPassword"
                                                             Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding ConfirmPasswordEntry}"
                                                             IsPassword="True"
                                                             MaxLength="16">
                                         <control:BorderlessEntry.Behaviors>
                                                            <GAZTBehaviors:PasswordTextBehaviour />
                                                        </control:BorderlessEntry.Behaviors>
                     
                                    </control:BorderlessEntry>

                                    <inputLayout:SfTextInputLayout.TrailingView >
                                        <Image x:Name="ConfirmPasswordImg"
                                           Source="hidePassword.png">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                            Tapped="OnConfirmPasswordTapped" 
                                                            NumberOfTapsRequired="1">
                                                </TapGestureRecognizer>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                            </StackLayout>
                        </ScrollView>

                        <Grid Grid.Row="0" BackgroundColor="White" Padding="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackLayout Grid.Column="0" Grid.Row="0" BackgroundColor="White">
                                <Image HorizontalOptions="Start"
                                   Source="arrowLeft.png" Style="{DynamicResource BackButtonArrow}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1"
                                              Tapped="OnBackArrowTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <StackLayout Grid.Column="1" Grid.Row="0" BackgroundColor="White">
                                <Image Source="ic_logo_gazt.png" HeightRequest="30"/>
                            </StackLayout>
                            <StackLayout Grid.Column="2" Grid.Row="0" BackgroundColor="White">
                                <Image HorizontalOptions="End"
                                   Source="closeGrey.png">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1"
                                              Tapped="OnBackArrowTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                        </Grid>

                        <buttons:SfButton Grid.Row="2" x:Name="btn"
                                      Text="{x:Static ResourceManager:AppResources.Verify}"
                                      Clicked="VerifyBtnClicked"
                                      Style="{StaticResource PrimaryButtonStyle}"
                                      IsEnabled="{Binding BtnEnableFlag}"/>
                    </Grid>
                </yummy:PancakeView>
            </StackLayout>


            <Grid Grid.Row="0" Grid.RowSpan="1" Margin="-20"
                      IsVisible="{Binding IsLoading}">
                    <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Black"
                             Opacity="0.4" VerticalOptions="FillAndExpand">
                    </StackLayout>
                    <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Transparent"
                             Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                       EnableAnimation="True"
                                                       AnimationType="SingleCircle"
                                                       HorizontalOptions="CenterAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                       IsBusy="True"
                                                       ViewBoxWidth = "70"
                                                       TitlePlacement="Bottom"
                                                       ViewBoxHeight="70" TextColor="#006450"/>
                        </StackLayout>
                    </StackLayout>
                </Grid>


        </Grid>
    </ContentPage.Content>
</ContentPage>