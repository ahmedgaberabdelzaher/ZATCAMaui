<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.TaxpayerProfileSuccessPage"
    xmlns:custom="clr-namespace:GAZT"
    
    BackgroundImageSource="partials_background.png">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Padding="24"
                     Orientation="Vertical">
            <Image Source="Forget_ic_success.png"
                   Margin="0,90,0,0"/>
            <custom:CustomLabel Text="{Binding SuccessTitleLbl}"
                                Style="{StaticResource SectionTitleWhiteBold}"
                                HorizontalOptions="Center"/>
            <custom:CustomLabel Text="{Binding successCaptionLbl}"
                                HorizontalOptions="Center"
                                Style="{StaticResource CaptionLabelWhite}"/>
            <custom:CustomLabel Text="{Binding ButtonLabelText}"
                                VerticalOptions="EndAndExpand"
                                TextColor="{StaticResource NewDullOrangeColor}"
                                Style="{StaticResource ButtonLabelBlackBold}"
                                HorizontalOptions="Center">
                <custom:CustomLabel.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                          Tapped="OnGoToProfileLblTapped" />
                </custom:CustomLabel.GestureRecognizers>
            </custom:CustomLabel>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
