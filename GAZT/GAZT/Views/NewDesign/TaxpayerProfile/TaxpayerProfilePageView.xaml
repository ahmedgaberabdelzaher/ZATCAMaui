<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             BackgroundImageSource="partials_background.png"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.TaxpayerProfilePageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>


            <Grid Padding="0,20,0,0" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackLayout Grid.Row="1" Padding="24" Orientation="Vertical" Spacing="0">
                    <custom:CustomLabel Text="{Binding TPProfileNameLbl}"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource LoginMenuTitleWhite}"
                                   />

                    <custom:CustomLabel Margin="0,0,0,0"
                                    Text="{Binding ResidenceText}"
                                    Style="{StaticResource BodyLabelBlack}"
                                    HorizontalOptions="StartAndExpand"
                                    TextColor="White"/>
                </StackLayout>
                <ScrollView Grid.Row="2">
                    <yummy:PancakeView Style="{StaticResource CommonTopCurves}" Padding="24,32,24,200" >
                        <StackLayout>
                            <Frame BorderColor="{StaticResource NeutralLightGrey}" HasShadow="False" CornerRadius="16" Padding="16">
                                <StackLayout Orientation="Horizontal">
                                    <StackLayout>
                                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZTERReportDetailTIN}" Style="{StaticResource ValueLabelGrey}"
                                                        HorizontalOptions="Start"/>
                                        <custom:CustomLabel
                                        Text="{Binding TINLabel}"
                                        Style="{StaticResource ValueLabelBlackMedium}"
                                        Margin="0,-10,0,0"/>
                                    </StackLayout>
                                    <yummy:PancakeView  Padding="10,0,10,0" CornerRadius="14"  HeightRequest="32" WidthRequest="59" BorderThickness="1" BackgroundColor="{StaticResource OpacityPrimary}"  VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" >
                                        <custom:CustomLabel Text="{Binding TinStatusLabelText}"
                                                        Style="{StaticResource CaptionLabelGrey}"
                                                        TextColor="{StaticResource Primary}"
                                                        HorizontalOptions="Center"
                                                        VerticalTextAlignment="Center"/>
                                    </yummy:PancakeView>
                                </StackLayout>
                            </Frame>


                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZContactInformation}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource TPProfileLabelBlackBold}"
                                            Margin="0,16,0,0"/>

                            <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.MobileNumber}"
                                                    Style="{StaticResource CaptionLabelGrey}"/>
                                <Image Source="ic_Edit.png" HorizontalOptions="EndAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMobileEditTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <inputLayout:SfTextInputLayout
                            Margin="0,-10,0,0"
                            HorizontalOptions="FillAndExpand"
                            LeadingViewPosition="Inside"
                            ContainerType="Outlined"
                            UnfocusedColor="#B1B1B1"
                            OutlineCornerRadius="8"
                            FocusedColor="#005e4b" ErrorColor="#B00020"
                            InputViewPadding="16,0,16,0" >
                                <StackLayout Orientation="Horizontal"
                                   >
                                    <Entry x:Name="MobileNumberCodeEntry" FlowDirection="LeftToRight" VerticalTextAlignment="Center"
                                                         Style="{StaticResource DefaultEntry}"
                                                         IsReadOnly="True" TextColor="Black" HorizontalOptions="FillAndExpand"
                                                         Text="{Binding MobileNumber}" 
                                                         />
                                </StackLayout>
                            </inputLayout:SfTextInputLayout>
                            </StackLayout>

                 <BoxView Style="{StaticResource lineSeperator}" BackgroundColor="Transparent"/>


                       <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEmail}"
                                                Style="{StaticResource CaptionLabelGrey}"/>
                                <Image Source="ic_Edit.png" HorizontalOptions="EndAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEmailEditTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand"
                                                        LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        FocusedColor="#005e4b" ErrorColor="#B00020"
                                                        InputViewPadding="16,0,16,0">

                                <control:BorderlessEntry Style="{StaticResource DefaultEntry}"
                                                     Text="{Binding EmailEntry}"
                                                    IsReadOnly="True">
                                </control:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                           </StackLayout>
                                             <BoxView Style="{StaticResource lineSeperator}" BackgroundColor="Transparent"/>

                             <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Password}"
                                                Style="{StaticResource CaptionLabelGrey}"/>
                                <Image Source="ic_Edit.png" HorizontalOptions="EndAndExpand">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPasswordEditTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                            <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand"
                                                        LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,0,16,0">
                                <control:BorderlessEntry x:Name="Password"
                                                         Style="{StaticResource DefaultEntry}"
                                                         Text="{Binding PasswordEntry}"
                                                         IsReadOnly="True"
                                                         IsPassword="True">
                                </control:BorderlessEntry>

                            </inputLayout:SfTextInputLayout>
                        </StackLayout>

                        </StackLayout>
                    </yummy:PancakeView>

                </ScrollView>

                <Grid Padding="15,0,15,0"
                  Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <custom:CustomLabel Grid.Column="1"
                                    Text="{x:Static ResourceManager:AppResources.NDProfile}"
                                    Style="{StaticResource SectionTitleWhiteBold}"
                                    HorizontalOptions="Center"
                                    VerticalTextAlignment="Center"/>

                    <StackLayout Grid.Column="0"
                             Padding="0,8,0,0">
                        <Image Source="arrowLeftwhite.png"
                           HorizontalOptions="Start"
                           VerticalOptions="Center" Style="{DynamicResource BackButtonArrow}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackArrowBtnTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </StackLayout>
                </Grid>

            </Grid>


            <Grid Grid.Row="0" Grid.RowSpan="1" Margin="-20"
                      IsVisible="{Binding IsLoading}">
                <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Black"
                             Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0"
                             Orientation="Vertical" BackgroundColor="Transparent"
                             Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                       EnableAnimation="True"
                                                       AnimationType="SingleCircle"
                                                       HorizontalOptions="CenterAndExpand"
                                                       VerticalOptions="CenterAndExpand"
                                                       IsBusy="True"
                                                       ViewBoxWidth = "70"
                                                       TitlePlacement="Bottom"
                                                       ViewBoxHeight="70" TextColor="#006450"/>
                    </StackLayout>
                </StackLayout>
            </Grid>


        </Grid>
    </ContentPage.Content>
</ContentPage>