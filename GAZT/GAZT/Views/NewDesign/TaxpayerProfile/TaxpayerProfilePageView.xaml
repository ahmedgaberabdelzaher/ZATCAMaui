<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             BackgroundImageSource="partials_background.png"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.TaxpayerProfile.TaxpayerProfilePageView">
    <ContentPage.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
            <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
        </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackLayout Grid.Row="1" Padding="24" Orientation="Vertical" Spacing="0">
                <custom:CustomLabel Text="Zaed Hardy" Style="{StaticResource SectionTitleWhiteBold}" FontSize="24"/>
                <custom:CustomLabel Margin="0,-15,0,0" Text="Individual Saudi (Resident)" Style="{StaticResource BodyLabelBlack}" TextColor="White"/>

                <StackLayout Orientation="Horizontal" Spacing="15" Padding="0,0,0,0" >
                    <Image Source="Whiteclock.png" Margin="0,0,0,0"/>
                    <custom:CustomLabel Text="The Last time you accessed was on 06, April, 2020 at 15:45" Style="{StaticResource BodyLabelBlack}" TextColor="White">
                    </custom:CustomLabel>
                </StackLayout>
            </StackLayout>
            <ScrollView Grid.Row="2">
                <yummy:PancakeView Style="{StaticResource CommonTopCurves}" Padding="24,32,24,16">
                <StackLayout>
                    <Frame BorderColor="{StaticResource NeutralLightGrey}" HasShadow="False" CornerRadius="16" Padding="16">
                        <StackLayout Orientation="Horizontal">
                            <StackLayout>
                                <custom:CustomLabel Text="TIN" Style="{StaticResource ValueLabelGrey}"/>
                                <custom:CustomLabel Text="Q973423542" Style="{StaticResource ValueLabelBlackMedium}" Margin="0,-20,0,0"/>
                            </StackLayout>
                            <yummy:PancakeView  Padding="10,0,10,0" CornerRadius="14"  HeightRequest="32" WidthRequest="59" BorderThickness="1" BackgroundColor="{StaticResource OpacityPrimary}"  VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" >
                                <custom:CustomLabel Text="Active" Style="{StaticResource CaptionLabelGrey}" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </yummy:PancakeView>
                        </StackLayout>
                    </Frame>

                    <custom:CustomLabel Text="Contact Information" Style="{StaticResource ValueLabelBlackBold}" Margin="0,16,0,0"/>
                    
                    <StackLayout Orientation="Horizontal">
                    <custom:CustomLabel Text="Mobile Number" Style="{StaticResource CaptionLabelGrey}"/>
                            <Image Source="ic_Edit.png" HorizontalOptions="EndAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMobileEditTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>

                    <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,0,16,0">


                            <StackLayout Orientation="Horizontal" Padding="0,8,0,8">
                                    <control:BorderlessEntry Placeholder="+966" Style="{StaticResource DefaultEntry}"/>
                                <BoxView WidthRequest="1" HeightRequest="1" BackgroundColor="{StaticResource NeutralLightGrey}"/>



                        <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Text="551 234 567" Keyboard="Numeric" >
                        </control:BorderlessEntry>
                            </StackLayout>
                        </inputLayout:SfTextInputLayout>


                    <StackLayout Orientation="Horizontal">
                        <custom:CustomLabel Text="Email" Style="{StaticResource CaptionLabelGrey}"/>
                            <Image Source="ic_Edit.png" HorizontalOptions="EndAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEmailEditTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">


                            <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Text="Zaedhardy@gmail.com" Keyboard="Email" >
                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>


                        <StackLayout Orientation="Horizontal">
                            <custom:CustomLabel Text="Password" Style="{StaticResource CaptionLabelGrey}"/>
                            <Image Source="ic_Edit.png" HorizontalOptions="EndAndExpand">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPasswordEditTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <inputLayout:SfTextInputLayout  Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" LeadingViewPosition="Inside" ContainerType="Outlined"  UnfocusedColor="#B1B1B1" OutlineCornerRadius="8" FocusedColor="#005e4b" ErrorColor="#B00020" InputViewPadding="16,8,16,8">


                            <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Text="kkkkkkkk" IsPassword="True" >
                            </control:BorderlessEntry>

                            <inputLayout:SfTextInputLayout.TrailingView >
                                <Image Source="showPassword.png"/>
                            </inputLayout:SfTextInputLayout.TrailingView>
                        </inputLayout:SfTextInputLayout>

                    </StackLayout>
            </yummy:PancakeView>
            </ScrollView>
            <Grid Padding="15,10,15,10" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="20*"/>
                </Grid.ColumnDefinitions>

                <custom:CustomLabel Grid.Column="1" Grid.Row="0"   Text="My Profile" Style="{StaticResource SectionTitleWhiteBold}" HorizontalTextAlignment="Center"/>

                <StackLayout Grid.Row="0" Grid.Column="0">
                    <Image Source="arrowLeftwhite.png" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                    </Image>
                </StackLayout>
            </Grid>
  
        </Grid>
    </ContentPage.Content>
</ContentPage>