<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.LiveVideo.LiveVideoPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

        <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,5,20,5" ColumnDefinitions="*,2*,*">

                <!--  Live video Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.LiveVideoTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

            <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">
                <Grid RowDefinitions="*,auto">
                    <StackLayout Grid.Row="0" Spacing="20">

                        <!--  Live Video Sub Title Label  -->
                        <Label
                            Margin="0,10,0,0"
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="28"
                            HorizontalOptions="StartAndExpand"
                            Text="{x:Static ResourceManager:AppResources.LiveVideoSubTitle}"
                            TextColor="#58595B" />

                        <Frame
                            Padding="0"
                            BorderColor="#EBEBEB"
                            CornerRadius="20"
                            HeightRequest="250"
                            IsClippedToBounds="True"
                            WidthRequest="470">

                            <xct:MediaElement
                                AutoPlay="True"
                                ShowsPlaybackControls="True"
                                Source="{Binding VideoUrl}" />

                        </Frame>

                        <!--  Live Video Sub Title Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="18"
                            HorizontalOptions="CenterAndExpand"
                            Text="{Binding SelectedVideo}"
                            TextColor="#58595B"
                            VerticalOptions="Center" />

                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


                            <ScrollView VerticalScrollBarVisibility="Never">
                                <Grid
                                    x:Name="videosList"
                                    BindableLayout.ItemsSource="{Binding LiveVideosList}"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="30"
                                    RowDefinitions="150,150"
                                    RowSpacing="30">


                                    <BindableLayout.ItemTemplate>

                                        <DataTemplate>

                                            <Frame
                                                x:Name="Item"
                                                Grid.Row="{Binding Row}"
                                                Grid.Column="{Binding Column}"
                                                Padding="0"
                                                BorderColor="#EBEBEB"
                                                CornerRadius="20"
                                                IsClippedToBounds="True">

                                                <Grid Padding="0" RowDefinitions="*,20">

                                                    <!--  Live video Label  -->
                                                    <Label
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        FontSize="14"
                                                        HorizontalOptions="CenterAndExpand"
                                                        Text="{Binding VideoNumber}"
                                                        TextColor="#58595B"
                                                        VerticalOptions="CenterAndExpand" />

                                                    <!--  Bottom bold frame  -->
                                                    <yummy:PancakeView
                                                        Grid.Row="1"
                                                        BackgroundColor="#0996D4"
                                                        CornerRadius="0,0,15,15"
                                                        HorizontalOptions="FillAndExpand"
                                                        IsVisible="{Binding IsSelected}"
                                                        Style="{StaticResource CommonTopCurves}"
                                                        VerticalOptions="EndAndExpand" />

                                                </Grid>

                                                <Frame.GestureRecognizers>

                                                    <TapGestureRecognizer
                                                        BindingContext="{Binding Source={x:Reference videosList}, Path=BindingContext}"
                                                        Command="{Binding SelectedVideoItemCommand}"
                                                        CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />

                                                </Frame.GestureRecognizers>

                                            </Frame>
                                        </DataTemplate>

                                    </BindableLayout.ItemTemplate>

                                </Grid>
                            </ScrollView>

                        </StackLayout>

                    </StackLayout>

                    <controls:BottomMenu 
                            Grid.Row="1"
                             VerticalOptions="EndAndExpand" />

                </Grid>

            </yummy:PancakeView>

            <!--  Loader  -->
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>
