<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    x:Class="EGAZT.Views.NewDesign.LiveVideo.LiveVideoPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">

     <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>

         <Grid RowDefinitions="Auto,*">

            <!--#region Header-->
            <Grid Padding="20,5,20,5" ColumnDefinitions="*,2*,*"> 

                <!--  Live video Label  -->
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.LiveVideoTitle}"
                    VerticalOptions="Center" />

            </Grid>
            <!--#endregion Header-->

             <!--#region Body-->
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView>

                    <StackLayout Spacing="20">

                        <!--  Live Video Sub Title Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="28"
                            HorizontalOptions="StartAndExpand"
                            Margin="0,10,0,0"
                            Text="{x:Static ResourceManager:AppResources.LiveVideoSubTitle}"
                            TextColor="#58595B" />

                        <Frame CornerRadius="20"
                                IsClippedToBounds="True"
                                Padding="0"
                                WidthRequest="470"
                                HeightRequest="250"
                                BorderColor="#EBEBEB">

                            <xct:MediaElement 
                                              AutoPlay="True"
                                              ShowsPlaybackControls="True"
                                              Source="{Binding VideoUrl}"/>

                        </Frame>

                        <!--  Live Video Sub Title Label  -->
                        <Label
                            FontFamily="{StaticResource SomarRegular}"
                            FontSize="18"
                            HorizontalOptions="CenterAndExpand"
                            VerticalOptions="Center"
                            Text="{Binding SelectedVideo}"
                            TextColor="#58595B" />

                        <StackLayout VerticalOptions="FillAndExpand"
                                     HorizontalOptions="FillAndExpand">



                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="30"
                                  RowSpacing="30"
                                  x:Name="videosList"
                                  BindableLayout.ItemsSource="{Binding LiveVideosList}"
                                  RowDefinitions="150,150">

                                
                                <BindableLayout.ItemTemplate>

                                    <DataTemplate>

                                        <Frame  CornerRadius="20"
                                                IsClippedToBounds="True"
                                                Padding="0"
                                                x:Name="Item"
                                                Grid.Row="{Binding Row}"
                                                Grid.Column="{Binding Column}"
                                                BorderColor="#EBEBEB">

                                                <Grid RowDefinitions="*,20"
                                                      Padding="0">

                                                    <!--  Live video Label  -->
                                                    <Label
                                                        FontFamily="{StaticResource SomarRegular}"
                                                        FontSize="14"
                                                        HorizontalOptions="CenterAndExpand"
                                                        VerticalOptions="CenterAndExpand"
                                                        Text="{Binding VideoNumber}"
                                                        TextColor="#58595B" />

                                                     <!--Bottom bold frame-->
                                                     <yummy:PancakeView
                                                        Grid.Row="1"
                                                        CornerRadius="0,0,15,15"
                                                        VerticalOptions="EndAndExpand"
                                                        HorizontalOptions="FillAndExpand"  
                                                        BackgroundColor="#0996D4"
                                                        IsVisible="{Binding IsSelected}"
                                                        Style="{StaticResource CommonTopCurves}"/>

                                                </Grid>

                                                <Frame.GestureRecognizers>

                                                    <TapGestureRecognizer
                                                        BindingContext="{Binding Source={x:Reference videosList},Path=BindingContext}"
                                                        Command="{Binding SelectedVideoItemCommand}"
                                                        CommandParameter="{Binding Source={x:Reference Item}, Path=BindingContext}" />

                                                </Frame.GestureRecognizers>

                                         </Frame>
                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </Grid>

                        </StackLayout>
                       



                    </StackLayout>

                </ScrollView>

            </yummy:PancakeView>

              <!--Loader-->  
            <controls:Loader Grid.RowSpan="2" IsVisible="{Binding IsLoading}" />

        </Grid>

    </ContentPage.Content>
</ContentPage>
