<?xml version="1.0" encoding="UTF-8"?>
<pages:PopupPage  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                  xmlns="http://xamarin.com/schemas/2014/forms"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:custom="clr-namespace:GAZT"
                  xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                  xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                  xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
                  xmlns:local="clr-namespace:EGAZT.CustomControl"
                          xmlns:ResourceManager="clr-namespace:EGAZT"
                               xmlns:custom2="clr-namespace:EGAZT"
                           xmlns:FontImage="clr-namespace:MVP.FontIcons"
                  x:Class="EGAZT.Views.NewDesign.VATDeRegistration.VATDeregistrationInstructionsPage">
        <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </ContentPage.Resources>
    
         <yummy:PancakeView BackgroundColor="Transparent" CornerRadius="32,32,0,0" Padding="0" Margin="0,0,0,0">
            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White">

                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="80*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <!--<Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1" Grid.Column="0"  Margin="0" 
                  Padding="15,15,15,0" BackgroundColor="White" RowSpacing="0" >
                    <Grid.RowDefinitions >
                        <RowDefinition Height="100*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <WebView x:Name="TCWebView" HeightRequest="200" WidthRequest="300" HorizontalOptions="FillAndExpand" />
                </Grid>-->
                 <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}" Grid.Row="1" Grid.Column="0">
                    <StackLayout Orientation="Horizontal" Padding="15">
<Image>
                            <Image.Source>
                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.Information}"/>
                            </Image.Source>
                        </Image>
                        <Label Text="TIN Number" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Vertical" >
                            <Label Text="3101503102" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>

                        </StackLayout>                      
                    </StackLayout>
                </border:SfBorder >
                <StackLayout Grid.Row="2" Grid.Column="0"  Margin="0,0,0,0" VerticalOptions="End" HorizontalOptions="FillAndExpand"  BackgroundColor="White" >
                    <!--<CheckBox x:Name="chkTAndC"   IsChecked="{Binding IschkTAndC}"  Margin="10,0,0,0" VerticalOptions="Center">
                    </CheckBox>
                    <custom:CustomLabel Text="{x:Static custom2:AppResources.ZZIagreeontermsAndconditions}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalOptions="Start" VerticalOptions="Center"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Margin="0,0,10,0"/>-->
                    <StackLayout BackgroundColor="White" HeightRequest="70" Margin="0,0,0,0" WidthRequest="1000" Orientation="Horizontal" VerticalOptions="Center">
                        <!--<buttons:SfCheckBox x:Name="checkBox"  VerticalOptions="Center" IsChecked="{Binding IschkTAndC}" LineBreakMode="WordWrap" Text="{x:Static local:AppResources.ZZIagreeontermsAndconditions}" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" />-->
                        <CheckBox x:Name="chkTAndC"   IsChecked="{Binding IschkTAndC}"  Margin="10,0,0,0" VerticalOptions="Center">
                        </CheckBox>
                        <custom:CustomLabel Text="{x:Static custom2:AppResources.ZZIagreeontermsAndconditions}"   FontFamily="{StaticResource GAZT_FONT_MEDIUM}" HorizontalOptions="Start" HorizontalTextAlignment="Center" VerticalOptions="Center"  Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}" Margin="0,0,10,0"/>
                    </StackLayout>
               <buttons:SfButton Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,16"  x:Name="btnContinueSummary" Command="{Binding SummaryContinueBtnTapped}" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                   Style="{StaticResource PrimaryButtonStyle}"/> <!--Clicked="btnContinue_Clicked"-->
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" BackgroundColor="White" Padding="0" Margin="15,-15,15,0">

                        <Label Text="Instructions &amp; Conditions"  VerticalOptions="Center" HorizontalOptions="StartAndExpand"/>
                   
                </StackLayout>
                
            </Grid>
        </yummy:PancakeView>
</pages:PopupPage>

