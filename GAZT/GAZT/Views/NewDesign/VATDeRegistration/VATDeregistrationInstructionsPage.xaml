<?xml version="1.0" encoding="UTF-8"?>
<pages:PopupPage  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                  xmlns="http://xamarin.com/schemas/2014/forms"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:custom="clr-namespace:GAZT"
                  xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                  xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                  xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
                  xmlns:local="clr-namespace:EGAZT.CustomControl"
                  xmlns:ResourceManager="clr-namespace:EGAZT"
                  xmlns:custom2="clr-namespace:EGAZT"
                  xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:custom1="clr-namespace:GAZT.CustomControl"
                  x:Class="EGAZT.Views.NewDesign.VATDeRegistration.VATDeregistrationInstructionsPage" NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <yummy:PancakeView BackgroundColor="White" CornerRadius="15,15,0,0"  HorizontalOptions="End" VerticalOptions="End" IsVisible="true">
        <StackLayout BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="End" Margin="24,8,24,0">
            <BoxView Style="{StaticResource NeutralGrayBoxViewDrag}" HorizontalOptions="Center" VerticalOptions="Start"/>
            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}" Margin="0,0,0,16"  />
            <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">
                <StackLayout Margin="8">
                    <StackLayout Orientation="Horizontal" Spacing="0">
                       <Image HeightRequest="24" WidthRequest="24" Source="information" HorizontalOptions="Start" VerticalOptions="Center"/>
                       <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Information}" Margin="10,0,10,5"  HorizontalOptions="End"
                            Style="{StaticResource ValueLabelBlack}"/>
                    </StackLayout>
                   <StackLayout Orientation="Vertical" Spacing="0">

                    <Label Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructions}" HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}" />
                     <Label Text="{x:Static ResourceManager:AppResources.VATDeregInstructionsAndConditionsFirst}"  Style="{StaticResource CaptionLabelGrey}" Margin="0"/>
                      <Label   Text="{x:Static ResourceManager:AppResources.VATDeregInstructionsAndConditionsSecond}"  Style="{StaticResource CaptionLabelGrey}" Margin="0"/>
                       </StackLayout>
                </StackLayout>
            </border:SfBorder>
            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="End">
 <custom1:CheckboxCustom  Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsInstructionChecked}" IsEnabled="{Binding isInstructionCheckedEnable}"
                                                                             Style="{StaticResource CheckboxHeightWidth32}"/>
         

                <!--<CheckBox x:Name="chkDeclaration" Color="{StaticResource NeutralGreay}" VerticalOptions="CenterAndExpand" IsChecked="{Binding IsInstructionChecked}">
                    <CheckBox.Triggers>
                        <DataTrigger TargetType="CheckBox"  Value="false">
                            <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                        </DataTrigger>
                    </CheckBox.Triggers>
                </CheckBox>-->
                <custom:CustomLabel Margin="5,10,0,15"  Style="{DynamicResource IsInstructionCheckedStyle}" >
                    <custom:CustomLabel.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static custom2:AppResources.ZZZVATRInstrunctionsAndConditionsAgreeCondition}"  />
                        </FormattedString>
                    </custom:CustomLabel.FormattedText>
                      <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsInstructionChecked}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsInstructionChecked}" Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                </custom:CustomLabel>
           </StackLayout>
           <buttons:SfButton Grid.ColumnSpan="2" Margin="0,24,0,24" IsEnabled="{Binding IsContinueButtonEnable}" BackgroundColor="{Binding ContinueButtonnBackroundColor}" x:Name="btnVATDeregistration" Command="{Binding VATDeregistrationClicked}" Text="{x:Static ResourceManager:AppResources.VATDeregistration}"
                                   Style="{StaticResource PrimaryButtonStyle}"/>
    </StackLayout>
    </yummy:PancakeView>

</pages:PopupPage>

