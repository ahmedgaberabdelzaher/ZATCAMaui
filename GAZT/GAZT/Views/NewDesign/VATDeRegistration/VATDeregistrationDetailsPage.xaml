<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"        
                   xmlns:ResourceManager="clr-namespace:EGAZT"
                          xmlns:custom2="clr-namespace:EGAZT"
                          xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:local="clr-namespace:EGAZT"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
          xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             x:Class="EGAZT.Views.NewDesign.VATDeRegistration.VATDeregistrationDetailsPage"
             NavigationPage.HasNavigationBar="False" BackgroundColor="#006450" >
   <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>
                   

                    <yummy:PancakeView Grid.Row="1" BackgroundColor="White" CornerRadius="15,15,0,0" Padding="0,0,0,0">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                       
                        <Grid Grid.Row="1" RowSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" Padding="0,15,0,0" BackgroundColor="White"
                              x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>

                            <ContentPresenter VerticalOptions="FillAndExpand"
                                HorizontalOptions="FillAndExpand"
                                Grid.Column="0"
                                Grid.Row="0" BackgroundColor="White"/>
                        </Grid>

                        <StackLayout Orientation="Horizontal" BackgroundColor="White" Grid.Row="0" VerticalOptions="CenterAndExpand" >

                            <custom:CustomLabel BackgroundColor="Transparent" Padding="0,35,0,0" Margin="0" HorizontalOptions="Start" Style="{StaticResource IconLabelStyle}" Text="{DynamicResource Back}">
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding BindingContext.BackButtonTapped}"  />
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>
                            <commonView:PageIndicatorView Margin="0,35,0,0"  
                                                              Grid.Row="1" Grid.Column="0" MaxNum="{TemplateBinding BindingContext.MaxIndex}"
                                                              MinNum="{TemplateBinding BindingContext.CurrentIndex}"
                                                              Completed="{TemplateBinding BindingContext.MarkComplete}" VerticalOptions="CenterAndExpand"/>
                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>

                    <Grid Padding="0,10,0,10" Grid.Row="0" Margin="8,0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VATDeregistration}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"/>
                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}" Source="arrowLeftwhite"  VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image  Grid.Row="0" IsVisible="{TemplateBinding BindingContext.VoidIsVisible}" Grid.Column="2" Source="close" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="voidTapped" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

     <ContentPage.Content>
        <Grid>
            <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
               <Grid>
                  <Grid IsVisible="{Binding IsReasonViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                      <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

               
                     <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VatDeregDetailsTitle}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource SectionTitleBlack}" />
                     
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VatDeregDeclarationSubtitle}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>
                    </Grid>
      
                     <custom:CustomLabel Grid.Row="1" Text="{x:Static ResourceManager:AppResources.VatDeregRequestType}" HorizontalOptions="StartAndExpand"
                                                   Style="{StaticResource CaptionLabelGrey}" />   
                  <listView:SfListView x:Name="outletDecisionOptionsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" AutoFitMode="Height" ItemSpacing="5"
                                          ItemsSource="{Binding OutletDecisionOptions}" SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"  SelectionMode="Single"
                                          SelectionBackgroundColor="Transparent" SelectionChanged="outletDecisionOptionsListView_SelectionChanged" >
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
					                    <cards1:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="100">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                                    <Image Source="vat_tile_listofsignup_W" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <Label Text="{Binding ActiveOutletDecisionOptions}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                        Margin="20,0,20,20" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                    </Label>
                                                </Grid>
                                        </cards1:SfCardView>
			                    </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                          <listView:SfListView.SelectedItemTemplate>
                                <DataTemplate>
					                    <cards1:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="100">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                                    <Image Source="vat_tile_listofsignup" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <Label Text="{Binding ActiveOutletDecisionOptions}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                        Margin="20,0,20,20" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                    </Label>
                                                </Grid> 
                                        </cards1:SfCardView>
			                    </DataTemplate>
                           </listView:SfListView.SelectedItemTemplate>
                            <listView:SfListView.LayoutManager>
                                <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                            </listView:SfListView.LayoutManager>
                     </listView:SfListView>
                                 <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0" Grid.Column="0">
                         
                             <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" />   
                                <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="10,0,10,0"  Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">
                                        
                                        <Label Text="{Binding ReasonTitle}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown" Margin="5,0" WidthRequest="15" HeightRequest="15"
                                                   HorizontalOptions="Start" VerticalOptions="Center">

                                            </Image>

                                        </StackLayout>
                                          <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnVatRegistrationReasonTapped}" ></TapGestureRecognizer>
                                        </StackLayout.GestureRecognizers>
                                    </StackLayout>
                                </border:SfBorder >
                                 <StackLayout Spacing="2">
                                        <inputLayout:SfTextInputLayout x:Name="OthersTxt" LeadingViewPosition="Inside" TrailingViewPosition="Inside"  Margin="10,0,10,0" 
                                        ContainerType="Outlined"  UnfocusedColor="#B1B1B1" IsVisible="{Binding IsOthersEditorVisible}" HelperText="{Binding TextCount}" 
                                        OutlineCornerRadius="15" FocusedColor="#005e4b" ErrorColor="#B00020">

                                            <Entry Style="{StaticResource DefaultEntry}" Text="{Binding OtherField}" TextChanged="Others_Entry_TextChanged"  HeightRequest="100" MaxLength="1000"/>
             
                                        </inputLayout:SfTextInputLayout>
                                     <!--<Label Text="no of characters remaining"/>-->
                                 </StackLayout>
                        </StackLayout>
                        
                    </Grid>
                     
                        <StackLayout Orientation="Vertical" Grid.Row="4" Grid.Column="0"  Grid.ColumnSpan="2" HorizontalOptions="FillAndExpand">
                                 <StackLayout.Triggers>
                                     <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedOutletOptionIndex}" Value="0">
                                        <Setter Property="IsVisible" Value="false" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="StackLayout" Binding="{Binding SelectedOutletOptionIndex}" Value="1">
                                        <Setter Property="IsVisible" Value="true" />
                                    </DataTrigger>
                                </StackLayout.Triggers>
                        <StackLayout>
                        <StackLayout>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedStartDate}" HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" />   
                                    <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="10,0,10,0"  Style="{StaticResource GreyBorderFrame}">

                                        <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">
                                            <StackLayout Orientation="Horizontal" HorizontalOptions="Start">
                                             <Label Text="{Binding FromDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                                 Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                    </Image.Source>
                                                </Image>

                                            </StackLayout>
                                                          <StackLayout.GestureRecognizers>
                                                 <TapGestureRecognizer x:Name="StartDate" Tapped="VATDeregStartDateClicked" ></TapGestureRecognizer>
                                             </StackLayout.GestureRecognizers>

                                        </StackLayout>
                                    
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="End">
                                             <Label Text="{Binding ToDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                            <StackLayout HorizontalOptions="End" Orientation="Horizontal" >
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                                 Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                    </Image.Source>
                                                </Image>

                                            </StackLayout>

                                            <StackLayout.GestureRecognizers>
                                                 <TapGestureRecognizer x:Name="EndDate" Tapped="VATDeregEndDateClicked" ></TapGestureRecognizer>
                                             </StackLayout.GestureRecognizers>

                                        </StackLayout>
                                        </StackLayout>
                                    </border:SfBorder >
                                </StackLayout>
                                  <StackLayout Orientation="Vertical">
                                       <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VatDeregSuspendedFilingPeriod}" HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" /> 
                                       <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="10,0,10,0"  Style="{StaticResource GreyBorderFrame}">

                                        <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">
                                             <Label Text="{Binding SuspendedStartDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Center"/>
                                                <Image Margin="5,0">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                                 Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                                    </Image.Source>
                                                </Image>
                                          <Label Text="{Binding SuspendedEndDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="End"/>


                                        </StackLayout>
                                    </border:SfBorder >
                                 </StackLayout >
                                <StackLayout Orientation="Vertical" >
                                       <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VatDeregNextFilingPeriod}" HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" /> 
                                       <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="10,0,10,0"  Style="{StaticResource GreyBorderFrame}">

                                        <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">
                                             <Label  Text="{Binding NextFilingStartDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                                <Image Margin="5,0" HorizontalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                                 Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                                    </Image.Source>
                                                </Image>
                                          <Label  Text="{Binding NextFilingEndDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="End"/>

                                        </StackLayout>
                                    </border:SfBorder >
                                </StackLayout >
                                   <StackLayout Orientation="Vertical" >
                                       <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.VatDeregNextFilingDueDate}" HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" /> 
                                       <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="10,0,10,0"  Style="{StaticResource GreyBorderFrame}">

                                        <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">
                                             <Label Text="{Binding NextFilingDueDate,StringFormat='{0:dd MMM yyyy}' }" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Center"/>
                     
                                        </StackLayout>
                                    </border:SfBorder >
                                </StackLayout >
                  </StackLayout>
                </StackLayout>
                      <buttons:SfButton Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,10,0,36"  x:Name="btnReasonContinue" Command="{Binding ReasonContinueBtnTapped}" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                       Style="{StaticResource PrimaryButtonStyle}"/>
              
                </Grid>
                  <Grid IsVisible="{Binding IsAttachmentsViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                         <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                     <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                             <RowDefinition Height="auto"/>
                             <RowDefinition Height="auto"/>
                             <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VatDeregAttachmentsHeaderTitle}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource SectionTitleBlack}" />
                     
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VatDeregDocumentselectionTitle}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource BodyLabelGrey}" Margin="0,0,0,8" />

                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                           <listView:SfListView Grid.Row="3" Grid.Column="0" x:Name="outletDocumentOptionsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                          ItemsSource="{Binding AttachmentTypes}" SelectedItem="{Binding SelectedDocumentOption, Mode=TwoWay}"  SelectionMode="Single"
                                          SelectionBackgroundColor="Transparent" SelectionChanged="outletDocumentOptionsListView_SelectionChanged" >
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
					                    <cards1:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="100">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                                    <Image Source="vat_tile_listofsignup_W" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <Label Text="{Binding Txt50}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                        Margin="20,0,20,20" TextColor="Black" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                    </Label>
                                                </Grid>
                                        </cards1:SfCardView>
			                    </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                          <listView:SfListView.SelectedItemTemplate>
                                <DataTemplate>
					                    <cards1:SfCardView HasShadow="True" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="100">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" ColumnSpacing="20" RowSpacing="10">
                                                    <Image Source="vat_tile_listofsignup" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                    <Label Text="{Binding Txt50}" Style="{StaticResource CaptionLabelBlack}" HorizontalOptions="StartAndExpand" VerticalOptions="EndAndExpand"
                                                                        Margin="20,0,20,20" TextColor="White" HorizontalTextAlignment="Start" LineHeight="0.8">
                                                    </Label>
                                                </Grid> 
                                        </cards1:SfCardView>
			                    </DataTemplate>
                           </listView:SfListView.SelectedItemTemplate>

                            <listView:SfListView.LayoutManager>
                                <listView:GridLayout x:Name="GridLayout1" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                            </listView:SfListView.LayoutManager>
                     </listView:SfListView>
                    </Grid>
               
                    <listView:SfListView  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="attachmentsListView" HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                          ItemsSource="{Binding VatAttachmentsList}" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent" >
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
					                    <StackLayout Spacing="2">
                                            <Label Text="{Binding AttachmentTitle,Mode=TwoWay}" HorizontalOptions="StartAndExpand"
                                                                    Style="{StaticResource CaptionLabelGrey}" VerticalTextAlignment="Start" FlowDirection="LeftToRight" />   
                                            <inputLayout:SfTextInputLayout  IsEnabled="True"  LeadingViewPosition="Inside" TrailingViewPosition="Inside"  Margin="0" 
                                            ContainerType="Outlined"  UnfocusedColor="#B1B1B1" 
                                            OutlineCornerRadius="12" FocusedColor="#B1B1B1" ErrorColor="#B00020">

                                                <Entry Style="{StaticResource DefaultEntry}" IsEnabled="False" Text="{Binding Filename,Mode=TwoWay}"
                                                       Placeholder="{x:Static custom2:AppResources.VatDeregAttachmentInputPlaceholder}" HorizontalTextAlignment="Start"
                                                       VerticalOptions="Center"/>

                                                <inputLayout:SfTextInputLayout.TrailingView>
                                                    <Image  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_delete.png"  >
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </inputLayout:SfTextInputLayout.TrailingView>
                                                
                                            </inputLayout:SfTextInputLayout>
                        <Label Text="{Binding FileSize,Mode=TwoWay}" HorizontalOptions="StartAndExpand" Margin="0,-12,0,0"
                                                    Style="{StaticResource CaptionLabelGrey}" /> 
                     </StackLayout>

			                    </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                     </listView:SfListView>
                           <StackLayout Grid.Row="4" Spacing="2" Grid.ColumnSpan="2">
                      <Label Text="{x:Static custom2:AppResources.VATRNewAttachment}"    Style="{StaticResource CaptionLabelGrey}"/>
                                                        <inputLayout:SfTextInputLayout  Margin="10,-6,0,-6" 
                                                ContainerType="Outlined" x:Name="FrmAttachmentOptional" UnfocusedColor= "#bbbbbb"
                                                OutlineCornerRadius="8" FocusedColor="#bbbbbb" ErrorColor="#B00020" HasError="False" >
                                                                <!--Attachments-->
                                                    <Entry IsEnabled="False" Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                                                           HorizontalTextAlignment="Start" VerticalOptions="Center"/>
  
                                                         <inputLayout:SfTextInputLayout.TrailingView>
                                                            <Image  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_attachment.png"  >
                                                                <Image.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                                                </Image.GestureRecognizers>
                                                            </Image>
                                            
                                                        </inputLayout:SfTextInputLayout.TrailingView>
                                                        </inputLayout:SfTextInputLayout>
                                        <Label Text="{x:Static custom2:AppResources.VatDeregAttachmentInputsizeLarge}"  Style="{StaticResource CaptionLabelGrey}"/>
                                    </StackLayout>
         <StackLayout Grid.Row ="5" Orientation="Vertical" Grid.ColumnSpan="2" Margin="10,0,10,0">
           <Label HorizontalTextAlignment="Start"   Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote1}"  Margin="0,0,0,0" TextColor="#005e4b" HorizontalOptions="StartAndExpand"  Style="{StaticResource CaptionLabelGrey}"/>
                    <Label HorizontalTextAlignment="Start"  Text="{x:Static custom2:AppResources.ZZZZVATRAttachmentNote2}"   Margin="0,0,0,0" TextColor="#005e4b" HorizontalOptions="StartAndExpand" Style="{StaticResource CaptionLabelGrey}"/>
                         <Label HorizontalTextAlignment="Start"   Text="{x:Static custom2:AppResources.ZMaximumnoof5attachmentscanbeuploaded}"   Margin="0,0,0,0" TextColor="#005e4b" HorizontalOptions="StartAndExpand" Style="{StaticResource CaptionLabelGrey}"/>
             </StackLayout>
                     <buttons:SfButton  Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,10,0,36" x:Name="btnAttachmentsContinue"
                                       Command="{Binding AttachmentsContinueBtnTapped}" Text="{x:Static ResourceManager:AppResources.ZZZZContinue}"
                                       Style="{StaticResource PrimaryButtonStyle}"/>
                    
 
                </Grid>
                  <Grid IsVisible="{Binding IsDeclarationViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                             <RowDefinition Height="auto"/>
                             <RowDefinition Height="auto"/>
                             <RowDefinition Height="auto"/>
                             <RowDefinition Height="auto"/>
                             <RowDefinition Height="auto"/>
                             <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>
                             <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                 <RowDefinition Height="auto"/>
                                 <RowDefinition Height="auto"/>
                                 <RowDefinition Height="1"/>
                                </Grid.RowDefinitions>
