<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             NavigationPage.HasNavigationBar="False"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"             
            xmlns:local="clr-namespace:EGAZT" xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             x:Class="EGAZT.Views.NewDesign.VATDeRegistration.VATDeregistrationSuccessPage"
             BackgroundImageSource="partials_background">
   <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView>
        <StackLayout>
            <StackLayout Padding="40" VerticalOptions="CenterAndExpand" BackgroundColor="Transparent">
                <Image Source="Forget_ic_success.png"   Aspect="AspectFit"/>
                <Label Text="VAT Deregistration" FontFamily="{StaticResource SSTArBold}"  FontSize="Large" TextColor="White" HorizontalTextAlignment="Center"/>
                <Label Text="VAT Deregistration Submitted Successfully"  FontFamily="{StaticResource SSTArabicMedium}"
                       TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </StackLayout>
            <yummy:PancakeView BackgroundColor="White" CornerRadius="22,22,0,0" Padding="20"  Margin="0,20,0,0" VerticalOptions="EndAndExpand">
                <StackLayout >
              
                  <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
               <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                        <Label  Text="Name" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                       <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                            <Label Text="Zaey Hardy" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>

                        </StackLayout>

                   </StackLayout>
                 
                </border:SfBorder>
                     
                  <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                   
                      <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                        <Label  Text="Application Number" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                          <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                            <Label Text="123456789" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>

                        </StackLayout>
                   </StackLayout>
                 
                </border:SfBorder>
                     
                  <border:SfBorder   Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrame}">
                   
                    <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                        <Label  Text="Date" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>
                         <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                            <Label Text="08 August 2020" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>

                        </StackLayout>

                   </StackLayout>
                </border:SfBorder>
                  
                  <buttons:SfButton x:Name="btnVATRegistration" FontFamily="{StaticResource SSTArabicMedium}" Text="VAT Registration Services"  CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="56" Clicked="btnVATRegistration_Clicked"   Margin="10,10,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource SfButtonStyle}" BackgroundColor="#d49504" /> 
                    <buttons:SfButton x:Name="btnDashboard"   Text="{x:Static local:AppResources.ZZZZGotoDashboard}" CornerRadius="10" VerticalOptions="End" FontAttributes="Bold" 
                                      HeightRequest="46" Clicked="btnDashboard_Clicked"  FontFamily="{StaticResource SSTArabicMedium}"  Margin="10,0,10,0" FontSize="15"   Grid.ColumnSpan="2" 
                                      Style="{StaticResource SfButtonStyle}" BackgroundColor="Transparent" TextColor="#d49504" />
                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
            </ScrollView>
    </ContentPage.Content>
</ContentPage>
