                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsNextButtonEnable}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsNextButtonEnable}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource NeutralGreay}"/>
                                </DataTrigger>
                            </buttons:SfButton.Triggers>
                        </buttons:SfButton>
