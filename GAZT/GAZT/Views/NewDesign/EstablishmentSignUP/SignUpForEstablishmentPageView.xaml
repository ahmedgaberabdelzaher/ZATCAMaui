                                                            <TapGestureRecognizer CommandParameter="7" Tapped="OTPTap" />
                                                        </inputLayout:SfTextInputLayout.GestureRecognizers>
                                                    </custom:BorderlessEntry>
                                                </inputLayout:SfTextInputLayout>
                                                <!--  Third OTP Digit End  -->

                                                <!--  Fourth OTP Digit Start  -->
                                                <inputLayout:SfTextInputLayout
                                                    Grid.Column="3"
                                                    ContainerType="Outlined"
                                                    ErrorColor="#B00020"
                                                    FocusedColor="{StaticResource Primary}"
                                                    HasError="False"
                                                    OutlineCornerRadius="8"
                                                    UnfocusedColor="#B1B1B1">
                                                    <custom:BorderlessEntry
                                                        x:Name="MobOTPFourthEntry"
                                                        FontFamily="{StaticResource SomarBold}"
                                                        FontSize="Small"
                                                        HorizontalOptions="CenterAndExpand"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding MIsOTPEntryEnable}"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        ReturnType="Next"
                                                        Text="{Binding MOTPFourthDigit}"
                                                        TextChanged="MobOTPFourthEntry_TextChanged"
                                                        TextColor="#bbbbbb"
                                                        WidthRequest="15" />
                                                    <inputLayout:SfTextInputLayout.GestureRecognizers>
                                                        <TapGestureRecognizer CommandParameter="8" Tapped="OTPTap" />
                                                    </inputLayout:SfTextInputLayout.GestureRecognizers>
                                                </inputLayout:SfTextInputLayout>
                                                <!--  Fourth OTP Digit End  -->

                                            </Grid>


                                        </Grid>
                                    </StackLayout>

                                    <StackLayout
                                        Margin="0,-30,0,0"
                                        HorizontalOptions="Center"
                                        Orientation="Horizontal">
                                        <Image Source="clock" />

                                        <custom:CustomLabel
                                            FontFamily="{StaticResource SomarBold}"
                                            FontSize="11"
                                            Text="{Binding LblCountDownTimer}"
                                            TextColor="{StaticResource Primary}" />
                                    </StackLayout>
                                    <buttons:SfButton
                                        Margin="0,50,0,0"
                                        BackgroundColor="Transparent"
                                        Command="{Binding OnResendOTPClicked}"
                                        FontFamily="{StaticResource SomarBold}"
                                        IsEnabled="{Binding IsResendOTPEnabled}"
                                        Text="{x:Static ResourceManager:AppResources.NDResendVerificationCode}"
                                        TextColor="{Binding ButtonDisableTextColor}"
                                        VerticalOptions="EndAndExpand">
                                        <buttons:SfButton.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsResendOTPEnabled}"
                                                TargetType="buttons:SfButton"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding IsResendOTPEnabled}"
                                                TargetType="buttons:SfButton"
                                                Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource NeutralGreay}" />
                                            </DataTrigger>
                                        </buttons:SfButton.Triggers>
                                    </buttons:SfButton>
                                </StackLayout>
                            </StackLayout>
                            <!--  Verification Mobile Ends  -->

                            <!--  Password Starts  -->
                            <StackLayout>
                                <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">

                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.NDNewPassword}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="8"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}"
                                        UnfocusedColor="#B1B1B1">

                                        <control:BorderlessEntry
                                            x:Name="EntryPass"
                                            IsPassword="{Binding IsPasswordEncripted}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtPassword}"
                                            TextChanged="EntryPass_TextChanged"
                                            TextColor="{StaticResource NeutralBlack}">
                                            <control:BorderlessEntry.Behaviors>
                                                <ResourceManager:PasswordTextBehaviour />
                                            </control:BorderlessEntry.Behaviors>
                                        </control:BorderlessEntry>

                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image x:Name="imageNewPassword" Source="showPassword.png">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ImageSeeNewPassword_Tapped" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>
                                <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">

                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZZZRepeatPassword}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                    <inputLayout:SfTextInputLayout
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="8"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}"
                                        UnfocusedColor="#B1B1B1">

                                        <control:BorderlessEntry
                                            x:Name="EntryCfrmPass"
                                            IsPassword="{Binding IsConfirmPasswordEncripted}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtConfirmPassword}"
                                            TextChanged="EntryCfrmPass_TextChanged"
                                            TextColor="{StaticResource NeutralBlack}">

                                            <control:BorderlessEntry.Behaviors>
                                                <ResourceManager:PasswordTextBehaviour />
                                            </control:BorderlessEntry.Behaviors>
                                        </control:BorderlessEntry>

                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image x:Name="imageConfirmPassword" Source="showPassword.png">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="ImageSeeConfirmPassword_Tapped" />
                                                </Image.GestureRecognizers>
                                            </Image>

                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                </StackLayout>



                                <StackLayout x:Name="PasswordChecks" Margin="0,20,0,0">
                                    <StackLayout Orientation="Horizontal" Spacing="16">
                                        <Image Source="{Binding MinEight}" />
                                        <custom:CustomLabel
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.NDAtleast8character}" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="16">
                                        <Image Source="{Binding CapsSmall}" />
                                        <custom:CustomLabel
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.NDEnglishcapitalandsmallletters}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="16">
                                        <Image Source="{Binding MaxSixteen}" />
                                        <custom:CustomLabel
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZZNotexceed16characters}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="16">
                                        <Image Source="{Binding NumSymbol}" />
                                        <custom:CustomLabel
                                            Padding="5,-5,0,0"
                                            Style="{StaticResource BodyLabelBlack}"
                                            Text="{x:Static ResourceManager:AppResources.NDNumbersAndSymbols}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                            <!--  Password Ends  -->

                        </StackLayout>
                    </ScrollView>
                    <!--  Start step 6  -->
                    <ScrollView
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.MobileVerification}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout>

                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0,10,0,10">
                                    <Grid Padding="10,0,10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--<Frame Style="{StaticResource circleFrame}" Grid.Row="0" Grid.Column="0">
                                        <Image Margin="0" Source="vat_user.png" >



                                        </Image>
                                    </Frame>-->
                                        <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>-->

                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="vat_user"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <custom:CustomLabel
                                                Padding="8,0"
                                                Style="{StaticResource SectionTitleBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZIndividualInformation}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>


                                        <buttons:SfButton
                                            x:Name="Btn_Edit_indiviadualInfo"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Clicked="Btn_Edit_indiviadualInfo_Clicked"
                                            HorizontalOptions="End"
                                            Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                            Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                    </Grid>



                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />



                                    <StackLayout Padding="10" Spacing="10">

                                        <StackLayout IsVisible="False" Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZTIN}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtTIN}" />

                                            <StackLayout.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundYes}"
                                                    TargetType="StackLayout"
                                                    Value="re_Tile_Background">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </StackLayout.Triggers>
                                        </StackLayout>


                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtIDType}" />
                                        </StackLayout>



                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.NDIDNumber}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtIDNumber}" />
                                        </StackLayout>



                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding PickerDobToDisplay}" />
                                        </StackLayout>



                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtName}" />
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="0,10,0,10">
                                    <Grid Padding="10,0,10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--<Frame Style="{StaticResource circleFrame}" Grid.Row="0" Grid.Column="0">
                                        <Image Margin="0" Source="ic_company.png" >


                                        </Image>
                                    </Frame>-->
                                        <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>-->

                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="ic_company"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <custom:CustomLabel
                                                Padding="8,0"
                                                Style="{StaticResource SectionTitleBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZBusinessInformation}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>

                                        <buttons:SfButton
                                            x:Name="Btn_Edit_BusinessInfo"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Clicked="Btn_Edit_BusinessInfo_Clicked"
                                            HorizontalOptions="End"
                                            Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                            Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                    </Grid>



                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />


                                    <StackLayout Padding="10" Spacing="10">


                                        <StackLayout IsVisible="false" Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZCRNumber}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtCRNumber}" />
                                            <StackLayout.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundCRNubmer}"
                                                    TargetType="StackLayout"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </StackLayout.Triggers>
                                        </StackLayout>


                                        <StackLayout IsVisible="false" Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtLicenseNumber}" />
                                            <StackLayout.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                    TargetType="StackLayout"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </StackLayout.Triggers>
                                        </StackLayout>


                                        <StackLayout IsVisible="false" Orientation="Horizontal">
                                            <custom:CustomLabel
                                                Style="{StaticResource ValueLabelGrey}"
                                                Text="{x:Static ResourceManager:AppResources.ZZLicenseNumberIssuedBy}"
                                                WidthRequest="200" />
                                            <Label
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtLOrCIssuedBy}"
                                                WidthRequest="200" />
                                            <StackLayout.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                    TargetType="StackLayout"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </StackLayout.Triggers>
                                        </StackLayout>


                                        <StackLayout IsVisible="false" Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZIssuingCity}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtLOrCIssuedByCity}" />
                                            <StackLayout.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                    TargetType="StackLayout"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </StackLayout.Triggers>
                                        </StackLayout>


                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>

                            <border:SfBorder Margin="0,10,0,10" Style="{StaticResource GreyBorderFrameWithShadow}">
                                <StackLayout Padding="10,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--<Frame Style="{StaticResource circleFrame}" Grid.Row="0" Grid.Column="0">
                                        <Image Margin="0" Source="phone_Green.png" >



                                        </Image>
                                    </Frame>-->
                                        <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="15" WidthRequest="15" CornerRadius="28" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                        </Frame>-->


                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="8,0"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal">

                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="24"
                                                HorizontalOptions="Start"
                                                Source="phone_Green"
                                                VerticalOptions="Center"
                                                WidthRequest="24" />

                                            <custom:CustomLabel
                                                Padding="8,0"
                                                Style="{StaticResource SectionTitleBlack}"
                                                Text="{x:Static ResourceManager:AppResources.ZZZContactInformation}"
                                                VerticalTextAlignment="Center" />
                                        </StackLayout>



                                        <buttons:SfButton
                                            x:Name="Btn_Edit_ContactInfo"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Clicked="Btn_Edit_ContactInfo_Clicked"
                                            HorizontalOptions="End"
                                            Style="{StaticResource NoBackgroundButtonStylePrimary}"
                                            Text="{x:Static ResourceManager:AppResources.NDEdit}" />
                                    </Grid>



                                    <BoxView
                                        BackgroundColor="LightGray"
                                        HeightRequest="1"
                                        HorizontalOptions="FillAndExpand" />



                                    <StackLayout Padding="10" Spacing="10">
                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZEmailAddress}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtEmailAddress}" />
                                        </StackLayout>



                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZMobileNumber}" />
                                            <custom:CustomLabel
                                                FlowDirection="LeftToRight"
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TxtCountryCode}" />
                                                        <Span Text="{Binding TxtMobileNumber}" />
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>

                                        </StackLayout>



                                        <StackLayout Orientation="Horizontal">
                                            <custom:CustomLabel Style="{StaticResource ValueLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZPhoneNumber}" />
                                            <custom:CustomLabel
                                                HorizontalOptions="EndAndExpand"
                                                HorizontalTextAlignment="End"
                                                Style="{StaticResource ValueLabelBlack}"
                                                Text="{Binding TxtPhoneNumber}" />
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </border:SfBorder>
                        </StackLayout>
                    </ScrollView>

                    <!--  Summary end  -->



                    <StackLayout
                        Grid.Row="3"
                        Padding="0,8,0,0"
                        BackgroundColor="White">
                        <buttons:SfButton
                            x:Name="btnprimary"
                            Clicked="btnSubmitNext_Clicked"
                            IsEnabled="{Binding IsNextButtonEnable}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding NextBTN}">
                            <buttons:SfButton.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsNextButtonEnable}"
                                    TargetType="buttons:SfButton"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsNextButtonEnable}"
                                    TargetType="buttons:SfButton"
                                    Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource NeutralGreay}" />
                                </DataTrigger>
                            </buttons:SfButton.Triggers>
                        </buttons:SfButton>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Padding="0,15,0,8">
                        <commonView:PageIndicatorView
                            Completed="{Binding MarkComplete}"
                            DotSize="12"
                            HorizontalOptions="End"
                            MaxNum="{Binding MaxIndex}"
                            MinNum="{Binding CurrentIndex}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            Padding="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource PageTitleBlack}"
                            Text="{Binding PageTitle}"
                            VerticalOptions="CenterAndExpand" />
                        <custom:CustomLabel
                            Padding="0,10,0,8"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{Binding BodyText}" />
                        <BoxView
                            BackgroundColor="{StaticResource NeutralLightGrey}"
                            HeightRequest="1"
                            Style="{StaticResource SeparatorStyle}" />
                    </StackLayout>





                    <Grid Grid.Row="0" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Column="0" Padding="0,8,0,0">
                            <Image
                                x:Name="Image_backArrow"
                                HorizontalOptions="Start"
                                Source="arrowLeft.png"
                                Style="{DynamicResource BackButtonArrow}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OnBackButtonClick}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Image
                                HeightRequest="40"
                                Source="ic_logo_gazt.png"
                                WidthRequest="34" />
                        </StackLayout>
                        <StackLayout Grid.Column="2" Padding="0,8,0,0">
                            <Image HorizontalOptions="End" Source="close.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Closed_Tapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                    </Grid>


                </Grid>
            </yummy:PancakeView>



            <Grid
                Grid.Row="0"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>