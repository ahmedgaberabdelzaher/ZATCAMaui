<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
            xmlns:custom="clr-namespace:GAZT"
            xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
            xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
            xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
             NavigationPage.HasNavigationBar="False"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"  
             BackgroundImageSource="partials_background.png"
             x:Class="EGAZT.Views.NewDesign.EstablishmentSignUP.SignUpForEstablishmentPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EstablishmentSignUPTabEnumToVisibilityConverters x:Key="enumToVisibilityConverter"/>

            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="HeightRequest" Value="25"/>
                <Setter Property="WidthRequest" Value="25"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            
       
        <yummy:PancakeView Style="{StaticResource CommonTopCurves}" Padding="24,16,24,24">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
<!-- step 1 -->

                <StackLayout Grid.Row="2" IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.TermsAndConditions}}">

                        <WebView x:Name="TCWebView" HeightRequest="880" WidthRequest="1000" />
                        <StackLayout Orientation="Horizontal">
                        <!--terms and condition  CheckBox -->
                        <CheckBox VerticalOptions="CenterAndExpand" IsEnabled="True" IsChecked="{Binding IsDeclarationCheckedForInstruction}">
                            <CheckBox.Triggers>
                                <DataTrigger TargetType="CheckBox" Value="false">
                                    <Setter Property="Color" Value="#ff0000" />
                                </DataTrigger>
                            </CheckBox.Triggers>
                        </CheckBox>
                        <custom:CustomLabel VerticalTextAlignment="Center" VerticalOptions="CenterAndExpand"  Style="{StaticResource CaptionLabelBlack}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ZZZZIAgreeWithThese}"  />
                                    <Span Text="&#160;"/>
                                    <Span Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}"  />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                            <custom:CustomLabel.GestureRecognizers>
                                <!--<TapGestureRecognizer Tapped="OnInCTapped"/>-->
                            </custom:CustomLabel.GestureRecognizers>
                        </custom:CustomLabel>
                    </StackLayout>
                        <!--<WebView x:Name="TCWebView" HeightRequest="880" WidthRequest="1000" /> TextColor="{StaticResource Primary}"-->

                   
                    
                </StackLayout>

                <!--Start step 2-->
                <ScrollView Grid.Row="2" IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.IndividualInformation}}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never" Padding="0,0,0,50">
                        <StackLayout>
                    <StackLayout>
                          
                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZAlreadyhaveTIN}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                              <!--<cards:SfCardView HasShadow="True" WidthRequest="366" HeightRequest="48" BackgroundColor="Transparent" CornerRadius="20" >                              </cards:SfCardView>-->

           
                                <Image Source="{Binding ImgBackgroundYes}">

                                </Image>
                        
                                
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZYesText}" Style="{StaticResource ButtonLabelBlackBold}" VerticalOptions="End" Margin="16,0,16,0" Padding="16,8,16,8">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundYes}" Value="re_Tile_Background">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnYesTapped" NumberOfTapsRequired="1"/>
                                </Grid.GestureRecognizers>
                        </Grid>
                        <Grid Grid.Column="1">
         
                                <Image x:Name="NoBackGroungImg" Source="{Binding ImgBackgroundNo}">
                                </Image>

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZNoText}" Style="{StaticResource ButtonLabelBlackBold}" Margin="16,0,16,0" VerticalOptions="End" Padding="16,8,16,8">
                                <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundNo}" Value="re_Tile_Background">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                </custom:CustomLabel.Triggers>
                            </custom:CustomLabel>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNoTapped" NumberOfTapsRequired="1"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                    </Grid>

                        <StackLayout IsVisible="False" Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">
                            
                            <!-- TIN -->

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZTIN}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout x:Name="FrmTIN" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0">
                                    <control:BorderlessEntry  x:Name="EntryTIN" Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                                              VerticalTextAlignment="Center"
                                                           Keyboard="Numeric" MaxLength="10" TextChanged="EntryTIN_TextChanged" 
                                                          IsSpellCheckEnabled="False"  Text="{Binding TxtTIN}" FontSize="Small" 
                                                          Unfocused="EntryTIN_Unfocused" Focused="EntryTIN_focused">
                                    <control:BorderlessEntry.Behaviors>
                                        <custom1:OnlyNumericValuesBehaviour/>
                                    </control:BorderlessEntry.Behaviors>
                                </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                            <StackLayout.Triggers>
                                <DataTrigger TargetType="StackLayout" Binding="{Binding ImgBackgroundYes}" Value="re_Tile_Background">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </StackLayout.Triggers>
                        </StackLayout>
                        <Grid >
                        <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                   

                            <StackLayout Grid.Row="0">
                                <!-- ID Type-->
                            <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">

                                    <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}"/>
                                                <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                    <Grid>
                                    <inputLayout:SfTextInputLayout x:Name="txtEntryName" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0" >
                                            <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Text="{Binding TxtIDType}" Placeholder="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                                 VerticalTextAlignment="Center" IsReadOnly="True"   TextColor="{StaticResource NeutralBlack}">
                                               
                                            </control:BorderlessEntry>
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png"/>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                    <Button Clicked="OnIDTypeClicked" BackgroundColor="Transparent"/>
                                    <syncfusion:SfPicker FlowDirection="RightToLeft"  x:Name="IDTypePicker" 
                                                         HeaderHeight="55"
                                                         HeaderText="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                         HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46" 
                                                         PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" 
                                                         BackgroundColor="White" SelectedItemFontSize="15"
                                                         ShowFooter="False" ItemHeight="40" 
                                                         DisplayMemberPath="SUType" Margin="10,0,10,0" PickerHeight="250" 
                                                         SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" 
                                                         UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                                         PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                                                         FooterHeight="46" SelectionChanged="IDTypePicker_SelectionChanged" 
                                                         ItemsSource="{Binding SignUpUsingList}" SelectedIndex="{Binding IDTypeIndex}"  OkButtonClicked="DDlIDType_OkayButtonClicked">
                                        <syncfusion:SfPicker.Behaviors>
                                            <customcontrol:SfPickerBehavior />
                                        </syncfusion:SfPicker.Behaviors>
                                    </syncfusion:SfPicker>
                                </Grid>

                            </StackLayout>
                            </StackLayout>
                                           
                        <!-- ID Number -->
                        <StackLayout Grid.Row="1" Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}" Margin="0,14,0,0">

                            <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.NDIDNumber}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <inputLayout:SfTextInputLayout x:Name="FrmIDNumber" Style="{StaticResource InputTableTextInputLayoutStyle}"     LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0"> 
                                <control:BorderlessEntry x:Name="EntryIDNumber" Text="{Binding TxtIDNumber}" Style="{StaticResource DefaultEntry}"
                                                         Placeholder="{x:Static ResourceManager:AppResources.NDIDNumber}"
                                                     VerticalTextAlignment="Center" Keyboard="Numeric" 
                                                     MaxLength="{Binding MaxLengthID}" IsSpellCheckEnabled="False" Unfocused="EntryIDNumber_Unfocused" TextChanged="GAZTBorderlessEntry_TextChanged">
                                    <control:BorderlessEntry.Behaviors>
                                        <custom1:OnlyNumericValuesBehaviour/>
                                    </control:BorderlessEntry.Behaviors>
                                </control:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>
                  </StackLayout>

                        </Grid>
                        <!-- DOB-->
                        <StackLayout Margin="0,14,0,0">
                            <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                           
                                <buttons:SfChipGroup  x:Name="ChipGroup_statusFilter" Margin="0,0,0,5" Type="Choice"  HorizontalOptions="Start"  ChipBackgroundColor="Transparent"                                         ItemsSource="{Binding ChipDataFilterlist}" SelectedChipBackgroundColor="#F9F0DF"  ChipBorderColor="{StaticResource NeutralLightGrey}"  ChipBorderWidth="1" SelectionChanged="ChipGroup_statusFilter_SelectionChanged" VerticalOptions="Center" >
                                    <buttons:SfChipGroup.ItemTemplate>
                                        <DataTemplate >
                                            <StackLayout WidthRequest="80" >
                                                <custom:CustomLabel Text="{Binding Text}" StyleId="OnBoardText" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Style="{StaticResource CaptionLabelBlack}"/>
                                            </StackLayout>
                                        </DataTemplate>
                                    </buttons:SfChipGroup.ItemTemplate>
                                </buttons:SfChipGroup>
                                <Grid>
                                <inputLayout:SfTextInputLayout x:Name="FrmDBO" Style="{StaticResource InputTableTextInputLayoutStyle}"  LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0">
                                    <control:BorderlessEntry Style="{StaticResource DefaultEntry}" x:Name="DateEntry"
                                                         Text ="{Binding PickerDobToDisplay}" Unfocused="DatePicker_Unfocused" TextChanged="DateEntry_TextChanged"
                                                         Focused="OnDateEntryFocussed"  Placeholder="yyyy/MM/dd" 
                                                             VerticalTextAlignment="Center"  IsReadOnly="True" TextColor="{StaticResource NeutralBlack}">

                            </control:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <!--<Image Source="arrowDropdown.png"/>-->
                                        <Image Source="calendar.png" HorizontalOptions="EndAndExpand">
                                            
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                            <Button BackgroundColor="Transparent" Clicked="OnDOBClicked" Margin="0,0,0,0" >
                        </Button>
                            <custom1:CustomDatePicker FlowDirection="RightToLeft" 
								ShowHeader="False"
								Margin="10,0,10,0" 
                              BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="#EAF7CC"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
                                
								ShowFooter="False"
								 ShowColumnHeader="True"
                                 ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="46"
                                PickerMode="Dialog"
								HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
								
								x:Name="DpDbo"
                               
                     
                             OKButtonTextColor="#006450" 
                                
                                             CancelButtonTextColor="#006450"
                               
                            
                            SelectedItem="{Binding TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                 Closed="DpDbo_Closed"
                                                      SelectionChanged="DpDbo_SelectionChanged"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
								ItemHeight="40">
                                <custom1:CustomDatePicker.Behaviors>
                                    <custom1:SfPickerBehavior />
                                </custom1:CustomDatePicker.Behaviors>
                            </custom1:CustomDatePicker>
                            <!--HijriDatePicker-->
                                    <custom1:CustomHijriDatePicker FlowDirection="RightToLeft" 
								ShowHeader="False"
								Margin="10,0,10,0" 
                              BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="#EAF7CC"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
                                  SelectedItem="{Binding TodayDateinHijri}"                                  
								ShowFooter="False"
								 ShowColumnHeader="True"
                                 ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="46"
                                PickerMode="Dialog"
								HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
								x:Name="DpDboHijri"
                             OKButtonTextColor="#006450"    
                             CancelButtonTextColor="#006450"
                           
                            HorizontalOptions="FillAndExpand"
                               Closed="DpDbo_Closed"
                                                      SelectionChanged="DpDbo_SelectionChanged"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
								ItemHeight="40">
                                    </custom1:CustomHijriDatePicker>
                                    <!--SelectedItem="{Binding TodayDate}"-->
                                    <!--HijriDatePicker-->
                                </Grid>
                            </StackLayout>
                    <!-- Name -->
                        </StackLayout>
                        <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}" >
                            <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZName}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <inputLayout:SfTextInputLayout x:Name="FrmName" Style="{StaticResource InputTableTextInputLayoutStyle}" LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0">
                                    <control:BorderlessEntry x:Name="EntryName" Unfocused="EntryName_Unfocused" Text="{Binding TxtName}" IsSpellCheckEnabled="False"
                                                     Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZName}"
                                                     VerticalTextAlignment="Center" >
                                        <control:BorderlessEntry.Behaviors>
                                            <custom1:AlphabetandArabicCharacters/>
                                        </control:BorderlessEntry.Behaviors>
                                    </control:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                    
                        </StackLayout>
                            </StackLayout>
                    </ScrollView>
    <!--End-->
                <!--Start step 3-->
                    <ScrollView Grid.Row="2" IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.BusinessInformation}}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                    <StackLayout>
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZSelectatleastoneofthefieldsCommercialRegistrationNumberorLicencebelow}" Style="{StaticResource CaptionLabelGrey}"/>
                    <Grid HorizontalOptions="StartAndExpand" > 
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
 
                         <Grid Grid.Row="0" Grid.Column="0">
           
                <Image Source="{Binding ImgBackgroundCRNubmer}" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />
                            <StackLayout VerticalOptions="End" Padding="15,0,16,16">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZCRNumber}" Style="{StaticResource ButtonLabelBlackBold}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundCRNubmer}" Value="FP_selected_tile">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCRNumberTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1">

                           <Image Source="{Binding ImgBackgroundLicenseNubmer}" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />

                            <StackLayout VerticalOptions="End" Padding="15,0,16,16">

                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" Style="{StaticResource ButtonLabelBlackBold}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundLicenseNubmer}" Value="FP_selected_tile">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLicenseNumberTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Grid>
                        
                        <!-- CR Number -->
                            <StackLayout IsVisible="{Binding CROptionsVisible}">
                              <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZCRNumber}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout x:Name="FrmCR" Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                               LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0">
                                    <control:BorderlessEntry x:Name="EntryCRNumber" Style="{StaticResource DefaultEntry}"
                                                         MaxLength="10" Placeholder="{x:Static ResourceManager:AppResources.ZZCRNumber}" 
                                                         Text="{Binding TxtCRNumber}" TextChanged="EntryCRNumber_TextChanged"
                                                         Unfocused="EntryCRNumber_Unfocused" VerticalTextAlignment="Center"  Keyboard="Numeric">
                                        <control:BorderlessEntry.Behaviors>
                                            <custom1:OnlyNumericValuesBehaviour/>
                                        </control:BorderlessEntry.Behaviors>
                                    </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                            
                
                        </StackLayout>
                                                    </StackLayout>

                            <StackLayout  Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}" IsVisible="{Binding LicenseOptionsVisible}">
                            <!-- License Number -->

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout x:Name="FrmLicenseNumber" Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                               LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0" >
                                    <control:BorderlessEntry x:Name="EntryLicenceNumber" Style="{StaticResource DefaultEntry}"
                                                             Text="{Binding TxtLicenseNumber}"  MaxLength="20" Keyboard="Numeric"
                                                         Placeholder="{x:Static ResourceManager:AppResources.ZZLicenseNumber}"
                                                     VerticalTextAlignment="Center" 
                                                     IsSpellCheckEnabled="False" Unfocused="EntryLicenceNumber_Unfocused">
                                        <control:BorderlessEntry.Behaviors>
                                            <custom1:OnlyNumericValuesBehaviour/>
                                        </control:BorderlessEntry.Behaviors>

                                    </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                                </StackLayout>
                           <!-- Licence number issued by -->

                        <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}" IsVisible="{Binding LicenseOptionsVisible}" Margin="0,14,0,0">

                                <custom:CustomLabel   Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZLicenseNumberIssuedBy}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                       LeadingViewPosition="Inside" ContainerType="Outlined"
                                                        UnfocusedColor="#B1B1B1" OutlineCornerRadius="8"
                                                        InputViewPadding="16,0,16,0"  Margin="0,-10,0,0" x:Name="FrmlicenceNumberIssuedbyframe"
                                                       >
