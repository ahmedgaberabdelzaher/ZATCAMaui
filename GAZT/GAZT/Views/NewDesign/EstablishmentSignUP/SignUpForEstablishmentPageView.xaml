<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
            xmlns:custom="clr-namespace:GAZT"
            xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
            xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
            xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:local="clr-namespace:EGAZT.CustomControl"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"             x:Class="EGAZT.Views.NewDesign.EstablishmentSignUP.SignUpForEstablishmentPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EstablishmentSignUPTabEnumToVisibilityConverters x:Key="enumToVisibilityConverter"/>

            <Style TargetType="Frame" x:Key="circleFrame">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}"/>
                <Setter Property="CornerRadius" Value="50"/>
                <Setter Property="VerticalOptions" Value="CenterAndExpand"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="HeightRequest" Value="25"/>
                <Setter Property="WidthRequest" Value="25"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView Style="{StaticResource CommonTopCurves}" Padding="24,16,24,24">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>


                <StackLayout Grid.Row="2" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.TermsAndConditions}}">

                    <WebView x:Name="TCWebView" HeightRequest="880" WidthRequest="1000" />

                    <StackLayout Orientation="Horizontal">
                        <CheckBox VerticalOptions="CenterAndExpand" IsEnabled="True" IsChecked="{Binding IsDeclarationCheckedForInstruction}">
                            <CheckBox.Triggers>
                                <DataTrigger TargetType="CheckBox" Value="false">
                                    <Setter Property="Color" Value="#ff0000" />
                                </DataTrigger>
                            </CheckBox.Triggers>
                        </CheckBox>
                        <custom:CustomLabel VerticalTextAlignment="Center" VerticalOptions="CenterAndExpand"  Style="{StaticResource CaptionLabelBlack}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZZZIAgreeWithThese}"  />
                                        <Span Text="&#160;"/>
                                        <Span Text="{x:Static ResourceManager:AppResources.ZZZZVATREInstructionsandConditions}" TextColor="{StaticResource Primary}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                                <custom:CustomLabel.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnInCTapped"/>
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>
                        </StackLayout>
                    
                </StackLayout>

                <!--Start-->
                <ScrollView Grid.Row="2" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.IndividualInformation}}">
                    <StackLayout>
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZAlreadyhaveTIN}" Style="{StaticResource CaptionLabelGrey}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                                <Image Source="{Binding ImgBackgroundYes}">
                                
                            </Image>
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZYesText}" Style="{StaticResource ButtonLabelBlackBold}" VerticalOptions="End" Padding="16,8,16,8">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundYes}" Value="re_Tile_Background">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnYesTapped" NumberOfTapsRequired="1"/>
                                </Grid.GestureRecognizers>
                        </Grid>
                        <Grid Grid.Column="1">
                                <Image x:Name="NoBackGroungImg" Source="{Binding ImgBackgroundNo}">

                            </Image>
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZNoText}" Style="{StaticResource ButtonLabelBlackBold}" VerticalOptions="End" Padding="16,8,16,8">
                                <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundNo}" Value="re_Tile_Background">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                </custom:CustomLabel.Triggers>
                            </custom:CustomLabel>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNoTapped" NumberOfTapsRequired="1"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                    </Grid>

                        <StackLayout IsVisible="False">
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZTIN}" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <control:BorderlessEntry  x:Name="EntryTIN" Style="{StaticResource DefaultEntry}" Placeholder="TIN" VerticalTextAlignment="End"  HeightRequest="51" Keyboard="Numeric" MaxLength="10" TextChanged="EntryTIN_TextChanged" IsSpellCheckEnabled="False"  Text="{Binding TxtTIN}" FontSize="Small" Unfocused="EntryTIN_Unfocused" Focused="EntryTIN_focused">
                                    <control:BorderlessEntry.Behaviors>
                                        <custom1:OnlyNumericValuesBehaviour/>
                                    </control:BorderlessEntry.Behaviors>
                                </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                            <StackLayout.Triggers>
                                <DataTrigger TargetType="StackLayout" Binding="{Binding ImgBackgroundYes}" Value="re_Tile_Background">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </StackLayout.Triggers>
                        </StackLayout>

                        <Grid>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                        <!--<Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>-->

                            <StackLayout Grid.Row="0">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZIDType}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Grid>
                                    <inputLayout:SfTextInputLayout x:Name="txtEntryName" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                        <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Text="{Binding TxtIDType}" Placeholder="{x:Static ResourceManager:AppResources.ZZIDType}" VerticalTextAlignment="End"  HeightRequest="51" IsEnabled="False">

                                        </control:BorderlessEntry>
                                        <inputLayout:SfTextInputLayout.TrailingView>
                                            <Image Source="arrowDropdown.png"/>
                                        </inputLayout:SfTextInputLayout.TrailingView>
                                    </inputLayout:SfTextInputLayout>
                                    <Button Clicked="OnIDTypeClicked" BackgroundColor="Transparent"/>
                                    <syncfusion:SfPicker x:Name="IDTypePicker" HeaderHeight="55" HeaderText="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                         HeaderTextColor="White" ShowColumnHeader="False" ColumnHeaderHeight="46" 
                                                         PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" 
                                                         BackgroundColor="White" SelectedItemFontSize="15" ShowFooter="False" ItemHeight="40" 
                                                         DisplayMemberPath="SUType" Margin="10,0,10,0" PickerHeight="250" 
                                                         SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" 
                                                         UnSelectedItemTextColor="{StaticResource NeutralBlack}"
                                                         PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                                                         FooterHeight="46" SelectionChanged="IDTypePicker_SelectionChanged" 
                                                      
                                                         ItemsSource="{Binding SignUpUsingList}" SelectedIndex="{Binding IDTypeIndex}"  OkButtonClicked="DDlIDType_OkayButtonClicked">
                                        <syncfusion:SfPicker.Behaviors>
                                            <customcontrol:SfPickerBehavior />
                                        </syncfusion:SfPicker.Behaviors>
                                    </syncfusion:SfPicker>
                                </Grid>
                            </StackLayout>
                        </Grid>

                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDIDNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                    <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry x:Name="EntryIDNumber" Text="{Binding TxtIDNumber}" Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.NDIDNumber}"
                                                     VerticalTextAlignment="End" HeightRequest="51" Keyboard="Numeric"
                                                     MaxLength="{Binding MaxLengthID}" IsSpellCheckEnabled="False" Unfocused="EntryIDNumber_Unfocused" TextChanged="GAZTBorderlessEntry_TextChanged">

                        </control:BorderlessEntry>
                    </inputLayout:SfTextInputLayout>


                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" Style="{StaticResource CaptionLabelGrey}"/>
                        <Grid>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <control:BorderlessEntry Style="{StaticResource DefaultEntry}" x:Name="DateEntry" Text ="{Binding PkrDBO}" Unfocused="DatePicker_Unfocused" Focused="OnDateEntryFocussed"  Placeholder="yyyy/MM/dd" VerticalTextAlignment="End"  HeightRequest="51" IsEnabled="False">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                            <Button BackgroundColor="Transparent" Clicked="OnDOBClicked" Margin="0,0,0,0" >
                        </Button>
                            <custom1:CustomDatePicker 
								ShowHeader="false"
								Margin="10,0,10,0" 
                              BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="#006450"
                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                    BorderColor="Black"
                                
								ShowFooter="True"
								 ShowColumnHeader="True"
                                             ColumnHeaderBackgroundColor="#EAF7CC"
								ColumnHeaderHeight="46"
                                PickerMode="Dialog"
								HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
								
								x:Name="DpDbo"
                               
                           SelectionChanged="DpDbo_SelectionChanged"
                             OKButtonTextColor="#006450" 
                                
                                             CancelButtonTextColor="#006450"
                                Closed="DpDbo_Closed"
                            
                            SelectedItem="{Binding TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
								ItemHeight="40">
                                <custom1:CustomDatePicker.Behaviors>
                                    <custom1:SfPickerBehavior />
                                </custom1:CustomDatePicker.Behaviors>
                            </custom1:CustomDatePicker>
                        </Grid>


                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZName}" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry x:Name="EntryName" Unfocused="EntryName_Unfocused" Text="{Binding TxtName}" IsSpellCheckEnabled="False" Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZName}" VerticalTextAlignment="End"  HeightRequest="51">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                    </StackLayout>
                </ScrollView>
    <!--End-->      
                <ScrollView Grid.Row="2" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.BusinessInformation}}" >
                    <StackLayout>
                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZSelectatleastoneofthefieldsCommercialRegistrationNumberorLicencebelow}" Style="{StaticResource CaptionLabelGrey}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                                <Image Source="{Binding ImgBackgroundCRNubmer}">

                            </Image>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZCRNumber}" Style="{StaticResource ButtonLabelBlackBold}" VerticalOptions="End" Padding="16,8,16,8">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundCRNubmer}" Value="FP_selected_tile">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCRNumberTapped" NumberOfTapsRequired="1"/>
                                </Grid.GestureRecognizers>
                        </Grid>
                        <Grid Grid.Column="1">
                                <Image x:Name="LicenseBackGroungImg" Source="{Binding ImgBackgroundLicenseNubmer}">

                            </Image>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" Style="{StaticResource ButtonLabelBlackBold}" VerticalOptions="End" Padding="16,8,16,8">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding ImgBackgroundLicenseNubmer}" Value="FP_selected_tile">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLicenseNumberTapped" NumberOfTapsRequired="1"/>
                                </Grid.GestureRecognizers>
                        </Grid>
                    </Grid>

                        <StackLayout IsVisible="False">
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZCRNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <control:BorderlessEntry x:Name="EntryCRNumber" Style="{StaticResource DefaultEntry}" MaxLength="10" Placeholder="{x:Static ResourceManager:AppResources.ZZCRNumber}" Text="{Binding TxtCRNumber}"  Unfocused="EntryCRNumber_Unfocused" VerticalTextAlignment="End"  HeightRequest="51">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                            <StackLayout.Triggers>
                                <DataTrigger TargetType="StackLayout" Binding="{Binding ImgBackgroundCRNubmer}" Value="FP_selected_tile">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </StackLayout.Triggers>
                        </StackLayout>

                        <StackLayout IsVisible="False">
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Text="{Binding TxtLicenseNumber}" MaxLength="20" Placeholder="{x:Static ResourceManager:AppResources.ZZLicenseNumber}"
                                                     VerticalTextAlignment="End"  HeightRequest="51"
                                                     IsSpellCheckEnabled="False">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>


                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZLicenseNumberIssuedBy}" Style="{StaticResource CaptionLabelGrey}"/>
                        <Grid>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZLicenseNumberIssuedBy}" 
                                                     VerticalTextAlignment="End" IsEnabled="False"  HeightRequest="51"
                                                     IsSpellCheckEnabled="False" Text="{Binding TxtLOrCIssuedBy}">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                                <Button Clicked="LIssuedBy_Clicked" BackgroundColor="Transparent"/>
                                <syncfusion:SfPicker x:Name="ddlLIssuedBy" HeaderHeight="55" HeaderText="{x:Static ResourceManager:AppResources.ZZIDType}" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ShowFooter="True" ItemHeight="40" Margin="10,0,10,0" 
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" 
                        OKButtonTextColor="#006450" CancelButtonTextColor="#006450" 
                        ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        ItemsSource="{Binding IssuedByList}" DisplayMemberPath="txt50"
                        OkButtonClicked="ddlLIssuedBy_OkButtonClicked"
                        CancelButtonClicked="ddlLIssuedBy_CancelButtonClicked"
                        FooterHeight="46">
                                <syncfusion:SfPicker.Behaviors>
                                    <customcontrol:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                            </syncfusion:SfPicker>
                        </Grid>

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZIssuingCity}" Style="{StaticResource CaptionLabelGrey}"/>
                        <Grid>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                    <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZIssuingCity}"
                                                         VerticalTextAlignment="End" IsEnabled="False" HeightRequest="51" Text="{Binding TxtLOrCIssuedByCity}">

                                    </control:BorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                                <Button Clicked="LIssuedByCity_Clicked" BackgroundColor="Transparent"/>
                                <syncfusion:SfPicker x:Name="ddlLIssuedByCity" HeaderHeight="55" HeaderText="{x:Static ResourceManager:AppResources.ZZIDType}" HeaderTextColor="White"
                        ShowColumnHeader="False" ColumnHeaderHeight="46" PickerMode="Dialog" 
                                                     HeaderBackgroundColor="#006450" BorderColor="Black" BackgroundColor="White" SelectedItemFontSize="15"
                        ItemHeight="40" Margin="10,0,10,0" 
                                                 OkButtonClicked="ddlLIssuedByCity_OkButtonClicked"
                                    CancelButtonClicked="ddlLIssuedByCity_CancelButtonClicked"
                      ShowFooter="True"  ItemsSource="{Binding CityList}" DisplayMemberPath="CityName"
                        PickerHeight="250" SelectedItemFontAttribute="Bold" SelectedItemTextColor="{StaticResource NeutralBlack}" UnSelectedItemTextColor="{StaticResource NeutralBlack}" PickerWidth="300" HeaderFontSize="14" OKButtonTextColor="#006450" CancelButtonTextColor="#006450" ShowHeader="False" OKButtonBackgroundColor="#EAF7CC" CancelButtonBackgroundColor="#EAF7CC"
                        FooterHeight="46">
                                <syncfusion:SfPicker.Behaviors>
                                    <customcontrol:SfPickerBehavior />
                                </syncfusion:SfPicker.Behaviors>
                            </syncfusion:SfPicker>
                        </Grid>
                            <StackLayout.Triggers>
                                <DataTrigger TargetType="StackLayout" Binding="{Binding ImgBackgroundLicenseNubmer}" Value="FP_selected_tile">
                                    <Setter Property="IsVisible" Value="True"/>
                                </DataTrigger>
                            </StackLayout.Triggers>
                    </StackLayout>
                    </StackLayout>
                </ScrollView>
                
                <ScrollView Grid.Row="2" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.ContactInformation}}">
                    <StackLayout>
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZEmailAddress}" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry x:Name="EntryEmail" Unfocused="EntryEmail_TextChanged" Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZEmailAddress}" VerticalTextAlignment="End" Keyboard="Email" HeightRequest="51">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>


                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZMobileNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                        <StackLayout Orientation="Horizontal">
                       <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" LeadingViewPosition="Inside">
                                <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Placeholder="{Binding TxtCountryCode}" VerticalTextAlignment="End" IsEnabled="False" HeightRequest="51">

                            </control:BorderlessEntry>
                            <inputLayout:SfTextInputLayout.LeadingView>
                                <Image Source="arrowDropdown"/>
                            </inputLayout:SfTextInputLayout.LeadingView>
                                <inputLayout:SfTextInputLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="CountryCodeTapped"/>
                                </inputLayout:SfTextInputLayout.GestureRecognizers>
                        </inputLayout:SfTextInputLayout>

                            <inputLayout:SfTextInputLayout HorizontalOptions="FillAndExpand" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                <control:BorderlessEntry x:Name="EntryMobileNumber"  Unfocused="EntryMobileNumber_Unfocused" Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZMobileNumber}" VerticalTextAlignment="End" Keyboard="Numeric" HeightRequest="51" >

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        </StackLayout>


                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZPhoneNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry x:Name="EntryPhoneNumber" TextChanged="EntryPhoneNumber_TextChanged" Unfocused="EntryPhoneNumber_Unfocused" Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZPhoneNumber}" VerticalTextAlignment="End" Keyboard="Numeric" HeightRequest="51">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                    </StackLayout>
                </ScrollView>


                <ScrollView Grid.Row="2" IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.EmailVerification}}">
                    <StackLayout>
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZEmailAddress}" Style="{StaticResource CaptionLabelGrey}"/>
                        <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                            <control:BorderlessEntry Style="{StaticResource DefaultEntry}" Placeholder="{x:Static ResourceManager:AppResources.ZZEmailAddress}" VerticalTextAlignment="End" Keyboard="Email" HeightRequest="51">

                            </control:BorderlessEntry>
                        </inputLayout:SfTextInputLayout>

                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZConfirmationcodesenttoemailaddress}" Style="{StaticResource CaptionLabelGrey}" HorizontalTextAlignment="Center"/>

                        <StackLayout>
                            <StackLayout Padding="0,0,0,0" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="20" Padding="30,0,30,20" FlowDirection="LeftToRight">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <!--First OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                                    Grid.Column="0"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                        x:Name="OTPFirstEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPFirstDigit}"
                                                        TextChanged="OTPFirstEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
                                                    <local:EntryFocusBehaviour NextFocusElementName="OTPSecondEntry"/>
                                                </custom:BorderlessEntry.Behaviors>
                                            </custom:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                        <!--First OTP Digit End-->

                                        <!--Second OTP Digit Start-->
                                        <inputLayout:SfTextInputLayout
                                                    Grid.Column="1"
                                                    ContainerType="Outlined"
                                                    UnfocusedColor="#B1B1B1"
                                                    OutlineCornerRadius="8"
                                                    FocusedColor="#005e4b" ErrorColor="#B00020" HasError="False">
                                            <custom:BorderlessEntry
                                                        x:Name="OTPSecondEntry"
                                                        FontAttributes="Bold"
                                                        FontSize="Small"
                                                        WidthRequest="8"
                                                        HorizontalTextAlignment="Center"
                                                        IsEnabled="{Binding IsOTPEntryEnable}"
                                                        Text="{Binding OTPSecondDigit}"
                                                        TextChanged="OTPSecondEntry_TextChanged"
                                                        ReturnType="Next"
                                                        Keyboard="Numeric"
                                                        MaxLength="1"
                                                        TextColor="#bbbbbb" HorizontalOptions="CenterAndExpand" >
                                                <custom:BorderlessEntry.Behaviors>
