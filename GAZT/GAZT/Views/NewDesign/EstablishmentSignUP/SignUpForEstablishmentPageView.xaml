<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstablishmentSignUP.SignUpForEstablishmentPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:local="clr-namespace:EGAZT.CustomControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:EGAZT.Models.EnumModels"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    FlowDirection="RightToLeft"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EstablishmentSignUPTabEnumToVisibilityConverters x:Key="enumToVisibilityConverter" />

            <Style x:Key="circleFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource OpacityPrimary}" />
                <Setter Property="CornerRadius" Value="25" />
                <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                <Setter Property="HeightRequest" Value="25" />
                <Setter Property="WidthRequest" Value="25" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>


            <yummy:PancakeView Padding="24,16,24,24" Style="{StaticResource CommonTopCurves}">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <!--  step 1  -->

                    <StackLayout Grid.Row="2" IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.TermsAndConditions}}">

                        <WebView
                            x:Name="TCWebView"
                            HeightRequest="880"
                            WidthRequest="1000" />
                        <StackLayout Orientation="Horizontal">
                            <!--  terms and condition  CheckBox  -->
                            <custom1:CheckboxCustom
                                x:Name="chkDeclaration"
                                IsChecked="{Binding IsDeclarationCheckedForInstruction}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />
                            <!--<CheckBox VerticalOptions="CenterAndExpand" IsEnabled="True" IsChecked="{Binding IsDeclarationCheckedForInstruction}">
                            <CheckBox.Triggers>
                                <DataTrigger TargetType="CheckBox" Value="false">
                                    <Setter Property="Color" Value="#e84941" />
                                </DataTrigger>
                            </CheckBox.Triggers>
                        </CheckBox>-->
                            <custom:CustomLabel
                                FontFamily="{StaticResource GAZT_FONT_MEDIUM}"
                                Style="{StaticResource GAZTGrayLabelStyleForCaptionFont}"
                                Text="{x:Static ResourceManager:AppResources.ZZZZIAgreeTheseTermsCond}">

                                <custom:CustomLabel.GestureRecognizers>
                                    <!--<TapGestureRecognizer Tapped="OnInCTapped"/>-->
                                </custom:CustomLabel.GestureRecognizers>
                            </custom:CustomLabel>
                        </StackLayout>
                        <!--<WebView x:Name="TCWebView" HeightRequest="880" WidthRequest="1000" /> TextColor="{StaticResource Primary}"-->



                    </StackLayout>

                    <!--  Start step 2  -->
                    <ScrollView
                        Grid.Row="2"
                        Padding="0,0,0,50"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.IndividualInformation}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout>
                            <StackLayout>

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZAlreadyhaveTIN}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <!--<cards:SfCardView HasShadow="False" WidthRequest="366" HeightRequest="48" BackgroundColor="Transparent" CornerRadius="20" >                              </cards:SfCardView>-->


                                        <Image Aspect="AspectFill" Source="{Binding ImgBackgroundYes}" />


                                        <custom:CustomLabel
                                            Margin="16,0,16,0"
                                            Padding="16,8,16,8"
                                            Style="{StaticResource ButtonLabelBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZYesText}"
                                            VerticalOptions="End">
                                            <custom:CustomLabel.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundYes}"
                                                    TargetType="custom:CustomLabel"
                                                    Value="re_Tile_Background">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </custom:CustomLabel.Triggers>
                                        </custom:CustomLabel>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnYesTapped" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    <Grid Grid.Column="1">

                                        <Image
                                            x:Name="NoBackGroungImg"
                                            Aspect="AspectFill"
                                            Source="{Binding ImgBackgroundNo}" />

                                        <custom:CustomLabel
                                            Margin="16,0,16,0"
                                            Padding="16,8,16,8"
                                            Style="{StaticResource ButtonLabelBlackBold}"
                                            Text="{x:Static ResourceManager:AppResources.ZZZNoText}"
                                            VerticalOptions="End">
                                            <custom:CustomLabel.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundNo}"
                                                    TargetType="custom:CustomLabel"
                                                    Value="re_Tile_Background">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </custom:CustomLabel.Triggers>
                                        </custom:CustomLabel>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnNoTapped" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Grid>

                                <StackLayout
                                    IsVisible="False"
                                    Orientation="Vertical"
                                    Style="{StaticResource SFTaxPayerProfile}">

                                    <!--  TIN  -->

                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZTIN}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmTIN"
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="8"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}"
                                        UnfocusedColor="#B1B1B1">
                                        <control:BorderlessEntry
                                            x:Name="EntryTIN"
                                            Focused="EntryTIN_focused"
                                            FontSize="Small"
                                            IsSpellCheckEnabled="False"
                                            Keyboard="Numeric"
                                            MaxLength="10"
                                            Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtTIN}"
                                            TextChanged="EntryTIN_TextChanged"
                                            Unfocused="EntryTIN_Unfocused"
                                            VerticalTextAlignment="Center">
                                            <control:BorderlessEntry.Behaviors>
                                                <custom1:OnlyNumericValuesBehaviour />
                                            </control:BorderlessEntry.Behaviors>
                                        </control:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>
                                    <StackLayout.Triggers>
                                        <DataTrigger
                                            Binding="{Binding ImgBackgroundYes}"
                                            TargetType="StackLayout"
                                            Value="re_Tile_Background">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </StackLayout.Triggers>
                                </StackLayout>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>


                                    <StackLayout Grid.Row="0">
                                        <!--  ID Type  -->
                                        <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">

                                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                                <custom:CustomLabel.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}" />
                                                        <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                    </FormattedString>
                                                </custom:CustomLabel.FormattedText>
                                            </custom:CustomLabel>
                                            <Grid>
                                                <inputLayout:SfTextInputLayout
                                                    x:Name="txtEntryName"
                                                    Margin="0,-10,0,0"
                                                    ContainerType="Outlined"
                                                    InputViewPadding="16,0,16,0"
                                                    LeadingViewPosition="Inside"
                                                    OutlineCornerRadius="8"
                                                    Style="{StaticResource InputTableTextInputLayoutStyle}"
                                                    UnfocusedColor="#B1B1B1">
                                                    <control:BorderlessEntry
                                                        IsReadOnly="True"
                                                        Placeholder="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                        Style="{StaticResource DefaultEntry}"
                                                        Text="{Binding TxtIDType}"
                                                        TextColor="{StaticResource NeutralBlack}"
                                                        VerticalTextAlignment="Center" />
                                                    <inputLayout:SfTextInputLayout.TrailingView>
                                                        <Image Source="arrowDropdown.png" />
                                                    </inputLayout:SfTextInputLayout.TrailingView>
                                                </inputLayout:SfTextInputLayout>
                                                <Button BackgroundColor="Transparent" Clicked="OnIDTypeClicked" />
                                                <syncfusion:SfPicker
                                                    x:Name="IDTypePicker"
                                                    Margin="10,0,10,0"
                                                    BackgroundColor="White"
                                                    BorderColor="Black"
                                                    CancelButtonBackgroundColor="#EAF7CC"
                                                    CancelButtonTextColor="{StaticResource Primary}"
                                                    ColumnHeaderHeight="46"
                                                    DisplayMemberPath="SUType"
                                                    FlowDirection="RightToLeft"
                                                    FooterHeight="46"
                                                    HeaderBackgroundColor="{StaticResource Primary}"
                                                    HeaderFontSize="13"
                                                    HeaderHeight="55"
                                                    HeaderText="{x:Static ResourceManager:AppResources.ZZIDType}"
                                                    HeaderTextColor="White"
                                                    ItemHeight="40"
                                                    ItemsSource="{Binding SignUpUsingList}"
                                                    OKButtonBackgroundColor="#EAF7CC"
                                                    OKButtonTextColor="{StaticResource Primary}"
                                                    OkButtonClicked="DDlIDType_OkayButtonClicked"
                                                    PickerHeight="250"
                                                    PickerMode="Dialog"
                                                    PickerWidth="300"
                                                    SelectedIndex="{Binding IDTypeIndex}"
                                                    SelectedItemFontAttribute="Bold"
                                                    SelectedItemFontSize="15"
                                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                                    SelectionChanged="IDTypePicker_SelectionChanged"
                                                    ShowColumnHeader="False"
                                                    ShowFooter="False"
                                                    ShowHeader="False"
                                                    UnSelectedItemTextColor="{StaticResource NeutralBlack}">
                                                    <syncfusion:SfPicker.Behaviors>
                                                        <customcontrol:SfPickerBehavior />
                                                    </syncfusion:SfPicker.Behaviors>
                                                </syncfusion:SfPicker>
                                            </Grid>

                                        </StackLayout>
                                    </StackLayout>

                                    <!--  ID Number  -->
                                    <StackLayout
                                        Grid.Row="1"
                                        Margin="0,14,0,0"
                                        Orientation="Vertical"
                                        Style="{StaticResource SFTaxPayerProfile}">

                                        <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                            <custom:CustomLabel.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{x:Static ResourceManager:AppResources.NDIDNumber}" />
                                                    <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                                </FormattedString>
                                            </custom:CustomLabel.FormattedText>
                                        </custom:CustomLabel>
                                        <inputLayout:SfTextInputLayout
                                            x:Name="FrmIDNumber"
                                            Margin="0,-10,0,0"
                                            ContainerType="Outlined"
                                            InputViewPadding="16,0,16,0"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="8"
                                            Style="{StaticResource InputTableTextInputLayoutStyle}"
                                            UnfocusedColor="#B1B1B1">
                                            <control:BorderlessEntry
                                                x:Name="EntryIDNumber"
                                                IsSpellCheckEnabled="False"
                                                Keyboard="Numeric"
                                                MaxLength="{Binding MaxLengthID}"
                                                Placeholder="{x:Static ResourceManager:AppResources.NDIDNumber}"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding TxtIDNumber}"
                                                TextChanged="GAZTBorderlessEntry_TextChanged"
                                                Unfocused="EntryIDNumber_Unfocused"
                                                VerticalTextAlignment="Center">
                                                <control:BorderlessEntry.Behaviors>
                                                    <custom1:OnlyNumericValuesBehaviour />
                                                </control:BorderlessEntry.Behaviors>
                                            </control:BorderlessEntry>
                                        </inputLayout:SfTextInputLayout>
                                    </StackLayout>

                                </Grid>
                                <!--  DOB  -->
                                <StackLayout Margin="0,14,0,0">
                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZDateofBirth}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>

                                    <buttons:SfChipGroup
                                        x:Name="ChipGroup_statusFilter"
                                        Margin="0,0,0,5"
                                        ChipBackgroundColor="Transparent"
                                        ChipBorderColor="{StaticResource NeutralLightGrey}"
                                        ChipBorderWidth="1"
                                        HorizontalOptions="Start"
                                        ItemsSource="{Binding ChipDataFilterlist}"
                                        SelectedChipBackgroundColor="{StaticResource PartialBg}"
                                        SelectionChanged="ChipGroup_statusFilter_SelectionChanged"
                                        Type="Choice"
                                        VerticalOptions="Center">
                                        <buttons:SfChipGroup.ItemTemplate>
                                            <DataTemplate>
                                                <StackLayout WidthRequest="80">
                                                    <custom:CustomLabel
                                                        HorizontalOptions="FillAndExpand"
                                                        HorizontalTextAlignment="Center"
                                                        Style="{StaticResource CaptionLabelBlack}"
                                                        StyleId="OnBoardText"
                                                        Text="{Binding Text}" />
                                                </StackLayout>
                                            </DataTemplate>
                                        </buttons:SfChipGroup.ItemTemplate>
                                    </buttons:SfChipGroup>
                                    <Grid>
                                        <inputLayout:SfTextInputLayout
                                            x:Name="FrmDBO"
                                            Margin="0,-10,0,0"
                                            ContainerType="Outlined"
                                            InputViewPadding="16,0,16,0"
                                            LeadingViewPosition="Inside"
                                            OutlineCornerRadius="8"
                                            Style="{StaticResource InputTableTextInputLayoutStyle}"
                                            UnfocusedColor="#B1B1B1">
                                            <control:BorderlessEntry
                                                x:Name="DateEntry"
                                                Focused="OnDateEntryFocussed"
                                                IsReadOnly="True"
                                                Placeholder="yyyy/MM/dd"
                                                Style="{StaticResource DefaultEntry}"
                                                Text="{Binding PickerDobToDisplay}"
                                                TextChanged="DateEntry_TextChanged"
                                                TextColor="{StaticResource NeutralBlack}"
                                                Unfocused="DatePicker_Unfocused"
                                                VerticalTextAlignment="Center" />
                                            <inputLayout:SfTextInputLayout.TrailingView>
                                                <!--<Image Source="arrowDropdown.png"/>-->
                                                <Image HorizontalOptions="EndAndExpand" Source="calendar.png" />
                                            </inputLayout:SfTextInputLayout.TrailingView>
                                        </inputLayout:SfTextInputLayout>
                                        <Button
                                            Margin="0,0,0,0"
                                            BackgroundColor="Transparent"
                                            Clicked="OnDOBClicked" />
                                        <custom1:CustomDatePicker
                                            x:Name="DpDbo"
                                            Margin="10,0,10,0"
                                            BackgroundColor="White"
                                            BorderColor="Black"
                                            CancelButtonBackgroundColor="#EAF7CC"
                                            CancelButtonClicked="DpDbo_CancelButtonClicked"
                                            CancelButtonTextColor="{StaticResource Primary}"
                                            Closed="DpDbo_Closed"
                                            ColumnHeaderBackgroundColor="White"
                                            ColumnHeaderHeight="46"
                                            FlowDirection="RightToLeft"
                                            HeaderBackgroundColor="#EAF7CC"
                                            HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
                                            HorizontalOptions="FillAndExpand"
                                            ItemHeight="40"
                                            OKButtonBackgroundColor="#EAF7CC"
                                            OKButtonTextColor="{StaticResource Primary}"
                                            OkButtonClicked="DOBpicker_OkButtonClicked"
                                            PickerMode="Dialog"
                                            SelectedItem="{Binding TodayDate}"
                                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                                            SelectionChanged="DpDbo_SelectionChanged"
                                            ShowColumnHeader="True"
                                            ShowFooter="False"
                                            ShowHeader="False">
                                            <custom1:CustomDatePicker.Behaviors>
                                                <custom1:SfPickerBehavior />
                                            </custom1:CustomDatePicker.Behaviors>
                                        </custom1:CustomDatePicker>
                                        <!--  HijriDatePicker  -->
                                        <custom1:CustomHijriDatePicker
                                            x:Name="DpDboHijri"
                                            Margin="10,0,10,0"
                                            BackgroundColor="White"
                                            BorderColor="Black"
                                            CancelButtonBackgroundColor="#EAF7CC"
                                            CancelButtonClicked="DpDbo_CancelButtonClicked"
                                            CancelButtonTextColor="{StaticResource Primary}"
                                            Closed="DpDbo_Closed"
                                            ColumnHeaderBackgroundColor="White"
                                            ColumnHeaderHeight="46"
                                            FlowDirection="RightToLeft"
                                            HeaderBackgroundColor="#EAF7CC"
                                            HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
                                            HorizontalOptions="FillAndExpand"
                                            ItemHeight="40"
                                            OKButtonBackgroundColor="#EAF7CC"
                                            OKButtonTextColor="{StaticResource Primary}"
                                            OkButtonClicked="DOBpicker_OkButtonClicked"
                                            PickerMode="Dialog"
                                            SelectedItem="{Binding TodayDateinHijri}"
                                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                                            SelectionChanged="DpDbo_SelectionChanged"
                                            ShowColumnHeader="True"
                                            ShowFooter="False"
                                            ShowHeader="False" />
                                        <!--  SelectedItem="{Binding TodayDate}"  -->
                                        <!--  HijriDatePicker  -->
                                    </Grid>
                                </StackLayout>
                                <!--  Name  -->
                            </StackLayout>
                            <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZName}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmName"
                                    Margin="0,-10,0,0"
                                    ContainerType="Outlined"
                                    InputViewPadding="16,0,16,0"
                                    LeadingViewPosition="Inside"
                                    OutlineCornerRadius="8"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}"
                                    UnfocusedColor="#B1B1B1">
                                    <control:BorderlessEntry
                                        x:Name="EntryName"
                                        IsSpellCheckEnabled="False"
                                        Placeholder="{x:Static ResourceManager:AppResources.ZZName}"
                                        Style="{StaticResource DefaultEntry}"
                                        Text="{Binding TxtName}"
                                        Unfocused="EntryName_Unfocused"
                                        VerticalTextAlignment="Center">
                                        <control:BorderlessEntry.Behaviors>
                                            <custom1:AlphabetandArabicCharacters />
                                        </control:BorderlessEntry.Behaviors>
                                    </control:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>

                            </StackLayout>
                        </StackLayout>
                    </ScrollView>
                    <!--  End  -->
                    <!--  Start step 3  -->
                    <ScrollView
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentSignUPTabEnum.BusinessInformation}}"
                        VerticalScrollBarVisibility="Never">
                        <StackLayout>
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZSelectatleastoneofthefieldsCommercialRegistrationNumberorLicencebelow}" />
                            <Grid HorizontalOptions="StartAndExpand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0">

                                    <Image
                                        Aspect="Fill"
                                        HorizontalOptions="FillAndExpand"
                                        Source="{Binding ImgBackgroundCRNubmer}"
                                        VerticalOptions="FillAndExpand" />
                                    <StackLayout Padding="15,0,16,16" VerticalOptions="End">

                                        <custom:CustomLabel Style="{StaticResource ButtonLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.ZZCRNumber}">
                                            <custom:CustomLabel.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundCRNubmer}"
                                                    TargetType="custom:CustomLabel"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </custom:CustomLabel.Triggers>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCRNumberTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="1">

                                    <Image
                                        Aspect="Fill"
                                        HorizontalOptions="FillAndExpand"
                                        Source="{Binding ImgBackgroundLicenseNubmer}"
                                        VerticalOptions="FillAndExpand" />

                                    <StackLayout Padding="15,0,16,16" VerticalOptions="End">

                                        <custom:CustomLabel Style="{StaticResource ButtonLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}">
                                            <custom:CustomLabel.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding ImgBackgroundLicenseNubmer}"
                                                    TargetType="custom:CustomLabel"
                                                    Value="FP_selected_tile">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </custom:CustomLabel.Triggers>
                                        </custom:CustomLabel>
                                    </StackLayout>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLicenseNumberTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Grid>

                            <!--  CR Number  -->
                            <StackLayout IsVisible="{Binding CROptionsVisible}">
                                <StackLayout Orientation="Vertical" Style="{StaticResource SFTaxPayerProfile}">

                                    <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                        <custom:CustomLabel.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static ResourceManager:AppResources.ZZCRNumber}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </custom:CustomLabel.FormattedText>
                                    </custom:CustomLabel>
                                    <inputLayout:SfTextInputLayout
                                        x:Name="FrmCR"
                                        Margin="0,-10,0,0"
                                        ContainerType="Outlined"
                                        InputViewPadding="16,0,16,0"
                                        LeadingViewPosition="Inside"
                                        OutlineCornerRadius="8"
                                        Style="{StaticResource InputTableTextInputLayoutStyle}"
                                        UnfocusedColor="#B1B1B1">
                                        <control:BorderlessEntry
                                            x:Name="EntryCRNumber"
                                            Keyboard="Numeric"
                                            MaxLength="10"
                                            Placeholder="{x:Static ResourceManager:AppResources.ZZCRNumber}"
                                            Style="{StaticResource DefaultEntry}"
                                            Text="{Binding TxtCRNumber}"
                                            TextChanged="EntryCRNumber_TextChanged"
                                            Unfocused="EntryCRNumber_Unfocused"
                                            VerticalTextAlignment="Center">
                                            <control:BorderlessEntry.Behaviors>
                                                <custom1:OnlyNumericValuesBehaviour />
                                            </control:BorderlessEntry.Behaviors>
                                        </control:BorderlessEntry>
                                    </inputLayout:SfTextInputLayout>


                                </StackLayout>
                            </StackLayout>

                            <StackLayout
                                IsVisible="{Binding LicenseOptionsVisible}"
                                Orientation="Vertical"
                                Style="{StaticResource SFTaxPayerProfile}">
                                <!--  License Number  -->

                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZLicenseNumber}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
