<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstablishmentSignUP.AccountCreatedSuccessfullyPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout
                Grid.Row="0"
                Padding="24,0,24,16"
                VerticalOptions="CenterAndExpand">
                <Image Margin="0,75,0,0" Source="Forget_ic_success.png" />
                <custom:CustomLabel
                    Margin="0,25,0,0"
                    HorizontalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    StyleId="OnBoardText"
                    Text="{x:Static ResourceManager:AppResources.ZZAccountCreatedSuccessfully}" />
                <!--<custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDYouSuccessfullyRegisteredGAZTServies}" Style="{StaticResource BodyLabelBlack}" HorizontalTextAlignment="Center" TextColor="White"/>-->

            </StackLayout>
            <yummy:PancakeView
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="20"
                BackgroundColor="White"
                CornerRadius="20,20,0,0"
                VerticalOptions="EndAndExpand">
                <StackLayout>
                    <Frame
                        Margin="0,20,0,0"
                        Padding="0"
                        BorderColor="LightGray"
                        CornerRadius="8"
                        HasShadow="False">
                        <StackLayout Padding="10" Orientation="Horizontal">
                            <Label
                                FontFamily="{StaticResource SomarSemiBold}"
                                FontSize="11"
                                HorizontalOptions="StartAndExpand"
                                Text="{x:Static ResourceManager:AppResources.TINS}"
                                TextColor="{StaticResource DarkGrayTextColor}"
                                VerticalOptions="Center" />
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                <Label
                                    x:Name="Label_Tin"
                                    FontFamily="{StaticResource SomarSemiBold}"
                                    FontSize="15"
                                    Text="{Binding TINnumber}"
                                    TextColor="#010101" />
                                <Image x:Name="Image_Copy">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.ContentPaste}"
                                            Size="25"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Image_Copy_Tapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                        </StackLayout>

                    </Frame>
                    <!--<Frame BorderColor="LightGray" Padding="0" CornerRadius="8" HasShadow="False" Margin="0,20,0,0">



                        </Frame>
                               <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" HasShadow="False" Margin="0,20,0,0">



                        </Frame>
                                      <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" HasShadow="False" Margin="0,20,0,0">



                        </Frame>
                                      <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" HasShadow="False" Margin="0,20,0,0">



                        </Frame>-->

                    <buttons:SfButton
                        x:Name="btnprimary"
                        Margin="0,20,0,0"
                        Clicked="OnGoToLoginClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.Clickhereforlogin}" />
                </StackLayout>
            </yummy:PancakeView>
        </Grid>

    </ContentPage.Content>
</ContentPage>