<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstablishmentSignUP.EstablishmentSignUPPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EstablishmentSignUPTabEnumToVisibilityConverters x:Key="enumToVisibilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView Padding="24,16,24,24" Style="{StaticResource CommonTopCurves}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="ParentView"
                        Grid.Row="2"
                        HorizontalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">

                            <Image
                                Aspect="Fill"
                                HorizontalOptions="FillAndExpand"
                                Source="{Binding IndividualBackImg}"
                                VerticalOptions="FillAndExpand" />
                            <StackLayout Padding="15,0,16,16" VerticalOptions="End">

                                <Image HorizontalOptions="Start" Source="individual_32White.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IndividualBackImg}"
                                            TargetType="Image"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="individual_32.png" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <custom:CustomLabel Style="{StaticResource ValueLabelWhiteMedium}" Text="{x:Static ResourceManager:AppResources.NDIndividuals}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IndividualBackImg}"
                                            TargetType="custom:CustomLabel"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIndividualTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1">

                            <Image
                                Aspect="Fill"
                                HorizontalOptions="FillAndExpand"
                                Source="{Binding EstablishmentBackImg}"
                                VerticalOptions="FillAndExpand" />



                            <StackLayout Padding="15,0,16,16" VerticalOptions="End">
                                <Image HorizontalOptions="Start" Source="establishments_White.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding EstablishmentBackImg}"
                                            TargetType="Image"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="establishments_BigGreen.png" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <custom:CustomLabel Style="{StaticResource ValueLabelWhiteMedium}" Text="{x:Static ResourceManager:AppResources.NDEstablishments}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger
                                            Binding="{Binding EstablishmentBackImg}"
                                            TargetType="custom:CustomLabel"
                                            Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEstablishmentTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Grid>

                    <!--<Grid Grid.Row="2" x:Name="ParentView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                        <Image HorizontalOptions="Start" Source="ic_company.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDCompany}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Image Source="FP_selected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="establishments_White.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEstablishments}" Style="{StaticResource ValueLabelWhiteMedium}"/>
                        </StackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEstablishmentTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>


                    <Grid Grid.Row="1" Grid.Column="0">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="individual_32.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDIndividuals}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="other.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDOthers}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                </Grid>-->



                    <StackLayout Grid.Row="1" Padding="0,48,0,0">
                        <custom:CustomLabel Style="{StaticResource PageTitleBlack}" Text="{x:Static ResourceManager:AppResources.ZTERNewAccount}" />
                        <custom:CustomLabel Style="{StaticResource BodyLabelGrey}" Text="{x:Static ResourceManager:AppResources.ZZZZSelectthetypeofEntity}" />
                        <BoxView Style="{StaticResource SeparatorStyle}" />
                    </StackLayout>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Column="0" Padding="0,8,0,0">
                            <Image
                                x:Name="backArrow"
                                HorizontalOptions="Start"
                                Rotation="0"
                                Source="arrowLeft.png">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackArrowTapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Image
                                HeightRequest="40"
                                Source="ic_logo_gazt.png"
                                WidthRequest="34" />
                        </StackLayout>
                        <StackLayout Grid.Column="2" Padding="0,8,0,0" />
                    </Grid>

                    <!--  Loader Starts  -->
                </Grid>
            </yummy:PancakeView>


            <Grid
                Grid.Row="0"
                Margin="0,-20,0,0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>