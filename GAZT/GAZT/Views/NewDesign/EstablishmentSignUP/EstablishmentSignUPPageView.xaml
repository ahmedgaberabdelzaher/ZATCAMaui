<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             NavigationPage.HasNavigationBar="False"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             BackgroundImageSource="partials_background.png"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" 
             x:Class="EGAZT.Views.NewDesign.EstablishmentSignUP.EstablishmentSignUPPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:EstablishmentSignUPTabEnumToVisibilityConverters x:Key="enumToVisibilityConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView Style="{StaticResource CommonTopCurves}" Padding="24,16,24,24">

                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="2" x:Name="ParentView" HorizontalOptions="FillAndExpand" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
           
                <Image Source="{Binding IndividualBackImg}" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />
                            <StackLayout VerticalOptions="End" Padding="15,0,16,16">

                                <Image HorizontalOptions="Start"  Source="individual_32White.png">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding IndividualBackImg}" Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="individual_32.png"/>
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDIndividuals}" Style="{StaticResource ValueLabelWhiteMedium}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IndividualBackImg}" Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIndividualTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1">

                           <Image Source="{Binding EstablishmentBackImg}" Aspect="Fill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />


        
                            <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                                <Image HorizontalOptions="Start" Source="establishments_White.png">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding EstablishmentBackImg}" Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="Source" Value="establishments_BigGreen.png"/>
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEstablishments}" Style="{StaticResource ValueLabelWhiteMedium}">
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding EstablishmentBackImg}" Value="vat_tile_listofsignup_W.png">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEstablishmentTapped"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Grid>

                    <!--<Grid Grid.Row="2" x:Name="ParentView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                        <Image HorizontalOptions="Start" Source="ic_company.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDCompany}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Image Source="FP_selected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="establishments_White.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEstablishments}" Style="{StaticResource ValueLabelWhiteMedium}"/>
                        </StackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEstablishmentTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>


                    <Grid Grid.Row="1" Grid.Column="0">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="individual_32.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDIndividuals}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="other.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDOthers}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                </Grid>-->



                    <StackLayout Grid.Row="1" Padding="0,48,0,0">
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZTERNewAccount}" Style="{StaticResource PageTitleBlack}"/>
                        <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.ZZZZSelectthetypeofEntity}" Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Style="{StaticResource SeparatorStyle}"/>
                    </StackLayout>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <StackLayout Grid.Column="0" Padding="0,8,0,0">
                            <Image x:Name="backArrow" Source="arrowLeft.png" Rotation="0" HorizontalOptions="Start">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackArrowTapped"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Image HeightRequest="40" WidthRequest="34" Source="ic_logo_gazt.png">

                            </Image>
                        </StackLayout>
                        <StackLayout Grid.Column="2" Padding="0,8,0,0">

                        </StackLayout>
                    </Grid>

                    <!--Loader Starts-->
                </Grid>
            </yummy:PancakeView>


            <Grid Grid.Row="0" IsVisible="{Binding IsLoading}" Margin="0,-20,0,0">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Secondary}"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>