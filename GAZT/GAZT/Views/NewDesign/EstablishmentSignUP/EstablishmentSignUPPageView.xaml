<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="partials_background.png"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.EstablishmentSignUP.EstablishmentSignUPPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:EstablishmentSignUPTabEnumToVisibilityConverters x:Key="enumToVisibilityConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <yummy:PancakeView Style="{StaticResource CommonTopCurves}" Padding="24,16,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="2" x:Name="ParentView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Image Source="{Binding IndividualBackImg}"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="menu_individual.png">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding IndividualBackImg}" Value="FP_unselected_tile.png">
                                        <Setter Property="Source" Value="individual_32.png"/>
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDIndividuals}" Style="{StaticResource ValueLabelWhiteMedium}">
                                <custom:CustomLabel.Triggers>
                                    <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IndividualBackImg}" Value="FP_unselected_tile.png">
                                        <Setter Property="TextColor" Value="Black"/>
                                    </DataTrigger>
                                </custom:CustomLabel.Triggers>
                            </custom:CustomLabel>
                        </StackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnIndividualTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Image Source="{Binding EstablishmentBackImg}"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="establishments.png">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding IndividualBackImg}" Value="FP_unselected_tile.png">
                                        <Setter Property="Source" Value="establishments_White.png"/>
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEstablishments}" Style="{StaticResource ValueLabelWhiteMedium}">
                                <custom:CustomLabel.Triggers>
                                    <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding EstablishmentBackImg}" Value="FP_unselected_tile.png">
                                        <Setter Property="TextColor" Value="Black"/>
                                    </DataTrigger>
                                </custom:CustomLabel.Triggers>
                            </custom:CustomLabel>
                        </StackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEstablishmentTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>

                <!--<Grid Grid.Row="2" x:Name="ParentView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                        <Image HorizontalOptions="Start" Source="ic_company.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDCompany}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Image Source="FP_selected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="establishments_White.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDEstablishments}" Style="{StaticResource ValueLabelWhiteMedium}"/>
                        </StackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEstablishmentTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>


                    <Grid Grid.Row="1" Grid.Column="0">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="individual_32.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDIndividuals}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Image Source="FP_unselected_tile.png"/>
                        <StackLayout VerticalOptions="End" Padding="15,0,16,16">
                            <Image HorizontalOptions="Start" Source="other.png"/>
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDOthers}" Style="{StaticResource ValueLabelBlackMedium}"/>
                        </StackLayout>
                    </Grid>
                </Grid>-->
                
                
                
                <StackLayout Grid.Row="1" Padding="0,48,0,0">
                    <custom:CustomLabel Text="{Binding PageTitle}" Style="{StaticResource PageTitleBlack}"/>
                    <custom:CustomLabel Text="{Binding BodyText}" Style="{StaticResource BodyLabelGrey}"/>
                    <BoxView Style="{StaticResource SeparatorStyle}"/>
                </StackLayout>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="60*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.Column="0" Padding="0,8,0,0">
                        <Image Source="arrowLeft.png" HorizontalOptions="Start">
                            
                        </Image>
                    </StackLayout>
                    <StackLayout Grid.Column="1">
                        <Image HeightRequest="40" WidthRequest="34" Source="ic_logo_gazt.png">

                        </Image>
                    </StackLayout>
                    <StackLayout Grid.Column="2" Padding="0,8,0,0">
                        <Image Source="closeGrey.png" HorizontalOptions="End">

                        </Image>
                    </StackLayout>
                </Grid>
            </Grid>
        </yummy:PancakeView>
    </ContentPage.Content>
</ContentPage>