<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             
                   xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             BackgroundImageSource="partials_background"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:local="clr-namespace:EGAZT;assembly=GAZT"

             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             
             x:Class="EGAZT.Views.NewDesign.ZAKATObjectionPages.NewZakatObjectionPageView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="BoxView" x:Key="boxIndicator">
                <Setter Property="BackgroundColor" Value="{StaticResource NeutralLightGrey}"/>
                <Setter Property="HeightRequest" Value="10"/>
                <Setter Property="WidthRequest" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style TargetType="Label" x:Key="HorizontalEnd" >
                <Setter Property="HorizontalOptions" Value="EndAndExpand"/>
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="Label" x:Key="SectionTitleBlackTopNegative10" >
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarSemiBold}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="0,-10,0,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <yummy:PancakeView Grid.Row="1"  Style="{StaticResource CommonTopCurves}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <!--Header Section Starts-->
                    <StackLayout Grid.Row="0" x:Name="ObjectionDetailsView">
                        <StackLayout Orientation="Horizontal">
                            <BoxView Style="{StaticResource boxIndicator}" BackgroundColor="{StaticResource Primary}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                        </StackLayout>

                        <custom:CustomLabel Text="{Binding HeaderTitle}"  Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Text="{Binding subHeaderTitle}" Style="{StaticResource CaptionLabelGrey}"/>
                         <BoxView Style="{StaticResource lineSeperator}"/>
                    </StackLayout>
                            <!--Header Section Ends-->

                            <!--Footer Section Starts-->
                     <StackLayout Grid.Row="2" BackgroundColor="White">
                        <buttons:SfButton Text="Continue" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OnContinueClicked}"/>
                     </StackLayout>
                            <!--Footer Section Ends-->
                    
                    <!--Body Section Starts-->
          
                    <!--Start of Objectioin Details-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding IsObjectionDetailVisible}" x:Name="ObjectionDetailView">
                    <StackLayout >
                        <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout>
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="10">

                                    <Image Source="ic_vat_return">
                                    </Image>

                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.FORM5ReturnDetails}" Style="{StaticResource SectionTitleBlack}"/>


                                    <custom:CustomLabel HorizontalOptions="EndAndExpand" Text="View Return" Style="{StaticResource ValueLabelBlack}" TextColor="{StaticResource Primary}">
                                    </custom:CustomLabel>
                                </StackLayout>

                                <BoxView HorizontalOptions="FillAndExpand"  HeightRequest="1" BackgroundColor="LightGray" />

                                <StackLayout Padding="10" Spacing="10" BindingContext="{Binding ZakatReturnDetail}">
                                    <StackLayout Orientation="Horizontal">
                                        <custom:CustomLabel Text="{x:Static local:AppResources.FiscalYear}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="2020" Style="{StaticResource HorizontalEnd}" />
                                    </StackLayout>
                                    <StackLayout Spacing="10" Orientation="Horizontal">
                                        <custom:CustomLabel Text="Financial Period" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="May 2019 - May 2020"  Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </StackLayout>
                                    <StackLayout Spacing="10" Orientation="Horizontal">
                                        <custom:CustomLabel Text="{x:Static local:AppResources.ZReturnReferenceNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="{Binding Fbnum}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </StackLayout>
                                    <StackLayout Spacing="10" Orientation="Horizontal">
                                        <custom:CustomLabel Text="Tax Type" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="Zakat" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </StackLayout>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60*"/>
                                            <ColumnDefinition Width="40*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="Assessment Amount GAZT" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Text="500.00 SAR" Grid.Column="1" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder>
                        <custom:CustomLabel Text="Dispute Amounts" Style="{StaticResource SectionTitleBlack}"/>
                            <custom:CustomLabel Text="The Following data has been changed by GAZT. Please edit all the data you want to dispute" Style="{StaticResource BodyLabelGrey}"/>
                            <Grid ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="Internal Procurement for Saudi" Style="{StaticResource CaptionLabelGrey}"/>
                                <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="Sales" Style="{StaticResource CaptionLabelGrey}"/>

                                <inputLayout:SfTextInputLayout Grid.Row="1" Grid.Column="0"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0">
                                    <custom:GAZTBorderlessEntry  Text="400.00"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                    </custom:GAZTBorderlessEntry>
                                </inputLayout:SfTextInputLayout>

                                <inputLayout:SfTextInputLayout Grid.Row="1" Grid.Column="1"  Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0">
                                    <custom:GAZTBorderlessEntry  Text="400.00"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                    </custom:GAZTBorderlessEntry>

                                </inputLayout:SfTextInputLayout>
                            </Grid>
                        </StackLayout>
                    </ScrollView>
                    <!--End of Objectioin Details-->
                    
                    <!--Start Of Objection Reason-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding IsObjectionReasonVisible}" x:Name="ObjectionReasonView">
                        <StackLayout>
                        <custom:CustomLabel Text="Write Your Objection Reason" Style="{StaticResource CaptionLabelGrey}"/>
                            <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0">
                                <custom:GAZTBorderlessEntry  Style="{StaticResource InputTableEntryLayoutStyle}">
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>
                    </ScrollView>
                    <!--End Of Objection Reason-->
                    
                    <!--Start of Attachment Visible-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding IsAttachmentsVisible}">
                        <StackLayout>
                        <custom:CustomLabel Margin="0,10,0,0" Text="Attachment" Style="{StaticResource CaptionLabelGrey}"/>
                            <border:SfBorder   Margin="0"  Style="{StaticResource GreyBorderFrameWithShadow}" BorderWidth="1" BorderColor="{StaticResource DarkGrayTextColor}">
                                <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                                    <Image>
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}" Size="25"
                                                             Glyph="{x:Static FontImage:IconFonts.FilePdf}"/>
                                        </Image.Source>
                                    </Image>
                                    <Label Text="File1.pdf" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="Start"/>
                                    
                                        <Image HorizontalOptions="EndAndExpand">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource SecondaryNew}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.Close}"/>
                                            </Image.Source>
                                        </Image>

                                    
                                </StackLayout>
                            </border:SfBorder>
                            <custom:CustomLabel Margin="0,-5,0,0" Text="20MB max" Style="{StaticResource CaptionLabelGrey}"/>

                            <custom:CustomLabel Margin="0,10,0,0" Text="New Attachment (Optional)" Style="{StaticResource CaptionLabelGrey}"/>
                
                            <border:SfBorder   Margin="0"  Style="{StaticResource GreyBorderFrameWithShadow}" BorderWidth="1" BorderColor="{StaticResource DarkGrayTextColor}">
                                <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                                    <Label Text="Please Upload your docuument" Style="{StaticResource ValueLabelGrey}" HorizontalOptions="Start"/>

                                    <Image HorizontalOptions="EndAndExpand" Rotation="90">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.Attachment}"/>
                                        </Image.Source>
                                    </Image>
                                </StackLayout>
                            </border:SfBorder>
                            <custom:CustomLabel Margin="0,-5,0,0" Text="50MB max" Style="{StaticResource CaptionLabelGrey}"/>
                        </StackLayout>
                    </ScrollView>
                    <!--End of Attachment Visible-->

                    <!--Start of Declaration Visible-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding IsDeclarationVisible}">
                        <Grid ColumnSpacing="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,10,0,0" Text="ID Type" Style="{StaticResource CaptionLabelGrey}"/>
                            
                            <border:SfBorder Grid.Row="1" Grid.ColumnSpan="2" HasShadow="False" Margin="0"  Style="{StaticResource GreyBorderFrameWithShadow}" BorderWidth="1" BorderColor="{StaticResource DarkGrayTextColor}">
                                <StackLayout Orientation="Horizontal" Padding="15,10,15,10">
                                    <Label Text="National ID" Style="{StaticResource ValueLabelBlackMedium}" FontAttributes="None" HorizontalOptions="Start"/>
                                    
                                    <Image HorizontalOptions="EndAndExpand">
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}" Size="25"
                                             Glyph="{x:Static FontImage:IconFonts.ArrowDown}"/>
                                        </Image.Source>
                                    </Image>
                                </StackLayout>
                            </border:SfBorder>
                            <custom:CustomLabel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="ID Number" Style="{StaticResource CaptionLabelGrey}"/>

                            <custom:CustomLabel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="Date of Birth" Style="{StaticResource CaptionLabelGrey}"/>

                            <inputLayout:SfTextInputLayout Margin="0,-10,0,0" Grid.Row="3" Grid.Column="0" Style="{StaticResource InputTableTextInputLayoutStyle}" >
                                <custom:GAZTBorderlessEntry  Text="Q1720187"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                            <inputLayout:SfTextInputLayout Margin="0,-10,0,0" Grid.Row="3" Grid.Column="1" Style="{StaticResource InputTableTextInputLayoutStyle}" >
                                <custom:GAZTBorderlessEntry  Text="7 jun 1995"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                </custom:GAZTBorderlessEntry>

                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <Image>
                                        <Image.Source>
                                            <FontImageSource FontFamily="UserIconFont"
                                                             Color="{StaticResource SecondaryNew}" Size="25" Glyph="{x:Static FontImage:IconFonts.Calendar}" />
                                        </Image.Source>
                                    </Image>
                                </inputLayout:SfTextInputLayout.TrailingView>

                            </inputLayout:SfTextInputLayout>


                            <custom:CustomLabel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" Text="Contact Person Name" Style="{StaticResource CaptionLabelGrey}"/>

                            <inputLayout:SfTextInputLayout Margin="0,-10,0,0" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource InputTableTextInputLayoutStyle}" >
                                <custom:GAZTBorderlessEntry  Text="Zaed Hardy"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                </custom:GAZTBorderlessEntry>
                            </inputLayout:SfTextInputLayout>

                        </Grid>
                    </ScrollView>
                    <!--End of Declaration Visible-->

                    <!--Start of Summary Visible-->
                    <ScrollView Grid.Row="1" IsVisible="{Binding IsSummaryVisible}">

                    </ScrollView>
                    <!--End of Summary Visible-->

                    <!--Select Returns View Starts-->
                    <StackLayout x:Name="SelectReturnsView" IsVisible="False">
                        <StackLayout Orientation="Horizontal">
                            <BoxView Style="{StaticResource boxIndicator}" BackgroundColor="{StaticResource Primary}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                            <BoxView Style="{StaticResource boxIndicator}"/>
                        </StackLayout>
                        <Label Text="Select Return"  Style="{StaticResource SectionTitleBlack}" />
                        <Label Text="Choose one Return" Style="{StaticResource CaptionLabelGrey}"/>
                        <BoxView Style="{StaticResource lineSeperator}"/>
                        <ScrollView>
                            <StackLayout>
                                <inputLayout:SfTextInputLayout Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0">
                                    <custom:GAZTBorderlessEntry  Text="500"     Style="{StaticResource InputTableEntryLayoutStyle}">
                                    </custom:GAZTBorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <Image>
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont"
                                                                 Color="{StaticResource SecondaryNew}" Size="25" Glyph="{x:Static FontImage:IconFonts.SearchWeb}"/>
                                            </Image.Source>
                                        </Image>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>

                                <border:SfBorder Margin="0,10,0,10"  Style="{StaticResource GreyBorderFrameWithShadow}" BackgroundColor="{StaticResource Primary}">
                                    <StackLayout>
                                        <StackLayout Padding="14,10,14,10" Spacing="-5">
                                            <custom:CustomLabel Text="Zakat" Style="{StaticResource ValueLabelBlack}" TextColor="White"/>
                                            <custom:CustomLabel Text="May 2019 - May 2020" Style="{StaticResource CaptionLabelGrey}" TextColor="White"/>
                                        </StackLayout>
                                        <BoxView Style="{StaticResource lineSeperator}"/>

                                        <custom:CustomLabel Text="1,200.00 SAR" Padding="14,10,14,10" Style="{StaticResource ValueLabelBlack}" TextColor="White"/>

                                        <Grid Padding="14,0,14,10" RowSpacing="-10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="Reference Number" Style="{StaticResource CaptionLabelGrey}" TextColor="White"/>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="Year" Style="{StaticResource CaptionLabelGrey}" TextColor="White"/>
                                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="1234567890   " Style="{StaticResource BodyLabelBlack}" TextColor="White"/>
                                            <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="2020   " Style="{StaticResource BodyLabelBlack}" TextColor="White"/>
                                        </Grid>
                                    </StackLayout>
                                </border:SfBorder>

                                <border:SfBorder Style="{StaticResource GreyBorderFrameWithShadow}">
                                    <StackLayout>
                                        <StackLayout Padding="14,10,14,10" Spacing="-5">
                                            <custom:CustomLabel Text="Zakat" Style="{StaticResource ValueLabelBlack}" />
                                            <custom:CustomLabel Text="May 2019 - May 2020" Style="{StaticResource CaptionLabelGrey}" />
                                        </StackLayout>
                                        <BoxView Style="{StaticResource lineSeperator}"/>

                                        <custom:CustomLabel Text="1,200.00 SAR" Padding="14,10,14,10" Style="{StaticResource ValueLabelBlack}" />

                                        <Grid Padding="14,0,14,10" RowSpacing="-10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="Reference Number" Style="{StaticResource CaptionLabelGrey}" />
                                            <custom:CustomLabel Grid.Row="0" Grid.Column="1" Text="Year" Style="{StaticResource CaptionLabelGrey}" />
                                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="1234567890   " Style="{StaticResource BodyLabelBlack}" />
                                            <custom:CustomLabel Grid.Row="1" Grid.Column="1" Text="2020   " Style="{StaticResource BodyLabelBlack}" />
                                        </Grid>
                                    </StackLayout>
                                </border:SfBorder>

                            </StackLayout>
                        </ScrollView>

                    </StackLayout>
                    <!--Select Returns View Ends-->


                    <!--Body Section Ends-->
                </Grid>
            </yummy:PancakeView>

            <Grid Padding="15,10,15,10" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="20*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="1" Grid.Row="0"   Text="Zakat Objection" TextColor="White" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" FontSize="Large" />

                <StackLayout Grid.Row="0" Grid.Column="0">
                    <Image Source="arrowLeftwhite" VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnBackStepClicked}"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Grid.Row="0" Grid.Column="2" IsVisible="{Binding isLabelVisible}">
                    <Image Source="close" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">

                    </Image>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>