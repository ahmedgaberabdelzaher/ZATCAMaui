                            <Image Source="ic_location_Outline.png"/>
                        </inputLayout:SfTextInputLayout.TrailingView>
                    </inputLayout:SfTextInputLayout>
                    <CollectionView VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand" Margin="0" VerticalScrollBarVisibility="Never">
