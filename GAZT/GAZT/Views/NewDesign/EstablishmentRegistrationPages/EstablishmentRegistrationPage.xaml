<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstablishmentRegistrationPages.EstablishmentRegistrationPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:GAZTBehaviors1="clr-namespace:GAZT.CustomControl"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:customOne="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:models="clr-namespace:EGAZT.Models"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Name="ESTRegistrationPage"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:EstablishmentTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:EstablishmentFinanicalMethodsToVisibilityConverter x:Key="methodToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="xBoolToVisibilityConverter" />
            <converters:ESTOutletDeleteActionVisibilityConverter x:Key="deleteActionVisibilityConverter" />
            <converters:ESTresidentialStatusConverter x:Key="residentialStatusConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <yummy:PancakeView
                Margin="0"
                Padding="{OnPlatform Android='0',
                                     iOS='0,0,0,30'}"
                BackgroundColor="White"
                CornerRadius="{OnPlatform Android='15,15,0,0',
                                          iOS='15'}"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ContentPresenter
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </StackLayout>
            </yummy:PancakeView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="1"
                Padding="10,10,10,0"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    x:Name="RegistrationTabMainGrid"
                    IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}"
                    Orientation="Vertical"
                    Spacing="3"
                    VerticalOptions="StartAndExpand">
                    <ScrollView
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        VerticalScrollBarVisibility="Never">
                        <Grid
                            x:Name="RegistrationTab"
                            HorizontalOptions="FillAndExpand"
                            RowSpacing="24"
                            VerticalOptions="FillAndExpand">
                            <!--  IsVisible="{Binding currentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentRegistrationTabsEnum.RegistrationType}}">  -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <StackLayout Grid.Row="0" Orientation="Vertical">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontFamily="{StaticResource GAZT_FONT_REGULAR}" Text="{x:Static ResourceManager:AppResources.ESTReportBranchQuestionLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout>
                                    <buttons:SfButton
                                        Padding="5"
                                        BorderColor="{StaticResource NeutralGreay}"
                                        BorderWidth="1"
                                        Command="{Binding OnReportingBranchSelectButtonClick}"
                                        CornerRadius="10"
                                        HorizontalTextAlignment="Start"
                                        ImageAlignment="End"
                                        ImageSource="arrowDropdown.png"
                                        ShowIcon="True"
                                        Style="{StaticResource NoBackgroundButtonStyle}"
                                        Text="{Binding SelectedReportingBranch}"
                                        TextColor="{StaticResource NeutralBlack}" />
                                </StackLayout>
                            </StackLayout>
                            <StackLayout Grid.Row="1" Orientation="Vertical">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontFamily="{StaticResource GAZT_FONT_REGULAR}" Text="{x:Static ResourceManager:AppResources.ESTEntityTypeQuestionLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomLabel
                                    Padding="0,10,0,0"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding SelectedEntityType}" />
                            </StackLayout>
                            <StackLayout Grid.Row="2" Orientation="Vertical">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontFamily="{StaticResource GAZT_FONT_REGULAR}" Text="{x:Static ResourceManager:AppResources.ESTaxpayerTypeQuestionLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomLabel
                                    Padding="0,10,0,0"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding SelectedTaxPayerType}" />
                            </StackLayout>
                            <StackLayout Grid.Row="3" Orientation="Vertical">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontFamily="{StaticResource GAZT_FONT_REGULAR}" Text="{x:Static ResourceManager:AppResources.NDWhatisYourNationality}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <custom:CustomLabel
                                    Padding="0,10,0,0"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding SelectedRegNationalityType}" />
                            </StackLayout>
                            <Grid Grid.Row="4" IsVisible="{Binding IsSaudi, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontFamily="{StaticResource GAZT_FONT_REGULAR}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusQuestionLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <buttons:SfButton
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    BackgroundColor="#cee0dd"
                                    BorderWidth="1"
                                    CornerRadius="20"
                                    HorizontalOptions="EndAndExpand"
                                    ImageSource="Paid_check.png"
                                    ImageWidth="25"
                                    IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                    ShowIcon="True"
                                    Text="{x:Static ResourceManager:AppResources.ESTResidentOptionValue}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="CenterAndExpand" />

                            </Grid>
                            <StackLayout
                                x:Name="NationalityStatusOptionmain"
                                Grid.Row="5"
                                IsVisible="{Binding IsSaudi, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                Orientation="Vertical">
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120" />
                                        <RowDefinition Height="120" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        x:Name="StayMoreKsagrid"
                                        Grid.Row="0"
                                        Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusStayMoreThanKSAClick}" />
                                        </Grid.GestureRecognizers>
                                        <!--<Image Grid.Row="0" Source="vat_tile_listofsignup_W.png"  IsVisible="{Binding IsClickedStayMoreThanKSAOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                               HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                        <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}"  Style="{StaticResource ValueLabelBlackMedium}"
                                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption,Converter={StaticResource xBoolToVisibilityConverter},ConverterParameter='invert'}"
                                                            HorizontalOptions="CenterAndExpand"  Margin="10"
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="Gray" />
                                        <Image Grid.Row="0" Source="vat_tile_listofsignup.png"
                                               IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                               HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Aspect="Fill" />
                                          <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}"  Style="{StaticResource ValueLabelBlackMedium}"
                                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                                            HorizontalOptions="CenterAndExpand"  Margin="10"
                                                            VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center"
                                                            LineSpacing="1" VerticalTextAlignment="Center" TextColor="White" />-->
                                        <cards:SfCardView
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            CornerRadius="20"
                                            HasShadow="False"
                                            HeightRequest="104"
                                            IsVisible="{Binding IsClickedStayMoreThanKSAOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            WidthRequest="171">

                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image
                                                    Aspect="Fill"
                                                    HorizontalOptions="FillAndExpand"
                                                    Source="unselected171x136"
                                                    VerticalOptions="FillAndExpand" />
                                                <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                    <custom:CustomLabel Style="{DynamicResource ValueLabelBlackMedium}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}" />
                                                </StackLayout>
                                            </Grid>

                                        </cards:SfCardView>
                                        <Grid Padding="5">
                                            <cards:SfCardView
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                CornerRadius="20"
                                                HasShadow="False"
                                                HeightRequest="110"
                                                IsVisible="{Binding IsClickedStayMoreThanKSAOption}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="110" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="selected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <custom:CustomLabel Style="{DynamicResource ValueLabelBlackMedium}" Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionOneValue}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                        </Grid>


                                    </Grid>
                                    <Grid
                                        x:Name="OwnhouseGrid"
                                        Grid.Row="0"
                                        Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusRentOwnHouseClick}" />
                                        </Grid.GestureRecognizers>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsClickedOwnRentOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            Source="vat_tile_listofsignup_W.png"
                                            VerticalOptions="FillAndExpand" />
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedOwnRentOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            LineSpacing="1"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}"
                                            TextColor="Gray"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsClickedOwnRentOption}"
                                            Source="vat_tile_listofsignup.png"
                                            VerticalOptions="FillAndExpand" />
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedOwnRentOption}"
                                            LineSpacing="1"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionTwoValue}"
                                            TextColor="White"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                    <Grid
                                        x:Name="NoneOfTheAboveGrid"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        WidthRequest="250">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding NationalityStatusNoneOfTheAboveClick}" />
                                        </Grid.GestureRecognizers>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsClickedNoneOfTheAboveOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            Source="vat_tile_listofsignup_W.png"
                                            VerticalOptions="FillAndExpand" />
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedNoneOfTheAboveOption, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                            LineSpacing="1"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}"
                                            TextColor="Gray"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Aspect="Fill"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding IsClickedNoneOfTheAboveOption}"
                                            Source="vat_tile_listofsignup.png"
                                            VerticalOptions="FillAndExpand" />
                                        <custom:CustomLabel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="10"
                                            HorizontalOptions="CenterAndExpand"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsClickedNoneOfTheAboveOption}"
                                            LineSpacing="1"
                                            Style="{StaticResource ValueLabelBlackMedium}"
                                            Text="{x:Static ResourceManager:AppResources.ESTNationalyStatusOptionThreeValue}"
                                            TextColor="White"
                                            VerticalOptions="CenterAndExpand"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </StackLayout>
                            <!--  Attachment layout start  -->
                            <StackLayout
                                x:Name="RentAttachmentsMainLayout"
                                Grid.Row="6"
                                IsVisible="{Binding IsClickedOwnRentOption}"
                                Orientation="Vertical">
                                <custom:CustomLabel Style="{StaticResource ButtonLabelBlackBold}" Text="{x:Static ResourceManager:AppResources.ZVatAttachments}" />
                                <StackLayout Orientation="Horizontal">
                                    <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontFamily="{StaticResource GAZT_FONT_REGULAR}" Text="{x:Static ResourceManager:AppResources.ESTProvideAttachmentCopyofRentLabel}" />
                                                <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Image
                                        HeightRequest="20"
                                        HorizontalOptions="EndAndExpand"
                                        Source="ic_vat_info.png"
                                        WidthRequest="20">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                                <StackLayout>
                                    <border:SfBorder
                                        Margin="0,0,0,10"
                                        BorderColor="#B1B1B1"
                                        BorderWidth="1"
                                        Style="{StaticResource GreyBorderFrame}">
                                        <StackLayout
                                            Padding="5,15,5,15"
                                            IsEnabled="True"
                                            Orientation="Horizontal">
                                            <Label
                                                HorizontalOptions="Start"
                                                Style="{StaticResource GAZTSmallBlackLabel}"
                                                Text="{x:Static ResourceManager:AppResources.Attachments}" />
                                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="5,0"
                                                    HeightRequest="20"
                                                    HorizontalOptions="Start"
                                                    Source="ic_attachment"
                                                    VerticalOptions="Center"
                                                    WidthRequest="20" />
                                            </StackLayout>
                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnEstablishmentRegistrationAttachmentTapped}" />
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </border:SfBorder>
                                </StackLayout>
                                <StackLayout IsVisible="{Binding IsVisbleRentAttachmentmentList}">
                                    <custom:CustomLabel
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource CaptionLabelGrey}"
                                        Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyofRentLabel}" />
                                    <StackLayout
                                        Margin="0,5,0,0"
                                        BindableLayout.ItemsSource="{Binding UploadedRentDocumentsList, Mode=TwoWay}"
                                        Orientation="Vertical"
                                        Spacing="5"
                                        VerticalOptions="FillAndExpand">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <border:SfBorder
                                                    Margin="0,0,0,10"
                                                    Padding="10"
                                                    BorderColor="{StaticResource NeutralGreay}"
                                                    BorderWidth="1"
                                                    CornerRadius="10"
                                                    Style="{StaticResource GreyBorderFrame}">
                                                    <Grid
                                                        ColumnSpacing="0"
                                                        HorizontalOptions="FillAndExpand"
                                                        RowSpacing="0"
                                                        VerticalOptions="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image
                                                            Grid.Column="0"
                                                            HorizontalOptions="Center"
                                                            Source="Generic_attachment_icon.png"
                                                            VerticalOptions="Center" />
                                                        <custom:CustomLabel
                                                            Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            HorizontalOptions="StartAndExpand"
                                                            HorizontalTextAlignment="Start"
                                                            Style="{StaticResource BodyLabelGrey}"
                                                            Text="{Binding Filename}"
                                                            VerticalOptions="CenterAndExpand" />
                                                        <Image
                                                            Grid.Column="2"
                                                            HorizontalOptions="Center"
                                                            Source="close.png"
                                                            VerticalOptions="Center">
                                                            <Image.GestureRecognizers>
                                                                <!--<ClickGestureRecognizer Clicked="removeRentAttachmentClicked"/>-->
                                                                <TapGestureRecognizer CommandParameter="Rentcommand" Tapped="TapRentDeleteGestureRecognizer_Tapped" />
                                                            </Image.GestureRecognizers>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout
                                x:Name="NoneOfTheAboveOptionsLayout"
                                Grid.Row="7"
                                IsVisible="{Binding IsClickedNoneOfTheAboveOption}"
                                Orientation="Vertical">
                                <Label HorizontalOptions="Start" Style="{StaticResource forLightLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontFamily="{StaticResource GAZT_FONT_REGULAR}" Text="{x:Static ResourceManager:AppResources.ESTChooseLegalEntityBelowTitleLabel}" />
                                            <Span Style="{StaticResource MandatoryRedColorLabel}" Text="*" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <StackLayout Margin="0,0,0,10" Orientation="Vertical">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            x:Name="PermanentEstablishmentGrid"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            ColumnSpacing="24"
                                            RowSpacing="24">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="104" />
                                            </Grid.RowDefinitions>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PermanentEstablishmentLegalEntityClick}" />
                                            </Grid.GestureRecognizers>
                                            <cards:SfCardView
                                                CornerRadius="20"
                                                HasShadow="False"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedPermanentLegalEntity, Converter={StaticResource xBoolToVisibilityConverter}, ConverterParameter='invert'}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="unselected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <Label Style="{DynamicResource CardLabelBlack}" Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" />
                                                    </StackLayout>
                                                </Grid>
                                            </cards:SfCardView>
                                            <cards:SfCardView
                                                CornerRadius="20"
                                                HasShadow="False"
                                                HeightRequest="104"
                                                IsVisible="{Binding IsClickedPermanentLegalEntity}"
                                                WidthRequest="171">
                                                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="104" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Aspect="Fill"
                                                        HorizontalOptions="FillAndExpand"
                                                        Source="selected171x136"
                                                        VerticalOptions="FillAndExpand" />
                                                    <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                                        <Label Style="{DynamicResource CardLabelWhite}" Text="{x:Static ResourceManager:AppResources.ESTPermanentEstablishmentTypeLabel}" />
                                                    </StackLayout>
