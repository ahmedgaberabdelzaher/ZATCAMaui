                        <StackLayout
                            HorizontalOptions="EndAndExpand"
                            Orientation="Horizontal"
                            Rotation="90"
                            Spacing="3"
                            VerticalOptions="CenterAndExpand">
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                            <BoxView
                                BackgroundColor="{StaticResource SecondaryNew}"
                                CornerRadius="3"
                                HeightRequest="5"
                                WidthRequest="5" />
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnVoidOrSaveDraftClick}" NumberOfTapsRequired="1" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </Grid>
                <commonView:PageIndicatorView
                    Completed="{Binding MarkComplete}"
                    DotSize="12"
                    HorizontalOptions="End"
                    MarkSize="24"
                    MaxNum="{Binding MaxIndex}"
                    MinNum="{Binding CurrentIndex}" />
                <custom:CustomLabel
                    Margin="0,15,0,0"
                    Padding="0,10,0,0"
                    HorizontalOptions="Start"
                    Style="{StaticResource PageTitleBlack}"
                    Text="{Binding SelectedTabText}"
                    VerticalOptions="Center" />
