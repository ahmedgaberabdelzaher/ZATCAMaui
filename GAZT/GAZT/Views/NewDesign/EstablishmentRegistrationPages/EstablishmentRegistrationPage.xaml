                                </StackLayout>
                            </StackLayout>
                        </cards:SfCardView>

                        <StackLayout Orientation="Horizontal">
                            <custom1:CheckboxCustom
                                IsChecked="{Binding ESTLedge}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />
                            <Label Text="{x:Static ResourceManager:AppResources.ESTPledgeLabel}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding ESTLedge}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding ESTLedge}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <StackLayout
                Grid.Row="0"
                Padding="20,15"
                BackgroundColor="White"
