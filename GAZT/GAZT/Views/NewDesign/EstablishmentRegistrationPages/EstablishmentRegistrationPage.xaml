                                            <StackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OnPassportAttachmentTapped}" ></TapGestureRecognizer>
                                            </StackLayout.GestureRecognizers>
                                        </StackLayout>
                                    </border:SfBorder >
                                </StackLayout>
                                <StackLayout>
                                    <custom:CustomLabel Text="Attachment - passport details" HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource CaptionLabelGrey}" />
