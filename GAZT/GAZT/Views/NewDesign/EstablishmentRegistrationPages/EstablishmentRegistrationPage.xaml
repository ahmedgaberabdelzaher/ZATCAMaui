                                            Grid.Row="2"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding FiscalMonth}"
                                            VerticalOptions="Center" />
                                        <custom:CustomLabel
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Style="{StaticResource BodyLabelGrey}"
                                            Text="{x:Static ResourceManager:AppResources.ESTEndOfFiscalDay}" />
