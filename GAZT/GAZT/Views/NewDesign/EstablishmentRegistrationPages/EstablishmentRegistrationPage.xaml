                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource BodyLabelGrey}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                <BoxView
                    Margin="0,15"
                    BackgroundColor="WhiteSmoke"
                    HeightRequest="1" />
                <ScrollView
                    x:Name="TabScrollView"
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <!--<buttons:SfChipGroup Type="Choice"  x:Name="TabSfChipGroup" SelectedItem="{Binding SelectedTabText}" Style=""  ItemsSource="{x:Binding TabList}" SelectionChanged="SfChipGroup_SelectionChanged" SelectionChanging="SfChipGroup_SelectionChanging"  ChipBackgroundColor="Transparent" HorizontalOptions="Start"  SelectedChipBackgroundColor="{StaticResource BackgroundGray}" ChipBorderColor="{StaticResource NeutralLightGrey}" SelectedChipTextColor="{StaticResource Primary}" ChipBorderWidth="1">
                    </buttons:SfChipGroup>-->


                    <buttons:SfChipGroup
                        x:Name="TabSfChipGroup"
                        Margin="0,10,0,0"
                        ChipBackgroundColor="Transparent"
                        ChipBorderColor="{StaticResource NeutralLightGrey}"
                        ChipBorderWidth="1"
                        HorizontalOptions="Start"
                        ItemsSource="{Binding TabList}"
                        SelectedChipBackgroundColor="{StaticResource PartialBg}"
                        SelectedItem="{Binding SelectedTabText}"
                        SelectionChanged="SfChipGroup_SelectionChanged"
                        SelectionChanging="SfChipGroup_SelectionChanging"
                        Type="Choice"
                        VerticalOptions="Center">
                        <buttons:SfChipGroup.ItemTemplate>
                            <DataTemplate>
                                <StackLayout
                                    Margin="0"
                                    Padding="5,-2,5,-2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <custom:CustomLabel
                                        HorizontalOptions="CenterAndExpand"
                                        Style="{StaticResource CaptionLabelBlack}"
                                        Text="{Binding}" />
                                </StackLayout>
                            </DataTemplate>
                        </buttons:SfChipGroup.ItemTemplate>
                    </buttons:SfChipGroup>
                </ScrollView>
            </StackLayout>
            <Grid
                Grid.Row="2"
                Padding="20,15"
                BackgroundColor="White">
                <buttons:SfButton
                    Command="{Binding OnNextButtonClick}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{Binding NxtButtonLabel}" />
            </Grid>
            <!--<StackLayout IsVisible="{Binding IsLoading}" BackgroundColor="Black" Opacity="0.4"
               Grid.Row="0" Grid.RowSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                <busyindicator:SfBusyIndicator HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
	                        EnableAnimation="True"
	                        AnimationType="SingleCircle"
	                        IsBusy="True"
	                        TextColor="{StaticResource Secondary}"
	                        ViewBoxWidth="70"
                            ViewBoxHeight="70"
                            TitlePlacement="Bottom" />
            </StackLayout>-->

            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>


        </Grid>
    </ContentPage.Content>
</ContentPage>
