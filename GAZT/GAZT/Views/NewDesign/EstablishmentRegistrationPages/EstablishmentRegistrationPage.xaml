                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        HeightRequest="40"
