                                            Grid.Row="3"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Style="{StaticResource ValueLabelBlack}"
                                            Text="{Binding FiscalDay}"
                                            VerticalOptions="Center" />
                                        <custom:CustomLabel
