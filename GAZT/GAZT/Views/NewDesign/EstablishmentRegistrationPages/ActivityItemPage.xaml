                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnAcitivitySelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding LicenseAcitivity}"
                            TextColor="{StaticResource NeutralBlack}" />
                    </StackLayout>
                </ScrollView>
            </Grid>
            <StackLayout
                Grid.Row="0"
                Padding="20,15"
                BackgroundColor="White"
                HorizontalOptions="FillAndExpand"
                Orientation="Vertical"
                Spacing="0"
                VerticalOptions="StartAndExpand">
                <Grid
                    Padding="0,0,0,10"
                    ColumnSpacing="0"
                    RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*" />
                        <ColumnDefinition Width="70*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="-30,0,-30,0"
                        HorizontalOptions="Center"
                        Source="arrowLeft"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
