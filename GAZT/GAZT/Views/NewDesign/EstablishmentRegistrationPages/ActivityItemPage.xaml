<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.EstablishmentRegistrationPages.ActivityItemPage"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:customOne="clr-namespace:GAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:models="clr-namespace:EGAZT.Models"
    xmlns:syncfusion="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Name="ESTActivityItemPage"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                <Setter Property="Rotation" Value="180" />
            </Style>
            <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                <Setter Property="Rotation" Value="0" />
            </Style>
            <converters:EstablishmentRegistrationActivityTabsEnumToVisibilityConverter x:Key="enumToVisibilityConverter" />
            <converters:EstablishmentMainActivityToVisibilityConverter x:Key="isMainActivityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <yummy:PancakeView
                Margin="0"
                Padding="0"
                BackgroundColor="White"
                CornerRadius="{OnPlatform Android='15,15,0,0',
                                          iOS='15'}"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Margin="0"
                    Padding="0"
                    HorizontalOptions="FillAndExpand"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <ContentPresenter
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand" />
                </StackLayout>
            </yummy:PancakeView>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid
            Padding="0"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="1"
                Padding="20,10,20,0"
                ColumnSpacing="0"
                HorizontalOptions="FillAndExpand"
                RowSpacing="0"
                VerticalOptions="FillAndExpand">
                <ScrollView
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.CRDetails}}"
                    Orientation="Vertical"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill">
                        <custom:CustomLabel
                            Margin="0,0,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTIssueCountryLabel}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnIssueCountrySelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding CRIssueCountry}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTIssueBy}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnIssueBySelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding CRIssueBy}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTIssueCity}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnIssueCitySelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding CRIssueCity}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ZCRNumber}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <inputLayout:SfTextInputLayout
                            Margin="0,-6,0,-6"
                            ContainerType="Outlined"
                            HorizontalOptions="FillAndExpand"
                            InputViewPadding="16,0,16,0"
                            IsEnabled="{Binding EnableCRInputField}"
                            LeadingViewPosition="Inside"
                            Style="{StaticResource TextInputLayout}"
                            UnfocusedColor="#B1B1B1">
                            <custom:GAZTBorderlessEntry
                                Margin="10"
                                FontFamily="{StaticResource SomarRegular}"
                                FontSize="15"
                                HeightRequest="48"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Start"
                                Keyboard="Numeric"
                                MaxLength="10"
                                PlaceholderColor="{StaticResource NeutralGreay}"
                                Style="{StaticResource DefaultEntry}"
                                Text="{Binding CRNumber}"
                                TextColor="{StaticResource NeutralBlack}"
                                Unfocused="CREntry_Unfocused"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center">

                                <customOne:GAZTBorderlessEntry.Behaviors>
                                    <custom:NumericValidationBehavior />
                                </customOne:GAZTBorderlessEntry.Behaviors>
                            </custom:GAZTBorderlessEntry>
                        </inputLayout:SfTextInputLayout>
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTValidFrom}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Clicked="crValidFromButtonClick"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding DisplayCRValidFrom}"
                            TextColor="{StaticResource NeutralBlack}">
                            <buttons:SfButton.ImageSource>
                                <FontImageSource
                                    FontFamily="UserIconFont"
                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                    Size="20"
                                    Color="{StaticResource SecondaryNew}" />
                            </buttons:SfButton.ImageSource>
                        </buttons:SfButton>
                        <custom1:CustomDatePicker
                            x:Name="crValidFromPicker"
                            Margin="10,0,10,0"
                            BackgroundColor="White"
                            BorderColor="Black"
                            CancelButtonBackgroundColor="#EAF7CC"
                            CancelButtonTextColor="{StaticResource Primary}"
                            Closed="crValidFromPicker_Closed"
                            ColumnHeaderBackgroundColor="White"
                            ColumnHeaderHeight="46"
                            FlowDirection="RightToLeft"
                            HeaderBackgroundColor="#EAF7CC"
                            HeaderText="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            OKButtonBackgroundColor="#EAF7CC"
                            OKButtonTextColor="{StaticResource Primary}"
                            PickerMode="Dialog"
                            SelectedItem="{Binding SelectedCRValidFromDate}"
                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                            ShowColumnHeader="True"
                            ShowFooter="False"
                            ShowHeader="False">
                            <custom1:CustomDatePicker.Behaviors>
                                <custom1:SfPickerBehavior />
                            </custom1:CustomDatePicker.Behaviors>
                        </custom1:CustomDatePicker>
                        <custom1:CustomHijriDatePicker
                            x:Name="crValidFromHijiriPicker"
                            Margin="10,0,10,0"
                            BackgroundColor="White"
                            BorderColor="Black"
                            CancelButtonBackgroundColor="#EAF7CC"
                            CancelButtonTextColor="{StaticResource Primary}"
                            Closed="crValidFromPicker_Closed"
                            ColumnHeaderBackgroundColor="White"
                            ColumnHeaderHeight="46"
                            FlowDirection="RightToLeft"
                            HeaderBackgroundColor="#EAF7CC"
                            HeaderText="{x:Static ResourceManager:AppResources.ESTIssueDateLabel}"
                            HorizontalOptions="FillAndExpand"
                            ItemHeight="40"
                            OKButtonBackgroundColor="#EAF7CC"
                            OKButtonTextColor="{StaticResource Primary}"
                            PickerMode="Dialog"
                            SelectedItem="{Binding SelectedCRValidFromHijiriDate}"
                            SelectedItemTextColor="{StaticResource NeutralBlack}"
                            ShowColumnHeader="True"
                            ShowFooter="False"
                            ShowHeader="False" />
                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.ESTMainActivity}"
                                VerticalOptions="Center" />
                            <syncfusion:SfSwitch
                                x:Name="CRMainActivity"
                                HorizontalOptions="Center"
                                IsOn="{Binding MainActivity}"
                                StateChanged="CRSwitch_StateChanged"
                                VerticalOptions="Center"
                                VisualType="Material" />
                        </StackLayout>
                        <custom:CustomLabel
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            Text="{x:Static ResourceManager:AppResources.Attachments}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <StackLayout
                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="Center">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyOfCRLabel}" />
                                        <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <Image
                                HorizontalOptions="Center"
                                Source="ic_vat_info.png"
                                VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnTransferCopyOfCRChoiceButtonClick}"
                            CommandParameter="RG01"
                            CornerRadius="10"
                            FontSize="13"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="ic_attachment"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                            TextColor="{StaticResource NeutralGreay}" />
                        <StackLayout
                            Margin="0,5,0,0"
                            BindableLayout.ItemsSource="{Binding CRsCopies}"
                            Orientation="Vertical"
                            Spacing="5"
                            VerticalOptions="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <border:SfBorder
                                        Padding="10"
                                        BorderColor="{StaticResource NeutralGreay}"
                                        BorderWidth="1"
                                        CornerRadius="10">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="Generic_attachment_icon.png"
                                                VerticalOptions="Center" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding Filename}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="Center"
                                                Source="close.png"
                                                VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={Reference ESTActivityItemPage}, Path=BindingContext.OnDeleteCRsCopyButtonClick}"
                                                        CommandParameter="{Binding .}"
                                                        NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </border:SfBorder>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <custom:CustomLabel
                            Margin="0,15,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.ESTAttachmentTransferCopyOfCRLabel}"
                            VerticalOptions="Center" />
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnTransferCopyOfCRChoiceButtonClick}"
                            CommandParameter="RG12"
                            CornerRadius="10"
                            FontSize="13"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="ic_attachment"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationAttachmentUploadYourDocument}"
                            TextColor="{StaticResource NeutralGreay}" />
                        <StackLayout
                            Margin="0,5,0,0"
                            BindableLayout.ItemsSource="{Binding TransferCRsCopies}"
                            Orientation="Vertical"
                            Spacing="5"
                            VerticalOptions="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <border:SfBorder
                                        Padding="10"
                                        BorderColor="{StaticResource NeutralGreay}"
                                        BorderWidth="1"
                                        CornerRadius="10">
                                        <Grid
                                            ColumnSpacing="0"
                                            HorizontalOptions="Fill"
                                            RowSpacing="0"
                                            VerticalOptions="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Grid.Column="0"
                                                HorizontalOptions="Center"
                                                Source="Generic_attachment_icon.png"
                                                VerticalOptions="Center" />
                                            <custom:CustomLabel
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalOptions="StartAndExpand"
                                                HorizontalTextAlignment="Start"
                                                Style="{StaticResource BodyLabelGrey}"
                                                Text="{Binding Filename}"
                                                VerticalOptions="CenterAndExpand" />
                                            <Image
                                                Grid.Column="2"
                                                HorizontalOptions="Center"
                                                Source="close.png"
                                                VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={Reference ESTActivityItemPage}, Path=BindingContext.OnDeleteTransferCRsCopyButtonClick}"
                                                        CommandParameter="{Binding .}"
                                                        NumberOfTapsRequired="1" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </border:SfBorder>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                        <custom:CustomLabel
                            Margin="0,15"
                            FontFamily="{StaticResource SomarBold}"
                            FontSize="18"
                            Text="{x:Static ResourceManager:AppResources.ESTBusinessActivityDetails}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,0,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTMainGroup}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnMainGroupSelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding CRMainGroup}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTSubGroup}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnSubGroupSelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding CRSubGroup}"
                            TextColor="{StaticResource NeutralBlack}" />
                        <custom:CustomLabel
                            Margin="0,10,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTActivity}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnAcitivitySelectButtonClick}"
                            CornerRadius="10"
                            HorizontalTextAlignment="Start"
                            ImageAlignment="End"
                            ImageSource="arrowDropdown.png"
                            ShowIcon="True"
                            Style="{StaticResource NoBackgroundButtonStyle}"
                            Text="{Binding CRAcitivity}"
                            TextColor="{StaticResource NeutralBlack}" />
                    </StackLayout>
                </ScrollView>
                <StackLayout
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.ActivityList}}"
                    Orientation="Vertical"
                    Spacing="0"
                    VerticalOptions="FillAndExpand">
                    <buttons:SfButton
                        Padding="5"
                        BorderColor="{StaticResource NeutralGreay}"
                        BorderWidth="1"
                        Command="{Binding OnNewLicenseButtonClick}"
                        CornerRadius="10"
                        HeightRequest="56"
                        HorizontalTextAlignment="Start"
                        ImageSource="ic_add_plus.png"
                        ShowIcon="True"
                        Style="{StaticResource NoBackgroundButtonStyle}"
                        Text="{x:Static ResourceManager:AppResources.ESTAddLicense}"
                        TextColor="{StaticResource NewDarkGreenColor}" />
                    <listView:SfListView
                        Margin="0,15"
                        AutoFitMode="Height"
                        HorizontalOptions="Fill"
                        IsScrollBarVisible="False"
                        ItemSpacing="5"
                        ItemsSource="{Binding LicenseData}"
                        SelectedItem="{Binding SelectedLicense}"
                        SelectionBackgroundColor="Transparent"
                        SelectionMode="Single"
                        VerticalOptions="Start">
                        <listView:SfListView.LayoutManager>
                            <listView:LinearLayout />
                        </listView:SfListView.LayoutManager>
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource NeutralGreay}"
                                    BorderWidth="0.7"
                                    HasShadow="False">
                                    <Grid
                                        Padding="12"
                                        ColumnSpacing="10"
                                        HorizontalOptions="FillAndExpand"
                                        VerticalOptions="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel
                                            Grid.Column="0"
                                            FontFamily="{StaticResource SomarBold}"
                                            FontSize="15"
                                            HorizontalOptions="FillAndExpand"
                                            Text="{Binding Idnumber}"
                                            TextColor="{StaticResource NeutralBlack}"
                                            VerticalOptions="Center" />
                                        <Image
                                            Grid.Column="1"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding Actcat, Converter={StaticResource isMainActivityConverter}}"
                                            Source="check_oval.png"
                                            VerticalOptions="Center" />
                                        <Image
                                            Grid.Column="2"
                                            HorizontalOptions="Center"
                                            Source="arrowRight.png"
                                            Style="{DynamicResource BackButtonArrow}"
                                            VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={Reference ESTActivityItemPage}, Path=BindingContext.OnLicenseSelected}" CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                    </listView:SfListView>
                </StackLayout>
                <ScrollView
                    IsVisible="{Binding CurrentTab, Converter={StaticResource enumToVisibilityConverter}, ConverterParameter={x:Static models:EstablishmentOutletActivitiesTabsEnum.LicenseDetails}}"
                    Orientation="Vertical"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        HorizontalOptions="Fill"
                        Spacing="0"
                        VerticalOptions="Fill">
                        <custom:CustomLabel
                            Margin="0,0,0,0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource CaptionLabelGrey}"
                            VerticalOptions="Center">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.ESTIssueCountryLabel}" />
                                    <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnIssueCountrySelectButtonClick}"
