                            Margin="0,10,0,0"
                            Padding="10,0"
                            HorizontalOptions="FillAndExpand"
                            Orientation="Horizontal"
                            VerticalOptions="EndAndExpand">
                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                VerticalOptions="Center">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.ESTAttachmentCopyOfLicense}" />
                                        <Span Text="*" TextColor="{StaticResource InformationRedColor}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <Image
                                HorizontalOptions="Center"
