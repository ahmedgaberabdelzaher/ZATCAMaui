                    FontFamily="{StaticResource SomarRegular}"
                    FontSize="15"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource forLightLabel}"
                    Text="{x:Static ResourceManager:AppResources.ZZZZCompletethebelowdetails}" />
                <BoxView
                    Margin="0,15"
                    BackgroundColor="WhiteSmoke"
                    HeightRequest="1" />
            </StackLayout>
            <Grid
                Grid.Row="2"
                Margin="0,20,0,20"
                Padding="20,15"
                BackgroundColor="White">
                <buttons:SfButton
                    Command="{Binding OnNextButtonClick}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Text="{x:Static ResourceManager:AppResources.ZZNext}" />
            </Grid>
            <!--<StackLayout IsVisible="{Binding IsLoading}" BackgroundColor="Black" Opacity="0.4"
               Grid.Row="0" Grid.RowSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                <busyindicator:SfBusyIndicator HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
	                        EnableAnimation="True"
	                        AnimationType="SingleCircle"
	                        IsBusy="True"
	                        TextColor="{StaticResource Primary}"
	                        ViewBoxWidth="70"
                            ViewBoxHeight="70"
                            TitlePlacement="Bottom" />
            </StackLayout>-->


            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Margin="0,-20,0,0"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="FillAndExpand">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
