                                VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TappedOnAttachmentInformationIcon}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                        <buttons:SfButton
                            Margin="0,5,0,0"
                            Padding="5"
                            BorderColor="{StaticResource NeutralGreay}"
                            BorderWidth="1"
                            Command="{Binding OnTransferCopyOfLicenseChoiceButtonClick}"
