                            <buttons:SfButton ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" Text="{Binding CountrySame}"  Command="{Binding OnCountrySelectButtonClick}" CommandParameter="same"
                                                       Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                                       TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" Padding="5" Margin="0,5,0,0" />
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="Provinance"/>
                                        <Span Text="*" TextColor="{StaticResource Secondary}"/>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <buttons:SfButton ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" Text="{Binding ProvinanceSame}"  Command="{Binding OnProvinanceSelectButtonClick}" CommandParameter="same"
                                                       Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                                       TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" Padding="5" Margin="0,5,0,0" />
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" HorizontalOptions="StartAndExpand" VerticalOptions="Center" Margin="0,10,0,0">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="City"/>
                                        <Span Text="*" TextColor="{StaticResource Secondary}"/>
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <buttons:SfButton ShowIcon="True" ImageSource="arrowDropdown.png" ImageAlignment="End" Text="{Binding CitySame}"  Command="{Binding OnCitySelectButtonClick}" CommandParameter="same"
                                                       Style="{StaticResource NoBackgroundButtonStyle}" BorderColor="{StaticResource NeutralGreay}" BorderWidth="1" CornerRadius="10" 
                                                       TextColor="{StaticResource NeutralBlack}" HorizontalTextAlignment="Start" Padding="5" Margin="0,5,0,0" />
                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <StackLayout Grid.Row="0" Spacing="0" Padding="20,15" Orientation="Vertical" VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="White">
                <Grid ColumnSpacing="0" RowSpacing="0" Padding="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Color="LightGray" FontFamily="UserIconFont" Size="48" Glyph="{x:Static FontImage:IconFonts.ChevronLeft}"/>
                        </Image.Source>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OnPreButtonClick}" NumberOfTapsRequired="1"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Grid.Column="1" Grid.Row="0" Source="ic_logo_gazt.png" HeightRequest="27" WidthRequest="27" />
                    <Image Grid.Column="2" Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Color="LightGray" FontFamily="UserIconFont" Size="36" Glyph="{x:Static FontImage:IconFonts.DotsVertical}"/>
                        </Image.Source>
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
                <commonView:PageIndicatorView MarkSize="24" DotSize="12" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" />
                <custom:CustomLabel Text="{Binding SelectedOutletTabText}" HorizontalOptions="Start" VerticalOptions="Center" Padding="0,-5,0,-10" Style="{StaticResource SectionTitleBlack}" FontFamily="{StaticResource SSTArBold}" FontSize="28"/>
                <custom:CustomLabel Text="Complete the below details" HorizontalOptions="StartAndExpand" Style="{StaticResource forLightLabel}" FontFamily="{StaticResource SSTArRoman}" FontSize="16"/>
                <BoxView BackgroundColor="WhiteSmoke" HeightRequest="1" Margin="0,15" />
                <buttons:SfChipGroup Type="Choice" SelectedItem="Outlets" ChipBackgroundColor="Transparent" HorizontalOptions="Start"  SelectedChipBackgroundColor="#E5EFED" ChipBorderColor="{StaticResource NeutralLightGrey}" SelectedChipTextColor="#006450" ChipBorderWidth="1" >
                    <buttons:SfChipGroup.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Passport Details</x:String>
                            <x:String>Outlets</x:String>
                            <x:String>Financial Details</x:String>
                        </x:Array>
                    </buttons:SfChipGroup.ItemsSource>
                </buttons:SfChipGroup>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" x:Name="OutletTabScrollView">
                <buttons:SfChipGroup Type="Choice" SelectedItem="{Binding SelectedOutletTabText}" x:Name="OutletTabSfChipGroup" SelectionChanged="SfChipGroup_SelectionChanged" Margin="0,10" ChipBackgroundColor="Transparent" HorizontalOptions="Start"  SelectedChipBackgroundColor="#E5EFED" ChipBorderColor="{StaticResource NeutralLightGrey}" SelectedChipTextColor="#006450" ChipBorderWidth="1" >
                    <buttons:SfChipGroup.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Outlet Details</x:String>
                            <x:String>Activity Details</x:String>
                            <x:String>Address Details</x:String>
                        </x:Array>
                    </buttons:SfChipGroup.ItemsSource>
                </buttons:SfChipGroup>
                    </ScrollView>
            </StackLayout>
            <Grid Grid.Row="2" Padding="20,15" BackgroundColor="White">
                <buttons:SfButton Style="{StaticResource PrimaryButtonStyle}" Text="Next" Command="{Binding OnNextButtonClick}" />
            </Grid>
            <StackLayout IsVisible="{Binding IsLoading}" BackgroundColor="Black" Opacity="0.4"
               Grid.Row="0" Grid.RowSpan="3" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" >
                <busyindicator:SfBusyIndicator HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
	                        EnableAnimation="True" 
	                        AnimationType="SingleCircle" 
	                        IsBusy="True" 
	                        TextColor="#D99A29"
	                        ViewBoxWidth="70"
                            ViewBoxHeight="70"
                            TitlePlacement="Bottom" />
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
