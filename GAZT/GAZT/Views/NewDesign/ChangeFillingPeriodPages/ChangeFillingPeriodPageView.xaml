<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:commonView="clr-namespace:EGAZT.Views.NewDesign.Common"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
              xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms" 
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             ios:Page.UseSafeArea="true"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             mc:Ignorable="d" FlowDirection="RightToLeft"    
              xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"   xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             x:Class="EGAZT.Views.NewDesign.ChangeFillingPeriodPages.ChangeFillingPeriodPageView" 
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector"/>
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>


    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0"
                  Padding="0,0,0,0" x:Name="VATRMainGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriod}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <StackLayout  Grid.Row="0" Grid.Column="2">
                            <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                                <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.onMoreOptionClicked }"/>
                            </StackLayout.GestureRecognizers>
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <commonView:PageIndicatorView HeightRequest="16" Margin="20,25,0,0" MaxNum="{Binding MaxIndex}" MinNum="{Binding CurrentIndex}" Completed="{Binding MarkComplete}" VerticalOptions="CenterAndExpand" DotSize="12" />
                </Grid>

                <Grid Grid.Row="1">

                    <!--Frequency Details screen-->

                    <Grid IsVisible="{Binding IsFrequencyViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlackBold}" FontSize="28" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetailsSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Frame Grid.Row="0" HasShadow="False"  HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Margin="10" Padding="10,3,10,3" VerticalOptions="FillAndExpand">
                                <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="0,5,0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelGrey}" Margin="0" Padding="0" />
                                    <custom:CustomLabel Grid.Row="1" Text="{Binding CurrentFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlackBold}" Margin="0,8,0,0" Padding="0"  />
                                </Grid>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1" HasShadow="False" Margin="10" HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,3,10,3" VerticalOptions="FillAndExpand">
                                <Grid HorizontalOptions="FillAndExpand" ColumnSpacing="0" RowSpacing="0" Padding="0,5,0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <custom:CustomLabel Grid.Row="0" Grid.Column="0" VerticalOptions="Start" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelGrey}"  Margin="0" Padding="0"   />

                                    <custom:CustomLabel Grid.Row="1" Grid.Column="0" VerticalOptions="Start" Text="{Binding NewFrequency}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource ValueLabelBlackBold}" Margin="0,8,0,0" Padding="0" />
                                </Grid>
                            </Frame>
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="0" RowSpacing="0" HeightRequest="80" WidthRequest="171" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition Height="auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <custom:CustomLabel Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}" HorizontalOptions="StartAndExpand" Style="{StaticResource MiniNewGrayLabelStyle}" Margin="0" Padding="0">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}"  />
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>

                            <Frame Grid.Row="1" HasShadow="False" Margin="0,5,0,0"  HorizontalOptions="FillAndExpand" CornerRadius="12" BorderColor="Gray" Padding="10,0,10,0">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
                                    <custom:GAZTBorderlessEntry IsEnabled="False" Text="{Binding EffectiveDatePicked}" 
                                                    PlaceholderColor="Gray"  FontSize="Small" TextColor="Black" FontAttributes="Bold" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"/>
                                    <Image Source="arrowDropdown.png" WidthRequest="24" HeightRequest="24" Margin="12" VerticalOptions="CenterAndExpand">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding EffectiveDateSpinnerClicked}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </Frame>

                        </Grid>

                        <StackLayout Grid.Row="3" Margin="10,25,10,0" Grid.ColumnSpan="2" IsVisible="{Binding IsDecCheckBoxVisible}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--<CheckBox Grid.Column="0" Color="{StaticResource NewDarkGreenColor}"
                                          VerticalOptions="CenterAndExpand" CheckedChanged="OnFrequechCheckChanged"
                                          IsChecked="{Binding IsFrequencyDetailsChecked}">
                                    <CheckBox.Triggers>
                                        <DataTrigger TargetType="CheckBox" Value="false">
                                            <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                        </DataTrigger>
                                    </CheckBox.Triggers>
                                </CheckBox>
                                <custom:CustomLabel Grid.Column="1"
                                                    Text="{x:Static ResourceManager:AppResources.VFCFrequencyDetailsCheckBoxString}"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" />-->
                                <StackLayout Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2">
                                                    <custom1:CheckboxCustom  
                                                                       Style="{StaticResource CheckboxHeightWidth32}"
                                                                         VerticalOptions="CenterAndExpand"  CheckChanged="OnFrequechCheckChanged" IsChecked="{Binding IsFrequencyDetailsChecked}"/>
                                                    <custom:CustomLabel   >
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span    Text="{x:Static ResourceManager:AppResources.VFCFrequencyDetailsCheckBoxString}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                        <custom:CustomLabel.Triggers>
                                                                     <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsFrequencyDetailsChecked}" Value="True">
                                                                         <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                                                     </DataTrigger>
                                                             <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsFrequencyDetailsChecked}" Value="False">
                                                                         <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                                                     </DataTrigger>
                                                       </custom:CustomLabel.Triggers>
                                                    </custom:CustomLabel>
                                </StackLayout>




                            </Grid>
                        </StackLayout>

                        <Frame Margin="-20,0,-20,0" Grid.Row="4" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False">

                            <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" BackgroundColor="{Binding FrequencyDetailsButtonBackGroundColor}" WidthRequest="366" HeightRequest="48"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding FrequencyContinueBtnTapped}" />

                        </Frame>
                    </Grid>



                    <!--Attachments screen-->

                    <StackLayout IsVisible="{Binding IsAttachmentsViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}" HorizontalOptions="StartAndExpand"
                                         Style="{StaticResource SectionTitleBlackBold}" FontSize="28" />
                            <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsSub}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                            <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>


                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>

                            </Grid.RowDefinitions>


                            <StackLayout Grid.Row="0" Grid.Column="0" >
                                <listView:SfListView HorizontalOptions="Center" x:Name="AttachmentTypeOption" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="Center" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" AutoFitMode="Height" ItemSpacing="5"
                                      ItemsSource="{Binding OutletDecisionOptions}" SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"  SelectionMode="Single"
                                       SelectedItemTemplate="{StaticResource SelectedIttemTemplateSelector}"
                                      ItemTemplate="{StaticResource UnselectedItemTemplateSelector}"
                                      SelectionBackgroundColor="Transparent" SelectionChanged="outletDecisionOptionsListView_SelectionChanged">
                                    <listView:SfListView.LayoutManager>
                                        <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                                    </listView:SfListView.LayoutManager>
                                </listView:SfListView>
                            </StackLayout>
                        </Grid>
                        <StackLayout Grid.Row="2" IsVisible="{Binding ShowAttachments}" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid Grid.Row="0" IsVisible="{Binding IsTwoYearsAtachmentsVisible}" HorizontalOptions="FillAndExpand">
                                <listView:SfListView HorizontalOptions="Center"
                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding YearsattachmentsListViewData}"
                                             TapCommand="{Binding NewAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">


                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>

                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               LineHeight="0.8"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="Center"/>
                                                        <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>

                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>

                            <Grid Grid.Row="0" IsVisible="{Binding IsMonthsAtachmentsVisible}" HorizontalOptions="FillAndExpand">

                                <listView:SfListView HorizontalOptions="Center"
                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding MonthsattachmentsListViewData}"
                                             TapCommand="{Binding NewAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">


                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>

                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               LineHeight="0.8"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="Center"/>
                                                        <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>

                            <Grid Grid.Row="0" IsVisible="{Binding IsOthersAtachmentsVisible}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                                <listView:SfListView HorizontalOptions="Center"
                                             IsScrollBarVisible="False" IsScrollingEnabled="False"
                                             VerticalOptions="Center" AutoFitMode="Height" ItemSpacing="5"
                                             ItemsSource="{Binding OtherAttachmentsListViewData}"
                                             TapCommand="{Binding NewAttachmentTapped}"
                                             SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">


                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>

                                                <border:SfBorder Grid.Row="0" Margin="0,0,0,10" Padding="12"
                                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Source="Generic_attachment_icon" Margin="5,0" WidthRequest="25" HeightRequest="25"
                                                       HorizontalOptions="Start" VerticalOptions="Center"/>

                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Filename}"
                                                               Style="{StaticResource CaptionLabelBlack}"
                                                               LineHeight="0.8"
                                                               HorizontalOptions="FillAndExpand"
                                                               VerticalOptions="Center"/>
                                                        <Image Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Rotation="90">
                                                            <Image.Source>
                                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray"
                                                                         Size="24"
                                                                         Glyph="{x:Static FontImage:IconFonts.Close}" />
                                                            </Image.Source>
                                                        </Image>
                                                    </Grid>
                                                </border:SfBorder>
                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>
                            </Grid>

                            <Grid Grid.Row="1" HorizontalOptions="FillAndExpand">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <custom:CustomLabel Grid.Row="0"
                                            Text="{x:Static ResourceManager:AppResources.VRNewAttachment}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />
                                <border:SfBorder Grid.Row="1" Margin="0,0,0,10" Padding="10"
                                         Style="{StaticResource SfStyleGreyBorderFrame}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Row="0" Grid.Column="0"
                                                    Text="{x:Static ResourceManager:AppResources.VRUploadYourDocument}"
                                                    FontSize="Small" TextColor="Black"
                                                    HorizontalOptions="FillAndExpand" />
                                        <Image Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center"
                                       Rotation="90">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                         Glyph="{x:Static FontImage:IconFonts.Attachment}" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                </border:SfBorder>
                                <custom:CustomLabel Grid.Row="2"
                                            Text="{x:Static ResourceManager:AppResources.VatInstalment5MB}"
                                            HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource MicroGrayLabelStyle}" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NewAttachmentTapped}" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </StackLayout>

                        <Frame Grid.Row="3" Margin="0,10,0,0" Grid.ColumnSpan="2" CornerRadius="12" BorderColor="LightGray" Padding="15" HasShadow="False" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                            <StackLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Orientation="Vertical">

                                <StackLayout Orientation="Horizontal" >
                                    <Image Source="ic_vat_info" HeightRequest="20" WidthRequest="20"/>
                                    <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.Attachments}" Style="{StaticResource CaptionLabelBlack}" CharacterSpacing="0" VerticalOptions="CenterAndExpand"/>
                                </StackLayout>
                                <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}" Text="{x:Static 
                                        ResourceManager:AppResources.VFCAttachmnetsInfo}" HorizontalOptions="FillAndExpand" 
                                                        VerticalOptions="FillAndExpand"/>

                            </StackLayout>
                        </Frame>

                        <Frame Margin="-20,0,-20,0" Grid.Row="4" Grid.ColumnSpan="2" VerticalOptions="End" HasShadow="False" HorizontalOptions="FillAndExpand">

                            <buttons:SfButton Text="{x:Static ResourceManager:AppResources.ZZZZContinue}" BackgroundColor="{Binding AttachButtonBackGroundColor}" WidthRequest="366" HeightRequest="48"
                                   Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AttachmentsContinueBtnTapped}" HorizontalOptions="FillAndExpand" />

                        </Frame>

                    </StackLayout>

                    <!--Declaration screen-->

                    <Grid IsVisible="{Binding IsDeclarationViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
