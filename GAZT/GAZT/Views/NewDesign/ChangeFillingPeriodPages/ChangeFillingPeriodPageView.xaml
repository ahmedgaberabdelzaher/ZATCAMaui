                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VFCIDType}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                    </Grid>

                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Label Text="{Binding IDType}"
                                               HorizontalOptions="End"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VFCIDNumber}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Label HorizontalOptions="End" Text="{Binding IDNumber}"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </Grid>

                                    <Grid Grid.Row="2" IsVisible="{Binding IsDOBVisible}" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VFCDateofBirth}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                    </Grid>

                                    <Grid Grid.Row="2" IsVisible="{Binding IsDOBVisible}" Grid.Column="1">
                                        <Label Text="{Binding PickedDate,StringFormat='{0:dd MMM yyyy}'}"
                                               HorizontalOptions="End"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </Grid>

                                    <Grid Grid.Row="3" Grid.Column="0">
                                        <Label Text="{x:Static ResourceManager:AppResources.VFCContactPersonName}"
                                               HorizontalOptions="Start"
                                               Style="{StaticResource BodyLabelGrey}" />

                                    </Grid>

                                    <Grid Grid.Row="3" Grid.Column="1">
                                        <Label Text="{Binding ContactPersonName}"
                                               HorizontalOptions="End"
                                               Style="{StaticResource BodyLabelBlack}" />
                                    </Grid>

                                </Grid>
                            </StackLayout>
                        </border:SfBorder >

                        <StackLayout Grid.Row="6"  Grid.ColumnSpan="2">

                            <buttons:SfButton  Margin="0,16,0,16" Text="{x:Static ResourceManager:AppResources.ZakatInstalmetContinue}"
                                   Style="{StaticResource PrimaryButtonStyle}"  Command="{Binding SummaryContinueBtnTapped}" />

                        </StackLayout>

                    </Grid>

                </Grid>
               
                <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                 Opacity="0.4" VerticalOptions="FillAndExpand" />
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                 Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                           EnableAnimation="True"
                                                           AnimationType="SingleCircle"
                                                           HorizontalOptions="CenterAndExpand"
                                                           VerticalOptions="CenterAndExpand"
                                                           IsBusy="True"
                                                           ViewBoxWidth="70"
                                                           TitlePlacement="Bottom"
                                                           ViewBoxHeight="70"
                                                           TextColor="#D99A29" />
                            <!--Title="{x:Static custom2:AppResources.ActivityIndicatorTitle}"-->
                        </StackLayout>
                    </StackLayout>
                </Grid>
</Grid>

            </Grid>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>