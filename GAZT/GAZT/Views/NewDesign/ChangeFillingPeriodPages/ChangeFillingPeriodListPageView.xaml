<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.ChangeFillingPeriodPages.ChangeFillingPeriodListPageView"
             NavigationPage.HasNavigationBar="False" BackgroundImageSource="partials_background.png">

    <ContentPage.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />

                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0"
                              Padding="0,0,0,0">
                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                                              HorizontalOptions="FillAndExpand"
                                              Grid.Column="0"
                                              Grid.Row="0" BackgroundColor="White" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="24,10,24,10" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <Label Grid.Column="1" Grid.Row="0"   Text="{x:Static ResourceManager:AppResources.NDFillingFrequency}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center"/>

                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand"
                               Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackClick}"/>
                            </Image.GestureRecognizers>
                        </Image>

                        <Image  Grid.Row="0" Grid.Column="2"
                               VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand"
                               Source="close"
                               HeightRequest="24"
                               WidthRequest="24">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.CloseClick}"/>
                            </Image.GestureRecognizers>
                        </Image>

                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>

        <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid>

                <Grid IsVisible="{Binding IsMyRequestsViewEnabled}" Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodMyNewRequests}" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource PageTitleBlack}" Padding="0,10,0,0" />

                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                    </Grid>

                    <Grid Grid.Row="1"   BackgroundColor="Transparent" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">



                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>



                        <border:SfBorder Grid.Row="0" CornerRadius="14" Margin="0,20,0,0" Padding="8" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow} " >
                            <Grid>
                                <!--<Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>-->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="ic_add1.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" Margin="0" VerticalOptions="CenterAndExpand"></Image>
                                <Label Grid.Column="1" x:Name="Filinglbl" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodButtonText}" Style="{StaticResource GAZTSmallGreenLabelStyle}" FontSize="15"  VerticalOptions="CenterAndExpand"/>
                              

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding MyRequestsButtonTapped}"></TapGestureRecognizer>
                                </Grid.GestureRecognizers>

                            </Grid>

                           
                        </border:SfBorder>
                    </Grid>

                    <Grid Grid.Row="2" VerticalOptions="Start">

                        <listView:SfListView HorizontalOptions="Center" IsScrollBarVisible="False" IsScrollingEnabled="False"  VerticalOptions="FillAndExpand" AutoFitMode="DynamicHeight"
                                      ItemsSource="{Binding MyRequestsListViewData}" ItemTapped="Request_Item_Tapped" SelectionMode="SingleDeselect" SelectionBackgroundColor="Transparent">
                            <listView:SfListView.ItemTemplate>
                                <DataTemplate>
                                    <border:SfBorder Padding="10"  Grid.Column="0" CornerRadius="15" Margin="0,15,0,0" HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}" VerticalOptions="FillAndExpand">
                                        <Grid VerticalOptions="FillAndExpand">

                                            <Grid.RowDefinitions >
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50*"/>
                                                <ColumnDefinition Width="50*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Row="0" Margin="0,0,0,5" Grid.ColumnSpan="2" Orientation="Vertical" HorizontalOptions="StartAndExpand" VerticalOptions="FillAndExpand">
                                                <custom:CustomLabel Text="{Binding FbtText}" Style="{StaticResource SectionTitleBlackBold}"  HorizontalOptions="StartAndExpand" Margin="0" Padding="0"  VerticalOptions="FillAndExpand"/>
                                            </StackLayout>
                                            <StackLayout Grid.Row="1" Grid.Column="0" Orientation="Vertical"  VerticalOptions="FillAndExpand">

                                                <Label  Text="{Binding Fbnum}" Style="{StaticResource ValueLabelGrey}"  HorizontalTextAlignment="Start"
                                                       HorizontalOptions="StartAndExpand" VerticalOptions="CenterAndExpand"/>

                                            </StackLayout>
                                            <yummy:PancakeView Padding="8,3,8,3" Grid.Row="1" Grid.Column="1" CornerRadius="14"
                                                                   BackgroundColor="{StaticResource PartialBg}"
                                                                   VerticalOptions="CenterAndExpand"
                                                                   HorizontalOptions="EndAndExpand" >

                                                <yummy:PancakeView.Border>
                                                    <yummy:Border  Thickness="1"/>
                                                </yummy:PancakeView.Border>
                                                <Label  Style="{StaticResource CaptionLabelBlack}"
                                                           TextColor="{StaticResource Partial}" Text="{Binding FbustTxt}"
                                                           HorizontalTextAlignment="Center"
                                                           HorizontalOptions="CenterAndExpand"
                                                           VerticalOptions="CenterAndExpand">
                                                    <Label.Triggers>

                                                        <DataTrigger TargetType="Label" Binding="{Binding
                                                                 FbustTxt}" Value="{x:Static
                                                                 ResourceManager:AppResources.NDBilled}">

                                                            <Setter Property="Text" Value="{x:Static
                                                                     ResourceManager:AppResources.NDBilled}" />

                                                            <Setter Property="TextColor"
                                                                         Value="{StaticResource Primary}" />

                                                            <Setter Property="HorizontalTextAlignment"
                                                                         Value="Center"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </yummy:PancakeView>

                                        </Grid>
                                    </border:SfBorder>

                                </DataTemplate>
                            </listView:SfListView.ItemTemplate>
                        </listView:SfListView>

                    </Grid>


                </Grid>

                <Grid IsVisible="{Binding IsSummaryViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.VatDeregSummaryTitle}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static ResourceManager:AppResources.ZakatInstallmentPlanSummaryReview}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>

                        <border:SfBorder Margin="0,16,0,10" Grid.Row="3" Grid.ColumnSpan="2"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                    </Frame>-->
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Padding="8,0" Orientation="Horizontal">
                                       <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Start" VerticalOptions="Center"  Aspect="AspectFit" Source="ic_reviewDetails"/>
                                        <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodFrequencyDetails}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15" Spacing="8">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodCurrentFrequency}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding CurrentFrequency}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodNewFrequency}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding NewFrequency}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VFCEffectiveDate}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding EffectiveDatePicked}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                        </border:SfBorder >

                        <!-- Attachments Section -->


                        <border:SfBorder  Margin="0,16,0,10" Grid.Row="4" Grid.ColumnSpan="2"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">

                            <StackLayout Padding="0">

                                <Grid Padding="15" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                      
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                    </Frame>-->
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Padding="8,0" Orientation="Horizontal">
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Start" VerticalOptions="Center"  Aspect="AspectFit" Source="ic_attachment"/>

                                        <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachments}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                                <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                IsScrollBarVisible="False" IsScrollingEnabled="False"
                                VerticalOptions="Center"
                                ItemsSource="{Binding YearsattachmentsListViewData}"
                                SelectionMode="None"
                                SelectionBackgroundColor="Transparent">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel Grid.Column="0"
                                                               Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsTwoYears}"
                                                               Style="{StaticResource ValueLabelGrey}" />
                                                <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                               Style="{StaticResource ValueLabelBlack}"
                                                               HorizontalOptions="EndAndExpand"
                                                               HorizontalTextAlignment="End" />
                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>

                                <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                    IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                    VerticalOptions="Center"
                                                    ItemsSource="{Binding MonthsattachmentsListViewData}"
                                                    SelectionMode="None"
                                                    SelectionBackgroundColor="Transparent">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel Grid.Column="0"
                                                                   Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsTwelveMonths}"
                                                                   Style="{StaticResource ValueLabelGrey}" />
                                                <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                   Style="{StaticResource ValueLabelBlack}"
                                                                   HorizontalOptions="EndAndExpand"
                                                                   HorizontalTextAlignment="End" />
                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>

                                <listView:SfListView Grid.Row="0" HorizontalOptions="Center"
                                                    IsScrollBarVisible="False" IsScrollingEnabled="False"
                                                    VerticalOptions="Center"
                                                    ItemsSource="{Binding OtherAttachmentsListViewData}"
                                                    SelectionMode="None"
                                                    SelectionBackgroundColor="Transparent">
                                    <listView:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <custom:CustomLabel Grid.Column="0"
                                                                   Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodAttachmentsOtherDocuments}"
                                                                   Style="{StaticResource ValueLabelGrey}" />
                                                <custom:CustomLabel Grid.Column="1" Text="{Binding Filename}"
                                                                   Style="{StaticResource ValueLabelBlack}"
                                                                   HorizontalOptions="EndAndExpand"
                                                                   HorizontalTextAlignment="End" />
                                            </Grid>
                                        </DataTemplate>
                                    </listView:SfListView.ItemTemplate>
                                </listView:SfListView>

                            </StackLayout>
                        </border:SfBorder >

                        <!-- Installment Agreement Section-->

                        <border:SfBorder Margin="0,16,0,10" Grid.Row="5" Grid.ColumnSpan="2"  HasShadow="False" Style="{StaticResource GreyBorderFrameWithShadow}">
                            <StackLayout Padding="0">
                                <Grid Padding="15" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                       
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!--<Frame Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start" VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True" BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                HasShadow="False">
                                    </Frame>-->
                                    <StackLayout HorizontalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0" Padding="8,0" Orientation="Horizontal">
                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Start" VerticalOptions="Center"  Aspect="AspectFit" Source="declaration"/>

                                        <Label Text="{x:Static ResourceManager:AppResources.ChangeFillingPeriodDeclaration}" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}" Padding="8,0"/>
                                    </StackLayout>

                                </Grid>

                                <BoxView Style="{StaticResource NeutralGrayOpacity90BoxView}" />

                                <StackLayout Padding="15" Spacing="8">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VFCIDType}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding IDType}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VFCIDNumber}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding IDNumber}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>

                                    <Grid IsVisible="{Binding IsDobVisible}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.VFCDateofBirth}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding PickedDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <custom:CustomLabel Grid.Column="0" Text="{x:Static ResourceManager:AppResources.CRContactPersonName}" Style="{StaticResource ValueLabelGrey}"/>
                                        <custom:CustomLabel Grid.Column="1" Text="{Binding ContactPersonName}" Style="{StaticResource ValueLabelBlack}" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                                    </Grid>
                                </StackLayout>
                            </StackLayout>

                        </border:SfBorder >

                        <StackLayout Padding="0" Grid.Row ="6" Grid.ColumnSpan="2">

                            <buttons:SfButton
                                          Text="{x:Static ResourceManager:AppResources.CRDownloadConfirmation}"
                                          Clicked="Download_Acknowledgement"
                                          WidthRequest="366" HeightRequest="48"
                                          CornerRadius="10" VerticalOptions="End" 
                                          Margin="10,20,10,20"  Grid.ColumnSpan="2"
                                          Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackLayout>
                    </Grid>

                </Grid>

                <Grid IsVisible="{Binding IsLoading}" BackgroundColor="Transparent">
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black"
                                 Opacity="0.4" VerticalOptions="FillAndExpand" />
                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent"
                                 Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding"
                                                           EnableAnimation="True"
                                                           AnimationType="SingleCircle"
                                                           HorizontalOptions="CenterAndExpand"
                                                           VerticalOptions="CenterAndExpand"
                                                           IsBusy="True"
                                                           ViewBoxWidth="70"
                                                           TitlePlacement="Bottom"
                                                           ViewBoxHeight="70"
                                                           TextColor="{StaticResource Secondary}" />
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
