<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.VAT.TaxCalculator"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:controls="clr-namespace:EGAZT.Controls"
    xmlns:converter="clr-namespace:EGAZT.Converters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:customcontrol="clr-namespace:GAZT.CustomControl"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:syncfusion="http://schemas.syncfusion.com/xamarin"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    FlowDirection="{Binding AppDirection}"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                    <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                        <Setter Property="WidthRequest" Value="30" />
                    </Style>
           
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">
            <yummy:PancakeView
                Grid.Row="1"
                Padding="20,5,20,0"
                Style="{StaticResource CommonTopCurves}">

                <ScrollView VerticalScrollBarVisibility="Never">
                    <StackLayout>
                        <StackLayout Margin="24,10,24,0">
                            <Label
                                Margin="0,23,0,5"
                                FontSize="20" FontFamily="{StaticResource FontSomarBold}"
                                Text="{x:Static ResourceManager:AppResources.VATCalculator}"
                                TextColor="#58595B" />
                            <Label
                                FontSize="14"
                                Text="{x:Static ResourceManager:AppResources.VATCalculatorDesc}"
                                TextColor="#868894" />
                        </StackLayout>
                        <Grid ColumnDefinitions="*,5,*">
                            <Grid Grid.Column="0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ConsumerCalcSelectedCommand}" />

                                </Grid.GestureRecognizers>
                                <Image
                                    HeightRequest="136"
                                    HorizontalOptions="FillAndExpand"
                                    Source="Unselected.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CalcBy}"
                                            TargetType="Image"
                                            Value="1">
                                            <Setter Property="Source" Value="UnselectedCard" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Image
                                    Margin="17,25,17,10"
                                    HeightRequest="33"
                                    HorizontalOptions="Start"
                                    Source="UnselectedConsumer.png"
                                    VerticalOptions="Start"
                                    WidthRequest="30">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CalcBy}"
                                            TargetType="Image"
                                            Value="1">
                                            <Setter Property="Source" Value="SelectedConsumer" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Label
                                    Margin="25,10,25,15"
                                    FontSize="16"
                                    Text="{x:Static ResourceManager:AppResources.ConsumerCalculator}"
                                    TextColor="#FFFFFF"
                                    VerticalOptions="EndAndExpand">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CalcBy}"
                                            TargetType="Label"
                                            Value="1">
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding MerchantCalcSelectedCommand}" />

                                </Grid.GestureRecognizers>
                                <Image Source="UnselectedCard.png">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CalcBy}"
                                            TargetType="Image"
                                            Value="1">
                                            <Setter Property="Source" Value="Unselected" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Image
                                    Margin="17,25,17,10"
                                    HeightRequest="33"
                                    HorizontalOptions="Start"
                                    Source="UnSelectedMerchant.png"
                                    VerticalOptions="Start"
                                    WidthRequest="30">
                                    <Image.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CalcBy}"
                                            TargetType="Image"
                                            Value="0">
                                            <Setter Property="Source" Value="SelectedMerchant" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Label
                                    Margin="25,10,25,15"
                                    FontSize="16"
                                    Text="{x:Static ResourceManager:AppResources.MerchantCalculator}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="EndAndExpand">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CalcBy}"
                                            TargetType="Label"
                                            Value="1">
                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Grid>
                        <!--  Consumer View  -->
                        <controls:EntryWithSAR
                            x:Name="ConsumerTotaltaxablepurchases"
                            IsVisible="{Binding IsConsumerCalc}"
                            Placeholder="{x:Static ResourceManager:AppResources.Totaltaxablepurchases}"
                            Text="{Binding Totaltaxablepurchases}"
                            TitleText="{x:Static ResourceManager:AppResources.Totaltaxablepurchases}"
                            ValueText="{Binding Totaltaxablepurchases, Mode=TwoWay}" >
                        </controls:EntryWithSAR>
                        <!--  MerchantView  -->
                        <StackLayout IsVisible="{Binding IsMerchantCalc}">
                            <controls:EntryWithSAR
                                Placeholder="{x:Static ResourceManager:AppResources.Totaltaxablesales}"
                                TitleText="{x:Static ResourceManager:AppResources.Totaltaxablesales}"
                                ValueText="{Binding Totaltaxablesales}" />
                            <controls:EntryWithSAR
                                Placeholder="{x:Static ResourceManager:AppResources.Totalnontaxablesales}"
                                TitleText="{x:Static ResourceManager:AppResources.Totalnontaxablesales}"
                                ValueText="{Binding Totalnontaxablesales}" />
                            <controls:EntryWithSAR
                                Placeholder="{x:Static ResourceManager:AppResources.Totaltaxablepurchases}"
                                TitleText="{x:Static ResourceManager:AppResources.Totaltaxablepurchases}"
                                ValueText="{Binding Totaltaxablepurchases}" />
                            <controls:EntryWithSAR
                                Placeholder="{x:Static ResourceManager:AppResources.Totalnontaxablepurchases}"
                                TitleText="{x:Static ResourceManager:AppResources.Totalnontaxablepurchases}"
                                ValueText="{Binding Totalnontaxablepurchases}" />
                        </StackLayout>
                        <Frame
                            Margin="0,27,0,40"
                            Padding="12"
                            BackgroundColor="#0996D4"
                            CornerRadius="14"
                            HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CalculateTaxCommand}" />
                            </Frame.GestureRecognizers>
                            <Label
                                FontSize="16"
                                HorizontalOptions="CenterAndExpand"
                                Text="{x:Static ResourceManager:AppResources.CalculateTheAmount}"
                                TextColor="White" />
                        </Frame>
                    </StackLayout>
                </ScrollView>
            </yummy:PancakeView>
            <Grid Grid.Row="0" Padding="20,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0">
                    <Image
                        HorizontalOptions="Start"
                        Rotation="180"
                        Source="arrowLeftwhite.png"
                        Style="{DynamicResource BackButtonArrow}"
                        VerticalOptions="CenterAndExpand">

                        <Image.Triggers>
                            <DataTrigger
                                Binding="{Binding AppDirection}"
                                TargetType="Image"
                                Value="LeftToRight">
                                <Setter Property="Rotation" Value="0" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <custom:CustomLabel
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SectionTitleWhiteBold}"
                    Text="{x:Static ResourceManager:AppResources.TaxCalculator}"
                    VerticalOptions="Center" />
            </Grid>
            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Margin="0,0,0,0"
                IsVisible="{Binding IsShowMsgView}"
                VerticalOptions="FillAndExpand">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}" />
                </Grid.GestureRecognizers>
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <yummy:PancakeView
                    Padding="20,20,20,10"
                    BackgroundColor="White"
                    CornerRadius="15,15,0,0"
                    Style="{StaticResource CommonTopCurves}"
                    VerticalOptions="EndAndExpand">

                    <StackLayout Margin="0,0,0,0" VerticalOptions="Center">
                        <!--                            Text="{x:Static ResourceManager:AppResources.TotalPriceValue}"-->
                        <Label
                            Margin="10,30,56,0"
                            HorizontalTextAlignment="Start" Text="{Binding MessageTxt}"
                            Style="{StaticResource BodyLabelBlack}"
                            >
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding AppDirection}"
                                    TargetType="Label"
                                    Value="LeftToRight">
                                    <Setter Property="Margin" Value="56,30,10,10" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label
                            Margin="10,7,57,10"
                            HorizontalTextAlignment="Start"
                            Style="{StaticResource BodyLabelBlack}"
                            TextColor="#58595B">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding AppDirection}"
                                    TargetType="Label"
                                    Value="LeftToRight">
                                    <Setter Property="Margin" Value="57,7,10,10" />
                                </DataTrigger>
                            </Label.Triggers>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontSize="31" Text="{Binding TaxValue}" />
                                    <Span FontSize="12" Text="{x:Static ResourceManager:AppResources.FORM5SAR}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label IsVisible="{Binding IsConsumerCalc}"
                            Margin="10,10,56,10"
                            FontSize="12"
                            HorizontalTextAlignment="Start"
                            Text="{x:Static ResourceManager:AppResources.ThetotalamountplusVAT}"
                            TextColor="#868894">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding AppDirection}"
                                    TargetType="Label"
                                    Value="LeftToRight">
                                    <Setter Property="Margin" Value="56,10,10,10" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <buttons:SfButton
                            Margin="0,0,0,10"
                            Command="{Binding CloseMsgViewCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{x:Static ResourceManager:AppResources.ZZZZDone}"
                            VerticalOptions="CenterAndExpand" />

                    </StackLayout>
                </yummy:PancakeView>
            </Grid>
            <controls:MsgView  Grid.Row="0"
                Grid.RowSpan="2" IsVisible="{Binding IsValidationError}"></controls:MsgView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
