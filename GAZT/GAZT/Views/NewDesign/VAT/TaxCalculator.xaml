<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          FlowDirection="{Binding AppDirection}"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
           xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core" xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms" xmlns:syncfusion="http://schemas.syncfusion.com/xamarin" xmlns:control="clr-namespace:GAZTeServicesApp.Controls" xmlns:customcontrol="clr-namespace:GAZT.CustomControl" xmlns:custom="clr-namespace:GAZT" xmlns:converter="clr-namespace:EGAZT.Converters"
             ios:Page.UseSafeArea="true"
             BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False"
     xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    xmlns:controls="clr-namespace:EGAZT.Controls" xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    x:Class="EGAZT.Views.NewDesign.VAT.TaxCalculator">
      <ContentPage.Resources>
        <ResourceDictionary>
           <converter:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <converter:SelectedItemEventArgsToSelectedItemConverter x:Key="SelectedItemConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                     <Style x:Key="ArrowImage" TargetType="Image">
                        <Setter Property="HeightRequest" Value="30" />
                          <Setter Property="WidthRequest" Value="30" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>          
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid RowDefinitions="auto,*">
                                <yummy:PancakeView Grid.Row="1" Style="{StaticResource CommonTopCurves}" Padding="20,5,20,0" >

            <ScrollView VerticalScrollBarVisibility="Never">
                <StackLayout>
                             <StackLayout Margin="24,10,24,0">
            <Label  Text="{x:Static ResourceManager:AppResources.VATCalculator}" TextColor="#58595B" FontSize="26"  Margin="0,34,0,5"></Label>
            <Label   Text="{x:Static ResourceManager:AppResources.VATCalculatorDesc}" FontSize="14"  TextColor="#868894"></Label>
         </StackLayout>
                               <Grid ColumnDefinitions="*,5,*">
                                   <Grid Grid.Column="0">
                                       <Grid.GestureRecognizers>
                                           <TapGestureRecognizer Command="{Binding ConsumerCalcSelectedCommand}"></TapGestureRecognizer>

                                       </Grid.GestureRecognizers>
                                       <Image Source="Unselected.png" HeightRequest="136" HorizontalOptions="FillAndExpand">
                                           <Image.Triggers>
                                               <DataTrigger TargetType="Image" Binding="{Binding CalcBy}" Value="1">
                                                   <Setter Property="Source" Value="UnselectedCard"></Setter>
                                               </DataTrigger>
                                           </Image.Triggers>
                                       </Image>
                                        <Image Source="UnselectedConsumer.png" Margin="17,25,17,10" VerticalOptions="Start" HorizontalOptions="Start" HeightRequest="33" WidthRequest="30">
                                           <Image.Triggers>
                                               <DataTrigger TargetType="Image" Binding="{Binding CalcBy}" Value="0">
                                                   <Setter Property="Source" Value="SelectedConsumer"></Setter>
                                               </DataTrigger>
                                           </Image.Triggers>
                                       </Image>
                                       <Label Text="{x:Static ResourceManager:AppResources.ConsumerCalculator}" FontSize="16" TextColor="#FFFFFF" Margin="25,10,25,15" VerticalOptions="EndAndExpand">
                                             <Label.Triggers>
                                               <DataTrigger TargetType="Label" Binding="{Binding CalcBy}" Value="1">
                                                   <Setter Property="TextColor" Value="{StaticResource Primary}"></Setter>
                                               </DataTrigger>
                                           </Label.Triggers>
                                       </Label>
                                   </Grid>
                                    <Grid Grid.Column="2">
                                                                       <Grid.GestureRecognizers>
                                           <TapGestureRecognizer Command="{Binding MerchantCalcSelectedCommand}"></TapGestureRecognizer>

                                       </Grid.GestureRecognizers>
                                       <Image Source="UnselectedCard.png">
                                             <Image.Triggers>
                                               <DataTrigger TargetType="Image" Binding="{Binding CalcBy}" Value="1">
                                                   <Setter Property="Source" Value="Unselected"></Setter>
                                               </DataTrigger>
                                           </Image.Triggers>
                                       </Image>
                                          <Image Source="UnSelectedMerchant.png" Margin="17,25,17,10" VerticalOptions="Start" HorizontalOptions="Start" HeightRequest="33" WidthRequest="30">
                                           <Image.Triggers>
                                               <DataTrigger TargetType="Image" Binding="{Binding CalcBy}" Value="1">
                                                   <Setter Property="Source" Value="SelectedMerchant"></Setter>
                                               </DataTrigger>
                                           </Image.Triggers>
                                       </Image>
                                       <Label Text="{x:Static ResourceManager:AppResources.MerchantCalculator}" TextColor="{StaticResource Primary}" FontSize="16" Margin="25,10,25,15" VerticalOptions="EndAndExpand">
                                             <Label.Triggers>
                                               <DataTrigger TargetType="Label" Binding="{Binding CalcBy}" Value="1">
                                                   <Setter Property="TextColor" Value="#FFFFFF"></Setter>
                                               </DataTrigger>
                                           </Label.Triggers>
                                       </Label>
                                   </Grid>
                               </Grid>
                    <!--Consumer View-->
                    <controls:EntryWithSAR x:Name="ConsumerTotaltaxablepurchases" IsVisible="{Binding IsConsumerCalc}" TitleText="{x:Static ResourceManager:AppResources.Totaltaxablepurchases}"  ValueText="{Binding Totaltaxablepurchases,Mode=TwoWay}" Text="{Binding Totaltaxablepurchases}" Placeholder="{x:Static ResourceManager:AppResources.AcceptButton}"></controls:EntryWithSAR>
                    <!--MerchantView-->
                    <StackLayout IsVisible="{Binding IsMerchantCalc}">
                    <controls:EntryWithSAR TitleText="{x:Static ResourceManager:AppResources.Totaltaxablesales}" ValueText="{Binding Totaltaxablesales}" Placeholder="{x:Static ResourceManager:AppResources.Totaltaxablesales}"></controls:EntryWithSAR>
                    <controls:EntryWithSAR TitleText="{x:Static ResourceManager:AppResources.Totalnontaxablesales}" ValueText="{Binding Totalnontaxablesales}" Placeholder="{x:Static ResourceManager:AppResources.Totalnontaxablesales}"></controls:EntryWithSAR>
                    <controls:EntryWithSAR TitleText="{x:Static ResourceManager:AppResources.Totaltaxablepurchases}" ValueText="{Binding Totaltaxablepurchases}" Placeholder="{x:Static ResourceManager:AppResources.Totaltaxablepurchases}"></controls:EntryWithSAR>
                    <controls:EntryWithSAR TitleText="{x:Static ResourceManager:AppResources.Totalnontaxablepurchases}" ValueText="{Binding Totalnontaxablepurchases}" Placeholder="{x:Static ResourceManager:AppResources.Totalnontaxablepurchases}"></controls:EntryWithSAR>
                    </StackLayout>
                     <Frame BackgroundColor="#00BBBD"  CornerRadius="14" Padding="12" Margin="0,27,0,40" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CalculateTaxCommand}"></TapGestureRecognizer>
                                </Frame.GestureRecognizers>
<Label Text="{x:Static ResourceManager:AppResources.CalculateTheAmount}" HorizontalOptions="CenterAndExpand" TextColor="White" FontSize="16"></Label>
                            </Frame>
                </StackLayout>
            </ScrollView>
                                    </yummy:PancakeView>
                        <Grid Grid.Row="0" Padding="20,5,20,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="80*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0">
                    <Image Source="arrowLeftwhite.png" Rotation="180" VerticalOptions="CenterAndExpand" HorizontalOptions="Start" Style="{DynamicResource BackButtonArrow}"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
              <custom:CustomLabel Grid.Column="1" Text="{x:Static ResourceManager:AppResources.TahqaqService}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>
                                 <Grid IsVisible="{Binding IsShowMsgView}" Grid.Row="0" Grid.RowSpan="2" VerticalOptions="FillAndExpand" Margin="0,0,0,0">
                            <Grid.GestureRecognizers >
                                <TapGestureRecognizer Command="{Binding CloseMsgViewCommand}"></TapGestureRecognizer>
                            </Grid.GestureRecognizers>
                            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <yummy:PancakeView  Style="{StaticResource CommonTopCurves}" CornerRadius="15,15,0,0" VerticalOptions="EndAndExpand" Padding="20,20,20,10" BackgroundColor="White">

        <StackLayout VerticalOptions="Center" Margin="0,0,0,0">
         
                       <Label Text="{x:Static ResourceManager:AppResources.TotalPriceValue}" Margin="10,30,56,0"  HorizontalTextAlignment="Start" Style="{StaticResource BodyLabelBlack}">
                             <Label.Triggers>
                     <DataTrigger TargetType="Label" Binding="{Binding AppDirection}" Value="LeftToRight">
                         <Setter Property="Margin" Value="56,30,10,10"></Setter>
                     </DataTrigger>
                 </Label.Triggers>
                       </Label>
            <Label Margin="10,7,57,10" TextColor="#58595B" HorizontalTextAlignment="Start" Style="{StaticResource BodyLabelBlack}">
                      <Label.Triggers>
                     <DataTrigger TargetType="Label" Binding="{Binding AppDirection}" Value="LeftToRight">
                         <Setter Property="Margin" Value="57,7,10,10"></Setter>
                     </DataTrigger>
                 </Label.Triggers>
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding MessageTxt}"  FontSize="31"></Span>
                       <Span Text="{x:Static ResourceManager:AppResources.FORM5SAR}"  FontSize="12" ></Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
             <Label Margin="10,10,56,10" Text="{x:Static ResourceManager:AppResources.ThetotalamountplusVAT}"  HorizontalTextAlignment="Start" TextColor="#868894" FontSize="12">
                 <Label.Triggers>
                     <DataTrigger TargetType="Label" Binding="{Binding AppDirection}" Value="LeftToRight">
                         <Setter Property="Margin" Value="56,10,10,10"></Setter>
                     </DataTrigger>
                 </Label.Triggers>
             </Label>
            <buttons:SfButton  Command="{Binding CloseMsgViewCommand}"  VerticalOptions="CenterAndExpand"  Text="{x:Static ResourceManager:AppResources.ZZZZDone}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10" />

        </StackLayout>
    </yummy:PancakeView>
</Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
