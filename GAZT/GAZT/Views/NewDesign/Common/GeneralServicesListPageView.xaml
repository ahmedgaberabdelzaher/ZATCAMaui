<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.Common.GeneralServicesListPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Name="ZakatReg"
    ios:Page.UseSafeArea="true"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid>

                <Grid VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="15,5,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.GeneralServices}" />

                        <Image
                            x:Name="Image_BacKIcon"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{Binding IsBackStepButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        CornerRadius="14,14,0,0"
                        VerticalOptions="FillAndExpand">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>

    <ContentPage.Content>
        <listView:SfListView
            x:Name="outletDecisionOptionsListView"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            AutoFitMode="Height"
            HorizontalOptions="FillAndExpand"
            IsScrollBarVisible="False"
            IsScrollingEnabled="False"
            ItemSpacing="5"
            ItemsSource="{Binding GeneralServicesList}"
            SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
            SelectionBackgroundColor="Transparent"
            SelectionChanged="GeneralServices_SelectionChanged"
            SelectionMode="Single"
            VerticalOptions="FillAndExpand">
            <listView:SfListView.ItemTemplate>
                <DataTemplate>
                    <border:SfBorder Margin="16,10,16,0" Style="{StaticResource GreyBorderFrameWithShadow}">
                        <Grid Padding="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="10,0,10,0"
                                HeightRequest="20"
                                HorizontalOptions="Start"
                                Source="{Binding ZDImageSource}"
                                VerticalOptions="Center"
                                WidthRequest="20" />
                            <StackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                                <Label
                                    FontFamily="{StaticResource SomarBold}"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="{Binding ZDTitle}"
                                    VerticalOptions="Center" />
                            </StackLayout>
                            <Image
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="5,10,5,0"
                                HorizontalOptions="Start"
                                Source="{Binding ArrowImageSource}"
                                VerticalOptions="Center">

                                <!--<Image.Triggers>
                                                 <DataTrigger TargetType="Image" Binding="{Binding IsArabic}" Value="false">
                                                    <Setter Property="Rotation" Value="180" />
                                                </DataTrigger>
                                                 <DataTrigger TargetType="Image" Binding="{Binding IsArabic}" Value="true">
                                                    <Setter Property="Rotation" Value="0" />
                                                </DataTrigger>
                                            </Image.Triggers>-->
                            </Image>
                        </Grid>
                    </border:SfBorder>
                </DataTemplate>
            </listView:SfListView.ItemTemplate>
        </listView:SfListView>

    </ContentPage.Content>
</ContentPage>