<?xml version="1.0" encoding="utf-8"?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:d="http://xamarin.com/schemas/2014/forms/design"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 FlowDirection="RightToLeft"  
                 xmlns:FontImage="clr-namespace:MVP.FontIcons"
                 xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                 xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
                 xmlns:custom="clr-namespace:GAZT"
                 xmlns:custom1="clr-namespace:GAZT.CustomControl"
                 xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
                 xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup" 
                 CloseWhenBackgroundIsClicked="False"
                 x:Class="EGAZT.Views.NewDesign.InstructionsBottomPopUpView">

    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </pages:PopupPage.Resources>

    <Grid>

        <yummy:PancakeView IsVisible="{Binding IsInstructions}" CornerRadius="15,15,0,0" HasShadow="True" VerticalOptions="EndAndExpand" BackgroundColor="White" Padding="15,0,15,0">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,32,0,0" HorizontalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

 

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

 

                    <Image Grid.Row="0" VerticalOptions="Center" Margin="0,5,5,0" Grid.Column="0" HorizontalOptions="End">
                        <Image.Source>
                            <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                 Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                        </Image.Source>
                    </Image>
                    <custom:CustomLabel Grid.Row="0" VerticalOptions="Center" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructionsTitle}" HorizontalOptions="Center" Style="{StaticResource ValueLabelBlackBold}" FontSize="16"/>
                </Grid>
               

 

                <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                    <StackLayout Orientation="Vertical" Margin="0,32,0,0" Padding="5,0,5,0">

 

                        <border:SfBorder Grid.Row="0" BorderColor="#B1B1B1" BorderWidth="1"
                             Style="{StaticResource GreyBorderFrame}">

 

                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

 

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

 

                                <Image Grid.Row="0" Grid.Column="0" IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                 Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel IsVisible="false" Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.Information}"
                                            Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlackBold}" />
                                <custom:CustomLabel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}" LineSpacing="1.5" />
                            </Grid>
                        </border:SfBorder>

 

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--<CheckBox Grid.Column="0" Color="{StaticResource NewDarkGreenColor}" VerticalOptions="CenterAndExpand" CheckedChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsInstuctionsChecked}" IsEnabled="{Binding IsCheckboxEditable}">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox" Value="false">
                                        <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                            <custom:CustomLabel Grid.Column="1" Text="{Binding CheckBoxDescription}" Style="{StaticResource GAZTMicroMediumGrayLabel}" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalTextAlignment="Center"/>-->


                              <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" >
                                                    <custom1:CheckboxCustom  
                                                                       Style="{StaticResource CheckboxHeightWidth32}"
                                                                         VerticalOptions="CenterAndExpand" CheckChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsInstuctionsChecked}" IsEnabled="{Binding IsCheckboxEditable}"/>
                                                    <custom:CustomLabel   >
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span   Text="{Binding CheckBoxDescription}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                        <custom:CustomLabel.Triggers>
                                                                     <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsInstuctionsChecked}" Value="True">
                                                                         <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                                                     </DataTrigger>
                                                             <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsInstuctionsChecked}" Value="False">
                                                                         <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                                                     </DataTrigger>
                                                       </custom:CustomLabel.Triggers>
                                                    </custom:CustomLabel>
                                </StackLayout>
                        </Grid>

 

                        <buttons:SfButton  Text="{Binding ButtonTitle}" Margin="0,24,0,24"  BackgroundColor="{Binding ContinueBackGroundColor}"
                                                   IsEnabled="{Binding IsContinueEnabled}"
                                           Command="{Binding InstructionsContinueClick}"
                              Style="{StaticResource PrimaryButtonStyle}" VerticalOptions="End"
                                           />
                    </StackLayout>
                </ScrollView>

 


            </Grid>
        </yummy:PancakeView>
        <yummy:PancakeView IsVisible="{Binding IsTerms}" CornerRadius="15,15,0,0" HasShadow="True" VerticalOptions="EndAndExpand" BackgroundColor="White" Padding="15,0,15,0">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <custom:CustomLabel Margin="0,32,0,0" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.BPTermsAndConditions}" HorizontalOptions="Center" Style="{StaticResource ValueLabelBlackBold}" FontSize="16"/>
                <ScrollView Grid.Row="1">
                    <StackLayout Orientation="Vertical" Margin="0,32,0,0" Padding="5,0,5,0">


                        <border:SfBorder Grid.Row="0" BorderColor="#B1B1B1" BorderWidth="1" 
                             Style="{StaticResource GreyBorderFrame}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Row="0" Grid.Column="0 " IsVisible="False">
                                    <Image.Source>
                                        <FontImageSource FontFamily="UserIconFont" Color="DarkGray" Size="24"
                                                 Glyph="{x:Static FontImage:IconFonts.InformationOutline}" />
                                    </Image.Source>

                                </Image>
                                <custom:CustomLabel IsVisible="False" Grid.Row="0" Grid.Column="1" Text="{x:Static ResourceManager:AppResources.Information}"
                                            Margin="10,0,0,0" HorizontalOptions="StartAndExpand"
                                            Style="{StaticResource ValueLabelBlackBold}" FontSize="16"/>

                                <custom:CustomLabel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}"
                                        HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}" LineSpacing="1.5" />

                            </Grid>
                        </border:SfBorder>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--<CheckBox Grid.Column="0" Color="{StaticResource NewDarkGreenColor}" VerticalOptions="CenterAndExpand" CheckedChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsTermsChecked}" IsEnabled="{Binding IsCheckboxEditable}">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox" Value="false">
                                        <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                            <custom:CustomLabel Grid.Column="1" Text="{Binding CheckBoxDescription}" Style="{StaticResource GAZTMicroMediumGrayLabel}" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start"/>-->





                                <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" >
                                                    <custom1:CheckboxCustom  
                                                                       Style="{StaticResource CheckboxHeightWidth32}"
                                                                         VerticalOptions="CenterAndExpand" CheckChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsTermsChecked}" IsEnabled="{Binding IsCheckboxEditable}"/>
                                                    <custom:CustomLabel   >
                                                        <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span   Text="{Binding CheckBoxDescription}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>
                                                        <custom:CustomLabel.Triggers>
                                                                     <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsTermsChecked}" Value="True">
                                                                         <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                                                     </DataTrigger>
                                                             <DataTrigger TargetType="custom:CustomLabel" Binding="{Binding IsTermsChecked}" Value="False">
                                                                         <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                                                     </DataTrigger>
                                                       </custom:CustomLabel.Triggers>
                                                    </custom:CustomLabel>
                                </StackLayout>
                        </Grid>



                        <buttons:SfButton Text="{Binding ButtonTitle}" BackgroundColor="{Binding ContinueBackGroundColor}"
                                                   IsEnabled="{Binding IsContinueEnabled}" Margin="0,24,0,24" Command="{Binding TermsContinueClick}" VerticalOptions="End"
                              Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackLayout>

                </ScrollView>

            </Grid>
        </yummy:PancakeView>

    </Grid>

</pages:PopupPage>