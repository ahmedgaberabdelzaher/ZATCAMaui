<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.InstructionsBottomPopUpView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    CloseWhenBackgroundIsClicked="False"
    FlowDirection="RightToLeft"
    mc:Ignorable="d">

    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </pages:PopupPage.Resources>

    <Grid>


        <yummy:PancakeView
            Padding="15,0,15,0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            IsVisible="{Binding IsCancelButtonVisible}"
            VerticalOptions="EndAndExpand">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>



                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        HorizontalOptions="End"
                        Source="ic_close"
                        VerticalOptions="End">

                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Close_Tapped}" />
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>

                <Grid Margin="0,32,0,0" HorizontalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>



                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>



                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <custom:CustomLabel
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="15"
                        HorizontalOptions="Center"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructionsTitle}"
                        VerticalOptions="Center" />
                </Grid>




                <ScrollView
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        Orientation="Vertical">



                        <border:SfBorder
                            Grid.Row="0"
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">



                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>



                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>



                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="false"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.Information}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineSpacing="1"
                                    Style="{StaticResource TCBodyLabelGrey}"
                                    Text="{Binding Description}" />
                            </Grid>
                        </border:SfBorder>



                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--<CheckBox Grid.Column="0" Color="{StaticResource NewDarkGreenColor}" VerticalOptions="CenterAndExpand" CheckedChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsInstuctionsChecked}" IsEnabled="{Binding IsCheckboxEditable}">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox" Value="false">
                                        <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                            <custom:CustomLabel Grid.Column="1" Text="{Binding CheckBoxDescription}" Style="{StaticResource GAZTMicroMediumGrayLabel}" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalTextAlignment="Center"/>-->


                            <StackLayout
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                                <custom1:CheckboxCustom
                                    CheckChanged="CheckBox_CheckedChanged"
                                    IsChecked="{Binding IsInstuctionsChecked}"
                                    IsEnabled="{Binding IsCheckboxEditable}"
                                    Style="{StaticResource CheckboxHeightWidth32}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel
                                    HorizontalOptions="StartAndExpand"
                                    LineSpacing="0.8"
                                    Text="{Binding CheckBoxDescription}">
                                    <!-- <custom:CustomLabel.FormattedText>
                                                            <FormattedString>
                                                                <Span   Text="{Binding CheckBoxDescription}" />
                                                            </FormattedString>
                                                        </custom:CustomLabel.FormattedText>-->
                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="custom:CustomLabel"
                                            Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="custom:CustomLabel"
                                            Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                        </Grid>



                        <buttons:SfButton
                            Margin="0,24,0,24"
                            BackgroundColor="{Binding ContinueBackGroundColor}"
                            Command="{Binding InstructionsContinueClick}"
                            IsEnabled="{Binding IsContinueEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ButtonTitle}"
                            VerticalOptions="End" />
                    </StackLayout>
                </ScrollView>




            </Grid>
        </yummy:PancakeView>


        <yummy:PancakeView
            Padding="15,0,15,0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            IsVisible="{Binding IsInstructions}"
            VerticalOptions="EndAndExpand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,32,0,0" HorizontalOptions="StartAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>



                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>



                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalOptions="StartAndExpand"
                        VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="UserIconFont"
                                Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                Size="24"
                                Color="{StaticResource SecondaryNew}" />
                        </Image.Source>
                    </Image>
                    <custom:CustomLabel
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="15"
                        HorizontalOptions="StartAndExpand"
                        Style="{StaticResource ValueLabelBlackBold}"
                        Text="{x:Static ResourceManager:AppResources.VATDeregistrationInstructionsTitle}"
                        VerticalOptions="CenterAndExpand" />
                </Grid>




                <ScrollView
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">
                    <StackLayout
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        Orientation="Vertical">



                        <border:SfBorder
                            Grid.Row="0"
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">



                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>



                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>



                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="false">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>
                                </Image>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="false"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.Information}" />
                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineSpacing="1"
                                    Style="{StaticResource TCBodyLabelGrey}"
                                    Text="{Binding Description}" />
                            </Grid>
                        </border:SfBorder>



                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--<CheckBox Grid.Column="0" Color="{StaticResource NewDarkGreenColor}" VerticalOptions="CenterAndExpand" CheckedChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsInstuctionsChecked}" IsEnabled="{Binding IsCheckboxEditable}">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox" Value="false">
                                        <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                            <custom:CustomLabel Grid.Column="1" Text="{Binding CheckBoxDescription}" Style="{StaticResource GAZTMicroMediumGrayLabel}" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start" VerticalTextAlignment="Center"/>-->


                            <StackLayout
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="StartAndExpand"
                                Orientation="Horizontal">
                                <custom1:CheckboxCustom
                                    CheckChanged="CheckBox_CheckedChanged"
                                    IsChecked="{Binding IsInstuctionsChecked}"
                                    IsEnabled="{Binding IsCheckboxEditable}"
                                    Style="{StaticResource CheckboxHeightWidth32}"
                                    VerticalOptions="CenterAndExpand" />
                                <custom:CustomLabel
                                    HorizontalOptions="StartAndExpand"
                                    LineSpacing="0.8"
                                    Text="{Binding CheckBoxDescription}"
                                    VerticalOptions="CenterAndExpand">

                                    <custom:CustomLabel.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="custom:CustomLabel"
                                            Value="True">
                                            <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsInstuctionsChecked}"
                                            TargetType="custom:CustomLabel"
                                            Value="False">
                                            <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                        </DataTrigger>
                                    </custom:CustomLabel.Triggers>
                                </custom:CustomLabel>
                            </StackLayout>
                        </Grid>



                        <buttons:SfButton
                            Margin="0,24,0,24"
                            BackgroundColor="{Binding ContinueBackGroundColor}"
                            Command="{Binding InstructionsContinueClick}"
                            IsEnabled="{Binding IsContinueEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ButtonTitle}"
                            VerticalOptions="End" />
                    </StackLayout>
                </ScrollView>




            </Grid>
        </yummy:PancakeView>
        <yummy:PancakeView
            Padding="15,0,15,0"
            BackgroundColor="White"
            CornerRadius="15,15,0,0"
            IsVisible="{Binding IsTerms}"
            VerticalOptions="EndAndExpand">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <custom:CustomLabel
                    Grid.Row="0"
                    Margin="0,32,0,0"
                    FontSize="15"
                    HorizontalOptions="Center"
                    Style="{StaticResource ValueLabelBlackBold}"
                    Text="{x:Static ResourceManager:AppResources.BPTermsAndConditions}" />
                <ScrollView Grid.Row="1">
                    <StackLayout
                        Margin="0,32,0,0"
                        Padding="5,0,5,0"
                        Orientation="Vertical">


                        <border:SfBorder
                            Grid.Row="0"
                            BorderColor="#B1B1B1"
                            BorderWidth="1"
                            Style="{StaticResource GreyBorderFrame}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0 "
                                    IsVisible="False">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="UserIconFont"
                                            Glyph="{x:Static FontImage:IconFonts.InformationOutline}"
                                            Size="24"
                                            Color="{StaticResource SecondaryNew}" />
                                    </Image.Source>

                                </Image>
                                <custom:CustomLabel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    FontSize="15"
                                    HorizontalOptions="StartAndExpand"
                                    IsVisible="False"
                                    Style="{StaticResource ValueLabelBlackBold}"
                                    Text="{x:Static ResourceManager:AppResources.Information}" />

                                <custom:CustomLabel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalOptions="StartAndExpand"
                                    LineSpacing="1.5"
                                    Style="{StaticResource BodyLabelGrey}"
                                    Text="{Binding Description}" />

                            </Grid>
                        </border:SfBorder>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--<CheckBox Grid.Column="0" Color="{StaticResource NewDarkGreenColor}" VerticalOptions="CenterAndExpand" CheckedChanged="CheckBox_CheckedChanged" IsChecked="{Binding IsTermsChecked}" IsEnabled="{Binding IsCheckboxEditable}">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox" Value="false">
                                        <Setter Property="Color" Value="{StaticResource NewDarkGreenColor}" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                            <custom:CustomLabel Grid.Column="1" Text="{Binding CheckBoxDescription}" Style="{StaticResource GAZTMicroMediumGrayLabel}" HorizontalOptions="StartAndExpand" HorizontalTextAlignment="Start"/>-->





                            <custom1:CheckboxCustom
                                Grid.Row="0"
                                Grid.Column="0"
                                CheckChanged="CheckBox_CheckedChanged"
                                IsChecked="{Binding IsTermsChecked}"
                                IsEnabled="{Binding IsCheckboxEditable}"
                                Style="{StaticResource CheckboxHeightWidth32}"
                                VerticalOptions="CenterAndExpand" />

                            <custom:CustomLabel
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalOptions="StartAndExpand"
                                LineSpacing="0.8"
                                Text="{Binding CheckBoxDescription}"
                                VerticalOptions="Center">
                                <!--<custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span   Text="{Binding CheckBoxDescription}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>-->
                                <custom:CustomLabel.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsTermsChecked}"
                                        TargetType="custom:CustomLabel"
                                        Value="True">
                                        <Setter Property="Style" Value="{StaticResource CheckboxSelectedFontStyle}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsTermsChecked}"
                                        TargetType="custom:CustomLabel"
                                        Value="False">
                                        <Setter Property="Style" Value="{StaticResource CheckboxUnselectedFontStyle}" />
                                    </DataTrigger>
                                </custom:CustomLabel.Triggers>
                            </custom:CustomLabel>
                        </Grid>



                        <buttons:SfButton
                            Margin="0,24,0,24"
                            BackgroundColor="{Binding ContinueBackGroundColor}"
                            Command="{Binding TermsContinueClick}"
                            IsEnabled="{Binding IsContinueEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Text="{Binding ButtonTitle}"
                            VerticalOptions="End" />
                    </StackLayout>

                </ScrollView>

            </Grid>
        </yummy:PancakeView>

    </Grid>

</pages:PopupPage>