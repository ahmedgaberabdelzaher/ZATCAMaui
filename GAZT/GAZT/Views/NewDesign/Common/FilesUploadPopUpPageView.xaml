<?xml version="1.0" encoding="utf-8" ?>

<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.ZakatInstalmentPlan.FilesUploadPopUpPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards1="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    FlowDirection="RightToLeft">

    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>

    <yummy:PancakeView
        BackgroundColor="White"
        CornerRadius="22,22,0,0"
        VerticalOptions="End">
        <Grid>
            <StackLayout Margin="10,0,10,0" Padding="0,0,0,0">

                <!--<border:SfBorder Margin="0,10,0,10" HasShadow="False" Padding="0"
                                 Style="{StaticResource GreyBorderFrameWithShadow}">-->
                <StackLayout Orientation="Vertical">
                    <BoxView
                        HorizontalOptions="Center"
                        Style="{StaticResource NeutralGrayBoxViewDrag}"
                        VerticalOptions="Start" />
                    <Button
                        Margin="10,10,10,10"
                        BackgroundColor="Transparent"
                        Command="{Binding GoButtonClick}"
                        FontAttributes="Bold"
                        FontSize="Medium"
                        HorizontalOptions="End"
                        Style="{StaticResource GAZTVerifyButton}"
                        Text="{x:Static ResourceManager:AppResources.CRDone}"
                        TextColor="{StaticResource Primary}" />
                </StackLayout>
                <!--</border:SfBorder>-->
                <Label
                    Margin="0,0,0,0"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding TitleOne}" />
                <Label
                    Margin="0,0,0,0"
                    HorizontalTextAlignment="Start"
                    Style="{StaticResource CaptionLabelGrey}"
                    Text="{Binding TitleTwo}" />
                <BoxView Margin="0,0,0,10" Style="{StaticResource lineSeperator}" />
                <ListView
                    x:Name="List"
                    HasUnevenRows="True"
                    HeightRequest="300"
                    HorizontalOptions="FillAndExpand"
                    ItemTapped="Attachmentlist_ItemTapped"
                    ItemsSource="{Binding AttachmentList}"
                    SeparatorVisibility="None"
                    VerticalOptions="FillAndExpand">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <ContentView>
                                    <cards1:SfCardView
                                        Margin="10"
                                        BackgroundColor="White"
                                        BorderColor="{StaticResource NeutralLightGrey}"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HasShadow="False"
                                        IndicatorColor="{StaticResource Primary}"
                                        IndicatorPosition="Left"
                                        IndicatorThickness="5"
                                        Opacity=".9"
                                        ShadowColor="{StaticResource EntryTextColor}">
                                        <StackLayout
                                            Padding="10"
                                            HorizontalOptions="FillAndExpand"
                                            Orientation="Horizontal"
                                            VerticalOptions="CenterAndExpand">
                                            <Grid
                                                BackgroundColor="White"
                                                ColumnSpacing="0"
                                                HorizontalOptions="FillAndExpand"
                                                RowSpacing="2"
                                                Style="{DynamicResource GridStyle}"
                                                VerticalOptions="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70*" />
                                                    <ColumnDefinition Width="15*" />
                                                    <ColumnDefinition Width="15*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30" />
                                                    <RowDefinition Height="30" />
                                                </Grid.RowDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    LineBreakMode="TailTruncation"
                                                    Style="{StaticResource MicroGrayLabelStyleNew}"
                                                    Text="{Binding Filename}"
                                                    VerticalOptions="CenterAndExpand" />
                                                <!--<Image Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Source="ic_file_download.png"  >
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDownloadAttachmentClicked" />
                                                </Image.GestureRecognizers>
                                            </Image>-->
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="2"
                                                    HorizontalOptions="CenterAndExpand"
                                                    Source="ic_delete.png"
                                                    VerticalOptions="CenterAndExpand">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDeleteAttachmentClicked" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="3,0,3,-5"
                                                    FlowDirection="LeftToRight"
                                                    FontFamily="{StaticResource SomarBold}"
                                                    HorizontalOptions="StartAndExpand"
                                                    Style="{StaticResource MiniGrayLabelStyle}"
                                                    Text="{Binding Erfdt}"
                                                    VerticalOptions="CenterAndExpand" />
                                            </Grid>
                                        </StackLayout>
                                    </cards1:SfCardView>
                                </ContentView>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <buttons:SfButton
                    x:Name="btnAddAttachment"
                    Margin="0,0,0,20"
                    BackgroundColor="{StaticResource Secondary}"
                    BorderWidth="0"
                    Command="{Binding OnAttachmentClick}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="{StaticResource SomarSemiBold}"
                    FontSize="15"
                    HeightRequest="56"
                    Text="{x:Static custom2:AppResources.FAPAddAttachment}"
                    TextColor="{DynamicResource Gray-White}"
                    VerticalOptions="End" />
            </StackLayout>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                IsVisible="{Binding IsLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="{Binding IsLoading}"
                            TextColor="{StaticResource Primary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="Center"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                    <!--  Title="{x:Static local:AppResources.ActivityIndicatorTitle}"  -->
                </StackLayout>
            </Grid>
        </Grid>

    </yummy:PancakeView>
</pages:PopupPage>