<?xml version="1.0" encoding="UTF-8" ?>
<newdesign:BaseContentPage
    xmlns:newdesign="clr-namespace:EGAZT.Views.NewDesign"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGAZT.Views.NewDesign.Common.PaymentWebView"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:xct="http://xamarin.com/schemas/2020/toolkit"
    TitleText="{x:Static ResourceManager:AppResources.PaymentDetails}">
    
    <newdesign:BaseContentPage.Behaviors>
        <xct:EventToCommandBehavior Command="{Binding GoTransactionPageCommand}"
                                    EventName="Appearing"/>
    </newdesign:BaseContentPage.Behaviors>

    <newdesign:BaseContentPage.PancakeView>

            <WebView x:Name="PaymentView"
                     Navigating="PaymentView_Navigating"
                     Source="{Binding PageURL}"  />

    </newdesign:BaseContentPage.PancakeView>
</newdesign:BaseContentPage>

