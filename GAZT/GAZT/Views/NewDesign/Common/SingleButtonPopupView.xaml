<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="EGAZT.Views.NewDesign.Common.SingleButtonPopupView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundClicked="OnBackGroundClicked">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView
        BackgroundColor="White"
        Style="{StaticResource CommonTopCurves}"
        VerticalOptions="EndAndExpand">
        <yummy:PancakeView.Border>
            <yummy:Border Thickness="0" Color="Transparent" />
        </yummy:PancakeView.Border>
        <ScrollView VerticalScrollBarVisibility="Never">

            <StackLayout>
                <custom:CustomLabel
                    x:Name="lblPopupHeader"
                    Margin="0,0,0,16"
                    HorizontalOptions="StartAndExpand"
                    Style="{StaticResource SectionTitleBlackBold}"
                    Text="{x:Static ResourceManager:AppResources.ZVatRefundTermsAndConditions}" />
                <border:SfBorder
                    Margin="0,0,0,10"
                    BorderColor="Transparent"
                    BorderWidth="0"
                    Style="{StaticResource GreyBorderFrame}">
                    <custom:CustomLabel
                        x:Name="MessageText"
                        Margin="5"
                        LineSpacing="1"
                        Style="{StaticResource BodyLabelBlack}" />
                </border:SfBorder>
                <buttons:SfButton
                    x:Name="btnOK"
                    Clicked="OnOkayButtonClicked"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackLayout>
        </ScrollView>
    </yummy:PancakeView>
</pages:PopupPage>