<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:custom="clr-namespace:GAZT"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             BackgroundClicked="OnBackGroundClicked"
             x:Class="EGAZT.Views.NewDesign.Common.SingleButtonPopupView"
                 xmlns:ResourceManager="clr-namespace:EGAZT"
                  xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms">
    <pages:PopupPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:PopupPage.Resources>
    <yummy:PancakeView BorderColor="Transparent" BorderThickness="0" Style="{StaticResource CommonTopCurves}" VerticalOptions="EndAndExpand" BackgroundColor="White">
        <ScrollView VerticalScrollBarVisibility="Never">

            <StackLayout>
                <custom:CustomLabel x:Name="lblPopupHeader" Text="{x:Static ResourceManager:AppResources.ZVatRefundTermsAndConditions}" HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlackBold}" Margin="0,0,0,16"  />
                <border:SfBorder BorderColor="Transparent" BorderWidth="0"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">
                    <custom:CustomLabel Margin="10" x:Name="MessageText" Style="{StaticResource BodyLabelBlack}"/>
                </border:SfBorder>
                <buttons:SfButton  x:Name="btnOK" HorizontalOptions="FillAndExpand" 
                                  Style="{StaticResource PrimaryButtonStyle}" Clicked="OnOkayButtonClicked" />
            </StackLayout>
        </ScrollView>
    </yummy:PancakeView>
</pages:PopupPage>