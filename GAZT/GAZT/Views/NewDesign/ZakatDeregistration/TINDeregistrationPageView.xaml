<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.TINDeregistrationPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
    xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
    xmlns:custom="clr-namespace:GAZT"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local="clr-namespace:EGAZT.Helper"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    x:Name="TinDeReg"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="false">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabelBlack" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SomarRegular}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector" />
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector" />
            <converters:ValueTypeToVisibilityConverter x:Key="valueTypeToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>

            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid
                        Grid.Row="0"
                        Margin="8,0"
                        Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistration}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>

                        <!--<Image Grid.Row="0" Grid.Column="2" Source="close" IsVisible="{TemplateBinding BindingContext.VoidIsVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>-->

                        <StackLayout Grid.Row="0" Grid.Column="2">
                            <StackLayout
                                HorizontalOptions="EndAndExpand"
                                Orientation="Horizontal"
                                Rotation="90"
                                Spacing="3"
                                VerticalOptions="CenterAndExpand">
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                                <BoxView
                                    BackgroundColor="{StaticResource SecondaryNew}"
                                    CornerRadius="3"
                                    HeightRequest="5"
                                    WidthRequest="5" />
                            </StackLayout>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}" />
                            </StackLayout.GestureRecognizers>
                        </StackLayout>


                    </Grid>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>

        <Grid
            Grid.Row="0"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">

            <ScrollView>
                <Grid
                    Margin="20,10,20,0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="FillAndExpand"
                    IsVisible="{Binding IsReasonViewEnabled}"
                    VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <custom:CustomLabel
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource SectionTitleBlack}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                        <custom:CustomLabel
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            Style="{StaticResource BodyLabelGrey}"
                            Text="{x:Static ResourceManager:AppResources.TinDeregistrationSelectReason}" />
                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource NeutralGrayOpacity90BoxView}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0" Grid.Column="0">

                            <custom:CustomLabel
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource CaptionLabelGrey}"
                                Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" />
                            <border:SfBorder
                                Margin="0,0,0,10"
                                BorderColor="#B1B1B1"
                                BorderWidth="1"
                                Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Padding="5,15,5,15" Orientation="Horizontal">

                                    <Label
                                        x:Name="selectedReasonLbl"
                                        FontFamily="{StaticResource SomarLight}"
                                        HorizontalOptions="Start"
                                        Style="{StaticResource GAZTSmallBlackLabel}"
                                        Text="{Binding SelectedReason.ReasonDesc}" />
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5,0"
                                            HeightRequest="15"
                                            HorizontalOptions="Start"
                                            Source="arrowDropdown"
                                            VerticalOptions="Center"
                                            WidthRequest="15" />

                                        <!--<Image Margin="5,0" Rotation="270">
                                            <Image.Source Aspect="AspectFit" HeightRequest="15" WidthRequest="15">
                                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="15"
                                                            Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                            </Image.Source>
                                        </Image>-->
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTinRegistrationReasonTapped" />
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </border:SfBorder>
                        </StackLayout>
                    </Grid>

                    <listView:SfListView
                        x:Name="outletDecisionOptionsListView"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        AutoFitMode="Height"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        IsScrollBarVisible="False"
                        IsScrollingEnabled="False"
                        IsVisible="{Binding IsOutletDecisionOptionsLVVisible}"
                        ItemSpacing="5"
                        ItemsSource="{Binding OutletDecisionOptions}"
                        SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                        SelectionBackgroundColor="Transparent"
                        SelectionChanged="outletDecisionOptionsListView_SelectionChanged"
                        SelectionMode="Single"
                        VerticalOptions="Center">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HasShadow="False"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="AspectFill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="unselected171x136"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelBlack}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <listView:SfListView.SelectedItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView
                                    BackgroundColor="Transparent"
                                    CornerRadius="20"
                                    HasShadow="False"
                                    HeightRequest="104"
                                    WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Aspect="AspectFill"
                                            HorizontalOptions="FillAndExpand"
                                            Source="re_Tile_Background_S"
                                            VerticalOptions="FillAndExpand" />
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Style="{DynamicResource CardLabelWhite}" Text="{Binding CardLabel}" />
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.SelectedItemTemplate>
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>
                    </listView:SfListView>

                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsOption1Visible}">
                        <custom:CustomLabel x:Name="DateLabel" Style="{StaticResource CaptionLabelGrey}">
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                    <Span Text="*" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <StackLayout
                            x:Name="CalLabel"
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">
                            <custom:CustomLabel
                                HorizontalOptions="Start"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                            <Switch
                                x:Name="HijriCalSwitch"
                                HorizontalOptions="CenterAndExpand"
                                IsToggled="{Binding IsHijriCal}"
                                Toggled="HijriCalSwitch_Toggled" />
                            <custom:CustomLabel
                                HorizontalOptions="End"
                                Style="{StaticResource CaptionLabelBlack}"
                                Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                        </StackLayout>

                        <Grid
                            Grid.Row="5"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <inputLayout:SfTextInputLayout
                                x:Name="FrmDBO"
                                Margin="0,-10,0,0"
                                Style="{StaticResource InputTableTextInputLayoutStyle}">
                                <custom:BorderlessEntry
                                    x:Name="DateEntry"
                                    BackgroundColor="Gray"
                                    Focused="OnDateEntryFocussed"
                                    FontFamily="{StaticResource SomarLight}"
                                    IsReadOnly="True"
                                    Placeholder="yyyy/MM/dd"
                                    Style="{StaticResource InputTableEntryLayoutStyle}"
                                    Text="{Binding PickerDobToDisplay}"
                                    TextChanged="DateEntry_TextChanged"
                                    TextColor="{StaticResource NeutralBlack}"
                                    Unfocused="DatePicker_Unfocused"
                                    VerticalTextAlignment="End" />
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <!--<Image Source="arrowDropdown.png"/>-->
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                        <Image Margin="5,0">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="UserIconFont"
                                                    Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                    Size="20"
                                                    Color="{StaticResource SecondaryNew}" />
                                            </Image.Source>
                                        </Image>
                                    </StackLayout>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <Button
                                Margin="0,0,0,0"
                                BackgroundColor="Transparent"
                                Clicked="OnDOBClicked" />
                            <custom1:CustomDatePicker
                                x:Name="DpDbo"
                                Margin="10,0,10,0"
                                BackgroundColor="White"
                                BorderColor="Black"
                                CancelButtonBackgroundColor="#EAF7CC"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
                                CancelButtonTextColor="{StaticResource Primary}"
                                Closed="DpDbo_Closed"
                                ColumnHeaderBackgroundColor="White"
                                ColumnHeaderHeight="46"
                                FlowDirection="RightToLeft"
                                HeaderBackgroundColor="#EAF7CC"
                                HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                OKButtonBackgroundColor="#EAF7CC"
                                OKButtonTextColor="{StaticResource Primary}"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                PickerMode="Dialog"
                                SelectedItem="{Binding TodayDate}"
                                SelectedItemTextColor="{StaticResource NeutralBlack}"
                                SelectionChanged="DpDbo_SelectionChanged"
                                ShowColumnHeader="True"
                                ShowFooter="False"
                                ShowHeader="False">
                                <custom1:CustomDatePicker.Behaviors>
                                    <custom1:SfPickerBehavior />
                                </custom1:CustomDatePicker.Behaviors>
                            </custom1:CustomDatePicker>
                            <!--  HijriDatePicker  -->
                            <custom1:CustomHijriDatePicker
                                x:Name="DpDboHijri"
                                Margin="10,0,10,0"
                                BackgroundColor="White"
                                BorderColor="Black"
                                CancelButtonBackgroundColor="#EAF7CC"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
                                CancelButtonTextColor="{StaticResource Primary}"
                                Closed="DpDbo_Closed"
                                ColumnHeaderBackgroundColor="White"
                                ColumnHeaderHeight="46"
                                FlowDirection="RightToLeft"
                                HeaderBackgroundColor="#EAF7CC"
                                HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
                                HorizontalOptions="FillAndExpand"
                                ItemHeight="40"
                                OKButtonBackgroundColor="#EAF7CC"
                                OKButtonTextColor="{StaticResource Primary}"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                PickerMode="Dialog"
                                SelectedItem="{Binding TodayDateinHijri}"
                                SelectedItemTextColor="{StaticResource NeutralBlack}"
                                SelectionChanged="DpDbo_SelectionChanged"
                                ShowColumnHeader="True"
                                ShowFooter="False"
                                ShowHeader="False" />
                            <!--  SelectedItem="{Binding TodayDate}"  -->
                            <!--  HijriDatePicker  -->
                        </Grid>

                    </StackLayout>


                    <StackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding IsOption2Visible}">

                        <!--  Display this view in both cases Transfer outlets to snigle transferee an sub selection all id types-!>  -->

                        <StackLayout>
                            <custom:CustomLabel Style="{StaticResource CaptionLabelGrey}">
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" />
                                        <Span Text="*" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel
                                    HorizontalOptions="Start"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NDGregorian}" />
                                <Switch
                                    x:Name="HijriCalSwitch1"
                                    HorizontalOptions="CenterAndExpand"
                                    IsToggled="{Binding IsHijriCal, Mode=TwoWay}"
                                    Toggled="HijriCal2Switch_Toggled" />
                                <custom:CustomLabel
                                    HorizontalOptions="End"
                                    Style="{StaticResource CaptionLabelBlack}"
                                    Text="{x:Static ResourceManager:AppResources.NDHijri}" />
                            </StackLayout>

                            <Grid>
                                <inputLayout:SfTextInputLayout
                                    x:Name="FrmDBO2"
                                    Margin="0,-10,0,0"
                                    Style="{StaticResource InputTableTextInputLayoutStyle}">
                                    <custom:BorderlessEntry
                                        x:Name="DateEntry21"
                                        Focused="OnDateEntryFocussed"
                                        FontAttributes="None"
                                        FontFamily="{StaticResource SomarRegular}"
                                        FontSize="Small"
                                        IsReadOnly="True"
                                        Placeholder="yyyy/MM/dd"
                                        Style="{StaticResource InputTableEntryLayoutStyle}"
                                        Text="{Binding PickerDobToDisplay}"
                                        TextChanged="DateEntry_TextChanged"
                                        TextColor="{StaticResource NeutralBlack}"
                                        Unfocused="DatePicker_Unfocused"
                                        VerticalTextAlignment="End" />
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <!--<Image Source="arrowDropdown.png"/>-->
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource
                                                        FontFamily="UserIconFont"
                                                        Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"
                                                        Size="20"
                                                        Color="{StaticResource SecondaryNew}" />
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <Button
                                    Margin="0,0,0,0"
                                    BackgroundColor="Transparent"
                                    Clicked="OnDOBClicked"
                                    TextColor="Transparent" />
                                <custom1:CustomDatePicker
                                    x:Name="DpDbo2"
                                    Margin="10,0,10,0"
                                    BackgroundColor="White"
                                    BorderColor="Black"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    CancelButtonClicked="DpDbo_CancelButtonClicked"
                                    CancelButtonTextColor="{StaticResource Primary}"
                                    Closed="DpDbo_Closed"
                                    ColumnHeaderBackgroundColor="White"
                                    ColumnHeaderHeight="46"
                                    FlowDirection="RightToLeft"
                                    HeaderBackgroundColor="#EAF7CC"
                                    HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="40"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    OKButtonTextColor="{StaticResource Primary}"
                                    OkButtonClicked="DOBpicker_OkButtonClicked"
                                    PickerMode="Dialog"
                                    SelectedItem="{Binding TodayDate}"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    SelectionChanged="DpDbo_SelectionChanged"
                                    ShowColumnHeader="True"
                                    ShowFooter="False"
                                    ShowHeader="False">
                                    <custom1:CustomDatePicker.Behaviors>
                                        <custom1:SfPickerBehavior />
                                    </custom1:CustomDatePicker.Behaviors>
                                </custom1:CustomDatePicker>
                                <!--  HijriDatePicker  -->
                                <custom1:CustomHijriDatePicker
                                    x:Name="DpDboHijri2"
                                    Margin="10,0,10,0"
                                    BackgroundColor="White"
                                    BorderColor="Black"
                                    CancelButtonBackgroundColor="#EAF7CC"
                                    CancelButtonClicked="DpDbo_CancelButtonClicked"
                                    CancelButtonTextColor="{StaticResource Primary}"
                                    Closed="DpDbo_Closed"
                                    ColumnHeaderBackgroundColor="White"
                                    ColumnHeaderHeight="46"
                                    FlowDirection="RightToLeft"
                                    HeaderBackgroundColor="#EAF7CC"
                                    HeaderText="{x:Static ResourceManager:AppResources.TinDeregistrationDate}"
                                    HorizontalOptions="FillAndExpand"
                                    ItemHeight="40"
                                    OKButtonBackgroundColor="#EAF7CC"
                                    OKButtonTextColor="{StaticResource Primary}"
                                    OkButtonClicked="DOBpicker_OkButtonClicked"
                                    PickerMode="Dialog"
                                    SelectedItem="{Binding TodayDateinHijri}"
                                    SelectedItemTextColor="{StaticResource NeutralBlack}"
                                    SelectionChanged="DpDbo_SelectionChanged"
                                    ShowColumnHeader="True"
                                    ShowFooter="False"
                                    ShowHeader="False" />
                                <!--  SelectedItem="{Binding TodayDate}"  -->
                                <!--  HijriDatePicker  -->
                            </Grid>
                            <!--<StackLayout IsVisible="{Binding DateField.IsVisible}">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />
                                <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">

                                        <Label Text="{Binding DeregistrationDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                             Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                             <TapGestureRecognizer Command="{Binding OnTinRegistrationDateTapped}" ></TapGestureRecognizer>
                                         </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </border:SfBorder >
                            </StackLayout>-->
                            <StackLayout Margin="0,20,0,0" IsVisible="{Binding TinText.IsVisible}">
                                <custom:CustomLabel
                                    HorizontalOptions="StartAndExpand"
                                    Style="{StaticResource CaptionLabelGrey}"
                                    Text="{x:Static ResourceManager:AppResources.TIN}" />
                                <inputLayout:SfTextInputLayout
                                    x:Name="TINNumber"
                                    Margin="0,-6,0,-6"
                                    CharMaxLength="10"
                                    ContainerType="Outlined"
                                    ErrorColor="#B00020"
                                    FocusedColor="{StaticResource Primary}"
                                    HasError="{Binding FrameTinError}"
                                    OutlineCornerRadius="13"
                                    UnfocusedColor="#B1B1B1">
                                    <control:BorderlessEntry
                                        x:Name="EntryTIN"
                                        FontFamily="{StaticResource SomarLight}"
                                        FontSize="Small"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        IsEnabled="{Binding TinText.IsEditable}"
                                        Placeholder="{x:Static ResourceManager:AppResources.TIN}"
                                        Text="{Binding TINNumber}"
                                        TextChanged="OnTinEntered"
                                        TextColor="{DynamicResource BlackLabelTextColor}"
                                        Unfocused="BorderlessTINEntry_Unfocused"
                                        VerticalTextAlignment="Start">
                                        <control:BorderlessEntry.Behaviors>
                                            <custom1:OnlyNumericValuesBehaviour />
                                        </control:BorderlessEntry.Behaviors>
                                    </control:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

