<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:custom="clr-namespace:GAZT" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.TINDeregistrationPageView"
             NavigationPage.HasNavigationBar="false"
             BackgroundImageSource="partials_background.png" xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms" xmlns:custom1="clr-namespace:GAZT.CustomControl"
             xmlns:FontImage="clr-namespace:MVP.FontIcons" xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:local="clr-namespace:EGAZT.Helper"
             xmlns:templateSelector="clr-namespace:EGAZT.Views.NewDesign.TemplateSelector"
             xmlns:control="clr-namespace:GAZTeServicesApp.Controls"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:converters="clr-namespace:EGAZT.NewDesignConverters"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
             x:Name="TinDeReg">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionLabelBlack" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource NeutralBlack}" />
                <Setter Property="FontFamily" Value="{StaticResource SSTArRoman}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <templateSelector:LVUnselectedItemTemplateSelectorNoIcon x:Key="UnselectedItemTemplateSelector"/>
            <templateSelector:LVSelectedItemTemplateSelectorNoIcon x:Key="SelectedIttemTemplateSelector"/>
            <converters:ValueTypeToVisibilityConverter x:Key="valueTypeToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>

            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,0" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />

                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0" Margin="8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.TinDeregistration}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"/>
                        <Image Grid.Row="0" Grid.Column="0" IsVisible="{TemplateBinding BindingContext.IsBackButtonVisible}" Source="arrowLeftwhite" Style="{DynamicResource BackButtonArrow}"  VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>

                        <!--<Image Grid.Row="0" Grid.Column="2" Source="close" IsVisible="{TemplateBinding BindingContext.VoidIsVisible}" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>-->

                        <StackLayout  Grid.Row="0" Grid.Column="2">
                        <StackLayout Spacing="3" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Orientation="Horizontal" Rotation="90">
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                            <BoxView HeightRequest="5" WidthRequest="5" CornerRadius="3" BackgroundColor="White"/>
                        </StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{TemplateBinding BindingContext.OnMoreClicked}"/>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                  

                    </Grid>
                </Grid>

            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>

        <Grid Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <ScrollView>
                <Grid IsVisible="{Binding IsReasonViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0"
                      HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <custom:CustomLabel Grid.Row="0" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource SectionTitleBlack}" />
                        <custom:CustomLabel Grid.Row="1" Grid.Column="0" Text="{x:Static ResourceManager:AppResources.TinDeregistrationSelectReason}" HorizontalOptions="StartAndExpand"
                                        Style="{StaticResource BodyLabelGrey}"/>
                        <BoxView Grid.Row="2" Grid.Column="0" Style="{StaticResource NeutralGrayOpacity90BoxView}"/>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>

                        <StackLayout Grid.Row="0" Grid.Column="0">

                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TinDeregistrationReason}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />
                            <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">

                                    <Label Text="{Binding SelectedReason.ReasonDesc}" x:Name="selectedReasonLbl" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown" Margin="5,0" WidthRequest="15" HeightRequest="15"
                                               HorizontalOptions="Start" VerticalOptions="Center">

                                        </Image>

                                        <!--<Image Margin="5,0" Rotation="270">
                                            <Image.Source Aspect="AspectFit" HeightRequest="15" WidthRequest="15">
                                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="15"  
                                                            Glyph="{x:Static FontImage:IconFonts.LessThan}"/>
                                            </Image.Source>
                                        </Image>-->
                                    </StackLayout>

                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTinRegistrationReasonTapped" ></TapGestureRecognizer>
                                    </StackLayout.GestureRecognizers>

                                </StackLayout>
                            </border:SfBorder >
                        </StackLayout>
                    </Grid>

                    <listView:SfListView BackgroundColor="Transparent" x:Name="outletDecisionOptionsListView" HorizontalOptions="Center" IsScrollBarVisible="False"
                                      IsScrollingEnabled="False" AutoFitMode="Height"  VerticalOptions="Center"
                                      Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ItemSpacing="5" IsVisible="{Binding IsOutletDecisionOptionsLVVisible}"
                                      ItemsSource="{Binding OutletDecisionOptions}"   SelectionMode="Single" SelectedItem="{Binding SelectedOutletOption, Mode=TwoWay}"
                                      SelectionBackgroundColor="Transparent" SelectionChanged="outletDecisionOptionsListView_SelectionChanged">
                        <listView:SfListView.ItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="104" WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image  Source="unselected171x136" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Text="{Binding CardLabel}" Style="{DynamicResource CardLabelBlack}" LineHeight="0.7"/>
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.ItemTemplate>
                        <listView:SfListView.SelectedItemTemplate>
                            <DataTemplate>
                                <cards:SfCardView HasShadow="False" BackgroundColor="Transparent" CornerRadius="20" HeightRequest="104" WidthRequest="171">
                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="104"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="re_Tile_Background_S" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                        <StackLayout Style="{DynamicResource CardParentStacklayout}" VerticalOptions="EndAndExpand">
                                            <Label Text="{Binding CardLabel}" Style="{DynamicResource CardLabelWhite}" LineHeight="0.7"/>
                                        </StackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </listView:SfListView.SelectedItemTemplate>
                        <listView:SfListView.LayoutManager>
                            <listView:GridLayout x:Name="GridLayout" SpanCount="{OnIdiom Phone=2, Tablet=4, Desktop=5}" />
                        </listView:SfListView.LayoutManager>
                    </listView:SfListView>

                    <StackLayout  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsOption1Visible}">
                        <custom:CustomLabel x:Name="DateLabel" Style="{StaticResource CaptionLabelGrey}" >
                            <custom:CustomLabel.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}"/>
                                    <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                </FormattedString>
                            </custom:CustomLabel.FormattedText>
                        </custom:CustomLabel>
                        <StackLayout x:Name="CalLabel" Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                            <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDGregorian}"  HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}"  />
                            <Switch x:Name="HijriCalSwitch" HorizontalOptions="CenterAndExpand" IsToggled="{Binding IsHijriCal}" Toggled="HijriCalSwitch_Toggled" />
                            <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.NDHijri}" HorizontalOptions="End" Style="{StaticResource CaptionLabelBlack}"/>
                        </StackLayout>

                        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2">
                            <inputLayout:SfTextInputLayout x:Name="FrmDBO" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0" >
                                <custom:BorderlessEntry Style="{StaticResource InputTableEntryLayoutStyle}" x:Name="DateEntry" 
                                                         Text ="{Binding PickerDobToDisplay}" Unfocused="DatePicker_Unfocused" TextChanged="DateEntry_TextChanged"
                                                         Focused="OnDateEntryFocussed"  Placeholder="yyyy/MM/dd"  BackgroundColor="Gray"
                                                             VerticalTextAlignment="End"  IsReadOnly="True" TextColor="{StaticResource NeutralBlack}">

                                </custom:BorderlessEntry>
                                <inputLayout:SfTextInputLayout.TrailingView>
                                    <!--<Image Source="arrowDropdown.png"/>-->
                                    <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                        <Image Margin="5,0">
                                            <Image.Source>
                                                <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                            </Image.Source>
                                        </Image>
                                    </StackLayout>
                                </inputLayout:SfTextInputLayout.TrailingView>
                            </inputLayout:SfTextInputLayout>
                            <Button BackgroundColor="Transparent" Clicked="OnDOBClicked" Margin="0,0,0,0" >
                            </Button>
                            <custom1:CustomDatePicker FlowDirection="RightToLeft" 
								ShowHeader="False"
								Margin="10,0,10,0" 
                                BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                HeaderBackgroundColor="#EAF7CC"
                                SelectedItemTextColor="{StaticResource NeutralBlack}"
                                BorderColor="Black"
								ShowFooter="False"
								ShowColumnHeader="True"
                                ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="46"
                                PickerMode="Dialog"
								HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
								x:Name="DpDbo"
                                OKButtonTextColor="#006450" 
                                CancelButtonTextColor="#006450"
                                SelectedItem="{Binding TodayDate}"
                                HorizontalOptions="FillAndExpand"
                                Closed="DpDbo_Closed"
                                SelectionChanged="DpDbo_SelectionChanged"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
								ItemHeight="40">
                                <custom1:CustomDatePicker.Behaviors>
                                    <custom1:SfPickerBehavior />
                                </custom1:CustomDatePicker.Behaviors>
                            </custom1:CustomDatePicker>
                            <!--HijriDatePicker-->
                            <custom1:CustomHijriDatePicker FlowDirection="RightToLeft" 
								ShowHeader="False"
								Margin="10,0,10,0" 
                                BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                HeaderBackgroundColor="#EAF7CC"
                                SelectedItemTextColor="{StaticResource NeutralBlack}"
                                BorderColor="Black"
                                SelectedItem="{Binding TodayDateinHijri}"                                  
								ShowFooter="False"
								ShowColumnHeader="True"
                                ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="46"
                                PickerMode="Dialog"
								HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
								x:Name="DpDboHijri"
                             OKButtonTextColor="#006450"    
                             CancelButtonTextColor="#006450"
                           
                            HorizontalOptions="FillAndExpand"
                               Closed="DpDbo_Closed"
                                                      SelectionChanged="DpDbo_SelectionChanged"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
								ItemHeight="40">
                            </custom1:CustomHijriDatePicker>
                            <!--SelectedItem="{Binding TodayDate}"-->
                            <!--HijriDatePicker-->
                        </Grid>

                    </StackLayout>


                    <StackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsOption2Visible}">

                        <!--Display this view in both cases Transfer outlets to snigle transferee an sub selection all id types-!>-->

                        <StackLayout >
                            <custom:CustomLabel  Style="{StaticResource CaptionLabelGrey}"  >
                                <custom:CustomLabel.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}"/>
                                        <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                    </FormattedString>
                                </custom:CustomLabel.FormattedText>
                            </custom:CustomLabel>
                            <StackLayout Orientation="Horizontal">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.NDGregorian}" HorizontalOptions="Start" Style="{StaticResource CaptionLabelBlack}"/>
                                <Switch x:Name="HijriCalSwitch1" HorizontalOptions="CenterAndExpand" IsToggled="{Binding IsHijriCal, Mode=TwoWay}" Toggled="HijriCal2Switch_Toggled" />
                                <custom:CustomLabel  Text="{x:Static ResourceManager:AppResources.NDHijri}" HorizontalOptions="End" Style="{StaticResource CaptionLabelBlack}"/>
                            </StackLayout>

                            <Grid >
                                <inputLayout:SfTextInputLayout x:Name="FrmDBO2" Style="{StaticResource InputTableTextInputLayoutStyle}" Margin="0,-10,0,0">
                                    <custom:BorderlessEntry Style="{StaticResource InputTableEntryLayoutStyle}" x:Name="DateEntry21"
                                                         Text ="{Binding PickerDobToDisplay}" Unfocused="DatePicker_Unfocused" TextChanged="DateEntry_TextChanged"
                                                         Focused="OnDateEntryFocussed"  Placeholder="yyyy/MM/dd" 
                                                             VerticalTextAlignment="End"  IsReadOnly="True" TextColor="{StaticResource NeutralBlack}">

                                    </custom:BorderlessEntry>
                                    <inputLayout:SfTextInputLayout.TrailingView>
                                        <!--<Image Source="arrowDropdown.png"/>-->
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                            Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>
                                    </inputLayout:SfTextInputLayout.TrailingView>
                                </inputLayout:SfTextInputLayout>
                                <Button  TextColor="Transparent"  BackgroundColor="Transparent" Clicked="OnDOBClicked"  Margin="0,0,0,0" >
                                </Button>
                                <custom1:CustomDatePicker FlowDirection="RightToLeft" 
								ShowHeader="False"
								Margin="10,0,10,0" 
                                BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="#EAF7CC"
                                 SelectedItemTextColor="{StaticResource NeutralBlack}"
                                 BorderColor="Black"
								ShowFooter="False"
								 ShowColumnHeader="True"
                                 ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="46"
                                PickerMode="Dialog"
								HeaderText="{x:Static ResourceManager:AppResources.ZZDateofBirth}"
								
								x:Name="DpDbo2"
                             OKButtonTextColor="#006450" 
                              CancelButtonTextColor="#006450"
                            SelectedItem="{Binding TodayDate}"
                            HorizontalOptions="FillAndExpand"
                                 Closed="DpDbo_Closed"
                                 SelectionChanged="DpDbo_SelectionChanged"
                                OkButtonClicked="DOBpicker_OkButtonClicked"
                                CancelButtonClicked="DpDbo_CancelButtonClicked"
								ItemHeight="40">
                                    <custom1:CustomDatePicker.Behaviors>
                                        <custom1:SfPickerBehavior />
                                    </custom1:CustomDatePicker.Behaviors>
                                </custom1:CustomDatePicker>
                                <!--HijriDatePicker-->
                                <custom1:CustomHijriDatePicker FlowDirection="RightToLeft" 
								ShowHeader="False"
								Margin="10,0,10,0" 
                              BackgroundColor="White"
                                OKButtonBackgroundColor="#EAF7CC"
                                CancelButtonBackgroundColor="#EAF7CC"
                                     HeaderBackgroundColor="#EAF7CC"
                              SelectedItemTextColor="{StaticResource NeutralBlack}"
                                BorderColor="Black"
                                  SelectedItem="{Binding TodayDateinHijri}"                                  
								ShowFooter="False"
								 ShowColumnHeader="True"
                                 ColumnHeaderBackgroundColor="White"
								ColumnHeaderHeight="46"
                                PickerMode="Dialog"
								HeaderText="{x:Static ResourceManager:AppResources.TinDeregistrationDate}"
								x:Name="DpDboHijri2"
                             OKButtonTextColor="#006450"    
                             CancelButtonTextColor="#006450"
                           
                            HorizontalOptions="FillAndExpand"
                               Closed="DpDbo_Closed"
                               SelectionChanged="DpDbo_SelectionChanged"
                               OkButtonClicked="DOBpicker_OkButtonClicked"
                               CancelButtonClicked="DpDbo_CancelButtonClicked"
							    ItemHeight="40">
                                </custom1:CustomHijriDatePicker>
                                <!--SelectedItem="{Binding TodayDate}"-->
                                <!--HijriDatePicker-->
                            </Grid>
                            <!--<StackLayout IsVisible="{Binding DateField.IsVisible}">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TinDeregistrationDate}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />   
                                <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">
                                        
                                        <Label Text="{Binding DeregistrationDate,StringFormat='{0:dd MMM yyyy}'}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <Image Margin="5,0">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="UserIconFont" Color="{StaticResource NeutralGreay}" Size="20"
                                                             Glyph="{x:Static FontImage:IconFonts.CalendarMonth}"/>
                                                </Image.Source>
                                            </Image>
                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                             <TapGestureRecognizer Command="{Binding OnTinRegistrationDateTapped}" ></TapGestureRecognizer>
                                         </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </border:SfBorder >
                            </StackLayout>-->
                            <StackLayout IsVisible="{Binding TinText.IsVisible}" Margin="0,20,0,0">
                                <custom:CustomLabel Text="{x:Static ResourceManager:AppResources.TIN}" HorizontalOptions="StartAndExpand"
                                                Style="{StaticResource CaptionLabelGrey}" />
                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" HasError="{Binding FrameTinError}"
							        ContainerType="Outlined" UnfocusedColor="#B1B1B1" CharMaxLength="10" x:Name="TINNumber"
							        OutlineCornerRadius="13" FocusedColor="#005e4b" ErrorColor="#B00020" >
                                    <control:BorderlessEntry x:Name="EntryTIN" Text="{Binding TINNumber}" IsEnabled="{Binding TinText.IsEditable}" Placeholder="{x:Static ResourceManager:AppResources.TIN}" FontSize="Small"  HorizontalTextAlignment="Start"
                                                            VerticalTextAlignment="Start" Unfocused="BorderlessTINEntry_Unfocused"
                                                            TextColor="#bbbbbb" HorizontalOptions="FillAndExpand" TextChanged="OnTinEntered">
                                        <control:BorderlessEntry.Behaviors>
                                            <custom1:OnlyNumericValuesBehaviour/>
                                        </control:BorderlessEntry.Behaviors>
                                    </control:BorderlessEntry>
                                </inputLayout:SfTextInputLayout>
                            </StackLayout>

                            <StackLayout >
                                <custom:CustomLabel  Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.ZZIDType}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>

                                <border:SfBorder BorderColor="#B1B1B1" BorderWidth="1"  Margin="0,0,0,10"  Style="{StaticResource GreyBorderFrame}">

                                    <StackLayout Orientation="Horizontal"  Padding="5,15,5,15">

                                        <Label Text="{Binding SelectedIdtype}" Style="{StaticResource GAZTSmallBlackLabel}" HorizontalOptions="Start"/>
                                        <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal" >
                                            <Image Grid.Row="0" Grid.Column="1" Source="arrowDropdown" Margin="5,0" WidthRequest="15" HeightRequest="15"
                                               HorizontalOptions="Start" VerticalOptions="Center">
                                            </Image>
                                        </StackLayout>

                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding IdTypeTapped}" ></TapGestureRecognizer>
                                        </StackLayout.GestureRecognizers>

                                    </StackLayout>
                                </border:SfBorder >
                            </StackLayout>

                            <StackLayout IsVisible="{Binding IdNumberText.IsVisible}">
                                <custom:CustomLabel  Style="{StaticResource CaptionLabelGrey}"  >
                                    <custom:CustomLabel.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static ResourceManager:AppResources.IDNumber}"/>
                                            <Span  Text="*" Style="{StaticResource MandatoryRedColorLabel}" />
                                        </FormattedString>
                                    </custom:CustomLabel.FormattedText>
                                </custom:CustomLabel>


                                <inputLayout:SfTextInputLayout  Margin="0,-6,0,-6" 
							        ContainerType="Outlined" UnfocusedColor="#B1B1B1"
							        OutlineCornerRadius="13" FocusedColor="#005e4b" ErrorColor="#B00020" HasError="{Binding FrameIDError}">
                                    <control:BorderlessEntry x:Name="idNumber"  IsEnabled="{Binding IdNumberText.IsEditable}" Placeholder="{x:Static ResourceManager:AppResources.IDNumber}" FontSize="Small"  HorizontalTextAlignment="Start"
