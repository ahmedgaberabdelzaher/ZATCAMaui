<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.TINDeregestrationSuccessPageView"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:local="clr-namespace:EGAZT"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout
            Margin="0"
            BackgroundColor="Transparent"
            IsVisible="{Binding IsAccountUnlockedSuccessViewVisible}">
            <StackLayout
                Padding="40"
                BackgroundColor="Transparent"
                VerticalOptions="CenterAndExpand">
                <Image Aspect="AspectFit" Source="Forget_ic_success.png" />
                <Label
                    FontFamily="{StaticResource SomarBold}"
                    FontSize="Large"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static custom2:AppResources.TinDeregistration}"
                    TextColor="White" />
                <Label
                    FontFamily="{StaticResource SomarSemiBold}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static custom2:AppResources.TinDeregistrationSuccess}"
                    TextColor="White" />
            </StackLayout>
            <yummy:PancakeView
                Margin="0,20,0,0"
                Padding="20"
                BackgroundColor="White"
                CornerRadius="22,22,0,0"
                VerticalOptions="Fill">
                <StackLayout>

                    <border:SfBorder Margin="0,8,0,8" Style="{StaticResource GreyBorderFrame}">
                        <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="StartAndExpand"
                                Style="{StaticResource ValueLabelGrey}"
                                Text="{x:Static custom2:AppResources.VATRSName}"
                                WidthRequest="80" />
                            <StackLayout HorizontalOptions="End" Orientation="Horizontal">
                                <Label
                                    x:Name="Label_Name"
                                    HorizontalOptions="EndAndExpand"
                                    Style="{StaticResource ValueLabelBlack}"
                                    Text="Sandeep Kumar Saini Sankhala Jilla abc  Jhunjhunu" />

                            </StackLayout>

                        </StackLayout>

                    </border:SfBorder>

                    <border:SfBorder Margin="0,0,0,8" Style="{StaticResource GreyBorderFrame}">

                        <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource ValueLabelGrey}"
                                Text="{x:Static custom2:AppResources.VATRSAppNumber}" />
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                <Label
                                    x:Name="Label_ApplicationNumber"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}" />
                                <Image Source="MainGrayCopy" Style="{StaticResource SmallIcon}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Image_Copy_Tapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>
                        </StackLayout>

                    </border:SfBorder>

                    <border:SfBorder Margin="0,0,0,8" Style="{StaticResource GreyBorderFrame}">

                        <StackLayout Padding="15,10,15,10" Orientation="Horizontal">
                            <Label
                                HorizontalOptions="Start"
                                Style="{StaticResource ValueLabelGrey}"
                                Text="{x:Static custom2:AppResources.Date}" />
                            <StackLayout HorizontalOptions="EndAndExpand" Orientation="Horizontal">
                                <Label
                                    x:Name="Label_Date"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource ValueLabelBlack}" />

                            </StackLayout>

                        </StackLayout>
                    </border:SfBorder>
                    <buttons:SfButton
                        Grid.ColumnSpan="2"
                        Margin="10,0,15,0"
                        BackgroundColor="{StaticResource Secondary}"
                        Clicked="SfButton_Clicked"
                        CornerRadius="10"
                        FontFamily="{StaticResource SomarBold}"
                        FontSize="15"
                        HeightRequest="46"
                        Text="{x:Static ResourceManager:AppResources.ZTINDeregDownloadAcknowledgement}"
                        TextColor="White"
                        VerticalOptions="End" />


                    <buttons:SfButton
                        x:Name="btnDash"
                        Grid.ColumnSpan="2"
                        Margin="10,0,10,0"
                        BackgroundColor="Transparent"
                        Clicked="btnDash_Clicked"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontFamily="{StaticResource SomarSemiBold}"
                        FontSize="15"
                        HeightRequest="46"
                        Style="{StaticResource SfButtonStyle}"
                        Text="{x:Static local:AppResources.ZZZZGotoDashboard}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="End" />
                </StackLayout>
            </yummy:PancakeView>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>