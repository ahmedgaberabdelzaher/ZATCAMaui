<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.ZakatRegistrationTaxPayerDetails"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="false">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid
                        Grid.Row="0"
                        Margin="8,0"
                        Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="true"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid
                Margin="20,10,20,0"
                BackgroundColor="Transparent"
                HorizontalOptions="FillAndExpand"
                IsVisible="{Binding IsOutletViewEnabled}"
                VerticalOptions="FillAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="50*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <Frame
                        Margin="0,10,0,0"
                        Padding="0"
                        BorderColor="LightGray"
                        CornerRadius="8"
                        HasShadow="False">
                        <StackLayout>

                            <Grid Padding="5" RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <Frame
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="10,10,10,0"
                                    BackgroundColor="Transparent"
                                    CornerRadius="32"
                                    HasShadow="False"
                                    HeightRequest="24"
                                    HorizontalOptions="Start"
                                    IsClippedToBounds="True"
                                    Opacity=".2"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <Image
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="10,10,10,10"
                                    Aspect="AspectFit"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    Source="details"
                                    VerticalOptions="Center"
                                    WidthRequest="24" />
                                <StackLayout
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="8,0">
                                    <Label
                                        FontSize="Medium"
                                        Style="{StaticResource SectionTitleBlackBold}"
                                        Text="{x:Static custom2:AppResources.ZZTaxPayerDetails}"
                                        VerticalOptions="CenterAndExpand" />
                                </StackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource lineSeperator}" />
                            <StackLayout Padding="10,5,10,10">
                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.EntityType}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding SelectedEntityType}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.ESTNationalityLabel}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding SelectedRegNationalityType}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.ZZIDType}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding GCCIDType}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.IDNumber}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding GCCIDTypeIdNumberValue}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.ZZDateofBirth}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding SelectedDOB}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.ZZZVATRFirstName}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding FirstName}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.ESTLastNameLabel}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding LastName}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.ESTFathersNameLabel}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding FatherName}" />
                                </StackLayout>

                                <StackLayout Orientation="Horizontal">
                                    <Label Style="{StaticResource CaptionLabelGrey}" Text="{x:Static custom2:AppResources.TinDeregistrationGrandFathersName}" />
                                    <Label
                                        HorizontalOptions="EndAndExpand"
                                        Style="{StaticResource ValueLabelBlack}"
                                        Text="{Binding GrandFatherName}" />
                                </StackLayout>



                            </StackLayout>
                        </StackLayout>
                    </Frame>



                </Grid>
            </Grid>
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,-20,0,0"
                IsVisible="{Binding isLoading}">
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="Black"
                    Opacity="0.4"
                    Orientation="Vertical"
                    VerticalOptions="FillAndExpand" />
                <StackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15,15"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    Opacity="0.8"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <busyindicator:SfBusyIndicator
                            x:Name="busyindicatorForLanding"
                            AnimationType="SingleCircle"
                            EnableAnimation="True"
                            HorizontalOptions="CenterAndExpand"
                            IsBusy="True"
                            TextColor="{StaticResource Secondary}"
                            TitlePlacement="Bottom"
                            VerticalOptions="CenterAndExpand"
                            ViewBoxHeight="70"
                            ViewBoxWidth="70" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>


    </ContentPage.Content>

</ContentPage>
