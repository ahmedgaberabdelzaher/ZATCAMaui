<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.ZakatRegistrationTaxPayerDetails"
             NavigationPage.HasNavigationBar="false"
             BackgroundImageSource="partials_background.png" xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:custom2="clr-namespace:EGAZT" 
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:busyindicator="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms">
     <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>          
            </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                    Padding="0,0,0,0" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0" Margin="8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.ZZTaxPayerDetails}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"/>
                        <Image Grid.Row="0" Grid.Column="0" IsVisible="true" Source="arrowLeftwhite"  Style="{DynamicResource BackButtonArrow}"  VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <Grid IsVisible="{Binding IsOutletViewEnabled}" BackgroundColor="Transparent"  Margin="20,10,20,0"
        HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1"/>
                </Grid.RowDefinitions>
                <Frame BorderColor="LightGray" Padding="0" CornerRadius="8" Margin="0,10,0,0" HasShadow="False">
                    <StackLayout>

                        <Grid Padding="5" RowSpacing="0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Frame Margin="10,10,10,0" Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start"
                                                    VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True"
                                       BackgroundColor="Transparent"
                                                            HasShadow="False">
                            </Frame>
                            <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center"
                                                    VerticalOptions="Center"  Aspect="AspectFit"  Source="details" Margin="10,10,10,10" />
                            <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                <Label Text="{x:Static custom2:AppResources.ZZTaxPayerDetails}" FontSize="Medium" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                            </StackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource lineSeperator}"/>
                        <StackLayout Padding="10,5,10,10" >
                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.EntityType}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand"  Text="{Binding SelectedEntityType}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.ESTNationalityLabel}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding SelectedRegNationalityType}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.ZZIDType}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding GCCIDType}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.IDNumber}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding GCCIDTypeIdNumberValue}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.ZZDateofBirth}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding SelectedDOB}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.ZZZVATRFirstName}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding FirstName}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.ESTLastNameLabel}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding LastName}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label  Text="{x:Static custom2:AppResources.ESTFathersNameLabel}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding FatherName}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal">
                                <Label Text="{x:Static custom2:AppResources.TinDeregistrationGrandFathersName}" Style="{StaticResource CaptionLabelGrey}"/>
                                <Label  HorizontalOptions="EndAndExpand" Text="{Binding GrandFatherName}" Style="{StaticResource ValueLabelBlack}"/>
                            </StackLayout>



                        </StackLayout>
                    </StackLayout>
                </Frame>



            </Grid>
        </Grid>
             <Grid Grid.Row="0" Grid.Column="0"  IsVisible="{Binding isLoading}" Margin="0,-20,0,0">
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Black" Opacity="0.4" VerticalOptions="FillAndExpand">
                </StackLayout>
                <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical" BackgroundColor="Transparent" Opacity="0.8" VerticalOptions="Center" HorizontalOptions="Center" Padding="15,15">
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <busyindicator:SfBusyIndicator x:Name="busyindicatorForLanding" 
                                           EnableAnimation="True"
                                       AnimationType="SingleCircle"
                                           HorizontalOptions="CenterAndExpand"
                                           VerticalOptions="CenterAndExpand"
                                           IsBusy="True"
                                       ViewBoxWidth = "70" 
                                         
                                       TitlePlacement="Bottom"
                                       ViewBoxHeight="70" 
                                       TextColor="{StaticResource Secondary}"/>
                    </StackLayout>
                </StackLayout>
            </Grid>
        </Grid>
        

    </ContentPage.Content>

</ContentPage>
