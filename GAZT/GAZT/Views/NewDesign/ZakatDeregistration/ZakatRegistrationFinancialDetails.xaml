<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.ZakatRegistrationFinancialDetails"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FontImage="clr-namespace:MVP.FontIcons"
    xmlns:ResourceManager="clr-namespace:EGAZT"
    xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
    xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms"
    xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
    xmlns:custom1="clr-namespace:GAZT.CustomControl"
    xmlns:custom2="clr-namespace:EGAZT"
    xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
    xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
    xmlns:local="clr-namespace:EGAZT.Helper"
    xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
    xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
    BackgroundImageSource="partials_background.png"
    NavigationPage.HasNavigationBar="false">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <yummy:PancakeView
                        Grid.Row="1"
                        Padding="0"
                        BackgroundColor="Black"
                        CornerRadius="15,15,0,0">
                        <Grid
                            x:Name="VATRMainGrid"
                            Margin="0"
                            Padding="0,0,0,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand" />
                        </Grid>
                    </yummy:PancakeView>
                    <Grid
                        Grid.Row="0"
                        Margin="8,0"
                        Padding="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="60*" />
                            <ColumnDefinition Width="20*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="CenterAndExpand"
                            Style="{StaticResource SectionTitleWhiteBold}"
                            Text="{x:Static ResourceManager:AppResources.VATRFinancialDetails}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="StartAndExpand"
                            IsVisible="true"
                            Source="arrowLeftwhite"
                            Style="{DynamicResource BackButtonArrow}"
                            VerticalOptions="CenterAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
    <ContentPage.Content>
        <Grid>
            <yummy:PancakeView
                Padding="0"
                BackgroundColor="Black"
                CornerRadius="42,42,0,0">
                <Grid
                    x:Name="VATRDMainGrid"
                    Margin="0"
                    Padding="0,15,0,0"
                    BackgroundColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*" />

                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0"
                        Padding="15,15,15,0"
                        BackgroundColor="White"
                        HorizontalOptions="FillAndExpand"
                        RowSpacing="0"
                        VerticalOptions="FillAndExpand">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="98*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0"
                            Padding="0,0,0,10"
                            BackgroundColor="White"
                            HorizontalOptions="FillAndExpand"
                            RowSpacing="0"
                            VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*" />
                            </Grid.ColumnDefinitions>


                            <!--  Summery  -->
                            <Grid
                                x:Name="SummeryView"
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="0,0,0,0"
                                IsVisible="true">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <StackLayout Grid.Row="0">
                                    <Frame
                                        Margin="0,10,0,0"
                                        Padding="0"
                                        BorderColor="LightGray"
                                        CornerRadius="8"
                                        HasShadow="False"
                                        HorizontalOptions="Center"
                                        VerticalOptions="StartAndExpand">


                                        <StackLayout>
                                            <Grid Padding="5" RowSpacing="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <Frame
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="10,10,10,0"
                                                    BackgroundColor="Transparent"
                                                    CornerRadius="32"
                                                    HasShadow="False"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Start"
                                                    IsClippedToBounds="True"
                                                    Opacity=".2"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />
                                                <Image
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="10,15,10,10"
                                                    Aspect="AspectFit"
                                                    HeightRequest="24"
                                                    HorizontalOptions="Center"
                                                    Source="details"
                                                    VerticalOptions="Center"
                                                    WidthRequest="24" />
                                                <StackLayout
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Padding="8,0">
                                                    <Label
                                                        FontSize="Medium"
                                                        Style="{StaticResource SectionTitleBlackBold}"
                                                        Text="{x:Static custom2:AppResources.VATRFinancialDetails}"
                                                        VerticalOptions="CenterAndExpand" />
                                                </StackLayout>
                                            </Grid>
                                            <BoxView Style="{StaticResource lineSeperator}" />
                                            <Grid Padding="10,5,10,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40*" />
                                                    <ColumnDefinition Width="50*" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static custom2:AppResources.FORM5AccountingMethod}" />
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding SelectedMethod}" />

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static custom2:AppResources.FORM5CalendarType}" />
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding CalendarType}" />

                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static custom2:AppResources.ESTEndOfFiscalMonth}" />
                                                <Label
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding FiscalMonth}" />

                                                <Label
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static custom2:AppResources.ESTEndOfFiscalDay}" />
                                                <Label
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding FiscalDay}" />

                                                <Label
                                                    Grid.Row="4"
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static custom2:AppResources.ESTBusinessCommencementDate}" />
                                                <Label
                                                    Grid.Row="4"
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding CommDate}" />

                                                <Label
                                                    Grid.Row="5"
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionLabelGrey}"
                                                    Text="{x:Static custom2:AppResources.ESTDebtEndDate}" />

                                                <Label
                                                    Grid.Row="5"
                                                    Grid.Column="1"
                                                    HorizontalOptions="EndAndExpand"
                                                    Style="{StaticResource ValueLabelBlack}"
                                                    Text="{Binding TaxDate}" />
                                            </Grid>
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>
                            </Grid>

                        </Grid>
                    </Grid>
                </Grid>
            </yummy:PancakeView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
