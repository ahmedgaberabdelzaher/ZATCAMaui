<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="EGAZT.Views.NewDesign.ZakatDeregistration.ZakatRegistrationFinancialDetails"
                   NavigationPage.HasNavigationBar="false"
             BackgroundImageSource="partials_background.png" xmlns:ResourceManager="clr-namespace:EGAZT"
             xmlns:inputLayout="clr-namespace:Syncfusion.XForms.TextInputLayout;assembly=Syncfusion.Core.XForms"
             xmlns:syncfusion="clr-namespace:Syncfusion.SfPicker.XForms;assembly=Syncfusion.SfPicker.XForms"
             xmlns:custom1="clr-namespace:GAZT.CustomControl"
                          xmlns:custom2="clr-namespace:EGAZT"

             xmlns:FontImage="clr-namespace:MVP.FontIcons"
             xmlns:cards="clr-namespace:Syncfusion.XForms.Cards;assembly=Syncfusion.Cards.XForms"
             xmlns:local="clr-namespace:EGAZT.Helper"
             xmlns:listView="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms"
             xmlns:buttons="clr-namespace:Syncfusion.XForms.Buttons;assembly=Syncfusion.Buttons.XForms">
   <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\StylesNewUI.xaml" />
                <ResourceDictionary Source="..\..\SyncFusionEnabledViews\CommonStyle\Styles.xaml" />
                <ResourceDictionary>
                    <Style x:Key="ArrowImageForArabicStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="180" />
                    </Style>
                    <Style x:Key="ArrowImageForEnglishStyle" TargetType="Image">
                        <Setter Property="Rotation" Value="0" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
     <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>
                    <yummy:PancakeView Grid.Row="1" BackgroundColor="Black" CornerRadius="15,15,0,0" Padding="0">
                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                    Padding="0,0,0,0" x:Name="VATRMainGrid">

                            <Grid.RowDefinitions>
                                <!--<RowDefinition Height="10*" />-->
                                <RowDefinition Height="100*" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalOptions="FillAndExpand"
                        HorizontalOptions="FillAndExpand"
                        Grid.Column="0"
                        Grid.Row="0" BackgroundColor="White"/>
                        </Grid>
                    </yummy:PancakeView>
                    <Grid Padding="0,10,0,10" Grid.Row="0" Margin="8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="60*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static ResourceManager:AppResources.VATRFinancialDetails}" Style="{StaticResource SectionTitleWhiteBold}" HorizontalOptions="CenterAndExpand" VerticalOptions="Center"/>
                        <Image Grid.Row="0" Grid.Column="0" Rotation="0" IsVisible="true" Source="arrowLeftwhite"  VerticalOptions="CenterAndExpand" HorizontalOptions="StartAndExpand">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding BindingContext.GoBackBtnTapped}" ></TapGestureRecognizer>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
     <ContentPage.Content>
        <Grid>
            <yummy:PancakeView BackgroundColor="Black" CornerRadius="42,42,0,0" Padding="0">
                <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,15,0,0" BackgroundColor="White" x:Name="VATRDMainGrid">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="100*" />
                      
                    </Grid.RowDefinitions>

                  <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="0" Grid.Column="0"  Margin="0" 
                  Padding="15,15,15,0" BackgroundColor="White" RowSpacing="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="98*" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                   <Grid Grid.Row="0" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"  Margin="0" 
                  Padding="0,0,0,10" BackgroundColor="White" RowSpacing="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*"/>
                                    </Grid.ColumnDefinitions>

                                  
                                    <!--Summery-->
                    <Grid Grid.Row="0" Grid.Column="0"  Padding="0,0,0,0" IsVisible="true"
                              x:Name="SummeryView">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <StackLayout Grid.Row="0">
                                            <Frame BorderColor="LightGray" HorizontalOptions="Center" VerticalOptions="StartAndExpand"  Padding="0" CornerRadius="8" Margin="0,10,0,0" HasShadow="False">


                                                <StackLayout>
                                                   <Grid Padding="5" RowSpacing="0" >
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Frame Margin="10,10,10,0" Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" CornerRadius="32" HorizontalOptions="Start"
                                                                VerticalOptions="Center" Opacity=".2" IsClippedToBounds="True"
                                                                BackgroundColor="{StaticResource NewDarkBlueGreenColor}"
                                                                        HasShadow="False">
                                                        </Frame> 
                                                        <Image Grid.Row="0" Grid.Column="0" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center"
                                                                VerticalOptions="Center"  Aspect="AspectFit"  Source="details" Margin="10,15,10,10" />
                                                        <StackLayout Grid.Row="0" Grid.Column="1" Padding="8,0">
                                                            <Label Text="{x:Static custom2:AppResources.VATRFinancialDetails}" FontSize="Medium" VerticalOptions="CenterAndExpand" Style="{StaticResource SectionTitleBlackBold}"/>
                                                        </StackLayout>
                                                    </Grid>   
                                                    <BoxView Style="{StaticResource lineSeperator}"/>
                                                    <Grid Padding="10,5,10,10">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40*"/>
                                                            <ColumnDefinition Width="50*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Label Grid.Row="0" Grid.Column="0" Text="{x:Static custom2:AppResources.FORM5AccountingMethod}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <Label Grid.Row="0" Grid.Column="1" HorizontalOptions="EndAndExpand" Text="{Binding SelectedMethod}" Style="{StaticResource ValueLabelBlack}"/>

                                                        <Label Grid.Row="1" Grid.Column="0" Text="{x:Static custom2:AppResources.FORM5CalendarType}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <Label Grid.Row="1" Grid.Column="1" HorizontalOptions="EndAndExpand"  Text="{Binding CalendarType}" Style="{StaticResource ValueLabelBlack}"/>

                                                        <Label Grid.Row="2" Grid.Column="0" Text="{x:Static custom2:AppResources.ESTEndOfFiscalMonth}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <Label Grid.Row="2" Grid.Column="1" HorizontalOptions="EndAndExpand"  Text="{Binding FiscalMonth}"  Style="{StaticResource ValueLabelBlack}"/>

                                                        <Label Grid.Row="3" Grid.Column="0" Text="{x:Static custom2:AppResources.ESTEndOfFiscalDay}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <Label Grid.Row="3" Grid.Column="1" HorizontalOptions="EndAndExpand"  Text="{Binding FiscalDay}" Style="{StaticResource ValueLabelBlack}"/>

                                                        <Label Grid.Row="4" Grid.Column="0" Text="{x:Static custom2:AppResources.ESTBusinessCommencementDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                        <Label Grid.Row="4" Grid.Column="1" HorizontalOptions="EndAndExpand"   Text="{Binding CommDate}"  Style="{StaticResource ValueLabelBlack}"/>

                                                        <Label Grid.Row="5" Grid.Column="0" Text="{x:Static custom2:AppResources.ESTTaxableDate}" Style="{StaticResource CaptionLabelGrey}"/>
                                                   
                                                        <Label Grid.Row="5" Grid.Column="1" HorizontalOptions="EndAndExpand"  Text="{Binding TaxDate}" Style="{StaticResource ValueLabelBlack}"/>
                                                    </Grid>
                                                </StackLayout>
                                            </Frame>
                                        </StackLayout>
                                    </Grid>

                                </Grid>
                    </Grid>
                </Grid>
            </yummy:PancakeView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
